    },
    "peerDependencies": {
        "brs-scenegraph": "~0.6.2"
    },
    "peerDependenciesMeta": {
        "brs-scenegraph": {
            "optional": true
        }
    },
    "devDependencies": {
        "brs-scenegraph": "~0.6.2",
        "playwright": "^1.65.1"
    }
