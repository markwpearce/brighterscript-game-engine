sub Main()
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.fitCanvasToScreen()

  ' One-shot sound effects go through Game.Sounds (roAudioResource) - loaded up front,
  ' then played by name via playSound(). Background music instead goes through
  ' Game.musicPlay(path, loop) (roAudioPlayer) - see MainScene.
  game.loadSound("bell", "pkg:/sounds/bell.wav")

  firstScene = new MainScene(game)
  game.defineScene(firstScene)
  game.changeScene(firstScene.name)

  game.enableStandardDebugUi({memory: false, garbageCollector: false, log: false})

  game.play()
end sub
