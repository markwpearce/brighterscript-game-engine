' The snake game's BGE.GameSession: counts apples, keeps the best score and shows the
' "Press OK To Play" / "Game Over!" prompts. MainScene reacts to its state changes.
class ScoreHandler extends BGE.GameSession

  ' BGE.UI.Labels cache their text bitmap, so unlike a DrawText() each frame they don't flicker on device
  scoreLabel as BGE.UI.Label
  bestLabel as BGE.UI.Label

  sub new(game as BGE.Game)
    super(game, {prompts: true, startButton: "ok"})
    m.name = "ScoreHandler"
    ' "Press OK To Play" sits above "Game Over!" in this game
    m.overPrompt = m.readyPrompt + Chr(10) + "Game Over!"
    ' The prompt's on the UI canvas: size it like the default font on the scaled game canvas.
    promptSize = cint(28 * m.game.canvas.scale.y)
    m.promptLabel.setFont(CreateObject("roFontRegistry").GetDefaultFont(promptSize, false, false))
    m.persistHighScore("bge-snake")
  end sub

  override sub onCreate(args as roAssociativeArray)
    super.onCreate(args)
    ' Same size as the prompt
    font = m.promptLabel.drawableText.font
    m.scoreLabel = m.addTopWallLabel(font)
    m.bestLabel = m.addTopWallLabel(font)
    m.refreshText()
  end sub

  override sub onStateChanged(previousState as BGE.GameSessionState, newState as BGE.GameSessionState)
    m.refreshText()
  end sub

  override sub onGameEvent(event as string, data as object)
    if event = "score"
      m.addScore()
      m.refreshText()
    else if event = "game_over"
      m.gameOver()
    end if
  end sub

  ' Black text on the top wall, sized and placed like the default font at y = 100 on the
  ' (scaled) game canvas, though it's on the UI canvas.
  private function addTopWallLabel(font as roFont) as BGE.UI.Label
    canvas = m.game.canvas
    label = new BGE.UI.Label(m.game)
    label.setFont(font)
    label.drawableText.textColor = BGE.Colors.black
    label.horizAlign = "center"
    label.customPosition = true
    label.customY = canvas.offset.y + 100 * canvas.scale.y
    m.game.getScene().addUi(label)
    return label
  end function

  private sub refreshText()
    centerX = m.game.canvas.getWidth() / 2
    m.setCenteredText(m.scoreLabel, m.score.ToStr(), centerX)
    ' Beside the score, on the top wall.
    m.setCenteredText(m.bestLabel, "Best " + m.highScore.ToStr(), centerX + 240)
  end sub

  ' Centres a label on game-canvas x (it's on the UI canvas).
  private sub setCenteredText(label as BGE.UI.Label, text as string, gameX as float)
    canvas = m.game.canvas
    label.setText(text)
    label.customX = canvas.offset.x + gameX * canvas.scale.x
  end sub

end class
