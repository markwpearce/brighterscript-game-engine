class ScoreHandler extends BGE.GameEntity

  score = 0
  profile as BGE.SaveProfile = invalid

  sub new(game as BGE.Game)
    super(game)
    m.name = "ScoreHandler"
    m.profile = new BGE.SaveProfile("bge-snake")
  end sub

  override sub onGameEvent(event as string, data as object)
    if event = "score"
      m.score++
    else if event = "game_start"
      m.score = 0
    else if event = "game_over"
      m.profile.recordHighScore("highScore", m.score)
    end if
  end sub

  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")
    frameCenter = renderObj.getCanvasCenter()
    renderObj.drawText(m.score.ToStr(), frameCenter.x, 100, BGE.Colors.black, font, "center")
    ' Beside the score, on the top wall.
    renderObj.drawText("Best " + m.profile.getHighScore("highScore").ToStr(), frameCenter.x + 240, 100, BGE.Colors.black, font, "center")

  end sub

end class
