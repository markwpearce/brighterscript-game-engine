{
    "extends": "../../bsconfig.build.json",
    "rootDir": "steps/step7",
    "outDir": "build/step7",
    "files": [
        "**/*",
        {
            "src": "../../src/manifest",
            "dest": "manifest"
        },
        {
            "src": "../../src/images/**/*",
            "dest": "images"
        },
        {
            "src": "../../../../src/source/**/*",
            "dest": "source"
        },
        "!../../../../src/**/*.spec.*"
    ],
    "compilerOptions": {
        "emitDefinitions": false
    },
    "diagnosticFilters": [
        {
            "files": "../../../../src/**/*"
        }
    ]
}
