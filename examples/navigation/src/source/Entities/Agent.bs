import "pkg:/source/engine/navigation/NavGrid.bs"
import "pkg:/source/engine/navigation/NavFollower.bs"

' Walks to the flag: straight at it while it's in sight, otherwise along a path from the
' scene's NavGrid, re-planned when the flag moves. Each search gets a small slice of every
' frame, so several agents searching at once don't drop frames. position is its centre.
class Agent extends BGE.GameEntity

  radius = 10.0
  speed = 150.0
  colorRGB = &hFFFFFF
  ' Last finished search, for the HUD
  lastStatus = "-"
  lastExpanded = 0
  lastFrames = 0
  ' "path", "direct" or "here"
  mode = "here"

  private world as BGE.SolidWorld
  private flagEntity as BGE.GameEntity
  private follower as BGE.NavFollower

  sub new(game as BGE.Game)
    super(game)
    m.name = "Agent"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = args.x
    m.position.y = args.y
    m.colorRGB = args.color
    m.world = args.world
    m.flagEntity = args.flag
    ' Keeps planning while it can see the flag, so a path is ready the moment it can't. Re-plans
    ' soon after the flag moves, otherwise only now and then, in case it was pushed off its path.
    m.follower = new BGE.NavFollower(args.nav, {
      plane: BGE.SeparationPlane.xy,
      sightInterval: 0.1,
      repathInterval: 3.0,
      repathDistance: 20.0,
      minRepathInterval: 0.25,
      arriveRadius: 6.0,
      searchBudgetMs: 2,
      pathWhileVisible: true
    })
    m.follower.repathAfter(args.delay)
    r = m.radius
    m.addCircle("body", r, {color: m.colorRGB, outlineRGBA: &hFFFFFF, offset: BGE.Math.VectorOps.create(-r, r)})
  end sub

  ' Drops the current search and searches again next frame, e.g. after a door changed
  sub forceRepath()
    m.follower.forceRepath()
  end sub

  override sub onUpdate(deltaTime as float)
    scene = m.game.currentScene as MainScene
    goal = m.flagEntity.position
    m.follower.searchOptions.smooth = scene.smoothPaths
    way = m.follower.steer(m.position, goal, deltaTime)
    m.updateHud()

    ' Close enough: stop
    dx = goal.x - m.position.x
    dy = goal.y - m.position.y
    if dx * dx + dy * dy < 45 * 45
      m.mode = "here"
      return
    end if

    if m.follower.canSeeTarget
      m.mode = "direct"
      m.moveToward(goal.x, goal.y, deltaTime)
      return
    end if
    m.mode = "path"
    if invalid <> way
      m.moveBy(way.x, way.y, m.speed * deltaTime)
    end if
  end sub

  private sub updateHud()
    if invalid = m.follower.lastSearch
      return
    end if
    search = m.follower.lastSearch as BGE.NavPathSearch
    m.lastStatus = search.status
    m.lastExpanded = search.expandedCells
    m.lastFrames = m.follower.lastSearchFrames
  end sub

  private sub moveToward(x as float, y as float, deltaTime as float)
    dx = x - m.position.x
    dy = y - m.position.y
    distance = Sqr(dx * dx + dy * dy)
    if distance < 0.001
      return
    end if
    m.moveBy(dx / distance, dy / distance, BGE.Math.Min(distance, m.speed * deltaTime))
  end sub

  ' Moves along a unit direction, sliding along walls
  private sub moveBy(directionX as float, directionY as float, stepLength as float)
    r = m.radius
    feet = {x: m.position.x - r, y: m.position.y - r, w: r * 2, h: r * 2}
    result = m.world.moveAndSlide(feet, directionX * stepLength, directionY * stepLength)
    m.position.x = result.x + r
    m.position.y = result.y + r
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    scene = m.game.currentScene as MainScene
    if not scene.showPaths or m.mode <> "path"
      return
    end if
    points = [BGE.Math.VectorOps.create(m.position.x, m.position.y, 0)]
    waypoints = m.follower.path
    for i = m.follower.pathIndex to waypoints.count() - 1
      points.push(BGE.Math.VectorOps.create(waypoints[i].x, waypoints[i].y, 0))
    end for
    rgba = (m.colorRGB << 8) or &hFF
    gameRenderer.drawWorldPolyline(points, rgba)
    for i = 1 to points.count() - 1
      canvasPoint = gameRenderer.worldPointToCanvasPoint(points[i])
      gameRenderer.drawRectangle(canvasPoint.x - 3, canvasPoint.y - 3, 6, 6, rgba)
    end for
  end sub

end class
