' The goal every agent heads for. Moved with the arrows; it can go inside walls, to show a
' blocked goal snapping to the nearest open cell. position is the foot of the pole.
class Flag extends BGE.GameEntity

  speed = 260.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "Flag"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = args.x
    m.position.y = args.y
    m.addRectangle("pole", 4, 34, {color: &hDDDDDD, offset: BGE.Math.VectorOps.create(-2, 34)})
    m.addRectangle("cloth", 20, 13, {color: &hFFD23F, offset: BGE.Math.VectorOps.create(2, 34)})
    m.addCircle("base", 5, {color: &hFFD23F, offset: BGE.Math.VectorOps.create(-5, 5)})
  end sub

  override sub onInput(input as BGE.GameInput)
    m.velocity.x = input.x * m.speed
    m.velocity.y = input.y * m.speed
  end sub

  override sub onUpdate(deltaTime as float)
    ' keep it on the map
    m.position.x = BGE.Math.Clamp(m.position.x, MAP_LEFT + 4, MAP_LEFT + 28 * MAP_CELL - 4)
    m.position.y = BGE.Math.Clamp(m.position.y, MAP_BOTTOM + 4, MAP_BOTTOM + 14 * MAP_CELL - 4)
  end sub

end class
