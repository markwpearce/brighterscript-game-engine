' A wall or door: a filled rectangle. position is its top-left corner.
class Block extends BGE.GameEntity

  body as BGE.DrawableRectangle

  sub new(game as BGE.Game)
    super(game)
    m.name = "Block"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = args.x
    m.position.y = args.y
    m.body = m.addRectangle("body", args.width, args.height, {color: args.color, outlineRGBA: args.outline})
  end sub

  ' Doors only: shows a closed door solid, an open one as a faint outline
  sub setOpen(isOpen as boolean)
    m.body.filled = not isOpen
  end sub

end class
