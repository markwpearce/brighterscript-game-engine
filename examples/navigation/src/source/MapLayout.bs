' One character per cell, row 0 at the top:
' #  wall    D  door    A  agent start    F  flag start    .  floor
function getMapRows() as string[]
  return [
    "############################",
    "#A.........#.......#......A#",
    "#..........#.......#.......#",
    "#...####...D...#...#...##..#",
    "#...#..........#.......#...#",
    "#...#..######..#####...#...#",
    "#...#.......#..........#...#",
    "####D####...#...F..#####...#",
    "#.......#...####...#.......#",
    "#.......#..........D...#...#",
    "#...#####...####...#...#...#",
    "#.......D......#...#####...#",
    "#A.............#..........A#",
    "############################"
  ]
end function

const MAP_CELL = 40
' World position of the map's bottom-left corner
const MAP_LEFT = 80
const MAP_BOTTOM = 60
