' Fixed (not runtime-random) low-wall placements for WorldScene, generated once from
' worldMap.png's actual dark dashed-tile-line pixel content, the same way
' TreePlacements.bs's tree positions were derived - clustered from the map's 3 real
' fence/rubble lines (ruling out the visually similar but unrelated dark grey rocky
' shore/waterfall pixels elsewhere on the map). `length` is the segment's size along its
' own axis (world units, 1:1 with source pixels); `rotY` is 0 for a segment that runs
' along world X, 90 for one that runs along world Z.
function getWallPlacements() as object[]
  return [
    {x: -404.0, z: -117.0, length: 56.0, rotY: 0.0}
    {x: -392.0, z: 445.0, length: 49.0, rotY: 90.0}
    {x: -378.0, z: 344.0, length: 61.0, rotY: 0.0}
    {x: -369.0, z: -225.0, length: 227.0, rotY: 90.0}
    {x: -347.0, z: 409.0, length: 40.0, rotY: 90.0}
    {x: -330.0, z: 287.0, length: 53.0, rotY: 0.0}
    {x: -321.0, z: -390.0, length: 92.0, rotY: 0.0}
    {x: -278.0, z: 320.0, length: 132.0, rotY: 0.0}
    {x: -248.0, z: -379.0, length: 43.0, rotY: 0.0}
    {x: -220.0, z: 309.0, length: 24.0, rotY: 90.0}
    {x: -162.0, z: -373.0, length: 116.0, rotY: 0.0}
    {x: 15.0, z: -405.0, length: 226.0, rotY: 0.0}
  ]
end function
