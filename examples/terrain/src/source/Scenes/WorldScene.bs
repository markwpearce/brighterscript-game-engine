import "../TerrainProfiler.bs"

class WorldScene extends BGE.GameScene

  cameraController as TerrainFreeFlyCameraController
  cameraHeight = 50
  ' Set before the scene is created to run the scripted profile instead of taking input.
  profileMode = false
  profileStages = false
  profiler as TerrainProfiler = invalid

  sub new(game as BGE.Game)
    super(game)
    m.name = "WorldScene"
  end sub

  ' Loaded the first time this scene is visited and kept, since it's the scene you come back to.
  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    bitmaps = {
      grass: "pkg:/sprites/grass.png",
      worldMap: "pkg:/sprites/worldMap.png",
      skyboxNight: "pkg:/sprites/skybox_night.jpg",
      tree1: "pkg:/sprites/tree1.png",
      tree2: "pkg:/sprites/tree2.png",
      tree3: "pkg:/sprites/tree3.png",
      tree4: "pkg:/sprites/tree4.png",
      tree5: "pkg:/sprites/tree5.png",
      guardSheet: "pkg:/sprites/helix_full_sheet.png"
    }
    for each bitmapName in bitmaps
      if m.game.Bitmaps[bitmapName] = invalid
        loader.loadBitmap(bitmapName, bitmaps[bitmapName])
      end if
    end for

    if m.game.Models["chapel"] = invalid
      loader.load3dModel("chapel", "pkg:/models/chapel/chapel.obj")
    end if
  end sub

  override sub onCreate(args as roAssociativeArray)
    groundPlaneDef = {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}

    ' Layered ground, same composition pattern as MainScene.cycleGroundOverlay(): a
    ' flat color base, a seamlessly tiled grass texture over it, then the finite
    ' park/lake map decal on top (grass09.png is CC0 / OpenGameArt, credit:
    ' https://opengameart.org/content/seamless-grass-textures-20-pack).
    colorBase = new BGE.DrawablePlane(m, invalid, groundPlaneDef, {fillMode: BGE.PlaneFillMode.color, color: BGE.ColorsRGB.Green})
    m.addDrawable("GroundColor", colorBase)

    grassBmp = m.game.getBitmap("grass")
    grassRegion = CreateObject("roRegion", grassBmp, 0, 0, grassBmp.GetWidth(), grassBmp.GetHeight())
    grassOverlay = new BGE.DrawablePlane(m, grassRegion, groundPlaneDef, {fillMode: BGE.PlaneFillMode.tiledImage})
    m.addDrawable("GroundGrass", grassOverlay)

    mapBmp = m.game.getBitmap("worldMap")
    mapRegion = CreateObject("roRegion", mapBmp, 0, 0, mapBmp.GetWidth(), mapBmp.GetHeight())
    mapOverlay = new BGE.DrawablePlane(m, mapRegion, groundPlaneDef, {fillMode: BGE.PlaneFillMode.staticImage})
    m.addDrawable("GroundMap", mapOverlay)

    skyBmp = m.game.getBitmap("skyboxNight")
    skyRegion = CreateObject("roRegion", skyBmp, 0, 0, skyBmp.GetWidth(), skyBmp.GetHeight())
    ' Wider than the default 90 - the camera's own pitch clamp
    ' (TerrainFreeFlyCameraController.maxDownwardTilt, ~69 degrees) exceeds the default's
    ' +/-45 degree half-coverage, so looking near-straight-up hit the flat background
    ' clear color instead of sky. 160 gives +/-80 degrees of headroom.
    sky = new BGE.DrawableSkybox(m, skyRegion, {verticalDegreesCovered: 160})
    m.addDrawable("Sky", sky)

    ' Matches the skybox texture's own darkest (zenith) tone, so any residual gap past
    ' its coverage blends into the sky rather than hard-cutting to the engine's default
    ' black clear color.
    m.game.setBackgroundColor(&h0B1E3AFF)

    m.addTrees()
    ' m.addLowWalls() - turned off for now; LowWall entity/getWallPlacements() are left
    ' in place, just not instantiated.
    m.addGuards()
    m.addChapel()

    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.position = BGE.Math.VectorOps.create(0, m.cameraHeight, 0)
    m.cameraController = new TerrainFreeFlyCameraController(m, "MainScene", groundPlaneDef)
    m.cameraController.occlusionToggleEnabled = true
    if m.profileMode
      m.profiler = new TerrainProfiler(m.game, m.profileStages)
    end if
  end sub

  ' World size is set explicitly (not left at the source PNG's native pixel size) so
  ' every tree is the same in-world height regardless of its source image's resolution -
  ' width is derived per sprite to preserve that image's own aspect ratio.
  private sub addTrees()
    treeHeight = 180.0
    bitmapsByIndex = {
      "1": m.game.getBitmap("tree1"),
      "2": m.game.getBitmap("tree2"),
      "3": m.game.getBitmap("tree3"),
      "4": m.game.getBitmap("tree4"),
      "5": m.game.getBitmap("tree5")
    }

    placements = getTreePlacements()
    for i = 0 to placements.count() - 1
      placement = placements[i]
      bmp = bitmapsByIndex[placement.spriteIndex.ToStr()]
      region = CreateObject("roRegion", bmp, 0, 0, bmp.GetWidth(), bmp.GetHeight())
      treeWidth = treeHeight * (bmp.GetWidth() / bmp.GetHeight())

      tree = new BGE.Image(m, region, {
        width: treeWidth,
        height: treeHeight,
        drawMode: BGE.SceneObjectDrawMode.directScaled,
        ' A tree planted in the ground should visually bank with camera roll like the
        ' ground itself does, not stay screen-vertical (directScaled's default, "Doom
        ' sprite" behavior - see Drawable.banksWithCameraRoll).
        banksWithCameraRoll: true
      })
      anchor = getTreeAnchor(placement.spriteIndex)
      tree.setAnchor(anchor.x, anchor.y)
      tree.offset = BGE.Math.VectorOps.create(placement.x, 0, placement.z)
      m.addDrawable("Tree" + i.ToStr(), tree)
    end for
  end sub

  ' Low grey walls along worldMap.png's dark fence/rubble lines - see WallPlacements.bs.
  ' Each is its own GameEntity (not a GameScene-owned drawable like the trees), which lets
  ' only the walls be marked isStatic (issue #107) - the scene's ground/sky/tree
  ' drawables aren't eligible for the static BSP tree anyway (see
  ' SceneObject.isEligibleForStaticBsp()), and marking the whole scene static would log
  ' a misuse warning for each of them. Separate entities also get independently
  ' destroyed/re-created on a scene change like any other non-persistent entity, same as
  ' addTrees()'s drawables get cleared via GameScene's own onChangeScene().
  private sub addLowWalls()
    wallHeight = 15.0
    placements = getWallPlacements()
    for i = 0 to placements.count() - 1
      placement = placements[i]
      m.game.addEntity(new LowWall(m.game), {
        x: placement.x,
        z: placement.z,
        length: placement.length,
        rotY: placement.rotY,
        height: wallHeight
      })
    end for
  end sub

  ' Sits between the start position and a cluster of trees, hiding some of them.
  private sub addChapel()
    m.game.addEntity(new Chapel(m.game), {x: 80, z: -320, rotY: 180})
  end sub

  ' Guard characters demonstrating DrawableOrientedSprite (issue #104) - see
  ' GuardPlacements.bs.
  private sub addGuards()
    placements = getGuardPlacements()
    for i = 0 to placements.count() - 1
      placement = placements[i]
      m.game.addEntity(new Guard(m.game), {
        x: placement.x,
        z: placement.z,
        rotY: placement.rotY,
        patrolTo: placement.patrolTo,
        patrolSpeed: placement.patrolSpeed
      })
    end for
  end sub

  override sub onInput(input as BGE.GameInput)
    if invalid = m.profiler
      m.cameraController.onInput(input)
    end if
  end sub

  override sub onUpdate(dt as float)
    if invalid <> m.profiler
      m.profiler.update(dt)
    else
      m.cameraController.update(dt)
    end if
  end sub

  ' BGE.GameScene's default onChangeScene() already clears this scene's own directly-added
  ' drawables on a change to a different scene (see #144) - onCreate() runs fresh every
  ' time this scene becomes current again, so there's nothing extra to do here.

  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")
    frameCenter = uiRenderObj.getCanvasCenter()
    if invalid <> m.profiler
      m.profiler.afterDraw(renderObj)
      uiRenderObj.DrawText(m.profiler.getStatusText(), frameCenter.x, 140, BGE.Colors.White, font, "center")
      return
    end if
    uiRenderObj.DrawText(m.cameraController.getOcclusionHintText() + Chr(10) + m.cameraController.getHintText(), frameCenter.x, 140, BGE.Colors.White, font, "center")
  end sub

end class
