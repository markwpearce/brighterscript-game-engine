class MainRoom extends BGE.Room

  drawablePlane as BGE.DrawablePlane
  colorBasePlane as BGE.DrawablePlane
  groundModeIndex = 0 ' cycles staticImage -> tiledImage -> color
  debugEnabled = false

  cameraHeight = 50

  cameraController as TerrainFreeFlyCameraController

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' WorldRoom sets its own (dark navy, matching its skybox's zenith tone) - reset
    ' back to the engine default here so switching from WorldRoom doesn't leave this
    ' room's flat-fill/checkerboard ground demo tinted by the previous room's sky.
    m.game.setBackgroundColor(BGE.Colors.Black)

    m.colorBasePlane = new BGE.DrawablePlane(m, invalid, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.color, color: BGE.ColorsRGB.Green})
    m.addDrawable("GroundBase", m.colorBasePlane)
    m.cycleGroundOverlay()

    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.position = BGE.Math.VectorOps.create(0, m.cameraHeight, 0)
    m.cameraController = new TerrainFreeFlyCameraController(m, "WorldRoom", {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}})
    ' -0.12, not 0.12: setInitialPitch()/update() apply a NEGATED rotation for a given
    ' pitch value (see TerrainFreeFlyCameraController's yaw/pitch sign comments), so this is the
    ' value that reproduces the room's original (already visually verified) slight
    ' downward-tilt opening view, now with pitchAccum seeded to match.
    m.cameraController.setInitialPitch(-0.12)

    marker = new RollMarker(m.game)
    marker.position = BGE.Math.VectorOps.create(150, 0, -400)
    m.game.addEntity(marker)
  end sub

  ' Cycles the ground's overlay layer through the three fill modes, drawn on top of a
  ' permanent color base plane (demonstrates layering via ordinary addDrawable() order).
  ' Replaces the drawable entirely rather than reassigning its region, since
  ' SceneObjectPlane caches a rendered bitmap and only redraws once the camera moves.
  private sub cycleGroundOverlay()
    if invalid <> m.drawablePlane
      m.removeDrawable("GroundOverlay")
    end if

    groundPlaneDef = {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}

    if m.groundModeIndex = 0
      marioKartBmp = m.game.getBitmap("mariokart")
      bmpRegion = CreateObject("roRegion", marioKartBmp, 0, 76, 1024, 1024)
      m.drawablePlane = new BGE.DrawablePlane(m, bmpRegion, groundPlaneDef, {fillMode: BGE.PlaneFillMode.staticImage})
    else if m.groundModeIndex = 1
      checkerboardBmp = m.game.getBitmap("checkerboard")
      ' A small crop of the checkerboard sheet, used as a single repeating tile -
      ' the whole 1080x1080 sheet would make for a needlessly huge cached
      ' supertexture (see SceneObjectPlane.buildSuperTextureIfNeeded).
      tileRegion = CreateObject("roRegion", checkerboardBmp, 0, 0, 120, 120)
      m.drawablePlane = new BGE.DrawablePlane(m, tileRegion, groundPlaneDef, {fillMode: BGE.PlaneFillMode.tiledImage})
    else
      m.drawablePlane = invalid
    end if

    if invalid <> m.drawablePlane
      m.addDrawable("GroundOverlay", m.drawablePlane)
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    m.cameraController.onInput(input)

    if input.press
      if input.isButton("OK")
        m.groundModeIndex = (m.groundModeIndex + 1) mod 3
        m.cycleGroundOverlay()
      end if
    end if
  end sub

  override sub onUpdate(dt as float)
    m.cameraController.update(dt)
  end sub

  ' See RoomCleanup.clearRoomDrawables() - a Room's own drawables aren't covered by
  ' Game.handleRoomChange()'s automatic entity cleanup.
  override sub onChangeRoom(newRoom as BGE.Room)
    if newRoom.name <> m.name
      clearRoomDrawables(m)
    end if
  end sub

  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")
    frameCenter = uiRenderObj.getCanvasCenter()
    text = m.cameraController.getHintText() + Chr(10) + "OK: cycle ground overlay"
    uiRenderObj.DrawText(text, frameCenter.x, 140, BGE.Colors.White, font, "center")
  end sub

end class
