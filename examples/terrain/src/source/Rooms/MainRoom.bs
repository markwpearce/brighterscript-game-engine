class MainRoom extends BGE.Room

  debugEnabled = false

  drawablePlane as BGE.DrawablePlane

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.game.addEntity(new Player(m.game))
    marioKartBmp = m.game.getBitmap("mariokart")
    bmpRegion = CreateObject("roRegion", marioKartBmp, 0, 76, 1024, 1024)

    m.drawablePlane = new BGE.DrawablePlane(m, bmpRegion, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}})

    m.addDrawable("Ground", m.drawablePlane)

    ' Stationary landmarks scattered around the origin - since these never
    ' move, they make it easy to see the ground plane scrolling correctly
    ' underneath the camera as you drive around, rather than the world
    ' appearing to slide along with you.
    m.addMarkerCube(BGE.Math.VectorOps.create(0, 50, 0), 200, BGE.Math.PI / 6)
    m.addMarkerCube(BGE.Math.VectorOps.create(0, 40, -400), 150, 0)
    m.addMarkerCube(BGE.Math.VectorOps.create(0, 40, 400), 150, 0)
    m.addMarkerCube(BGE.Math.VectorOps.create(400, 40, 0), 150, 0)
    m.addMarkerCube(BGE.Math.VectorOps.create(-400, 40, 0), 150, 0)
  end sub

  private sub addMarkerCube(position as BGE.Math.Vector, size as integer, rotationZ as float)
    imgCube = new ImageCube(m.game)
    imgCube.position = position
    imgCube.rotation.z = rotationZ
    imgCube.size = size
    m.game.addEntity(imgCube)
  end sub

  override sub onUpdate(dt as float)

  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press
      if input.isButton("replay")
        m.debugEnabled = not m.debugEnabled
        m.game.debugDrawEntityDetails(m.debugEnabled)
        m.game.debugShowUi(m.debugEnabled)
      else if input.isButton("back")
        m.game.end()
      else if input.isButton("play")
        for each entity in m.game.sortedEntities
          updateDrawMode(entity)
        end for
      end if
    end if
  end sub

  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")
    frameCenter = uiRenderObj.getCanvasCenter()
    text = "Steer: Left/Right   Drive: Up/Down" + Chr(10) + "Debug Information: Replay" + Chr(10) + "Cycle Draw Mode: Play"
    uiRenderObj.DrawText(text, frameCenter.x, 140, BGE.Colors.White, font, "center")
  end sub

end class
