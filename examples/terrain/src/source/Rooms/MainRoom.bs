class MainRoom extends BGE.Room

  drawablePlane as BGE.DrawablePlane
  showingCheckerboard = false
  debugEnabled = false

  turnSpeed = 2.0 ' radians/sec
  driveSpeed = 80 ' units/sec
  cameraHeight = 50
  downwardTilt = 0.12 ' small negative y-component on the (unit) look direction, for a slight downward tilt

  heading = 0.0 ' radians, 0 = facing -z (the default camera forward)
  lastInput as BGE.GameInput

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.setGroundTexture(false)

    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.position = BGE.Math.VectorOps.create(0, m.cameraHeight, 0)
    m.updateCameraOrientation()
  end sub

  ' Swaps the ground plane's texture. Replaces the drawable entirely
  ' (rather than just reassigning its region) since BGE.SceneObjectPlane
  ' caches a rendered bitmap and only redraws it once the camera has moved -
  ' a plain region swap wouldn't be picked up until the next camera movement.
  private sub setGroundTexture(useCheckerboard as boolean)
    if invalid <> m.drawablePlane
      m.removeDrawable("Ground")
    end if

    if useCheckerboard
      checkerboardBmp = m.game.getBitmap("checkerboard")
      bmpRegion = CreateObject("roRegion", checkerboardBmp, 0, 0, checkerboardBmp.getWidth(), checkerboardBmp.getHeight())
    else
      marioKartBmp = m.game.getBitmap("mariokart")
      bmpRegion = CreateObject("roRegion", marioKartBmp, 0, 76, 1024, 1024)
    end if

    m.drawablePlane = new BGE.DrawablePlane(m, bmpRegion, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}})
    m.addDrawable("Ground", m.drawablePlane)
    m.showingCheckerboard = useCheckerboard
  end sub

  override sub onInput(input as BGE.GameInput)
    m.lastInput = input
    if input.press
      if input.isButton("back")
        m.game.end()
      else if input.isButton("OK")
        m.setGroundTexture(not m.showingCheckerboard)
      else if input.isButton("options")
        m.debugEnabled = not m.debugEnabled
        m.game.debugDrawEntityDetails(m.debugEnabled)
      end if
    end if
  end sub

  override sub onUpdate(dt as float)
    input = m.lastInput
    if input <> invalid
      m.heading += input.x * dt * m.turnSpeed
      if input.y <> 0
        camera = m.game.canvas.renderer.camera as BGE.Camera3d
        camera.position = BGE.Math.VectorOps.add(camera.position, BGE.Math.VectorOps.scale(m.headingForward(), input.y * dt * m.driveSpeed))
      end if
    end if
    m.updateCameraOrientation()
  end sub

  private function headingForward() as BGE.Math.Vector
    return BGE.Math.VectorOps.create(sin(m.heading), 0, -cos(m.heading))
  end function

  ' Sets the camera's own look direction directly from the current heading
  ' (plus a fixed downward tilt), rather than pointing it at some other
  ' fixed world point - so steering turns the camera's view the way turning
  ' your head does, rotating about the world y-axis, rather than orbiting
  ' the camera around a point.
  private sub updateCameraOrientation()
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    forward = m.headingForward()
    tiltedForward = BGE.Math.VectorOps.create(forward.x, -m.downwardTilt, forward.z)
    BGE.Math.VectorOps.normalize(tiltedForward)
    camera.orientation = tiltedForward
  end sub

  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    ' Cheap screen-space fog toward the horizon, fading the ground plane rather than
    ' letting it cut off sharply at the far edge of the view - see
    ' Renderer.drawFogBands() for how this works (and its screen-space limitations).
    canvasSize = renderObj.getCanvasSize()
    renderObj.drawFogBands(BGE.ColorsRGB.Silver, canvasSize.y * 0.35)

    font = m.game.getFont("default")
    frameCenter = uiRenderObj.getCanvasCenter()
    text = "Turn: Left/Right   Move: Up/Down" + Chr(10) + "OK: toggle track / checkerboard" + Chr(10) + "*: toggle debug info"
    uiRenderObj.DrawText(text, frameCenter.x, 140, BGE.Colors.White, font, "center")
  end sub

end class
