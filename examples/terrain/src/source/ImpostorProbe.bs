' Deep link `profile=impostor` (#345, specs/2026-10-22-model-impostors-design.md): while the
' profile path flies, simulates reusing the chapel's captured bitmap instead of redrawing
' it, for several pixel tolerances and view-angle limits at once, and counts which draw
' each moving frame would have taken. Nothing is drawn differently.
'
' The "front" variants (#556) measure every fit on the vertices of the faces that faced the
' camera at capture, since only those are in the bitmap: "front-rot" a single rotate-scale
' blit, "strip-edge" that or else vertical strips hinted by the box's visible vertical
' edges, "strip-lsq" the same strips least-squares fitted to the vertices (an upper bound).
class ImpostorProbe

  ' Rough per-frame costs on a Roku Ultra: a redraw from profile=stages (performDraw plus
  ' canvas position), a pin from rendererTest's impostor-blit-benchmark, plus projecting 8
  ' points for any reuse.
  redrawMs = 13.0
  pinMs = 4.5
  blitMs = 0.5
  ' one region DrawScaledObject per strip, from the draw2d benchmark's ~2.5k/sec
  stripMs = 0.4
  ' each strip's vertical scale and offset is held within this of the warp
  stripStepPx = 1.0
  ' a reused bitmap is redrawn after this many frames whatever the fit
  maxStaleFrames = 30

  private variants = [] as roAssociativeArray[]
  private projected = [] as float[]
  private modelVertices as BGE.Math.Vector[] = invalid
  ' each model vertex's face normal in world space, matching modelVertices
  private modelNormals as BGE.Math.Vector[] = invalid

  sub new()
    ' "box" fits the 8 bounding box corners, "verts" every model vertex - the box's corners
    ' are farther apart in depth than the model is, so it may overstate the error
    for each samples in ["box", "front-rot", "strip-edge", "strip-lsq"]
      for each tolerance in [1, 2, 4, 8]
        m.variants.push({
          samples: samples,
          tolerance: tolerance,
          maxAngleDegrees: 5,
          capture: invalid,
          staleFrames: 0,
          counts: {scale: 0, rotate: 0, pin: 0, strip: 0, redraw: 0, hidden: 0},
          stripTotal: 0,
          stripMax: 0
        })
      end for
    end for
  end sub

  ' Call once per frame after the game canvas has drawn. Only moving frames are counted,
  ' since a still model already reuses its bitmap.
  sub observe(sceneObj as BGE.SceneObject, camera as BGE.Camera3d, moving as boolean)
    if not moving
      return
    end if
    boxProjection = m.projectSamples(sceneObj.getBoundingPoints(camera), camera)
    verts = m.projectSamples(m.getModelVertices(sceneObj.drawable as BGE.DrawableModel), camera)
    edges = m.projectSamples(m.getBoxEdges(sceneObj.getBoundingPoints(camera)), camera)
    for each variant in m.variants
      if invalid = boxProjection or invalid = verts or invalid = edges
        variant.capture = invalid
        variant.counts.hidden++
      else if variant.samples = "box"
        m.observeVariant(variant, boxProjection.xs, boxProjection.ys, boxProjection.direction)
      else
        m.observeFrontVariant(variant, verts, edges, camera)
      end if
    end for
  end sub

  ' Canvas x and y of each point, and the direction from the camera to their centre, or
  ' invalid if any point won't project.
  private function projectSamples(points as BGE.Math.Vector[], camera as BGE.Camera3d) as roAssociativeArray
    if points.count() = 0 or not camera.projectPointsWithDepth(points, m.projected)
      return invalid
    end if
    xs = [] as float[]
    ys = [] as float[]
    centre = BGE.Math.VectorOps.create()
    for i = 0 to points.count() - 1
      xs.push(m.projected[i * 3])
      ys.push(m.projected[i * 3 + 1])
      centre = BGE.Math.VectorOps.add(centre, points[i])
    end for
    centre = BGE.Math.VectorOps.scale(centre, 1.0 / points.count())
    direction = BGE.Math.VectorOps.subtract(centre, camera.position)
    BGE.Math.VectorOps.normalize(direction)
    return {xs: xs, ys: ys, direction: direction, points: points}
  end function

  ' The model's vertices in world space, once - the chapel is static.
  private function getModelVertices(drawable as BGE.DrawableModel) as BGE.Math.Vector[]
    if invalid = m.modelVertices
      matrix = BGE.Math.Matrix44.multiply(drawable.transformationMatrix, drawable.getOwnerTransformationMatrix())
      m.modelVertices = []
      m.modelNormals = []
      for each face in drawable.model.faces
        for each vert in face.vertices
          world = BGE.Math.Matrix44.multVecMatrix(vert, matrix)
          ' a rigid transform: the normal is where vert + normal lands, less vert
          normal = BGE.Math.VectorOps.subtract(BGE.Math.Matrix44.multVecMatrix(BGE.Math.VectorOps.add(vert, face.normal), matrix), world)
          BGE.Math.VectorOps.normalize(normal)
          m.modelVertices.push(world)
          m.modelNormals.push(normal)
        end for
      end for
    end if
    return m.modelVertices
  end function

  ' The 4 vertical edges of the points' world box, each as its top then bottom point.
  private function getBoxEdges(points as BGE.Math.Vector[]) as BGE.Math.Vector[]
    if points.count() = 0
      return []
    end if
    low = BGE.Math.VectorOps.copy(points[0])
    high = BGE.Math.VectorOps.copy(points[0])
    for each point in points
      low = BGE.Math.VectorOps.create(BGE.Math.Min(low.x, point.x), BGE.Math.Min(low.y, point.y), BGE.Math.Min(low.z, point.z))
      high = BGE.Math.VectorOps.create(BGE.Math.Max(high.x, point.x), BGE.Math.Max(high.y, point.y), BGE.Math.Max(high.z, point.z))
    end for
    edges = [] as BGE.Math.Vector[]
    for each x in [low.x, high.x]
      for each z in [low.z, high.z]
        edges.push(BGE.Math.VectorOps.create(x, high.y, z))
        edges.push(BGE.Math.VectorOps.create(x, low.y, z))
      end for
    end for
    return edges
  end function

  private sub observeFrontVariant(variant as roAssociativeArray, verts as roAssociativeArray, edges as roAssociativeArray, camera as BGE.Camera3d)
    capture = variant.capture
    if invalid = capture or variant.staleFrames >= m.maxStaleFrames or m.angleDegrees(verts.direction, capture.direction) > variant.maxAngleDegrees
      m.recaptureFront(variant, verts, edges, camera)
      return
    end if
    toX = [] as float[]
    toY = [] as float[]
    for each index in capture.front
      toX.push(verts.xs[index])
      toY.push(verts.ys[index])
    end for
    tolerance = variant.tolerance
    if BGE.ImpostorFit.fitRotateScale(capture.xs, capture.ys, toX, toY).residual <= tolerance
      variant.counts.rotate++
      variant.staleFrames++
      return
    end if
    if variant.samples <> "front-rot"
      fit = invalid
      if variant.samples = "strip-edge"
        edgeToX = [] as float[]
        edgeToY = [] as float[]
        for each index in capture.edgePoints
          edgeToX.push(edges.xs[index])
          edgeToY.push(edges.ys[index])
        end for
        fit = BGE.ImpostorFit.fitColumnsToEdges(capture.edgeXs, capture.edgeYs, edgeToX, edgeToY)
        if invalid <> fit.params
          fit.residual = BGE.ImpostorFit.columnsResidual(fit.params, capture.xs, capture.ys, toX, toY)
        end if
      else
        fit = BGE.ImpostorFit.fitColumns(capture.knotX, capture.xs, capture.ys, toX, toY)
      end if
      if invalid <> fit.params and fit.residual <= tolerance
        strips = BGE.ImpostorFit.columnStripCount(fit.params, capture.top, capture.bottom, m.stripStepPx)
        variant.counts.strip++
        variant.stripTotal += strips
        variant.stripMax = BGE.Math.Max(variant.stripMax, strips)
        variant.staleFrames++
        return
      end if
    end if
    m.recaptureFront(variant, verts, edges, camera)
  end sub

  ' Captures the vertices of camera-facing faces, and the box edges that bound the model on
  ' screen or are nearest the camera (the crease between the two faces it sees) - the far
  ' edges are hidden, so they'd hint the wrong surface.
  private sub recaptureFront(variant as roAssociativeArray, verts as roAssociativeArray, edges as roAssociativeArray, camera as BGE.Camera3d)
    capture = {xs: [] as float[], ys: [] as float[], front: [] as integer[], direction: verts.direction, edgePoints: [] as integer[], edgeXs: [] as float[], edgeYs: [] as float[], knotX: [] as float[]}
    top = 1000000.0
    bottom = -1000000.0
    for i = 0 to m.modelVertices.count() - 1
      toCamera = BGE.Math.VectorOps.subtract(camera.position, m.modelVertices[i])
      if BGE.Math.VectorOps.dotProduct(m.modelNormals[i], toCamera) > 0
        capture.front.push(i)
        capture.xs.push(verts.xs[i])
        capture.ys.push(verts.ys[i])
        top = BGE.Math.Min(top, verts.ys[i])
        bottom = BGE.Math.Max(bottom, verts.ys[i])
      end if
    end for
    capture.top = top
    capture.bottom = bottom
    leftmost = 0
    rightmost = 0
    nearest = 0
    nearestDistance = 1000000000.0
    for e = 0 to 3
      x = edges.xs[e * 2]
      if x < edges.xs[leftmost * 2]
        leftmost = e
      end if
      if x > edges.xs[rightmost * 2]
        rightmost = e
      end if
      distance = BGE.Math.VectorOps.length(BGE.Math.VectorOps.subtract(edges.points[e * 2], camera.position))
      if distance < nearestDistance
        nearestDistance = distance
        nearest = e
      end if
    end for
    for e = 0 to 3
      if e = leftmost or e = rightmost or e = nearest
        capture.edgePoints.push(e * 2)
        capture.edgePoints.push(e * 2 + 1)
        capture.edgeXs.push(edges.xs[e * 2])
        capture.edgeXs.push(edges.xs[e * 2 + 1])
        capture.edgeYs.push(edges.ys[e * 2])
        capture.edgeYs.push(edges.ys[e * 2 + 1])
      end if
    end for
    ' the least-squares variant's knots: the same edges' captured x, in order
    hinted = BGE.ImpostorFit.fitColumnsToEdges(capture.edgeXs, capture.edgeYs, capture.edgeXs, capture.edgeYs)
    if invalid <> hinted.params
      capture.knotX = hinted.params.knotX
    end if
    variant.capture = capture
    variant.staleFrames = 0
    variant.counts.redraw++
  end sub

  private sub observeVariant(variant as roAssociativeArray, xs as float[], ys as float[], direction as BGE.Math.Vector)
    capture = variant.capture
    if invalid = capture or variant.staleFrames >= m.maxStaleFrames or m.angleDegrees(direction, capture.direction) > variant.maxAngleDegrees
      m.recapture(variant, xs, ys, direction)
      return
    end if
    tolerance = variant.tolerance
    if BGE.ImpostorFit.fitScaleTranslate(capture.xs, capture.ys, xs, ys).residual <= tolerance
      variant.counts.scale++
    else if BGE.ImpostorFit.fitRotateScale(capture.xs, capture.ys, xs, ys).residual <= tolerance
      variant.counts.rotate++
    else if BGE.ImpostorFit.fitAffine(capture.xs, capture.ys, xs, ys).residual <= tolerance
      variant.counts.pin++
    else
      m.recapture(variant, xs, ys, direction)
      return
    end if
    variant.staleFrames++
  end sub

  private sub recapture(variant as roAssociativeArray, xs as float[], ys as float[], direction as BGE.Math.Vector)
    variant.capture = {xs: xs, ys: ys, direction: direction}
    variant.staleFrames = 0
    variant.counts.redraw++
  end sub

  private function angleDegrees(a as BGE.Math.Vector, b as BGE.Math.Vector) as float
    cosine = BGE.Math.Min(1, BGE.Math.Max(-1, BGE.Math.VectorOps.dotProduct(a, b)))
    return BGE.Math.RadiansToDegrees(BGE.Math.Atan2(Sqr(1 - cosine * cosine), cosine))
  end function

  ' One line per variant: the share of moving frames each draw would take, and the chapel's
  ' estimated cost per moving frame against redrawing every frame.
  function describe() as string[]
    lines = [] as string[]
    for each variant in m.variants
      counts = variant.counts
      drawn = counts.scale + counts.rotate + counts.pin + counts.strip + counts.redraw
      if drawn = 0
        drawn = 1
      end if
      estimate = ((counts.scale + counts.rotate) * m.blitMs + counts.pin * m.pinMs + variant.stripTotal * m.stripMs + counts.redraw * m.redrawMs) / drawn
      line = variant.samples + " tol " + variant.tolerance.ToStr() + "px:"
      line += " scale " + m.percent(counts.scale, drawn) + " rotate " + m.percent(counts.rotate, drawn)
      line += " pin " + m.percent(counts.pin, drawn) + " strip " + m.percent(counts.strip, drawn)
      if counts.strip > 0
        line += " (avg " + m.format(variant.stripTotal / counts.strip) + " max " + variant.stripMax.ToStr() + " strips)"
      end if
      line += " redraw " + m.percent(counts.redraw, drawn)
      line += " | est " + m.format(estimate) + "ms vs " + m.format(m.redrawMs) + "ms (hidden " + counts.hidden.ToStr() + ")"
      lines.push(line)
    end for
    return lines
  end function

  private function percent(part as integer, whole as integer) as string
    return Int(100.0 * part / whole + 0.5).ToStr() + "%"
  end function

  private function format(value as float) as string
    return (Int(value * 10 + 0.5) / 10).ToStr()
  end function

end class
