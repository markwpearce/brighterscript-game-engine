import "ImpostorProbe.bs"

' Deep link `profile=1`: flies the camera along a fixed path (driven by frame index, not
' dt or input) once per occlusion configuration, and reports frame times for each.
class TerrainProfiler

  ' Frames before the first configuration, so loading/first-draw costs aren't measured.
  settleFrames = 60
  moveFrames = 240
  holdFrames = 120
  ' Frames skipped at the start of each segment.
  warmupFrames = 10

  configs = [
    ' fastExactClaim draws the chapel the way it would draw were it not an occluder
    {name: "off", occlusion: false, policy: BGE.OccluderDrawPolicy.fastExactClaim},
    {name: "exact", occlusion: true, policy: BGE.OccluderDrawPolicy.exact},
    {name: "fastShrink", occlusion: true, policy: BGE.OccluderDrawPolicy.fastShrink},
    {name: "fastExactClaim", occlusion: true, policy: BGE.OccluderDrawPolicy.fastExactClaim}
  ]

  results = [] as string[]
  done = false
  ' Whether each frame is also broken down by render stage (Renderer.profileStages).
  profileStages = false
  ' Set for profile=impostor.
  impostorProbe as ImpostorProbe = invalid

  ' Where WorldScene.addChapel() puts it.
  private chapelX = 80.0
  private chapelZ = -320.0
  private game as BGE.Game
  private camera as BGE.Camera3d
  private startPosition as BGE.Math.Vector
  ' -1 while settling
  private configIndex = -1
  ' The path frame the camera is posed for, -1 before the first.
  private pathFrame = -1
  private stats as roAssociativeArray

  sub new(game as BGE.Game, profileStages = false as boolean, profileImpostor = false as boolean)
    m.game = game
    m.camera = game.canvas.renderer.camera as BGE.Camera3d
    m.startPosition = BGE.Math.VectorOps.copy(m.camera.position)
    m.profileStages = profileStages
    if profileStages
      ' just occlusion off and the default policy, since timing every draw adds its own cost
      m.configs = [m.configs[0], m.configs[2]]
      game.canvas.renderer.profileStages = true
    end if
    if profileImpostor
      m.configs = [m.configs[2]]
      m.impostorProbe = new ImpostorProbe()
    end if
  end sub

  ' Call from the scene's onUpdate(). dt is how long the previous frame took.
  sub update(dt as float)
    if m.done
      return
    end if
    if m.pathFrame >= 0 and m.configIndex >= 0
      m.addSample(m.pathFrame, "ms", dt * 1000)
    end if
    nextFrame = m.pathFrame + 1
    if nextFrame >= m.getFrameCount()
      m.finishConfig()
      m.configIndex++
      if m.configIndex >= m.configs.count()
        m.done = true
        m.posePath(0)
        return
      end if
      m.startConfig()
      nextFrame = 0
    end if
    m.pathFrame = nextFrame
    m.posePath(nextFrame)
  end sub

  ' Call from the scene's onDrawEnd(), after the game canvas has rendered this frame.
  sub afterDraw(renderer as BGE.Renderer)
    if m.done or m.configIndex < 0 or m.pathFrame < 0
      return
    end if
    m.addSample(m.pathFrame, "drawCalls", renderer.getDrawCallsLastFrame())
    m.addSample(m.pathFrame, "occluded", renderer.getOccludedCountLastFrame())
    m.addSample(m.pathFrame, "occlusionMs", renderer.getOcclusionMsLastFrame())
    m.addSample(m.pathFrame, "tests", renderer.getOcclusionTestsLastFrame())
    if m.profileStages
      m.addStageSamples(m.pathFrame, renderer)
    end if
    if invalid <> m.impostorProbe and invalid <> m.getSegment(m.pathFrame)
      chapelEntity = m.game.getEntityByName("Chapel")
      if invalid <> chapelEntity
        sceneObjects = chapelEntity.getDrawable("chapel").getSceneObjects()
        if sceneObjects.count() > 0
          m.impostorProbe.observe(sceneObjects[0], m.camera, m.pathFrame < m.moveFrames)
        end if
      end if
    end if
  end sub

  ' Adds up each render stage's time (and count) over the segment, so averages are per frame.
  private sub addStageSamples(frame as integer, renderer as BGE.Renderer)
    segment = m.getSegment(frame)
    if invalid = segment
      return
    end if
    stageMs = renderer.getStageMsLastFrame()
    stageCounts = renderer.getStageCountsLastFrame()
    for each name in stageMs
      if invalid = segment.stageMs[name]
        segment.stageMs[name] = 0
        segment.stageCounts[name] = 0
      end if
      segment.stageMs[name] += stageMs[name]
      segment.stageCounts[name] += stageCounts[name]
    end for
    segment.stageFrames++
  end sub

  function getStatusText() as string
    if m.done
      return "Profile done (quality " + m.game.renderQuality.getLevel().ToStr() + ")" + Chr(10) + m.results.Join(Chr(10))
    end if
    if m.configIndex < 0
      return "Profile: settling"
    end if
    return "Profile: " + m.configs[m.configIndex].name + " frame " + m.pathFrame.ToStr()
  end function

  private function getFrameCount() as integer
    if m.configIndex < 0
      return m.settleFrames
    end if
    return m.moveFrames + m.holdFrames
  end function

  private sub startConfig()
    config = m.configs[m.configIndex]
    renderer = m.game.canvas.renderer
    renderer.occlusionCullingEnabled = config.occlusion
    renderer.occluderDrawPolicy = config.policy
    m.stats = {
      moving: {ms: [], drawCalls: [], occluded: [], occlusionMs: [], tests: [], stageMs: {}, stageCounts: {}, stageFrames: 0},
      still: {ms: [], drawCalls: [], occluded: [], occlusionMs: [], tests: [], stageMs: {}, stageCounts: {}, stageFrames: 0}
    }
  end sub

  private sub addSample(frame as integer, key as string, value as float)
    segment = m.getSegment(frame)
    if invalid <> segment
      segment[key].push(value)
    end if
  end sub

  ' The stats a path frame's samples go into, or invalid while settling or warming up.
  private function getSegment(frame as integer) as roAssociativeArray
    if m.configIndex < 0
      return invalid
    end if
    segment = m.stats.moving
    segmentFrame = frame
    if frame >= m.moveFrames
      segment = m.stats.still
      segmentFrame = frame - m.moveFrames
    end if
    if segmentFrame < m.warmupFrames
      return invalid
    end if
    return segment
  end function

  private sub finishConfig()
    if m.configIndex < 0
      return
    end if
    moving = m.stats.moving
    still = m.stats.still
    line = m.configs[m.configIndex].name + ": moving " + m.describeSegment(moving) + " | still " + m.describeSegment(still)
    print "[terrain profile] " + line
    m.results.push(line)
    if invalid <> m.impostorProbe
      for each probeLine in m.impostorProbe.describe()
        print "[terrain profile] impostor " + probeLine
      end for
    end if
    if m.profileStages
      name = m.configs[m.configIndex].name
      print "[terrain profile] " + name + " stages moving: " + m.describeStages(moving)
      print "[terrain profile] " + name + " stages still: " + m.describeStages(still)
    end if
  end sub

  ' Each stage's average ms per frame, with how many objects a draw stage drew per frame.
  private function describeStages(segment as roAssociativeArray) as string
    frames = BGE.Math.Max(1, segment.stageFrames)
    parts = [] as string[]
    names = segment.stageMs.Keys()
    names.Sort()
    for each name in names
      part = name + " " + m.format(segment.stageMs[name] / frames)
      if name.StartsWith("draw") or name.StartsWith("onScreenCheck") or name.StartsWith("canvasPosition") or name.StartsWith("performDraw") or (name.StartsWith("update") and name <> "update")
        part += " (x" + m.format(segment.stageCounts[name] / frames) + ")"
      end if
      parts.push(part)
    end for
    return parts.Join(", ")
  end function

  ' Averages for one segment; occlusion ms and tests are the occlusion pass's own cost.
  private function describeSegment(segment as roAssociativeArray) as string
    text = "avg " + m.format(m.average(segment.ms)) + "ms worst " + m.format(m.maximum(segment.ms)) + "ms"
    text += " occl " + m.format(m.average(segment.occlusionMs)) + "ms tests " + m.format(m.average(segment.tests))
    return text + " occluded " + m.format(m.average(segment.occluded)) + " draws " + m.format(m.average(segment.drawCalls))
  end function

  ' Strafes right, then left, then back to the middle while edging forward, turning to keep
  ' the chapel in view, so the trees behind it slide in and out of its shadow. Then holds.
  private sub posePath(frame as integer)
    t = BGE.Math.Min(frame, m.moveFrames) / m.moveFrames
    x = m.startPosition.x + 200 * Sin(2 * BGE.Math.PI * t)
    z = m.startPosition.z - 60 * t
    m.camera.position = BGE.Math.VectorOps.create(x, m.startPosition.y, z)
    ' starts at the normal view straight ahead, and turns toward the chapel over the first tenth
    towardChapel = Atn((m.chapelX - x) / (z - m.chapelZ))
    heading = towardChapel * BGE.Math.Min(1, t * 10)
    m.camera.orientation = BGE.Math.VectorOps.create(Sin(heading), 0, -Cos(heading))
  end sub

  private function average(values as float[]) as float
    if values.count() = 0
      return 0
    end if
    total = 0.0
    for each value in values
      total += value
    end for
    return total / values.count()
  end function

  private function maximum(values as float[]) as float
    result = 0.0
    for each value in values
      result = BGE.Math.Max(result, value)
    end for
    return result
  end function

  private function format(value as float) as string
    return (Int(value * 10 + 0.5) / 10).ToStr()
  end function

end class
