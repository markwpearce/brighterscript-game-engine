sub main()
  'testMap()
  'return
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.scaleCanvasToFillScreen()
  game.setCamera(new BGE.Camera3d())


  'try

  game.loadBitmap("mariokart", "pkg:/sprites/SuperMarioKartMapMushroomCup1.png")
  game.loadBitmap("checkerboard", "pkg:/sprites/checkerboard.png")

  game.loadBitmap("roku", "pkg:/sprites/roku-logo-purple.png")
  main_Room = new MainRoom(game)
  game.defineRoom(main_Room)

  game.changeRoom(game.getRoomNames()[0])

  game.getDebugUI().addChild(new BGE.Debug.FpsDisplay(game))
  game.getDebugUI().addChild(new BGE.Debug.InputDisplay(game))

  game.getDebugUI().addChild(new BGE.Debug.MemoryDisplay(game))
  game.getDebugUI().addChild(new BGE.Debug.GarbageCollectorDisplay(game))

  ' game.debugDrawColliders(true)
  game.debugDrawEntityDetails(true)
  game.debugShowUi(true, true)
  'game.canvas.renderer.drawDebugCells = true
  game.Play()


end sub



sub testMap()
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  'game.scaleCanvasToFillScreen()
  game.canvas.renderer.drawDebugCells = true

  camera = new BGE.Camera3d()
  game.canvas.renderer.setCamera(camera)

  game.loadBitmap("mariokart", "pkg:/sprites/SuperMarioKartMapMushroomCup1.png")
  game.loadBitmap("checkerboard", "pkg:/sprites/checkerboard.png")

  ' scratchBmp = CreateObject("roBitmap", {width: game.canvas.getWidth(), height: game.canvas.getHeight(), AlphaEnable: true})
  ' scratchRegion = CreateObject("roRegion", scratchBmp, 0, 0, 200, 200)
  marioKartBmp = game.getBitmap("mariokart")
  bmpRegion = CreateObject("roRegion", marioKartBmp, 0, 76, 1024, 1024)

  'checkerboardBmp = game.getBitmap("checkerboard")
  'bmpRegion = CreateObject("roRegion", checkerboardBmp, 0, 0, 1000, 1000)

  mapRegion = BGE.RendererHelpers.createRegionWithId(bmpRegion, "map")

  rot = 0

  nearDistance = 50
  farDistance = 600
  'farWidth = sin(BGE.Math.DegreesToRadians(90) / 2) * farDistance * 2

  uiMapHeight = 200
  mapScale = uiMapHeight / mapRegion.region.GetHeight()
  mapXOffset = 1000 ' where is the left edge of the map drawn on the screen
  mapYOffset = 50 ' where is the top edge of the map drawn on the screen

  preperspectiveOffset = 50

  finalHeight = farDistance - nearDistance
  finalWidth = (finalHeight) * tan(BGE.Math.DegreesToRadians(camera.fieldOfViewDegrees) / 2) * 2
  prePerspectiveBmp = CreateObject("roBitmap", {width: finalWidth, height: finalHeight, AlphaEnable: true})

  time = CreateObject("roTimeSpan")
  time.Mark()
  center = {x: bmpRegion.GetWidth() / 2, y: 5, z: bmpRegion.GetHeight() / 2}

  drawMiniMap = true
  drawPrePerspectiveBmp = true
  sliceCount = 50

  mapPlane = {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}
  mapOffset = {x: 500, y: 500, z: 0}

  m.rotSpeed = 0.1
  m.walkSpeed = 0.1
  universalControlEvents = []
  m.buttonHeld = -1
  m.buttonHeldTimer = CreateObject("roTimeSpan")
  m.screen_port = (game["screen_port"] as roMessagePort)
  m.camera = camera
  m.mapPlane = mapPlane
  camera.position = center
  while true
    screenMsg = m.screen_port.GetMessage()
    while screenMsg <> invalid
      if type(screenMsg) = "roUniversalControlEvent" and screenMsg.GetInt() <> 11
        universalControlEvents.Push(screenMsg as roUniversalControlEvent)
        if screenMsg.GetInt() < 100
          m.buttonHeld = screenMsg.GetInt()
          m.buttonHeldTimer.Mark()
        else
          m.buttonHeld = -1
        end if
      end if
      screenMsg = m.screen_port.GetMessage()
    end while
    m.buttonHeldTimeMs = m.buttonHeldTimer.TotalMilliseconds()

    m.camera.checkMovement()
    if m.camera.movedLastFrame() or invalid = m.camera.worldToCamera
      m.camera.computeWorldToCameraMatrix()
    end if



    'rotationRad = BGE.Math.DegreesToRadians(rot)


    ' camera.position = center
    'camera.orientation = BGE.Math.RotateVectorAroundPoint3d(
    'camera.orientation,
    '{x: 0, y: 0, z: 0},
    'mapPlane.normal,
    '- rotationRad
    ')
    BGE.Math.VectorOps.normalize(camera.orientation)
    '{
    '  x: center.x + dist * cos(rotationRad),
    '  y: center.y,
    '  z: center.y + dist * sin(rotationRad)
    '}

    'cp = getPerspectivePoints({
    '  x: center.x + dist * cos(rotationRad),
    '  y: center.y + dist * sin(rotationRad),
    '  z: center.z
    '}, fov, rotationRad, nearDistance, farDistance)


    perspectivePoints = getPerspectivePointsByCamera(camera, mapPlane, mapOffset, farDistance)


    if invalid <> perspectivePoints
      mapped as BGE.Math.CornerPoints = perspectivePoints.mapped

      gotPreBmp = populatePerspectiveBmp(game, mapped, mapRegion.region, prePerspectiveBmp)

      if drawMiniMap
        game.canvas.renderer.drawScaledObject(mapXOffset, mapYOffset, mapScale, mapScale, mapRegion.region, BGE.RGBAtoRGBA(255, 255, 255, 0.5))
        colors = [BGE.Colors().Red, BGE.Colors().Green, BGE.Colors().Blue, BGE.Colors().Yellow]
        i = 0
        for each point in mapped.toArray()
          game.canvas.renderer.drawSquare(point.x * mapScale + mapXOffset, point.y * mapScale + mapYOffset, 5, colors[i])
          i++
        end for
        cameraPointOnPlane = BGE.Math.closestPointOnPlane(mapPlane, camera.position)

        game.canvas.renderer.drawLine(cameraPointOnPlane.x * mapScale + mapXOffset, cameraPointOnPlane.z * mapScale + mapYOffset, mapped.topLeft.x * mapScale + mapXOffset, mapped.topLeft.y * mapScale + mapYOffset, BGE.Colors().White)
        game.canvas.renderer.drawLine(cameraPointOnPlane.x * mapScale + mapXOffset, cameraPointOnPlane.z * mapScale + mapYOffset, mapped.topRight.x * mapScale + mapXOffset, mapped.topRight.y * mapScale + mapYOffset, BGE.Colors().White)
        game.canvas.renderer.drawLine(cameraPointOnPlane.x * mapScale + mapXOffset, cameraPointOnPlane.z * mapScale + mapYOffset, mapped.bottomLeft.x * mapScale + mapXOffset, mapped.bottomLeft.y * mapScale + mapYOffset, BGE.Colors().White)
        game.canvas.renderer.drawLine(cameraPointOnPlane.x * mapScale + mapXOffset, cameraPointOnPlane.z * mapScale + mapYOffset, mapped.bottomRight.x * mapScale + mapXOffset, mapped.bottomRight.y * mapScale + mapYOffset, BGE.Colors().White)
        game.canvas.renderer.drawSquare(cameraPointOnPlane.x * mapScale + mapXOffset, cameraPointOnPlane.z * mapScale + mapYOffset, 5, BGE.Colors().Pink)
      end if


      if gotPreBmp

        if drawPrePerspectiveBmp
          prePBmpDrawScale = 0.5
          game.canvas.renderer.drawScaledObject(preperspectiveOffset, preperspectiveOffset, prePBmpDrawScale, prePBmpDrawScale, prePerspectiveBmp)
          centerOfprePerspectiveBmp = {x: prePerspectiveBmp.getWidth() / 2 * prePBmpDrawScale + preperspectiveOffset, y: (prePerspectiveBmp.getHeight() + nearDistance) * prePBmpDrawScale + preperspectiveOffset}
          game.canvas.renderer.drawLine(centerOfprePerspectiveBmp.x, centerOfprePerspectiveBmp.y, preperspectiveOffset, preperspectiveOffset, BGE.Colors().White)
          game.canvas.renderer.drawLine(centerOfprePerspectiveBmp.x, centerOfprePerspectiveBmp.y, prePerspectiveBmp.getWidth() * prePBmpDrawScale + preperspectiveOffset, preperspectiveOffset, BGE.Colors().White)
        end if

        drawPerspectiveBmpSlicesToByCamera(game, game.screen, prePerspectiveBmp, camera, perspectivePoints.actual, perspectivePoints.horizon, nearDistance, farDistance, sliceCount)
      else
        print "failed to populate perspective bmp"
      end if
    end if

    game.screen.DrawScaledObject(game.canvas.offset.x, game.canvas.offset.y, game.canvas.scale.x, game.canvas.scale.y, game.canvas.bitmap)
    game.screen.swapBuffers()

    game.canvas.renderer.onSwapBuffers()
    game.canvas.renderer.resetDrawCallCounter()
    timeDelta = time.TotalMilliseconds()
    time.Mark()
    'rot = rotSpeed * timeDelta / 1000
    ' game.canvas.bitmap.Clear(&h000000FF)

    if not handleInput(universalControlEvents, timeDelta)
      universalControlEvents = []
    end if
  end while
  return

end sub


function handleInput(universalControlEvents as object[], delta as float) as boolean
  for each msg in universalControlEvents

    if m.buttonHeld <> -1
      ' Button release codes are 100 plus the button press code
      ' This shows a button held code as 1000 plus the button press code
      input = (new BGE.GameInput(1000 + m.buttonHeld, m.buttonHeldTimeMs))
      print input.button; " held for "; input.heldTimeMs; " ms"

      m.camera.orientation = BGE.Math.RotateVectorAroundPoint3d(
      m.camera.orientation,
      {x: 0, y: 0, z: 0},
      m.camera.GetUpVector(),
      BGE.Math.DegreesToRadians(-input.x * delta * m.rotSpeed)
      )
      if input.y <> 0
        m.camera.position = BGE.Math.VectorOps.add(m.camera.position, BGE.Math.VectorOps.scale(m.camera.orientation, input.y * delta * m.walkSpeed))
      end if

      if input.isButton("FastForward")
        m.camera.position.y += delta * m.walkSpeed
      end if
      if input.isButton("Rewind")
        m.camera.position.y -= delta * m.walkSpeed
      end if

      if input.isButton("Options") or input.isButton("Play")

        change = input.isButton("Options") ? 1 : -1

        m.camera.orientation = BGE.Math.RotateVectorAroundPoint3d(
        m.camera.orientation,
        {x: 0, y: 0, z: 0},
        m.camera.GetRightVector(),
        BGE.Math.DegreesToRadians(change * delta * m.rotSpeed / 20)
        )
      end if

    else
      return false
    end if

  end for
  return true
end function



interface PerspectiveCalculationResult
  actual as BGE.Math.CornerPoints
  mapped as BGE.Math.CornerPoints
  horizon as BGE.Math.Vector[]
end interface



function getPerspectivePointsByCamera(camera as BGE.Camera3d, plane as BGE.Math.Plane, mapOffset as BGE.Math.Vector, farDistance as float) as PerspectiveCalculationResult


  camera.onCameraMovement()

  rays = camera.frustumRays


  output = new BGE.Math.CornerPoints()

  output.topRight = BGE.Math.intersectRayWithPlane(plane, rays.topRight)
  output.topLeft = BGE.Math.intersectRayWithPlane(plane, rays.topLeft)
  output.bottomRight = BGE.Math.intersectRayWithPlane(plane, rays.bottomRight)
  output.bottomLeft = BGE.Math.intersectRayWithPlane(plane, rays.bottomLeft)

  horizonOrig = camera.getHorizonLine(plane)
  horizon = []
  for each pt in horizonOrig
    converted = camera.cameraPointToScreenPoint(pt)
    print "horizon point: "; pt; converted
    horizon.Push(converted)
  end for


  cameraHeight = BGE.Math.distanceFromPointToPlane(plane, camera.position)

  vertFov = camera.getVerticalFOV()
  horizFov = camera.fieldOfViewDegrees


  cameraPointOnPlane = BGE.Math.closestPointOnPlane(plane, camera.position)

  targetOnPlane = BGE.Math.intersectRayWithPlane(plane, {origin: camera.position, direction: camera.orientation})

  if targetOnPlane <> invalid
    print "camera looks directly at point on plane: "; targetOnPlane
  end if


  if output.topRight = invalid and output.topLeft = invalid and output.bottomRight = invalid and output.bottomLeft = invalid
    ' camera can not see the plane at all
    return invalid
  end if


  projectedRay = BGE.Math.projectRayOntoPlane(plane, {origin: camera.position, direction: camera.orientation})
  if projectedRay = invalid
    print "failed to project camera ray onto plane"
    return invalid
  end if

  scaledOrientationFromCameraPointOnPlane = BGE.Math.VectorOps.add(cameraPointOnPlane, BGE.Math.VectorOps.scale(BGE.Math.VectorOps.getNormalizedCopy(projectedRay.direction), farDistance))

  if invalid = output.topRight
    output.topRight = BGE.Math.RotateVectorAroundPoint3d(
    scaledOrientationFromCameraPointOnPlane,
    cameraPointOnPlane,
    plane.normal,
    BGE.Math.DegreesToRadians(-horizFov / 2)
    )
  end if
  if invalid = output.topLeft
    output.topLeft = BGE.Math.RotateVectorAroundPoint3d(
    scaledOrientationFromCameraPointOnPlane,
    cameraPointOnPlane,
    plane.normal,
    BGE.Math.DegreesToRadians(horizFov / 2)
    )
  end if
  if invalid = output.bottomRight
    output.bottomRight = BGE.Math.RotateVectorAroundPoint3d(
    scaledOrientationFromCameraPointOnPlane,
    cameraPointOnPlane,
    plane.normal,
    BGE.Math.DegreesToRadians(horizFov / 2)
    )
  end if
  if invalid = output.bottomLeft
    output.bottomLeft = BGE.Math.RotateVectorAroundPoint3d(
    scaledOrientationFromCameraPointOnPlane,
    cameraPointOnPlane,
    plane.normal,
    - BGE.Math.DegreesToRadians(horizFov / 2)
    )
  end if

  mapped = new BGE.Math.CornerPoints()

  mapped.topRight = BGE.Math.VectorOps.switchYAndZ(output.topRight)
  mapped.topLeft = BGE.Math.VectorOps.switchYAndZ(output.topLeft)
  mapped.bottomRight = BGE.Math.VectorOps.switchYAndZ(output.bottomRight)
  mapped.bottomLeft = BGE.Math.VectorOps.switchYAndZ(output.bottomLeft)



  return {actual: output, mapped: mapped, horizon: horizon}
end function






function populatePerspectiveBmp(game as BGE.Game, cp as BGE.Math.CornerPoints, srcRegion as ifDraw2D, destRegion as ifDraw2D) as boolean
  if invalid = cp
    return false
  end if

  rotation = BGE.Math.atan2(cp.topRight.y - cp.topLeft.y, cp.topRight.x - cp.topLeft.x)
  footInfo = BGE.Math.TriangleOps.getPerpendicularFootFromPoint(cp.topLeft, cp.topRight, cp.bottomRight)

  horizScale = destRegion.GetWidth() / BGE.Math.TotalDistance(cp.topLeft, cp.topRight)
  vertScale = destRegion.GetHeight() / footInfo.distanceToPoint
  scratchRegion = game.canvas.renderer.bmpPool.getRegion(srcRegion.GetWidth(), srcRegion.GetHeight())

  if scratchRegion = invalid
    print "failed to get scratch region from pool"
    return false
  end if


  worked = game.canvas.renderer.drawRotatedImageWithCenterTo(scratchRegion.region, srcRegion, cp.topLeft, rotation, BGE.Math.VectorOps.negative(cp.topLeft))
  worked = worked and game.canvas.renderer.drawScaledObjectTo(destRegion, 0, 0, horizScale, vertScale, scratchRegion.region)
  if worked
    '  game.canvas.renderer.forceDraw(destRegion)
  else
    print "failed to draw perspective bmp"
  end if
  game.canvas.renderer.bmpPool.returnRegion(scratchRegion)

  return worked
end function



function drawPerspectiveBmpSlicesToByCamera(game as BGE.Game, destBmp as ifDraw2D, srcBmp as ifDraw2D, camera as BGE.Camera3d, cp as BGE.Math.CornerPoints, horizon as BGE.Math.Vector[], nearDistance as float, farDistance as float, maxSliceCount as integer) as boolean

  fovDeg = camera.fieldOfViewDegrees
  origin = camera.position
  slices as PerspectiveSlice[] = []
  halfFov = BGE.Math.DegreesToRadians(fovDeg / 2)
  destWidth = 1280
  srcTop = srcBmp.GetHeight()
  srcSliceWidth = srcTop / maxSliceCount
  midWidthBmp = srcBmp.GetWidth() / 2

  theta = BGE.Math.Atan2(nearDistance, origin.z)
  cummulativeHeight = 0'nearDistance
  tanHalfFov = tan(halfFov)
  i = 0

  firstHeight = 50

  slicePt = cp.bottomLeft
  leftLineSegment = BGE.Math.VectorOps.subtract(cp.topLeft, cp.bottomLeft)
  actualSliceVector = BGE.Math.VectorOps.scale(leftLineSegment, srcSliceWidth / BGE.Math.VectorOps.length(leftLineSegment))
  for i = 0 to maxSliceCount - 1
    distanceToSlice = nearDistance + srcSliceWidth * i
    distanceToNextSlice = distanceToSlice + srcSliceWidth
    'theta = BGE.Math.Atan2(distanceToNextSlice, origin.z)
    halfSliceWidth = distanceToNextSlice * tanHalfFov
    nextSlicePoint = BGE.Math.VectorOps.add(slicePt, actualSliceVector)

    theta = BGE.Math.GetAngleBetweenVectors(origin, slicePt, nextSlicePoint)
    slicePt = nextSlicePoint
    'destHeight = distanceToSlice * tan(theta) - tan(lastTheta) * 4'3
    destHeight = Cint(BGE.Tweens.ExponentialEaseOut(firstHeight, 1, i, maxSliceCount)) '(distanceToNextSlice * tan(BGE.math.HALF_PI - theta) - cummulativeHeight)

    'destHeight = 50 * tan(theta)
    cummulativeHeight += destHeight
    if destHeight < 1
      destHeight = 1
    end if
    sliceWidth = BGE.Math.Max(1, (halfSliceWidth * 2))
    slices.push({
      srcWidth: halfSliceWidth * 2,
      srcHeight: srcSliceWidth,
      srcTopLeft: {x: midWidthBmp - halfSliceWidth, y: srcTop - srcSliceWidth * (i + 1)},
      destHeight: destHeight,
      scaleX: destWidth / sliceWidth,
      scaleY: (destHeight) / srcSliceWidth
    })
  end for

  destTop = 0

  worked = true
  destTop = game.screen.GetHeight()
  horizonY = destTop / 2

  horizonY = horizon[0].y ' TODO: need to account for camera roll

  vertScale = (destTop - horizonY) / cummulativeHeight

  'print "Vertical scale: "; vertScale

  for i = 0 to slices.count() - 1
    'print "drawing slice "; i;" - destHeight: "; slices[i].destHeight; " - scaleY: "; slices[i].scaleY

    slice = slices[i]
    destTop -= cint(slice.destHeight * vertScale)
    sliceRegion = CreateObject("roRegion", srcBmp, slice.srcTopLeft.x, slice.srcTopLeft.y, slice.srcWidth, slice.srcHeight)

    sliceVertScale = slice.scaleY * vertScale
    worked = game.canvas.renderer.drawScaledObject(0, destTop, slice.scaleX, sliceVertScale, sliceRegion) and worked

  end for



  return worked
end function

interface PerspectiveSlice
  srcWidth as float
  srcHeight as float
  srcTopLeft as BGE.PositionXY
  destHeight as float
  scaleX as float
  scaleY as float
end interface
