sub testMap()
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.scaleCanvasToFillScreen()
  game.canvas.renderer.drawDebugCells = true
  game.loadBitmap("mariokart", "pkg:/sprites/SuperMarioKartMapMushroomCup1.png")
  game.loadBitmap("checkerboard", "pkg:/sprites/checkerboard.png")

  ' scratchBmp = CreateObject("roBitmap", {width: game.canvas.getWidth(), height: game.canvas.getHeight(), AlphaEnable: true})
  ' scratchRegion = CreateObject("roRegion", scratchBmp, 0, 0, 200, 200)
  marioKartBmp = game.getBitmap("mariokart")
  bmpRegion = CreateObject("roRegion", marioKartBmp, 0, 76, 1024, 1024)

  '  checkerboardBmp = game.getBitmap("checkerboard")
  ' bmpRegion = CreateObject("roRegion", checkerboardBmp, 0, 0, 1000, 1000)

  mapRegion = BGE.RendererHelpers.createRegionWithId(bmpRegion, "map")

  rot = 0
  bevel = 0' 30
  planeBmpWidth = 480
  planeBmpHeight = 240
  planeBmpScale = 2


  yTop = 0 ' 400
  yBot = planeBmpHeight '720 - bevel
  xLeft = 0 + bevel
  xRight = planeBmpWidth' 1280 - bevel
  destTL = {x: xLeft, y: yTop, z: 0}
  destTR = {x: xRight, y: yTop, z: 0}
  destBL = {x: xLeft, y: yBot, z: 0}
  destBR = {x: xRight, y: yBot, z: 0}
  destCenter = {x: (xRight + xLeft) / 2, y: 0 + (yBot - yTop) / 4, z: 0}

  fov = 60

  halfBottomWidthInView = sin(BGE.Math.DegreesToRadians(fov) / 2) * 50
  nearDistance = 50
  farDistance = 400
  'farWidth = sin(BGE.Math.DegreesToRadians(90) / 2) * farDistance * 2

  bottomScale = (BGE.Math.TotalDistance(destTL, destTR) / 2) / halfBottomWidthInView
  'halfBottomDiff = BGE.Math.TotalDistance(destTL, destTR) / 2 - halfBottomWidthInView
  halfExtraBottom = (BGE.Math.TotalDistance(destTL, destTR) / 2) - halfBottomWidthInView
  scaledExtra = halfExtraBottom * 2' bottomScale
  'destBL = {x: xLeft - scaledExtra, y: yBot, z: 0}
  'destBR = {x: xRight + scaledExtra, y: yBot, z: 0}
  destBL = {x: xLeft, y: yBot, z: 0}
  destBR = {x: xRight, y: yBot, z: 0}


  destPoints = [
    [
      destTL,
      destCenter,
      destTR,

    ],
    [
      destTR,
      destCenter,
      destBR,

    ], [destBR,
      destCenter,
      destBL,

    ], [
      destBL,
      destCenter,
      destTL,
  ]]

  triIndex = 0

  for each tri in destPoints
    ptIndex = 0
    for each pt in tri
      tri[ptIndex] = BGE.Math.VectorOps.copy(pt)' bs:disable-line 1001
      ' tri[ptIndex].y += (100 * triIndex) 'bs:disable-line 1001
      ptIndex++
    end for
    triIndex++
  end for


  uiMapHeight = 200
  mapScale = uiMapHeight / mapRegion.region.GetHeight()
  mapXOffset = 1000' game.screen.GetWidth() / 2 - (mapRegion.region.GetWidth() * mapScale) / 2
  drawTris = [false, false, false, false]


  planeBmp = CreateObject("roBitmap", {width: planeBmpWidth, height: planeBmpHeight, AlphaEnable: true})
  finalHeight = farDistance - nearDistance
  finalWidth = (finalHeight) * cos(BGE.Math.DegreesToRadians(fov) / 2) * 2
  prePerspectiveBmp = CreateObject("roBitmap", {width: finalWidth, height: finalHeight, AlphaEnable: true})

  time = CreateObject("roTimeSpan")
  time.Mark()

  while true
    'planeBmp.Clear(255)
    'srcPoints = getPerspectiveTriangles({x: 512, y: 512, z: 0}, 90, BGE.Math.DegreesToRadians(rot), 50, 400)
    srcPerspectivePoints = getPerspectivePoints({x: 500, y: 500, z: 0}, fov, BGE.Math.DegreesToRadians(rot), nearDistance, farDistance)
    srcCenter = srcPerspectivePoints.getDiagonalIntersection()

    srcPoints2 = [[
      srcPerspectivePoints.topLeft,
      srcPerspectivePoints.bottomRight,
      srcPerspectivePoints.topRight,
    ], [
      srcPerspectivePoints.bottomRight
      srcPerspectivePoints.topLeft,
      srcPerspectivePoints.bottomLeft,
    ]]

    srcPoints3 = [[
      srcPerspectivePoints.topLeft,
      srcCenter
      srcPerspectivePoints.topRight,
    ], [
      srcPerspectivePoints.topRight,
      srcCenter
      srcPerspectivePoints.bottomRight,
    ], [
      srcPerspectivePoints.bottomRight,
      srcCenter
      srcPerspectivePoints.bottomLeft,
    ], [
      srcPerspectivePoints.bottomLeft,
      srcCenter
      srcPerspectivePoints.topLeft,
    ]]

    scaledSrcPoints = []
    for each tri in srcPoints3
      scaledTri = []
      for each pt in tri
        scaledTri.push({x: pt.x * mapScale, y: pt.y * mapScale, z: 0}) 'bs:disable-line 1001
      end for
      scaledSrcPoints.push(scaledTri)
    end for

    game.canvas.renderer.drawScaledObject(mapXOffset, 50, mapScale, mapScale, mapRegion.region, BGE.RGBAtoRGBA(255, 255, 255, 0.5))

    rotationRad = BGE.Math.DegreesToRadians(rot)
    dist = 100
    cp = getPerspectivePoints({x: 500 + dist * cos(rotationRad), y: 500 + dist * sin(rotationRad), z: 0}, fov, rotationRad, nearDistance, farDistance)
    if invalid <> cp
      gotPreBmp = populatePerspectiveBmp(game, cp, rotationRad, mapRegion.region, prePerspectiveBmp)
      colors = [BGE.Colors().Red, BGE.Colors().Green, BGE.Colors().Blue, BGE.Colors().Yellow]
      i = 0
      for each point in cp.toArray()
        game.canvas.renderer.drawSquare(point.x * mapScale + mapXOffset, point.y * mapScale + 50, 5, colors[i])
        i++
      end for
      if gotPreBmp
        game.canvas.renderer.drawScaledObject(50, 50, 0.5, 0.5, prePerspectiveBmp)
        drawPerspectiveBmpSlicesTo(game, game.screen, prePerspectiveBmp, {x: 500, y: 500, z: 50}, fov, nearDistance, farDistance, 100)
      end if
    end if


    for i = 0 to 3
      if drawTris[i]
        src = []
        for each pt in srcPoints3[i]
          src.push(BGE.Math.VectorOps.copy(pt))'bs:disable-line 1001
        end for
        dest = []
        for each pt in destPoints[i]
          dest.push(BGE.Math.VectorOps.copy(pt))'bs:disable-line 1001
        end for
        game.canvas.renderer.drawBitmapTriangleTo(planeBmp, mapRegion, src, dest)
        'game.canvas.renderer["bmpPool"].returnStagedRegions()
        game.canvas.renderer.drawObject((1280 - planeBmpWidth) / 2, 300, planeBmp)
        game.canvas.renderer.drawTrianglePoints(scaledSrcPoints[i], 5, {x: mapXOffset, y: 0})
        game.canvas.renderer.drawTrianglePointsTo(planeBmp, destPoints[i])

      end if

    end for
    game.canvas.renderer.drawScaledObject((1280 - (planeBmpWidth * planeBmpScale)) / 2, 300, planeBmpScale, planeBmpScale, planeBmp)
    game.screen.DrawScaledObject(game.canvas.offset.x, game.canvas.offset.y, game.canvas.scale.x, game.canvas.scale.y, game.canvas.bitmap)
    game.screen.swapBuffers()

    game.canvas.renderer.onSwapBuffers()
    game.canvas.renderer.resetDrawCallCounter()
    timeDelta = time.TotalMilliseconds()
    time.Mark()
    rot += 30 * timeDelta / 1000

  end while
  return

end sub


function getPerspectiveTriangles(origin as BGE.Math.Vector, fovDegrees as float, rotation as float, nearDistance as float, farDistance as float) as BGE.Math.Vector[][]
  midDistance = (farDistance / 2 + nearDistance)
  cp = getPerspectivePoints(origin, fovDegrees, rotation, nearDistance, farDistance)

  center = {x: origin.x + midDistance * cos(rotation), y: origin.y + midDistance * sin(rotation), z: 0}
  topLeft = cp.topLeft
  topRight = cp.topRight
  bottomLeft = cp.bottomLeft
  bottomRight = cp.bottomRight
  output = [
    '[topRight, topLeft, origin,]
    [topLeft, center, topRight],

    [topRight, center, bottomRight],

    [bottomLeft, bottomRight, center,],

    [bottomLeft, center, topLeft],

  ]
  return output
end function

function getPerspectivePoints(origin as BGE.Math.Vector, fovDegrees as float, rotation as float, nearDistance as float, farDistance as float) as BGE.Math.CornerPoints
  fov = BGE.Math.DegreesToRadians(fovDegrees)
  halfFov = fov / 2
  topRight = {x: origin.x + farDistance * cos(rotation + halfFov), y: origin.y + farDistance * sin(rotation + halfFov), z: 0}
  bottomRight = {x: topRight.x + (farDistance - nearDistance) * cos(BGE.Math.PI + rotation), y: topRight.y + (farDistance - nearDistance) * sin(BGE.Math.PI + rotation), z: 0}


  topLeft = {x: origin.x + farDistance * cos(rotation - halfFov), y: origin.y + farDistance * sin(rotation - halfFov), z: 0}

  bottomLeft = {x: topLeft.x + (farDistance - nearDistance) * cos(BGE.Math.PI + rotation), y: topLeft.y + (farDistance - nearDistance) * sin(BGE.Math.PI + rotation), z: 0}

  output = new BGE.Math.CornerPoints()
  output.topRight = topRight
  output.topLeft = topLeft
  output.bottomRight = bottomRight
  output.bottomLeft = bottomLeft
  return output
end function


function populatePerspectiveBmp(game as BGE.Game, cp as BGE.Math.CornerPoints, rotation as float, srcRegion as ifDraw2D, destRegion as ifDraw2D) as boolean
  if invalid = cp
    return false
  end if

  worked = game.canvas.renderer.drawRotatedImageWithCenterTo(destRegion, srcRegion, cp.topLeft, BGE.Math.HALF_PI + rotation, BGE.Math.VectorOps.negative(cp.topLeft))
  if worked
    game.canvas.renderer.forceDraw(destRegion)'(destRegion, srcRegion, cp.topRight, BGE.Math.HALF_PI + rotation, BGE.Math.VectorOps.negative(cp.topRight)) and worked
  else
    print "failed to draw perspective bmp"
  end if
  return worked
end function


function drawPerspectiveBmpSlicesTo(game as BGE.Game, destBmp as ifDraw2D, srcBmp as ifDraw2D, origin as BGE.Math.Vector, fovRad as float, nearDistance as float, farDistance as float, maxSliceCount as integer) as boolean

  slices as PerspectiveSlice[] = []
  halfFov = BGE.Math.DegreesToRadians(fovRad / 2)

  sliceLength = (farDistance - nearDistance) / maxSliceCount
  i = 0
  midWidthBmp = srcBmp.GetWidth() / 2
  srcTop = srcBmp.GetHeight()
  theta = BGE.Math.Atan2(nearDistance, origin.z)
  lastTheta = BGE.Math.Atan2(nearDistance, origin.z)
  for i = 0 to maxSliceCount
    distanceToSlice = nearDistance + sliceLength * i
    distanceToNextSlice = nearDistance + sliceLength * (i + 1)
    theta = BGE.Math.Atan2(distanceToNextSlice, origin.z)
    halfSliceWidth = BGE.Math.Min(distanceToSlice * tan(halfFov), midWidthBmp)

    destHeight = distanceToSlice * tan(theta - lastTheta) * 3
    if destHeight < 1
      destHeight = 1
    end if
    slices.push({
      srcWidth: halfSliceWidth * 2,
      srcHeight: sliceLength,
      srcTopLeft: {x: midWidthBmp - halfSliceWidth, y: srcTop - sliceLength * i},
      destHeight: destHeight
    })
    lastTheta = theta
  end for

  destTop = 0
  destWidth = destBmp.GetWidth()
  for i = slices.count() - 1 to 0 step -1
    slice = slices[i]
    sliceRegion = CreateObject("roRegion", srcBmp, slice.srcTopLeft.x, slice.srcTopLeft.y, slice.srcWidth, slice.srcHeight)
    worked = game.canvas.renderer.drawScaledObject(0, destTop + 250, destWidth / slice.srcWidth, slice.destHeight, sliceRegion)
    destTop += slice.destHeight
    ' if not worked
    '  return false
    'end if

  end for

  worked = true

  return worked
end function

interface PerspectiveSlice
  srcWidth as float
  srcHeight as float
  srcTopLeft as BGE.PositionXY
  destHeight as float
end interface
