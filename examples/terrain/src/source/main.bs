sub main(args as dynamic)
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.scaleCanvasToFillScreen()
  game.setCamera(new BGE.Camera3d())
  game.enableControllerInput()
  game.setCombineRemoteInputs(true)
  game.controls.bindAxis("move", "1", 0, "Move/Strafe")
  game.controls.bindAxis("look", "2", 0, "Look/Pitch")

  profileArg = ""
  if args <> invalid and args.profile <> invalid
    profileArg = args.profile
  end if
  ' "stages" also breaks each frame down by render stage, "impostor" simulates reusing the
  ' chapel's bitmap (ImpostorProbe)
  profileMode = profileArg = "1" or profileArg = "stages" or profileArg = "impostor"
  world_Scene = new WorldScene(game)
  world_Scene.profileMode = profileMode
  world_Scene.profileStages = profileArg = "stages"
  world_Scene.profileImpostor = profileArg = "impostor"
  if args <> invalid and args.impostor <> invalid
    world_Scene.chapelImpostorTolerance = Val(args.impostor)
  end if
  game.defineScene(world_Scene)

  main_Scene = new MainScene(game)
  game.defineScene(main_Scene)

  game.changeScene("WorldScene")

  game.enableStandardDebugUi()

  if profileMode
    ' pinned at the level the device starts at, so it can't change mid-profile
    game.setQualityLevel(BGE.seedRenderQualityLevelForDevice())
  else
    ' Hold the default 20fps target by moving the render quality level automatically
    game.enableAdaptiveQuality()
  end if

  ' Entity-detail overlays render oddly for the Ground plane (it doesn't have
  ' a normal bounded screen area like other entities), so leave that off.
  game.debugDrawEntityDetails(false)
  game.debugShowUi(true)
  game.Play()
end sub


