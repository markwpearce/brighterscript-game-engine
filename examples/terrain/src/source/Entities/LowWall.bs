' A single flat grey wall segment along one of worldMap.png's dark fence/rubble lines -
' see WallPlacements.bs. Marked isStatic (issue #107) since it never moves after
' spawning, so it draws in correct order against WorldScene's trees via the static
' geometry BSP tree rather than the plain painter's sort.
class LowWall extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "LowWall"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.isStatic = true
    m.position = BGE.Math.VectorOps.create(args.x, args.height / 2.0, args.z)

    rect = m.addRectangle("visual", args.length, args.height, {
      drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace,
      color: BGE.ColorsRGB.Gray,
      rotation: BGE.Math.VectorOps.create(0, BGE.Math.DegreesToRadians(args.rotY), 0)
    })
    rect.setAnchor(0.5, 0.5)
  end sub

end class
