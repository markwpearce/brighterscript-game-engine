' Thin example-specific wrapper around BGE.FreeFlyCameraController (issue #148): the
' engine class owns the generic free-fly yaw/pitch/roll/drive/ground-clamp behavior,
' while this subclass adds this example's own scene-switching-on-Back, hold-to-toggle
' debug overlay, and hint text.
class TerrainFreeFlyCameraController extends BGE.FreeFlyCameraController

  scene as BGE.Scene
  otherSceneName as string
  backHeldMs = 0
  debugToggledForThisHold = false
  debugEnabled = false

  sub new(scene as BGE.Scene, otherSceneName as string, groundPlane as BGE.Math.Plane)
    camera = scene.game.canvas.renderer.camera as BGE.Camera3d
    super(camera, groundPlane, scene.game.controls)
    m.scene = scene
    m.otherSceneName = otherSceneName
  end sub

  function getHintText() as string
    return "Gamepad: L stick move/strafe, R stick look/pitch" + Chr(10) + "Remote: D-pad turn/move   Roll: Replay/Options/L1/R1   Pitch: Rewind/FF" + Chr(10) + "Play: reset orientation   Back: switch scene" + Chr(10) + "Hold Back 2s: toggle debug info"
  end function

  override sub onInput(input as BGE.GameInput)
    super.onInput(input)

    ' Back needs tap-vs-hold disambiguation: switching scenes can't fire on press (a
    ' hold-to-toggle-debug would never get 2 seconds to accumulate before the scene
    ' already changed), so a press just resets the hold tracking, and a release only
    ' switches scenes if the hold never reached 2 seconds (i.e. debug info wasn't
    ' already toggled by update()'s held-time check below).
    if input.isButton("back")
      if input.press
        m.backHeldMs = 0
        m.debugToggledForThisHold = false
      else if input.release
        if not m.debugToggledForThisHold
          m.scene.game.changeScene(m.otherSceneName)
        end if
      end if
    end if
  end sub

  override sub update(dt as float)
    super.update(dt)

    input = m.lastInput
    if input <> invalid and input.isButton("back") and input.held
      m.backHeldMs = input.heldTimeMs
      if m.backHeldMs >= 2000 and not m.debugToggledForThisHold
        m.debugEnabled = not m.debugEnabled
        m.scene.game.debugDrawEntityDetails(m.debugEnabled)
        m.debugToggledForThisHold = true
      end if
    end if
  end sub

end class
