' A static chapel model that hides the trees behind it, to show off occlusion culling
' (issue #108). Static so its drawable can register as an occluder.
class Chapel extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "Chapel"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.isStatic = true
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    m.rotation = BGE.Math.VectorOps.create(0, BGE.Math.DegreesToRadians(args.rotY), 0)
    model = m.game.get3dModel("chapel")
    drawable = new BGE.DrawableModel(m, model, {
      isOccluder: true,
      drawMode: BGE.SceneObjectDrawMode.solidDrawBackFace
    })
    ' The model is ~13 units tall; 25x makes it ~330 against the 180-tall trees.
    drawable.scale = BGE.Math.createScaleVector(25)
    m.addDrawable("chapel", drawable)
  end sub

end class
