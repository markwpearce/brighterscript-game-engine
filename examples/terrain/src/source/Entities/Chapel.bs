' A static chapel model that hides the trees behind it, to show off occlusion culling
' (issue #108). Static so its drawable can register as an occluder.
class Chapel extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "Chapel"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.isStatic = true
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    m.rotation = BGE.Math.VectorOps.create(0, BGE.Math.DegreesToRadians(args.rotY), 0)
    model = m.game.get3dModel("chapel")
    drawable = new BGE.DrawableModel(m, model, {
      isOccluder: true,
      drawMode: BGE.SceneObjectDrawMode.solid
    })
    ' The model is ~13 units tall; 25x makes it ~330 against the 180-tall trees.
    drawable.scale = BGE.Math.createScaleVector(25)
    if invalid <> args.useImpostor
      drawable.useImpostor = args.useImpostor
    end if
    strips = args.strips
    if invalid <> strips
      drawable.useImpostorStrips = strips.useImpostorStrips
      if invalid <> strips.stripStep
        drawable.impostorStripStepPx = strips.stripStep.toFloat()
      end if
      if invalid <> strips.stripWidth
        drawable.impostorStripWidth = strips.stripWidth.toInt()
      end if
      if invalid <> strips.stripKnots
        drawable.impostorStripKnots = strips.stripKnots.toInt()
      end if
      if invalid <> strips.stripError
        drawable.impostorStripMaxError = strips.stripError.toFloat()
      end if
      if invalid <> strips.stripMax
        drawable.impostorStripMaxStrips = strips.stripMax.toInt()
      end if
      if invalid <> strips.stripAngle
        drawable.impostorStripMaxAngleDegrees = strips.stripAngle.toFloat()
      end if
      if invalid <> strips.blitScale
        drawable.impostorBlitErrorScale = strips.blitScale.toFloat()
      end if
      if invalid <> strips.blitAngle
        drawable.impostorBlitMaxAngleDegrees = strips.blitAngle.toFloat()
      end if
      if invalid <> strips.stripScale
        drawable.impostorStripErrorScale = strips.stripScale.toFloat()
      end if
      if invalid <> strips.blitRoll
        drawable.impostorBlitRollOnly = strips.blitRoll = "1" or strips.blitRoll = "true"
      end if
      if invalid <> strips.newFace
        drawable.impostorRedrawOnNewFace = not (strips.newFace = "0" or strips.newFace = "false")
      end if
      if invalid <> strips.blitAngleScale
        drawable.impostorBlitAngleScale = strips.blitAngleScale.toFloat()
      end if
      if invalid <> strips.stripLinear
        drawable.impostorStripPerspective = not (strips.stripLinear = "1" or strips.stripLinear = "true")
      end if
      print "[terrain] chapel strips: on " + drawable.useImpostorStrips.toStr() + ", step " + drawable.impostorStripStepPx.toStr() + "px, width " + drawable.impostorStripWidth.toStr() + "px, knots " + drawable.impostorStripKnots.toStr() + ", error " + drawable.impostorStripMaxError.toStr() + "px, max " + drawable.impostorStripMaxStrips.toStr() + ", angle " + drawable.impostorStripMaxAngleDegrees.toStr() + ", blitScale " + drawable.impostorBlitErrorScale.toStr() + ", blitAngle " + drawable.impostorBlitMaxAngleDegrees.toStr() + ", stripScale " + drawable.impostorStripErrorScale.toStr()
    end if
    m.addDrawable("chapel", drawable)
  end sub

end class
