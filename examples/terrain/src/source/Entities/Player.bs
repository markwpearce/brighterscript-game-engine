' Drives a Mario-Kart-style chase camera: steering (left/right) turns a
' heading, driving (up/down) moves a virtual "kart" position along the
' ground plane, and the camera is kept a fixed distance behind/above that
' position every frame - it never free-flies, so the ground plane is always
' visible and the fixed ImageCube markers show the camera's motion relative
' to the world.
class Player extends BGE.GameEntity

  turnSpeed = 2.0 ' radians/sec
  driveSpeed = 200 ' units/sec

  chaseDistance = 250
  chaseHeight = 80
  lookAtHeight = 75

  heading = 0.0 ' radians, 0 = facing -z (the default camera forward)
  kartPosition as BGE.Math.Vector

  lastInput as BGE.GameInput

  sub new(game as BGE.Game)
    super(game)
    m.name = "Player"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.kartPosition = BGE.Math.VectorOps.create(0, 0, 150)
    m.updateCameraFromKart()
  end sub

  override sub onInput(input as BGE.GameInput)
    m.lastInput = input
  end sub

  override sub onUpdate(dt as float)
    input = m.lastInput
    if input <> invalid
      m.heading -= input.x * dt * m.turnSpeed
      if input.y <> 0
        forward = m.headingForward()
        m.kartPosition = BGE.Math.VectorOps.add(m.kartPosition, BGE.Math.VectorOps.scale(forward, input.y * dt * m.driveSpeed))
      end if
    end if
    m.updateCameraFromKart()
  end sub

  private function headingForward() as BGE.Math.Vector
    return BGE.Math.VectorOps.create(sin(m.heading), 0, -cos(m.heading))
  end function

  private sub updateCameraFromKart()
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    forward = m.headingForward()

    camera.position = BGE.Math.VectorOps.subtract(m.kartPosition, BGE.Math.VectorOps.scale(forward, m.chaseDistance))
    camera.position.y = m.chaseHeight

    lookTarget = BGE.Math.VectorOps.add(m.kartPosition, BGE.Math.VectorOps.create(0, m.lookAtHeight, 0))
    camera.setTarget(lookTarget)
  end sub

end class
