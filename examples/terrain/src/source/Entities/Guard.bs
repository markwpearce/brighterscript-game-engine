' A Doom-style oriented-sprite character built from the Helix character spritesheet
' (helix_full_sheet.png, 640x1024, 8 cols x 16 rows of 80x64 cells) - demonstrates
' DrawableOrientedSprite (issue #104). Sheet rows 0-7 are a single-frame-per-row idle
' pose block, rows 8-15 an 8-frame-per-row walk cycle block; both blocks use the same
' per-row compass order (row 0 of each block = SW, then S, SE, E, NE, N, NW, W), per
' the asset's own documentation. No mirroring is needed - all 8 directions have real
' art in both blocks.
class Guard extends BGE.GameEntity

  sprite as BGE.DrawableOrientedSprite

  sub new(game as BGE.Game)
    super(game)
    m.name = "Guard"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    m.rotation = BGE.Math.VectorOps.create(0, BGE.Math.DegreesToRadians(args.rotY), 0)

    sheet = m.game.getBitmap("guardSheet")
    ' Row-major cell index for sheet row r, column c (8 columns per row).
    walkRow = function(r as integer) as integer[]
      frames = []
      for c = 0 to 7
        frames.push(r * 8 + c)
      end for
      return frames
    end function

    ' Bucket 0 = front (facing the camera, i.e. facing south), proceeding clockwise
    ' viewed from above - front, front-right, right, back-right, back, back-left, left,
    ' front-left. Each block's rows are ordered SW,S,SE,E,NE,N,NW,W starting at its own
    ' first row, so "front" (S) is the block's row + 1 and "front-left" (SW) wraps back
    ' to the block's own first row.
    walkAngleFrames = [
      walkRow(9)  ' S  (front)
      walkRow(10) ' SE (front-right)
      walkRow(11) ' E  (right)
      walkRow(12) ' NE (back-right)
      walkRow(13) ' N  (back)
      walkRow(14) ' NW (back-left)
      walkRow(15) ' W  (left)
      walkRow(8)  ' SW (front-left)
    ]
    idleAngleFrames = [
      [1 * 8] ' S  (front)
      [2 * 8] ' SE (front-right)
      [3 * 8] ' E  (right)
      [4 * 8] ' NE (back-right)
      [5 * 8] ' N  (back)
      [6 * 8] ' NW (back-left)
      [7 * 8] ' W  (left)
      [0 * 8] ' SW (front-left)
    ]

    m.sprite = m.addOrientedSprite("visual", sheet, 80, 64, 8, 1, {
      drawMode: BGE.SceneObjectDrawMode.directScaled,
      banksWithCameraRoll: true
    })
    m.sprite.setAnchor(0.5, 1.0)
    m.sprite.addOrientedAnimation("walk", walkAngleFrames, 8, BGE.SpritePlayMode.Loop)
    m.sprite.addOrientedAnimation("idle", idleAngleFrames, 1, BGE.SpritePlayMode.Loop)
    m.sprite.playOrientedAnimation("idle")
  end sub

end class
