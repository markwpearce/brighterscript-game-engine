' Adds a label per line to gameUi, top-left inside the title-safe area. Each line wraps to 78%
' of the width, and the next starts below however many lines it wrapped to.
'
' @param {BGE.Game} game
' @param {string[]} lines
sub showLabelLines(game as BGE.Game, lines as string[])
  width = game.uiCanvas.getWidth()
  height = game.uiCanvas.getHeight()
  y = height * 0.11
  for each line in lines
    label = new BGE.UI.Label(game)
    label.setText(line)
    label.wrapWidth = width * 0.78
    label.customPosition = true
    label.customX = width * 0.11
    label.customY = y
    game.gameUi.addChild(label)
    lineHeight = label.drawableText.font.GetOneLineHeight()
    wrappedCount = BGE.UI.wrapText(line, label.drawableText.font, label.wrapWidth).count()
    y += height * 0.015 + wrappedCount * lineHeight
  end for
end sub
