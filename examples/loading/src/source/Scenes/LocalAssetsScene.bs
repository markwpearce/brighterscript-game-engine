' Loads every model in pkg:/models/ through onLoad(), parsed a slice at a time, plus some large
' textures (decoded off the main thread on a Roku, one of them resized as it loads), then lists
' what loaded, how long the whole load took and the longest frame while loading.
class LocalAssetsScene extends BGE.GameScene

  private loadTimer as roTimespan
  private loadSeconds as float = 0.0
  private modelNames as string[]
  private bitmapNames as string[]
  private loadingScreen as TimedLoadingScreen = invalid

  sub new(game as BGE.Game)
    super(game)
    m.name = "LocalAssetsScene"
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    m.loadTimer = CreateObject("roTimespan")
    ' the previous scene's widgets stay on screen (and focusable) while loading - clear them
    m.game.gameUi.clearChildren()
    m.modelNames = []
    m.bitmapNames = []
    files = CreateObject("roFileSystem").GetDirectoryListing("pkg:/models/")
    for each fileName in files
      lowerName = LCase(fileName)
      if lowerName.EndsWith(".stl") or lowerName.EndsWith(".obj")
        task = loader.load3dModel(fileName, "pkg:/models/" + fileName)
        ' bigger files take longer - weight the bar by size
        stat = CreateObject("roFileSystem").Stat("pkg:/models/" + fileName)
        if stat <> invalid and stat.size <> invalid
          task.weight = stat.size / 1000.0 + 1
        end if
        m.modelNames.push(fileName)
      end if
    end for
    ' large textures: on a Roku these decode off the main thread, so the frame time stays steady
    for each fileName in CreateObject("roFileSystem").GetDirectoryListing("pkg:/images/big/")
      bitmapTask = loader.loadBitmap(fileName, "pkg:/images/big/" + fileName)
      stat = CreateObject("roFileSystem").Stat("pkg:/images/big/" + fileName)
      if stat <> invalid and stat.size <> invalid
        bitmapTask.weight = stat.size / 1000.0 + 1
      end if
      m.bitmapNames.push(fileName)
    end for
    ' resized while it loads, so only the small copy takes texture memory
    loader.loadBitmap("worldMap thumbnail", "pkg:/images/big/worldMap.png", {width: 320, height: 180})
    m.bitmapNames.push("worldMap thumbnail")
  end sub

  override function getLoadingScreen() as BGE.LoadingScreen
    m.loadingScreen = new TimedLoadingScreen(m.game.getFont("debugUI"))
    return m.loadingScreen
  end function

  override sub onCreate(args as roAssociativeArray)
    m.loadSeconds = m.loadTimer.TotalMilliseconds() / 1000.0
    m.game.gameUi.clearChildren()
    lines = [`Loaded ${m.modelNames.count()} models + ${m.bitmapNames.count()} textures in ${m.loadSeconds}s - Back for the menu`] as string[]
    if m.loadingScreen <> invalid
      lines.push(`Longest frame while loading: ${Int(m.loadingScreen.worstFrameMs)}ms`)
    end if
    models = [] as string[]
    for each modelName in m.modelNames
      model = m.game.Models[modelName]
      if model <> invalid
        models.push(`${modelName} ${model.faces.count()}`)
      end if
    end for
    lines.push("Models (faces): " + models.join(", "))
    textures = [] as string[]
    for each bitmapName in m.bitmapNames
      bitmap = m.game.Bitmaps[bitmapName]
      if bitmap <> invalid
        textures.push(`${bitmapName} ${bitmap.getWidth()}x${bitmap.getHeight()}`)
      end if
    end for
    lines.push("Textures: " + textures.join(", "))
    for each errorMessage in m.game.getSceneLoader().getErrors()
      lines.push("ERROR " + errorMessage)
    end for
    showLabelLines(m.game, lines)
  end sub

  override sub onDestroy()
    ' frees the texture memory, including the texture manager's copies
    for each bitmapName in m.bitmapNames
      m.game.unloadBitmap(bitmapName)
    end for
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.changeScene("MenuScene")
    end if
  end sub

end class
