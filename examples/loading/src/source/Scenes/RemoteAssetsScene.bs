import "../UI/LabelList.bs"
import "../UI/TimedLoadingScreen.bs"

' Downloads images (one from a URL without an extension), a textured model, a sound and a font in onLoad(), then lists where each
' came from (network or cache) and how long it took. A relaunch should show everything from the cache. Play streams music from a URL.
class RemoteAssetsScene extends BGE.GameScene

  private baseUrl as string
  private loadTimer as roTimespan
  private tasks as roAssociativeArray
  private musicLabel as BGE.UI.Label = invalid

  sub new(game as BGE.Game, baseUrl as string)
    super(game)
    m.name = "RemoteAssetsScene"
    m.baseUrl = baseUrl
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    m.loadTimer = CreateObject("roTimespan")
    m.game.gameUi.clearChildren()
    m.tasks = {}
    m.tasks["rpgSplash.png"] = loader.loadBitmap("remoteSplash", m.baseUrl + "images/rpgSplash.png")
    m.tasks["icon.png"] = loader.loadBitmap("remoteIcon", m.baseUrl + "images/icon.png")
    m.tasks["d20.obj"] = loader.load3dModel("remoteD20", m.baseUrl + "models/d20.obj")
    m.tasks["hit.wav"] = loader.loadSound("remoteHit", m.baseUrl + "sounds/hit.wav")
    ' no extension - the type comes from the response
    m.tasks["picsum.photos/200 (no extension)"] = loader.loadBitmap("remotePicsum", "https://picsum.photos/200")
    m.tasks["Audiowide-Regular.ttf"] = loader.registerFont(m.baseUrl + "fonts/Audiowide-Regular.ttf")
  end sub

  override function getLoadingScreen() as BGE.LoadingScreen
    screen = new TimedLoadingScreen(m.game.getFont("debugUI"))
    return screen
  end function

  override sub onCreate(args as roAssociativeArray)
    seconds = m.loadTimer.TotalMilliseconds() / 1000.0
    m.game.gameUi.clearChildren()
    lines = [`Loaded from ${m.baseUrl}`, `in ${seconds}s - OK plays the sound, Play streams music, Back for the menu`]
    picsum = m.game.Bitmaps["remotePicsum"]
    for each fileName in m.tasks
      line = m.describe(fileName, m.tasks[fileName])
      if fileName.StartsWith("picsum") and picsum <> invalid
        line += `, ${picsum.GetWidth()}x${picsum.GetHeight()}`
      end if
      lines.push(line)
    end for
    splash = m.game.Bitmaps["remoteSplash"]
    if splash <> invalid
      lines.push(`rpgSplash.png is ${splash.GetWidth()}x${splash.GetHeight()}`)
    end if
    model = m.game.Models["remoteD20"]
    if model <> invalid
      textured = model.faces.count() > 0 and model.faces[0].Texture <> invalid
      lines.push(`d20.obj has ${model.faces.count()} faces, textured: ${textured}`)
    end if
    for each errorMessage in m.game.getSceneLoader().getErrors()
      lines.push("ERROR " + errorMessage)
    end for
    showLabelLines(m.game, lines)
    m.addFontSample()
    m.musicLabel = m.addLabelAt("", 0.84)
  end sub

  override sub onUpdate(dt as float)
    if m.musicLabel = invalid
      return
    end if
    status = "Music: stopped"
    if m.game.getMusicPath() <> ""
      status = "Music: streaming music/victory.mp3"
    end if
    m.musicLabel.setText(status)
  end sub

  override sub onChangeScene(newScene as BGE.GameScene)
    m.game.musicStop()
    m.musicLabel = invalid
  end sub

  ' A line drawn with the downloaded font, if it registered.
  private sub addFontSample()
    if m.tasks["Audiowide-Regular.ttf"].error <> invalid
      return
    end if
    m.game.loadFont("remoteAudiowide", "Audiowide", 32, false, false)
    sample = m.addLabelAt("This line uses a font downloaded from a URL", 0.77)
    sample.drawableText.font = m.game.getFont("remoteAudiowide")
  end sub

  private function addLabelAt(text as string, yFraction as float) as BGE.UI.Label
    label = new BGE.UI.Label(m.game)
    label.setText(text)
    label.customPosition = true
    label.customX = m.game.uiCanvas.getWidth() * 0.11
    label.customY = m.game.uiCanvas.getHeight() * yFraction
    m.game.gameUi.addChild(label)
    return label
  end function

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("OK")
      m.game.playSound("remoteHit")
    else if input.press and input.isButton("play")
      if m.game.getMusicPath() = ""
        m.game.musicPlay(m.baseUrl + "music/victory.mp3")
      else
        m.game.musicStop()
      end if
    else if input.press and input.isButton("back")
      m.game.changeScene("MenuScene")
    end if
  end sub

  private function describe(fileName as string, task as BGE.LoadTask) as string
    if task.error <> invalid
      return fileName + ": failed"
    end if
    fileTask = task as BGE.FileLoadTask
    download = fileTask.download
    if download = invalid
      return fileName + ": local"
    end if
    if download.fromCache
      return fileName + ": cache"
    end if
    return `${fileName}: network, ${download.elapsedMs}ms`
  end function

end class
