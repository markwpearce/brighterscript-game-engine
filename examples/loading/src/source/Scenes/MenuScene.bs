class MenuScene extends BGE.GameScene

  sub new(game as BGE.Game)
    super(game)
    m.name = "MenuScene"
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' gameUi persists across scenes, so clear it before re-adding widgets.
    m.game.gameUi.clearChildren()
    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    hint = new BGE.UI.Label(m.game)
    hint.setText("Each scene loads its assets in onLoad() before it opens.")
    hint.customPosition = true
    hint.customX = width * 0.11
    hint.customY = height * 0.14
    m.game.gameUi.addChild(hint)

    localButton = new BGE.UI.Button(m.game)
    localButton.setLabel("Large local assets")
    localButton.customPosition = true
    localButton.customX = width * 0.11
    localButton.customY = height * 0.24
    localButton.width = width * 0.27
    localButton.height = height * 0.083
    localButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeScene("LocalAssetsScene")
    end sub
    m.game.gameUi.addChild(localButton)

    customButton = new BGE.UI.Button(m.game)
    customButton.setLabel("Custom loading screen")
    customButton.customPosition = true
    customButton.customX = width * 0.11
    customButton.customY = height * 0.34
    customButton.width = width * 0.27
    customButton.height = height * 0.083
    customButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeScene("CustomScreenScene")
    end sub
    m.game.gameUi.addChild(customButton)
  end sub

end class
