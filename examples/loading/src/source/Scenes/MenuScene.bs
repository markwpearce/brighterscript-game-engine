class MenuScene extends BGE.GameScene

  private hint as BGE.UI.Label

  sub new(game as BGE.Game)
    super(game)
    m.name = "MenuScene"
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' gameUi persists across scenes, so clear it before re-adding widgets.
    m.game.gameUi.clearChildren()
    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    m.hint = new BGE.UI.Label(m.game)
    m.hint.setText("Each scene loads its assets in onLoad() before it opens. Remote scenes download from the web.")
    m.hint.customPosition = true
    m.hint.customX = width * 0.11
    m.hint.customY = height * 0.14
    m.game.gameUi.addChild(m.hint)

    localButton = new BGE.UI.Button(m.game)
    localButton.setLabel("Large local assets")
    localButton.customPosition = true
    localButton.customX = width * 0.11
    localButton.customY = height * 0.24
    localButton.width = width * 0.27
    localButton.height = height * 0.083
    localButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeScene("LocalAssetsScene")
    end sub
    m.game.gameUi.addChild(localButton)

    customButton = new BGE.UI.Button(m.game)
    customButton.setLabel("Custom loading screen")
    customButton.customPosition = true
    customButton.customX = width * 0.11
    customButton.customY = height * 0.34
    customButton.width = width * 0.27
    customButton.height = height * 0.083
    customButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeScene("CustomScreenScene")
    end sub
    m.game.gameUi.addChild(customButton)

    remoteButton = new BGE.UI.Button(m.game)
    remoteButton.setLabel("Remote assets")
    remoteButton.customPosition = true
    remoteButton.customX = width * 0.11
    remoteButton.customY = height * 0.44
    remoteButton.width = width * 0.27
    remoteButton.height = height * 0.083
    remoteButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeScene("RemoteAssetsScene")
    end sub
    m.game.gameUi.addChild(remoteButton)

    failureButton = new BGE.UI.Button(m.game)
    failureButton.setLabel("Failures")
    failureButton.customPosition = true
    failureButton.customX = width * 0.11
    failureButton.customY = height * 0.54
    failureButton.width = width * 0.27
    failureButton.height = height * 0.083
    failureButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeScene("FailureScene")
    end sub
    m.game.gameUi.addChild(failureButton)

    clearButton = new BGE.UI.Button(m.game)
    clearButton.setLabel("Clear download cache")
    clearButton.customPosition = true
    clearButton.customX = width * 0.11
    clearButton.customY = height * 0.64
    clearButton.width = width * 0.27
    clearButton.height = height * 0.083
    clearButton.onActivate = sub(button as BGE.UI.Button)
      button.game.assets.clearCache()
      menu = button.game.currentScene as MenuScene
      menu.showHint("Download cache cleared")
    end sub
    m.game.gameUi.addChild(clearButton)
  end sub

  sub showHint(text as string)
    m.hint.setText(text)
  end sub

end class
