sub Main(args as dynamic)
  game = new BGE.Game(1280, 720)
  game.fitCanvasToScreen()

  menu = new MenuScene(game)
  game.defineScene(menu)
  local = new LocalAssetsScene(game)
  game.defineScene(local)
  custom = new CustomScreenScene(game)
  game.defineScene(custom)

  baseUrl = "https://raw.githubusercontent.com/markwpearce/brighterscript-game-engine/main/examples/loading/remote-assets/"
  params = new BGE.LaunchParams(args)
  if params.getString("baseUrl") <> ""
    baseUrl = params.getString("baseUrl")
    if not baseUrl.EndsWith("/")
      baseUrl = baseUrl + "/"
    end if
  end if
  remote = new RemoteAssetsScene(game, baseUrl)
  game.defineScene(remote)
  failure = new FailureScene(game, baseUrl)
  game.defineScene(failure)

  game.changeScene(params.sceneName(game.getSceneNames(), menu.name))

  game.enableStandardDebugUi({memory: false, garbageCollector: false, log: false})
  game.debugShowUi(true)
  game.play()
end sub
