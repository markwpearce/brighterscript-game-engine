import "../LevelData.bs"

' Tracks score/lives, listens for the game events Coin/Enemy/Goal post
' (BGE.Game.postGameEvent), and owns the HUD + win/game-over BGE.UI panels -
' the same "entity reacts to broadcast events, doesn't know who sent them"
' pattern as examples/breakout's ScoreHandler, but with real BGE.UI widgets
' instead of a drawText overlay.
class GameStateManager extends BGE.GameEntity

  score = 0
  lives = 3
  gameOver = false
  won = false

  ' Which level is currently playing - seeded from onCreate()'s args (see
  ' MainRoom's addEntity() call), purely for the levelLabel HUD text below.
  levelIndex = 0

  scoreLabel as BGE.UI.Label
  livesLabel as BGE.UI.Label
  levelLabel as BGE.UI.Label
  endPanel as BGE.UI.MessagePanel

  sub new(game as BGE.Game)
    super(game)
    m.name = "GameStateManager"
    ' Not persistent: MainRoom.onCreate() unconditionally adds a fresh
    ' GameStateManager every time it runs (initial load and every
    ' Game.resetRoom() on Retry). A persistent instance would survive that
    ' reset and coexist with the new one - two listeners double-handling
    ' every game event, two overlapping HUDs. Letting it be destroyed and
    ' recreated like every other level entity (Level/Player/Coin/...) gives
    ' Retry a genuinely fresh score/lives/gameOver state for free.
    m.persistent = false
  end sub

  ' @param {integer} [args.levelIndex=0] - which level is currently playing (HUD text only)
  ' @param {integer} [args.score=0] - carried forward from the previous level on a
  '   Goal-triggered advance (see Goal.onCollision()), so score accumulates across the
  '   whole playthrough instead of resetting every level. Left at 0 on the very first
  '   level load, same as before.
  ' @param {integer} [args.lives=3] - carried forward the same way. Since resetRoom()
  '   (Retry) replays these exact same args, dying mid-level and retrying restores the
  '   score/lives you had when you *arrived* at this level, not a full game restart -
  '   an emergent, effectively-free checkpoint behavior from how BGE.Game.currentRoomArgs
  '   already works, not anything special-cased here.
  override sub onCreate(args as roAssociativeArray)
    ' gameUi persists across a room reset (unlike entities). Clear it first so
    ' Retry doesn't stack a second HUD/end-panel on top of the previous
    ' (now-destroyed) GameStateManager's widgets - same pattern as
    ' examples/ui's MainRoom.
    m.game.gameUi.clearChildren()

    ' A fresh GameStateManager.onCreate() means either the initial level load
    ' (game not paused, this is a no-op) or a Retry-triggered resetRoom()
    ' (game.pause() was called by the just-destroyed previous instance's
    ' showEndPanel() and is never undone by resetRoom() itself).
    m.game.Resume()

    if invalid <> args.levelIndex
      m.levelIndex = args.levelIndex as integer
    end if
    if invalid <> args.score
      m.score = args.score as integer
    end if
    if invalid <> args.lives
      m.lives = args.lives as integer
    end if

    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    ' A translucent dark bar behind the whole Score/Level/Lives row - added
    ' first (draw order follows insertion order) so it sits behind the three
    ' labels below rather than covering them. Plain text color alone wasn't
    ' reliably legible against the parallax forest background, which varies
    ' from dark tree silhouettes to bright green foliage depending on
    ' scroll position.
    hudBarHeight = m.game.getFont("body").GetOneLineHeight() + 24.0
    hudBar = new BGE.UI.UiContainer(m.game)
    hudBar.backgroundRGBA = &h0D1117B0
    hudBar.customPosition = true
    hudBar.customX = 0
    hudBar.customY = 0
    hudBar.width = width
    hudBar.height = hudBarHeight
    m.game.gameUi.addChild(hudBar)

    m.scoreLabel = new BGE.UI.Label(m.game)
    m.scoreLabel.customPosition = true
    m.scoreLabel.customX = width * 0.1
    m.scoreLabel.customY = height * 0.06
    m.scoreLabel.setText("Score: " + m.score.toStr())
    m.scoreLabel.drawableText.textColor = &hF5E6C8FF ' warm cream, readable over the parallax forest
    m.game.gameUi.addChild(m.scoreLabel)

    ' Right-edge-anchored via the actual measured text width (not a fixed
    ' percentage) so this stays inside the title-safe area regardless of how
    ' wide "Lives: N" renders in the display font.
    livesText = "Lives: " + m.lives.toStr()
    livesWidth = m.game.getFont("body").GetOneLineWidth(livesText, 10000)
    m.livesLabel = new BGE.UI.Label(m.game)
    m.livesLabel.customPosition = true
    m.livesLabel.customX = width * 0.9 - livesWidth
    m.livesLabel.customY = height * 0.06
    m.livesLabel.setText(livesText)
    m.livesLabel.drawableText.textColor = &hF5E6C8FF
    m.game.gameUi.addChild(m.livesLabel)

    ' Top-center, between the score/lives labels - "Level 2/6" rather than a bare
    ' index so it's meaningful without also showing getLevelCount() elsewhere.
    levelText = "Level " + (m.levelIndex + 1).toStr() + "/" + getLevelCount().toStr()
    levelWidth = m.game.getFont("body").GetOneLineWidth(levelText, 10000)
    m.levelLabel = new BGE.UI.Label(m.game)
    m.levelLabel.customPosition = true
    m.levelLabel.customX = (width - levelWidth) / 2.0
    m.levelLabel.customY = height * 0.06
    m.levelLabel.setText(levelText)
    m.levelLabel.drawableText.textColor = &hF5E6C8FF
    m.game.gameUi.addChild(m.levelLabel)
  end sub

  override sub onGameEvent(eventName as string, data as roAssociativeArray)
    if m.gameOver or m.won
      return
    end if

    if eventName = "coinCollected"
      m.score += 10
      m.scoreLabel.setText("Score: " + m.score.toStr())
    else if eventName = "enemyStomped"
      m.score += 25
      m.scoreLabel.setText("Score: " + m.score.toStr())
    else if eventName = "playerHurt"
      m.lives -= 1
      m.livesLabel.setText("Lives: " + m.lives.toStr())
      if m.lives <= 0
        m.gameOver = true
        m.showEndPanel("Game Over - Score: " + m.score.toStr())
      end if
    else if eventName = "levelComplete"
      m.won = true
      m.showEndPanel("You Win! - Score: " + m.score.toStr())
    end if
  end sub

  ' Builds a fresh end panel (win or game-over - both use this same panel, just with a
  ' different message and button set) and shows it - called from onGameEvent() below the
  ' first time an end state actually happens. A Button registers itself with the shared,
  ' global BGE.UI.FocusManager the instant it's added to any focusEnabled container, so
  ' building it lazily here (via BGE.UI.MessagePanel.show()) rather than upfront in
  ' onCreate() keeps Retry/Quit out of the focus registry (and un-clickable) for the
  ' entire time the level is actually being played.
  private sub showEndPanel(message as string)
    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    retryButton = new BGE.UI.MessagePanelButton("Retry", sub(button as BGE.UI.Button)
      button.game.resetRoom()
    end sub)
    quitButton = new BGE.UI.MessagePanelButton("Quit to Title", sub(button as BGE.UI.Button)
      button.game.changeRoom("TitleRoom")
    end sub)

    ' Widened/heightened from the original 340x185 to fit the larger body font
    ' (24 -> 30) and taller buttons (48px -> 56px).
    m.endPanel = new BGE.UI.MessagePanel(m.game, 460.0, 200.0, [retryButton, quitButton], "", message)
    m.endPanel.show(m.game.gameUi, width, height)
    m.game.pause()
  end sub

end class
