import "../LevelData.bs"

class Goal extends BGE.GameEntity

  width = 48.0
  height = 96.0

  ' Which level this Goal belongs to - set from onCreate()'s args (see MainRoom's
  ' addEntity() call). Reaching this Goal advances to levelIndex + 1, or posts the
  ' real "levelComplete" win event once there's no next level (see getLevelCount()).
  levelIndex = 0

  ' Guards against onCollision() firing more than once for the same overlap (e.g. if
  ' the player's collider keeps overlapping this Goal for a frame or two after the
  ' room-change is triggered but before it actually takes effect at end-of-frame -
  ' same guard shape as Enemy.stomp()'s isDying check).
  advancing = false

  sub new(game as BGE.Game)
    super(game)
    m.name = "Goal"
  end sub

  override sub onCreate(args as roAssociativeArray)
    if invalid <> args.levelIndex
      m.levelIndex = args.levelIndex as integer
    end if

    ' goal.png is a 60x96, 10-col x 1-row grid - one continuous waving-flag loop,
    ' every frame facing right. Pretranslated so the pole's base sits at the
    ' entity's own position, matching the rectangle collider's own anchor below.
    sprite = m.addSprite("body", m.game.getBitmap("goal"), 60, 96)
    sprite.applyPreTranslation(-30, -96)
    sprite.addAnimation("wave", {startFrame: 0, frameCount: 10}, 10, BGE.SpritePlayMode.Loop)
    sprite.playAnimation("wave")

    m.addRectangleCollider("body", m.width, m.height, -m.width / 2.0, m.height)
  end sub

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if otherEntity.name <> "Player" or m.advancing
      return
    end if
    m.advancing = true

    if m.levelIndex + 1 < getLevelCount()
      m.game.postGameEvent("levelAdvanced", {levelIndex: m.levelIndex + 1})
      m.game.changeRoom("MainRoom", {levelIndex: m.levelIndex + 1})
    else
      m.game.postGameEvent("levelComplete", {})
    end if
  end sub

end class
