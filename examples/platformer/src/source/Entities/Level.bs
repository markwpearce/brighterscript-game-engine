import "../LevelData.bs"
import "pkg:/source/utils/tilemap/TileMapBaking.bs"
import "pkg:/source/utils/tilemap/TileMapColliderMerging.bs"

' Holds every static tile in the level, baked down to a handful of drawables/colliders
' instead of one of each per tile - a naive one-GameEntity-per-tile (or even one-drawable-
' and-one-collider-per-tile) approach doesn't cost anything in per-frame onUpdate/onInput
' dispatch (this was never a GameEntity-per-tile design), but it does still cost a per-frame
' SceneObject in the renderer's depth sort and a collider in the compositor's collision
' checks for every single tile, whether or not the tile ever moves. BGE.TileMap.
' bakeTileMapImages()/mergeTileColliderRuns() collapse those down to one drawable per screen-
' sized chunk of stationary tiles and one collider per contiguous same-tag run - see their own
' doc comments for how. See LevelData.bs for the row/column -> world-position formula this
' class implements.
class Level extends BGE.GameEntity

  ' Each chunkSize x chunkSize area of stationary tiles becomes one baked Image/draw call
  ' instead of one per tile - must be a multiple of TileSize so no tile ever straddles two
  ' chunks (see bakeTileMapImages()'s own doc comment). Raised from an original cap of 128
  ' to 512 (colliders 24->9, scene objects 34->10 on this level) after Renderer.render()
  ' was fixed to call Finish() on its destination before the frame proceeds (see issue #211
  ' and Renderer.bs's own comment on that call) - real-device testing at 512 (memory- and
  ' disk-sourced images, up to 16 simultaneous 320px blits/frame, sustained) found zero
  ' failures after that fix, versus the ~192px threshold before it.
  '
  ' Still keep this well under 768: a merged chunk that spans a large mostly-empty vertical
  ' gap (e.g. this level's floating one-way platform merging with unrelated ground tiles
  ' far below it) can still silently fail to render at 768+ *inside this actual running
  ' game* even though the identical dimensions render reliably in an isolated
  ' rendererTest-style stress test (confirmed: a 512x325 chunk here renders fine; a 768x325
  ' chunk, same height, does not) - a real, currently-unexplained difference between an
  ' isolated blit and the full Game/GameScene/entity/collision pipeline - filed as issue #213
  ' rather than chased further here.
  private chunkSize = 512.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "Level"
    m.persistent = false
  end sub

  ' @param {integer} [args.levelIndex=0] - which level layout to build, per
  ' LevelData.getLevelRows(). Passed as an addEntity() arg (not a field set
  ' afterward) since onCreate() needs it immediately, before MainScene would
  ' otherwise get a chance to set a field post-construction.
  override sub onCreate(args as roAssociativeArray)
    levelIndex = 0
    if invalid <> args.levelIndex
      levelIndex = args.levelIndex as integer
    end if
    rows = getLevelRows(levelIndex)
    surfaceBitmap = m.game.getBitmap("tileSurface")
    fillBitmap = m.game.getBitmap("tileFill")
    ' Same region reused for every tile of a given kind - the bitmap/rect never
    ' changes between iterations, so build each once rather than re-creating an
    ' identical roRegion per tile.
    surfaceRegion = CreateObject("roRegion", surfaceBitmap, 0, 0, surfaceBitmap.GetWidth(), surfaceBitmap.GetHeight())
    fillRegion = CreateObject("roRegion", fillBitmap, 0, 0, fillBitmap.GetWidth(), fillBitmap.GetHeight())

    tiles = [] as BGE.TileMap.TileSpec[]
    colliderCells = [] as BGE.TileMap.ColliderCell[]

    for r = 0 to rows.count() - 1
      row = rows[r]
      for c = 0 to row.len() - 1
        tileChar = row.mid(c, 1)
        if tileChar = "#" or tileChar = "-"
          ' A "#" is an exposed top surface only if the cell directly above it is
          ' air (or off the top of the level) - anything else ("#" from the row
          ' below piled on top of another) is buried and never seen from above,
          ' so it gets the seamless fill texture instead of the non-tileable
          ' decorative surface piece.
          exposedTop = true
          if tileChar = "#" and r > 0
            exposedTop = rows[r - 1].mid(c, 1) <> "#"
          end if
          tiles.push(m.buildTileSpec(r, c, tileChar, exposedTop, surfaceRegion, fillRegion))
          colliderTag = "oneWay"
          if tileChar = "#"
            colliderTag = "solid"
          end if
          colliderCells.push({row: r, col: c, tag: colliderTag})
        end if
      end for
    end for

    m.addBakedTileImages(tiles)
    m.addMergedTileColliders(colliderCells)
  end sub

  ' Builds one BGE.TileMap.TileSpec describing tile (r, c)'s drawable - position, source
  ' texture region, and size - matching this level's exact visual conventions (see the
  ' inline comments below for why each tile kind needs its own y-offset/height nudge).
  private function buildTileSpec(r as integer, c as integer, tileChar as string, exposedTop as boolean, surfaceRegion as roRegion, fillRegion as roRegion) as BGE.TileMap.TileSpec
    topY = (NumRows - r) * TileSize
    leftX = c * TileSize

    ' tile_surface.png is a one-off decorative rock/grass piece (not seamlessly
    ' tileable) used for every visible top surface, including one-way platforms
    ' (which read fine as a thin floating rock/grass slab); tile_fill.png tiles
    ' seamlessly and is used for buried ground tiles where no repeat is visible
    ' anyway. Each is scaled uniformly (both native pieces are square) to fill
    ' one TileSize x TileSize cell - simplest option given the existing per-cell
    ' loop, at the cost of the surface piece's crevice detail repeating once per
    ' exposed-top column; the vertical pillar pieces aren't used here since this
    ' level's ground/platforms are too flat and shallow to need a separate
    ' vertical rock-face composition.
    ' tile_surface.png's rock has a raised front lip, so its own flat "walkable" surface
    ' sits a few pixels below the art's literal top edge - a 2.5D look that otherwise makes
    ' the player appear to float above the ground, since collision rests the player's feet
    ' exactly at the tile's grid top edge (topY). Nudging only the DRAWABLE up by this many
    ' pixels (never the collider - collision geometry is untouched) lines the texture's
    ' visual surface up with where the player already rests. Determined by eye against
    ' on-device screenshots, not a formula.
    surfaceVisualYOffset = 5
    imageOffsetY = topY
    imageHeight = TileSize
    if tileChar = "-" or exposedTop
      region = surfaceRegion
      imageOffsetY += surfaceVisualYOffset
    else
      region = fillRegion
      ' A buried tile's own top edge sits exactly at the tile above's bottom edge -
      ' except when that tile above got nudged up by surfaceVisualYOffset (an exposed
      ' "#"/"-" tile, per the comment above), which otherwise leaves a gap this many
      ' pixels tall with nothing drawn in it (the parallax background shows straight
      ' through - this was a real, confirmed-on-device bug, not merely cosmetic).
      ' Stretching this tile's own top edge up by the same amount closes that seam;
      ' its bottom edge (aligned to the collider) is untouched. Applied unconditionally
      ' (not just when the tile above happens to be exposed) since two stacked buried
      ' tiles overlapping by a few pixels of the same seamless fill texture is
      ' invisible - simpler than tracking which specific neighbor needs it.
      imageOffsetY += surfaceVisualYOffset
      imageHeight += surfaceVisualYOffset
    end if

    return {worldX: leftX, worldY: imageOffsetY, region: region, width: TileSize, height: imageHeight}
  end function

  ' Bakes every tile's drawable into one Image per occupied chunkSize x chunkSize chunk (see
  ' BGE.TileMap.bakeTileMapImages()) instead of one Image per tile.
  private sub addBakedTileImages(tiles as BGE.TileMap.TileSpec[])
    chunks = BGE.TileMap.bakeTileMapImages(tiles, m.chunkSize)
    for i = 0 to chunks.count() - 1
      chunk = chunks[i]
      chunkRegion = CreateObject("roRegion", chunk.bitmap, 0, 0, chunk.bitmap.GetWidth(), chunk.bitmap.GetHeight())
      m.addImage("tileChunk_" + i.toStr(), chunkRegion, {
        offset: BGE.Math.VectorOps.create(chunk.worldX, chunk.worldY),
        drawMode: BGE.SceneObjectDrawMode.matchCamera
      })
    end for
  end sub

  ' Merges every tile's collider into one RectangleCollider per contiguous same-tag run
  ' within a row (see BGE.TileMap.mergeTileColliderRuns()) instead of one per tile.
  private sub addMergedTileColliders(colliderCells as BGE.TileMap.ColliderCell[])
    colliderRuns = BGE.TileMap.mergeTileColliderRuns(colliderCells)
    for i = 0 to colliderRuns.count() - 1
      colliderRun = colliderRuns[i]
      topY = (NumRows - colliderRun.row) * TileSize
      leftX = colliderRun.startCol * TileSize
      width = (colliderRun.endCol - colliderRun.startCol + 1) * TileSize
      collider = m.addRectangleCollider("tileRun_" + i.toStr(), width, TileSize, leftX, topY)
      collider.tagsList.add(colliderRun.tag)
    end for
  end sub

end class
