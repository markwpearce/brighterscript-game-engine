class Coin extends BGE.GameEntity

  radius = 16.0

  sparkle as BGE.DrawableParticles

  sub new(game as BGE.Game)
    super(game)
    m.name = "Coin"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.addCircle("body", m.radius, {
      offset: BGE.Math.VectorOps.create(-m.radius, m.radius),
      color: &hFFD700 ' gold (RGB - Drawable.color is packed RGB, not RGBA)
    })
    ' Unlike DrawableCircle.offset above (the circle's bounding-square top-left,
    ' which is why that offset is -radius/radius to center it on this entity's
    ' position), CircleCollider.offset is the literal circle center - so this
    ' collider needs no offset at all to land on that same centered position.
    m.addCircleCollider("coin", m.radius)
    m.sparkle = m.addParticles("sparkle", BGE.ParticleShape.Rectangle, {
      lifetime: 0.4,
      velocitySpreadMagnitude: 120.0,
      startColor: &hFFD700FF,
      endColor: &hFFFFAAFF,
      startAlpha: 255.0,
      endAlpha: 0.0,
      startSize: 5.0,
      endSize: 1.0
    })
  end sub

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if otherEntity.name <> "Player" or m.isDying
      return
    end if
    m.sparkle.burst(10)
    m.game.playSound("coin")
    m.game.postGameEvent("coinCollected", {})
    ' Hide the coin's own circle immediately - invalidateAfter() keeps the
    ' whole entity (and its particle emitter) alive/updating for the grace
    ' period below, but the coin itself should visually vanish the instant
    ' it's collected while the sparkle plays on at that same position.
    m.removeDrawable("body")
    ' Delay invalidate() so the sparkle burst (lifetime 0.4s) gets a chance to
    ' actually render instead of being removed from the scene on this same
    ' frame - see GameEntity.invalidateAfter(). The isDying guard above stops
    ' the player still overlapping this coin next frame from re-triggering
    ' the sound/score/burst before it's actually gone.
    m.invalidateAfter(500)
  end sub

end class
