import "GameStateManager.bs"

' A non-pauseable entity that toggles a BGE.UI pause panel in step with
' Game.pause()/resume() - following the same "own entity for a
' meta/housekeeping concern" pattern as examples/breakout's PauseHandler,
' but with a real UI panel instead of a drawText overlay.
class PauseMenu extends BGE.GameEntity

  panel as BGE.UI.MessagePanel
  isOpen = false

  sub new(game as BGE.Game)
    super(game)
    m.name = "PauseMenu"
    ' Not persistent, unlike breakout's PauseHandler: MainScene.onCreate()
    ' unconditionally adds a fresh PauseMenu every time it runs (initial
    ' load and every Game.resetScene() on Restart Level). A persistent
    ' instance would survive that reset and coexist with the new one -
    ' both dispatching onControls for "pause" every frame, panels stacking,
    ' and (since persistent entities also survive changeScene()) every past
    ' instance leaking forward into TitleScene on Quit to Title, reacting to
    ' "pause" there against a MainScene that no longer exists. Same fix
    ' GameStateManager already uses for the identical reason.
    m.persistent = false
    m.pauseable = false
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' The panel itself (title + Resume/Restart Level/Quit to Title buttons)
    ' is intentionally NOT built here - see open()'s comment for why.
  end sub

  ' Uses BGE.UI.MessagePanel (show()/hide()) rather than removing/hiding the panel in
  ' place - see MessagePanel's own doc comment for why a modal panel must be built fresh
  ' right before showing and torn down (not just hidden) on close, to keep its buttons
  ' out of the shared FocusManager's registry while the panel isn't visible.
  sub open()
    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    resumeButton = new BGE.UI.MessagePanelButton("Resume", sub(button as BGE.UI.Button)
      menu = button.game.getEntityByName("PauseMenu") as PauseMenu
      menu.close()
    end sub)
    restartButton = new BGE.UI.MessagePanelButton("Restart Level", sub(button as BGE.UI.Button)
      ' close() (not just resume()) - Restart Level bypasses the Resume
      ' button entirely, so without this the just-built panel and its 3
      ' focus-registered buttons are never removed from gameUi: Game.
      ' handleSceneChange() (which resetScene() drives) never clears gameUi
      ' itself and destroys entities with callOnDestroy=false, so nothing
      ' tears the panel down on its own. Left leaked, the fresh PauseMenu
      ' MainScene.onCreate() adds next would stack a second identical panel
      ' on top of the orphaned one the next time it's opened.
      menu = button.game.getEntityByName("PauseMenu") as PauseMenu
      menu.close()
      button.game.resetScene()
    end sub)
    quitButton = new BGE.UI.MessagePanelButton("Quit to Title", sub(button as BGE.UI.Button)
      ' Same reasoning as restartButton above: without close() here, the
      ' panel's buttons would leak straight into TitleScene's own focus
      ' registry alongside its real Start Game button.
      menu = button.game.getEntityByName("PauseMenu") as PauseMenu
      menu.close()
      button.game.changeScene("TitleScene")
    end sub)

    ' Sized/colored to actually show as a panel via MessagePanel's own defaults - see
    ' MessagePanel.bs. Widened/heightened from the original 340x240 to fit the larger
    ' "heading" title font and taller buttons (48px -> 56px, for the bumped 30pt body
    ' font).
    m.panel = new BGE.UI.MessagePanel(m.game, 400.0, 275.0, [resumeButton, restartButton, quitButton], "Paused")
    m.panel.show(m.game.gameUi, width, height)
    m.isOpen = true
    m.game.pause()
  end sub

  sub close()
    m.isOpen = false
    m.panel.hide(m.game.gameUi)
    m.game.resume()
  end sub

  override sub onControls(controls as BGE.Controller.ControlMap)
    if controls.isActionPressed("pause")
      ' Don't reopen on top of a win/game-over end panel - GameStateManager
      ' already paused the game for that panel, and Resume here would
      ' un-pause a level whose gameOver/won flag is set, leaving gameplay
      ' silently inert behind the still-visible end panel.
      gsm = m.game.getEntityByName("GameStateManager") as GameStateManager
      if gsm <> invalid and (gsm.gameOver or gsm.won)
        return
      end if

      if m.isOpen
        m.close()
      else
        m.open()
      end if
    end if
  end sub

end class
