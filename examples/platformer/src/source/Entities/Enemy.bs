class Enemy extends BGE.GameEntity

  width = 48.0
  height = 48.0
  patrolSpeed = 100.0
  patrolRange = 128.0
  spawnX = 0.0
  spawnCaptured = false

  poof as BGE.DrawableParticles

  sub new(game as BGE.Game)
    super(game)
    m.name = "Enemy"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.velocity.x = m.patrolSpeed
    m.addRectangle("body", m.width, m.height, {
      offset: BGE.Math.VectorOps.create(-m.width / 2.0, m.height),
      color: &hCC3333 ' Drawable.color is packed RGB, not RGBA (see Coin.bs)
    })
    m.addRectangleCollider("body", m.width, m.height, -m.width / 2.0, m.height)
    m.poof = m.addParticles("poof", BGE.ParticleShape.Rectangle, {
      lifetime: 0.35,
      velocitySpreadMagnitude: 100.0,
      startColor: &hCC3333FF,
      endColor: &h662222FF,
      startAlpha: 220.0,
      endAlpha: 0.0,
      startSize: 6.0,
      endSize: 1.0
    })
  end sub

  override sub onUpdate(dt as float)
    ' MainRoom sets the real spawn position via addEntity(...).position.x/y
    ' *after* addEntity() returns - i.e. after onCreate() already ran - so
    ' capturing spawnX in onCreate() (like the constructor-time default 0.0
    ' logic below used to) always captured the pre-placement default 0.0, not
    ' the real spawn tile. Same timing issue Task 3 found and fixed for
    ' Player.spawnPosition; captured lazily here on first onUpdate instead,
    ' since every entity is fully positioned before the game loop's first
    ' onUpdate() call.
    if not m.spawnCaptured
      m.spawnX = m.position.x
      m.spawnCaptured = true
    end if

    if m.position.x <= m.spawnX - m.patrolRange
      m.velocity.x = m.patrolSpeed
    else if m.position.x >= m.spawnX + m.patrolRange
      m.velocity.x = -m.patrolSpeed
    end if
  end sub

  ' Called by Player.onCollision() when a stomp is detected. Bursts, plays a
  ' sound, and removes this entity - Player handles its own bounce velocity.
  ' Guarded by isDying since the player's collider can still overlap this
  ' enemy for a frame or two during the invalidateAfter() grace period below,
  ' which would otherwise re-trigger the sound/score/burst before it's gone.
  sub stomp()
    if m.isDying
      return
    end if
    m.poof.burst(12)
    m.game.playSound("stomp")
    m.game.postGameEvent("enemyStomped", {})
    ' Hide the enemy's own rectangle immediately - invalidateAfter() keeps the
    ' whole entity (and its particle emitter) alive/updating for the grace
    ' period below, but the enemy itself should visually vanish the instant
    ' it's stomped while the poof plays on at that same position.
    m.removeDrawable("body")
    ' Delay invalidate() so the poof burst (lifetime 0.35s) gets a chance to
    ' actually render - see GameEntity.invalidateAfter().
    m.invalidateAfter(450)
  end sub

end class
