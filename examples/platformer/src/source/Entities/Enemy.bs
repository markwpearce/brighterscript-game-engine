class Enemy extends BGE.GameEntity

  width = 48.0
  height = 48.0
  patrolSpeed = 100.0
  patrolRange = 128.0
  spawnX = 0.0
  spawnCaptured = false

  sprite as BGE.Sprite
  poof as BGE.DrawableParticles

  sub new(game as BGE.Game)
    super(game)
    m.name = "Enemy"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.velocity.x = m.patrolSpeed

    ' enemy.png is an 86x60, 10-col x 5-row grid (idle/walk/run/jump/dead), every
    ' frame facing right - only "walk" (patrol) and "dead" (stomp) are used by
    ' this entity today; run/jump/idle are along for the ride for a future enemy
    ' variant. Pretranslated so the sprite's feet sit at the entity's own
    ' position, matching the rectangle collider's own anchor below - the source
    ' frames share a common 680x472 canvas with the dino's feet consistently
    ' baselined at y=425 (confirmed across every animation row), i.e. 47px of
    ' transparent margin below the feet, or ~6px at this sprite's 60px cell
    ' height (86x60 = 680x472 scaled by 60/472) - without accounting for that
    ' margin the sprite floats a few pixels above the ground.
    m.sprite = m.addSprite("body", m.game.getBitmap("enemy"), 86, 60)
    m.sprite.applyPreTranslation(-43, -54)
    m.sprite.addAnimation("walk", {startFrame: 10, frameCount: 10}, 10, BGE.SpritePlayMode.Loop)
    ' One-shot, paced to finish within the invalidateAfter() grace period below so the
    ' dino visibly reacts to the stomp instead of just vanishing under the poof burst.
    m.sprite.addAnimation("dead", {startFrame: 40, frameCount: 8}, 8.0 / 0.45, BGE.SpritePlayMode.Forward)
    m.sprite.playAnimation("walk")

    m.addRectangleCollider("body", m.width, m.height, -m.width / 2.0, m.height)
    m.poof = m.addParticles("poof", BGE.ParticleShape.Rectangle, {
      lifetime: 0.35,
      velocitySpreadMagnitude: 100.0,
      startColor: &hCC3333FF,
      endColor: &h662222FF,
      startAlpha: 220.0,
      endAlpha: 0.0,
      startSize: 6.0,
      endSize: 1.0
    })
  end sub

  override sub onUpdate(dt as float)
    ' MainRoom sets the real spawn position via addEntity(...).position.x/y
    ' *after* addEntity() returns - i.e. after onCreate() already ran - so
    ' capturing spawnX in onCreate() (like the constructor-time default 0.0
    ' logic below used to) always captured the pre-placement default 0.0, not
    ' the real spawn tile. Same timing issue Task 3 found and fixed for
    ' Player.spawnPosition; captured lazily here on first onUpdate instead,
    ' since every entity is fully positioned before the game loop's first
    ' onUpdate() call.
    if not m.spawnCaptured
      m.spawnX = m.position.x
      m.spawnCaptured = true
    end if

    if m.position.x <= m.spawnX - m.patrolRange
      m.velocity.x = m.patrolSpeed
    else if m.position.x >= m.spawnX + m.patrolRange
      m.velocity.x = -m.patrolSpeed
    end if

    ' enemy.png's frames all face right, like player.png - mirror via the sprite's
    ' own scale.x sign (see Player.onUpdate()'s same trick) rather than a second
    ' frame set.
    if m.velocity.x < 0
      m.sprite.scale.x = -1.0
    else if m.velocity.x > 0
      m.sprite.scale.x = 1.0
    end if
  end sub

  ' Called by Player.onCollision() when a stomp is detected. Bursts, plays a
  ' sound, and removes this entity - Player handles its own bounce velocity.
  ' Guarded by isDying since the player's collider can still overlap this
  ' enemy for a frame or two during the invalidateAfter() grace period below,
  ' which would otherwise re-trigger the sound/score/burst before it's gone.
  sub stomp()
    if m.isDying
      return
    end if
    m.poof.burst(12)
    m.game.playSound("stomp")
    m.game.postGameEvent("enemyStomped", {})
    ' Stop patrolling and play the "dead" animation instead of hiding the sprite
    ' outright - it's paced (see onCreate()) to finish within the same grace
    ' period invalidateAfter() gives the poof burst below, so the dino visibly
    ' reacts to the stomp rather than just vanishing under the particles.
    m.velocity.x = 0.0
    m.sprite.playAnimation("dead")
    ' Delay invalidate() so both the poof burst (lifetime 0.35s) and the "dead"
    ' animation get a chance to actually render - see GameEntity.invalidateAfter().
    m.invalidateAfter(450)
  end sub

end class
