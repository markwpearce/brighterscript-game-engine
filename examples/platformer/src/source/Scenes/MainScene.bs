import "../LevelData.bs"
import "../Entities/Level.bs"
import "pkg:/source/utils/tiled/TiledLayers.bs"
import "../Entities/Player.bs"
import "../Entities/Coin.bs"
import "../Entities/Enemy.bs"
import "../Entities/Goal.bs"
import "../Entities/PlantBoss.bs"
import "../Entities/GameStateManager.bs"
import "../Entities/PauseMenu.bs"

class MainScene extends BGE.GameScene

  showingDebug = false

  ' Which level is currently loaded - see LevelData.getAllLevels(). Read back by
  ' onUpdate()'s camera-clamp math below, and forwarded (along with score/lives
  ' carried in via args) to every entity that needs it.
  currentLevelIndex = 0

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainScene"
  end sub

  ' @param {integer} [args.levelIndex=0] - which level to load, per LevelData.getAllLevels().
  ' @param {integer} [args.score] @param {integer} [args.lives] - forwarded to
  '   GameStateManager (see its own onCreate() doc comment) so a level-to-level
  '   advance (Goal.onCollision) carries the running score/lives forward instead
  '   of resetting them; omitted (nil) on the very first level load.
  override sub onCreate(args as roAssociativeArray)
    if invalid <> args.levelIndex
      m.currentLevelIndex = args.levelIndex as integer
    end if
    ' Added first so it draws behind everything else added afterward this frame
    ' (draw order follows insertion order - there's no settable zIndex on a
    ' Drawable/Image to reorder it explicitly).
    '
    ' Back-to-front draw order, increasing parallaxFactor per layer (examples/parallax's
    ' multi-layer pattern): bg_back (flat, very-distant bright-green hint) drifts least,
    ' bg_far (a full dark-forest silhouette scene) drifts a bit more, bg_middle (one large
    ' close-up tree) drifts the most of the three.
    '
    ' All three share the same owner (m, this GameScene, sitting at the default (0,0,0)
    ' position) as their parallax reference point, and their factors are all close to 1 -
    ' with no offset compensation (unlike examples/parallax's newLayer(), which always
    ' applies one), every layer's own tile-repeat boundary landed at nearly the same
    ' on-canvas position for as long as the camera sits at its initial rest position (which
    ' is also where it stays clamped for the level's whole opening stretch, until the
    ' player runs far enough right to unclamp it) - three overlapping, reinforcing
    ' boundaries read as one obvious seam, worse than any single layer's own repeat would
    ' be alone. newBackgroundLayer()'s targetX staggers each layer's boundary to a
    ' different on-canvas position instead so they don't reinforce each other, and its Y
    ' offset pins every layer's vertical tile boundary to the very top edge permanently
    ' (this GameScene's camera.y target never changes - see onUpdate() - so this isn't just a
    ' best-effort anchor, it's an exact, permanent fix on that axis).
    m.addDrawable("bgBack", m.newBackgroundLayer("bgBack", 0.02, 0))
    m.addDrawable("bgFar", m.newBackgroundLayer("bgFar", 0.05, 96))
    m.addDrawable("bgMiddle", m.newBackgroundLayer("bgMiddle", 0.1, 192))
    ' Pushed back so the boss (z = -1) can sit between the backgrounds and the
    ' level's floor tiles (z = 0) and sink out of sight behind the floor.
    for each bgName in ["bgBack", "bgFar", "bgMiddle"]
      m.getDrawable(bgName).offset.z = -10
    end for

    levelArgs = {levelIndex: m.currentLevelIndex}
    gameStateArgs = {levelIndex: m.currentLevelIndex}
    if invalid <> args.score
      gameStateArgs.score = args.score
    end if
    if invalid <> args.lives
      gameStateArgs.lives = args.lives
    end if

    m.game.addEntity(new Level(m.game), levelArgs)
    m.game.addEntity(new GameStateManager(m.game), gameStateArgs)
    m.game.addEntity(new PauseMenu(m.game))

    map = getLevelMap(m.currentLevelIndex)
    if map <> invalid
      ' Each spawn point sits exactly where its entity's position goes
      offsetY = getLevelMapOffsetY(map)
      spawns = BGE.Tiled.getLayer(map, "spawns")
      if spawns = invalid
        print "MainScene: the level's map has no ""spawns"" layer"
        return
      end if
      for each spawn in spawns.objects
        m.spawnEntity(spawn.type, BGE.Tiled.toWorldX(map, spawn.x), BGE.Tiled.toWorldY(map, spawn.y, offsetY), levelArgs)
      end for
      return
    end if

    spawnKinds = {"P": "player", "o": "coin", "e": "enemy", "B": "boss", "G": "goal"}
    rows = getLevelRows(m.currentLevelIndex)
    for r = 0 to rows.count() - 1
      row = rows[r]
      for c = 0 to row.len() - 1
        kind = spawnKinds[row.mid(c, 1)]
        if kind = "boss"
          ' The boss is placed by its left edge, not its center - in the 10-column
          ' arena that's x = 320, dead center, leaving equal clearance to both side
          ' platforms.
          m.spawnEntity(kind, c * TileSize, m.getSpawnY(kind, r), levelArgs)
        else if kind <> invalid
          m.spawnEntity(kind, c * TileSize + TileSize / 2.0, m.getSpawnY(kind, r), levelArgs)
        end if
      end for
    end for
  end sub

  ' World y for a spawn marker in string-level row r.
  private function getSpawnY(kind as string, r as integer) as float
    if kind = "player"
      ' Player has gravity: it starts at the marker row's top and falls into place
      return (NumRows - r) * TileSize
    else if kind = "coin"
      return (NumRows - r) * TileSize - TileSize / 2.0
    end if
    ' Enemy, Goal and PlantBoss have no gravity, so they start on the ground tile's
    ' top edge (one row below the marker's own row)
    return (NumRows - r - 1) * TileSize
  end function

  ' Adds one level entity at a world position.
  '
  ' @param {string} kind - "player", "coin", "enemy", "boss" or "goal"
  private sub spawnEntity(kind as string, x as float, y as float, levelArgs as roAssociativeArray)
    entity = invalid
    if kind = "player"
      entity = m.game.addEntity(new Player(m.game), levelArgs)
    else if kind = "coin"
      entity = m.game.addEntity(new Coin(m.game))
    else if kind = "enemy"
      entity = m.game.addEntity(new Enemy(m.game))
    else if kind = "boss"
      entity = m.game.addEntity(new PlantBoss(m.game))
    else if kind = "goal"
      entity = m.game.addEntity(new Goal(m.game), levelArgs)
    else
      print "MainScene: unknown spawn type """; kind; """"
      return
    end if
    entity.position.x = x
    entity.position.y = y
  end sub

  override sub onInput(input as BGE.GameInput)
    ' Back is the "pause" action (main.bs), handled by PauseMenu.onControls() - not a quit here.
    if input.press and input.isButton("options")
      m.showingDebug = not m.showingDebug
      m.game.debugShowUi(m.showingDebug, true)
      m.game.debugDrawColliders(m.showingDebug)
    end if
  end sub

  override sub onGameEvent(eventName as string, data as roAssociativeArray)
    if eventName = "bossDefeated"
      m.spawnBossGoal(data.x, data.y)
    end if
  end sub

  ' The boss level has no G - the flag grows out of the ground where the boss sank.
  private sub spawnBossGoal(x as float, y as float)
    goalEntity = new Goal(m.game)
    m.game.addEntity(goalEntity, {levelIndex: m.currentLevelIndex})
    goalEntity.position.x = x
    goalEntity.position.y = y
    goalEntity.scale.x = 0.0
    goalEntity.scale.y = 0.0
    m.game.tweenManager.to(goalEntity.scale, {x: 1.0, y: 1.0}, 600, BGE.Tweens.Easing.ElasticEaseOut)
  end sub

  override sub onUpdate(dt as float)
    playerEntity = m.game.getEntityByName("Player") as Player
    if invalid = playerEntity
      return
    end if

    camera = m.game.canvas.renderer.camera
    halfViewWidth = camera.frameSize.x / 2.0
    levelWidth = getLevelNumCols(m.currentLevelIndex) * TileSize

    targetX = playerEntity.position.x
    minX = halfViewWidth
    maxX = levelWidth - halfViewWidth
    if targetX < minX
      targetX = minX
    else if targetX > maxX
      targetX = maxX
    end if

    ' TODO: allow camera to move up & Down?

    camera.setTarget(BGE.Math.VectorOps.create(targetX, camera.frameSize.y / 2.0))
  end sub

  ' Builds one repeating, canvas-height-filling background layer from an already-loaded
  ' bitmap, via BGE.newFullHeightParallaxLayer - see that function's doc comment for the
  ' targetX/offset derivation this wraps. Callers pass a different targetX per layer so
  ' the three layers' seams land at different on-canvas spots instead of all landing near
  ' the same one (see onCreate()'s comment above on why that matters).
  private function newBackgroundLayer(bitmapName as string, factor as float, targetX as float) as BGE.DrawableParallaxLayer
    bmp = m.game.getBitmap(bitmapName)
    region = CreateObject("roRegion", bmp, 0, 0, bmp.GetWidth(), bmp.GetHeight())
    return BGE.newFullHeightParallaxLayer(m, region, m.game.canvas.getWidth(), m.game.canvas.getHeight(), factor, targetX, 0.0)
  end function

end class
