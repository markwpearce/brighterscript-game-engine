import "pkg:/source/utils/tiled/TiledLayers.bs"

' The platformer's level layouts. Level 1 is a Tiled map (see getLevelMap()), to
' show loading one; the rest are one row-of-characters-per-string array per level,
' which is quicker to read and edit in code. Row 0 is the
' top of a level; row (NumRows - 1) is the camera-visible bottom row (world y = 0,
' via Level.bs's `(NumRows - r) * TileSize` formula - this always lands exactly on
' MainScene's fixed camera framing's bottom edge, regardless of how many rows exist
' above or below it). Legend:
'   #  solid tile (blocks from every side)
'   -  one-way platform (land on top only, pass through from below/side)
'   o  coin spawn
'   e  enemy patrol spawn
'   P  player spawn
'   G  goal spawn
'   B  boss spawn (rooted on the ground tile below)
'   .  empty
'
' Rows after index (NumRows - 1) are optional: the same `(NumRows - r) * TileSize`
' formula gives them a negative world y (below the camera's fixed bottom edge, so
' never actually visible), which is exactly the point - see the extra buried-filler
' rows below.
'
' Every level shares the same NumRows (the camera-anchoring formula above depends
' on it staying fixed) but each has its own width (getLevelNumCols()) - later
' levels are simply longer, with more/wider gaps and more enemies, rather than
' taller. `levelIndex` picks a level throughout this file and MainScene/Level/
' Player/Goal - see their own `levelIndex` fields/args.
const TileSize = 64
const NumRows = 11

' Level 1 is a Tiled map instead (src/maps/level1.tmj, edited in Tiled - see
' getLevelMap()). Its tile layer uses the same rows and columns as the strings
' below, including the buried filler rows.
const Level1MapPath = "pkg:/maps/level1.tmj"

