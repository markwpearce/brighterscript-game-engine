  return [
    "............................................",
    "............................................",
    "............................................",
    "............................................",
    "............................................",
    "............................................",
    "...................ooo......................",
    "..................-----.....................",
    ".P...ooo..e..............ooo......e......G..",
    "##############..##############..############",
    "##############..##############..############",
    "##############..##############..############",
    "##############..##############..############",
    "##############..##############..############",
    "##############..##############..############"
  ]
end function

