' The platformer's level layout, as one row-of-characters-per-string array -
' no tilemap format/editor, per this example's design spec. Row 0 is the top
' of the level; row (NumRows - 1) is the camera-visible bottom row (world y = 0,
' via Level.bs's `(NumRows - r) * TileSize` formula - this always lands exactly on
' MainRoom's fixed camera framing's bottom edge, regardless of how many rows exist
' above or below it). Legend:
'   #  solid tile (blocks from every side)
'   -  one-way platform (land on top only, pass through from below/side)
'   o  coin spawn
'   e  enemy patrol spawn
'   P  player spawn
'   G  goal spawn
'   .  empty
'
' Rows after index (NumRows - 1) are optional: the same `(NumRows - r) * TileSize`
' formula gives them a negative world y (below the camera's fixed bottom edge, so
' never actually visible), which is exactly the point - see the extra buried-filler
' rows below.
const TileSize = 64
const NumCols = 40
const NumRows = 11

function getLevelRows() as string[]
  return [
    "........................................",
    "........................................",
    "........................................",
    "........................................",
    "........................................",
    "........................................",
    "................ooo.....................",
    "...............-----....................",
    ".P...ooo...................e...oo...G...",
    "####################..##################",
    "####################..##################",
    ' Extra buried filler, purely defensive: MainRoom's camera Y target/frameSize
    ' math already puts world y = 0 (the row above, index NumRows - 1) exactly on the
    ' visible screen's bottom edge with no gap (confirmed on-device - see
    ' specs/ or the ground-depth fix commit), so these rows never actually appear
    ' on screen. They exist only to guard against a future camera change (e.g. any
    ' vertical follow/shake) exposing world y < 0 with nothing solid underneath. Row
    ' index intentionally does NOT bump NumRows - see Level.bs/MainRoom.bs comments
    ' on why every Y-position formula in this example is anchored off the NumRows
    ' constant, not off the level array's actual length; bumping NumRows here would
    ' shift the existing ground/spawn positions up instead of merely adding depth
    ' below them. Pit columns (20-21) stay open here too, so falling into the pit is
    ' still a real bottomless-void hazard, not a false floor.
    "####################..##################",
    "####################..##################",
    "####################..##################",
    "####################..##################"
  ]
end function

' Whether a solid ("#") or one-way ("-") tile has its top edge exactly at world y and
' spans world x - the same tile characters Level.bs turns into colliders, queried
' directly from the static layout instead of through collision-detection. Player.bs uses
' this to confirm it's still resting on the ground each frame it's already grounded,
' rather than depending on onCollision() re-firing every single frame for an unbroken,
' already-overlapping pair - confirmed on real hardware that Roku's compositor does not
' reliably do that, so a continuously-resting (or walking) player's own "assume airborne,
' wait for onCollision to re-confirm" logic flickered true/false on a roughly-every-other-
' frame basis, animating a jump pose for one frame even though nothing about the player's
' situation actually changed.
'
' @param {float} x - world x to check. Checked as a single point (the caller's own
'   horizontal center, e.g. Player.position.x), not the caller's full hitbox width -
'   stricter than the AABB-overlap collision check it replaces for "am I still
'   grounded": a walkway narrower than the caller's hitbox could read as ungrounded
'   slightly before the old logic would have. Not an issue for this level's 64px
'   tiles/56px hitbox and contiguous solid runs, but worth knowing before narrowing
'   a walkway below the hitbox width in a future level.
' @param {float} y - world y to check (must be a tile's exact top edge, e.g. Player.position.y
'   while resting - this is a point lookup, not a range/overlap test)
' @return {boolean}
function isSolidGroundAt(x as float, y as float) as boolean
  col = Int(x / TileSize)
  row = NumRows - Int(y / TileSize)
  if row < 0 or col < 0 or col >= NumCols
    return false
  end if
  rows = getLevelRows()
  if row >= rows.count()
    return false
  end if
  tileChar = rows[row].mid(col, 1)
  return tileChar = "#" or tileChar = "-"
end function
