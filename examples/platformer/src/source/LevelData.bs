' The final level: a one-screen boss arena (10 columns = exactly one 640px camera
' frame, so the camera never scrolls), a one-way platform on each side.
function getLevel7Rows() as string[]
  return [
    "..........",
    "..........",
    "..........",
    "..........",
    "..........",
    "..........",
    "..........",
    "---....---",
    ".P...B....",
    "##########",
    "##########",
    "##########",
    "##########",
    "##########",
    "##########"
  ]
end function

' Every level in play order: a Tiled map's path, or a row array - `levelIndex`
' everywhere in this example (MainScene/Level/Player/Goal) is a 0-based index into
' this array.
' Built once and kept: Player asks about the ground every frame.
function getAllLevels() as object
  globals = GetGlobalAA()
  if globals.platformerLevels = invalid
    globals.platformerLevels = [
      Level1MapPath,
      getLevel2Rows(),
      getLevel3Rows(),
      getLevel4Rows(),
      getLevel5Rows(),
      getLevel6Rows(),
      getLevel7Rows()
    ]
  end if
  return globals.platformerLevels
end function

function getLevelCount() as integer
  return (getAllLevels()).count()
end function

' @param {integer} levelIndex - 0-based; clamped into range so an out-of-bounds
'   index (e.g. a bad `level` launch param, see main.bs) falls back to the last
'   real level rather than crashing.
' @return {dynamic} the level's map path or row array
function getLevelSource(levelIndex as integer) as dynamic
  levels = getAllLevels()
  clampedIndex = levelIndex
  if clampedIndex < 0
    clampedIndex = 0
  else if clampedIndex >= levels.count()
    clampedIndex = levels.count() - 1
  end if
  return levels[clampedIndex]
end function

' @param {integer} levelIndex
' @return {string[]} the given level's row layout; empty for a Tiled map level
function getLevelRows(levelIndex as integer) as string[]
  source = getLevelSource(levelIndex)
  if GetInterface(source, "ifArray") = invalid
    return []
  end if
  return source
end function

' The given level's Tiled map, parsed on first use and then kept (Player asks every
' frame, via isSolidGroundAt()).
'
' A map has a "ground" tile layer, whose tiles' "collision" property is "solid" or
' "oneWay", and a "spawns" object layer of points typed player/coin/enemy/goal/boss,
' each placed where that entity's position goes.
'
' @param {integer} levelIndex
' @return {BGE.Tiled.TiledMap} invalid for a string level
function getLevelMap(levelIndex as integer) as BGE.Tiled.TiledMap
  source = getLevelSource(levelIndex)
  if GetInterface(source, "ifString") = invalid
    return invalid
  end if
  globals = GetGlobalAA()
  if globals.platformerLevelMaps = invalid
    globals.platformerLevelMaps = {}
  end if
  cached = globals.platformerLevelMaps[source]
  if cached = invalid
    cached = BGE.Tiled.parseMapFile(source)
    if cached = invalid
      ' Already reported by parseMapFile(); remember the failure rather than retry
      ' every frame. The level is then empty.
      cached = false
    end if
    globals.platformerLevelMaps[source] = cached
  end if
  if GetInterface(cached, "ifAssociativeArray") = invalid
    return invalid
  end if
  return cached
end function

' The "col,row" keys of a Tiled level's colliding ground cells - the same cells Level.bs
' makes colliders for - built once, since Player asks every frame.
'
' @param {integer} levelIndex
' @return {roAssociativeArray} invalid for a string level
function getLevelMapSolidCells(levelIndex as integer) as roAssociativeArray
  map = getLevelMap(levelIndex)
  if map = invalid
    return invalid
  end if
  source = getLevelSource(levelIndex) as string
  globals = GetGlobalAA()
  if globals.platformerLevelSolidCells = invalid
    globals.platformerLevelSolidCells = {}
  end if
  solidCells = globals.platformerLevelSolidCells[source]
  if solidCells = invalid
    solidCells = {}
    for each cell in BGE.Tiled.layerToColliderCells(map, BGE.Tiled.getLayer(map, "ground"), "collision")
      solidCells[cell.col.toStr() + "," + cell.row.toStr()] = true
    end for
    globals.platformerLevelSolidCells[source] = solidCells
  end if
  return solidCells
end function

' World units to add to a map's y coordinates so its row NumRows lands on world y = 0,
' as `(NumRows - r) * TileSize` does for string levels (the rows below it are buried
' filler).
'
' @param {BGE.Tiled.TiledMap} map
' @return {float}
function getLevelMapOffsetY(map as BGE.Tiled.TiledMap) as float
  return (NumRows - map.height) * TileSize
end function

' A level's width, derived from its own row length rather than a shared constant -
' unlike NumRows, levels are not all the same width.
'
' @param {integer} levelIndex
' @return {integer}
function getLevelNumCols(levelIndex as integer) as integer
  map = getLevelMap(levelIndex)
  if map <> invalid
    return map.width
  end if
  rows = getLevelRows(levelIndex)
  if rows.count() = 0
    return 0
  end if
  return rows[0].len()
end function

' Whether a solid ("#") or one-way ("-") tile has its top edge exactly at world y and
' spans world x - the same tile characters Level.bs turns into colliders, queried
' directly from the static layout instead of through collision-detection. Player.bs uses
' this to confirm it's still resting on the ground each frame it's already grounded.
' onCollision() can't do that: a landing snaps the player flush to the tile top, and
' flush edges don't overlap, so the next frame has no collision (issue #200).
'
' @param {float} x - world x to check. Checked as a single point (the caller's own
'   horizontal center, e.g. Player.position.x), not the caller's full hitbox width -
'   stricter than the AABB-overlap collision check it replaces for "am I still
'   grounded": a walkway narrower than the caller's hitbox could read as ungrounded
'   slightly before the old logic would have. Not an issue for this level's 64px
'   tiles/56px hitbox and contiguous solid runs, but worth knowing before narrowing
'   a walkway below the hitbox width in a future level.
' @param {float} y - world y to check (must be a tile's exact top edge, e.g. Player.position.y
'   while resting - this is a point lookup, not a range/overlap test)
' @param {integer} levelIndex - which level's layout to check against (see MainScene/
'   Player's own `levelIndex` field)
' @return {boolean}
function isSolidGroundAt(x as float, y as float, levelIndex as integer) as boolean
  col = Int(x / TileSize)
  row = NumRows - Int(y / TileSize)
  if row < 0 or col < 0
    return false
  end if
  solidCells = getLevelMapSolidCells(levelIndex)
  if solidCells <> invalid
    return solidCells.DoesExist(col.toStr() + "," + row.toStr())
  end if
  rows = getLevelRows(levelIndex)
  if rows.count() = 0 or col >= rows[0].len() or row >= rows.count()
    return false
  end if
  tileChar = rows[row].mid(col, 1)
  return tileChar = "#" or tileChar = "-"
end function
