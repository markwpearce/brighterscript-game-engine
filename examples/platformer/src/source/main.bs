import "LevelData.bs"

sub Main(args = [] as object)
  game = new BGE.Game(640, 360)
  game.fitCanvasToScreen()
  game.enableControllerInput()

  ' "move" falls back to the remote d-pad automatically when no stick input
  ' is present (ControlMap.getAxis()), so the Roku remote alone is enough -
  ' a connected phone/web controller (examples/controller's protocol) or an
  ' analog gamepad stick adds smoother movement on top, with no extra code.
  game.controls.bindAxis("move", "1", 0, "Move")
  ' "ok"/"back" also drive menus (controller-web/index.html's on-screen buttons,
  ' plus a remote's own alias). controllerButton also lists "a"/"b" - a real
  ' gamepad plugged into the browser page sends those (unaliased, unlike the
  ' remote path) for its two primary face buttons.
  game.controls.bindAction("jump", "OK", ["ok", "a"], 0, "Jump")
  game.controls.bindAction("pause", "back", ["back", "b"], 0, "Pause")

  ' Reuses the same "move" axis for menu navigation (title screen, pause menu,
  ' win/game-over panel) - see FocusManager.updateAnalogList(). navigationMode
  ' stays the default "list" (a d-pad-style step through Start Game/Connect
  ' Controller/etc, not a spatial cursor), so this only changes how an analog
  ' stick drives that same stepping; the remote d-pad's own behavior (via
  ' regular button events) is untouched.
  game.focusManager.analogAxisName = "move"

  game.loadBitmap("player", "pkg:/sprites/player.png")
  game.loadBitmap("enemy", "pkg:/sprites/enemy.png")
  game.loadBitmap("goal", "pkg:/sprites/goal.png")
  game.loadBitmap("tileSurface", "pkg:/sprites/tile_surface.png")
  game.loadBitmap("tileFill", "pkg:/sprites/tile_fill.png")
  game.loadBitmap("bgBack", "pkg:/sprites/bg_back.png")
  game.loadBitmap("bgFar", "pkg:/sprites/bg_far.png")
  game.loadBitmap("bgMiddle", "pkg:/sprites/bg_middle.png")
  game.loadSound("jump", "pkg:/sounds/jump.wav")
  game.loadSound("coin", "pkg:/sounds/coin.wav")
  game.loadSound("stomp", "pkg:/sounds/stomp.wav")
  game.loadSound("die", "pkg:/sounds/die.wav")
  game.loadSound("slide", "pkg:/sounds/slide.wav")
  game.loadSound("monsterEat", "pkg:/sounds/monster_eat.wav")
  game.loadSound("monsterDie", "pkg:/sounds/monster_die.wav")
  game.loadSound("flag", "pkg:/sounds/flag.wav")
  game.loadSound("uiFocus", "pkg:/sounds/ui_focus.wav")
  game.loadSound("uiClick", "pkg:/sounds/ui_click.wav")
  ' Applies to every BGE.UI.Button in this game (title screen, pause menu, win/game-over
  ' panel) - see Button.onFocus()/onClick() - rather than wiring focusSoundKey/
  ' clickSoundKey on each button individually.
  game.uiFocusSoundKey = "uiFocus"
  game.uiClickSoundKey = "uiClick"

  ' Looping background music for the whole session (title screen + gameplay) -
  ' Game itself doesn't track per-room music state, so this is a one-shot call
  ' here rather than something rooms start/stop on their own (see examples/audio's
  ' MainRoom for the pattern where a room *does* need to toggle play/pause/stop).
  game.musicPlay("pkg:/sounds/rumble_jungle.mp3", true)

  ' "body" (buttons/labels/HUD, via defaultTheme.font), "hint" (TitleRoom's
  ' smaller controls line, over the title screen's background art), and
  ' "heading" (PauseMenu's short, fixed-width panel title) - see Theme.font
  ' doc comment: a UiContainer.theme override is what gives a specific
  ' container its own font size, since a single Theme only carries one font.
  ' Sized for a 640x360 canvas (half 720p's vertical resolution) - a
  ' playtest on a real TV found the original 24/18 sizes (chosen when this
  ' example still targeted 1280x720) illegibly small at this resolution, so
  ' these were bumped up for comfortable across-the-room legibility.
  game.registerFont("pkg:/fonts/SuperBouncer.ttf")
  game.loadFont("body", "Super Bouncer", 30, false, false)
  game.loadFont("hint", "Super Bouncer", 24, false, false)
  game.loadFont("heading", "Super Bouncer", 36, false, false)

  ' Warm rock-brown/amber palette pulled from the tileset/player art, applied
  ' engine-wide via defaultTheme so every BGE.UI widget in this example (no
  ' per-container overrides needed) picks it up automatically.
  game.defaultTheme.font = game.getFont("body")
  game.defaultTheme.backgroundColor = &h4A2E1AFF ' dark rock-brown button/panel fill
  game.defaultTheme.hoveredBackgroundColor = &h7A4B26FF ' lighter warm brown
  game.defaultTheme.focusedBorderColor = &hF2A93AFF ' amber focus ring
  game.defaultTheme.foregroundColor = &hF5E6C8FF ' warm cream

  game.defineRoom(new MainRoom(game))

  titleScreen = new TitleRoom(game)
  game.defineRoom(titleScreen)

  ' A `level` deep-link/launch param (e.g. `rokubot launch dev --param level=3`)
  ' skips straight to that level instead of the title screen - the same
  ' convention rendererTest's `demo` param uses to skip its own menu. 1-based
  ' in the param (friendlier for manual testing) since every other in-game
  ' level reference (LevelData/GameStateManager's "Level N/M" HUD text) is
  ' also 1-based; converted to a 0-based levelIndex here.
  startLevel = getRequestedStartLevel(args)
  if startLevel >= 0
    game.changeRoom("MainRoom", {levelIndex: startLevel})
  else
    game.changeRoom(titleScreen.name)
  end if

  game.enableStandardDebugUi({memory: false, garbageCollector: false, log: false})

  game.play()
end sub

' Pulls a `level` deep-link/launch param out of Main()'s args. Roku wraps launch
' params in a one-element array containing the actual roAssociativeArray.
'
' @param args
' @return {integer} a 0-based level index clamped into range, or -1 if no valid
'   `level` param was given (meaning: go to the title screen as normal)
function getRequestedStartLevel(args as object) as integer
  params = args
  if type(args) = "roArray" and args.count() > 0
    params = args[0]
  end if
  if type(params) <> "roAssociativeArray" or invalid = params.level
    return -1
  end if
  requestedLevel = Val(params.level.toStr()) ' launch params always arrive as strings
  levelIndex = Int(requestedLevel) - 1 ' 1-based param -> 0-based index
  if levelIndex < 0
    levelIndex = 0
  else if levelIndex >= getLevelCount()
    levelIndex = getLevelCount() - 1
  end if
  return levelIndex
end function
