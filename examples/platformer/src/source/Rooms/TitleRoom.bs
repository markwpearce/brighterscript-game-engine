class TitleRoom extends BGE.Room

  sub new(game as BGE.Game)
    super(game)
    m.name = "TitleRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.game.gameUi.clearChildren()

    ' GameStateManager.showEndPanel() pauses the game on game-over/win, and
    ' only its own onCreate() (the Retry path) undoes that - "Quit to Title"
    ' changes rooms instead, so without this the game stays paused forever
    ' and this room's own onInput() (pauseable defaults true) never fires.
    m.game.Resume()

    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    ' title_bg.png is a single 640x360 piece of art sized to exactly match the
    ' canvas, with the "JUNGLE ADVENTURE" logo and player character already
    ' baked in - so it replaces both the old parallax forest backdrop and the
    ' separate text heading Label that used to sit on top of it. Drawn as a
    ' UI widget on gameUi (uiCanvas coordinates, same as the hint/button below)
    ' rather than a world-space GameEntity Image - a Room's own drawables live
    ' in game-canvas/world space (subject to the camera's own position/anchor
    ' conventions), which is the wrong coordinate system for a plain
    ' full-canvas background image and was landing offset. Added first so it
    ' draws behind the hint text/button added afterward this frame.
    titleBg = new TitleBackgroundImage(m.game, BGE.UI.loadBackgroundImage("pkg:/sprites/title_bg.png"))
    titleBg.customPosition = true
    titleBg.customX = 0
    titleBg.customY = 0
    titleBg.width = width
    titleBg.height = height
    m.game.gameUi.addChild(titleBg)

    ' The background art's logo/character occupy roughly its top two-thirds,
    ' with denser jungle-floor foliage below (and a calmer gap in the middle
    ' right below the character's feet) - so the hint text and Start button
    ' sit low in that calmer gap instead of overlapping the art's own logo or
    ' character.
    '
    ' Both the button's size and the vertical gap between hint/button are
    ' derived from the actual font metrics (GetOneLineWidth/GetOneLineHeight)
    ' rather than fixed canvas percentages that "happened to work" only
    ' because the fonts used to be small - and are stacked bottom-up from a
    ' safe bottom anchor so the two never overlap regardless of exactly how
    ' tall Super Bouncer's glyphs render at these sizes. This keeps both
    ' comfortably within the engine's ~5% vertical / ~10% horizontal
    ' title-safe margins.
    hintContainer = new BGE.UI.UiContainer(m.game)
    hintContainer.showBackground = false
    hintContainer.theme = new BGE.UI.Theme()
    hintContainer.theme.font = m.game.getFont("hint")

    hintLine1 = "Move: d-pad/stick   Jump: OK"
    hintLine2 = "Pause: Back"
    hintFont = m.game.getFont("hint")
    hintWidth = BGE.Math.Max(hintFont.GetOneLineWidth(hintLine1, 10000), hintFont.GetOneLineWidth(hintLine2, 10000))
    hintBlockHeight = hintFont.GetOneLineHeight() * 2 ' two stacked lines

    startLabelText = "Start Game"
    startFont = m.game.getFont("body")
    startTextWidth = startFont.GetOneLineWidth(startLabelText, 10000)
    startTextHeight = startFont.GetOneLineHeight()
    startButtonPaddingX = 64 ' generous horizontal padding around the label
    startButtonPaddingY = 28 ' generous vertical padding so the larger body font isn't cramped

    bottomSafeY = height * 0.92 ' comfortably inside the ~5% bottom title-safe edge
    gapBetweenHintAndButton = 32

    startButton = new BGE.UI.Button(m.game)
    startButton.setLabel(startLabelText)
    startButton.customPosition = true
    startButton.width = startTextWidth + startButtonPaddingX
    startButton.height = startTextHeight + startButtonPaddingY
    startButton.customX = (width - startButton.width) / 2
    startButton.customY = bottomSafeY - startButton.height
    startButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeRoom("MainRoom")
    end sub

    hint = new BGE.UI.Label(m.game)
    hint.customPosition = true
    hint.customX = (width - hintWidth) / 2
    hint.customY = startButton.customY - gapBetweenHintAndButton - hintBlockHeight
    hint.setText(hintLine1 + Chr(10) + hintLine2)
    hint.drawableText.textColor = &hF5E6C8FF ' warm cream, readable over the art's dark jungle-floor foliage
    hintContainer.addChild(hint)
    m.game.gameUi.addChild(hintContainer)
    m.game.gameUi.addChild(startButton)

    ' Focuses the Start button immediately, rather than leaving it unfocused
    ' until the player's first press - see FocusManager.ensureFocusSeeded().
    m.game.focusManager.ensureFocusSeeded()
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    end if
  end sub

end class

' A plain full-canvas background image widget for gameUi - draws a
' BGE.UI.ImageBackground (see BGE.UI.loadBackgroundImage()) stretched to its
' own bounds. No widget in BGE.UI does this on its own today: Theme.backgroundImage
' is only ever consulted by interactive widgets (Button, Checkbox, Slider,
' Select, TextInput) via their shared UiWidget.drawThemedBackground() helper,
' and UiContainer's own draw() always fills with a flat color, never an image.
class TitleBackgroundImage extends BGE.UI.UiWidget

  private background as BGE.UI.ImageBackground

  sub new(game as BGE.Game, background as BGE.UI.ImageBackground)
    super(game)
    m.background = background
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    if m.background <> invalid
      m.background.draw(m.canvas.renderer, m.position.x, m.position.y, m.width, m.height)
    end if
  end sub

end class
