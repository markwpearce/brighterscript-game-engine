class TitleRoom extends BGE.Room

  sub new(game as BGE.Game)
    super(game)
    m.name = "TitleRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.game.gameUi.clearChildren()

    ' GameStateManager.showEndPanel() pauses the game on game-over/win, and
    ' only its own onCreate() (the Retry path) undoes that - "Quit to Title"
    ' changes rooms instead, so without this the game stays paused forever
    ' and this room's own onInput() (pauseable defaults true) never fires.
    m.game.Resume()

    ' Same parallax forest backdrop as MainRoom (issue-free to reuse: these
    ' bitmaps are already loaded in main.bs) so the title screen doesn't open
    ' on a flat black canvas.
    m.addDrawable("bgBack", m.newBackgroundLayer("bgBack", 0.02))
    m.addDrawable("bgFar", m.newBackgroundLayer("bgFar", 0.05))
    m.addDrawable("bgMiddle", m.newBackgroundLayer("bgMiddle", 0.1))

    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    ' A dedicated container just for the heading, so it alone can carry a
    ' bigger font (Theme.font is one size per Theme/container - see
    ' UiContainer.effectiveTheme() - applying a "heading" theme directly to
    ' gameUi would also blow up the hint text and button label to 44px).
    headingContainer = new BGE.UI.UiContainer(m.game)
    headingContainer.showBackground = false
    headingContainer.theme = new BGE.UI.Theme()
    headingContainer.theme.font = m.game.getFont("heading")

    headingText = "Platformer"
    headingWidth = m.game.getFont("heading").GetOneLineWidth(headingText, 10000)

    title = new BGE.UI.Label(m.game)
    title.customPosition = true
    title.customX = (width - headingWidth) / 2
    title.customY = height * 0.12
    title.setText(headingText)
    title.drawableText.textColor = &hFFD966FF ' bright gold, stands out against the forest greens
    headingContainer.addChild(title)
    m.game.gameUi.addChild(headingContainer)

    ' Its own (smaller) font/container, same reasoning as headingContainer -
    ' two lines at the small "hint" size keep this comfortably inside the
    ' title-safe area instead of running the full instructional line off
    ' either edge at the much larger body/heading sizes.
    hintContainer = new BGE.UI.UiContainer(m.game)
    hintContainer.showBackground = false
    hintContainer.theme = new BGE.UI.Theme()
    hintContainer.theme.font = m.game.getFont("hint")

    hintLine1 = "Move: d-pad/stick   Jump: OK"
    hintLine2 = "Pause: Options"
    hintFont = m.game.getFont("hint")
    hintWidth = BGE.Math.Max(hintFont.GetOneLineWidth(hintLine1, 10000), hintFont.GetOneLineWidth(hintLine2, 10000))

    hint = new BGE.UI.Label(m.game)
    hint.customPosition = true
    hint.customX = (width - hintWidth) / 2
    hint.customY = height * 0.32
    hint.setText(hintLine1 + Chr(10) + hintLine2)
    hint.drawableText.textColor = &hF5E6C8FF ' warm cream, readable over dark or light forest layers
    hintContainer.addChild(hint)
    m.game.gameUi.addChild(hintContainer)

    startButton = new BGE.UI.Button(m.game)
    startButton.setLabel("Start Game")
    startButton.customPosition = true
    startButton.width = width * 0.28
    startButton.height = height * 0.15
    startButton.customX = (width - startButton.width) / 2
    startButton.customY = height * 0.52
    startButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeRoom("MainRoom")
    end sub
    m.game.gameUi.addChild(startButton)

    ' Focuses the Start button immediately, rather than leaving it unfocused
    ' until the player's first press - see FocusManager.ensureFocusSeeded().
    m.game.focusManager.ensureFocusSeeded()
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    end if
  end sub

  ' Same tiling-parallax-layer construction as MainRoom.newBackgroundLayer()
  ' - duplicated rather than shared since these two rooms don't otherwise
  ' share a base class and this is only a few lines.
  private function newBackgroundLayer(bitmapName as string, factor as float) as BGE.DrawableParallaxLayer
    bmp = m.game.getBitmap(bitmapName)
    region = CreateObject("roRegion", bmp, 0, 0, bmp.GetWidth(), bmp.GetHeight())
    layerScale = m.game.canvas.getHeight() / bmp.GetHeight()
    return new BGE.DrawableParallaxLayer(m, region, {
      parallaxFactor: BGE.Math.VectorOps.create(factor, factor),
      repeatX: true,
      repeatY: true,
      scale: BGE.Math.createScaleVector(layerScale)
    })
  end function

end class
