class TitleRoom extends BGE.Room

  showingQr = false
  qrOverlay as QrOverlayWidget

  sub new(game as BGE.Game)
    super(game)
    m.name = "TitleRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.game.gameUi.clearChildren()
    m.showingQr = false

    ' GameStateManager.showEndPanel() pauses the game on game-over/win, and
    ' only its own onCreate() (the Retry path) undoes that - "Quit to Title"
    ' changes rooms instead, so without this the game stays paused forever
    ' and this room's own onInput() (pauseable defaults true) never fires.
    m.game.Resume()

    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    ' title_bg.png is a single 640x360 piece of art sized to exactly match the
    ' canvas, with the "JUNGLE ADVENTURE" logo and player character already
    ' baked in - so it replaces both the old parallax forest backdrop and the
    ' separate text heading Label that used to sit on top of it. Drawn as a
    ' UI widget on gameUi (uiCanvas coordinates, same as the hint/button below)
    ' rather than a world-space GameEntity Image - a Room's own drawables live
    ' in game-canvas/world space (subject to the camera's own position/anchor
    ' conventions), which is the wrong coordinate system for a plain
    ' full-canvas background image and was landing offset. Added first so it
    ' draws behind the hint text/button added afterward this frame.
    titleBg = new TitleBackgroundImage(m.game, BGE.UI.loadBackgroundImage("pkg:/sprites/title_bg.png"))
    titleBg.customPosition = true
    titleBg.customX = 0
    titleBg.customY = 0
    titleBg.width = width
    titleBg.height = height
    m.game.gameUi.addChild(titleBg)

    ' The background art's logo/character occupy roughly its top two-thirds,
    ' with denser jungle-floor foliage below (and a calmer gap in the middle
    ' right below the character's feet) - so the hint text and buttons sit low
    ' in that calmer gap instead of overlapping the art's own logo or character.
    '
    ' Every size/gap below is derived from actual font metrics
    ' (GetOneLineWidth/GetOneLineHeight) rather than fixed canvas percentages
    ' that "happened to work" only because the fonts used to be small - and
    ' the whole stack (hint, Start, Connect Controller) is laid out bottom-up
    ' from a safe bottom anchor so none of the three ever overlap regardless
    ' of exactly how tall Super Bouncer's glyphs render at these sizes. This
    ' keeps everything comfortably within the engine's ~5% vertical / ~10%
    ' horizontal title-safe margins.
    ' showBackground stays on (UiContainer's default) - a semi-opaque dark
    ' panel behind the hint text, not just the text's own color, since this
    ' sits directly over the busy jungle art (the foliage varies from dark to
    ' bright green depending on exactly where the text lands, and warm cream
    ' text alone wasn't reliably legible against the brighter patches).
    hintContainer = new BGE.UI.UiContainer(m.game)
    hintContainer.backgroundRGBA = &h0D1117CC ' near-black, matching the amber theme's dark panels
    hintContainer.theme = new BGE.UI.Theme()
    hintContainer.theme.font = m.game.getFont("hint")
    hintContainer.horizAlign = "center"

    hintLines = [
      "Move: D-pad/Analog Stick"
      "Jump: OK/A",
      "Pause: Back/B",
    ]
    hintFont = m.game.getFont("hint")
    hintWidths as float[] = []
    for each hintLine in hintLines
      hintWidths.push(hintFont.GetOneLineWidth(hintLine, 10000))
    end for
    hintBlockHeight = hintFont.GetOneLineHeight() * hintLines.Count()

    hintBlockWidth = BGE.Math.arrayMax(hintWidths)
    hintPadding = 24

    startLabelText = "Start Game"
    startFont = m.game.getFont("body")
    startTextWidth = startFont.GetOneLineWidth(startLabelText, 10000)
    startTextHeight = startFont.GetOneLineHeight()
    startButtonPaddingX = 64 ' generous horizontal padding around the label
    startButtonPaddingY = 28 ' generous vertical padding so the larger body font isn't cramped

    ' Same font as Start (Button has no per-instance theme override, only
    ' UiContainer does - see resolveTheme()), just noticeably less padding so
    ' it still reads as the secondary action despite its longer label.
    connectLabelText = "Connect Controller"
    connectTextWidth = startFont.GetOneLineWidth(connectLabelText, 10000)
    connectTextHeight = startFont.GetOneLineHeight()
    connectButtonPaddingX = 32
    connectButtonPaddingY = 14

    bottomSafeY = height * 0.92 ' comfortably inside the ~5% bottom title-safe edge
    gapBetweenHintAndButton = 48
    gapBetweenButtons = 16

    connectButton = new BGE.UI.Button(m.game)
    connectButton.setLabel(connectLabelText)
    connectButton.customPosition = true
    connectButton.width = connectTextWidth + connectButtonPaddingX
    connectButton.height = connectTextHeight + connectButtonPaddingY
    connectButton.customX = (width - connectButton.width) / 2
    connectButton.customY = bottomSafeY - connectButton.height

    startButton = new BGE.UI.Button(m.game)
    startButton.setLabel(startLabelText)
    startButton.customPosition = true
    startButton.width = startTextWidth + startButtonPaddingX
    startButton.height = startTextHeight + startButtonPaddingY
    startButton.customX = (width - startButton.width) / 2
    startButton.customY = connectButton.customY - gapBetweenButtons - startButton.height
    startButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeRoom("MainRoom")
    end sub

    ' BrighterScript's anonymous sub() literals don't close over outer local
    ' variables (only `m`, and only implicitly) - so unlike a real closure,
    ' this can't just capture `m`/a local pointing at this Room. Reached via
    ' button.game.currentRoom instead, the same way every other Button
    ' handler in this example reaches the game (button.game) rather than
    ' relying on capture.
    connectButton.onActivate = sub(button as BGE.UI.Button)
      ' Not named titleRoom - BrightScript identifiers are case-insensitive,
      ' so that would still collide with the TitleRoom class/constructor name.
      thisRoom = button.game.currentRoom as TitleRoom
      thisRoom.toggleQrOverlay()
    end sub

    hint = new BGE.UI.Label(m.game)

    hint.setText(hintLines.Join(Chr(10)))
    hint.horizAlign = "center"
    hint.drawableText.textColor = &hF5E6C8FF ' warm cream, readable over the art's dark jungle-floor foliage
    hintContainer.addChild(hint)
    hintContainer.customPosition = true
    hintContainer.width = hintBlockWidth + hintPadding * 2.0
    hintContainer.height = hintBlockHeight + hintPadding * 2.0
    hintContainer.customX = (width - hintContainer.width) / 2.0
    hintContainer.customY = startButton.customY - gapBetweenHintAndButton - hintContainer.height
    hintContainer.padding = new BGE.UI.OffsetSize(hintPadding)

    m.game.gameUi.addChild(hintContainer)
    m.game.gameUi.addChild(startButton)
    m.game.gameUi.addChild(connectButton)

    m.qrOverlay = new QrOverlayWidget(m.game)
    m.qrOverlay.width = width
    m.qrOverlay.height = height

    ' Focuses the Start button immediately, rather than leaving it unfocused
    ' until the player's first press - see FocusManager.ensureFocusSeeded().
    m.game.focusManager.ensureFocusSeeded()
  end sub

  ' Shows/hides the QR connect overlay - added to gameUi as its own top
  ' (last-drawn) child only while visible, rather than always present and
  ' toggling a hidden flag, so it isn't sitting in the focus registry
  ' (see BGE.UI.MessagePanel's own show()/hide() doc comment for the same
  ' registration hazard) or eating draw calls while closed.
  '
  ' @return {void}
  sub toggleQrOverlay()
    m.showingQr = not m.showingQr
    if m.showingQr
      m.game.gameUi.addChild(m.qrOverlay)
    else
      m.game.gameUi.removeChild(m.qrOverlay)
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      if m.showingQr
        m.toggleQrOverlay()
      else
        m.game.End()
      end if
    end if
  end sub

end class

' A plain full-canvas background image widget for gameUi - draws a
' BGE.UI.ImageBackground (see BGE.UI.loadBackgroundImage()) stretched to its
' own bounds. No widget in BGE.UI does this on its own today: Theme.backgroundImage
' is only ever consulted by interactive widgets (Button, Checkbox, Slider,
' Select, TextInput) via their shared UiWidget.drawThemedBackground() helper,
' and UiContainer's own draw() always fills with a flat color, never an image.
class TitleBackgroundImage extends BGE.UI.UiWidget

  private background as BGE.UI.ImageBackground

  sub new(game as BGE.Game, background as BGE.UI.ImageBackground)
    super(game)
    m.background = background
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    if m.background <> invalid
      m.background.draw(m.canvas.renderer, m.position.x, m.position.y, m.width, m.height)
    end if
  end sub

end class

' Full-canvas translucent backdrop + the controller-connection URL as a QR
' code (see docs/qr-codes.md) + that same URL as plain text, for players who'd
' rather type it in. Added as gameUi's LAST child while visible (see
' TitleRoom.toggleQrOverlay()) so draw order puts it on top of the title
' art/buttons already added earlier that same frame - draw order follows
' insertion order, there's no settable zIndex.
'
' A plain UiWidget rather than a Room.onDrawEnd() draw (the pattern
' examples/controller's MainRoom uses) deliberately: onDrawEnd runs as part
' of Game.drawEntities(), which happens *before* Game.drawUI() draws gameUi's
' whole widget tree - so anything drawn there would end up UNDER the Start/
' Connect Controller buttons instead of covering them.
class QrOverlayWidget extends BGE.UI.UiWidget

  ' Encoded once in the constructor, not re-encoded every draw() call - the
  ' connection URL never changes for the app's lifetime, and encoding
  ' (segment building, version-fit search, Reed-Solomon ECC, mask-penalty
  ' scoring) is the expensive part; only the much cheaper per-module blit
  ' (qrDrawModules(), called from draw() below) repeats.
  private qr as BGE.QrCode.QrCode
  private connectionInfo as string
  private qrWidth as float = 300.0

  sub new(game as BGE.Game)
    super(game)
    m.connectionInfo = game.getControllerConnectionInfo()
    m.qr = BGE.QrCode.qrEncodeText(m.connectionInfo, BGE.QrCode.EccLevel.medium)
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    renderer = m.canvas.renderer
    renderer.drawRectangle(0, 0, m.width, m.height, &h000000CC) ' translucent black backdrop

    qrX = (m.width - m.qrWidth) / 2.0
    qrY = m.height * 0.16
    renderer.incrementDrawCalls(BGE.QrCode.qrDrawModules(renderer.getDraw2d(), m.qr, qrX, qrY, m.qrWidth))

    font = m.game.getFont("body")
    textY = qrY + m.qrWidth + 48
    renderer.drawText("Scan to connect a controller", m.width / 2.0, textY, BGE.Colors.White, font, "center")
    renderer.drawText(m.connectionInfo, m.width / 2.0, textY + font.GetOneLineHeight() + 8, BGE.Colors.White, font, "center")
    renderer.drawText("Press Back to close", m.width / 2.0, m.height * 0.88, BGE.Colors.Gray, font, "center")
  end sub

end class
