' A ring of the course: a flat, double-sided band standing upright, facing along `normal`.
' Only the next ring (gold) and the one after it (white) are drawn.
class CourseRing extends BGE.GameEntity

  radius as float = 45
  ' horizontal unit vector the ring faces along
  normal = BGE.Math.VectorOps.create(0, 0, 1)
  index as integer = 0

  private nextRing as BGE.DrawableModel
  private laterRing as BGE.DrawableModel

  sub new(game as BGE.Game)
    super(game)
    m.name = "CourseRing"
  end sub

  ' args: x, y, z, normalX, normalZ, index, radius
  override sub onCreate(args as roAssociativeArray)
    m.position = BGE.Math.VectorOps.create(args.x, args.y, args.z)
    m.index = args.index
    if invalid <> args.radius
      m.radius = args.radius
    end if
    m.normal = BGE.Math.VectorOps.create(args.normalX, 0, args.normalZ)
    BGE.Math.VectorOps.normalize(m.normal)
    ' the model faces +z: turn that to the normal
    m.rotation = BGE.Math.VectorOps.create(0, BGE.Math.Atan2(-m.normal.x, m.normal.z), 0)
    m.scale = BGE.Math.VectorOps.create(m.radius, m.radius, m.radius)
    m.nextRing = m.makeDrawable(&hF2B630FF)
    m.addDrawable("next", m.nextRing)
    m.laterRing = m.makeDrawable(&hF4F4F0FF)
    m.addDrawable("later", m.laterRing)
    m.setState("hidden")
  end sub

  ' "next", "later" or "hidden"
  sub setState(state as string)
    m.nextRing.enabled = state = "next"
    m.laterRing.enabled = state = "later"
  end sub

  ' Whether the segment from one point to another passes through the ring
  function isCrossedBy(fromPoint as BGE.Math.Vector, toPoint as BGE.Math.Vector) as boolean
    n = m.normal
    c = m.position
    d0 = (fromPoint.x - c.x) * n.x + (fromPoint.z - c.z) * n.z
    d1 = (toPoint.x - c.x) * n.x + (toPoint.z - c.z) * n.z
    if (d0 > 0 and d1 > 0) or (d0 < 0 and d1 < 0) or d0 = d1
      return false
    end if
    t = d0 / (d0 - d1)
    hitX = fromPoint.x + (toPoint.x - fromPoint.x) * t - c.x
    hitY = fromPoint.y + (toPoint.y - fromPoint.y) * t - c.y
    hitZ = fromPoint.z + (toPoint.z - fromPoint.z) * t - c.z
    return hitX * hitX + hitY * hitY + hitZ * hitZ < m.radius * m.radius
  end function

  private function makeDrawable(color as integer) as BGE.DrawableModel
    ' unshaded, so it stays bright from any side; an impostor, as rings don't move (~9 ms a
    ' frame less with two near rings on a Roku Ultra)
    return new BGE.DrawableModel(m, makeRingModel(color), {drawMode: BGE.SceneObjectDrawMode.solidDrawBackFace, useImpostor: true, isShaded: false})
  end function

end class

' A flat ring of radius 1 in the x-y plane (facing z), its band `width` wide
function makeRingModel(color as integer, segments = 14 as integer, width = 0.16 as float) as BGE.Model3d
  faces = [] as BGE.Model3dFace[]
  inner = 1 - width
  normal = BGE.Math.VectorOps.create(0, 0, 1)
  for i = 0 to segments - 1
    a0 = i * 2 * BGE.Math.PI / segments
    a1 = (i + 1) * 2 * BGE.Math.PI / segments
    outer0 = BGE.Math.VectorOps.create(cos(a0), sin(a0), 0)
    outer1 = BGE.Math.VectorOps.create(cos(a1), sin(a1), 0)
    inner0 = BGE.Math.VectorOps.create(cos(a0) * inner, sin(a0) * inner, 0)
    inner1 = BGE.Math.VectorOps.create(cos(a1) * inner, sin(a1) * inner, 0)
    for each triangle in [[outer0, outer1, inner1], [outer0, inner1, inner0]]
      face = BGE.Model3dFaceOps.create(triangle, normal)
      face.color = color
      faces.push(face)
    end for
  end for
  model = new BGE.Model3d(faces)
  model.name = "ring"
  return model
end function
