' Biplane flight over voxel terrain (#655): fly round an island through a course of rings.
'
' Controls (remote, Bluetooth gamepad, or the phone controller page):
'   left stick / d-pad      bank and pitch (letting go levels out)
'   RT, R1, OK, FF          throttle up (hold)
'   LT, L1, RW              throttle down (hold)
'   right stick up/down     throttle
'   X, *                    invert pitch
'   Y, Instant Replay       restart the course
'   Back (remote)           quit
'
' Deep links: `quality=<0-4>` pins the render quality level (basic to ultra), `debug=1` shows the
' FPS and input panels, `profile=1` logs a `FLIGHT` line of render stage times every 60 frames.
sub Main(args as dynamic)
  ' the HUD is laid out at 1280x720 too, scaled to the screen
  game = new BGE.Game(1280, 720, 1280, 720)
  game.fitCanvasToScreen()
  game.setCamera(new BGE.Camera3d())

  ' one player: the remote, a gamepad and a phone all fly the same plane
  game.enableControllerInput()
  game.setCombineRemoteInputs(true)
  game.controls.bindAxis("fly", "1", 0, "Fly")
  game.controls.bindAxis("throttle", "2", 0, "Throttle")
  game.controls.bindAction("throttleUp", ["OK", "fastforward", "r1", "r2"], ["ok", "r1"], 0, "Faster")
  game.controls.bindAction("throttleDown", ["rewind", "l1", "l2"], ["b", "l1"], 0, "Slower")
  game.controls.bindAction("invert", ["options", "x"], "x", 0, "Invert")
  game.controls.bindAction("restart", ["replay", "y"], "y", 0, "Restart")

  game.load3dModel("biplane", "pkg:/models/biplane.obj")
  game.load3dModel("propeller", "pkg:/models/propeller.obj")
  game.loadBitmap("sky", "pkg:/sprites/sky.png")
  game.loadSound("score", "pkg:/sounds/score.wav")
  game.loadSound("die", "pkg:/sounds/die.wav")

  params = new BGE.LaunchParams(args)
  if not game.applyLaunchQuality(params)
    game.enableAdaptiveQuality()
  end if

  ' `*` is the pitch toggle, so the debug panels (FPS, input) are a deep link: `debug=1`
  if params.getBool("debug", false)
    game.enableStandardDebugUi({memory: false, garbageCollector: false, log: false})
    game.debugShowUi(true)
  end if

  scene = new FlightScene(game)
  scene.profile = params.getBool("profile", false)
  scene.drawDistance = params.getFloat("draw", scene.drawDistance)
  game.defineScene(scene)
  game.changeScene(scene.name)

  game.play()
end sub
