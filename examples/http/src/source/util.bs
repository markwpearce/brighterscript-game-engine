
' Decodes a base64-encoded string (the Open Trivia Database's `encode=base64` option encodes
' every text field this way, sidestepping the HTML-entity-escaping its default encoding uses)
function decodeBase64(encoded as string) as string
  bytes = CreateObject("roByteArray")
  bytes.FromBase64String(encoded)
  return bytes.ToAsciiString()
end function
