namespace tests
  @suite("FightRules")
  class FightRulesTests extends rooibos.BaseTestSuite

    @describe("movePhaseAt")

    @it("steps through startup, active, recovery, done")
    @params(0, "startup")
    @params(3, "startup")
    @params(4, "active")
    @params(6, "active")
    @params(7, "recovery")
    @params(13, "recovery")
    @params(14, "done")
    function _(frame, expected)
      move = findMove(Stance.stand, AttackButton.lightPunch)
      m.assertEqual(expected, movePhaseAt(move, frame))
    end function

    @it("keeps air moves in recovery until landing")
    function _()
      move = findMove(Stance.air, AttackButton.heavyKick)
      m.assertEqual(MovePhase.recovery, movePhaseAt(move, 200))
    end function

    @describe("move table")

    @it("has a move for every stance and button")
    function _()
      for each stanceName in [Stance.stand, Stance.crouch, Stance.air]
        for each button in [AttackButton.lightPunch, AttackButton.heavyPunch, AttackButton.lightKick, AttackButton.heavyKick]
          move = findMove(stanceName, button)
          m.assertNotInvalid(move, stanceName + " " + button)
          m.assertTrue(move.active >= 3, "active window too short to survive a 30fps frame: " + move.id)
        end for
      end for
    end function

    @describe("canBlockHeight")

    @it("needs the right guard for the attack's height")
    @params("mid", false, true)
    @params("mid", true, true)
    @params("low", false, false)
    @params("low", true, true)
    @params("overhead", false, true)
    @params("overhead", true, false)
    function _(height, crouching, expected)
      m.assertEqual(expected, canBlockHeight(height, crouching))
    end function

    @describe("isHoldingBack")

    @it("is holding away from the facing direction")
    @params(-1.0, 1, true)
    @params(1.0, 1, false)
    @params(1.0, -1, true)
    @params(-0.2, 1, false)
    function _(moveX, facing, expected)
      m.assertEqual(expected, isHoldingBack(moveX, facing))
    end function

    @describe("facingToward")

    @it("faces the opponent, keeping the current facing when level")
    @params(100.0, 200.0, -1, 1)
    @params(200.0, 100.0, 1, -1)
    @params(100.0, 100.5, -1, -1)
    function _(x, otherX, current, expected)
      m.assertEqual(expected, facingToward(x, otherX, current))
    end function

    @describe("worldBox")

    @it("mirrors a box when facing left")
    function _()
      area = worldBox(newBox(10, 20, 30, 5), 100, 50, -1)
      m.assertEqual(60.0, area.x)
      m.assertEqual(70.0, area.y)
      m.assertEqual(30.0, area.w)
    end function

    @it("detects overlap but not edge contact")
    function _()
      m.assertTrue(boxesOverlap(newBox(0, 0, 10, 10), newBox(5, 5, 10, 10)))
      m.assertFalse(boxesOverlap(newBox(0, 0, 10, 10), newBox(10, 0, 10, 10)))
    end function

    @describe("pushApartShift")

    @it("splits the overlap evenly")
    function _()
      m.assertEqual(-8.0, pushApartShift(100, 120, 36))
      m.assertEqual(0.0, pushApartShift(100, 140, 36))
    end function

    @describe("clampToStage")

    @it("keeps a fighter inside the stage")
    function _()
      m.assertEqual(18.0, clampToStage(5, 18, 0, 960))
      m.assertEqual(942.0, clampToStage(990, 18, 0, 960))
      m.assertEqual(500.0, clampToStage(500, 18, 0, 960))
    end function

    @describe("healthAfterHit")

    @it("takes full damage on hit, chip on block, and chip never KOs")
    function _()
      m.assertEqual(880, healthAfterHit(1000, 120, 15, false))
      m.assertEqual(985, healthAfterHit(1000, 120, 15, true))
      m.assertEqual(0, healthAfterHit(50, 120, 15, false))
      m.assertEqual(1, healthAfterHit(5, 120, 15, true))
    end function

    @describe("round and match")

    @it("gives the round to the healthier player")
    @params(500, 400, 0)
    @params(100, 400, 1)
    @params(300, 300, -1)
    function _(h0, h1, expected)
      m.assertEqual(expected, roundWinnerByHealth(h0, h1))
    end function

    @it("ends the match at two wins, but not when both reach it")
    function _()
      m.assertEqual(-1, matchWinner([1, 1]))
      m.assertEqual(0, matchWinner([2, 1]))
      m.assertEqual(1, matchWinner([0, 2]))
      m.assertEqual(-1, matchWinner([2, 2]))
    end function

    @describe("FightClock")

    @it("turns frame time into whole ticks, carrying the remainder")
    function _()
      clock = new FightClock()
      m.assertEqual(2, clock.advance(2.5 / 60.0))
      m.assertEqual(1, clock.advance(0.5 / 60.0))
    end function

    @it("caps a long frame")
    function _()
      clock = new FightClock()
      m.assertEqual(FIGHT_MAX_TICKS_PER_FRAME, clock.advance(1.0))
    end function

    @describe("HealthTrail")

    @it("holds after damage, then drains to health")
    function _()
      trail = new HealthTrail()
      trail.onDamage()
      for i = 1 to TRAIL_DELAY_TICKS
        trail.tick(900)
      end for
      m.assertEqual(MAX_HEALTH, trail.value)
      trail.tick(900)
      m.assertEqual(MAX_HEALTH - TRAIL_DRAIN, trail.value)
      for i = 1 to 100
        trail.tick(900)
      end for
      m.assertEqual(900, trail.value)
    end function

    @describe("FighterInput")

    @it("latches presses and hands out the strongest once")
    function _()
      input = new FighterInput()
      input.latchPress(AttackButton.lightPunch)
      input.latchPress(AttackButton.heavyKick)
      m.assertEqual(AttackButton.heavyKick, input.takePress())
      m.assertEqual("", input.takePress())
    end function

    @describe("fighter animations")

    @it("expands frame ranges")
    function _()
      m.assertEqual([3, 4, 5, 9], expandFrameList(["3-5", 9]))
    end function

    @it("expands stepped frame ranges")
    function _()
      m.assertEqual([20, 23, 26, 1], expandFrameList(["20-26/3", 1]))
    end function

    @it("stretches each attack list over its move phase")
    function _()
      move = findMove(Stance.stand, AttackButton.lightPunch) ' 4 startup, 3 active, 7 recovery
      anim = {startup: [10], active: [20, 21], recovery: [30, 31]} as FighterAnimation
      m.assertEqual(10, attackAnimationFrame(anim, move, 3))
      m.assertEqual(20, attackAnimationFrame(anim, move, 4))
      m.assertEqual(21, attackAnimationFrame(anim, move, 6))
      m.assertEqual(30, attackAnimationFrame(anim, move, 7))
      m.assertEqual(31, attackAnimationFrame(anim, move, 20))
    end function

    @it("loops or holds the last frame")
    function _()
      anim = {frames: [1, 2, 3], ticksPerFrame: 2, loop: true} as FighterAnimation
      m.assertEqual(1, plainAnimationFrame(anim, 6))
      anim.loop = false
      m.assertEqual(3, plainAnimationFrame(anim, 60))
    end function

    @describe("motion inputs")

    @it("reads the stick as numpad directions relative to facing")
    @params(1.0, 0.0, 1, 6)
    @params(1.0, 0.0, -1, 4)
    @params(0.0, -1.0, 1, 2)
    @params(1.0, -1.0, 1, 3)
    @params(-1.0, 1.0, 1, 7)
    @params(0.0, 0.0, -1, 5)
    function _(x, y, facing, expected)
      m.assertEqual(expected, numpadDirection(x, y, facing))
    end function

    @it("finds a quarter circle forward, with or without the diagonal")
    @params([5, 2, 3, 6])
    @params([2, 2, 6])
    @params([5, 2, 5, 6, 6])
    function _(directions)
      m.assertEqual("qcf", specialForPress(m.historyOf(directions), AttackButton.lightPunch))
    end function

    @it("finds a dragon punch, and prefers it to the quarter circle inside it")
    @params([6, 5, 2, 3])
    @params([6, 2, 6])
    function _(directions)
      m.assertEqual("dp", specialForPress(m.historyOf(directions), AttackButton.heavyPunch))
    end function

    @it("walking forward a while then a quarter circle is still a fireball")
    function _()
      history = m.historyOf([6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 5, 5, 5, 2, 2, 2, 3, 6])
      m.assertEqual("qcf", specialForPress(history, AttackButton.lightPunch))
    end function

    @it("finds a quarter circle back for kicks only")
    function _()
      history = m.historyOf([2, 1, 4])
      m.assertEqual("qcb", specialForPress(history, AttackButton.heavyKick))
      m.assertEqual("", specialForPress(history, AttackButton.heavyPunch))
    end function

    @it("ignores motions that are too old or out of order")
    function _()
      old = [2, 3, 6]
      for i = 1 to MOTION_WINDOW_TICKS
        old.push(5)
      end for
      m.assertEqual("", specialForPress(m.historyOf(old), AttackButton.lightPunch))
      m.assertEqual("", specialForPress(m.historyOf([6, 3, 2]), AttackButton.lightPunch))
    end function

    @describe("roster")

    @it("parses picks from launch params")
    function _()
      pick = parsePick("frost:1", newPick("blaze", 0))
      m.assertEqual("frost", pick.character)
      m.assertEqual(1, pick.palette)
      m.assertEqual(1, parsePick("frost:3", newPick("blaze", 0)).palette) ' wraps to its palette count
      m.assertEqual("blaze", parsePick("", newPick("blaze", 1)).character)
      m.assertEqual("blaze", parsePick("nobody", newPick("frost", 0)).character)
    end function

    @it("gives P2 another colour in a mirror match")
    function _()
      m.assertEqual(1, resolvePaletteClash(newPick("blaze", 0), newPick("blaze", 0)))
      m.assertEqual(0, resolvePaletteClash(newPick("blaze", 1), newPick("blaze", 1)))
      m.assertEqual(0, resolvePaletteClash(newPick("nova", 1), newPick("nova", 1)))
      m.assertEqual(0, resolvePaletteClash(newPick("blaze", 0), newPick("frost", 0)))
    end function

    @describe("special moves")

    @it("every character has frame data and animations for its specials and every move")
    function _()
      sets = {blaze: "mustermann", frost: "mustermann", bruno: "bruno", nova: "nova"}
      specials = getSpecialMoves()
      table = getMoveTable()
      for each character in getRoster()
        animations = ParseJson(ReadAsciiFile("pkg:/sprites/fighters/animations-" + sets[character.id] + ".json"))
        m.assertNotInvalid(animations, character.id)
        for each motion in ["qcf", "dp", "qcb"]
          id = character.specials[motion]
          m.assertNotInvalid(specials[id], character.id + " " + id)
          m.assertNotInvalid(animations[id], character.id + " " + id)
        end for
        for each key in table
          m.assertNotInvalid(animations[table[key].id], character.id + " " + key)
        end for
        for each name in ["idle", "walk", "walkBack", "jump", "crouch", "block", "hitstun", "knockdown", "getup", "thrown", "ko", "win", "throw", "intro"]
          m.assertNotInvalid(animations[name], character.id + " " + name)
        end for
      end for
    end function

    function historyOf(directions as object) as InputHistory
      history = new InputHistory()
      for each d in directions
        history.record(d)
      end for
      return history
    end function

  end class
end namespace
