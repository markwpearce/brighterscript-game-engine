namespace tests
  @suite("FightRules")
  class FightRulesTests extends rooibos.BaseTestSuite

    @describe("movePhaseAt")

    @it("steps through startup, active, recovery, done")
    @params(0, "startup")
    @params(3, "startup")
    @params(4, "active")
    @params(6, "active")
    @params(7, "recovery")
    @params(13, "recovery")
    @params(14, "done")
    function _(frame, expected)
      move = findMove(Stance.stand, AttackButton.lightPunch)
      m.assertEqual(expected, movePhaseAt(move, frame))
    end function

    @it("keeps air moves in recovery until landing")
    function _()
      move = findMove(Stance.air, AttackButton.heavyKick)
      m.assertEqual(MovePhase.recovery, movePhaseAt(move, 200))
    end function

    @describe("move table")

    @it("has a move for every stance and button")
    function _()
      for each stanceName in [Stance.stand, Stance.crouch, Stance.air]
        for each button in [AttackButton.lightPunch, AttackButton.heavyPunch, AttackButton.lightKick, AttackButton.heavyKick]
          move = findMove(stanceName, button)
          m.assertNotInvalid(move, stanceName + " " + button)
          m.assertTrue(move.active >= 3, "active window too short to survive a 30fps frame: " + move.id)
        end for
      end for
    end function

    @describe("canBlockHeight")

    @it("needs the right guard for the attack's height")
    @params("mid", false, true)
    @params("mid", true, true)
    @params("low", false, false)
    @params("low", true, true)
    @params("overhead", false, true)
    @params("overhead", true, false)
    function _(height, crouching, expected)
      m.assertEqual(expected, canBlockHeight(height, crouching))
    end function

    @describe("isHoldingBack")

    @it("is holding away from the facing direction")
    @params(-1.0, 1, true)
    @params(1.0, 1, false)
    @params(1.0, -1, true)
    @params(-0.2, 1, false)
    function _(moveX, facing, expected)
      m.assertEqual(expected, isHoldingBack(moveX, facing))
    end function

    @describe("facingToward")

    @it("faces the opponent, keeping the current facing when level")
    @params(100.0, 200.0, -1, 1)
    @params(200.0, 100.0, 1, -1)
    @params(100.0, 100.5, -1, -1)
    function _(x, otherX, current, expected)
      m.assertEqual(expected, facingToward(x, otherX, current))
    end function

    @describe("worldBox")

    @it("mirrors a box when facing left")
    function _()
      area = worldBox(newBox(10, 20, 30, 5), 100, 50, -1)
      m.assertEqual(60.0, area.x)
      m.assertEqual(70.0, area.y)
      m.assertEqual(30.0, area.w)
    end function

    @it("detects overlap but not edge contact")
    function _()
      m.assertTrue(boxesOverlap(newBox(0, 0, 10, 10), newBox(5, 5, 10, 10)))
      m.assertFalse(boxesOverlap(newBox(0, 0, 10, 10), newBox(10, 0, 10, 10)))
    end function

    @describe("pushApartShift")

    @it("splits the overlap evenly")
    function _()
      m.assertEqual(-8.0, pushApartShift(100, 120, 36))
      m.assertEqual(0.0, pushApartShift(100, 140, 36))
    end function

    @describe("clampToStage")

    @it("keeps a fighter inside the stage")
    function _()
      m.assertEqual(18.0, clampToStage(5, 18, 0, 960))
      m.assertEqual(942.0, clampToStage(990, 18, 0, 960))
      m.assertEqual(500.0, clampToStage(500, 18, 0, 960))
    end function

    @describe("healthAfterHit")

    @it("takes full damage on hit, chip on block, and chip never KOs")
    function _()
      move = findMove(Stance.stand, AttackButton.heavyKick)
      m.assertEqual(880, healthAfterHit(1000, move, false))
      m.assertEqual(985, healthAfterHit(1000, move, true))
      m.assertEqual(0, healthAfterHit(50, move, false))
      m.assertEqual(1, healthAfterHit(5, move, true))
    end function

    @describe("round and match")

    @it("gives the round to the healthier player")
    @params(500, 400, 0)
    @params(100, 400, 1)
    @params(300, 300, -1)
    function _(h0, h1, expected)
      m.assertEqual(expected, roundWinnerByHealth(h0, h1))
    end function

    @it("ends the match at two wins, but not when both reach it")
    function _()
      m.assertEqual(-1, matchWinner([1, 1]))
      m.assertEqual(0, matchWinner([2, 1]))
      m.assertEqual(1, matchWinner([0, 2]))
      m.assertEqual(-1, matchWinner([2, 2]))
    end function

    @describe("FightClock")

    @it("turns frame time into whole ticks, carrying the remainder")
    function _()
      clock = new FightClock()
      m.assertEqual(2, clock.advance(2.5 / 60.0))
      m.assertEqual(1, clock.advance(0.5 / 60.0))
    end function

    @it("caps a long frame")
    function _()
      clock = new FightClock()
      m.assertEqual(FIGHT_MAX_TICKS_PER_FRAME, clock.advance(1.0))
    end function

    @describe("HealthTrail")

    @it("holds after damage, then drains to health")
    function _()
      trail = new HealthTrail()
      trail.onDamage()
      for i = 1 to TRAIL_DELAY_TICKS
        trail.tick(900)
      end for
      m.assertEqual(MAX_HEALTH, trail.value)
      trail.tick(900)
      m.assertEqual(MAX_HEALTH - TRAIL_DRAIN, trail.value)
      for i = 1 to 100
        trail.tick(900)
      end for
      m.assertEqual(900, trail.value)
    end function

    @describe("FighterInput")

    @it("latches presses and hands out the strongest once")
    function _()
      input = new FighterInput()
      input.latchPress(AttackButton.lightPunch)
      input.latchPress(AttackButton.heavyKick)
      m.assertEqual(AttackButton.heavyKick, input.takePress())
      m.assertEqual("", input.takePress())
    end function

    @describe("fighter animations")

    @it("expands frame ranges")
    function _()
      m.assertEqual([3, 4, 5, 9], expandFrameList(["3-5", 9]))
    end function

    @it("stretches each attack list over its move phase")
    function _()
      move = findMove(Stance.stand, AttackButton.lightPunch) ' 4 startup, 3 active, 7 recovery
      anim = {startup: [10], active: [20, 21], recovery: [30, 31]} as FighterAnimation
      m.assertEqual(10, attackAnimationFrame(anim, move, 3))
      m.assertEqual(20, attackAnimationFrame(anim, move, 4))
      m.assertEqual(21, attackAnimationFrame(anim, move, 6))
      m.assertEqual(30, attackAnimationFrame(anim, move, 7))
      m.assertEqual(31, attackAnimationFrame(anim, move, 20))
    end function

    @it("loops or holds the last frame")
    function _()
      anim = {frames: [1, 2, 3], ticksPerFrame: 2, loop: true} as FighterAnimation
      m.assertEqual(1, plainAnimationFrame(anim, 6))
      anim.loop = false
      m.assertEqual(3, plainAnimationFrame(anim, 60))
    end function

  end class
end namespace
