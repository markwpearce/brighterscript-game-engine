import "../Fight/MoveData.bs"
import "../Fight/FrameLogic.bs"
import "../UI/UiArt.bs"

const PROJECTILE_SPEED_LIGHT = 3.2
const PROJECTILE_SPEED_HEAVY = 4.6
const PROJECTILE_HALF_WIDTH = 12.0
const PROJECTILE_HEIGHT = 20.0

' A fireball. FightScene moves it each tick and checks it against the other fighter and the
' other fighter's projectile; this entity just holds its state and draws it.
class Projectile extends BGE.GameEntity

  ownerIndex as integer
  direction as integer
  speed as float
  ' Cleared when it hits something or leaves the stage; FightScene then destroys it.
  alive as boolean = true
  private frames as roRegion[]
  private sprite as BGE.AnimatedImage
  private ticks as integer = 0

  sub new(game as BGE.Game, ownerIndex as integer, direction as integer, heavy as boolean, frames as roRegion[])
    super(game)
    m.name = "Projectile" + ownerIndex.toStr()
    m.ownerIndex = ownerIndex
    m.direction = direction
    m.frames = frames
    m.speed = PROJECTILE_SPEED_LIGHT
    if heavy
      m.speed = PROJECTILE_SPEED_HEAVY
    end if
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.sprite = m.addAnimatedImage("orb", m.frames, {animationDurationMs: 0})
    ' The art faces right with the orb near its right edge.
    m.sprite.setAnchor(0.7, 0.5)
    m.sprite.scale.x = m.direction
  end sub

  sub tick()
    m.ticks++
    m.position.x += m.direction * m.speed
    m.sprite.index = Int(m.ticks / 4) mod m.frames.count()
    m.sprite.update()
  end sub

  ' Its hitbox in world space: centred on its position, which is the orb's centre.
  function getHitbox() as FightBox
    return newBox(m.position.x - PROJECTILE_HALF_WIDTH, m.position.y - PROJECTILE_HEIGHT / 2, PROJECTILE_HALF_WIDTH * 2, PROJECTILE_HEIGHT)
  end function

end class
