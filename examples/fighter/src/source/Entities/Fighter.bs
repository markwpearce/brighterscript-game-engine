import "../Fight/MoveData.bs"
import "../Fight/FrameLogic.bs"
import "../Fight/MatchRules.bs"
import "../Fight/MotionInput.bs"
import "../Fight/Roster.bs"
import "../Fight/FighterAnimations.bs"
import "../UI/UiArt.bs"
import "pkg:/source/utils/Impulse.bs"

const GROUND_Y = 40.0
const FIGHTER_HALF_WIDTH = 18.0
const PUSH_WIDTH = 36.0
const STAND_HEIGHT = 92.0
const CROUCH_HEIGHT = 60.0
const WALK_FORWARD_SPEED = 2.4
const WALK_BACK_SPEED = 1.9
const JUMP_SPEED = 10.0
const JUMP_FORWARD_SPEED = 2.8
const GRAVITY = 0.55
const PRE_JUMP_TICKS = 3
const LANDING_TICKS = 4
' Landing after a special that ends in the air (the uppercut) is slower: it's punishable.
const SPECIAL_LANDING_TICKS = 14
' How far out and how high a thrown fighter is carried over the thrower's shoulder.
const THROW_CARRY_RADIUS = 30.0
const THROW_CARRY_HEIGHT = 70.0
' Lying on the floor after a knockdown, then getting up. Both can't be hit.
const DOWN_TICKS = 40
const GETUP_TICKS = 28
' An airborne fighter can be hit this many times before they can't be until they land.
const JUGGLE_LIMIT = 2
' A press during recovery is remembered this long, so it comes out the first free tick.
const PRESS_BUFFER_TICKS = 6
' Knockback loses this fraction of its speed each tick, and stops below KNOCKBACK_STOP_SPEED px/tick.
const KNOCKBACK_DECAY_PER_TICK = 0.2
const KNOCKBACK_STOP_SPEED = 0.1

enum FighterState
  intro = "intro"
  idle = "idle"
  walk = "walk"
  crouch = "crouch"
  preJump = "preJump"
  air = "air"
  landing = "landing"
  attack = "attack"
  hitstun = "hitstun"
  blockstun = "blockstun"
  airHit = "airHit"
  down = "down"
  getup = "getup"
  throw = "throw"
  thrown = "thrown"
  ko = "ko"
  win = "win"
end enum

' One player's fighter. FightScene drives it with tick() at a fixed 60 Hz and resolves
' hits; this class owns movement, the move state machine, and its colliders/visuals.
' Drawn from a per-character, per-palette sprite atlas (see scripts/build-sprites.js); the
' sheets face right, so facing left mirrors with a negative scale.x.
class Fighter extends BGE.GameEntity

  playerIndex as integer
  character as CharacterDef
  facing as integer = 1
  health as integer = MAX_HEALTH
  state as string = FighterState.idle
  stateTicks as integer = 0
  currentMove as dynamic = invalid ' MoveDef while attacking
  moveHasHit as boolean = false
  ' Set by onCollision, consumed by FightScene.resolveHits().
  pendingHitOn as dynamic = invalid
  ' Set on a fireball's first active tick; FightScene spawns it and clears this.
  wantsProjectile as boolean = false
  ' FightScene clears this while this fighter's projectile is on screen (one at a time).
  canFireProjectile as boolean = true
  ' Whether the move that's out was done with a heavy button (fireball speed, uppercut height).
  heavyVersion as boolean = false
  guarding as boolean = false
  crouching as boolean = false
  ' Ticks left in hitstun/blockstun/landing/down/getup.
  timer as integer = 0
  vx as float = 0.0
  vy as float = 0.0
  ' Hits taken since leaving the ground (see JUGGLE_LIMIT).
  airHitCount as integer = 0
  ' Horizontal push in px/tick (x only); start it with pushBack().
  knockback as BGE.Impulse = new BGE.Impulse()
  history as InputHistory = new InputHistory()
  private heavyHitReaction as boolean = false
  private jumpDirection as integer = 0
  private bufferedPress as string = ""
  private bufferTicks as integer = 0
  ' The fighter being thrown, while throwing.
  private throwVictim as dynamic = invalid
  ' True if the attack was active on any tick this frame, so a short active window
  ' isn't missed by the once-per-frame collision pass.
  private wasActiveThisFrame as boolean = false

  private atlasKey as string
  private animations as roAssociativeArray
  private layout as FighterAtlasLayout
  private art as UiArt
  private sprite as BGE.AnimatedImage
  private shadow as BGE.Image
  private landingTicks as integer = LANDING_TICKS
  private shownFrame as integer = -1
  private hurtCollider as BGE.RectangleCollider
  private attackCollider as BGE.RectangleCollider

  sub new(game as BGE.Game, playerIndex as integer, pick as FighterPick, animations as roAssociativeArray, layout as FighterAtlasLayout, art as UiArt)
    super(game)
    m.name = "Fighter" + playerIndex.toStr()
    m.playerIndex = playerIndex
    m.character = findCharacter(pick.character)
    m.atlasKey = fighterBitmapName(pick)
    m.animations = animations
    m.layout = layout
    m.art = art
    m.tagsList.add("fighter")
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.shadow = m.addImage("shadow", m.art.region("shadow"))
    m.shadow.setAnchor(0.5, 0.5)
    regions = buildFighterRegions(m.game.getBitmap(m.atlasKey), m.layout)
    m.sprite = m.addAnimatedImage("sprite", regions, {animationDurationMs: 0})
    m.showFrame(0)
    m.hurtCollider = m.addRectangleCollider("hurt", FIGHTER_HALF_WIDTH * 2, STAND_HEIGHT, -FIGHTER_HALF_WIDTH, STAND_HEIGHT)
    m.attackCollider = m.addRectangleCollider("attack", 1, 1, 0, 0, false)
  end sub

  ' Puts the fighter back at a round's start, in their intro pose.
  sub resetForRound(x as float, facing as integer)
    m.position.x = x
    m.position.y = GROUND_Y
    m.facing = facing
    m.health = MAX_HEALTH
    m.vx = 0.0
    m.vy = 0.0
    m.airHitCount = 0
    m.knockback.stop()
    m.bufferedPress = ""
    m.bufferTicks = 0
    m.pendingHitOn = invalid
    m.wantsProjectile = false
    m.throwVictim = invalid
    m.history.clear()
    m.crouching = false
    m.guarding = false
    m.setState(FighterState.intro)
    m.syncVisuals()
  end sub

  ' Ends the intro pose so the round can start.
  sub ready()
    if m.state = FighterState.intro
      m.setState(FighterState.idle)
    end if
  end sub

  function isAirborne() as boolean
    return m.position.y > GROUND_Y + 0.01
  end function

  function isKnockedOut() as boolean
    return m.state = FighterState.ko
  end function

  function isAttackActive() as boolean
    if m.state <> FighterState.attack or m.currentMove = invalid
      return false
    end if
    move = m.currentMove as MoveDef
    return not move.projectile and movePhaseAt(move, m.stateTicks) = MovePhase.active
  end function

  ' Can't be hit: on the floor, getting up, throwing or being thrown (so a fireball can't
  ' break a throw and strand the victim), or a special's invincible start.
  function isInvulnerable() as boolean
    s = m.state
    if s = FighterState.down or s = FighterState.getup or s = FighterState.throw or s = FighterState.thrown or s = FighterState.ko
      return true
    end if
    if s = FighterState.airHit and m.airHitCount >= JUGGLE_LIMIT
      return true
    end if
    if s = FighterState.attack and m.currentMove <> invalid
      move = m.currentMove as MoveDef
      return m.stateTicks < move.invulnerable
    end if
    return false
  end function

  ' Whether a throw can grab this fighter right now.
  function isThrowable() as boolean
    s = m.state
    return not m.isAirborne() and (s = FighterState.idle or s = FighterState.walk or s = FighterState.crouch or s = FighterState.landing or (s = FighterState.attack and m.stateTicks > 4))
  end function

  ' Whether the fighter is free to act (not attacking, stunned or airborne).
  function isFree() as boolean
    return m.state = FighterState.idle or m.state = FighterState.walk or m.state = FighterState.crouch
  end function

  ' Called by FightScene before a frame's ticks.
  sub beginFrame()
    m.wasActiveThisFrame = false
  end sub

  ' One 60 Hz step. `opponent` is the other Fighter (typed as object: bsc mis-types a method
  ' param of its own class).
  sub tick(input as FighterInput, opponent as object)
    m.stateTicks++
    m.history.record(numpadDirection(input.moveX, input.moveY, m.facing))
    press = input.takePress()
    if press <> ""
      m.bufferedPress = press
      m.bufferTicks = PRESS_BUFFER_TICKS
    else if m.bufferTicks > 0
      m.bufferTicks--
      if m.bufferTicks = 0
        m.bufferedPress = ""
      end if
    end if

    s = m.state
    if m.isFree()
      m.facing = facingToward(m.position.x, opponent.position.x, m.facing)
      m.tickFree(input, opponent)
    else if s = FighterState.preJump
      m.vx = 0.0
      if m.stateTicks >= PRE_JUMP_TICKS
        m.vy = JUMP_SPEED
        m.vx = m.jumpDirection * JUMP_FORWARD_SPEED * m.character.walkSpeed
        m.setState(FighterState.air)
      end if
    else if s = FighterState.air
      if m.bufferedPress <> ""
        m.startAttack(findMove(Stance.air, m.bufferedPress), Stance.air)
      end if
    else if s = FighterState.attack
      m.tickAttack()
    else if s = FighterState.throw
      m.tickThrow()
    else if s = FighterState.hitstun or s = FighterState.blockstun or s = FighterState.landing
      ' Guarding is re-read through blockstun, so a held guard stays up.
      m.guarding = isHoldingBack(input.moveX, m.facing)
      m.timer--
      if m.timer <= 0
        m.setState(FighterState.idle)
      end if
    else if s = FighterState.down
      m.timer--
      if m.timer <= 0
        m.setState(FighterState.getup)
        m.timer = GETUP_TICKS
      end if
    else if s = FighterState.getup
      m.timer--
      if m.timer <= 0
        m.facing = facingToward(m.position.x, opponent.position.x, m.facing)
        m.setState(FighterState.idle)
      end if
    end if

    if s <> FighterState.thrown
      m.applyPhysics()
    end if
    if m.isAttackActive()
      m.wasActiveThisFrame = true
    end if
  end sub

  private sub tickFree(input as FighterInput, opponent as object)
    m.guarding = isHoldingBack(input.moveX, m.facing)
    wantsCrouch = input.moveY < -0.5
    if m.bufferedPress <> ""
      m.startPressedMove(wantsCrouch, input, opponent)
      return
    end if
    if input.moveY > 0.5
      m.jumpDirection = 0
      if input.moveX > 0.5
        m.jumpDirection = 1
      else if input.moveX < -0.5
        m.jumpDirection = -1
      end if
      m.setState(FighterState.preJump)
      m.game.playSound("jump", 50)
      return
    end if
    m.crouching = wantsCrouch
    if wantsCrouch
      m.vx = 0.0
      m.setStateIfChanged(FighterState.crouch)
      return
    end if
    if Abs(input.moveX) > 0.5
      speed = WALK_BACK_SPEED
      if input.moveX * m.facing > 0
        speed = WALK_FORWARD_SPEED
      end if
      m.vx = Sgn(input.moveX) * speed * m.character.walkSpeed
      m.setStateIfChanged(FighterState.walk)
    else
      m.vx = 0.0
      m.setStateIfChanged(FighterState.idle)
    end if
  end sub

  ' A special if the stick made its motion, else a throw if close, else a normal.
  private sub startPressedMove(wantsCrouch as boolean, input as FighterInput, opponent as object)
    button = m.bufferedPress
    m.heavyVersion = isHeavyButton(button)
    specials = getSpecialMoves()
    specialId = ""
    motion = specialForPress(m.history, button)
    if motion <> ""
      specialId = m.character.specials[motion]
    end if
    if specialId <> ""
      special = specials[specialId] as MoveDef
      if special.projectile and not m.canFireProjectile
        specialId = ""
      end if
    end if
    if specialId <> ""
      m.history.clear()
      m.crouching = false
      m.startAttack(specials[specialId], Stance.stand)
      return
    end if
    nearby = Abs(opponent.position.x - m.position.x) <= THROW_RANGE
    if button = AttackButton.heavyPunch and not wantsCrouch and Abs(input.moveX) > 0.5 and nearby and opponent.isThrowable()
      m.startThrow(opponent, input.moveX)
      return
    end if
    stanceName = Stance.stand
    if wantsCrouch
      stanceName = Stance.crouch
    end if
    m.startAttack(findMove(stanceName, button), stanceName)
  end sub

  private sub startAttack(move as dynamic, stanceName as string)
    m.bufferedPress = ""
    m.bufferTicks = 0
    if move = invalid
      return
    end if
    def = move as MoveDef
    m.currentMove = def
    m.moveHasHit = false
    m.crouching = stanceName = Stance.crouch
    if stanceName <> Stance.air
      m.vx = 0.0
    end if
    m.setState(FighterState.attack)
    if def.projectile
      return ' the fireball sound plays when it's thrown
    end if
    if def.damage >= 80
      m.game.playSound("whiffHeavy", 60)
    else
      m.game.playSound("whiffLight", 50)
    end if
  end sub

  private sub tickAttack()
    move = m.currentMove as MoveDef
    phase = movePhaseAt(move, m.stateTicks)
    if phase = MovePhase.active
      if m.stateTicks = move.startup
        if move.projectile
          m.wantsProjectile = true
        end if
        if move.launchSpeed > 0
          m.vy = move.launchSpeed
          if not m.heavyVersion
            m.vy = move.launchSpeed * 0.8
          end if
        end if
      end if
      if move.advance <> 0
        m.vx = m.facing * move.advance
      end if
    else if phase = MovePhase.recovery and move.advance <> 0 and not m.isAirborne()
      m.vx = 0.0
    end if
    if move.endsOnLanding
      return ' applyPhysics() ends it on landing
    end if
    if phase = MovePhase.done
      if m.crouching
        m.setState(FighterState.crouch)
      else
        m.setState(FighterState.idle)
      end if
    end if
  end sub

  ' Grabs the opponent; tickThrow() carries them over this fighter's shoulder and flings
  ' them down behind, so the two swap sides. Holding back turns round first, so they land
  ' back where they were.
  private sub startThrow(opponent as object, moveX as float)
    m.bufferedPress = ""
    m.bufferTicks = 0
    m.vx = 0.0
    if moveX * m.facing < 0
      m.facing = -m.facing
    end if
    m.throwVictim = opponent
    m.setState(FighterState.throw)
    opponent.beGrabbed()
    m.game.playSound("whiffHeavy", 70)
  end sub

  private sub tickThrow()
    victim = m.throwVictim
    if victim <> invalid
      if m.stateTicks < THROW_RELEASE_TICK
        ' Lifted over the thrower's head, from in front to behind them, and released still in
        ' the air to be slammed down.
        angle = 3.14159 * 0.85 * m.stateTicks / THROW_RELEASE_TICK
        victim.position.x = m.position.x + m.facing * THROW_CARRY_RADIUS * Cos(angle)
        victim.position.y = GROUND_Y + THROW_CARRY_HEIGHT * Sin(angle)
      else if m.stateTicks = THROW_RELEASE_TICK
        move = getSpecialMoves().throwMove as MoveDef
        victim.releaseFromThrow(-m.facing, Int(move.damage * m.character.damageScale))
        m.throwVictim = invalid
      end if
    end if
    if m.stateTicks >= THROW_TICKS
      ' The victim ended up behind: turn to face them.
      m.facing = -m.facing
      m.setState(FighterState.idle)
    end if
  end sub

  ' Called by the thrower.
  sub beGrabbed()
    m.vx = 0.0
    m.vy = 0.0
    m.knockback.stop()
    m.crouching = false
    m.currentMove = invalid
    m.setState(FighterState.thrown)
  end sub

  ' Called by the thrower: takes the damage and flies toward `direction`.
  sub releaseFromThrow(direction as integer, damage as integer)
    m.health = healthAfterHit(m.health, damage, 0, false)
    m.facing = -direction
    m.vy = 2.5
    m.vx = direction * 2.8
    m.airHitCount = JUGGLE_LIMIT
    if m.health <= 0
      m.setState(FighterState.ko)
    else
      m.setState(FighterState.airHit)
    end if
  end sub

  private sub applyPhysics()
    m.position.x += m.vx + m.knockback.step(1).x
    if m.isAirborne() or m.vy > 0
      m.vy -= GRAVITY
      m.position.y += m.vy
      if m.position.y <= GROUND_Y
        m.position.y = GROUND_Y
        m.vy = 0.0
        m.onLanded()
      end if
    end if
  end sub

  private sub onLanded()
    m.vx = 0.0
    m.airHitCount = 0
    if m.state = FighterState.airHit
      m.game.playSound("thump", 70)
      m.setState(FighterState.down)
      m.timer = DOWN_TICKS
    else if m.state = FighterState.ko
      m.game.playSound("thump", 80)
      m.knockback.stop()
    else
      m.game.playSound("land", 40)
      m.landingTicks = LANDING_TICKS
      if m.state = FighterState.attack and m.currentMove <> invalid
        move = m.currentMove as MoveDef
        if move.kind = MoveKind.special
          m.landingTicks = SPECIAL_LANDING_TICKS
        end if
      end if
      m.crouching = false
      m.setState(FighterState.landing)
      m.timer = m.landingTicks
    end if
  end sub

  ' Applies an attack that connected, dealing `damage` (chip damage scales with it).
  ' @return {boolean} true if it was blocked
  function receiveHit(move as MoveDef, attackerFacing as integer, damage as integer) as boolean
    canGuard = (m.isFree() or m.state = FighterState.blockstun) and not m.isAirborne()
    blocked = canGuard and m.guarding and canBlockHeight(move.height, m.crouching)
    chip = Int(damage / 8)
    if move.projectile
      chip = Int(damage / 4)
    end if
    m.health = healthAfterHit(m.health, damage, chip, blocked)
    m.currentMove = invalid
    m.heavyHitReaction = damage >= 80
    if blocked
      m.setState(FighterState.blockstun)
      m.timer = move.blockstun
      m.vx = 0.0
      m.pushBack(attackerFacing * move.knockback * 0.7)
    else if m.health <= 0
      m.setState(FighterState.ko)
      m.vy = 6.0
      m.vx = attackerFacing * 2.5
      m.crouching = false
    else if m.isAirborne() or move.knockdown
      m.airHitCount++
      m.crouching = false
      m.setState(FighterState.airHit)
      m.vy = 4.5
      if move.knockdown and not m.isAirborne()
        m.vy = 5.5
      end if
      m.vx = 0.0
      m.pushBack(attackerFacing * move.knockback)
    else
      m.setState(FighterState.hitstun)
      m.timer = move.hitstun
      m.vx = 0.0
      m.pushBack(attackerFacing * move.knockback)
    end if
    return blocked
  end function

  ' Starts a knockback of `speed` px/tick along x (negative is left), easing out.
  sub pushBack(speed as float)
    m.knockback.start(BGE.Math.VectorOps.create(speed, 0), KNOCKBACK_DECAY_PER_TICK, KNOCKBACK_STOP_SPEED)
  end sub

  sub celebrate()
    if not m.isKnockedOut()
      m.setState(FighterState.win)
      m.vx = 0.0
    end if
  end sub

  ' The attack's world-space hitbox, or invalid when not attacking.
  function getHitbox() as dynamic
    if m.currentMove = invalid or m.state <> FighterState.attack
      return invalid
    end if
    move = m.currentMove as MoveDef
    if move.projectile
      return invalid
    end if
    return worldBox(move.hitbox, m.position.x, m.position.y, m.facing)
  end function

  function getHurtbox() as FightBox
    height = STAND_HEIGHT
    if m.crouching
      height = CROUCH_HEIGHT
    end if
    return newBox(m.position.x - FIGHTER_HALF_WIDTH, m.position.y, FIGHTER_HALF_WIDTH * 2, height)
  end function

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if myCollider.name = "attack" and otherCollider.name = "hurt" and not m.moveHasHit and otherEntity.tagsList.contains("fighter")
      m.pendingHitOn = otherEntity
    end if
  end sub

  ' Moves colliders and the sprite to match the current pose. Called after each frame's ticks.
  sub syncVisuals()
    height = STAND_HEIGHT
    if m.crouching
      height = CROUCH_HEIGHT
    else if (m.state = FighterState.ko or m.state = FighterState.down) and not m.isAirborne()
      height = 20
    end if
    m.hurtCollider.height = height
    m.hurtCollider.offset.y = height
    m.hurtCollider.enabled = not m.isInvulnerable()

    m.showFrame(m.currentAnimationFrame())
    m.sprite.scale.x = m.facing
    if (m.state = FighterState.hitstun or m.state = FighterState.airHit) and m.stateTicks < 6
      m.sprite.color = &hFFB0B0
    else
      m.sprite.color = &hFFFFFF
    end if
    ' The shadow stays on the floor and shrinks as the fighter rises.
    m.shadow.offset.y = GROUND_Y - m.position.y
    shadowScale = 1.0 - BGE.Math.Min(0.6, (m.position.y - GROUND_Y) / 160)
    m.shadow.scale.x = shadowScale
    m.shadow.scale.y = shadowScale

    hitbox = m.getHitbox()
    active = m.wasActiveThisFrame or m.isAttackActive()
    m.attackCollider.enabled = active and not m.moveHasHit
    if hitbox <> invalid
      area = hitbox as FightBox
      m.attackCollider.offset.x = area.x - m.position.x
      m.attackCollider.offset.y = area.y - m.position.y + area.h
      m.attackCollider.width = area.w
      m.attackCollider.height = area.h
    end if
  end sub

  ' Frames are trimmed to different sizes, so each has its own anchor at the feet.
  private sub showFrame(index as integer)
    if index <> m.shownFrame
      m.shownFrame = index
      rect = m.layout.rects[index]
      m.sprite.index = index
      m.sprite.setAnchor(rect[4] / rect[2], rect[5] / rect[3])
    end if
    m.sprite.update()
  end sub

  private function currentAnimationFrame() as integer
    if m.state = FighterState.attack and m.currentMove <> invalid
      move = m.currentMove as MoveDef
      return attackAnimationFrame(m.animations[move.id], move, m.stateTicks)
    end if
    if m.state = FighterState.air
      ' The jump follows the arc, not the clock: rising, tucked at the top, legs out to land.
      jump = m.animations["jump"] as FighterAnimation
      t = (JUMP_SPEED - m.vy) / (2 * JUMP_SPEED)
      index = Int(BGE.Math.Clamp(t, 0, 0.999) * jump.frames.count())
      return jump.frames[index]
    end if
    return plainAnimationFrame(m.animations[m.animationName()], m.stateTicks)
  end function

  private function animationName() as string
    s = m.state
    if s = FighterState.walk and m.vx * m.facing < 0
      return "walkBack"
    end if
    if s = FighterState.idle or s = FighterState.walk or s = FighterState.preJump or s = FighterState.airHit or s = FighterState.ko or s = FighterState.win or s = FighterState.intro or s = FighterState.getup or s = FighterState.throw or s = FighterState.thrown
      return s
    else if s = FighterState.down
      return "knockdown"
    else if s = FighterState.crouch
      if m.guarding
        return "crouchBlock"
      end if
      return "crouch"
    else if s = FighterState.air
      return "jump"
    else if s = FighterState.landing
      return "landing"
    else if s = FighterState.blockstun
      if m.crouching
        return "crouchBlock"
      end if
      return "block"
    else if s = FighterState.hitstun
      if m.crouching
        return "crouchHit"
      else if m.heavyHitReaction
        return "hitstunGut"
      end if
      return "hitstun"
    end if
    return "idle"
  end function

  private sub setState(newState as string)
    m.state = newState
    m.stateTicks = 0
    if newState <> FighterState.attack
      m.currentMove = invalid
    end if
  end sub

  private sub setStateIfChanged(newState as string)
    if m.state <> newState
      m.setState(newState)
    end if
  end sub

end class
