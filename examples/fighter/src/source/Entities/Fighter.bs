import "../Fight/MoveData.bs"
import "../Fight/FrameLogic.bs"
import "../Fight/MatchRules.bs"
import "../Fight/FighterAnimations.bs"

const GROUND_Y = 48.0
const FIGHTER_HALF_WIDTH = 18.0
const PUSH_WIDTH = 36.0
const STAND_HEIGHT = 92.0
const CROUCH_HEIGHT = 60.0
const WALK_FORWARD_SPEED = 2.4
const WALK_BACK_SPEED = 1.9
const JUMP_SPEED = 10.0
const JUMP_FORWARD_SPEED = 2.8
const GRAVITY = 0.55
const PRE_JUMP_TICKS = 3
const LANDING_TICKS = 4
const KNOCKDOWN_TICKS = 30
' A press during recovery is remembered this long, so it comes out the first free tick.
const PRESS_BUFFER_TICKS = 6

enum FighterState
  idle = "idle"
  walk = "walk"
  crouch = "crouch"
  preJump = "preJump"
  air = "air"
  landing = "landing"
  attack = "attack"
  hitstun = "hitstun"
  blockstun = "blockstun"
  airHit = "airHit"
  ko = "ko"
  win = "win"
end enum

' One player's fighter. FightScene drives it with tick() at a fixed 60 Hz and resolves
' hits; this class owns movement, the move state machine, and its colliders/visuals.
' Drawn from a per-player sprite atlas (see scripts/build-sprites.js); the sheets face
' right, so facing left mirrors with a negative scale.x.
class Fighter extends BGE.GameEntity

  playerIndex as integer
  facing as integer = 1
  health as integer = MAX_HEALTH
  state as string = FighterState.idle
  stateTicks as integer = 0
  currentMove as dynamic = invalid ' MoveDef while attacking
  moveHasHit as boolean = false
  ' Set by onCollision, consumed by FightScene.resolveHits().
  pendingHitOn as dynamic = invalid
  guarding as boolean = false
  crouching as boolean = false
  ' Ticks left in hitstun/blockstun/landing/knockdown.
  timer as integer = 0
  vx as float = 0.0
  vy as float = 0.0
  knockbackVx as float = 0.0
  private jumpDirection as integer = 0
  private bufferedPress as string = ""
  private bufferTicks as integer = 0
  ' True if the attack was active on any tick this frame, so a short active window
  ' isn't missed by the once-per-frame collision pass.
  private wasActiveThisFrame as boolean = false

  private atlasKey as string
  private animations as roAssociativeArray
  private layout as FighterAtlasLayout
  private sprite as BGE.AnimatedImage
  private landingAnim as string = "landing"
  private hurtCollider as BGE.RectangleCollider
  private attackCollider as BGE.RectangleCollider

  sub new(game as BGE.Game, playerIndex as integer, atlasKey as string, animations as roAssociativeArray, layout as FighterAtlasLayout)
    super(game)
    m.name = "Fighter" + playerIndex.toStr()
    m.playerIndex = playerIndex
    m.atlasKey = atlasKey
    m.animations = animations
    m.layout = layout
    m.tagsList.add("fighter")
  end sub

  override sub onCreate(args as roAssociativeArray)
    regions = buildFighterRegions(m.game.getBitmap(m.atlasKey), m.layout)
    m.sprite = m.addAnimatedImage("sprite", regions, {animationDurationMs: 0})
    m.sprite.setAnchor(m.layout.feetX / m.layout.cellWidth, m.layout.feetY / m.layout.cellHeight)
    m.hurtCollider = m.addRectangleCollider("hurt", FIGHTER_HALF_WIDTH * 2, STAND_HEIGHT, -FIGHTER_HALF_WIDTH, STAND_HEIGHT)
    m.attackCollider = m.addRectangleCollider("attack", 1, 1, 0, 0, false)
  end sub

  ' Puts the fighter back at a round's start.
  sub resetForRound(x as float, facing as integer)
    m.position.x = x
    m.position.y = GROUND_Y
    m.facing = facing
    m.health = MAX_HEALTH
    m.vx = 0.0
    m.vy = 0.0
    m.knockbackVx = 0.0
    m.bufferedPress = ""
    m.bufferTicks = 0
    m.pendingHitOn = invalid
    m.setState(FighterState.idle)
    m.syncVisuals()
  end sub

  function isAirborne() as boolean
    return m.position.y > GROUND_Y + 0.01
  end function

  function isKnockedOut() as boolean
    return m.state = FighterState.ko
  end function

  function isAttackActive() as boolean
    return m.state = FighterState.attack and movePhaseAt(m.currentMove, m.stateTicks) = MovePhase.active
  end function

  ' Called by FightScene before a frame's ticks.
  sub beginFrame()
    m.wasActiveThisFrame = false
  end sub

  ' One 60 Hz step.
  sub tick(input as FighterInput, opponentX as float)
    m.stateTicks++
    press = input.takePress()
    if press <> ""
      m.bufferedPress = press
      m.bufferTicks = PRESS_BUFFER_TICKS
    else if m.bufferTicks > 0
      m.bufferTicks--
      if m.bufferTicks = 0
        m.bufferedPress = ""
      end if
    end if

    if m.isFree()
      m.facing = facingToward(m.position.x, opponentX, m.facing)
      m.tickFree(input)
    else if m.state = FighterState.preJump
      m.vx = 0.0
      if m.stateTicks >= PRE_JUMP_TICKS
        m.vy = JUMP_SPEED
        m.vx = m.jumpDirection * JUMP_FORWARD_SPEED
        m.setState(FighterState.air)
      end if
    else if m.state = FighterState.air
      if m.bufferedPress <> ""
        m.startAttack(Stance.air)
      end if
    else if m.state = FighterState.attack
      m.tickAttack()
    else if m.state = FighterState.hitstun or m.state = FighterState.blockstun or m.state = FighterState.landing
      ' Guarding is re-read through blockstun, so a held guard stays up.
      m.guarding = isHoldingBack(input.moveX, m.facing)
      m.timer--
      if m.timer <= 0
        m.setState(FighterState.idle)
      end if
    end if

    m.applyPhysics()
    if m.isAttackActive()
      m.wasActiveThisFrame = true
    end if
  end sub

  private function isFree() as boolean
    return m.state = FighterState.idle or m.state = FighterState.walk or m.state = FighterState.crouch
  end function

  private sub tickFree(input as FighterInput)
    m.guarding = isHoldingBack(input.moveX, m.facing)
    wantsCrouch = input.moveY < -0.5
    if m.bufferedPress <> ""
      if wantsCrouch
        m.startAttack(Stance.crouch)
      else
        m.startAttack(Stance.stand)
      end if
      return
    end if
    if input.moveY > 0.5
      m.jumpDirection = 0
      if input.moveX > 0.5
        m.jumpDirection = 1
      else if input.moveX < -0.5
        m.jumpDirection = -1
      end if
      m.setState(FighterState.preJump)
      m.game.playSound("jump", 60)
      return
    end if
    m.crouching = wantsCrouch
    if wantsCrouch
      m.vx = 0.0
      m.setStateIfChanged(FighterState.crouch)
      return
    end if
    if Abs(input.moveX) > 0.5
      speed = WALK_BACK_SPEED
      if input.moveX * m.facing > 0
        speed = WALK_FORWARD_SPEED
      end if
      m.vx = Sgn(input.moveX) * speed
      m.setStateIfChanged(FighterState.walk)
    else
      m.vx = 0.0
      m.setStateIfChanged(FighterState.idle)
    end if
  end sub

  private sub startAttack(stanceName as string)
    move = findMove(stanceName, m.bufferedPress)
    m.bufferedPress = ""
    m.bufferTicks = 0
    if move = invalid
      return
    end if
    m.currentMove = move
    m.moveHasHit = false
    m.crouching = stanceName = Stance.crouch
    if stanceName <> Stance.air
      m.vx = 0.0
    end if
    m.setState(FighterState.attack)
    if move.damage >= 80
      m.game.playSound("whiffHeavy", 70)
    else
      m.game.playSound("whiffLight", 60)
    end if
  end sub

  private sub tickAttack()
    move = m.currentMove as MoveDef
    if move.endsOnLanding
      return ' applyPhysics() ends it on landing
    end if
    if movePhaseAt(move, m.stateTicks) = MovePhase.done
      if m.crouching
        m.setState(FighterState.crouch)
      else
        m.setState(FighterState.idle)
      end if
    end if
  end sub

  private sub applyPhysics()
    m.position.x += m.vx + m.knockbackVx
    m.knockbackVx = decayKnockback(m.knockbackVx)
    if m.isAirborne() or m.vy > 0
      m.vy -= GRAVITY
      m.position.y += m.vy
      if m.position.y <= GROUND_Y
        m.position.y = GROUND_Y
        m.vy = 0.0
        m.onLanded()
      end if
    end if
  end sub

  private sub onLanded()
    m.vx = 0.0
    m.game.playSound("land", 40)
    if m.state = FighterState.airHit
      m.setState(FighterState.landing)
      m.landingAnim = "knockdown"
      m.timer = KNOCKDOWN_TICKS
    else if m.state = FighterState.ko
      m.knockbackVx = 0.0
    else
      m.crouching = false
      m.setState(FighterState.landing)
      m.landingAnim = "landing"
      m.timer = LANDING_TICKS
    end if
  end sub

  ' Applies an attack that connected. @return {boolean} true if it was blocked
  function receiveHit(move as MoveDef, attackerFacing as integer) as boolean
    canGuard = (m.isFree() or m.state = FighterState.blockstun) and not m.isAirborne()
    blocked = canGuard and m.guarding and canBlockHeight(move.height, m.crouching)
    m.health = healthAfterHit(m.health, move, blocked)
    m.currentMove = invalid
    if blocked
      m.setState(FighterState.blockstun)
      m.timer = move.blockstun
      m.vx = 0.0
      m.knockbackVx = attackerFacing * move.knockback * 0.7
    else if m.health <= 0
      m.setState(FighterState.ko)
      m.vy = 6.0
      m.vx = attackerFacing * 2.5
      m.crouching = false
    else if m.isAirborne()
      m.setState(FighterState.airHit)
      m.vy = 4.0
      m.vx = 0.0
      m.knockbackVx = attackerFacing * move.knockback
    else
      m.setState(FighterState.hitstun)
      m.timer = move.hitstun
      m.vx = 0.0
      m.knockbackVx = attackerFacing * move.knockback
    end if
    return blocked
  end function

  sub celebrate()
    if not m.isKnockedOut()
      m.setState(FighterState.win)
      m.vx = 0.0
    end if
  end sub

  ' The attack's world-space hitbox, or invalid when not attacking.
  function getHitbox() as dynamic
    if m.currentMove = invalid or m.state <> FighterState.attack
      return invalid
    end if
    move = m.currentMove as MoveDef
    return worldBox(move.hitbox, m.position.x, m.position.y, m.facing)
  end function

  function getHurtbox() as FightBox
    height = STAND_HEIGHT
    if m.crouching
      height = CROUCH_HEIGHT
    end if
    return newBox(m.position.x - FIGHTER_HALF_WIDTH, m.position.y, FIGHTER_HALF_WIDTH * 2, height)
  end function

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if myCollider.name = "attack" and otherCollider.name = "hurt" and not m.moveHasHit and otherEntity.tagsList.contains("fighter")
      m.pendingHitOn = otherEntity
    end if
  end sub

  ' Moves colliders and the sprite to match the current pose. Called after each frame's ticks.
  sub syncVisuals()
    height = STAND_HEIGHT
    if m.crouching
      height = CROUCH_HEIGHT
    else if m.state = FighterState.ko and not m.isAirborne()
      height = 20
    end if
    m.hurtCollider.height = height
    m.hurtCollider.offset.y = height

    m.sprite.index = m.currentAnimationFrame()
    m.sprite.update()
    m.sprite.scale.x = m.facing
    if m.state = FighterState.hitstun or m.state = FighterState.airHit
      m.sprite.color = &hFFA0A0
    else
      m.sprite.color = &hFFFFFF
    end if

    hitbox = m.getHitbox()
    active = m.wasActiveThisFrame or m.isAttackActive()
    m.attackCollider.enabled = active and not m.moveHasHit
    if hitbox <> invalid
      area = hitbox as FightBox
      m.attackCollider.offset.x = area.x - m.position.x
      m.attackCollider.offset.y = area.y - m.position.y + area.h
      m.attackCollider.width = area.w
      m.attackCollider.height = area.h
    end if
  end sub

  private function currentAnimationFrame() as integer
    if m.state = FighterState.attack and m.currentMove <> invalid
      move = m.currentMove as MoveDef
      return attackAnimationFrame(m.animations[move.id], move, m.stateTicks)
    end if
    return plainAnimationFrame(m.animations[m.animationName()], m.stateTicks)
  end function

  private function animationName() as string
    s = m.state
    if s = FighterState.idle or s = FighterState.walk or s = FighterState.preJump or s = FighterState.airHit or s = FighterState.ko or s = FighterState.win
      return s
    else if s = FighterState.crouch
      if m.guarding
        return "crouchBlock"
      end if
      return "crouch"
    else if s = FighterState.air
      return "jump"
    else if s = FighterState.landing
      return m.landingAnim
    else if s = FighterState.blockstun
      if m.crouching
        return "crouchBlock"
      end if
      return "block"
    else if s = FighterState.hitstun
      if m.crouching
        return "crouch"
      end if
      return "hitstun"
    end if
    return "idle"
  end function

  private sub setState(newState as string)
    m.state = newState
    m.stateTicks = 0
    if newState <> FighterState.attack
      m.currentMove = invalid
    end if
  end sub

  private sub setStateIfChanged(newState as string)
    if m.state <> newState
      m.setState(newState)
    end if
  end sub

end class
