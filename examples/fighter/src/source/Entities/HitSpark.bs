import "../UI/UiArt.bs"

' A hit or block spark: plays its frames from the UI atlas once, then removes itself.
class HitSpark extends BGE.GameEntity

  private frames as roRegion[]
  private age as float = 0.0
  private sprite as BGE.AnimatedImage
  private sparkScale as float

  sub new(game as BGE.Game, frames as roRegion[], scale as float)
    super(game)
    m.name = "HitSpark"
    m.frames = frames
    m.sparkScale = scale
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.sprite = m.addAnimatedImage("spark", m.frames, {animationDurationMs: 0})
    m.sprite.setAnchor(0.5, 0.5)
    m.sprite.scale.x = m.sparkScale
    m.sprite.scale.y = m.sparkScale
  end sub

  override sub onUpdate(deltaTime as float)
    m.age += deltaTime
    frame = Int(m.age * 30)
    if frame >= m.frames.count()
      m.game.destroyEntity(m)
      return
    end if
    m.sprite.index = frame
    m.sprite.update()
  end sub

end class
