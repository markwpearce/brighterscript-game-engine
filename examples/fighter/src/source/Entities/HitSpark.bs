' Placeholder hit/block spark: a square that grows and fades. TODO(art): spark sprites.
class HitSpark extends BGE.GameEntity

  private blocked as boolean
  private age as float = 0.0
  private square as BGE.DrawableRectangle

  sub new(game as BGE.Game, blocked as boolean)
    super(game)
    m.name = "HitSpark"
    m.blocked = blocked
  end sub

  override sub onCreate(args as roAssociativeArray)
    color = &hFFF080
    if m.blocked
      color = &h80C0FF
    end if
    m.square = m.addRectangle("spark", 12, 12, {color: color})
    m.square.offset.x = -6
    m.square.offset.y = 6
  end sub

  override sub onUpdate(deltaTime as float)
    m.age += deltaTime
    size = 12 + m.age * 160
    m.square.setSize(size, size)
    m.square.offset.x = -size / 2
    m.square.offset.y = size / 2
    m.square.alpha = BGE.Math.Max(0, 255 - m.age * 1600)
    if m.age > 0.15
      m.game.destroyEntity(m)
    end if
  end sub

end class
