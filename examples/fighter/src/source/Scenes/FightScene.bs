import "../Entities/Fighter.bs"
import "../Entities/HitSpark.bs"
import "../Entities/Projectile.bs"
import "../UI/FightHud.bs"
import "../UI/UiArt.bs"
import "../UI/PortraitSet.bs"
import "../Fight/MatchRules.bs"
import "../Fight/FrameLogic.bs"
import "../Fight/Roster.bs"
import "../Fight/CpuBrain.bs"
import "../Fight/Announcer.bs"
import "../Fight/PlayerSlots.bs"
import "pkg:/source/engine/PauseMenu.bs"

const STAGE_LEFT = 0.0
const STAGE_RIGHT = 960.0
const START_GAP = 170.0
' Fighters can't be further apart than the camera can show.
const MAX_SEPARATION = 360.0
const ROUND_INTRO_TICKS = 80
const FIGHT_CALL_TICKS = 45
const ROUND_END_TICKS = 200
' When the round's result is followed up (PERFECT, DRAW), after the K.O./TIME call.
const ROUND_RESULT_TICK = 90
' After a K.O. the fight runs at a third of its speed for this many ticks.
const KO_SLOW_TICKS = 60
const MATCH_PANEL_TICKS = 150
const COMBO_SHOW_TICKS = 90
' Training: health refills after this long without being hit.
const TRAINING_REFILL_TICKS = 90
const CPU_PLAYER_INDEX = 1
' How far the floor reaches behind the fighters' feet.
const FLOOR_DEPTH_BEHIND = 18.0

enum MatchPhase
  intro = "intro"
  fight = "fight"
  roundEnd = "roundEnd"
  matchOver = "matchOver"
end enum

' How a match is played (FightScene's "mode" arg).
enum FightMode
  cpu = "cpu" ' P1 against the CPU
  versus = "versus" ' two players
  training = "training" ' P1 against a dummy (P2 can take it over)
end enum

' The whole fight: stage, two fighters, best-of-3 rounds. Reads both players' controls (or
' the CPU's), runs the fixed-step simulation, resolves hits and projectiles, and drives the
' HUD, announcer and music.
'
' Args: mode (FightMode), p1/p2 (FighterPick), cpuLevel (1-3), dummy ("", "stand", "crouch").
class FightScene extends BGE.GameScene

  fighters as Fighter[] = []
  inputs as FighterInput[] = []
  hudState as HudState
  mode as string = FightMode.cpu
  ' Whether P2 is a person (versus, or a training dummy that's been taken over).
  p2Human as boolean = false
  ' "", "stand" or "crouch": how a training dummy guards.
  dummyGuard as string = ""
  private art as UiArt
  private portraits as PortraitSet
  private slots as PlayerSlots
  private picks as FighterPick[] = []
  private brain as CpuBrain
  private cpuLevel as integer = 2
  private announcer as Announcer
  private hud as FightHud
  private clock as FightClock
  private trails as HealthTrail[] = []
  private projectiles as dynamic[] = [invalid, invalid]
  private phase as string = MatchPhase.intro
  private phaseTicks as integer = 0
  private round as integer = 1
  private roundTicksLeft as integer = 0
  private hitPauseTicks as integer = 0
  private koSlowTicks as integer = 0
  private slowCounter as integer = 0
  private shakeTicks as integer = 0
  private lastHitTicks as integer[] = [0, 0]
  private roundWinner as integer = -1
  private matchWinnerIndex as integer = -1
  private panel as dynamic = invalid ' BGE.UI.MessagePanel while the match-over panel is up
  private pause as BGE.PauseMenu
  ' The remote's Back aliases to a gamepad's B (heavy kick): set on a frame Back pauses, so
  ' it doesn't kick too.
  private remoteBackThisFrame as boolean = false

  sub new(game as BGE.Game, art as UiArt, portraits as PortraitSet, slots as PlayerSlots)
    super(game)
    m.name = "FightScene"
    m.slots = slots
    m.art = art
    m.portraits = portraits
    m.clock = new FightClock()
    m.hudState = new HudState()
    m.announcer = new Announcer(game)
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    m.readArgs(args)
    for each pick in m.picks
      m.loadSceneBitmap(loader, fighterBitmapName(pick), fighterBitmapPath(pick))
    end for
  end sub

  private sub readArgs(args as roAssociativeArray)
    m.mode = FightMode.cpu
    if args.mode <> invalid
      m.mode = args.mode
    end if
    p1 = newPick("blaze", 0)
    if args.p1 <> invalid
      p1 = args.p1
    end if
    p2 = newPick("frost", 0)
    if args.p2 <> invalid
      p2 = args.p2
    end if
    p2.palette = resolvePaletteClash(p1, p2)
    m.picks = [p1, p2]
    m.cpuLevel = 2
    if args.cpuLevel <> invalid
      m.cpuLevel = args.cpuLevel
    end if
    m.brain = new CpuBrain(m.cpuLevel)
    m.dummyGuard = ""
    if args.dummy <> invalid
      m.dummyGuard = args.dummy
    end if
    m.p2Human = m.mode = FightMode.versus
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.buildStage()
    m.fighters = []
    m.inputs = []
    m.trails = []
    m.projectiles = [invalid, invalid]
    m.panel = invalid
    for i = 0 to 1
      layout = loadFighterAtlasLayout(m.picks[i].character)
      animations = loadFighterAnimations(layout)
      f = new Fighter(m.game, i, m.picks[i], animations, layout, m.art)
      m.game.addEntity(f)
      m.fighters.push(f)
      m.inputs.push(new FighterInput())
      m.trails.push(new HealthTrail())
      character = findCharacter(m.picks[i].character)
      m.hudState.names[i] = character.nameArt
      m.hudState.portraits[i] = m.portraits.indexOf(m.picks[i])
    end for
    m.hud = new FightHud(m.game, m.hudState, m.art, m.portraits)
    m.addUi(m.hud)

    ' The remote's Back pauses (a gamepad's B is a kick).
    pauseMenu = new BGE.PauseMenu(m.game, {action: "", button: "back", closeOnBack: false, title: "Paused", buttons: ["resume"]})
    pauseMenu.addButton("select", "Character Select")
    pauseMenu.addButton("title", "Quit to Title")
    pauseMenu.titleScene = "TitleScene"
    pauseMenu.listener = m
    m.game.addEntity(pauseMenu)
    m.pause = pauseMenu

    camera = m.game.canvas.renderer.camera as BGE.Camera2d
    camera.setBounds(STAGE_LEFT, 0, STAGE_RIGHT - STAGE_LEFT, m.game.canvas.getHeight())
    m.game.musicPlay("pkg:/music/fight.mp3", true)
    m.startMatch()
  end sub

  ' Parallax layers (back to front, drifting more the closer they are) and a tiled floor.
  private sub buildStage()
    canvasW = m.game.canvas.getWidth()
    canvasH = m.game.canvas.getHeight()
    layers = [
      {key: "bgSky", factor: 0.1, targetX: 0},
      {key: "bgFar", factor: 0.25, targetX: 90},
      {key: "bgBuildings", factor: 0.45, targetX: 200},
      {key: "bgFront", factor: 0.7, targetX: 310}
    ]
    for each layer in layers
      bmp = m.game.getBitmap(layer.key)
      region = CreateObject("roRegion", bmp, 0, 0, bmp.GetWidth(), bmp.GetHeight())
      m.addDrawable(layer.key, BGE.newFullHeightParallaxLayer(m, region, canvasW, canvasH, layer.factor, layer.targetX, 0.0))
    end for
    floorRegion = m.art.region("floor")
    tileW = floorRegion.GetWidth()
    x = STAGE_LEFT - canvasW / 2
    i = 0
    while x < STAGE_RIGHT + canvasW / 2
      tile = m.addImage("floor" + i.toStr(), floorRegion)
      tile.offset.x = x
      ' The fighters stand inside the floor, not on its back edge.
      tile.offset.y = GROUND_Y + FLOOR_DEPTH_BEHIND
      x += tileW
      i++
    end while
  end sub

  private sub startMatch()
    m.closePanel()
    m.hudState.wins = [0, 0]
    m.round = 1
    m.matchWinnerIndex = -1
    m.startRound()
  end sub

  private sub startRound()
    middle = (STAGE_LEFT + STAGE_RIGHT) / 2
    m.fighters[0].resetForRound(middle - START_GAP / 2, 1)
    m.fighters[1].resetForRound(middle + START_GAP / 2, -1)
    for i = 0 to 1
      m.trails[i].reset(MAX_HEALTH)
      m.inputs[i].clear()
      m.removeProjectile(i)
      m.hudState.combo[i] = 0
      m.hudState.comboTicks[i] = 0
    end for
    m.brain.reset()
    m.roundTicksLeft = ROUND_SECONDS * 60
    m.hitPauseTicks = 0
    m.koSlowTicks = 0
    m.roundWinner = -1
    m.clock.reset()
    m.setPhase(MatchPhase.intro)
    if m.mode = FightMode.training
      m.announce("fight")
      m.announcer.say("vFight")
      ' Straight to the FIGHT! call: tickIntro() acts on the next tick.
      m.phaseTicks = ROUND_INTRO_TICKS - 1
      return
    end if
    if m.isFinalRound()
      m.announce("finalRound")
      m.announcer.say("vFinalRound")
    else
      m.announce("round" + m.round.toStr())
      m.announcer.say("vRound" + m.round.toStr())
    end if
  end sub

  ' Both players a round from winning, or past round 5 (the art and voice stop there).
  private function isFinalRound() as boolean
    wins = m.hudState.wins
    return (wins[0] = ROUNDS_TO_WIN - 1 and wins[1] = ROUNDS_TO_WIN - 1) or m.round > 5
  end function

  private sub setPhase(newPhase as string)
    m.phase = newPhase
    m.phaseTicks = 0
  end sub

  private sub announce(artName as string)
    m.hudState.announcement = artName
    m.hudState.announcementTicks = 0
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isRemoteBack()
      m.remoteBackThisFrame = true
    end if
    if not input.press or m.p2Human or input.playerIndex = m.slots.devices[0]
      return
    end if
    if input.isRawButton("options") or input.isRemoteBack()
      return
    end if
    m.slots.claim(1, input.playerIndex)
    ' A second player pressing a button: against the CPU they're a new challenger and pick a
    ' fighter; in training they take over the dummy.
    if m.mode = FightMode.cpu
      m.game.changeSceneWithFade("SelectScene", {mode: FightMode.versus, p1: m.picks[0], challenger: true})
    else if m.mode = FightMode.training
      m.p2Human = true
    end if
  end sub

  override sub onUpdate(deltaTime as float)
    m.hudState.frame++
    m.announcer.update(deltaTime)
    if m.phase = MatchPhase.matchOver
      m.phaseTicks++
      m.hudState.announcementTicks++
      if m.phaseTicks = MATCH_PANEL_TICKS
        m.showMatchOver()
      end if
      for each f in m.fighters
        f.syncVisuals()
      end for
      m.updateHud()
      return
    end if
    m.readControls()
    ticks = m.clock.advance(deltaTime)
    for each f in m.fighters
      f.beginFrame()
    end for
    m.resolveHits()
    for t = 1 to ticks
      m.tick()
      if m.phase = MatchPhase.matchOver
        exit for
      end if
    end for
    for each f in m.fighters
      f.syncVisuals()
    end for
    m.updateCamera()
    m.updateHud()
  end sub

  private sub readControls()
    for i = 0 to 1
      input = m.inputs[i]
      if i = 1 and not m.p2Human
        ' The CPU and the dummy decide per tick, in tick().
        continue for
      end if
      prefix = "p" + i.toStr()
      move = m.game.controls.getAxis(prefix + "move")
      input.moveX = move.x
      input.moveY = move.y
      for each button in [AttackButton.lightPunch, AttackButton.heavyPunch, AttackButton.lightKick, AttackButton.heavyKick]
        if m.game.controls.isActionPressed(prefix + button) and not (m.remoteBackThisFrame and button = AttackButton.heavyKick)
          input.latchPress(button)
        end if
      end for
    end for
    m.remoteBackThisFrame = false
  end sub

  ' The training dummy stands still, optionally guarding, so P1 can practise.
  private sub readDummy(input as FighterInput)
    input.clear()
    ' Only holds back while attacked, since holding back also walks away.
    attacked = m.fighters[0].state = FighterState.attack or m.projectiles[0] <> invalid
    if (m.dummyGuard = "stand" or m.dummyGuard = "crouch") and attacked
      input.moveX = -m.fighters[1].facing
    end if
    if m.dummyGuard = "crouch"
      input.moveY = -1.0
    end if
  end sub

  private sub tick()
    m.phaseTicks++
    m.hudState.announcementTicks++
    for i = 0 to 1
      if m.hudState.comboTicks[i] > 0
        m.hudState.comboTicks[i]--
      end if
    end for
    if m.phase = MatchPhase.intro
      m.tickIntro()
      return
    end if
    if m.hitPauseTicks > 0
      m.hitPauseTicks--
      return
    end if
    if m.koSlowTicks > 0
      m.koSlowTicks--
      m.slowCounter++
      if m.slowCounter mod 3 <> 0
        return
      end if
    end if
    canAct = m.phase = MatchPhase.fight
    if not m.p2Human and canAct
      if m.mode = FightMode.cpu
        m.brain.think(m.inputs[CPU_PLAYER_INDEX], m.fighters[CPU_PLAYER_INDEX], m.fighters[0], m.projectiles[0])
      else
        m.readDummy(m.inputs[1])
      end if
    end if
    for i = 0 to 1
      input = m.inputs[i]
      if not canAct
        input.clear()
      end if
      m.fighters[i].canFireProjectile = m.projectiles[i] = invalid
      m.fighters[i].tick(input, m.fighters[1 - i])
      m.trails[i].tick(m.fighters[i].health)
      if m.fighters[i].wantsProjectile
        m.fighters[i].wantsProjectile = false
        m.spawnProjectile(i)
      end if
    end for
    m.tickProjectiles()
    m.separateFighters()
    if m.mode = FightMode.training
      m.tickTraining()
    end if
    if m.phase = MatchPhase.fight
      if m.mode <> FightMode.training
        m.roundTicksLeft--
      end if
      m.checkRoundOver()
    else if m.phase = MatchPhase.roundEnd
      m.tickRoundEnd()
    end if
  end sub

  private sub tickIntro()
    for i = 0 to 1
      m.inputs[i].clear()
    end for
    if m.phaseTicks = ROUND_INTRO_TICKS
      if m.mode <> FightMode.training
        m.announce("fight")
        m.announcer.say("vFight")
      end if
      for each f in m.fighters
        f.ready()
      end for
    else if m.phaseTicks >= ROUND_INTRO_TICKS + FIGHT_CALL_TICKS
      m.setPhase(MatchPhase.fight)
      m.hudState.announcement = ""
      for each f in m.fighters
        f.ready()
      end for
    end if
    for each f in m.fighters
      f.tick(m.inputs[f.playerIndex], m.fighters[1 - f.playerIndex])
    end for
  end sub

  ' Training: no rounds; health refills once a fighter's been left alone for a moment.
  private sub tickTraining()
    for i = 0 to 1
      m.lastHitTicks[i]++
      f = m.fighters[i]
      if m.lastHitTicks[i] > TRAINING_REFILL_TICKS and f.health < MAX_HEALTH and f.isFree()
        f.health = MAX_HEALTH
      end if
    end for
  end sub

  ' Pushboxes, stage edges, and the max camera separation.
  private sub separateFighters()
    a = m.fighters[0]
    b = m.fighters[1]
    ' Airborne (and thrown) fighters can cross over each other.
    grounded = not a.isAirborne() and not b.isAirborne()
    if grounded and a.state <> FighterState.thrown and b.state <> FighterState.thrown
      shift = pushApartShift(a.position.x, b.position.x, PUSH_WIDTH)
      if a.position.x > b.position.x
        shift = -shift
      end if
      a.position.x += shift
      b.position.x -= shift
    end if
    gap = b.position.x - a.position.x
    if Abs(gap) > MAX_SEPARATION
      excess = (Abs(gap) - MAX_SEPARATION) / 2 * Sgn(gap)
      a.position.x += excess
      b.position.x -= excess
    end if
    for each f in m.fighters
      f.position.x = clampToStage(f.position.x, FIGHTER_HALF_WIDTH, STAGE_LEFT, STAGE_RIGHT)
    end for
  end sub

  ' Hits found by last frame's collision pass.
  private sub resolveHits()
    for i = 0 to 1
      attacker = m.fighters[i]
      if attacker.pendingHitOn = invalid
        continue for
      end if
      attacker.pendingHitOn = invalid
      if attacker.moveHasHit or attacker.currentMove = invalid
        continue for
      end if
      defender = m.fighters[1 - i]
      if defender.isKnockedOut() or defender.isInvulnerable()
        continue for
      end if
      move = attacker.currentMove as MoveDef
      attacker.moveHasHit = true
      hitbox = attacker.getHitbox()
      m.applyHit(i, move, attacker.facing, hitbox)
      ' Pushed into a wall, the attacker takes the knockback instead.
      if not defender.isAirborne()
        atWall = defender.position.x <= STAGE_LEFT + FIGHTER_HALF_WIDTH + 1 or defender.position.x >= STAGE_RIGHT - FIGHTER_HALF_WIDTH - 1
        if atWall
          attacker.pushBack(-attacker.facing * move.knockback)
        end if
      end if
    end for
  end sub

  ' A hit from player `attackerIndex` (a move or their projectile) lands on the other player.
  ' `hitbox` is where it hit from, for the spark.
  private sub applyHit(attackerIndex as integer, move as MoveDef, facing as integer, hitbox as dynamic)
    attacker = m.fighters[attackerIndex]
    defender = m.fighters[1 - attackerIndex]
    wasStunned = defender.state = FighterState.hitstun or defender.state = FighterState.airHit
    healthBefore = defender.health
    damage = Int(move.damage * attacker.character.damageScale)
    blocked = defender.receiveHit(move, facing, damage)
    if defender.health < healthBefore
      m.trails[1 - attackerIndex].onDamage()
      m.lastHitTicks[1 - attackerIndex] = 0
    end if
    m.hitPauseTicks = move.hitPause
    m.spawnSpark(hitbox, defender, blocked, move.damage >= 80)
    heavy = move.damage >= 80
    if blocked
      if heavy
        m.game.playSound("blockHeavy", 80)
      else
        m.game.playSound("block", 70)
      end if
      return
    end if
    if heavy
      m.shakeTicks = 8
      m.game.playSound(m.pickSound(["hitHeavy", "hitHeavy2"]), 95)
      if not defender.isKnockedOut()
        m.announcer.grunt(m.pickSound(["grunt1", "grunt2", "grunt3"]))
      end if
    else
      m.game.playSound(m.pickSound(["hitLight", "hitLight2"]), 85)
    end if
    ' Combos: hits that land before the defender has recovered from the last one.
    if wasStunned and m.hudState.comboTicks[attackerIndex] > 0
      m.hudState.combo[attackerIndex]++
      if m.hudState.combo[attackerIndex] = 3
        m.announcer.say("vCombo")
      end if
    else
      m.hudState.combo[attackerIndex] = 1
    end if
    m.hudState.comboTicks[attackerIndex] = COMBO_SHOW_TICKS
  end sub

  private function pickSound(names as string[]) as string
    return names[Rnd(names.count()) - 1]
  end function

  private sub spawnSpark(hitbox as dynamic, defender as Fighter, blocked as boolean, heavy as boolean)
    b = defender.getHurtbox()
    x = defender.position.x
    y = defender.position.y + b.h * 0.65
    if hitbox <> invalid
      a = hitbox as FightBox
      x = (BGE.Math.Max(a.x, b.x) + BGE.Math.Min(a.x + a.w, b.x + b.w)) / 2
      y = (BGE.Math.Max(a.y, b.y) + BGE.Math.Min(a.y + a.h, b.y + b.h)) / 2
    end if
    frames = m.art.frames("spark")
    scale = 0.8
    if heavy
      scale = 1.2
    end if
    if blocked
      frames = m.art.frames("block")
      scale = 0.9
    end if
    spark = new HitSpark(m.game, frames, scale)
    m.game.addEntity(spark)
    spark.position.x = x
    spark.position.y = y
  end sub

  private sub spawnProjectile(ownerIndex as integer)
    owner = m.fighters[ownerIndex]
    character = findCharacter(m.picks[ownerIndex].character)
    shot = new Projectile(m.game, ownerIndex, owner.facing, owner.heavyVersion, m.art.frames(character.projectileArt))
    m.game.addEntity(shot)
    shot.position.x = owner.position.x + owner.facing * 34
    shot.position.y = owner.position.y + 62
    m.projectiles[ownerIndex] = shot
    m.game.playSound("fireball", 80)
  end sub

  private sub removeProjectile(index as integer)
    if m.projectiles[index] <> invalid
      m.game.destroyEntity(m.projectiles[index])
      m.projectiles[index] = invalid
    end if
  end sub

  ' Moves projectiles, clashes them, and hits the other fighter.
  private sub tickProjectiles()
    for i = 0 to 1
      if m.projectiles[i] <> invalid
        shot = m.projectiles[i] as Projectile
        shot.tick()
        if shot.position.x < STAGE_LEFT - 40 or shot.position.x > STAGE_RIGHT + 40
          m.removeProjectile(i)
        end if
      end if
    end for
    if m.projectiles[0] <> invalid and m.projectiles[1] <> invalid
      a = m.projectiles[0] as Projectile
      b = m.projectiles[1] as Projectile
      if boxesOverlap(a.getHitbox(), b.getHitbox())
        m.spawnSpark(a.getHitbox(), m.fighters[1], true, true)
        m.removeProjectile(0)
        m.removeProjectile(1)
        m.game.playSound("blockHeavy", 80)
        return
      end if
    end if
    for i = 0 to 1
      if m.projectiles[i] <> invalid
        shot = m.projectiles[i] as Projectile
        defender = m.fighters[1 - i]
        if not defender.isInvulnerable() and boxesOverlap(shot.getHitbox(), defender.getHurtbox())
          move = getSpecialMoves().fireball as MoveDef
          hitbox = shot.getHitbox()
          m.removeProjectile(i)
          m.applyHit(i, move, shot.direction, hitbox)
        end if
      end if
    end for
  end sub

  private sub checkRoundOver()
    koCount = 0
    for each f in m.fighters
      if f.isKnockedOut()
        koCount++
      end if
    end for
    if m.mode = FightMode.training
      if koCount > 0
        m.startRound()
      end if
      return
    end if
    if koCount > 0
      m.endRound("ko")
      m.koSlowTicks = KO_SLOW_TICKS
      m.game.playSound("gruntKo", 100)
      m.announcer.sting("koSting")
    else if m.roundTicksLeft <= 0
      m.endRound("time")
      m.announcer.say("vTime")
    end if
  end sub

  private sub endRound(callout as string)
    m.announce(callout)
    for i = 0 to 1
      m.removeProjectile(i)
    end for
    m.roundWinner = roundWinnerByHealth(m.fighters[0].health, m.fighters[1].health)
    if m.roundWinner = -1
      m.hudState.wins[0]++
      m.hudState.wins[1]++
    else
      m.hudState.wins[m.roundWinner]++
    end if
    m.setPhase(MatchPhase.roundEnd)
  end sub

  private sub tickRoundEnd()
    if m.phaseTicks = ROUND_RESULT_TICK
      if m.roundWinner = -1
        m.announce("draw")
        m.announcer.say("vTie")
      else
        m.fighters[m.roundWinner].celebrate()
        if m.fighters[m.roundWinner].health = MAX_HEALTH
          m.announce("perfect")
          m.announcer.say("vFlawless")
        end if
      end if
    else if m.phaseTicks >= ROUND_END_TICKS
      m.finishRound()
    end if
  end sub

  private sub finishRound()
    winner = matchWinner(m.hudState.wins)
    if winner >= 0
      m.matchWinnerIndex = winner
      m.setPhase(MatchPhase.matchOver)
      m.fighters[winner].celebrate()
      m.announceMatchWinner(winner)
      m.game.musicPlay("pkg:/music/victory.mp3", false)
      return
    end if
    m.round++
    m.startRound()
  end sub

  private sub announceMatchWinner(winner as integer)
    if m.mode = FightMode.cpu
      if winner = 0
        m.announce("youWin")
        m.announcer.say("vYouWin")
      else
        m.announce("youLose")
        m.announcer.say("vYouLose")
      end if
      return
    end if
    m.announce("p" + (winner + 1).toStr() + "Wins")
    m.announcer.say("vPlayer" + (winner + 1).toStr())
    m.announcer.say("vWinner", 1.3)
  end sub

  private sub showMatchOver()
    buttons = [
      new BGE.UI.MessagePanelButton("Rematch", invalid, "rematch"),
      new BGE.UI.MessagePanelButton("Character Select", invalid, "select"),
      new BGE.UI.MessagePanelButton("Quit to Title", invalid, "title")
    ]
    panel = new BGE.UI.MessagePanel(m.game, 0.0, 0.0, buttons, "")
    panel.listener = m
    ' no parent: owned by this scene, so it's removed if the scene changes
    panel.show()
    m.panel = panel
    m.hudState.announcement = ""
  end sub

  sub onUiAction(actionId as string, button as BGE.UI.Button)
    if actionId = "rematch"
      m.game.playSound("menuSelect", 70)
      m.game.musicPlay("pkg:/music/fight.mp3", true)
      m.startMatch()
    else if actionId = "select"
      m.pause.close()
      m.game.changeSceneWithFade("SelectScene", {mode: m.mode, cpuLevel: m.cpuLevel})
    else if actionId = "title"
      m.pause.close()
      m.game.changeSceneWithFade("TitleScene")
    end if
  end sub

  private sub closePanel()
    if m.panel <> invalid
      panel = m.panel as BGE.UI.MessagePanel
      panel.hide()
      m.panel = invalid
    end if
  end sub

  private sub updateCamera()
    camera = m.game.canvas.renderer.camera as BGE.Camera2d
    midX = (m.fighters[0].position.x + m.fighters[1].position.x) / 2
    shake = 0.0
    if m.shakeTicks > 0
      m.shakeTicks--
      shake = (m.shakeTicks mod 2) * 4 - 2
    end if
    camera.setTarget(BGE.Math.VectorOps.create(midX + shake, m.game.canvas.getHeight() / 2))
  end sub

  private sub updateHud()
    for i = 0 to 1
      m.hudState.health[i] = m.fighters[i].health
      m.hudState.trail[i] = m.trails[i].value
    end for
    if m.mode = FightMode.training
      m.hudState.secondsLeft = -1
    else
      m.hudState.secondsLeft = Int((m.roundTicksLeft + 59) / 60)
      if m.hudState.secondsLeft < 0
        m.hudState.secondsLeft = 0
      end if
    end if
    m.hudState.prompt = ""
    if m.phase = MatchPhase.fight and not m.p2Human
      if m.mode = FightMode.training
        m.hudState.prompt = "Training - P2: press any button to take over"
      else if m.hudState.frame mod 120 < 80
        m.hudState.prompt = "P2: press any button to challenge"
      end if
    end if
  end sub

end class
