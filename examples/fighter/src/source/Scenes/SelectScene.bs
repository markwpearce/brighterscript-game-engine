import "pkg:/source/engine/ui/UiWidget.bs"
import "../UI/UiArt.bs"
import "../UI/PortraitSet.bs"
import "../Fight/Roster.bs"
import "../Fight/MoveData.bs"
import "../Fight/Announcer.bs"
import "FightScene.bs"
import "../Fight/PlayerSlots.bs"

const SELECT_CPU_ROULETTE_TICKS = 40
const SELECT_CONFIRMED_PAUSE = 0.8
const SELECT_VS_SECONDS = 2.4
const SELECT_P1_RGBA = &hE8402AFF
const SELECT_P2_RGBA = &h2A8CE8FF
const SELECT_CARD_W = 200
const SELECT_CARD_H = 290
const SELECT_CARD_Y = 160
const SELECT_CARD_SPACING = 250

' What the select screen shows; SelectScene updates it.
class SelectState
  ' Which character each player's cursor is on (roster index), and whether they've picked.
  cursor as integer[] = [0, 1]
  palette as integer[] = [0, 0]
  confirmed as boolean[] = [false, false]
  ' P1 claims a controller by pressing any button, unless the Controllers screen did it.
  p1Joined as boolean = true
  p2Joined as boolean = false
  p2Label as string = "2P"
  showVs as boolean = false
  vsTicks as integer = 0
  frame as integer = 0
end class

' Draws the select screen and the VS splash on the UI canvas (laid out for 1280x720).
class SelectView extends BGE.UI.UiWidget
  private art as UiArt
  private portraits as PortraitSet
  private state as SelectState

  sub new(game as BGE.Game, art as UiArt, portraits as PortraitSet, state as SelectState)
    super(game)
    m.art = art
    m.portraits = portraits
    m.state = state
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    m.state.frame++
    renderer = m.canvas.renderer
    canvasW = m.canvas.getWidth()
    canvasH = m.canvas.getHeight()
    backdrop = m.game.getBitmap("titleBg")
    renderer.drawScaledObject(0, 0, canvasW / backdrop.GetWidth(), canvasH / backdrop.GetHeight(), backdrop)
    renderer.drawRectangle(0, 0, canvasW, canvasH, &h05081090)
    if m.state.showVs
      m.drawVs(renderer, canvasW, canvasH)
    else
      m.drawSelect(renderer, canvasW, canvasH)
    end if
  end sub

  private sub drawSelect(renderer as BGE.Renderer, canvasW as integer, canvasH as integer)
    m.art.drawCentered(renderer, "chooseFighter", canvasW / 2, canvasH * 0.15)
    roster = getRoster()
    for i = 0 to roster.count() - 1
      cx = m.cardX(i, canvasW)
      x = cx - SELECT_CARD_W / 2
      y = SELECT_CARD_Y
      renderer.drawRectangle(x - 6, y - 6, SELECT_CARD_W + 12, SELECT_CARD_H + 12, &h11131CFF)
      renderer.drawRectangle(x, y, SELECT_CARD_W, SELECT_CARD_H, &h1E2438FF)
      ' Show the colour the player on this card has picked (P1 first), else the first.
      palette = 0
      for p = 1 to 0 step -1
        if m.state.cursor[p] = i and (p = 0 or m.state.p2Joined)
          palette = m.state.palette[p]
        end if
      end for
      body = m.portraits.body(m.portraits.indexOf(newPick(roster[i].id, palette)))
      scale = SELECT_CARD_H / body.GetHeight()
      renderer.drawRegion(body, cx - body.GetWidth() * scale / 2, y, scale, scale)
      m.art.drawCentered(renderer, roster[i].nameArt, cx, y + SELECT_CARD_H + 30, 0.8)
      ' The colours: up/down picks one.
      count = roster[i].palettes
      for p = 0 to count - 1
        swatch = m.portraits.region(m.portraits.indexOf(newPick(roster[i].id, p)))
        sx = cx - count * 27 + p * 54 + 4
        sy = y + SELECT_CARD_H + 60
        border = &h11131CFF
        for player = 0 to 1
          if m.state.cursor[player] = i and m.state.palette[player] = p and (player = 0 or m.state.p2Joined)
            if player = 0
              border = SELECT_P1_RGBA
            else
              border = SELECT_P2_RGBA
            end if
          end if
        end for
        renderer.drawRectangle(sx - 4, sy - 4, 54, 54, border)
        renderer.drawRegion(swatch, sx, sy, 46 / swatch.GetWidth(), 46 / swatch.GetWidth())
      end for
    end for
    if m.state.p1Joined
      m.drawCursor(renderer, canvasW, canvasH, 0)
    end if
    if m.state.p2Joined
      m.drawCursor(renderer, canvasW, canvasH, 1)
    end if
    font = m.game.getFont("hud")
    hint = "Left/Right: fighter   Up/Down: colour   Punch, kick or OK: select"
    if not m.state.p1Joined
      hint = "1P: press any button"
    else if m.state.confirmed[0] and not m.state.p2Joined
      hint = "2P: press any button to join"
    end if
    renderer.drawText(hint, canvasW / 2, canvasH * 0.9, &hFFFFFFFF, font, "center", "bottom")
  end sub

  private sub drawCursor(renderer as BGE.Renderer, canvasW as integer, canvasH as integer, playerIndex as integer)
    cx = m.cardX(m.state.cursor[playerIndex], canvasW)
    ' P2's frame sits just inside P1's when both are on one card.
    inset = -10
    if playerIndex = 1
      inset = -2
    end if
    color = SELECT_P1_RGBA
    label = "1P"
    if playerIndex = 1
      color = SELECT_P2_RGBA
      label = m.state.p2Label
    end if
    if m.state.confirmed[playerIndex] and (m.state.frame mod 16) < 8
      color = &hFFFFFFFF
    end if
    x = cx - SELECT_CARD_W / 2 + inset
    y = SELECT_CARD_Y + inset
    size = SELECT_CARD_W - inset * 2
    renderer.drawRectangleOutline(x, y, size, SELECT_CARD_H - inset * 2, color, 6)
    font = m.game.getFont("hud")
    if playerIndex = 0
      renderer.drawRectangle(x, y - 36, 64, 36, color)
      renderer.drawText(label, x + 32, y - 34, &hFFFFFFFF, font, "center", "top")
    else
      renderer.drawRectangle(x + size - 80, y - 36, 80, 36, color)
      renderer.drawText(label, x + size - 40, y - 34, &hFFFFFFFF, font, "center", "top")
    end if
  end sub

  private function cardX(index as integer, canvasW as integer) as float
    return canvasW / 2 + (index - (getRoster().count() - 1) / 2) * SELECT_CARD_SPACING
  end function

  private sub drawVs(renderer as BGE.Renderer, canvasW as integer, canvasH as integer)
    m.state.vsTicks++
    roster = getRoster()
    size = 400
    ' The portraits slide in from the sides.
    slide = BGE.Math.Max(0, 1 - m.state.vsTicks / 15.0)
    for p = 0 to 1
      character = roster[m.state.cursor[p]]
      region = m.portraits.region(m.portraits.indexOf(newPick(character.id, m.state.palette[p])))
      scale = size / region.GetWidth()
      y = canvasH / 2 - size / 2 - 30
      if p = 0
        x = canvasW * 0.27 - size / 2 - slide * 600
        renderer.drawRegion(region, x, y, scale, scale)
        m.art.drawCentered(renderer, character.nameArt, canvasW * 0.27, y + size + 40, 1.3)
      else
        x = canvasW * 0.73 - size / 2 + slide * 600
        renderer.drawRegion(region, x + size, y, -scale, scale)
        m.art.drawCentered(renderer, character.nameArt, canvasW * 0.73, y + size + 40, 1.3)
      end if
    end for
    vsScale = 1.0
    if m.state.vsTicks < 20
      vsScale = 2.5 - 1.5 * m.state.vsTicks / 20.0
    end if
    m.art.drawCentered(renderer, "vs", canvasW / 2, canvasH / 2, vsScale)
  end sub
end class

' Character select. Each player picks a fighter with left/right and a colour with up/down,
' and locks in with any attack button (OK is light kick). Against the CPU it picks after P1;
' in versus P2 joins with any button. Then a VS splash, then the fight.
'
' Args: mode (FightMode), cpuLevel (1-3), challenger (true: P2 just pressed to join).
class SelectScene extends BGE.GameScene

  private art as UiArt
  private portraits as PortraitSet
  private state as SelectState
  private slots as PlayerSlots
  private announcer as Announcer
  private mode as string = FightMode.cpu
  private cpuLevel as integer = 2
  private lastMoveX as float[] = [0.0, 0.0]
  private lastMoveY as float[] = [0.0, 0.0]
  private rouletteTicks as integer = 0
  private doneTimer as float = 0.0
  ' The remote's Back aliases to a gamepad's B (heavy kick), so it mustn't pick a colour.
  private remoteBackThisFrame as boolean = false
  private backThisFrame as boolean = false

  sub new(game as BGE.Game, art as UiArt, portraits as PortraitSet, slots as PlayerSlots)
    super(game)
    m.name = "SelectScene"
    m.slots = slots
    m.art = art
    m.portraits = portraits
    m.announcer = new Announcer(game)
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.state = new SelectState()
    m.mode = FightMode.cpu
    if args.mode <> invalid
      m.mode = args.mode
    end if
    if args.cpuLevel <> invalid
      m.cpuLevel = args.cpuLevel
    end if
    m.state.p2Label = "2P"
    if m.mode = FightMode.cpu
      m.state.p2Label = "CPU"
    else if m.mode = FightMode.training
      m.state.p2Label = "DUMMY"
    end if
    m.state.p2Joined = args.challenger = true
    m.state.p1Joined = m.slots.claimed[0] or args.challenger = true
    m.rouletteTicks = 0
    m.doneTimer = 0.0
    m.lastMoveX = [0.0, 0.0]
    m.lastMoveY = [0.0, 0.0]
    m.addUi(new SelectView(m.game, m.art, m.portraits, m.state))
    m.game.musicPlay("pkg:/music/title.mp3", true, false)
    m.announcer.say("vChoose", 0.3)
    ' Swallow the press that got us here.
    m.game.controls.blockHeldActions()
  end sub

  override sub onInput(input as BGE.GameInput)
    if not input.press
      return
    end if
    if not m.state.p1Joined
      ' Whichever controller presses first is P1.
      if not input.isRemoteBack()
        m.slots.claim(0, input.playerIndex)
        m.state.p1Joined = true
        m.game.playSound("menuSelect", 70)
        return
      end if
    end if
    if input.isRemoteBack()
      m.remoteBackThisFrame = true
      if m.state.confirmed[0] and not m.state.showVs
        m.state.confirmed[0] = false
        m.rouletteTicks = 0
        if m.mode <> FightMode.versus
          m.state.confirmed[1] = false
          m.state.p2Joined = false
        end if
      else if not m.state.showVs
        m.game.changeSceneWithFade("TitleScene")
      end if
      return
    end if
    if m.mode = FightMode.versus and m.state.p1Joined and not m.state.p2Joined and input.playerIndex <> m.slots.devices[0]
      m.slots.claim(1, input.playerIndex)
      m.state.p2Joined = true
      m.game.playSound("menuSelect", 70)
    end if
  end sub

  override sub onUpdate(deltaTime as float)
    m.announcer.update(deltaTime)
    m.backThisFrame = m.remoteBackThisFrame
    m.remoteBackThisFrame = false
    if m.state.showVs
      m.doneTimer += deltaTime
      if m.doneTimer >= SELECT_VS_SECONDS
        m.startFight()
      end if
      return
    end if
    if not m.state.p1Joined
      return
    end if
    m.readPlayer(0)
    if m.mode = FightMode.versus
      if m.state.p2Joined
        m.readPlayer(1)
      end if
    else if m.state.confirmed[0] and not m.state.confirmed[1]
      m.pickForCpu()
    end if
    if m.state.confirmed[0] and m.state.confirmed[1]
      m.doneTimer += deltaTime
      if m.doneTimer >= SELECT_CONFIRMED_PAUSE
        m.doneTimer = 0.0
        m.state.showVs = true
        m.state.vsTicks = 0
        m.game.playSound("koSting", 80)
        ' The announcer calls both fighters.
        roster = getRoster()
        m.announcer.say("v" + roster[m.state.cursor[0]].name, 0.3)
        m.announcer.say("v" + roster[m.state.cursor[1]].name, 1.4)
      end if
    end if
  end sub

  private sub readPlayer(playerIndex as integer)
    if m.state.confirmed[playerIndex]
      return
    end if
    prefix = "p" + playerIndex.toStr()
    moveX = m.game.controls.getAxis(prefix + "move").x
    moveY = m.game.controls.getAxis(prefix + "move").y
    previous = m.lastMoveX[playerIndex]
    previousY = m.lastMoveY[playerIndex]
    m.lastMoveX[playerIndex] = moveX
    m.lastMoveY[playerIndex] = moveY
    rosterSize = getRoster().count()
    paletteCount = getRoster()[m.state.cursor[playerIndex]].palettes
    if moveY > 0.5 and previousY <= 0.5
      m.state.palette[playerIndex] = (m.state.palette[playerIndex] + paletteCount - 1) mod paletteCount
      m.game.playSound("menuMove", 60)
    else if moveY < -0.5 and previousY >= -0.5
      m.state.palette[playerIndex] = (m.state.palette[playerIndex] + 1) mod paletteCount
      m.game.playSound("menuMove", 60)
    end if
    if moveX > 0.5 and previous <= 0.5
      m.state.cursor[playerIndex] = (m.state.cursor[playerIndex] + 1) mod rosterSize
      m.state.palette[playerIndex] = 0
      m.game.playSound("menuMove", 60)
    else if moveX < -0.5 and previous >= -0.5
      m.state.cursor[playerIndex] = (m.state.cursor[playerIndex] + rosterSize - 1) mod rosterSize
      m.state.palette[playerIndex] = 0
      m.game.playSound("menuMove", 60)
    end if
    for each button in [AttackButton.lightPunch, AttackButton.heavyPunch, AttackButton.lightKick, AttackButton.heavyKick]
      if m.game.controls.isActionPressed(prefix + button) and not (m.backThisFrame and button = AttackButton.heavyKick)
        m.confirm(playerIndex, m.state.palette[playerIndex])
        exit for
      end if
    end for
  end sub

  private sub confirm(playerIndex as integer, palette as integer)
    m.state.palette[playerIndex] = palette
    m.state.confirmed[playerIndex] = true
    m.game.playSound("menuSelect", 80)
    if playerIndex = 1
      roster = getRoster()
      p1 = newPick(roster[m.state.cursor[0]].id, m.state.palette[0])
      p2 = newPick(roster[m.state.cursor[1]].id, palette)
      m.state.palette[1] = resolvePaletteClash(p1, p2)
    end if
  end sub

  ' The CPU (or training dummy) flicks between fighters for a moment, then settles.
  private sub pickForCpu()
    m.state.p2Joined = true
    m.rouletteTicks++
    rosterSize = getRoster().count()
    if m.rouletteTicks mod 5 = 0
      m.state.cursor[1] = (m.state.cursor[1] + 1) mod rosterSize
      m.game.playSound("menuMove", 40)
    end if
    if m.rouletteTicks >= SELECT_CPU_ROULETTE_TICKS
      m.state.cursor[1] = Rnd(rosterSize) - 1
      m.confirm(1, Rnd(getRoster()[m.state.cursor[1]].palettes) - 1)
    end if
  end sub

  private sub startFight()
    roster = getRoster()
    p1 = newPick(roster[m.state.cursor[0]].id, m.state.palette[0])
    p2 = newPick(roster[m.state.cursor[1]].id, m.state.palette[1])
    m.game.changeSceneWithFade("FightScene", {mode: m.mode, p1: p1, p2: p2, cpuLevel: m.cpuLevel})
  end sub

end class
