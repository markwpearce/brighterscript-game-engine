import "pkg:/source/engine/ui/UiWidget.bs"
import "pkg:/source/engine/ui/MenuList.bs"
import "../UI/UiArt.bs"
import "../Fight/MatchRules.bs"

const CPU_LEVEL_NAMES = ["Easy", "Normal", "Hard"]

' The backdrop and logo behind the title menu, drawn on the UI canvas.
class TitleView extends BGE.UI.UiWidget
  frame as integer = 0
  private art as UiArt

  sub new(game as BGE.Game, art as UiArt)
    super(game)
    m.art = art
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    m.frame++
    renderer = m.canvas.renderer
    canvasW = m.canvas.getWidth()
    canvasH = m.canvas.getHeight()
    backdrop = m.game.getBitmap("titleBg")
    renderer.drawScaledObject(0, 0, canvasW / backdrop.GetWidth(), canvasH / backdrop.GetHeight(), backdrop)
    ' The logo bobs gently.
    bob = Sin(m.frame / 30.0) * 4
    m.art.drawCentered(renderer, "logo", canvasW / 2, canvasH * 0.22 + bob, 0.72)
    font = m.game.getFont("small")
    renderer.drawText("Art, sound and voices: CC0 / OGA-BY / CC-BY-SA - see README", canvasW / 2, canvasH * 0.9, &hA0B0C0FF, font, "center", "bottom")
  end sub
end class

' Title screen: logo and a menu to pick a mode (and the CPU's level).
class TitleScene extends BGE.GameScene

  private art as UiArt
  private menu as BGE.UI.MenuList
  private cpuLevel as integer = 2

  sub new(game as BGE.Game, art as UiArt)
    super(game)
    m.name = "TitleScene"
    m.art = art
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.addUi(new TitleView(m.game, m.art))
    m.game.musicPlay("pkg:/music/title.mp3", true, false)
    menu = new BGE.UI.MenuList(m.game)
    menu.listener = m
    menu.itemWidth = 360
    menu.itemHeight = 44
    menu.itemGap = 8
    menu.addItem("cpu", "Arcade (vs CPU)")
    menu.addItem("versus", "2 Players")
    menu.addItem("training", "Training")
    menu.addItem("level", m.levelLabel())
    menu.addItem("quit", "Quit")
    menu.open()
    ' Below the logo, centred.
    canvasW = m.game.uiCanvas.getWidth()
    canvasH = m.game.uiCanvas.getHeight()
    menu.customX = (canvasW - menu.width) / 2
    menu.customY = canvasH * 0.41
    m.menu = menu
  end sub

  private function levelLabel() as string
    return "CPU: " + CPU_LEVEL_NAMES[m.cpuLevel - 1]
  end function

  sub onUiAction(actionId as string, button as BGE.UI.Button)
    m.game.playSound("menuSelect", 70)
    if actionId = "level"
      m.cpuLevel = (m.cpuLevel mod 3) + 1
      button.setLabel(m.levelLabel())
    else if actionId = "quit"
      m.game.End()
    else
      m.game.changeSceneWithFade("SelectScene", {mode: actionId, cpuLevel: m.cpuLevel})
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isRemoteBack()
      m.game.End()
    end if
  end sub

end class
