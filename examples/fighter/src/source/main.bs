import "Scenes/TitleScene.bs"
import "Scenes/SelectScene.bs"
import "Scenes/FightScene.bs"
import "Scenes/ControlsScene.bs"
import "Fight/PlayerSlots.bs"
import "UI/UiArt.bs"
import "UI/PortraitSet.bs"

' Launch params (rokubot launch dev --param ...):
'   scene=fight|select   skip the title (fight also takes mode, p1, p2, cpu, dummy)
'   mode=cpu|versus|training, p1=blaze:0, p2=frost:1 (character:palette), cpu=1-3
'   dummy=stand|crouch   how the training dummy guards
sub Main(args as dynamic)
  game = new BGE.Game(448, 252, 1280, 720)
  game.fitCanvasToScreen()
  ' Every remote, gamepad and browser controller gets its own player index.
  game.enableControllerInput(8888, false)
  slots = new PlayerSlots(game)

  loadStageLayers(game)
  game.loadBitmap("ui", "pkg:/sprites/ui/ui.webp")
  game.loadBitmap("portraits", "pkg:/sprites/fighters/portraits.webp")
  game.loadBitmap("bodies", "pkg:/sprites/fighters/bodies.webp")
  game.loadBitmap("titleBg", "pkg:/images/title_bg.jpg")
  sounds = ["jump", "land", "thump", "whiffLight", "whiffHeavy", "hitLight", "hitLight2", "hitHeavy", "hitHeavy2", "block", "blockHeavy", "fireball", "koSting", "menuMove", "menuSelect", "grunt1", "grunt2", "grunt3"]
  voices = ["vRound1", "vRound2", "vRound3", "vRound4", "vRound5", "vFinalRound", "vFight", "vTime", "vYouWin", "vFlawless", "vTie", "vChoose", "vCombo", "vKO", "vWins", "vNewChallenger", "vBlaze", "vFrost", "vBruno", "vNova"]
  for each sound in sounds
    game.loadSound(sound, "pkg:/sounds/" + sound + ".wav")
  end for
  for each sound in voices
    game.loadSound(sound, "pkg:/sounds/" + sound + ".wav")
  end for

  game.registerFont("pkg:/fonts/ViperCommand-3l74X.otf")
  game.loadFont("hud", "Viper Command", 30, false, false)
  game.loadFont("small", "Viper Command", 24, false, false)
  game.loadFont("timer", "Viper Command", 52, false, false)
  game.loadFont("heading", "Viper Command", 40, false, false)
  applyTheme(game)

  art = new UiArt(game)
  portraits = new PortraitSet(game, loadFighterAtlas())
  game.defineScene(new TitleScene(game, art))
  game.defineScene(new ControlsScene(game, art, slots))
  game.defineScene(new SelectScene(game, art, portraits, slots))
  game.defineScene(new FightScene(game, art, portraits, slots))

  params = new BGE.LaunchParams(args)
  start = params.pick(["scene", "mode", "p1", "p2", "cpu", "dummy"])
  ' * steps through: off, FPS, then every panel with collider outlines and entity details.
  game.enableDebugToggle({
    button: "options",
    levels: [
      {},
      {showUi: true, panels: {input: false, memory: false, garbageCollector: false, log: false}},
      {showUi: true, panels: {}, colliders: true, entityDetails: true}
    ]
  })
  if start.scene = "fight"
    level = 2
    if start.cpu <> invalid
      level = start.cpu.toInt()
    end if
    game.changeScene("FightScene", {
      mode: start.mode,
      p1: parsePick(start.p1, newPick("blaze", 0)),
      p2: parsePick(start.p2, newPick("frost", 0)),
      cpuLevel: level,
      dummy: start.dummy
    })
  else if start.scene = "select"
    game.changeScene("SelectScene", {mode: start.mode})
  else
    game.changeScene("TitleScene")
  end if
  game.play()
end sub

' Dark steel panels with gold text, to match the art.
sub applyTheme(game as BGE.Game)
  theme = game.defaultTheme
  theme.font = game.getFont("hud")
  theme.panelBackgroundColor = &h0C1020E8
  theme.panelTitleColor = &hFFD84AFF
  theme.panelTextColor = &hFFFFFFFF
  theme.backgroundColor = &h2C3250FF
  theme.hoveredBackgroundColor = &hC3200CFF
  theme.focusedBorderColor = &hFFD84AFF
  theme.foregroundColor = &hFFFFFFFF
end sub

' The industrial layers have different heights; each is copied bottom-aligned onto a
' 272x160 bitmap so they share one scale and sit on the same horizon.
sub loadStageLayers(game as BGE.Game)
  files = {
    bgSky: "skill-desc_0003_bg.png",
    bgFar: "skill-desc_0002_far-buildings.png",
    bgBuildings: "skill-desc_0001_buildings.png",
    bgFront: "skill-desc_0000_foreground.png"
  }
  for each key in files
    source = CreateObject("roBitmap", "pkg:/sprites/stage/" + files[key])
    layer = CreateObject("roBitmap", {width: source.GetWidth(), height: 160, alphaEnable: true})
    layer.Clear(&h00000000)
    layer.DrawObject(0, 160 - source.GetHeight(), source)
    game.loadBitmap(key, layer)
  end for
end sub
