import "Scenes/FightScene.bs"

' Launch params (rokubot launch dev --param ...): p2=1 joins P2 straight away;
' dummy=stand|crouch makes an unjoined P2 guard.
sub Main(args as dynamic)
  game = new BGE.Game(640, 360, 1280, 720)
  game.fitCanvasToScreen()
  ' Every remote, gamepad and browser controller gets its own player index.
  game.enableControllerInput(8888, false)
  bindPlayerControls(game, 0)
  bindPlayerControls(game, 1)

  loadStageLayers(game)
  game.loadBitmap("fighterP1", "pkg:/sprites/fighters/p1.png")
  game.loadBitmap("fighterP2", "pkg:/sprites/fighters/p2.png")
  for each sound in ["jump", "land", "whiffLight", "whiffHeavy", "hitLight", "hitHeavy", "block", "announceRound", "announceFight", "announceKo", "announceTime", "announceWin"]
    game.loadSound(sound, "pkg:/sounds/" + sound + ".wav")
  end for

  game.registerFont("pkg:/fonts/ViperCommand-3l74X.otf")
  game.loadFont("hud", "Viper Command", 30, false, false)
  game.loadFont("announce", "Viper Command", 96, false, false)
  game.loadFont("heading", "Viper Command", 40, false, false)
  game.defaultTheme.font = game.getFont("hud")

  game.defineScene(new FightScene(game))
  params = {}
  if type(args) = "roAssociativeArray"
    params = args
  end if
  game.changeScene("FightScene", params)
  game.play()
end sub

' Gamepad: X/Y punch, A/B kick (light/heavy). Remote: Rewind/Play punch, OK/Fast-forward kick.
' Gamepad B arrives as the remote's Back, so Back is heavy kick too. Browser controller
' page: x/y/ok/b.
sub bindPlayerControls(game as BGE.Game, playerIndex as integer)
  prefix = "p" + playerIndex.toStr()
  game.controls.bindAxis(prefix + "move", "1", playerIndex, "Move")
  game.controls.bindAction(prefix + AttackButton.lightPunch, ["rewind", "x"], "x", playerIndex, "Light punch")
  game.controls.bindAction(prefix + AttackButton.heavyPunch, ["play", "y"], "y", playerIndex, "Heavy punch")
  game.controls.bindAction(prefix + AttackButton.lightKick, "ok", "ok", playerIndex, "Light kick")
  game.controls.bindAction(prefix + AttackButton.heavyKick, ["fastforward", "b"], "b", playerIndex, "Heavy kick")
end sub

' The industrial layers have different heights; each is copied bottom-aligned onto a
' 272x160 bitmap so they share one scale and sit on the same horizon.
sub loadStageLayers(game as BGE.Game)
  files = {
    bgSky: "skill-desc_0003_bg.png",
    bgFar: "skill-desc_0002_far-buildings.png",
    bgBuildings: "skill-desc_0001_buildings.png",
    bgFront: "skill-desc_0000_foreground.png"
  }
  for each key in files
    source = CreateObject("roBitmap", "pkg:/sprites/stage/" + files[key])
    game.loadBitmap(key, {width: source.GetWidth(), height: 160, AlphaEnable: true})
    layer = game.getBitmap(key)
    layer.Clear(&h00000000)
    layer.DrawObject(0, 160 - source.GetHeight(), source)
  end for
end sub
