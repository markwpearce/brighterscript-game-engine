import "../Fight/Roster.bs"
import "../Fight/FighterAnimations.bs"

' Character portraits and select-screen bodies, from pkg:/sprites/fighters/portraits.webp and
' bodies.webp (written by scripts/build-sprites.js, one per character palette). main.bs
' loads the bitmaps as "portraits" and "bodies".
class PortraitSet
  private regions as roRegion[] = []
  private bodies as roRegion[] = []
  private firstIndex as roAssociativeArray = {}

  sub new(game as BGE.Game, atlas as FighterAtlas)
    bitmap = game.getBitmap("portraits")
    bodyBitmap = game.getBitmap("bodies")
    size = atlas.portraitSize
    total = 0
    for each characterId in atlas.characters
      layout = atlas.characters[characterId] as FighterAtlasLayout
      m.firstIndex[characterId] = layout.portraitIndex
      total += layout.paletteCount
    end for
    for i = 0 to total - 1
      x = (i mod atlas.portraitColumns) * size
      y = Int(i / atlas.portraitColumns) * size
      m.regions.push(CreateObject("roRegion", bitmap, x, y, size, size))
      bodyX = (i mod atlas.portraitColumns) * atlas.bodyWidth
      bodyY = Int(i / atlas.portraitColumns) * atlas.bodyHeight
      m.bodies.push(CreateObject("roRegion", bodyBitmap, bodyX, bodyY, atlas.bodyWidth, atlas.bodyHeight))
    end for
  end sub

  ' The portrait number for a pick.
  function indexOf(pick as FighterPick) as integer
    return m.firstIndex[pick.character] + pick.palette
  end function

  function region(index as integer) as roRegion
    return m.regions[index]
  end function

  ' A full-body stance frame (feet at the bottom centre), for the select screen.
  function body(index as integer) as roRegion
    return m.bodies[index]
  end function
end class
