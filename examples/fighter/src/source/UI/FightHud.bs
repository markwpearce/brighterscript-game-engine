import "pkg:/source/engine/ui/UiWidget.bs"
import "../Fight/MatchRules.bs"

const HUD_BAR_BACK_RGBA = &h301010FF
const HUD_BAR_FILL_RGBA = &hF0D030FF
const HUD_BAR_TRAIL_RGBA = &hD03020FF
const HUD_BAR_EDGE_RGBA = &hFFFFFFFF
const HUD_TEXT_RGBA = &hFFFFFFFF
const HUD_WIN_MARK_RGBA = &hF0D030FF
const HUD_EMPTY_MARK_RGBA = &h505050FF

' What the HUD shows; FightScene writes it every frame.
class HudState
  health as integer[] = [MAX_HEALTH, MAX_HEALTH]
  trail as integer[] = [MAX_HEALTH, MAX_HEALTH]
  wins as integer[] = [0, 0]
  secondsLeft as integer = ROUND_SECONDS
  announcement as string = ""
  p2Prompt as string = ""
end class

' Health bars (with a recent-damage trail), round timer, round-win markers and the big
' centre announcement. All inside the 10% title-safe margin.
class FightHud extends BGE.UI.UiWidget

  hudState as HudState

  sub new(game as BGE.Game, state as HudState)
    super(game)
    m.hudState = state
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    renderer = m.canvas.renderer
    canvasW = m.canvas.getWidth()
    canvasH = m.canvas.getHeight()
    safeX = Int(canvasW * 0.1)
    safeY = Int(canvasH * 0.1)
    centre = Int(canvasW / 2)
    timerGap = Int(canvasW * 0.05)
    barW = centre - timerGap - safeX
    barH = Int(canvasH * 0.035)
    font = m.game.getFont("hud")
    bigFont = m.game.getFont("announce")

    m.drawBar(renderer, safeX, safeY, barW, barH, 0, true)
    m.drawBar(renderer, centre + timerGap, safeY, barW, barH, 1, false)
    renderer.drawText(m.hudState.secondsLeft.toStr(), centre, safeY - 4, HUD_TEXT_RGBA, font, "center", "top")
    renderer.drawText("P1", safeX, safeY + barH + 4, HUD_TEXT_RGBA, font, "left", "top")
    renderer.drawText("P2", canvasW - safeX, safeY + barH + 4, HUD_TEXT_RGBA, font, "right", "top")

    ' Round-win markers, next to each player's label.
    markSize = Int(barH * 0.8)
    markY = safeY + barH + 8
    for i = 0 to ROUNDS_TO_WIN - 1
      p1Color = HUD_EMPTY_MARK_RGBA
      if m.hudState.wins[0] > i
        p1Color = HUD_WIN_MARK_RGBA
      end if
      renderer.drawRectangle(centre - timerGap - (i + 1) * (markSize + 6), markY, markSize, markSize, p1Color)
      p2Color = HUD_EMPTY_MARK_RGBA
      if m.hudState.wins[1] > i
        p2Color = HUD_WIN_MARK_RGBA
      end if
      renderer.drawRectangle(centre + timerGap + 6 + i * (markSize + 6), markY, markSize, markSize, p2Color)
    end for

    if m.hudState.announcement <> ""
      renderer.drawText(m.hudState.announcement, centre, Int(canvasH * 0.38), HUD_TEXT_RGBA, bigFont, "center", "top")
    end if
    if m.hudState.p2Prompt <> ""
      renderer.drawText(m.hudState.p2Prompt, canvasW - safeX, canvasH - safeY, HUD_TEXT_RGBA, font, "right", "bottom")
    end if
  end sub

  ' Health drains toward the outer edge, so both bars stay anchored at the timer.
  private sub drawBar(renderer as BGE.Renderer, x as integer, y as integer, w as integer, h as integer, playerIndex as integer, anchorRight as boolean)
    renderer.drawRectangle(x - 2, y - 2, w + 4, h + 4, HUD_BAR_EDGE_RGBA)
    renderer.drawRectangle(x, y, w, h, HUD_BAR_BACK_RGBA)
    trailW = Int(w * m.hudState.trail[playerIndex] / MAX_HEALTH)
    fillW = Int(w * m.hudState.health[playerIndex] / MAX_HEALTH)
    if anchorRight
      renderer.drawRectangle(x + w - trailW, y, trailW, h, HUD_BAR_TRAIL_RGBA)
      renderer.drawRectangle(x + w - fillW, y, fillW, h, HUD_BAR_FILL_RGBA)
    else
      renderer.drawRectangle(x, y, trailW, h, HUD_BAR_TRAIL_RGBA)
      renderer.drawRectangle(x, y, fillW, h, HUD_BAR_FILL_RGBA)
    end if
  end sub

end class
