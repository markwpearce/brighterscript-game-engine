' The UI atlas written by scripts/build-ui-art.js: pkg:/sprites/ui/ui.webp, with each
' piece's rectangle in ui.json. main.bs loads the bitmap as "ui".

interface UiRect
  x as integer
  y as integer
  w as integer
  h as integer
end interface

class UiArt
  private bitmap as roBitmap
  private rects as roAssociativeArray
  private regions as roAssociativeArray = {}

  sub new(game as BGE.Game)
    m.bitmap = game.getBitmap("ui")
    m.rects = ParseJson(ReadAsciiFile("pkg:/sprites/ui/ui.json"))
  end sub

  ' A region for one piece (cached).
  function region(name as string) as roRegion
    found = m.regions[name]
    if found = invalid
      rect = m.rects[name] as UiRect
      found = CreateObject("roRegion", m.bitmap, rect.x, rect.y, rect.w, rect.h)
      m.regions[name] = found
    end if
    return found
  end function

  ' Regions for numbered frames: prefix + "0", prefix + "1", ... while they exist.
  function frames(prefix as string) as roRegion[]
    result = [] as roRegion[]
    i = 0
    while m.rects.DoesExist(prefix + i.toStr())
      result.push(m.region(prefix + i.toStr()))
      i++
    end while
    return result
  end function

  function width(name as string) as integer
    rect = m.rects[name] as UiRect
    return rect.w
  end function

  function height(name as string) as integer
    rect = m.rects[name] as UiRect
    return rect.h
  end function

  ' Draws a piece centred on (x, y), scaled.
  sub drawCentered(renderer as BGE.Renderer, name as string, x as float, y as float, scale = 1.0 as float, rgba = -1 as integer)
    rect = m.rects[name] as UiRect
    renderer.drawRegion(m.region(name), x - rect.w * scale / 2, y - rect.h * scale / 2, scale, scale, 0, rgba)
  end sub
end class
