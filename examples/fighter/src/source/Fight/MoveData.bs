' Frame data for every attack, in 60 Hz ticks (the fight's fixed step, see FightClock).
' Boxes are relative to the fighter's feet while facing right, world +y up: x/y is the
' bottom-left corner.

' Which way a defender has to block an attack.
enum AttackHeight
  mid = "mid" ' standing or crouching block
  low = "low" ' crouching block only
  overhead = "overhead" ' standing block only (every air attack)
end enum

' What the fighter is doing when the button is pressed.
enum Stance
  stand = "stand"
  crouch = "crouch"
  air = "air"
end enum

' The four attack buttons.
enum AttackButton
  lightPunch = "lp"
  heavyPunch = "hp"
  lightKick = "lk"
  heavyKick = "hk"
end enum

interface FightBox
  x as float
  y as float
  w as float
  h as float
end interface

interface MoveDef
  id as string
  stance as string
  startup as integer ' ticks before the hitbox appears
  active as integer ' ticks the hitbox is out
  recovery as integer ' ticks after, before the fighter can act again
  damage as integer
  chipDamage as integer ' taken through a block
  hitstun as integer
  blockstun as integer
  knockback as float ' defender's push-away speed, px/tick, decays each tick
  hitPause as integer ' ticks both fighters freeze on contact
  height as string
  hitbox as FightBox
  ' Air moves stay out until landing instead of running their recovery.
  endsOnLanding as boolean
end interface

function newBox(x as float, y as float, w as float, h as float) as FightBox
  return {x: x, y: y, w: w, h: h}
end function

function newMove(id as string, moveStance as string, startup as integer, active as integer, recovery as integer, damage as integer, hitstun as integer, blockstun as integer, knockback as float, height as string, hitbox as FightBox) as MoveDef
  isHeavy = damage >= 80
  hitPause = 5
  if isHeavy
    hitPause = 9
  end if
  return {
    id: id,
    stance: moveStance,
    startup: startup,
    active: active,
    recovery: recovery,
    damage: damage,
    chipDamage: Int(damage / 8),
    hitstun: hitstun,
    blockstun: blockstun,
    knockback: knockback,
    hitPause: hitPause,
    height: height,
    hitbox: hitbox,
    endsOnLanding: moveStance = Stance.air
  }
end function

' Every move, keyed by moveKey(stance, button).
function getMoveTable() as roAssociativeArray
  if m.fighterMoveTable <> invalid
    return m.fighterMoveTable
  end if
  moves = [
    newMove("standLP", Stance.stand, 4, 3, 7, 40, 14, 10, 3.0, AttackHeight.mid, newBox(18, 62, 46, 14)),
    newMove("standHP", Stance.stand, 7, 4, 16, 100, 20, 16, 5.0, AttackHeight.mid, newBox(18, 58, 58, 18)),
    newMove("standLK", Stance.stand, 5, 4, 9, 50, 15, 11, 3.5, AttackHeight.mid, newBox(18, 28, 50, 18)),
    newMove("standHK", Stance.stand, 9, 5, 18, 120, 22, 17, 6.0, AttackHeight.mid, newBox(18, 44, 66, 20)),
    newMove("crouchLP", Stance.crouch, 4, 3, 7, 35, 13, 9, 3.0, AttackHeight.mid, newBox(18, 34, 44, 14)),
    newMove("crouchHP", Stance.crouch, 7, 4, 18, 90, 20, 15, 4.5, AttackHeight.mid, newBox(10, 40, 40, 50)),
    newMove("crouchLK", Stance.crouch, 5, 3, 9, 35, 13, 9, 3.0, AttackHeight.low, newBox(18, 0, 52, 14)),
    newMove("crouchHK", Stance.crouch, 8, 5, 22, 100, 22, 16, 6.5, AttackHeight.low, newBox(18, 0, 70, 16)),
    newMove("airLP", Stance.air, 4, 8, 3, 45, 14, 10, 3.0, AttackHeight.overhead, newBox(14, 40, 40, 16)),
    newMove("airHP", Stance.air, 6, 6, 3, 90, 18, 14, 4.5, AttackHeight.overhead, newBox(14, 30, 50, 22)),
    newMove("airLK", Stance.air, 4, 10, 3, 50, 14, 10, 3.0, AttackHeight.overhead, newBox(10, 10, 46, 20)),
    newMove("airHK", Stance.air, 7, 7, 3, 100, 18, 14, 5.0, AttackHeight.overhead, newBox(10, 14, 60, 22))
  ] as MoveDef[]
  table = {}
  for each move in moves
    table[moveKey(move.stance, LCase(move.id.right(2)))] = move
  end for
  m.fighterMoveTable = table
  return table
end function

function moveKey(stanceName as string, button as string) as string
  return stanceName + ":" + button
end function

' @return {MoveDef} the move for a button in this stance, or invalid
function findMove(stanceName as string, button as string) as dynamic
  return getMoveTable()[moveKey(stanceName, button)]
end function
