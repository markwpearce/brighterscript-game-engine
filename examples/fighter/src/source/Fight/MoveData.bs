' Frame data for every attack, in 60 Hz ticks (the fight's fixed step, see FightClock).
' Boxes are relative to the fighter's feet while facing right, world +y up: x/y is the
' bottom-left corner.

' Which way a defender has to block an attack.
enum AttackHeight
  mid = "mid" ' standing or crouching block
  low = "low" ' crouching block only
  overhead = "overhead" ' standing block only (every air attack)
end enum

' What the fighter is doing when the button is pressed.
enum Stance
  stand = "stand"
  crouch = "crouch"
  air = "air"
end enum

' The four attack buttons.
enum AttackButton
  lightPunch = "lp"
  heavyPunch = "hp"
  lightKick = "lk"
  heavyKick = "hk"
end enum

enum MoveKind
  normal = "normal"
  special = "special"
  throw = "throw"
end enum

interface FightBox
  x as float
  y as float
  w as float
  h as float
end interface

interface MoveDef
  id as string
  kind as string
  stance as string
  startup as integer ' ticks before the hitbox appears
  active as integer ' ticks the hitbox is out
  recovery as integer ' ticks after, before the fighter can act again
  damage as integer
  chipDamage as integer ' taken through a block
  hitstun as integer
  blockstun as integer
  knockback as float ' defender's push-away speed, px/tick, decays each tick
  hitPause as integer ' ticks both fighters freeze on contact
  height as string
  hitbox as FightBox
  ' Air moves stay out until landing instead of running their recovery.
  endsOnLanding as boolean
  ' Knocks the defender down on hit.
  knockdown as boolean
  ' Fires a projectile on its first active tick instead of using its own hitbox.
  projectile as boolean
  ' Attacker's vertical speed (px/tick) when the active frames start, e.g. a rising uppercut.
  launchSpeed as float
  ' Attacker's forward speed (px/tick) during the active frames.
  advance as float
  ' Ticks from the start during which the attacker can't be hit.
  invulnerable as integer
end interface

function newBox(x as float, y as float, w as float, h as float) as FightBox
  return {x: x, y: y, w: w, h: h}
end function

function newMove(id as string, moveStance as string, startup as integer, active as integer, recovery as integer, damage as integer, hitstun as integer, blockstun as integer, knockback as float, height as string, hitbox as FightBox) as MoveDef
  isHeavy = damage >= 80
  hitPause = 5
  if isHeavy
    hitPause = 9
  end if
  return {
    id: id,
    kind: MoveKind.normal,
    stance: moveStance,
    startup: startup,
    active: active,
    recovery: recovery,
    damage: damage,
    chipDamage: Int(damage / 8),
    hitstun: hitstun,
    blockstun: blockstun,
    knockback: knockback,
    hitPause: hitPause,
    height: height,
    hitbox: hitbox,
    endsOnLanding: moveStance = Stance.air,
    knockdown: false,
    projectile: false,
    launchSpeed: 0.0,
    advance: 0.0,
    invulnerable: 0
  }
end function

' Copies `extras` over a move's fields (knockdown, launchSpeed, ...).
function withExtras(move as MoveDef, extras as roAssociativeArray) as MoveDef
  for each key in extras
    move[key] = extras[key]
  end for
  return move
end function

' Every normal move, keyed by moveKey(stance, button).
function getMoveTable() as roAssociativeArray
  if m.fighterMoveTable <> invalid
    return m.fighterMoveTable
  end if
  moves = [
    newMove("standLP", Stance.stand, 4, 3, 7, 40, 14, 10, 3.0, AttackHeight.mid, newBox(18, 62, 46, 14)),
    newMove("standHP", Stance.stand, 7, 4, 16, 100, 20, 16, 5.0, AttackHeight.mid, newBox(18, 58, 58, 18)),
    newMove("standLK", Stance.stand, 5, 4, 9, 50, 15, 11, 3.5, AttackHeight.mid, newBox(18, 28, 50, 18)),
    newMove("standHK", Stance.stand, 9, 5, 18, 120, 22, 17, 6.0, AttackHeight.mid, newBox(18, 44, 66, 20)),
    newMove("crouchLP", Stance.crouch, 4, 3, 7, 35, 13, 9, 3.0, AttackHeight.mid, newBox(18, 34, 44, 14)),
    newMove("crouchHP", Stance.crouch, 7, 4, 18, 90, 20, 15, 4.5, AttackHeight.mid, newBox(10, 40, 40, 50)),
    newMove("crouchLK", Stance.crouch, 5, 3, 9, 35, 13, 9, 3.0, AttackHeight.low, newBox(18, 0, 52, 14)),
    withExtras(newMove("crouchHK", Stance.crouch, 8, 5, 22, 100, 22, 16, 3.0, AttackHeight.low, newBox(18, 0, 70, 16)), {knockdown: true}),
    newMove("airLP", Stance.air, 4, 8, 3, 45, 14, 10, 3.0, AttackHeight.overhead, newBox(14, 40, 40, 16)),
    newMove("airHP", Stance.air, 6, 6, 3, 90, 18, 14, 4.5, AttackHeight.overhead, newBox(14, 30, 50, 22)),
    newMove("airLK", Stance.air, 4, 10, 3, 50, 14, 10, 3.0, AttackHeight.overhead, newBox(10, 10, 46, 20)),
    newMove("airHK", Stance.air, 7, 7, 3, 100, 18, 14, 5.0, AttackHeight.overhead, newBox(10, 14, 60, 22))
  ] as MoveDef[]
  table = {}
  for each move in moves
    table[moveKey(move.stance, LCase(move.id.right(2)))] = move
  end for
  m.fighterMoveTable = table
  return table
end function

function moveKey(stanceName as string, button as string) as string
  return stanceName + ":" + button
end function

' @return {MoveDef} the move for a button in this stance, or invalid
function findMove(stanceName as string, button as string) as dynamic
  return getMoveTable()[moveKey(stanceName, button)]
end function

' Special moves and the throw, keyed by id. Each character uses three (CharacterDef.specials).
function getSpecialMoves() as roAssociativeArray
  if m.fighterSpecialMoves <> invalid
    return m.fighterSpecialMoves
  end if
  fireball = withExtras(newMove("fireball", Stance.stand, 12, 2, 28, 90, 20, 16, 4.0, AttackHeight.mid, newBox(0, 0, 0, 0)), {kind: MoveKind.special, projectile: true, chipDamage: 20})
  uppercut = withExtras(newMove("uppercut", Stance.stand, 3, 10, 26, 130, 24, 18, 3.0, AttackHeight.mid, newBox(6, 50, 40, 60)), {kind: MoveKind.special, knockdown: true, launchSpeed: 9.0, advance: 1.2, invulnerable: 8, endsOnLanding: true})
  cartwheel = withExtras(newMove("cartwheel", Stance.stand, 8, 16, 14, 110, 20, 14, 5.0, AttackHeight.mid, newBox(4, 20, 50, 60)), {kind: MoveKind.special, knockdown: true, advance: 3.4})
  throwMove = withExtras(newMove("throw", Stance.stand, 2, 2, 0, 140, 0, 0, 0.0, AttackHeight.mid, newBox(10, 30, 40, 40)), {kind: MoveKind.throw, knockdown: true, hitPause: 0})
  ' Bruno: a shoulder charge, an overhead hammer fist, a slide. Nova: a flip kick, a slide.
  charge = withExtras(newMove("charge", Stance.stand, 10, 12, 18, 120, 22, 16, 6.0, AttackHeight.mid, newBox(4, 30, 46, 50)), {kind: MoveKind.special, knockdown: true, advance: 4.6})
  hammer = withExtras(newMove("hammer", Stance.stand, 14, 5, 22, 150, 30, 20, 3.0, AttackHeight.overhead, newBox(14, 40, 48, 70)), {kind: MoveKind.special, hitPause: 12})
  slide = withExtras(newMove("slide", Stance.stand, 6, 14, 16, 90, 20, 14, 3.0, AttackHeight.low, newBox(6, 0, 62, 24)), {kind: MoveKind.special, knockdown: true, advance: 4.0})
  flipKick = withExtras(newMove("flipKick", Stance.stand, 3, 12, 20, 120, 22, 16, 3.0, AttackHeight.mid, newBox(0, 40, 46, 70)), {kind: MoveKind.special, knockdown: true, launchSpeed: 8.5, advance: 1.5, invulnerable: 8, endsOnLanding: true})
  m.fighterSpecialMoves = {fireball: fireball, uppercut: uppercut, cartwheel: cartwheel, throwMove: throwMove, charge: charge, hammer: hammer, slide: slide, flipKick: flipKick}
  return m.fighterSpecialMoves
end function

' Throws reach this far between the fighters' centres.
const THROW_RANGE = 50.0
' Ticks the throw animation runs; the victim is released (and damaged) at THROW_RELEASE_TICK.
const THROW_TICKS = 33
const THROW_RELEASE_TICK = 18
