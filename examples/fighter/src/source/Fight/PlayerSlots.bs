import "MoveData.bs"

' Which controller plays P1 and P2. The engine gives every remote, gamepad and phone its own
' player index in the order they're first used, so a gamepad picked up after the remote is
' index 1 - P2. This maps the two fighters' controls ("p0..." and "p1..." actions) to whichever
' indexes claimed them: on the Controllers screen, or by pressing first on the select screen.
class PlayerSlots
  ' The engine player index each slot's controls are bound to.
  devices as integer[] = [0, 1]
  ' Whether a controller has claimed the slot (else it's still the default).
  claimed as boolean[] = [false, false]
  private game as BGE.Game

  sub new(game as BGE.Game)
    m.game = game
    m.bind(0)
    m.bind(1)
  end sub

  ' Gives slot 0 or 1 to the controller with this player index. If the other slot had that
  ' controller, they swap.
  sub claim(slot as integer, device as integer)
    other = 1 - slot
    if m.devices[other] = device
      m.devices[other] = m.devices[slot]
      m.claimed[other] = false
      m.bind(other)
    end if
    m.devices[slot] = device
    m.claimed[slot] = true
    m.bind(slot)
    ' The press that claimed it shouldn't also count as an action.
    m.game.controls.blockHeldActions()
  end sub

  ' Forgets who's who (the Controllers screen starts over).
  sub reset()
    m.devices = [0, 1]
    m.claimed = [false, false]
    m.bind(0)
    m.bind(1)
  end sub

  ' The slot this controller plays, or -1.
  function slotOf(device as integer) as integer
    for slot = 0 to 1
      if m.devices[slot] = device
        return slot
      end if
    end for
    return -1
  end function

  ' Gamepad: X/Y punch, A/B kick (light/heavy). Remote: Rewind/Play punch, OK/Fast-forward
  ' kick. Phone/browser controller page: x/y/ok/b.
  private sub bind(slot as integer)
    prefix = "p" + slot.toStr()
    device = m.devices[slot]
    controls = m.game.controls
    controls.bindAxis(prefix + "move", "1", device, "Move")
    controls.bindAction(prefix + AttackButton.lightPunch, ["rewind", "x"], "x", device, "Light punch")
    controls.bindAction(prefix + AttackButton.heavyPunch, ["play", "y"], "y", device, "Heavy punch")
    controls.bindAction(prefix + AttackButton.lightKick, "ok", "ok", device, "Light kick")
    controls.bindAction(prefix + AttackButton.heavyKick, ["fastforward", "b"], "b", device, "Heavy kick")
  end sub
end class
