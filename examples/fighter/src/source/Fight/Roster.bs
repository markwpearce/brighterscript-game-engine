import "MoveData.bs"

' The selectable fighters. Each has a few colour palettes (atlases written by
' scripts/build-sprites.js), picked on the select screen with up/down.

interface CharacterDef
  id as string ' atlas file prefix: pkg:/sprites/fighters/<id>-<palette>.webp
  name as string
  nameArt as string ' ui atlas piece with the name
  projectileArt as string ' ui atlas piece prefix: <prefix>0..3
  walkSpeed as float ' multiplies the base walk speeds
  damageScale as float ' multiplies the damage this fighter deals
  palettes as integer ' how many colour palettes
  ' The special move (a getSpecialMoves() id) for each motion: qcf (quarter circle forward
  ' + punch), dp (dragon punch + punch) and qcb (quarter circle back + kick).
  specials as roAssociativeArray
end interface

' Who's fighting: a character and a palette.
interface FighterPick
  character as string
  palette as integer
end interface

' Built once: the select screen asks for it many times a frame.
function getRoster() as CharacterDef[]
  if m.fighterRoster <> invalid
    return m.fighterRoster
  end if
  m.fighterRoster = [
    {id: "blaze", name: "Blaze", nameArt: "nameBlaze", projectileArt: "fire", walkSpeed: 1.0, damageScale: 1.08, palettes: 2, specials: {qcf: "fireball", dp: "uppercut", qcb: "cartwheel"}},
    {id: "frost", name: "Frost", nameArt: "nameFrost", projectileArt: "ice", walkSpeed: 1.12, damageScale: 0.95, palettes: 2, specials: {qcf: "fireball", dp: "uppercut", qcb: "cartwheel"}},
    {id: "bruno", name: "Bruno", nameArt: "nameBruno", projectileArt: "fire", walkSpeed: 0.85, damageScale: 1.2, palettes: 2, specials: {qcf: "charge", dp: "hammer", qcb: "slide"}},
    {id: "nova", name: "Nova", nameArt: "nameNova", projectileArt: "wind", walkSpeed: 1.2, damageScale: 0.9, palettes: 2, specials: {qcf: "fireball", dp: "flipKick", qcb: "slide"}}
  ] as CharacterDef[]
  return m.fighterRoster
end function

' @return {CharacterDef} the character with this id (the first one if it's unknown)
function findCharacter(id as string) as CharacterDef
  roster = getRoster()
  for each character in roster
    if character.id = id
      return character
    end if
  end for
  return roster[0]
end function

function newPick(characterId as string, palette as integer) as FighterPick
  return {character: characterId, palette: palette}
end function

' P2's palette when both players pick the same character and colour: the next one along.
function resolvePaletteClash(p1 as FighterPick, p2 as FighterPick) as integer
  if p1.character = p2.character and p1.palette = p2.palette
    return (p2.palette + 1) mod findCharacter(p2.character).palettes
  end if
  return p2.palette
end function

' Parses a launch param like "frost:2" into a pick (text may be invalid: the param wasn't given).
function parsePick(text as dynamic, fallback as FighterPick) as FighterPick
  if text = invalid or text = ""
    return fallback
  end if
  parts = text.split(":")
  character = findCharacter(parts[0])
  palette = 0
  if parts.count() > 1
    palette = parts[1].toInt() mod character.palettes
  end if
  return newPick(character.id, palette)
end function

function fighterBitmapName(pick as FighterPick) as string
  return "fighter_" + pick.character + "_" + pick.palette.toStr()
end function

function fighterBitmapPath(pick as FighterPick) as string
  return "pkg:/sprites/fighters/" + pick.character + "-" + pick.palette.toStr() + ".webp"
end function
