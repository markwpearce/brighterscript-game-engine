import "MoveData.bs"

' Pure fight rules: no entities or engine state, so tests/ can cover them directly.

enum MovePhase
  startup = "startup"
  active = "active"
  recovery = "recovery"
  done = "done"
end enum

' Which part of a move a fighter is in, `frame` ticks after it started (0-based).
function movePhaseAt(move as MoveDef, frame as integer) as string
  if frame < move.startup
    return MovePhase.startup
  end if
  if frame < move.startup + move.active
    return MovePhase.active
  end if
  if move.endsOnLanding
    ' Air moves keep their recovery pose until landing.
    return MovePhase.recovery
  end if
  if frame < move.startup + move.active + move.recovery
    return MovePhase.recovery
  end if
  return MovePhase.done
end function

' Whether a guard in this stance stops an attack of this height.
function canBlockHeight(height as string, crouching as boolean) as boolean
  if height = AttackHeight.low
    return crouching
  end if
  if height = AttackHeight.overhead
    return not crouching
  end if
  return true
end function

' Holding away from the opponent guards. `moveX` is the stick's x (-1..1), `facing` the
' defender's facing (+1 right, -1 left).
function isHoldingBack(moveX as float, facing as integer) as boolean
  return moveX * facing < -0.5
end function

' +1 if a fighter at `x` should face right toward `otherX`, else -1. Keeps `current` when
' they're level, so crossing straight over doesn't flicker.
function facingToward(x as float, otherX as float, current as integer) as integer
  if otherX > x + 1
    return 1
  else if otherX < x - 1
    return -1
  end if
  return current
end function

' A hitbox or hurtbox in world space, mirrored when facing left.
function worldBox(area as FightBox, x as float, y as float, facing as integer) as FightBox
  if facing >= 0
    return newBox(x + area.x, y + area.y, area.w, area.h)
  end if
  return newBox(x - area.x - area.w, y + area.y, area.w, area.h)
end function

' True if two boxes overlap by more than an edge.
function boxesOverlap(a as FightBox, b as FightBox) as boolean
  return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end function

' How far to move each of two fighters (centres x1 < x2 not required) so their
' pushboxes of width `width` stop overlapping. Split evenly.
' @return {float} the shift for the left fighter (negative); the right one moves by its negation
function pushApartShift(x1 as float, x2 as float, width as float) as float
  overlap = width - Abs(x2 - x1)
  if overlap <= 0
    return 0.0
  end if
  return -overlap / 2.0
end function

' Clamps a fighter's centre into the stage, given its half width.
function clampToStage(x as float, halfWidth as float, stageLeft as float, stageRight as float) as float
  if x < stageLeft + halfWidth
    return stageLeft + halfWidth
  end if
  if x > stageRight - halfWidth
    return stageRight - halfWidth
  end if
  return x
end function

' Health after a hit (or a blocked hit's chip damage). Chip damage never KOs.
function healthAfterHit(health as integer, move as MoveDef, blocked as boolean) as integer
  if blocked
    if health - move.chipDamage < 1
      return 1
    end if
    return health - move.chipDamage
  end if
  if health - move.damage < 0
    return 0
  end if
  return health - move.damage
end function

' Knockback speed after one tick of decay.
function decayKnockback(speed as float) as float
  decayed = speed * 0.8
  if Abs(decayed) < 0.1
    return 0.0
  end if
  return decayed
end function
