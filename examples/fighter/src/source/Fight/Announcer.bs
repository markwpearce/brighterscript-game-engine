' Voice lines and other sounds that mustn't be cut off by the hit sounds: they play on sound
' channel 1 (game.playSound()'s channel), while hits and whooshes use channel 0.
const VOICE_CHANNEL = 1
' How long a voice line is assumed to last, so a grunt doesn't cut it off.
const VOICE_SECONDS = 1.3

interface QueuedVoice
  sound as string
  at as float
end interface

class Announcer
  private game as BGE.Game
  private now as float = 0.0
  private busyUntil as float = 0.0
  private queue as QueuedVoice[] = []

  sub new(game as BGE.Game)
    m.game = game
  end sub

  ' Says a line now, or `delaySeconds` from now. A line said now drops any that are waiting.
  sub say(sound as string, delaySeconds = 0.0 as float)
    if delaySeconds <= 0
      m.queue = []
      m.play(sound)
      return
    end if
    m.queue.push({sound: sound, at: m.now + delaySeconds})
  end sub

  ' A sting (KO boom etc.) on the voice channel.
  sub sting(sound as string)
    m.queue = []
    m.play(sound)
  end sub

  ' A pain grunt, unless a line is being said.
  sub grunt(sound as string)
    if m.now >= m.busyUntil
      m.game.playSound(sound, 90, VOICE_CHANNEL)
      m.busyUntil = m.now + 0.5
    end if
  end sub

  sub update(deltaTime as float)
    m.now += deltaTime
    if m.queue.count() > 0 and m.now >= m.queue[0].at
      m.play(m.queue.shift().sound)
    end if
  end sub

  private sub play(sound as string)
    m.game.playSound(sound, 100, VOICE_CHANNEL)
    m.busyUntil = m.now + VOICE_SECONDS
  end sub
end class
