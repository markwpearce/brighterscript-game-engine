class MainRoom extends BGE.Room

  bound = 200.0

  ' addSphere's color is a Drawable color (packed RGB, BGE.ColorsRGB) - not the packed
  ' RGBA BGE.Colors used by Renderer.draw* calls. Lime rather than the (very dark) Green
  ' entry keeps every sphere clearly visible against the black background.
  colors = [BGE.ColorsRGB.Red, BGE.ColorsRGB.Lime, BGE.ColorsRGB.Blue, BGE.ColorsRGB.Yellow, BGE.ColorsRGB.Cyan, BGE.ColorsRGB.Magenta, BGE.ColorsRGB.White]

  ' How many spheres have been spawned so far - used to cycle m.colors and to seed each
  ' new sphere's starting position/velocity so OK-spawned spheres don't all land in the
  ' same spot.
  sphereCount = 0

  debugEnabled = false

  cameraSpeed = 300.0
  cameraVelocity = 0.0
  cameraRotation = 0.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' Off-axis (not dead-center on any wall) so the box actually reads as a box - a
    ' straight-on view down one axis puts the side/floor walls almost perfectly edge-on.
    m.game.canvas.renderer.camera.position = BGE.Math.VectorOps.create(300, 250, -550)
    m.game.canvas.renderer.camera.setTarget(BGE.Math.VectorOps.create(0, 0, 0))

    m.spawnWalls()

    positions = [
      BGE.Math.VectorOps.create(-100, 0, 0),
      BGE.Math.VectorOps.create(100, 50, -50),
      BGE.Math.VectorOps.create(0, -50, 100),
      BGE.Math.VectorOps.create(80, -30, -80),
      BGE.Math.VectorOps.create(-80, 60, 60)
    ]
    velocities = [
      BGE.Math.VectorOps.create(60, 40, 50),
      BGE.Math.VectorOps.create(-50, 55, -45),
      BGE.Math.VectorOps.create(45, -60, 55),
      BGE.Math.VectorOps.create(-55, -45, -50),
      BGE.Math.VectorOps.create(50, 50, -60)
    ]

    for i = 0 to 4
      m.spawnSphere(positions[i], velocities[i])
    end for
  end sub

  ' Spawns all 6 walls of the bouncing box as their own Wall entity (see Wall.bs). The
  ' near-camera face gets a collider but no image (hasImage: false), so the camera can
  ' see inside while spheres still bounce off it instead of flying out toward the camera.
  private sub spawnWalls()
    size = m.bound * 2.0
    thickness = 10.0
    halfPi = BGE.Math.HALF_PI

    faces = [
      {center: BGE.Math.VectorOps.create(0, 0, m.bound), rotation: BGE.Math.VectorOps.create(0, BGE.Math.PI, 0), size: size, colliderWidth: size, colliderHeight: size, colliderDepth: thickness},
      {center: BGE.Math.VectorOps.create(0, 0, -m.bound), rotation: BGE.Math.VectorOps.create(0, 0, 0), size: size, colliderWidth: size, colliderHeight: size, colliderDepth: thickness, hasImage: false},
      {center: BGE.Math.VectorOps.create(m.bound, 0, 0), rotation: BGE.Math.VectorOps.create(0, -halfPi, 0), size: size, colliderWidth: thickness, colliderHeight: size, colliderDepth: size},
      {center: BGE.Math.VectorOps.create(-m.bound, 0, 0), rotation: BGE.Math.VectorOps.create(0, halfPi, 0), size: size, colliderWidth: thickness, colliderHeight: size, colliderDepth: size},
      {center: BGE.Math.VectorOps.create(0, m.bound, 0), rotation: BGE.Math.VectorOps.create(halfPi, 0, 0), size: size, colliderWidth: size, colliderHeight: thickness, colliderDepth: size},
      {center: BGE.Math.VectorOps.create(0, -m.bound, 0), rotation: BGE.Math.VectorOps.create(-halfPi, 0, 0), size: size, colliderWidth: size, colliderHeight: thickness, colliderDepth: size}
    ]
    for each face in faces
      m.game.addEntity(new Wall(m.game), face)
    end for
  end sub

  ' Spawns one more sphere at a pseudo-random position/velocity within the bouncing
  ' cube, cycling through m.colors. Used both for the initial 5 spheres (given fixed
  ' positions/velocities, for a repeatable starting layout) and for each OK press
  ' (given randomized ones, so added spheres don't all overlap).
  private sub spawnSphere(position as BGE.Math.Vector, velocity as BGE.Math.Vector)
    color = m.colors[m.sphereCount mod m.colors.count()]
    m.game.addEntity(new Sphere(m.game), {
      radius: 25.0,
      position: position,
      velocity: velocity,
      color: color
    })
    m.sphereCount++
  end sub

  private function randomPosition() as BGE.Math.Vector
    range = m.bound - 25.0
    return BGE.Math.VectorOps.create((Rnd(0) * 2.0 - 1.0) * range, (Rnd(0) * 2.0 - 1.0) * range, (Rnd(0) * 2.0 - 1.0) * range)
  end function

  private function randomVelocity() as BGE.Math.Vector
    speed = 60.0
    return BGE.Math.VectorOps.create((Rnd(0) * 2.0 - 1.0) * speed, (Rnd(0) * 2.0 - 1.0) * speed, (Rnd(0) * 2.0 - 1.0) * speed)
  end function

  override sub onUpdate(deltaTime as float)
    camera = m.game.canvas.renderer.camera
    if m.cameraRotation <> 0
      camera.rotate(BGE.Math.VectorOps.create(0, m.cameraRotation * deltaTime, 0))
    end if
    if m.cameraVelocity <> 0
      BGE.Math.VectorOps.plusEquals(camera.position, BGE.Math.VectorOps.scale(camera.orientation, m.cameraSpeed * deltaTime * m.cameraVelocity))
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    else if input.press and input.isButton("ok")
      m.spawnSphere(m.randomPosition(), m.randomVelocity())
    else if input.press and input.isButton("options")
      m.debugEnabled = not m.debugEnabled
      m.game.debugShowUi(m.debugEnabled)
      m.game.debugDrawColliders(m.debugEnabled)
      m.game.debugDrawEntityDetails(m.debugEnabled)
    end if

    ' Up/down drive forward/back along the camera's current facing, left/right yaw it -
    ' same input.x/input.y-driven scheme as examples/3d's BaseRoom.
    m.cameraVelocity = 0.0
    m.cameraRotation = 0.0
    if input.x <> 0 or input.y <> 0
      m.cameraVelocity = input.y
      m.cameraRotation = input.x
    end if
  end sub

end class
