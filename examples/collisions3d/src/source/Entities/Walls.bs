' A static, textured 5-sided box (no near-camera face, so the camera can see inside) -
' purely visual, showing what the bouncing spheres are actually bouncing off. Each face
' is a BGE.Image built in the wall.png bitmap's own 512x512 pixel space, then the whole
' entity is scaled so every face lands exactly on the bounce boundary (args.bound) - the
' same "build in natural units, scale the entity" trick examples/3d's ImageCube uses.
class Walls extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "Walls"
  end sub

  override sub onCreate(args as roAssociativeArray)
    bound = args.bound
    halfPi = BGE.Math.HALF_PI
    textureSize = 512.0
    half = textureSize / 2.0

    m.scale = BGE.Math.createScaleVector((bound * 2.0) / textureSize)

    bitmap = m.game.getBitmap("wall")
    region = CreateObject("roRegion", bitmap, 0, 0, bitmap.getWidth(), bitmap.getHeight())

    ' Each face's rotation turns its default (unrotated) normal - which points +z, away
    ' from the box's center - to instead point back toward the center, so the inside
    ' surface (the one the camera and spheres actually see) is the one facing outward
    ' from this un-rotated-quad convention. Confirmed empirically on-device: an unrotated
    ' face at the +z offset was invisible (its normal pointed away from the camera) until
    ' rotated by Pi.
    '
    ' The near-camera face (facing the camera at -z, looking toward +z) is deliberately
    ' omitted, so the camera can see the spheres bouncing around inside the box.
    m.addImage("back", region, {offset: BGE.Math.VectorOps.create(0, 0, half), rotation: BGE.Math.VectorOps.create(0, BGE.Math.PI, 0), isShaded: true})
    m.addImage("right", region, {offset: BGE.Math.VectorOps.create(half, 0, 0), rotation: BGE.Math.VectorOps.create(0, -halfPi, 0), isShaded: true})
    m.addImage("left", region, {offset: BGE.Math.VectorOps.create(-half, 0, 0), rotation: BGE.Math.VectorOps.create(0, halfPi, 0), isShaded: true})
    m.addImage("top", region, {offset: BGE.Math.VectorOps.create(0, half, 0), rotation: BGE.Math.VectorOps.create(halfPi, 0, 0), isShaded: true})
    m.addImage("bottom", region, {offset: BGE.Math.VectorOps.create(0, -half, 0), rotation: BGE.Math.VectorOps.create(-halfPi, 0, 0), isShaded: true})

    for each drawableName in ["back", "right", "left", "top", "bottom"]
      m.getDrawable(drawableName).setAnchor(0.5, 0.5)
    end for
  end sub

end class
