' One face of the bouncing box: a real BGE.BoxCollider3d slab spheres actually collide
' against (not a position threshold), plus a textured BGE.Image - except the near-camera
' face, which needs the collider but deliberately skips the image so the camera can see
' inside the box (args.hasImage = false).
'
' Args: center (Vector), rotation (Vector) - the image's local pre-rotation plane is
' always a `size` x `size` square, rotated to whichever world axis it ends up facing;
' colliderWidth/colliderHeight/colliderDepth are the collider's real WORLD-axis-aligned
' extents (x/y/z), which differ per face (a side wall is thin on x, full-size on y/z) -
' these are two different coordinate systems, not the same numbers.
class Wall extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "Wall"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position = args.center

    if args.hasImage <> false
      textureSize = 512.0
      m.scale = BGE.Math.createScaleVector(args.size / textureSize)

      bitmap = m.game.getBitmap("wall")
      region = CreateObject("roRegion", bitmap, 0, 0, bitmap.getWidth(), bitmap.getHeight())
      ' orientedDrawBackFace: the camera is inside this box looking at each face's inner
      ' surface, which is the back face of the quad's default winding - the default
      ' `oriented` mode backface-culls that side (see SceneObjectBillboard.doNotDrawBecauseBackFace()).
      image = m.addImage("visual", region, {rotation: args.rotation, isShaded: true, drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace})
      image.setAnchor(0.5, 0.5)
    end if

    m.addBoxCollider3d("body", args.colliderWidth, args.colliderHeight, args.colliderDepth)
  end sub

end class
