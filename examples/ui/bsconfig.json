{
    "extends": "../../bsconfig.build.json",
    "rootDir": "src",
    "outDir": "build",
    "files": [
        "**/*",
        {
            "src": "../../../src/source/**/*",
            "dest": "source"
        },
        {
            "src": "../../../src/components/**/*",
            "dest": "components"
        },
        "!../../../src/**/*.spec.bs"
    ],
    "emitDefinitions": false,
    "diagnosticFilters": [
        {
            "files": "../../../src/**/*"
        }
    ]
}
