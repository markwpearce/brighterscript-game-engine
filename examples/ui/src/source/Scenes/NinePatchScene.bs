' Demonstrates BGE.UI.NinePatchImage / loadNinePatchImage(): a small 24x24
' Android-style .9.png (examples/ui/src/images/panel.9.png) backs the theme's
' widget background instead of a flat color, and Buttons at several different
' sizes show its corners staying crisp/unstretched while the edges/center
' stretch to fill each button's own size.
class NinePatchScene extends BGE.GameScene

  private ninePatch as BGE.UI.NinePatchImage

  ' The 9-patch image is loaded once in main.bs and handed in here, rather than
  ' being reloaded from disk every time this scene is entered.
  sub new(game as BGE.Game, ninePatch as BGE.UI.NinePatchImage)
    super(game)
    m.name = "NinePatchScene"
    m.ninePatch = ninePatch
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' Opts every themed widget's background fill into the 9-patch image
    ' instead of a flat color - see Theme.backgroundImage's doc comment.
    m.game.defaultTheme.backgroundImage = m.ninePatch

    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    hint = new BGE.UI.Label(m.game)
    hint.setText("A 9-patch background stretches to fit each button below")
    hint.customPosition = true
    hint.customX = width * 0.11
    hint.customY = height * 0.14
    m.addUi(hint)

    m.addSizedButton("Small", 0.11, 0.3, 0.18, 0.07)
    m.addSizedButton("Medium", 0.11, 0.45, 0.36, 0.1)
    m.addSizedButton("Large", 0.11, 0.63, 0.6, 0.15)

    ' Focuses the first button immediately, rather than leaving every button
    ' unfocused until the player's first press - see FocusManager.ensureFocusSeeded().
    m.game.focusManager.ensureFocusSeeded()
  end sub

  private sub addSizedButton(label as string, xPct as float, yPct as float, widthPct as float, heightPct as float)
    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    button = new BGE.UI.Button(m.game)
    button.setLabel(label)
    button.customPosition = true
    button.customX = width * xPct
    button.customY = height * yPct
    button.width = width * widthPct
    button.height = height * heightPct
    m.addUi(button)
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      ' backgroundImage is global on defaultTheme (not scoped to this scene) -
      ' restore the flat-color default so MainScene's own buttons aren't left
      ' showing this scene's 9-patch background.
      m.game.defaultTheme.backgroundImage = invalid
      m.game.changeScene("MainScene")
    end if
  end sub

end class
