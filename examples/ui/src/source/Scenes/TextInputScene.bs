' Demonstrates BGE.UI.TextInput with a BGE.UI.Keyboard on-screen keyboard:
' OK on the field opens the keyboard, which types into it with only the
' remote. The Roku mobile app's keyboard works too. A Select switches the
' keyboard between alphabetical and QWERTY layouts, and a "Show Value"
' button reads the text back out via getValue().
class TextInputScene extends BGE.GameScene

  private textInput as BGE.UI.TextInput
  private valueLabel as BGE.UI.Label
  private keyboard as BGE.UI.Keyboard
  private layoutSelect as BGE.UI.Select
  private shownLayoutIndex as integer = 0

  sub new(game as BGE.Game)
    super(game)
    m.name = "TextInputScene"
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' gameUi is shared/persistent across scenes (unlike entities, it isn't
    ' torn down on scene change), so clear whatever the previous scene left in
    ' it before adding this scene's own widgets.
    m.game.gameUi.clearChildren()

    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    hint = new BGE.UI.Label(m.game)
    hint.setText("OK on the field opens the keyboard. Back cancels, Play is Done, Replay deletes." + Chr(10) + "The Roku mobile app's keyboard works too.")
    hint.customPosition = true
    hint.customX = width * 0.11
    hint.customY = height * 0.1
    m.game.gameUi.addChild(hint)

    m.textInput = new BGE.UI.TextInput(m.game)
    m.textInput.placeholder = "Enter your name"
    ' TextInput doesn't clip or scroll, so cap the length to what fits.
    m.textInput.maxLength = 20
    m.textInput.customPosition = true
    m.textInput.customX = width * 0.11
    m.textInput.customY = height * 0.22
    m.textInput.width = width * 0.4
    m.textInput.height = height * 0.075
    m.game.gameUi.addChild(m.textInput)

    m.layoutSelect = new BGE.UI.Select(m.game)
    m.layoutSelect.style = BGE.UI.SelectStyle.horizontal
    m.layoutSelect.options = ["ABC", "QWERTY"]
    m.layoutSelect.customPosition = true
    m.layoutSelect.customX = width * 0.55
    m.layoutSelect.customY = height * 0.22
    m.layoutSelect.width = width * 0.34
    m.layoutSelect.height = height * 0.075
    m.game.gameUi.addChild(m.layoutSelect)

    showValueBtn = new ShowValueButton(m.game)
    showValueBtn.scene = m
    showValueBtn.setLabel("Show Value")
    showValueBtn.customPosition = true
    showValueBtn.customX = width * 0.11
    showValueBtn.customY = height * 0.33
    showValueBtn.width = width * 0.2
    showValueBtn.height = height * 0.075
    m.game.gameUi.addChild(showValueBtn)

    m.valueLabel = new BGE.UI.Label(m.game)
    m.valueLabel.setText("Value: ")
    m.valueLabel.customPosition = true
    m.valueLabel.customX = width * 0.34
    m.valueLabel.customY = height * 0.35
    m.game.gameUi.addChild(m.valueLabel)

    m.keyboard = new BGE.UI.Keyboard(m.game)
    m.keyboard.customPosition = true
    m.keyboard.customX = width * 0.11
    m.keyboard.customY = height * 0.47
    m.keyboard.height = height * 0.41
    m.applyLayout(0)
    m.textInput.keyboard = m.keyboard

    ' Focuses the text field immediately, rather than leaving it unfocused
    ' until the player's first press - see FocusManager.ensureFocusSeeded().
    m.game.focusManager.ensureFocusSeeded()
  end sub

  override sub onUpdate(deltaTime as float)
    if m.layoutSelect.selectedIndex <> m.shownLayoutIndex
      m.applyLayout(m.layoutSelect.selectedIndex)
    end if
  end sub

  ' Public - called from ShowValueButton.onClick().
  sub showValue()
    m.valueLabel.setText("Value: " + m.textInput.getValue())
  end sub

  override sub onInput(input as BGE.GameInput)
    ' an open keyboard consumes Back to cancel itself
    if input.press and input.isButton("back") and not input.consumed and not m.keyboard.isShown()
      m.game.changeScene("MainScene")
    end if
  end sub

  private sub applyLayout(index as integer)
    m.shownLayoutIndex = index
    width = m.game.uiCanvas.getWidth()
    if index = 1
      m.keyboard.layout = BGE.UI.createQwertyKeyboardLayout()
      m.keyboard.width = width * 0.78
    else
      m.keyboard.layout = BGE.UI.createAlphabeticalKeyboardLayout()
      m.keyboard.width = width * 0.5
    end if
  end sub

end class

' Routes OK-press-while-focused back to the owning scene's showValue() -
' a plain `sub(button as BGE.UI.Button)` closure assigned to onActivate
' can't reach back into this scene's own fields: `m` inside that closure
' rebinds to the Button itself (Button.activate() invokes it as
' m.onActivate(m)), and bsc's type-checker also rejects referencing an
' enclosing local var from inside a nested anonymous sub. Same reasoning
' as examples/audio's AudioRowSelect/AudioVolumeSlider, which subclass
' their widget for the same reason.
class ShowValueButton extends BGE.UI.Button
  scene as TextInputScene

  sub new(game as BGE.Game)
    super(game)
  end sub

  override sub onClick()
    m.scene.showValue()
  end sub
end class
