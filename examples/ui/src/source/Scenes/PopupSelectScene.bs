' Demonstrates BGE.UI.Select's three interaction styles: the default inline
' style (Left/Right cycles the option in place) on the left, the popup style
' (BGE.UI.SelectStyle.popup - OK expands a list, Up/Down move a highlight,
' OK commits, back cancels) on the right, and the horizontal style
' (BGE.UI.SelectStyle.horizontal - every option shown side-by-side in one
' row, Left/Right move directly between them, no wrap) spanning the bottom.
class PopupSelectScene extends BGE.GameScene

  private inlineSelect as BGE.UI.Select
  private popupSelect as BGE.UI.Select
  private horizontalSelect as BGE.UI.Select

  sub new(game as BGE.Game)
    super(game)
    m.name = "PopupSelectScene"
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' gameUi is shared/persistent across scenes (unlike entities, it isn't
    ' torn down on scene change), so clear whatever the previous scene left in
    ' it before adding this scene's own widgets.
    m.game.gameUi.clearChildren()

    width = m.game.canvas.getWidth()
    height = m.game.canvas.getHeight()

    hint = new BGE.UI.Label(m.game)
    hint.setText("Inline: Left/Right cycles. Popup: OK expands, Up/Down highlight, OK commits, Back cancels. Horizontal: Left/Right moves directly, no wrap")
    hint.customPosition = true
    hint.customX = width * 0.11
    hint.customY = height * 0.1
    m.game.gameUi.addChild(hint)

    inlineLabel = new BGE.UI.Label(m.game)
    inlineLabel.setText("Inline style:")
    inlineLabel.customPosition = true
    inlineLabel.customX = width * 0.11
    inlineLabel.customY = height * 0.2
    m.game.gameUi.addChild(inlineLabel)

    m.inlineSelect = new BGE.UI.Select(m.game)
    m.inlineSelect.options = ["Easy", "Normal", "Hard", "Expert", "Nightmare"]
    m.inlineSelect.customPosition = true
    m.inlineSelect.customX = width * 0.11
    m.inlineSelect.customY = height * 0.27
    m.inlineSelect.width = width * 0.27
    m.inlineSelect.height = height * 0.083
    m.game.gameUi.addChild(m.inlineSelect)

    popupLabel = new BGE.UI.Label(m.game)
    popupLabel.setText("Popup style:")
    popupLabel.customPosition = true
    popupLabel.customX = width * 0.62
    popupLabel.customY = height * 0.2
    m.game.gameUi.addChild(popupLabel)

    m.popupSelect = new BGE.UI.Select(m.game)
    m.popupSelect.style = BGE.UI.SelectStyle.popup
    ' Four options keeps the expanded list well clear of the horizontal
    ' select below: 0.27 + 0.083 * (4 + 1) = 0.685 of canvas height, leaving
    ' the 0.74/0.80 rows below untouched.
    m.popupSelect.options = ["Red", "Orange", "Yellow", "Green"]
    m.popupSelect.customPosition = true
    m.popupSelect.customX = width * 0.62
    m.popupSelect.customY = height * 0.27
    m.popupSelect.width = width * 0.27
    m.popupSelect.height = height * 0.083
    m.game.gameUi.addChild(m.popupSelect)

    horizontalLabel = new BGE.UI.Label(m.game)
    horizontalLabel.setText("Horizontal style:")
    horizontalLabel.customPosition = true
    horizontalLabel.customX = width * 0.11
    horizontalLabel.customY = height * 0.74
    m.game.gameUi.addChild(horizontalLabel)

    m.horizontalSelect = new BGE.UI.Select(m.game)
    m.horizontalSelect.style = BGE.UI.SelectStyle.horizontal
    m.horizontalSelect.options = ["Low", "Medium", "High"]
    m.horizontalSelect.customPosition = true
    m.horizontalSelect.customX = width * 0.11
    m.horizontalSelect.customY = height * 0.8
    ' Full title-safe width (0.11 to 0.89) - unlike inline/popup's fixed
    ' single-value box, a horizontal Select's row scales with option count,
    ' so it gets the widest slot in this demo.
    m.horizontalSelect.width = width * 0.78
    m.horizontalSelect.height = height * 0.083
    m.game.gameUi.addChild(m.horizontalSelect)

    ' Focuses the Select immediately, rather than leaving it unfocused until
    ' the player's first press - see FocusManager.ensureFocusSeeded().
    m.game.focusManager.ensureFocusSeeded()
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.changeScene("MainScene")
    end if
  end sub

end class
