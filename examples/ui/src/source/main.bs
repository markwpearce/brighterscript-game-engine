sub Main()
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.fitCanvasToScreen()

  ' Started once here, not in a scene's onCreate() - enableControllerInput()
  ' builds a new ControllerServer and rebinds its port each call, which logs a
  ' misleading "failed to listen" if a re-enterable scene calls it again.
  game.enableControllerInput()

  ' Loaded once here, not in NinePatchScene's onCreate() - each load allocates a
  ' fresh roBitmap plus 10 roRegions, so re-entering that scene would leak a new
  ' copy every visit. The image is immutable once sliced, so one instance is
  ' safely reused for the life of the app.
  ninePatch = BGE.UI.loadNinePatchImage("pkg:/images/panel.9.png")

  ' loadBackgroundImage() picks the plain-image path here since the filename
  ' doesn't end in ".9.png" - see ImageBackgroundScene. Same one-time-load
  ' reasoning as ninePatch above.
  imageBackground = BGE.UI.loadBackgroundImage("pkg:/images/plain-background.png")

  firstScene = new MainScene(game)
  game.defineScene(firstScene)
  game.defineScene(new AnalogCursorScene(game))
  patchScene = new NinePatchScene(game, ninePatch)
  game.defineScene(patchScene)
  game.defineScene(new ImageBackgroundScene(game, imageBackground))
  game.defineScene(new PopupSelectScene(game))
  game.defineScene(new TextInputScene(game))
  game.changeScene(firstScene.name)

  game.enableStandardDebugUi({memory: false, garbageCollector: false, log: false})

  game.play()
end sub
