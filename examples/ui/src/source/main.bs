sub Main()
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.fitCanvasToScreen()

  ' Started once here, not in a room's onCreate() - enableControllerInput()
  ' builds a new ControllerServer and rebinds its port each call, which logs a
  ' misleading "failed to listen" if a re-enterable room calls it again.
  game.enableControllerInput()

  ' Loaded once here, not in NinePatchRoom's onCreate() - each load allocates a
  ' fresh roBitmap plus 10 roRegions, so re-entering that room would leak a new
  ' copy every visit. The image is immutable once sliced, so one instance is
  ' safely reused for the life of the app.
  ninePatch = BGE.UI.loadNinePatchImage("pkg:/images/panel.9.png")

  ' loadBackgroundImage() picks the plain-image path here since the filename
  ' doesn't end in ".9.png" - see ImageBackgroundRoom. Same one-time-load
  ' reasoning as ninePatch above.
  imageBackground = BGE.UI.loadBackgroundImage("pkg:/images/plain-background.png")

  firstRoom = new MainRoom(game)
  game.defineRoom(firstRoom)
  game.defineRoom(new AnalogCursorRoom(game))
  patchRoom = new NinePatchRoom(game, ninePatch)
  game.defineRoom(patchRoom)
  game.defineRoom(new ImageBackgroundRoom(game, imageBackground))
  game.defineRoom(new PopupSelectRoom(game))
  game.defineRoom(new TextInputRoom(game))
  game.changeRoom(firstRoom.name)

  game.enableStandardDebugUi({memory: false, garbageCollector: false, log: false})

  game.play()
end sub
