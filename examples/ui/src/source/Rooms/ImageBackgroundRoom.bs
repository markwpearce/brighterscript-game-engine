' Demonstrates BGE.UI.ImageBackground / loadBackgroundImage(): a small 32x32
' striped-gradient PNG (examples/ui/src/images/plain-background.png, which
' does NOT end in ".9.png") backs the theme's widget background as a plain
' image - the whole image stretches to fill each button's bounds, corners
' included, unlike NinePatchRoom's 9-patch (which keeps its corners crisp).
' Buttons at several different sizes show the stripes visibly stretching/
' distorting more the further a button's aspect ratio departs from the
' source image's own 1:1 shape.
class ImageBackgroundRoom extends BGE.Room

  private imageBackground as BGE.UI.ImageBackground

  ' The image is loaded once in main.bs and handed in here, rather than
  ' being reloaded from disk every time this room is entered.
  sub new(game as BGE.Game, imageBackground as BGE.UI.ImageBackground)
    super(game)
    m.name = "ImageBackgroundRoom"
    m.imageBackground = imageBackground
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' gameUi is shared/persistent across rooms (unlike entities, it isn't
    ' torn down on room change), so clear whatever the previous room left in
    ' it before adding this room's own widgets.
    m.game.gameUi.clearChildren()

    ' Opts every themed widget's background fill into the plain image
    ' instead of a flat color - see Theme.backgroundImage's doc comment.
    m.game.defaultTheme.backgroundImage = m.imageBackground

    width = m.game.canvas.getWidth()
    height = m.game.canvas.getHeight()

    hint = new BGE.UI.Label(m.game)
    hint.setText("A plain image background stretches to fit, corners included")
    hint.customPosition = true
    hint.customX = width * 0.11
    hint.customY = height * 0.14
    m.game.gameUi.addChild(hint)

    m.addSizedButton("Small", 0.11, 0.3, 0.18, 0.07)
    m.addSizedButton("Medium", 0.11, 0.45, 0.36, 0.1)
    m.addSizedButton("Large", 0.11, 0.63, 0.6, 0.15)
  end sub

  private sub addSizedButton(label as string, xPct as float, yPct as float, widthPct as float, heightPct as float)
    width = m.game.canvas.getWidth()
    height = m.game.canvas.getHeight()

    button = new BGE.UI.Button(m.game)
    button.setLabel(label)
    button.customPosition = true
    button.customX = width * xPct
    button.customY = height * yPct
    button.width = width * widthPct
    button.height = height * heightPct
    m.game.gameUi.addChild(button)
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      ' backgroundImage is global on defaultTheme (not scoped to this room) -
      ' restore the flat-color default so MainRoom's own buttons aren't left
      ' showing this room's image background.
      m.game.defaultTheme.backgroundImage = invalid
      m.game.changeRoom("MainRoom")
    end if
  end sub

end class
