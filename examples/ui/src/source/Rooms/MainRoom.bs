class MainRoom extends BGE.Room

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainRoom"
  end sub

  ' Builds a simple hub menu: a hint label plus one Button per demo room.
  ' Each sibling plan (analog cursor, 9-patch, popup select, text input)
  ' registers its own room via game.defineRoom() in main.bs and adds one
  ' more Button block here, following the same pattern - no restructuring
  ' needed. Pressing a button whose room hasn't been registered yet is
  ' harmless: Game.changeRoom() just logs an error and does nothing.
  override sub onCreate(args as roAssociativeArray)
    ' gameUi is shared/persistent across rooms (unlike entities, it isn't
    ' torn down on room change) - clear it so re-entering this hub (e.g. via
    ' a demo room's Back handler) doesn't stack duplicate widgets on top of
    ' the ones from the last time this room was created.
    m.game.gameUi.clearChildren()

    hint = new BGE.UI.Label(m.game)
    hint.setText("Press OK on a room name to view that demo")
    hint.customPosition = true
    hint.customX = 140
    hint.customY = 100
    m.game.gameUi.addChild(hint)

    analogCursorButton = new BGE.UI.Button(m.game)
    analogCursorButton.setLabel("Analog Cursor")
    analogCursorButton.customPosition = true
    analogCursorButton.customX = 140
    analogCursorButton.customY = 180
    analogCursorButton.width = 340
    analogCursorButton.height = 60
    analogCursorButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeRoom("AnalogCursorRoom")
    end sub
    m.game.gameUi.addChild(analogCursorButton)

    ninePatchButton = new BGE.UI.Button(m.game)
    ninePatchButton.setLabel("Nine-Patch Backgrounds")
    ninePatchButton.customPosition = true
    ninePatchButton.customX = 140
    ninePatchButton.customY = 260
    ninePatchButton.width = 340
    ninePatchButton.height = 60
    ninePatchButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeRoom("NinePatchRoom")
    end sub
    m.game.gameUi.addChild(ninePatchButton)

    popupSelectButton = new BGE.UI.Button(m.game)
    popupSelectButton.setLabel("Popup Select")
    popupSelectButton.customPosition = true
    popupSelectButton.customX = 140
    popupSelectButton.customY = 340
    popupSelectButton.width = 340
    popupSelectButton.height = 60
    popupSelectButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeRoom("PopupSelectRoom")
    end sub
    m.game.gameUi.addChild(popupSelectButton)

    textInputButton = new BGE.UI.Button(m.game)
    textInputButton.setLabel("Text Input")
    textInputButton.customPosition = true
    textInputButton.customX = 140
    textInputButton.customY = 420
    textInputButton.width = 340
    textInputButton.height = 60
    textInputButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeRoom("TextInputRoom")
    end sub
    m.game.gameUi.addChild(textInputButton)
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    end if
  end sub

end class
