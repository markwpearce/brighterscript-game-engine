' Demonstrates FocusManager's pointer navigation mode driven by an analog
' stick axis (BGE.UI.FocusManager.updateAnalogCursor()) instead of the
' default discrete list navigation. D-pad focus movement still works
' unchanged in pointer mode (it drives currentlyFocused the same way), so
' this room is also the regression check for that path.
class AnalogCursorRoom extends BGE.Room

  sub new(game as BGE.Game)
    super(game)
    m.name = "AnalogCursorRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' gameUi is shared/persistent across rooms (unlike entities, it isn't
    ' torn down on room change), so clear whatever the previous room left in
    ' it before adding this room's own widgets.
    m.game.gameUi.clearChildren()

    ' Maps a connected controller's left stick (see examples/controller) to an
    ' axis named "cursor" - the server itself is started once in main.bs. A
    ' plain re-assignment into ControlMap's name-keyed map, so re-entering this
    ' room is harmless. With no controller connected this is silent - getAxis()
    ' falls back to the remote d-pad.
    m.game.controls.bindAxis("cursor", "1", 0)

    m.game.focusManager.navigationMode = BGE.UI.FocusNavigationMode.pointer
    m.game.focusManager.analogAxisName = "cursor"

    m.addHintLine("Move the cursor with the d-pad or a", 0.11)
    m.addHintLine("controller's left stick (examples/controller)", 0.15)

    m.addCornerButton("Top Left", 0.11, 0.21)
    m.addCornerButton("Top Right", 0.67, 0.21)
    m.addCornerButton("Bottom Left", 0.11, 0.75)
    m.addCornerButton("Bottom Right", 0.67, 0.75)
  end sub

  ' xPct/yPct are fractions (0-1) of the actual UI canvas size, which follows
  ' the physical screen resolution rather than a fixed 1280x720 - see
  ' examples/audio's MainRoom for the same pattern.
  private sub addHintLine(text as string, yPct as float)
    hint = new BGE.UI.Label(m.game)
    hint.setText(text)
    hint.customPosition = true
    hint.customX = m.game.canvas.getWidth() * 0.11
    hint.customY = m.game.canvas.getHeight() * yPct
    m.game.gameUi.addChild(hint)
  end sub

  private sub addCornerButton(label as string, xPct as float, yPct as float)
    width = m.game.canvas.getWidth()
    height = m.game.canvas.getHeight()

    button = new BGE.UI.Button(m.game)
    button.setLabel(label)
    button.customPosition = true
    button.customX = width * xPct
    button.customY = height * yPct
    button.width = width * 0.23
    button.height = height * 0.083
    m.game.gameUi.addChild(button)
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      ' navigationMode/analogAxisName are global on FocusManager (not scoped to
      ' this room) - restore the defaults so MainRoom's own d-pad navigation
      ' isn't left in pointer mode, and a later room opting into pointer mode
      ' doesn't silently inherit this room's axis binding.
      m.game.focusManager.navigationMode = BGE.UI.FocusNavigationMode.list
      m.game.focusManager.analogAxisName = invalid
      m.game.changeRoom("MainRoom")
    end if
  end sub

end class
