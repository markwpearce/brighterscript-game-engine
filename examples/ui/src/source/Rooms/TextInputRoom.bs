' Demonstrates BGE.UI.TextInput: a focusable single-line text field that
' receives characters via onECPKeyboard() (Roku's mobile-app on-screen
' keyboard), plus Left/Right caret movement while focused. A "Show Value"
' button reads the current text back out via getValue() and displays it in
' a Label, since typing itself produces no visible confirmation beyond the
' field's own content.
class TextInputRoom extends BGE.Room

  private textInput as BGE.UI.TextInput
  private valueLabel as BGE.UI.Label

  sub new(game as BGE.Game)
    super(game)
    m.name = "TextInputRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' gameUi is shared/persistent across rooms (unlike entities, it isn't
    ' torn down on room change), so clear whatever the previous room left in
    ' it before adding this room's own widgets.
    m.game.gameUi.clearChildren()

    width = m.game.canvas.getWidth()
    height = m.game.canvas.getHeight()

    hint = new BGE.UI.Label(m.game)
    hint.setText("Type on a connected Roku mobile app's keyboard. Left/Right move the caret.")
    hint.customPosition = true
    hint.customX = width * 0.11
    hint.customY = height * 0.14
    m.game.gameUi.addChild(hint)

    m.textInput = new BGE.UI.TextInput(m.game)
    m.textInput.placeholder = "Enter your name"
    ' TextInput doesn't clip or scroll, so cap the length to what fits.
    m.textInput.maxLength = 20
    m.textInput.customPosition = true
    m.textInput.customX = width * 0.11
    m.textInput.customY = height * 0.3
    m.textInput.width = width * 0.4
    m.textInput.height = height * 0.083
    m.game.gameUi.addChild(m.textInput)

    m.valueLabel = new BGE.UI.Label(m.game)
    m.valueLabel.setText("Value: ")
    m.valueLabel.customPosition = true
    m.valueLabel.customX = width * 0.11
    m.valueLabel.customY = height * 0.54
    m.game.gameUi.addChild(m.valueLabel)

    showValueBtn = new ShowValueButton(m.game)
    showValueBtn.room = m
    showValueBtn.setLabel("Show Value")
    showValueBtn.customPosition = true
    showValueBtn.customX = width * 0.11
    showValueBtn.customY = height * 0.42
    showValueBtn.width = width * 0.27
    showValueBtn.height = height * 0.083
    m.game.gameUi.addChild(showValueBtn)
  end sub

  ' Public - called from ShowValueButton.onClick().
  sub showValue()
    m.valueLabel.setText("Value: " + m.textInput.getValue())
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.changeRoom("MainRoom")
    end if
  end sub

end class

' Routes OK-press-while-focused back to the owning room's showValue() -
' a plain `sub(button as BGE.UI.Button)` closure assigned to onActivate
' can't reach back into this room's own fields: `m` inside that closure
' rebinds to the Button itself (Button.activate() invokes it as
' m.onActivate(m)), and bsc's type-checker also rejects referencing an
' enclosing local var from inside a nested anonymous sub. Same reasoning
' as examples/audio's AudioRowSelect/AudioVolumeSlider, which subclass
' their widget for the same reason.
class ShowValueButton extends BGE.UI.Button
  room as TextInputRoom

  sub new(game as BGE.Game)
    super(game)
  end sub

  override sub onClick()
    m.room.showValue()
  end sub
end class
