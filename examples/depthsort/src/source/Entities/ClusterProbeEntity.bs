' A DrawableRectangle panel whose outline turns red when it's part of a multi-member
' overlap cluster this frame (per Renderer.getOverlapClusters()), and stays its default
' color when it's alone. Used to visualize cluster detection directly - see
' ClusterVisualizerRoom.
class ClusterProbeEntity extends BGE.GameEntity

  panel as BGE.DrawableRectangle
  ' The SceneObject id for m.panel (captured once, after addRectangle registers it with
  ' the renderer) - comparing two custom class instances directly with `=` (e.g.
  ' sceneObj.drawable = m.panel) is not supported by BrightScript at runtime (a "Type
  ' Mismatch" crash confirmed on-device, even with an `as object` cast - that cast only
  ' satisfies the BrighterScript type-checker at compile time, it doesn't change what
  ' the underlying VM's `=` operator can do), so identity is compared via this id
  ' string instead. See Drawable.getSceneObjects().
  panelSceneObjectId as string = ""

  sub new(game as BGE.Game)
    super(game)
    m.name = "ClusterProbeEntity"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.panel = m.addRectangle("panel", args.size, args.size, {
      color: args.color,
      offset: BGE.Math.VectorOps.create(-args.size / 2, args.size / 2, 0),
      outlineRGBA: BGE.ColorsRGB.White,
      outlineWidth: 2
    })
    m.panelSceneObjectId = m.panel.getSceneObjects()[0].id
  end sub

  override sub onUpdate(deltaTime as float)
    ' Game's update pass runs before its draw pass (see CLAUDE.md's game loop
    ' walkthrough), and getOverlapClusters() is only recomputed during drawScene() -
    ' so this is reading last frame's cluster computation, one frame behind whatever
    ' actually just moved this frame. Harmless for this demo (clusters here are static
    ' or change slowly relative to the frame rate), but worth knowing.
    isClustered = false
    for each cluster in m.game.canvas.renderer.getOverlapClusters()
      if cluster.count() > 1
        for each sceneObj in cluster
          if sceneObj.id = m.panelSceneObjectId
            isClustered = true
          end if
        end for
      end if
    end for
    if isClustered
      m.panel.outlineRGBA = BGE.ColorsRGB.Red
    else
      m.panel.outlineRGBA = BGE.ColorsRGB.White
    end if
  end sub

end class
