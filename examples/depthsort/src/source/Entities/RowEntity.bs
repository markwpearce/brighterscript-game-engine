' One rectangle in a row of coplanar (or near-coplanar), horizontally-overlapping
' entities - used to show off stable tie-breaking. Each one jitters its own z position
' by a tiny sub-epsilon amount every frame, simulating the floating-point noise that
' used to cause visible order-swapping along the overlapping edges between neighbors.
class RowEntity extends BGE.GameEntity

  baseZ = 0.0
  jitterPhase = 0.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "RowEntity"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = args.x
    m.position.y = args.y
    m.baseZ = args.z
    m.jitterPhase = Rnd(0) * 6.28
    m.addRectangle("body", 60, 60, {color: args.color})
  end sub

  override sub onUpdate(deltaTime as float)
    ' Sub-epsilon jitter - smaller than Renderer.DEPTH_TIE_EPSILON, so every entity's
    ' depth almost always quantizes into the same epsilon-wide bucket as its neighbors'
    ' (see Renderer.drawScene()'s stableSortKey), which keeps the row's draw order
    ' stable once the tie-break fix is in place. Because the tie-break is bucket
    ' quantization rather than a true epsilon-tolerance comparison, jitter that happens
    ' to straddle a bucket boundary on a given frame could in principle still reorder -
    ' this demo just makes that rare in practice.
    m.position.z = m.baseZ + (sin(m.jitterPhase + (m.game.getTotalTime() * 3)) * 0.1)
  end sub

end class
