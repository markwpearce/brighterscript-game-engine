sub main(args as dynamic)
  game = new BGE.Game(1280, 720)
  game.fitCanvasToScreen()
  game.setCamera(new BGE.Camera3d())

  game.load3dModel("bird", "pkg:/models/low_poly_bird.stl")

  tieBreakSceneInstance = new TieBreakScene(game)
  game.defineScene(tieBreakSceneInstance)

  clusterVisualizerSceneInstance = new ClusterVisualizerScene(game)
  game.defineScene(clusterVisualizerSceneInstance)

  cycler = new DepthSortSceneCycler(game)
  game.addEntity(cycler)
  game.changeScene(game.getSceneNames()[0])
  game.enableStandardDebugUi()
  game.debugShowUi(true)
  ' splash=0 skips the engine splash
  game.applyLaunchSplash(new BGE.LaunchParams(args))
  game.Play()
end sub

' FF/RW step through the scenes, Back quits. ClusterVisualizerScene moves the camera, so put
' it back for the next scene.
class DepthSortSceneCycler extends BGE.SceneCycler
  sub new(game as BGE.Game)
    super(game)
  end sub

  override sub onSceneChanged(sceneName as string)
    camera = m.game.canvas.renderer.camera
    camera.useDefaultCameraTarget()
    camera.position.y = 30
  end sub
end class
