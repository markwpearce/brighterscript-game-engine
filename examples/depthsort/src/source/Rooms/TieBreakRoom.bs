' Demonstrates stable tie-breaking: a row of same-depth, horizontally-overlapping
' entities that each jitter their own z position by a tiny sub-epsilon amount every
' frame. Before the fix, this jitter alone was enough to cause visible left-right
' swapping of the overlapping edges between neighbors, purely from floating-point noise
' crossing zero - nothing here is actually changing depth order.
'
' Positions are genuine world-space coordinates (not canvas/screen coordinates) since
' this room shares the same BGE.Camera3d instance main.bs installs for every room in
' this example - see the design spec's note that this demo assumes a Camera2d room;
' expressing the layout in world space here is the smaller, more idiomatic diff than
' swapping cameras per room (no other room/example in this repo does that).
class TieBreakRoom extends BGE.Room

  sub new(game as BGE.Game)
    super(game)
    m.name = "TieBreakRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    colors = [BGE.ColorsRGB.Red, BGE.ColorsRGB.Yellow, BGE.ColorsRGB.Lime, BGE.ColorsRGB.Cyan, BGE.ColorsRGB.Blue, BGE.ColorsRGB.Magenta]
    centerX = 0
    centerY = 0
    ' 60-wide rectangles spaced 40 apart overlap their neighbors by 20px - the row must
    ' actually overlap on screen for painter's-algorithm draw order to be visible at all.
    spacing = 40
    startX = centerX - (spacing * (colors.count() - 1) / 2)
    ' z = 300.25, not a round 300: the shared Camera3d sits at world z=1000 (see
    ' main.bs), so a row depth of exactly 300 gives distance-from-camera = 700 - which
    ' divides evenly by Renderer.DEPTH_TIE_EPSILON (0.5): 700 / 0.5 = 1400.0, landing
    ' exactly ON a bucket boundary rather than inside one. Since the tie-break is bucket
    ' quantization, not a true epsilon-tolerance comparison (see Renderer.drawScene()),
    ' every entity's own +-0.1 jitter would then straddle that boundary on nearly every
    ' frame - the worst case the design doc calls out, not a representative one - and
    ' the row would visibly pop constantly instead of demonstrating stability. The
    ' 0.25 offset centers each entity's distance in the middle of its bucket instead
    ' (699.75 / 0.5 = 1399.5), so the +-0.1 jitter (+-0.2 once distance is halved by
    ' the epsilon) stays clear of both edges.
    for i = 0 to colors.count() - 1
      entity = new RowEntity(m.game)
      m.game.addEntity(entity, {x: startX + (i * spacing), y: centerY, z: 300.25, color: colors[i]})
    end for
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.end()
    else if input.press and input.isButton("fastforward")
      goToNextRoom(m, 1)
    else if input.press and input.isButton("rewind")
      goToNextRoom(m, -1)
    end if
  end sub

  override sub onGameEvent(event as string, data as object)
  end sub

  override sub onChangeRoom(newRoom as BGE.Room)
  end sub

end class
