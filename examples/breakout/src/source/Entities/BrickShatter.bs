' A throwaway, collider-less entity that plays one particle burst at a given
' position/color then deletes itself. Kept separate from Brick itself so a
' destroyed brick's collider is removed from the compositor immediately (via
' Game.destroyEntity in Brick.onCollision) rather than lingering for a grace
' period - that immediate removal is what stops the ball from re-bouncing off
' the same brick's collider on a following frame.
class BrickShatter extends BGE.GameEntity

  shatter as BGE.DrawableParticles

  sub new(game as BGE.Game)
    super(game)
    m.name = "BrickShatter"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position = args.position
    ' transformationMatrix (what getWorldPosition()/burst() actually place
    ' particles from) is normally only refreshed once per frame by Game's own
    ' update pass - calling burst() below in this same onCreate would otherwise
    ' see the stale identity matrix from before m.position was set above, and
    ' spawn every particle at the world origin instead of here.
    m.updateTransformationMatrix()
    m.shatter = m.addParticles("shatter", BGE.ParticleShape.Rectangle, {
      lifetime: 0.35,
      velocitySpreadMagnitude: 220.0,
      startColor: args.colorRGBA,
      endColor: args.colorRGBA,
      startAlpha: 255.0,
      endAlpha: 0.0,
      startSize: 12.0,
      endSize: 2.0
    })
    m.shatter.burst(14)
    m.invalidateAfter(400)
  end sub

end class
