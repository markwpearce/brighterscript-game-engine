' The engine pause menu (Resume/Quit, toggled by the "pause" action), plus the debug overlay
' toggle on "options" (FPS, input, memory, GC; see main.bs).
class PauseHandler extends BGE.PauseMenu

  sub new(game as BGE.Game)
    super(game)
  end sub

  override sub onInput(input as BGE.GameInput)
    super.onInput(input)
    if input.press and input.isButton("options")
      m.game.debugShowUi(not m.game.isDebugUiEnabled())
    end if
  end sub

end class
