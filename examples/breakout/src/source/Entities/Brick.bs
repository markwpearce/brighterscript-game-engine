' A single destructible brick. Destroyed on any collision with the ball -
' posts a "brickDestroyed" game event (with this brick's point value) so
' ScoreHandler/MainScene can react without Brick needing to know about score
' keeping or win conditions itself.
'
' kind ("normal" | "concrete" | "iron" | "explosive" | "moving") is what
' LevelGenerator.bs assigns per cell as levels get harder - see its own doc
' comment for the progression. "concrete"/"iron" take multiple hits, showing
' a damage-stage sprite (examples/breakout/src/sprites/concrete*.png,
' iron*.png) after each one instead of the plain color fill; "explosive"
' takes out its orthogonal neighbors when destroyed (see explodeNeighbors());
' "moving" patrols left/right instead of sitting still. powerUpType is only
' ever set on a "normal" kind brick (LevelGenerator keeps the two separate),
' so there's no sprite/outline conflict to resolve.
class Brick extends BGE.GameEntity

  width = 0
  height = 0
  points = 10
  kind = "normal"
  ' Packed RGBA (args.color, RGB, shifted the same way Drawable.bs's own draw
  ' path does) - kept so onCollision doesn't need to redo the conversion. Used
  ' for the shatter burst color regardless of kind, even a textured one.
  colorRGBA = 0
  ' "" (the default) | "multiBall" | "longerPaddle" | "passThrough" | "sticky"
  ' - see PowerUp.bs/PowerUpManager.bs. Marked bricks get a bright outline plus
  ' the matching power-up icon as a signifier, in addition to their row color.
  powerUpType = ""

  ' concrete/iron only - hits left before destruction, and hits total (so the
  ' damage-stage sprite index can be computed as maxHits - hitsRemaining).
  hitsRemaining = 1
  maxHits = 1

  ' "moving" only - patrols +/- patrolRange from its spawn x at patrolSpeed.
  homeX = 0.0
  patrolRange = 50.0
  patrolSpeed = 60.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "Brick"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = args.x
    m.position.y = args.y
    m.width = args.width
    m.height = args.height
    m.points = args.points
    m.powerUpType = args.powerUpType
    m.kind = args.kind

    if m.kind = "concrete"
      m.maxHits = 2
    else if m.kind = "iron"
      m.maxHits = 3
    else
      m.maxHits = 1
    end if
    m.hitsRemaining = m.maxHits

    outlineColor = BGE.ColorsRGB.White as integer
    outlineWidth = 1
    if m.powerUpType <> ""
      outlineColor = powerUpIconAccentColor(m.powerUpType)
      outlineWidth = 3
    end if

    ' "explosive" gets a fixed fill color rather than relying on an outline
    ' for its signifier - an outline color close to the row's own fill (e.g.
    ' red-on-red for the top row) would be invisible, the same problem
    ' powerUpIconAccentColor's palette was picked to avoid for power-ups.
    fillColor = args.color as integer
    if m.kind = "explosive"
      fillColor = &hFF6600
      outlineColor = BGE.ColorsRGB.Black
      outlineWidth = 3
    end if
    m.colorRGBA = (fillColor << 8) + 255

    ' A brick's position is its top left corner, so both the drawable and the
    ' collider sit at offset (0, 0) - see Paddle.bs for how an entity whose
    ' position is its center offsets the two together.
    if m.kind = "concrete" or m.kind = "iron"
      region = brickDamageRegion(m.game, m.kind, 0)
      m.addImage("body", region, {})
    else
      body = m.addRectangle("body", m.width, m.height, {
        color: fillColor,
        ' the outline is a light bevel edge, in the classic Breakout style -
        ' brighter/thicker for a power-up or explosive brick, see above
        outlineRGBA: outlineColor
      })
      body.outlineWidth = outlineWidth
    end if
    m.addRectangleCollider("body", m.width, m.height)

    if m.kind = "moving"
      m.homeX = m.position.x
      m.velocity.x = m.patrolSpeed
    end if

    if m.powerUpType <> ""
      ' Small icon overlay, scaled down to fit the brick's height, matching
      ' the falling capsule's own icon (PowerUp.bs) so the signifier and the
      ' drop are visually tied together.
      iconScale = 0.44
      region = powerUpIconRegion(m.game, m.powerUpType)
      iconWidth = region.getWidth() * iconScale
      iconHeight = region.getHeight() * iconScale
      ' The image is anchored at its own top-left and extends right/downward
      ' (same convention as the brick's own rectangle, see onCreate's comment
      ' above) - centering it means offsetting by half the leftover width and
      ' *negative* half the leftover height, not m.height/2 + iconHeight/2
      ' (which pushed it a full half-brick-height too far down).
      iconOffset = BGE.Math.VectorOps.create((m.width - iconWidth) / 2, (iconHeight - m.height) / 2)
      m.addImage("icon", region, {offset: iconOffset, scale: BGE.Math.VectorOps.create(iconScale, iconScale)})
    end if
  end sub

  override sub onUpdate(dt as float)
    if m.kind <> "moving"
      return
    end if
    if m.position.x >= m.homeX + m.patrolRange
      m.position.x = m.homeX + m.patrolRange
      m.velocity.x = -m.patrolSpeed
    else if m.position.x <= m.homeX - m.patrolRange
      m.position.x = m.homeX - m.patrolRange
      m.velocity.x = m.patrolSpeed
    end if
  end sub

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if otherEntity.name <> "Ball"
      return
    end if
    if (m.kind = "concrete" or m.kind = "iron") and m.hitsRemaining > 1
      m.hitsRemaining--
      region = brickDamageRegion(m.game, m.kind, m.maxHits - m.hitsRemaining)
      body = m.drawablesByName["body"] as BGE.Image
      body.region = region
      body.invalidateGeometry()
      m.game.playSound("hit")
      return
    end if
    m.destroy()
  end sub

  ' Destroys this brick: scores it, plays its shatter burst, drops a power-up
  ' capsule if it's marked for one, blasts its orthogonal neighbors if it's
  ' "explosive", and removes it from the game. Public (not just inlined into
  ' onCollision) so Ball's sticky-power-up explosive hit (see
  ' Ball.onCollision) can destroy a neighboring brick the same way, without
  ' having gone through an actual ball collision itself.
  sub destroy()
    m.game.postGameEvent("brickDestroyed", {points: m.points})
    center = BGE.Math.VectorOps.create(m.position.x + m.width / 2, m.position.y - m.height / 2)

    ' Constructed into locals first, not inline as addEntity() call arguments -
    ' `new` inline as a call argument referencing `m` has silently failed to
    ' register elsewhere in this codebase (see BGE.Game.enableStandardDebugUi()'s
    ' history).
    shatterEntity = new BrickShatter(m.game)
    m.game.addEntity(shatterEntity, {position: center, colorRGBA: m.colorRGBA})

    if m.powerUpType <> ""
      powerUpEntity = new PowerUp(m.game)
      m.game.addEntity(powerUpEntity, {position: center, powerUpType: m.powerUpType})
    end if

    if m.kind = "explosive"
      m.explodeNeighbors()
    end if

    m.game.destroyEntity(m)
  end sub

  ' Destroys every other Brick immediately orthogonally adjacent to this one
  ' (same row and one cell over in x, or same column and one cell over in y) -
  ' shared by "explosive"-kind bricks (above) and the "sticky" power-up's
  ' explosive first hit (Ball.onCollision).
  sub explodeNeighbors()
    centerX = m.position.x + m.width / 2
    centerY = m.position.y - m.height / 2
    for each entity in m.game.getAllEntities("Brick")
      otherBrick = entity as Brick
      if otherBrick.id = m.id
        continue for
      end if
      otherCenterX = otherBrick.position.x + otherBrick.width / 2
      otherCenterY = otherBrick.position.y - otherBrick.height / 2
      dx = abs(otherCenterX - centerX)
      dy = abs(otherCenterY - centerY)
      sameRow = dy < m.height * 0.5
      sameCol = dx < m.width * 0.5
      adjacentInRow = sameRow and dx < m.width * 1.5
      adjacentInCol = sameCol and dy < m.height * 1.5
      if adjacentInRow or adjacentInCol
        otherBrick.destroy()
      end if
    end for
  end sub

end class

' Damage-stage sprite for a "concrete"/"iron" brick - stage 0 is pristine,
' increasing by one each hit (see onCollision/onCreate above). Bitmaps are
' pre-sized to exactly one brick (112x30), loaded in main.bs as
' "concrete0"/"concrete1"/"iron0"/"iron1"/"iron2". A plain function, not a
' class method - this needs no Brick instance.
function brickDamageRegion(game as BGE.Game, kind as string, stage as integer) as roRegion
  bitmap = game.getBitmap(kind + stage.toStr())
  return CreateObject("roRegion", bitmap, 0, 0, bitmap.getWidth(), bitmap.getHeight())
end function
