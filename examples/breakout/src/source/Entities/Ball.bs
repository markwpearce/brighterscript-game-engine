' The ball. Rests on the paddle until launched (OK), then bounces off the
' side walls, the top wall, the paddle (with an angle that depends on where
' it hit the paddle - the classic Breakout mechanic for aiming), and bricks.
' Falling past the bottom of the screen costs a life.
'
' Positions here are in the engine's world space: y-up, with the origin at the
' bottom left of the canvas. So "up the screen" is +y, and the ball is lost when
' its y goes negative.
'
' Collision note: the engine reports *who* two colliders belong to, but not
' which side of either collider the hit was on - there's no collision
' normal available. Wall bounces are handled directly here by comparing
' position to the canvas edges (like examples/pong's Ball.bs does for its
' top/bottom bounds) rather than via colliders. For bricks (which can be hit
' from any of 4 sides), this example simplifies to always inverting
' velocity.y - correct for the common case of a grid of bricks approached
' from above/below, but not a full per-side bounce.
class Ball extends BGE.GameEntity

  size = 16
  ' Gap between the top of the play area and the top of the canvas, left clear
  ' for the score/lives HUD.
  topMargin = 60
  ' GameEntity.velocity is in units/second (see GameEntity.velocity).
  baseSpeed = 480
  launched = false

  ' "sticky" power-up: armed by PowerUpManager, consumed (false again) the
  ' next time this ball touches the paddle - see onCollision.
  stickyArmed = false
  ' True while this ball is stuck to the paddle (see onCollision/onControls) -
  ' distinct from the initial pre-launch wait so ScoreHandler's "launch"
  ' handling (gated on its own gameState) doesn't also try to relaunch it.
  stuck = false
  ' One-shot: set when a stuck ball is relaunched, consumed on this ball's
  ' very next brick hit to trigger a neighbor-destroying explosion (see
  ' explodeNeighbors) instead of a normal single-brick hit.
  explosiveNextHit = false
  ' "passThrough" power-up: while active, a brick hit still destroys/scores
  ' the brick but doesn't deflect this ball.
  passThroughTimer = new BGE.CountdownTimer()

  sub new(game as BGE.Game)
    super(game)
    m.name = "Ball"
  end sub

  override sub onCreate(args as roAssociativeArray)
    radius = m.size / 2
    ' The ball is drawn centered on m.position. DrawableCircle.offset is its
    ' bounding-square's top-left corner (so -radius/radius centers it), but
    ' CircleCollider.offset is the literal circle center - so unlike the
    ' Paddle/Brick's shared rectangle offset, this collider needs no offset at
    ' all. See examples/platformer's Coin.bs for the same distinction.
    m.addCircle("body", radius, {
      color: BGE.ColorsRGB.Yellow,
      offset: BGE.Math.VectorOps.create(-radius, radius)
    })
    m.addCircleCollider("body", radius)
  end sub

  sub resetOnPaddle(paddleEntity as Paddle)
    m.launched = false
    m.velocity = BGE.Math.VectorOps.create()
    m.position.x = paddleEntity.position.x
    m.position.y = paddleEntity.getTopY() + m.size / 2
  end sub

  ' paddleVelocityX carries over some of the paddle's own sideways motion at
  ' launch, on top of the fixed base angle - so drifting the paddle while
  ' waiting to launch (see onUpdate's pre-launch tracking above) actually
  ' aims the shot, rather than every launch leaving at the same fixed angle.
  sub launch(paddleVelocityX as float)
    if m.launched
      return
    end if
    m.launched = true
    m.velocity = BGE.Math.VectorOps.create(m.baseSpeed * 0.3 + paddleVelocityX * 0.5, m.baseSpeed)
  end sub

  ' Bounces off the paddle at an angle based on where it hit - dead center
  ' sends it straight up, the edges send it out at close to a 60 degree angle.
  sub bounceOffPaddle(paddleEntity as Paddle)
    hitOffset = (m.position.x - paddleEntity.position.x) / (paddleEntity.width / 2)
    hitOffset = BGE.Math.Clamp(hitOffset, -1, 1)

    maxAngleFromVertical = BGE.Math.DegreesToRadians(60)
    angle = hitOffset * maxAngleFromVertical

    m.velocity.x = sin(angle) * m.baseSpeed
    m.velocity.y = cos(angle) * m.baseSpeed
  end sub

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if not m.launched
      return
    end if
    if otherEntity.name = "Paddle"
      if m.stickyArmed
        m.stickyArmed = false
        m.stuck = true
        m.launched = false
        m.velocity = BGE.Math.VectorOps.create()
      else
        m.bounceOffPaddle(otherEntity as Paddle)
        m.game.playSound("bounce")
      end if
    else if otherEntity.name = "Brick"
      if not m.passThroughTimer.isActive()
        m.velocity.y = -m.velocity.y
      end if
      m.game.playSound("hit")
      if m.explosiveNextHit
        m.explosiveNextHit = false
        (otherEntity as Brick).explodeNeighbors()
      end if
    end if
  end sub

  ' "sticky" power-up follow-up: while stuck, the launch action fires this
  ' ball again (each stuck ball reacts independently, so this works the same
  ' whether one or several balls are stuck at once).
  override sub onControls(controls as BGE.Controller.ControlMap)
    if not m.stuck or not controls.isActionPressed("launch")
      return
    end if
    m.stuck = false
    m.explosiveNextHit = true
    paddleEntity = m.game.getEntityByName("Paddle") as Paddle
    paddleVelocityX = 0.0
    if invalid <> paddleEntity
      paddleVelocityX = paddleEntity.velocity.x
    end if
    m.launch(paddleVelocityX)
  end sub

  override sub onUpdate(dt as float)
    m.passThroughTimer.tick(dt)

    if not m.launched
      ' Track the paddle while waiting to launch (the initial pre-launch wait,
      ' or a "sticky" catch mid-play - see onCollision), so moving the paddle
      ' to aim (allowed, and authentic to the original game) doesn't leave the
      ' ball behind.
      paddleEntity = m.game.getEntityByName("Paddle") as Paddle
      if invalid <> paddleEntity
        m.position.x = paddleEntity.position.x
        m.position.y = paddleEntity.getTopY() + m.size / 2
      end if
      return
    end if

    halfSize = m.size / 2
    canvasWidth = m.game.canvas.getWidth()
    canvasHeight = m.game.canvas.getHeight()

    if m.position.x - halfSize <= 0
      m.position.x = halfSize
      m.velocity.x = abs(m.velocity.x)
      m.game.playSound("bounce")
    else if m.position.x + halfSize >= canvasWidth
      m.position.x = canvasWidth - halfSize
      m.velocity.x = -abs(m.velocity.x)
      m.game.playSound("bounce")
    end if

    ceiling = canvasHeight - m.topMargin
    if m.position.y + halfSize >= ceiling
      m.position.y = ceiling - halfSize
      m.velocity.y = -abs(m.velocity.y)
      m.game.playSound("bounce")
    end if

    if m.position.y + halfSize < 0
      ' Only the last ball in play costs a life (see PowerUpManager's
      ' multiBall clones) - an extra ball just quietly disappears.
      if m.game.getAllEntities("Ball").count() <= 1
        m.game.postGameEvent("ballLost", {})
      end if
      m.game.destroyEntity(m)
    end if
  end sub

end class
