' The player's paddle. Moves left/right only (input.x) - a Roku remote can
' only send one directional button at a time, so a single-axis paddle is a
' natural fit (no diagonal/simultaneous input needed, unlike e.g. a
' twin-stick shooter).
class Paddle extends BGE.GameEntity

  width = 150
  height = 20
  ' width reverts to this once a "longerPaddle" power-up (see widen()) expires.
  baseWidth = 150
  ' How far the paddle's center floats above the bottom of the play area.
  bottomMargin = 40
  ' GameEntity.velocity is in units/second (see GameEntity.velocity).
  speed = 720

  widenTimer = new BGE.CountdownTimer()

  sub new(game as BGE.Game)
    super(game)
    m.name = "Paddle"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = m.game.canvas.getWidth() / 2
    ' World space is y-up with the origin at the bottom left of the canvas (the
    ' renderer's camera flips y on its way to the screen), so a small y sits the
    ' paddle near the bottom of the screen.
    m.position.y = m.bottomMargin + m.height / 2

    ' The paddle's position is its center, so both the drawable and the collider
    ' are offset by half its size to put their shared top left corner in the
    ' right place. A DrawableRectangle is anchored at its top left and extends
    ' right/downwards, and a RectangleCollider covers the same area for the same
    ' offset (see RectangleCollider.refreshColliderRegion) - so giving both the
    ' same offset is all it takes to keep what you see and what collides aligned.
    cornerOffset = BGE.Math.VectorOps.create(-m.width / 2, m.height / 2)
    m.addRectangle("body", m.width, m.height, {
      color: BGE.ColorsRGB.White,
      offset: cornerOffset
    })
    m.addRectangleCollider("body", m.width, m.height, cornerOffset.x, cornerOffset.y)
  end sub

  ' Reads the "move" axis bound in main.bs rather than input.x directly, so a
  ' connected gamepad's analog stick (or examples/controller's web page) drives
  ' the paddle smoothly - ControlMap.getAxis() falls back to the plain remote
  ' d-pad when no stick input is present, so nothing changes for a bare remote.
  override sub onControls(controls as BGE.Controller.ControlMap)
    m.velocity.x = controls.getAxis("move").x * m.speed
  end sub

  override sub onUpdate(dt as float)
    wasWidened = m.widenTimer.isActive()
    m.widenTimer.tick(dt)
    if wasWidened and not m.widenTimer.isActive()
      m.setWidth(m.baseWidth)
    end if

    halfWidth = m.width / 2
    canvasWidth = m.game.canvas.getWidth()
    if m.position.x < halfWidth
      m.position.x = halfWidth
    else if m.position.x > canvasWidth - halfWidth
      m.position.x = canvasWidth - halfWidth
    end if
  end sub

  ' The y the ball rests at when sitting on top of the paddle.
  function getTopY() as float
    return m.position.y + m.height / 2
  end function

  ' Widens the paddle to 1.5x its base width for `seconds`, then automatically
  ' reverts (see onUpdate's widenTimer check) - the "longerPaddle" power-up.
  ' Calling this again while already widened just restarts the countdown.
  sub widen(seconds as float)
    m.widenTimer.start(seconds)
    m.setWidth(m.baseWidth * 1.5)
  end sub

  ' Resizes both the drawable and the collider, keeping their shared top-left
  ' corner in sync the same way onCreate's cornerOffset does (see its comment).
  private sub setWidth(newWidth as float)
    m.width = newWidth
    cornerOffset = BGE.Math.VectorOps.create(-newWidth / 2, m.height / 2)

    body = m.drawablesByName["body"] as BGE.DrawableRectangle
    body.setSize(newWidth, m.height)
    body.offset = cornerOffset

    collider = m.colliders["body"] as BGE.RectangleCollider
    collider.width = newWidth
    collider.offset = cornerOffset
  end sub

end class
