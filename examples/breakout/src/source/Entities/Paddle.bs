' The player's paddle. Moves left/right only (input.x) - a Roku remote can
' only send one directional button at a time, so a single-axis paddle is a
' natural fit (no diagonal/simultaneous input needed, unlike e.g. a
' twin-stick shooter).
class Paddle extends BGE.GameEntity

  width = 150
  height = 20
  ' How far the paddle's center floats above the bottom of the play area.
  bottomMargin = 40
  ' GameEntity.velocity is in units/second (see GameEntity.velocity).
  speed = 720

  sub new(game as BGE.Game)
    super(game)
    m.name = "Paddle"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = m.game.canvas.getWidth() / 2
    ' World space is y-up with the origin at the bottom left of the canvas (the
    ' renderer's camera flips y on its way to the screen), so a small y sits the
    ' paddle near the bottom of the screen.
    m.position.y = m.bottomMargin + m.height / 2

    ' The paddle's position is its center, so both the drawable and the collider
    ' are offset by half its size to put their shared top left corner in the
    ' right place. A DrawableRectangle is anchored at its top left and extends
    ' right/downwards, and a RectangleCollider covers the same area for the same
    ' offset (see RectangleCollider.refreshColliderRegion) - so giving both the
    ' same offset is all it takes to keep what you see and what collides aligned.
    cornerOffset = BGE.Math.VectorOps.create(-m.width / 2, m.height / 2)
    m.addRectangle("body", m.width, m.height, {
      color: BGE.ColorsRGB.White,
      offset: cornerOffset
    })
    m.addRectangleCollider("body", m.width, m.height, cornerOffset.x, cornerOffset.y)
  end sub

  override sub onInput(input as BGE.GameInput)
    m.velocity.x = input.x * m.speed
  end sub

  override sub onUpdate(dt as float)
    halfWidth = m.width / 2
    canvasWidth = m.game.canvas.getWidth()
    if m.position.x < halfWidth
      m.position.x = halfWidth
    else if m.position.x > canvasWidth - halfWidth
      m.position.x = canvasWidth - halfWidth
    end if
  end sub

  ' The y the ball rests at when sitting on top of the paddle.
  function getTopY() as float
    return m.position.y + m.height / 2
  end function

end class
