' Listens for "powerUpCollected" (posted by PowerUp.onCollision when the
' paddle catches a capsule) and applies the matching effect. Kept separate
' from ScoreHandler since it owns a different concern (buffs, not
' score/lives), matching this codebase's convention of one handler entity per
' concern (see PauseHandler).
class PowerUpManager extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "PowerUpManager"
  end sub

  override sub onGameEvent(eventName as string, data as roAssociativeArray)
    if eventName <> "powerUpCollected"
      return
    end if
    if data.powerUpType = "multiBall"
      m.spawnMultiBall()
    else if data.powerUpType = "longerPaddle"
      paddleEntity = m.game.getEntityByName("Paddle") as Paddle
      if invalid <> paddleEntity
        paddleEntity.widen(8.0)
      end if
    else if data.powerUpType = "passThrough"
      for each entity in m.game.getAllEntities("Ball")
        (entity as Ball).passThroughTimer.start(6.0)
      end for
    else if data.powerUpType = "sticky"
      for each entity in m.game.getAllEntities("Ball")
        (entity as Ball).stickyArmed = true
      end for
    end if

    m.game.playSound("powerUp")
    notice = new PowerUpNotice(m.game)
    m.game.addEntity(notice, {text: powerUpNoticeText(data.powerUpType)})
  end sub

  ' Every currently in-flight ball gains two clones, launched at +/-25 degrees
  ' off its current heading. A ball still waiting on the paddle (not yet
  ' launched) is skipped - cloning "no velocity yet" would just spawn clones
  ' sitting on top of the paddle with nowhere to go.
  private sub spawnMultiBall()
    origin = BGE.Math.VectorOps.create()
    for each entity in m.game.getAllEntities("Ball")
      activeBall = entity as Ball
      if not activeBall.launched
        continue for
      end if
      for angleDeg = -25 to 25 step 50
        clone = new Ball(m.game)
        m.game.addEntity(clone)
        clone.position = BGE.Math.VectorOps.create(activeBall.position.x, activeBall.position.y)
        clone.velocity = BGE.Math.RotateVectorAroundPoint2d(activeBall.velocity, origin, BGE.Math.DegreesToRadians(angleDeg))
        clone.launched = true
      end for
    end for
  end sub

end class
