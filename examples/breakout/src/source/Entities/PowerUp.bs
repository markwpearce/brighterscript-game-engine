' A falling capsule dropped by a power-up-marked Brick (see Brick.destroy()).
' Falls straight down at a fixed speed; the paddle catches it by touching it
' (PowerUpManager applies the actual effect), or it's discarded once it falls
' past the bottom of the play area uncaught.
class PowerUp extends BGE.GameEntity

  fallSpeed = 140.0
  powerUpType = ""

  sub new(game as BGE.Game)
    super(game)
    m.name = "PowerUp"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position = args.position
    m.powerUpType = args.powerUpType
    m.velocity = BGE.Math.VectorOps.create(0, -m.fallSpeed)

    region = powerUpIconRegion(m.game, m.powerUpType)
    cornerOffset = BGE.Math.VectorOps.create(-region.getWidth() / 2, region.getHeight() / 2)
    m.addImage("body", region, {offset: cornerOffset})
    m.addRectangleCollider("body", region.getWidth(), region.getHeight(), cornerOffset.x, cornerOffset.y)
  end sub

  override sub onUpdate(dt as float)
    if m.position.y < -60
      m.game.destroyEntity(m)
    end if
  end sub

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if otherEntity.name = "Paddle"
      ' PowerUpManager.onGameEvent plays the "powerUp" sound and shows the
      ' catch notice - this just applies the effect and removes the capsule.
      m.game.postGameEvent("powerUpCollected", {powerUpType: m.powerUpType})
      m.game.destroyEntity(m)
    end if
  end sub

end class

' Shared icon lookup for a power-up type - used for both the falling capsule
' (above) and a marked brick's own icon overlay (Brick.onCreate), so the two
' visually match up. examples/breakout/src/sprites/icons-power-up.png is a
' fixed 3x2 icon sheet (193x123, cells at x=0/64/128, y=0/62) - not every cell
' maps to a power-up type today (the dollar/star icons are unused). A plain
' function, not a class method - BrighterScript classes have no static
' methods, and this needs no instance.
function powerUpIconRegion(game as BGE.Game, powerUpType as string) as roRegion
  bitmap = game.getBitmap("powerUpIcons")
  cellX = 0
  cellY = 0
  cellWidth = 64
  cellHeight = 62
  if powerUpType = "multiBall"
    cellX = 64
    cellY = 0
  else if powerUpType = "longerPaddle"
    cellX = 64
    cellY = 62
    cellHeight = 61
  else if powerUpType = "passThrough"
    cellX = 128
    cellY = 62
    cellWidth = 65
    cellHeight = 61
  else if powerUpType = "sticky"
    ' Rockets/missiles icon (top-left) - stands in for "explodes on next hit".
    cellX = 0
    cellY = 0
  end if
  return CreateObject("roRegion", bitmap, cellX, cellY, cellWidth, cellHeight)
end function

' Accent color matching each icon's own badge color, used for a marked
' brick's bright outline (Brick.onCreate) - a plain color reads at a glance
' from further away than the icon itself does.
function powerUpIconAccentColor(powerUpType as string) as integer
  if powerUpType = "multiBall"
    return BGE.ColorsRGB.Magenta
  else if powerUpType = "longerPaddle"
    return BGE.ColorsRGB.Silver
  else if powerUpType = "passThrough"
    return BGE.ColorsRGB.Yellow
  else if powerUpType = "sticky"
    return &hFF8000
  end if
  return BGE.ColorsRGB.White
end function

' Display text for PowerUpNotice - the brief on-screen "what did I just get"
' label PowerUpManager shows when a capsule is caught.
function powerUpNoticeText(powerUpType as string) as string
  if powerUpType = "multiBall"
    return "Multi-Ball!"
  else if powerUpType = "longerPaddle"
    return "Longer Paddle!"
  else if powerUpType = "passThrough"
    return "Pass-Through Ball!"
  else if powerUpType = "sticky"
    return "Sticky Ball!"
  end if
  return "Power-Up!"
end function
