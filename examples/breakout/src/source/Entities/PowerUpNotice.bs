' A brief on-screen label announcing which power-up was just caught, fading
' out over its short lifetime via BGE.TweenManager rather than a fixed
' show/hide timer - see PowerUpManager.onGameEvent, which spawns one of these
' per "powerUpCollected" event.
class PowerUpNotice extends BGE.GameEntity

  text = ""
  alpha = 255.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "PowerUpNotice"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.text = args.text
    m.alpha = 255.0
    m.game.tweenManager.to(m, {alpha: 0.0}, 1200, BGE.Tweens.Easing.LinearTween, {
      owner: m,
      delay: 400,
      onComplete: sub(targetObj as object)
        notice = targetObj as PowerUpNotice
        notice.game.destroyEntity(notice)
      end sub
    })
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    font = m.game.getFont("hud")
    canvasSize = uiRenderer.getCanvasSize()
    color = (BGE.ColorsRGB.Yellow << 8) + int(m.alpha)
    uiRenderer.drawText(m.text, canvasSize.x / 2, canvasSize.y * 0.42, color, font, "center")
  end sub

end class
