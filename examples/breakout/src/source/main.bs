sub Main(args = [] as object)
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.fitCanvasToScreen()
  game.enableControllerInput()

  ' "move" falls back to the remote d-pad automatically when no stick input is
  ' present (ControlMap.getAxis()), so a real Bluetooth gamepad's analog stick
  ' or examples/controller's web page both drive the paddle smoothly, with the
  ' plain remote d-pad still working exactly as before.
  game.controls.bindAxis("move", "1", 0, "Move")
  game.controls.bindAction("launch", "OK", "ok", 0, "Launch")
  ' "back" also pauses (rather than quitting outright) - quitting now only
  ' happens via the Quit button in the pause panel itself (PauseHandler.open()).
  game.controls.bindAction("pause", ["play", "back"], ["play", "start", "b"], 0, "Pause")

  game.loadSound("bounce", "pkg:/sounds/bounce.wav")
  game.loadSound("hit", "pkg:/sounds/hit.wav")
  game.loadSound("launch", "pkg:/sounds/launch.wav")
  game.loadSound("lose", "pkg:/sounds/lose.wav")
  game.loadSound("win", "pkg:/sounds/win.wav")
  game.loadSound("uiFocus", "pkg:/sounds/uiFocus.wav")
  game.loadSound("uiSelect", "pkg:/sounds/uiSelect.wav")
  game.loadSound("powerUp", "pkg:/sounds/powerup.wav")
  game.loadBitmap("powerUpIcons", "pkg:/sprites/icons-power-up.png")
  ' Damage-stage sprites for "concrete"/"iron" bricks (see Brick.bs/
  ' LevelGenerator.bs) - named to match brickDamageRegion()'s "<kind><stage>"
  ' lookup.
  game.loadBitmap("concrete0", "pkg:/sprites/concrete0.png")
  game.loadBitmap("concrete1", "pkg:/sprites/concrete1.png")
  game.loadBitmap("iron0", "pkg:/sprites/iron0.png")
  game.loadBitmap("iron1", "pkg:/sprites/iron1.png")
  game.loadBitmap("iron2", "pkg:/sprites/iron2.png")
  ' Applies to every BGE.UI.Button in this game (the pause panel's Resume
  ' button today) - see Button.onFocus()/onClick() - rather than wiring
  ' focusSoundKey/clickSoundKey on each button individually.
  game.uiFocusSoundKey = "uiFocus"
  game.uiClickSoundKey = "uiSelect"
  ' Looping background music for the whole session, same one-shot-at-startup
  ' pattern examples/platformer uses (Game doesn't track per-room music state).
  game.musicPlay("pkg:/sounds/Free Fall.mp3", true)

  game.registerFont("pkg:/fonts/ViperCommand-3l74X.otf")
  game.loadFont("hud", "Viper Command", 32, false, false)
  game.loadFont("heading", "Viper Command", 48, false, false)
  game.defaultTheme.font = game.getFont("hud")

  ' Arcade-style palette pulled from the brick rows (MainRoom.rowColors) instead
  ' of the engine's default gray, so the pause/win/game-over panels match the
  ' rest of the game.
  game.defaultTheme.backgroundColor = &h101018E6
  game.defaultTheme.borderColor = BGE.Colors.Cyan
  game.defaultTheme.focusedBorderColor = BGE.Colors.Yellow
  game.defaultTheme.hoveredBackgroundColor = &h1A3A3AFF

  firstRoom = new MainRoom(game)
  game.defineRoom(firstRoom)

  ' A `level` deep-link/launch param (e.g. `rokubot launch dev --param level=3`)
  ' skips straight to that level instead of always starting at 1 - the same
  ' convention examples/platformer uses for its own `level` param. Useful for
  ' checking a specific level's brick-type mix (LevelGenerator.bs) without
  ' actually playing through every level before it.
  game.changeRoom(firstRoom.name, {level: getRequestedStartLevel(args)})

  game.enableStandardDebugUi()
  ' Hidden by default - PauseHandler toggles this on/off with "options" (see
  ' its onInput), so debug info doesn't clutter a normal playthrough.

  game.play()
end sub

' Pulls a `level` deep-link/launch param out of Main()'s args. Roku wraps
' launch params in a one-element array containing the actual roAssociativeArray.
'
' @param args
' @return {integer} the requested level (minimum 1), or 1 if no valid `level`
'   param was given
function getRequestedStartLevel(args as object) as integer
  params = args as dynamic
  if type(args) = "roArray" and args.count() > 0
    params = args[0]
  end if
  if type(params) <> "roAssociativeArray" or invalid = params.level
    return 1
  end if
  requestedLevel = Val(params.level.toStr()) ' launch params always arrive as strings
  if requestedLevel < 1
    return 1
  end if
  return Int(requestedLevel)
end function
