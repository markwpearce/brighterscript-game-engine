' Procedurally generates each level's difficulty parameters - there's no fixed
' level count or hand-authored layout (unlike examples/platformer's
' LevelData.bs); the game just keeps getting harder forever, per issue #206.
' MainRoom.addBricks() calls these per cell/level rather than using a fixed
' grid of literal colors/points the way the original single-level version did.

' Row count for a level's brick grid - starts small and grows slowly, capped
' at 8 (never crowds out the paddle/ball's play area) - cols stays fixed at
' 10, MainRoom.cols. Reaches the cap around level 16.
function getLevelRows(level as integer) as integer
  return BGE.Math.Clamp(3 + Int(level / 3), 4, 8)
end function

' How many bricks in this level get marked with a (random) power-up - see
' Brick.powerUpType/PowerUp.bs. Only ever assigned to "normal"-kind bricks.
function getLevelPowerUpCount(level as integer) as integer
  return BGE.Math.Clamp(2 + Int(level / 2), 3, 10)
end function

' Weighted-random brick kind for one cell, given the level number - tougher
' kinds unlock one at a time (concrete at level 3, iron at 6, explosive at 10,
' moving at 15) and grow more common the further past their unlock level this
' level is, so a level doesn't just add variety but leans on it harder over
' time - a mix this busy shouldn't show up until roughly level 20, not level
' 6. "normal" always has a flat baseline weight so it's never fully phased
' out, and "empty" (no brick at all - MainRoom.addBricks() skips that cell
' entirely) is always possible so rows aren't solid from level 1 onward.
function getLevelBrickKind(level as integer) as string
  weights = {normal: 10, empty: BGE.Math.Clamp(1 + Int(level / 4), 1, 6)}
  if level >= 3
    weights["concrete"] = BGE.Math.Clamp(level - 2, 1, 10)
  end if
  if level >= 6
    weights["iron"] = BGE.Math.Clamp(level - 5, 1, 8)
  end if
  if level >= 10
    weights["explosive"] = BGE.Math.Clamp(level - 9, 1, 6)
  end if
  if level >= 15
    weights["moving"] = BGE.Math.Clamp(level - 14, 1, 6)
  end if

  total = 0
  for each key in weights
    total += weights[key]
  end for

  roll = Rnd(0) * total
  cumulative = 0.0
  for each key in weights
    cumulative += weights[key]
    if roll <= cumulative
      return key
    end if
  end for
  return "normal"
end function
