class Player extends BGE.GameEntity

  speed = 480
  screenRect as BGE.Math.Rectangle

  sub new(game as BGE.Game)
    super(game)
    m.name = "Player"
  end sub

  override sub onCreate(args as roAssociativeArray)
    canvasSize = m.game.canvas.renderer.getCanvasSize()
    m.position.x = 80
    m.position.y = canvasSize.y / 2
    m.screenRect = new BGE.Math.Rectangle(0, 0, canvasSize.x, canvasSize.y)

    bitmap = m.game.getBitmap("ball")
    region = CreateObject("roRegion", bitmap, 0, 0, bitmap.GetWidth(), bitmap.GetHeight())
    m.addImage("sprite", region)
    m.addCircleCollider("body", bitmap.GetWidth() / 2)
  end sub

  override sub onInput(input as BGE.GameInput)
    m.velocity.x = input.x * m.speed
    m.velocity.y = input.y * m.speed
  end sub

  override sub onUpdate(dt as float)
    radius = (m.getCollider("body") as BGE.CircleCollider).radius
    BGE.Math.clampToRect(m.position, m.screenRect, radius, radius)
  end sub

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if otherEntity.name = "Target"
      m.game.playSound("hit", 50)
      m.game.End()
    end if
  end sub

end class
