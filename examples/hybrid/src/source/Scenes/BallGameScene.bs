class BallGameScene extends BGE.GameScene

  sub new(game as BGE.Game)
    super(game)
    m.name = "BallGameScene"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.game.addEntity(new Player(m.game))
    m.game.addEntity(new Target(m.game))
    m.game.addEntity(new BGE.PauseMenu(m.game, {style: "text"}))
  end sub

  override sub onDrawBegin(renderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    uiCenter = uiRenderer.getCanvasCenter()
    uiRenderer.drawText("Move the ball to the green target with the arrow keys", uiCenter.x, 60, BGE.Colors.White, m.game.getFont("default"), "center")
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.isRemoteBack()
      m.game.End()
    end if
  end sub

end class
