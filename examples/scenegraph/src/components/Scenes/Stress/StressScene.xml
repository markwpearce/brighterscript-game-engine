<?xml version="1.0" encoding="utf-8" ?>
<!--
  Stress-test scene for the BGE SceneGraph shape components (issue #61 follow-up).
  Builds a grid of shape instances on demand (see `spec`) to measure mass-construction
  behavior - 20-30 concurrent `ShapeRenderTask` spin-ups - that the 4-shape MainScene demo
  never exercises. Not shown by default; reachable via a `scene=stress` launch param.
  See docs/scenegraph-shapes.md and specs/2026-08-24-scenegraph-shape-components-design.md.
-->
<component name="StressScene" extends="Scene">
  <interface>
    <!-- "<variant>:<count>", e.g. "rects:25" or "mixed:30". Setting this (re)builds the grid.
         Starts empty and is set exactly once by main.bs right after scene creation - never
         left at a default that init() would also build, which would otherwise fire a second,
         overlapping build while the first is still mid-render (each ShapeRenderTask keeps
         running once started, regardless of its owning node being torn down) - see
         StressScene.bs's init(). -->
    <field id="spec" type="string" value="" onChange="onSpecChanged" />
  </interface>
  <children>
    <Label id="title" translation="[20, 16]" text="BGE Shape Stress Test" />
    <Label id="hint" translation="[20, 42]" text="OK: cycle spec   Back: exit" />
    <Label id="statusLabel" translation="[20, 68]" text="Building..." />
    <Label id="heartbeatLabel" translation="[20, 92]" text="Heartbeat: 0 (max gap: -ms)" />
    <Label id="spotCheckLabel" translation="[20, 116]" text="Spot-check redraw counts: -" />
    <Group id="grid" />
  </children>
</component>
