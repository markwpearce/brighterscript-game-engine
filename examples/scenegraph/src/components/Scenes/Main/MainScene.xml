<?xml version="1.0" encoding="utf-8" ?>
<!-- Demonstrates all four BGE shape components. OK toggles a width/height Animation. See docs/scenegraph-shapes.md. -->
<component name="MainScene" extends="Scene">
  <children>
    <Label id="title" translation="[100, 60]" text="BGE SceneGraph Shapes" />
    <Label id="hint" translation="[100, 100]" text="OK: animation   Left: redraw circle   Right: redraw TaskCircle   Back: exit" />

    <RoundedRectangle id="roundedRect" translation="[100, 180]" width="220" height="160" cornerRadius="24" color="0xFF6B35FF" />
    <Circle id="circle" translation="[380, 180]" width="180" height="180" color="0x3AAFA9FF" />
    <Triangle id="triangle" translation="[620, 180]" width="180" height="180" color="0xF6C90EFF" />
    <Polygon id="polygon" translation="[860, 180]" width="200" height="200" color="0xE85D75FF" />

    <Label id="fpsLabel" translation="[100, 420]" text="Redraws/sec - rect: 0  circle: 0  triangle: 0  polygon: 0" />
    <Label id="timingLabel" translation="[100, 450]" text="Round trip (ms) - rect: -  circle: -  triangle: -  polygon: -" />
    <Label id="heartbeatLabel" translation="[100, 480]" text="Heartbeat: 0 (max gap: -ms)" />

    <TaskCircle id="taskCircle" translation="[1060, 180]" width="180" height="180" color="0x8E6BFFFF" />

    <Animation id="shapeAnim" repeat="true" duration="2.0">
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[80.0, 220.0, 80.0]" fieldToInterp="roundedRect.width" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[100.0, 180.0, 100.0]" fieldToInterp="circle.width" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[100.0, 180.0, 100.0]" fieldToInterp="circle.height" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[100.0, 180.0, 100.0]" fieldToInterp="triangle.width" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[100.0, 180.0, 100.0]" fieldToInterp="triangle.height" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[120.0, 200.0, 120.0]" fieldToInterp="polygon.width" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[120.0, 200.0, 120.0]" fieldToInterp="polygon.height" />
    </Animation>
  </children>
</component>
