<?xml version="1.0" encoding="utf-8" ?>
<!--
  Demonstrates BGE's four SceneGraph shape components, each with a fill and an
  outline. Press OK to toggle a continuous width animation on all four (driven
  by an <Animation> node) and see the measured redraws/sec per shape - see
  docs/scenegraph-shapes.md for what was found animate-safe on real hardware.
-->
<component name="MainScene" extends="Scene">
  <children>
    <Label id="title" translation="[100, 60]" text="BGE SceneGraph Shapes" />
    <Label id="hint" translation="[100, 100]" text="OK: toggle animation    Back: exit" />

    <RoundedRectangle id="roundedRect" translation="[100, 180]" width="220" height="160" cornerRadius="24" color="0xFF6B35FF" outlineColor="0x1B1B1BFF" outlineWidth="4" />
    <Circle id="circle" translation="[380, 180]" width="180" height="180" color="0x3AAFA9FF" outlineColor="0x1B1B1BFF" outlineWidth="4" outlineSegments="48" />
    <Triangle id="triangle" translation="[620, 180]" width="180" height="180" color="0xF6C90EFF" outlineColor="0x1B1B1BFF" outlineWidth="1" />
    <Polygon id="polygon" translation="[860, 180]" width="200" height="200" color="0xE85D75FF" outlineColor="0x1B1B1BFF" outlineWidth="2" />

    <Label id="fpsLabel" translation="[100, 420]" text="Redraws/sec - rect: 0  circle: 0  triangle: 0  polygon: 0" />

    <Animation id="shapeAnim" repeat="true" duration="2.0">
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[80.0, 220.0, 80.0]" fieldToInterp="roundedRect.width" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[100.0, 180.0, 100.0]" fieldToInterp="circle.width" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[100.0, 180.0, 100.0]" fieldToInterp="circle.height" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[100.0, 180.0, 100.0]" fieldToInterp="triangle.width" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[100.0, 180.0, 100.0]" fieldToInterp="triangle.height" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[120.0, 200.0, 120.0]" fieldToInterp="polygon.width" />
      <FloatFieldInterpolator key="[0, 0.5, 1]" keyValue="[120.0, 200.0, 120.0]" fieldToInterp="polygon.height" />
    </Animation>
  </children>
</component>
