' See MainScene.xml.

function init()
  m.top.setFocus(true)

  m.roundedRect = m.top.findNode("roundedRect")
  m.circle = m.top.findNode("circle")
  m.triangle = m.top.findNode("triangle")
  m.polygon = m.top.findNode("polygon")
  m.fpsLabel = m.top.findNode("fpsLabel")
  m.timingLabel = m.top.findNode("timingLabel")
  m.heartbeatLabel = m.top.findNode("heartbeatLabel")
  m.animation = m.top.findNode("shapeAnim")
  m.circleColors = [&h3AAFA9FF, &hE07A5FFF]
  m.circleColorIndex = 0

  ' triangle/polygon vertices are set directly in MainScene.xml (vector2darray, XML-settable).

  m.roundedRect.observeField("uri", "onRoundedRectRedrawn")
  m.circle.observeField("uri", "onCircleRedrawn")
  m.triangle.observeField("uri", "onTriangleRedrawn")
  m.polygon.observeField("uri", "onPolygonRedrawn")
  m.roundedRect.observeField("lastRoundTripMs", "onTimingUpdated")
  m.circle.observeField("lastRoundTripMs", "onTimingUpdated")
  m.triangle.observeField("lastRoundTripMs", "onTimingUpdated")
  m.polygon.observeField("lastRoundTripMs", "onTimingUpdated")
  onTimingUpdated()

  m.redrawCounts = {roundedRect: 0, circle: 0, triangle: 0, polygon: 0}
  m.animationEnabled = false

  m.fpsTimer = CreateObject("roSGNode", "Timer")
  m.fpsTimer.duration = 1
  m.fpsTimer.repeat = true
  m.fpsTimer.ObserveField("fire", "onFpsTick")
  m.top.appendChild(m.fpsTimer)
  m.fpsTimer.control = "start"

  ' Ticks on a short fixed interval; a gap much larger than that reveals the
  ' render thread was blocked (e.g. by a shape's synchronous redraw) rather
  ' than actually running every heartbeatTimer.duration seconds.
  m.heartbeatCount = 0
  m.heartbeatMaxGapMs = 0
  m.heartbeatClock = CreateObject("roTimespan")
  m.heartbeatTimer = CreateObject("roSGNode", "Timer")
  m.heartbeatTimer.duration = 0.05
  m.heartbeatTimer.repeat = true
  m.heartbeatTimer.ObserveField("fire", "onHeartbeat")
  m.top.appendChild(m.heartbeatTimer)
  m.heartbeatTimer.control = "start"
end function

sub onHeartbeat()
  gapMs = m.heartbeatClock.TotalMilliseconds()
  m.heartbeatClock.Mark()
  m.heartbeatCount++
  if gapMs > m.heartbeatMaxGapMs
    m.heartbeatMaxGapMs = gapMs
  end if
  if gapMs > 70
    print "[MainScene] heartbeat gap " + gapMs.toStr() + "ms (expected ~50ms) - render thread was blocked"
  end if
  m.heartbeatLabel.text = "Heartbeat: " + m.heartbeatCount.toStr() + " (max gap: " + m.heartbeatMaxGapMs.toStr() + "ms)"
end sub

sub onRoundedRectRedrawn()
  m.redrawCounts.roundedRect++
end sub

sub onCircleRedrawn()
  m.redrawCounts.circle++
end sub

sub onTriangleRedrawn()
  m.redrawCounts.triangle++
end sub

sub onPolygonRedrawn()
  m.redrawCounts.polygon++
end sub

sub onTimingUpdated()
  m.timingLabel.text = "Round trip (ms) - rect: " + m.roundedRect.lastRoundTripMs.toStr() + "  circle: " + m.circle.lastRoundTripMs.toStr() + "  triangle: " + m.triangle.lastRoundTripMs.toStr() + "  polygon: " + m.polygon.lastRoundTripMs.toStr()
end sub

sub onFpsTick()
  counts = m.redrawCounts
  m.fpsLabel.text = "Redraws/sec - rect: " + counts.roundedRect.toStr() + "  circle: " + counts.circle.toStr() + "  triangle: " + counts.triangle.toStr() + "  polygon: " + counts.polygon.toStr()
  m.redrawCounts = {roundedRect: 0, circle: 0, triangle: 0, polygon: 0}
end sub

function onKeyEvent(key as string, press as boolean) as boolean
  handled = false
  if press and "OK" = key
    m.animationEnabled = not m.animationEnabled
    if m.animationEnabled
      m.animation.control = "start"
    else
      m.animation.control = "stop"
    end if
    handled = true
  else if press and "left" = key
    m.circleColorIndex = (m.circleColorIndex + 1) mod m.circleColors.count()
    m.circle.color = m.circleColors[m.circleColorIndex]
    handled = true
  end if
  return handled
end function
