import "../../source/utils/ShapeComponentHelpers.bs"

sub init()
  m.task = m.top.findNode("task")
  m.task.observeField("resultUri", "onResultReady")
  redraw()
end sub

sub onFieldChanged()
  redraw()
end sub

sub redraw()
  m.roundTripTimer = BGE.ShapeComponentHelpers.startRoundTripTimer()
  m.task.width = m.top.width
  m.task.height = m.top.height
  m.task.color = m.top.color
  m.task.control = "RUN"
end sub

sub onResultReady()
  m.top.uri = m.task.resultUri
  m.top.lastRoundTripMs = BGE.ShapeComponentHelpers.logRoundTrip("TaskCircle", m.roundTripTimer)
end sub
