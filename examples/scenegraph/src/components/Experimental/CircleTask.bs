import "../../source/utils/ShapeComponentHelpers.bs"

sub init()
  m.top.functionName = "doRender"
end sub

function doRender() as void
  width = Int(m.top.width)
  height = Int(m.top.height)
  radius = BGE.Math.Min(width, height) / 2
  cacheKey = FormatJson({w: width, h: height, color: m.top.color})

  renderState = BGE.ShapeComponentHelpers.beginShapeRender("TaskCircle", cacheKey, width, height)
  if not renderState.hit
    if invalid = renderState.renderer
      return
    end if
    renderState.renderer.drawCircleTo(renderState.bitmap, radius, radius, radius, m.top.color)
    BGE.ShapeComponentHelpers.finishShapeRender(renderState)
  end if
  m.top.resultUri = renderState.uri
end function
