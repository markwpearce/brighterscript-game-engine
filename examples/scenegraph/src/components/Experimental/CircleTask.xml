<?xml version="1.0" encoding="utf-8" ?>
<!-- Prototype: Circle's draw+PNG-encode+write work done on a Task thread instead of the render thread, to test whether it frees up the render thread. See TaskCircle.xml/.bs and docs/scenegraph-shapes.md's "Task experiment" section. -->
<component name="CircleTask" extends="Task">
  <interface>
    <field id="width" type="float" value="100" />
    <field id="height" type="float" value="100" />
    <field id="color" type="color" value="0xFFFFFFFF" />
    <field id="resultUri" type="string" value="" alwaysNotify="true" />
  </interface>
</component>
