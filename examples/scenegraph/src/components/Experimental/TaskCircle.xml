<?xml version="1.0" encoding="utf-8" ?>
<!-- Prototype: same visual result as the shipped Circle component, but the draw+PNG work runs on a CircleTask thread instead of the render thread. loadSync is left at its Poster default (async) - a Task result only fires once per change here, so there's no rapid-reassignment starvation risk like the shipped Circle's Animation case. -->
<component name="TaskCircle" extends="Poster">
  <interface>
    <field id="width" type="float" value="100" onChange="onFieldChanged" />
    <field id="height" type="float" value="100" onChange="onFieldChanged" />
    <field id="color" type="color" value="0xFFFFFFFF" onChange="onFieldChanged" />
    <field id="lastRoundTripMs" type="integer" value="0" />
  </interface>
  <children>
    <CircleTask id="task" />
  </children>
</component>
