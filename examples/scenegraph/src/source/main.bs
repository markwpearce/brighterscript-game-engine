' Pure SceneGraph entry point - no roScreen/BGE.Game anywhere in this process.
' Demonstrates BGE's SceneGraph shape components (RoundedRectangle, Circle,
' Triangle, Polygon), each backed internally by its own BGE.Renderer over a
' private roBitmap. See src/components/Scenes/Main/MainScene.bs.
'
' A `scene=stress` launch param switches to StressScene instead (a 20-30-shape
' mass-construction stress test, see src/components/Scenes/Stress/StressScene.bs) -
' e.g. `rokubot launch dev --param scene=stress --param spec=mixed:30`. Not the
' default view; MainScene's 4-shape demo remains what launches normally.
sub main(args as object)
  screen = CreateObject("roSGScreen")
  port = CreateObject("roMessagePort")
  screen.setMessagePort(port)

  params = getLaunchParams(args)
  if lcase(params.scene) = "stress"
    scene = screen.CreateScene("StressScene")
    ' Always set spec exactly once, even with no `spec` param - StressScene.xml's own
    ' default is deliberately empty so init() never builds on its own (see
    ' StressScene.bs), which would otherwise race a second build set here.
    spec = params.spec
    if spec = ""
      spec = "rects:25"
    end if
    scene.spec = spec
  else
    scene = screen.CreateScene("MainScene")
  end if
  screen.show()
  scene.setFocus(true)

  while true
    msg = wait(0, port)
    if type(msg) = "roSGScreenEvent" and msg.isScreenClosed()
      return
    end if
  end while
end sub

' Roku wraps launch params in a one-element array containing the actual roAssociativeArray.
function getLaunchParams(args as object) as object
  params = args
  if type(args) = "roArray" and args.count() > 0
    params = args[0]
  end if
  if type(params) <> "roAssociativeArray"
    params = {}
  end if
  if invalid = params.scene
    params.scene = ""
  end if
  if invalid = params.spec
    params.spec = ""
  end if
  return params
end function
