' Demonstrates burst(count) as a discrete, one-shot event fired on a button press,
' in contrast to the continuous start()/stop() emission the other demo rooms use.
' The emitter's own spawnRate is left at 0 - burst() spawns particles immediately
' regardless of start()/stop() state.
class BurstRoom extends BGE.Room

  fireworks as BGE.GameEntity
  emitter as BGE.DrawableParticles
  burstCount as integer = 0

  sub new(game as BGE.Game)
    super(game)
    m.name = "BurstRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.fireworks = new BGE.GameEntity(m.game, {name: "Fireworks", position: BGE.Math.VectorOps.create(m.game.canvas.getWidth() / 2, m.game.canvas.getHeight() / 2)})
    m.game.addEntity(m.fireworks)
    m.emitter = m.fireworks.addParticles("fireworks", BGE.ParticleShape.Rectangle, {
      lifetime: 1.0,
      lifetimeSpread: 0.3,
      velocitySpreadMagnitude: 300,
      startColor: BGE.ColorsRGB.Cyan,
      endColor: BGE.ColorsRGB.Magenta,
      startAlpha: 255,
      endAlpha: 0,
      startSize: 10,
      endSize: 2,
      maxParticles: 500
    })
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    else if input.press and input.isButton("fastforward")
      goToNextRoom(m, 1)
    else if input.press and input.isButton("rewind")
      goToNextRoom(m, -1)
    else if input.press and input.isButton("ok")
      m.emitter.burst(50)
      m.burstCount++
    end if
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    font = m.game.getFont("default")
    center = uiRenderer.getCanvasCenter()
    uiRenderer.DrawText("Burst Particles: press OK to fire 50 particles at once", center.x, 100, BGE.Colors.white, font, "center")
    uiRenderer.DrawText(`Bursts fired: ${m.burstCount}`, center.x, 140, BGE.Colors.Yellow, font, "center")
    uiRenderer.DrawText("Change Room: <</>>  |  Back: Back", center.x, 180, BGE.Colors.white, font, "center")
  end sub

end class
