' Several emitters running near maxParticles at a high spawnRate, specifically to
' read real on-device fps/draw-call numbers with a large live particle count - see
' the design spec's testing plan. The standard debug UI (FPS overlay) is enabled so
' the number is visible on-screen without any extra rokubot instrumentation.
class StressRoom extends BGE.Room

  emitters as object[] = []

  sub new(game as BGE.Game)
    super(game)
    m.name = "StressRoom"
    ' Room.onCreate() re-runs every time changeRoom() lands here (even re-entering an
    ' already-visited room), but debugUi is owned by Game and persists across room
    ' changes - enabling it here in the constructor (which only ever runs once) avoids
    ' stacking a duplicate FpsDisplay widget on every revisit.
    game.enableStandardDebugUi({log: false})
    game.debugShowUi(true)
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' Reset in case this room is being re-entered - see the constructor comment above,
    ' the same "onCreate reruns on revisit" issue applies to this array.
    m.emitters = []

    canvasWidth = m.game.canvas.getWidth()
    canvasHeight = m.game.canvas.getHeight()

    positions = [
      BGE.Math.VectorOps.create(canvasWidth * 0.25, canvasHeight * 0.5)
      BGE.Math.VectorOps.create(canvasWidth * 0.5, canvasHeight * 0.5)
      BGE.Math.VectorOps.create(canvasWidth * 0.75, canvasHeight * 0.5)
    ]

    for i = 0 to positions.count() - 1
      entity = new BGE.GameEntity(m.game, {name: "StressEmitter" + stri(i).trim(), position: positions[i]})
      m.game.addEntity(entity)
      emitter = entity.addParticles("particles" + stri(i).trim(), BGE.ParticleShape.Rectangle, {
        spawnRate: 300,
        lifetime: 2.0,
        velocitySpreadMagnitude: 200,
        startColor: BGE.ColorsRGB.Lime,
        endColor: BGE.ColorsRGB.Blue,
        startAlpha: 255,
        endAlpha: 0,
        startSize: 8,
        endSize: 2,
        maxParticles: 500
      })
      emitter.start()
      m.emitters.push(emitter)
    end for
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    else if input.press and input.isButton("fastforward")
      goToNextRoom(m, 1)
    else if input.press and input.isButton("rewind")
      goToNextRoom(m, -1)
    end if
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    font = m.game.getFont("default")
    center = uiRenderer.getCanvasCenter()
    liveCount = 0
    for each emitter in m.emitters
      liveCount += emitter.particles.count()
    end for
    uiRenderer.DrawText("Stress Test: 3 emitters near maxParticles - watch the FPS overlay", center.x, 100, BGE.Colors.white, font, "center")
    uiRenderer.DrawText(`Live particles: ${liveCount}`, center.x, 140, BGE.Colors.Yellow, font, "center")
    uiRenderer.DrawText("Change Room: <</>>  |  Back: Back", center.x, 180, BGE.Colors.white, font, "center")
  end sub

end class
