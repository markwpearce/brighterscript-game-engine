' Continuous emission of "rectangle" particles under constant downward acceleration
' (gravity), demonstrating DrawableParticles.acceleration.
class RectangleParticlesRoom extends BGE.Room

  debris as BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "RectangleParticlesRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.debris = new BGE.GameEntity(m.game, {name: "Debris", position: BGE.Math.VectorOps.create(m.game.canvas.getWidth() / 2, m.game.canvas.getHeight() * 0.8)})
    m.game.addEntity(m.debris)
    emitter = m.debris.addParticles("debris", "rectangle", {
      spawnRate: 20,
      lifetime: 2.0,
      velocitySpreadAngleDegrees: 30,
      velocitySpreadMagnitude: 150,
      acceleration: BGE.Math.VectorOps.create(0, -300), ' gravity - +y is world-up, see GameInput's convention
      startColor: BGE.ColorsRGB.Silver,
      endColor: BGE.ColorsRGB.Gray,
      startSize: 12,
      endSize: 3,
      maxParticles: 150
    })
    emitter.start()
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    else if input.press and input.isButton("fastforward")
      goToNextRoom(m, 1)
    else if input.press and input.isButton("rewind")
      goToNextRoom(m, -1)
    end if
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    font = m.game.getFont("default")
    center = uiRenderer.getCanvasCenter()
    uiRenderer.DrawText("Rectangle Particles: gravity pulls debris downward", center.x, 100, BGE.Colors.white, font, "center")
    uiRenderer.DrawText("Change Room: <</>>  |  Back: Back", center.x, 140, BGE.Colors.white, font, "center")
  end sub

end class
