' Two checks specifically aimed at the kind of bug a stationary-emitter screenshot can't
' catch: (1) a "rectangle" emitter attached to an entity that moves back and forth across
' the screen, trailing particles behind it - confirms particles spawn at the entity's
' current world position each frame, not a fixed point; (2) a stationary "image" emitter
' with rotationSpeed: 90 (degrees/second, i.e. one full rotation every 4 seconds) - slow
' enough to visually count, which is what actually would have caught the old
' degrees/radians rotationSpeed bug (that bug made this spin ~28.6x too fast).
class MovingEmitterRoom extends BGE.Room

  mover as BGE.GameEntity
  moveSpeed as float = 250.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "MovingEmitterRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.mover = new BGE.GameEntity(m.game, {name: "Mover", position: BGE.Math.VectorOps.create(m.game.canvas.getWidth() / 2, m.game.canvas.getHeight() * 0.7)})
    m.mover.velocity.x = m.moveSpeed
    m.game.addEntity(m.mover)
    trailEmitter = m.mover.addParticles("trail", BGE.ParticleShape.Rectangle, {
      spawnRate: 30,
      lifetime: 0.75,
      velocitySpreadAngleDegrees: 20,
      velocitySpreadMagnitude: 40,
      startColor: BGE.ColorsRGB.Cyan,
      endColor: BGE.ColorsRGB.Blue,
      startSize: 10,
      endSize: 2,
      maxParticles: 100
    })
    trailEmitter.start()

    slowSpinner = new BGE.GameEntity(m.game, {name: "SlowSpinner", position: BGE.Math.VectorOps.create(m.game.canvas.getWidth() / 2, m.game.canvas.getHeight() * 0.3)})
    m.game.addEntity(slowSpinner)
    spinEmitter = slowSpinner.addParticles("spin", BGE.ParticleShape.Image, {
      spawnRate: 3,
      lifetime: 4.0,
      velocitySpreadAngleDegrees: 0,
      velocitySpreadMagnitude: 0,
      rotationSpeed: 90, ' degrees/second - one full rotation every 4 seconds, easily counted by eye
      ' Note: spark.png's flame silhouette has no crisp geometric features (tick marks, a single
      ' sharp point) to read an exact angle off of, so a viewer can confirm it's steadily
      ' rotating and roughly on pace but can't verify 90 deg/sec to the exact degree by eye -
      ' this doesn't mask the ~28.6x-too-fast bug this room targets (that shows as continuous
      ' fast blur, not a slow discrete rotation), so no asset swap is needed here.
      startSize: 0.5,
      endSize: 0.5,
      startAlpha: 255,
      endAlpha: 255,
      maxParticles: 1
    })
    spinEmitter.image = m.game.getBitmap("spark")
    spinEmitter.start()
  end sub

  override sub onUpdate(deltaTime as float)
    margin = m.game.canvas.getWidth() * 0.1 ' keep the bounce points title-safe, matching this repo's other examples

    if m.mover.position.x >= m.game.canvas.getWidth() - margin and m.mover.velocity.x > 0
      m.mover.velocity.x = -m.moveSpeed
    else if m.mover.position.x <= margin and m.mover.velocity.x < 0
      m.mover.velocity.x = m.moveSpeed
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    else if input.press and input.isButton("fastforward")
      goToNextRoom(m, 1)
    else if input.press and input.isButton("rewind")
      goToNextRoom(m, -1)
    end if
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    font = m.game.getFont("default")
    center = uiRenderer.getCanvasCenter()
    uiRenderer.DrawText("Moving Emitter: particles trail the entity as it moves left/right", center.x, 100, BGE.Colors.white, font, "center")
    uiRenderer.DrawText("Slow Spinner: rotationSpeed 90 deg/sec - one full rotation every 4 sec", center.x, 140, BGE.Colors.white, font, "center")
    uiRenderer.DrawText("Change Room: <</>>  |  Back: Back", center.x, 180, BGE.Colors.white, font, "center")
  end sub

end class
