' Continuous emission of "image" particles - confetti-style sprites that spin
' (rotationSpeed) and shrink/fade as they age. Requires main.bs to have already
' loaded the "spark" bitmap via Game.loadBitmap().
class ImageParticlesRoom extends BGE.Room

  confetti as BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "ImageParticlesRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.confetti = new BGE.GameEntity(m.game, {name: "Confetti", position: BGE.Math.VectorOps.create(m.game.canvas.getWidth() / 2, m.game.canvas.getHeight() / 2)})
    m.game.addEntity(m.confetti)
    emitter = m.confetti.addParticles("confetti", BGE.ParticleShape.Image, {
      spawnRate: 15,
      lifetime: 1.5,
      velocitySpreadAngleDegrees: 45,
      velocitySpreadMagnitude: 100,
      rotationSpeed: 180,
      startSize: 0.25,
      endSize: 0.08,
      startAlpha: 255,
      endAlpha: 0,
      maxParticles: 100
    })
    emitter.image = m.game.getBitmap("spark")
    emitter.start()
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    else if input.press and input.isButton("fastforward")
      goToNextRoom(m, 1)
    else if input.press and input.isButton("rewind")
      goToNextRoom(m, -1)
    end if
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    font = m.game.getFont("default")
    center = uiRenderer.getCanvasCenter()
    uiRenderer.DrawText("Image Particles: sprites spin (rotationSpeed) and shrink/fade", center.x, 100, BGE.Colors.white, font, "center")
    uiRenderer.DrawText("Change Room: <</>>  |  Back: Back", center.x, 140, BGE.Colors.white, font, "center")
  end sub

end class
