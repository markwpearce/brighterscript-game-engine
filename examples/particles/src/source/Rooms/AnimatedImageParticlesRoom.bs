' Continuous emission of BGE.ParticleShape.Image particles using a sprite-sheet (cellWidth/cellHeight),
' cycling through each frame of the sheet over the particle's lifetime as it shrinks and
' fades. Requires main.bs to have already loaded the "fireball" bitmap via
' Game.loadBitmap(). See src/sprites/CREDITS.md for the sheet's attribution.
class AnimatedImageParticlesRoom extends BGE.Room

  fireballs as BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "AnimatedImageParticlesRoom"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.fireballs = new BGE.GameEntity(m.game, {name: "Fireballs", position: BGE.Math.VectorOps.create(m.game.canvas.getWidth() / 2, m.game.canvas.getHeight() / 2)})
    m.game.addEntity(m.fireballs)
    emitter = m.fireballs.addParticles("fireballs", BGE.ParticleShape.Image, {
      spawnRate: 8,
      lifetime: 1.2,
      velocitySpreadAngleDegrees: 360,
      velocitySpreadMagnitude: 60,
      startSize: 0.5,
      endSize: 0.5,
      startAlpha: 255,
      endAlpha: 0,
      cellWidth: 128,
      cellHeight: 128,
      maxParticles: 40
    })
    emitter.image = m.game.getBitmap("fireball")
    emitter.start()
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    else if input.press and input.isButton("fastforward")
      goToNextRoom(m, 1)
    else if input.press and input.isButton("rewind")
      goToNextRoom(m, -1)
    end if
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    font = m.game.getFont("default")
    center = uiRenderer.getCanvasCenter()
    uiRenderer.DrawText("Animated Image Particles: sprite-sheet frames cycle over each particle's lifetime", center.x, 100, BGE.Colors.white, font, "center")
    uiRenderer.DrawText("Change Room: <</>>  |  Back: Back", center.x, 140, BGE.Colors.white, font, "center")
  end sub

end class
