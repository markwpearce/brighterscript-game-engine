' Cycles between the rooms registered in main.bs, in the order returned by main.bs's
' own getRoomNames() (not Game.getRoomNames(), which comes back alphabetized rather
' than in definition order). Shared by every room's onInput handler.
sub goToNextRoom(currentRoom as BGE.Room, direction as integer)
  game = currentRoom.game

  currentIndex = 0
  i = 0
  roomNames = getRoomNames()
  for each name in roomNames
    if currentRoom.name = name
      currentIndex = i
      exit for
    end if
    i++
  end for

  nextIndex = currentIndex + direction

  if nextIndex >= roomNames.count()
    nextIndex = 0
  else if nextIndex < 0
    nextIndex = roomNames.count() - 1
  end if

  game.changeRoom(roomNames[nextIndex])
end sub
