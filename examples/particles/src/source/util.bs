' Cycles between the scenes registered in main.bs, in the order returned by main.bs's
' own getSceneNames() (not Game.getSceneNames(), which comes back alphabetized rather
' than in definition order). Shared by every scene's onInput handler.
sub goToNextScene(currentScene as BGE.Scene, direction as integer)
  game = currentScene.game

  currentIndex = 0
  i = 0
  sceneNames = getSceneNames()
  for each name in sceneNames
    if currentScene.name = name
      currentIndex = i
      exit for
    end if
    i++
  end for

  nextIndex = currentIndex + direction

  if nextIndex >= sceneNames.count()
    nextIndex = 0
  else if nextIndex < 0
    nextIndex = sceneNames.count() - 1
  end if

  game.changeScene(sceneNames[nextIndex])
end sub
