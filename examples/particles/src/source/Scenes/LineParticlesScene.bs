' Continuous emission of BGE.ParticleShape.Line particles - short yellow-to-red streaks radiating
' outward from a stationary emitter, fading out and shrinking over their lifetime.
class LineParticlesScene extends BGE.GameScene

  sparks as BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "LineParticlesScene"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.sparks = new BGE.GameEntity(m.game, {name: "Sparks", position: BGE.Math.VectorOps.create(m.game.canvas.getWidth() / 2, m.game.canvas.getHeight() / 2)})
    m.game.addEntity(m.sparks)
    emitter = m.sparks.addParticles("sparks", BGE.ParticleShape.Line, {
      spawnRate: 60,
      lifetime: 0.6,
      lifetimeSpread: 0.2,
      velocitySpreadMagnitude: 220,
      startColor: BGE.ColorsRGB.Yellow,
      endColor: BGE.ColorsRGB.Red,
      startAlpha: 255,
      endAlpha: 0,
      startSize: 14,
      endSize: 4,
      maxParticles: 200
    })
    emitter.start()
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    font = m.game.getFont("default")
    center = uiRenderer.getCanvasCenter()
    uiRenderer.DrawText("Line Particles: continuous emission, color fades yellow -> red", center.x, 100, BGE.Colors.white, font, "center")
  end sub

end class
