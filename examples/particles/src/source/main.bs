sub Main()
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.fitCanvasToScreen()

  game.loadBitmap("spark", "pkg:/sprites/spark.png")
  game.loadBitmap("fireball", "pkg:/sprites/fireball.png")

  game.defineScene(new LineParticlesScene(game))
  game.defineScene(new RectangleParticlesScene(game))
  game.defineScene(new ImageParticlesScene(game))
  game.defineScene(new AnimatedImageParticlesScene(game))
  game.defineScene(new MovingEmitterScene(game))
  game.defineScene(new BurstScene(game))
  game.defineScene(new StressScene(game))

  game.changeScene(getSceneNames()[0])

  game.play()
end sub

' Explicit demo order for fastforward/rewind cycling (see util.bs's goToNextScene) -
' Game.getSceneNames() comes back alphabetized, not in definition order, so this repo's
' other multi-scene examples (e.g. examples/3d) define their own ordered list instead.
function getSceneNames() as string[]
  return ["LineParticlesScene", "RectangleParticlesScene", "ImageParticlesScene", "AnimatedImageParticlesScene", "MovingEmitterScene", "BurstScene", "StressScene"]
end function
