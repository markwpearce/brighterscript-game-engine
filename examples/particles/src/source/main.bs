sub Main()
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.fitCanvasToScreen()

  game.loadBitmap("spark", "pkg:/sprites/spark.png")
  game.loadBitmap("fireball", "pkg:/sprites/fireball.png")

  game.defineRoom(new LineParticlesRoom(game))
  game.defineRoom(new RectangleParticlesRoom(game))
  game.defineRoom(new ImageParticlesRoom(game))
  game.defineRoom(new AnimatedImageParticlesRoom(game))
  game.defineRoom(new MovingEmitterRoom(game))
  game.defineRoom(new BurstRoom(game))
  game.defineRoom(new StressRoom(game))

  game.changeRoom(getRoomNames()[0])

  game.play()
end sub

' Explicit demo order for fastforward/rewind cycling (see util.bs's goToNextRoom) -
' Game.getRoomNames() comes back alphabetized, not in definition order, so this repo's
' other multi-room examples (e.g. examples/3d) define their own ordered list instead.
function getRoomNames() as string[]
  return ["LineParticlesRoom", "RectangleParticlesRoom", "ImageParticlesRoom", "AnimatedImageParticlesRoom", "MovingEmitterRoom", "BurstRoom", "StressRoom"]
end function
