' Interactive showcase of BGE.TweenManager. Three boxes, one per tween "aspect":
'   SlideBox - position, via to()
'   PulseBox - scale, via to() with loop = pingPong
'   FadeBox  - color, via toColorRGB() with loop = pingPong
'
' up/down cycles the selected easing, left/right cycles which box is "active", select (OK)
' re-triggers the active box's tween using the currently selected easing.
class MainRoom extends BGE.Room

  easings = [
    BGE.Tweens.Easing.LinearTween,
    BGE.Tweens.Easing.QuadraticEaseInOut,
    BGE.Tweens.Easing.CubicEaseIn,
    BGE.Tweens.Easing.SinusoidalEaseInOut,
    BGE.Tweens.Easing.ExponentialEaseOut,
    BGE.Tweens.Easing.CircularEaseInOut,
    BGE.Tweens.Easing.ElasticEaseOut,
    BGE.Tweens.Easing.OvershootEaseOut,
    BGE.Tweens.Easing.BounceEaseOut
  ]
  easingIndex = 0

  aspectNames = ["Position (SlideBox)", "Scale (PulseBox)", "Color (FadeBox)"]
  aspectIndex = 0

  slideBox as SlideBox
  pulseBox as PulseBox
  fadeBox as FadeBox

  label as BGE.UI.Label

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainRoom"
    m.label = new BGE.UI.Label(m.game)
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.slideBox = new SlideBox(m.game)
    m.game.addEntity(m.slideBox)

    m.pulseBox = new PulseBox(m.game)
    m.game.addEntity(m.pulseBox)

    m.fadeBox = new FadeBox(m.game)
    m.game.addEntity(m.fadeBox)

    m.label.customPosition = true
    m.label.customX = 20
    m.label.customY = 20
    m.game.gameUi.addChild(m.label)
    m.updateLabel()
  end sub

  override sub onChangeRoom(newRoom as BGE.Room)
    m.game.gameUi.removeChild(m.label)
  end sub

  override sub onInput(input as BGE.GameInput)
    if not input.press
      return
    end if
    if input.isButton("up")
      m.easingIndex = (m.easingIndex + 1) mod m.easings.count()
      m.updateLabel()
    else if input.isButton("down")
      m.easingIndex = m.easingIndex - 1
      if m.easingIndex < 0
        m.easingIndex = m.easings.count() - 1
      end if
      m.updateLabel()
    else if input.isButton("right")
      m.aspectIndex = (m.aspectIndex + 1) mod m.aspectNames.count()
      m.updateLabel()
    else if input.isButton("left")
      m.aspectIndex = m.aspectIndex - 1
      if m.aspectIndex < 0
        m.aspectIndex = m.aspectNames.count() - 1
      end if
      m.updateLabel()
    else if input.isButton("ok")
      m.playActiveTween()
    else if input.isButton("back")
      m.game.End()
    end if
  end sub

  private sub playActiveTween()
    easing = m.easings[m.easingIndex]
    if m.aspectIndex = 0
      m.slideBox.playTween(easing)
    else if m.aspectIndex = 1
      m.pulseBox.playTween(easing)
    else
      m.fadeBox.playTween(easing)
    end if
  end sub

  private sub updateLabel()
    easingName = m.easings[m.easingIndex]
    aspectName = m.aspectNames[m.aspectIndex]
    m.label.setText(`Easing: ${easingName}   |   Aspect: ${aspectName}` + Chr(10) + "Up/Down: change easing   Left/Right: change aspect   OK: play")
  end sub

end class
