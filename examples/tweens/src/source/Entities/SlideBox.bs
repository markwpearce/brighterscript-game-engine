' Slides left-to-right using BGE.TweenManager.to() on its own position.x.
class SlideBox extends BGE.GameEntity

  ' World space is y-up with the origin at the bottom-left of the canvas (Camera2d's
  ' default target is (canvasWidth / 2, canvasHeight / 2), not the origin) - so these are
  ' comfortably inside a 1280x720 canvas, not centered on world (0,0).
  startX = 128.0
  endX = 1092.0
  activeHandle = -1

  sub new(game as BGE.Game)
    super(game)
    m.name = "SlideBox"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = m.startX
    m.position.y = 600
    m.addRectangle("body", 60, 60, {color: BGE.ColorsRGB.Cyan})
  end sub

  sub playTween(easing as BGE.Tweens.Easing)
    if m.activeHandle > -1
      m.game.tweenManager.cancel(m.activeHandle)
    end if
    m.position.x = m.startX
    m.activeHandle = m.game.tweenManager.to(m.position, {x: m.endX}, 1200, easing, {owner: m})
  end sub

end class
