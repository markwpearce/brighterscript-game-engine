' Pulses in and out using BGE.TweenManager.to() on its own scale, looping pingPong so it
' keeps pulsing once triggered.
class PulseBox extends BGE.GameEntity

  activeHandle = -1

  sub new(game as BGE.Game)
    super(game)
    m.name = "PulseBox"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = 640
    m.position.y = 360
    m.addRectangle("body", 60, 60, {color: BGE.ColorsRGB.Magenta})
  end sub

  sub playTween(easing as BGE.Tweens.Easing)
    if m.activeHandle > -1
      m.game.tweenManager.cancel(m.activeHandle)
    end if
    m.scale = BGE.Math.VectorOps.create(1, 1, 1)
    m.activeHandle = m.game.tweenManager.to(m.scale, {x: 1.8, y: 1.8}, 500, easing, {
      owner: m,
      loop: BGE.Tweens.TweenLoopMode.pingPong
    })
  end sub

end class
