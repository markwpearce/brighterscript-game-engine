' Fades between two colors using BGE.TweenManager.toColorRGB() on its Drawable's own
' color field, looping pingPong so it keeps fading back and forth once triggered.
class FadeBox extends BGE.GameEntity

  activeHandle = -1
  box as BGE.DrawableRectangle

  sub new(game as BGE.Game)
    super(game)
    m.name = "FadeBox"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position.x = 640
    m.position.y = 170
    m.box = m.addRectangle("body", 60, 60, {color: BGE.ColorsRGB.Yellow})
  end sub

  sub playTween(easing as BGE.Tweens.Easing)
    if m.activeHandle > -1
      m.game.tweenManager.cancel(m.activeHandle)
    end if
    m.box.color = BGE.ColorsRGB.Yellow
    m.activeHandle = m.game.tweenManager.toColorRGB(m.box, "color", BGE.ColorsRGB.Blue, 700, easing, {
      owner: m,
      loop: BGE.Tweens.TweenLoopMode.pingPong
    })
  end sub

end class
