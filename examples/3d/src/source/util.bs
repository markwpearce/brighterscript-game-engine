
' The next SceneObjectDrawMode in the cycle, wrapping back around to the first.
'
' @param {BGE.SceneObjectDrawMode} current
' @return {BGE.SceneObjectDrawMode}
function nextDrawMode(current as BGE.SceneObjectDrawMode) as BGE.SceneObjectDrawMode
  if current >= BGE.MAX_DRAW_MODE
    return 0 as BGE.SceneObjectDrawMode
  end if
  return current + 1
end function


' Puts every drawable on an entity into the given draw mode.
'
' @param {BGE.GameEntity} entity
' @param {BGE.SceneObjectDrawMode} drawMode
sub applyDrawMode(entity as BGE.GameEntity, drawMode as BGE.SceneObjectDrawMode)
  for each drawable in entity.drawables
    drawable.drawMode = drawMode
  end for
end sub
