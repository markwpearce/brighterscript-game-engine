sub main(args as dynamic)

  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.scaleCanvasToFillScreen()

  camera = new BGE.Camera3d()
  camera.maxDrawDistance = 2000
  game.setCamera(camera)

  ' Deep link `quality=<0-4>` pins the render quality level (basic to ultra) for measuring
  if args <> invalid and args.quality <> invalid
    game.setQualityLevel(args.quality.toInt() as BGE.RenderQualityLevel)
  else
    game.enableAdaptiveQuality()
  end if

  game.loadBitmap("roku", "pkg:/sprites/roku-logo-purple.png")
  game.load3dModel("bird", "pkg:/models/low_poly_bird.stl")
  game.load3dModel("car", "pkg:/models/car.obj", {texturePath: "pkg:/sprites/car_texture.png"})
  game.load3dModel("d20", "pkg:/models/d20.obj")
  game.registerFont("pkg:/fonts/BADABB__.TTF")
  game.loadFont("badaboom-96", "BadaBoom BB", 96, false, false)

  cubes_scene = new CubesScene(game)
  game.defineScene(cubes_scene)

  trees_scene = new TreesScene(game)
  game.defineScene(trees_scene)

  images_scene = new ImagesScene(game)
  game.defineScene(images_scene)

  poly_scene = new PolyScene(game)
  game.defineScene(poly_scene)

  rectangles_scene = new RectanglesScene(game)
  game.defineScene(rectangles_scene)

  circles_scene = new CirclesScene(game)
  game.defineScene(circles_scene)

  model_scene = new ModelScene(game)
  game.defineScene(model_scene)

  car_scene = new CarScene(game)
  game.defineScene(car_scene)

  d20_scene = new D20Scene(game)
  game.defineScene(d20_scene)

  text_scene = new TextScene(game)
  game.defineScene(text_scene)

  anchor_scene = new AnchorScene(game)
  game.defineScene(anchor_scene)

  ' Deep links: `impostor=0` turns off every model's DrawableModel.useImpostor (#345),
  ' `pin=0` just its corner pin (useImpostorPin), `scene=<name>` starts on that scene
  if args <> invalid and args.impostor <> invalid
    GetGlobalAA().useImpostors = not (args.impostor = "0" or args.impostor = "false")
  end if
  if args <> invalid and args.pin <> invalid
    GetGlobalAA().useImpostorPins = not (args.pin = "0" or args.pin = "false")
  end if
  startScene = getSceneNames()[0]
  if args <> invalid and args.scene <> invalid
    startScene = args.scene
  end if
  game.changeScene(startScene)

  game.enableStandardDebugUi()

  game.debugDrawEntityDetails(true)
  game.debugShowUi(true, true)
  game.Play()

end sub

function getSceneNames() as string[]
  return ["ImagesScene", "TextScene", "ModelScene", "CarScene", "D20Scene", "CubesScene", "RectanglesScene", "CirclesScene", "PolyScene", "TreesScene", "AnchorScene"]
end function


sub goToNextScene(currentScene as BGE.GameScene, direction as integer)

  currentIndex = 0
  i = 0
  sceneNames = getSceneNames()
  for each name in sceneNames
    if currentScene.name = name
      currentIndex = i
      exit for
    end if
    i++
  end for

  nextIndex = currentIndex + direction

  if nextIndex >= sceneNames.count()
    nextIndex = 0
  else if nextIndex < 0
    nextIndex = sceneNames.count() - 1
  end if

  currentScene.game.changeScene(sceneNames[nextIndex])
  currentScene.game.canvas.renderer.camera.useDefaultCameraTarget()
  currentScene.game.canvas.renderer.camera.position.y = 30
end sub

' Whether models use impostors - on unless the `impostor` deep link turned them off.
function useImpostors() as boolean
  return false <> GetGlobalAA().useImpostors
end function

' Whether model impostors may corner pin - on unless the `pin` deep link turned it off.
function useImpostorPins() as boolean
  return false <> GetGlobalAA().useImpostorPins
end function
