sub main(args as dynamic)

  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.scaleCanvasToFillScreen()

  camera = new BGE.Camera3d()
  camera.maxDrawDistance = 2000
  game.setCamera(camera)

  ' Deep link `quality=<0-4>` pins the render quality level (basic to ultra) for measuring
  params = new BGE.LaunchParams(args)
  if not game.applyLaunchQuality(params)
    game.enableAdaptiveQuality()
  end if

  game.loadBitmap("roku", "pkg:/sprites/roku-logo-purple.png")
  game.load3dModel("bird", "pkg:/models/low_poly_bird.stl")
  game.load3dModel("car", "pkg:/models/car/car.obj")
  game.load3dModel("d20", "pkg:/models/d20.obj")
  game.registerFont("pkg:/fonts/BADABB__.TTF")
  game.loadFont("badaboom-96", "BadaBoom BB", 96, false, false)

  ' FF/RW step through the scenes in this order
  game.defineScene(new ImagesScene(game))
  game.defineScene(new TextScene(game))
  game.defineScene(new ModelScene(game))
  game.defineScene(new CarScene(game))
  game.defineScene(new D20Scene(game))
  game.defineScene(new CubesScene(game))
  game.defineScene(new RectanglesScene(game))
  game.defineScene(new CirclesScene(game))
  game.defineScene(new PolyScene(game))
  game.defineScene(new TreesScene(game))
  game.defineScene(new AnchorScene(game))
  cycler = new DemoSceneCycler(game)
  game.addEntity(cycler)

  ' Deep links: `impostor=0` turns off every model's DrawableModel.useImpostor (#345),
  ' `scene=<name>` starts on that scene
  if params.has("impostor")
    GetGlobalAA().useImpostors = params.getBool("impostor", true)
  end if
  sceneNames = game.getSceneNames()
  game.changeScene(params.sceneName(sceneNames, sceneNames[0]))

  game.enableStandardDebugUi()

  game.debugDrawEntityDetails(true)
  game.debugShowUi(true, true)
  game.applyLaunchSplash(params)
  game.Play()

end sub

' Back quits, FF/RW change scene and put the camera back where every scene expects it.
class DemoSceneCycler extends BGE.SceneCycler
  sub new(game as BGE.Game)
    super(game)
  end sub

  override sub onSceneChanged(sceneName as string)
    camera = m.game.canvas.renderer.camera
    camera.useDefaultCameraTarget()
    camera.position.y = 30
  end sub
end class

' Whether models use impostors - on unless the `impostor` deep link turned them off.
function useImpostors() as boolean
  return false <> GetGlobalAA().useImpostors
end function
