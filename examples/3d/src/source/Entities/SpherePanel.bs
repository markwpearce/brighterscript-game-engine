' A sphere standing in 3D space, drawn with a BGE.DrawableSphere - always an
' undistorted circle regardless of camera angle or its own rotation, unlike
' CirclePanel (a flat disc) right next to it in the ring, which foreshortens into an
' ellipse as it turns away from the camera in the oriented draw modes. DrawableSphere
' forces its own drawMode to directScaled internally, so cycling the room's draw mode
' with Play has no visible effect on these panels - that's the point of the comparison.
class SpherePanel extends BGE.GameEntity

  radius = 150
  spinSpeed = 0.6
  doRotation = false

  sphere as BGE.DrawableSphere

  sub new(game as BGE.Game)
    super(game)
    m.name = "SpherePanel"
  end sub

  override sub onCreate(args as roAssociativeArray)
    if invalid <> args.radius
      m.radius = args.radius
    end if

    fillColor = args.color ?? BGE.getRandomColorRGB()
    sphereArgs = {
      color: fillColor,
      offset: BGE.Math.VectorOps.create(-m.radius, m.radius, 0),
      isShaded: true
    }
    if BGE.isTrue(args.outlined)
      sphereArgs.outlineRGBA = BGE.ColorsRGB.White
      sphereArgs.outlineWidth = 2
    end if

    m.sphere = m.addSphere("sphere", m.radius, sphereArgs)
  end sub

  override sub onUpdate(deltaTime as float)
    if m.doRotation
      m.rotation.y += deltaTime * m.spinSpeed
    end if
    ' BaseRoom's Play button cycles every entity's drawables to the same
    ' SceneObjectDrawMode (see applyDrawMode in util.bs) - reasserted here every frame
    ' so that override can't stick, since the entire point of this panel is that it
    ' always stays directScaled regardless of what the rest of the room is cycling
    ' through.
    m.sphere.drawMode = BGE.SceneObjectDrawMode.directScaled
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("ok")
      m.doRotation = not m.doRotation
    end if
  end sub

end class
