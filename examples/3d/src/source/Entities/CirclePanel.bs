' A flat circle standing in 3D space, drawn with a BGE.DrawableCircle.
'
' Like RectanglePanel, this shows off what SceneObjectDrawMode does: in `oriented` it
' turns edge-on and foreshortens into a thinner and thinner ellipse as it rotates away
' from you, in `directToCamera` it stays a perfect circle no matter which way it's
' facing, and in `wireFrame` only its circular outline is drawn. Cycle modes with the
' Play button - see BaseRoom. Compare against SpherePanel, right next to each of these
' in the ring - a sphere never foreshortens, regardless of draw mode or rotation.
class CirclePanel extends BGE.GameEntity

  radius = 150
  spinSpeed = 0.6
  doRotation = false

  circle as BGE.DrawableCircle

  sub new(game as BGE.Game)
    super(game)
    m.name = "CirclePanel"
  end sub

  override sub onCreate(args as roAssociativeArray)
    if invalid <> args.radius
      m.radius = args.radius
    end if

    fillColor = args.color ?? BGE.getRandomColorRGB()
    circleArgs = {
      color: fillColor,
      offset: BGE.Math.VectorOps.create(-m.radius, m.radius, 0),
      isShaded: true
    }
    if BGE.isTrue(args.outlined)
      circleArgs.outlineRGBA = BGE.ColorsRGB.White
      circleArgs.outlineWidth = 2
    end if

    m.circle = m.addCircle("circle", m.radius, circleArgs)

    if invalid <> args.drawMode
      m.circle.drawMode = args.drawMode
    end if
  end sub

  override sub onUpdate(deltaTime as float)
    if m.doRotation
      m.rotation.y += deltaTime * m.spinSpeed
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("ok")
      m.doRotation = not m.doRotation
    end if
  end sub

end class
