' A single flat rectangle standing in 3D space, drawn with a BGE.DrawableRectangle.
'
' A rectangle is the simplest thing that shows off what SceneObjectDrawMode does,
' because it has an orientation but no texture: in `oriented` it turns edge-on and
' disappears as it rotates away from you (and vanishes entirely once it's facing
' away, unless the mode draws back faces), in `directToCamera` it stays square to
' the screen no matter which way it's facing, and in `wireFrame` only its outline
' is drawn. Cycle modes with the Play button - see BaseRoom.
class RectanglePanel extends BGE.GameEntity

  size = 300
  spinSpeed = 0.6
  doRotation = false

  rectangle as BGE.DrawableRectangle

  sub new(game as BGE.Game)
    super(game)
    m.name = "RectanglePanel"
  end sub

  override sub onCreate(args as roAssociativeArray)
    if invalid <> args.size
      m.size = args.size
    end if

    ' Anchored at its top left corner and extending right/downwards, so shifting it
    ' by half its size in each direction centers the panel on the entity's position.
    fillColor = args.color ?? BGE.getRandomColorRGB()
    rectangleArgs = {
      color: fillColor,
      offset: BGE.Math.VectorOps.create(-m.size / 2, m.size / 2, 0),
      ' shading darkens each panel by how squarely it faces the camera, which makes
      ' the ring of panels read as 3D rather than as flat cut-outs
      isShaded: true
    }
    if BGE.isTrue(args.outlined)
      rectangleArgs.outlineRGBA = BGE.ColorsRGB.White
      rectangleArgs.outlineWidth = 2
    end if
    if BGE.isTrue(args.outlineOnly)
      ' an unfilled rectangle is just its outline - and needs an outline color set,
      ' or there would be nothing at all to draw
      rectangleArgs.filled = false
      rectangleArgs.outlineRGBA = fillColor
      rectangleArgs.outlineWidth = 2
    end if

    m.rectangle = m.addRectangle("panel", m.size, m.size, rectangleArgs)

    if invalid <> args.drawMode
      m.rectangle.drawMode = args.drawMode
    end if
  end sub

  override sub onUpdate(deltaTime as float)
    if m.doRotation
      m.rotation.y += deltaTime * m.spinSpeed
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("ok")
      m.doRotation = not m.doRotation
    end if
  end sub

end class
