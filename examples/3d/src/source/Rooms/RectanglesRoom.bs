' Shows off BGE.DrawableRectangle in 3D, and what each SceneObjectDrawMode does to it.
'
' The panels are laid out as a ring facing outwards from the center plus a row of
' three in front of it, so from any camera angle some panels are square-on to you,
' some are edge-on, and some are facing away. Cycling the draw mode with Play then
' makes the differences obvious:
'
'   matchCamera            - follow the camera (a Camera3d means `oriented`)
'   directToCamera         - stay square to the screen however they're rotated
'   directScaled           - as above, but shrinking with distance
'   oriented               - turn in 3D; panels facing away vanish
'   orientedDrawBackFace   - as above, but back faces are drawn too
'   wireFrame              - outlines only
'   solid                  - flat filled quads, no shading
class RectanglesRoom extends BaseRoom

  ringPanelCount = 6
  ringRadius = 700
  panelSize = 320

  panels = []

  sub new(game as BGE.Game)
    super(game)
    m.name = "RectanglesRoom"
    m.instructions = "Rotation Toggle: OK | Redraw Panels: *"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.addPanels()
  end sub

  override sub onChangeRoom(newRoom as BGE.Room)
    m.clearPanels()
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("options")
      m.clearPanels()
      m.addPanels()
    end if
    super.onInput(input)
  end sub

  private sub addPanels()
    ' The ring: each panel sits on the circle and is turned to face outwards from its
    ' center, so the set of them covers every orientation relative to the camera.
    for i = 0 to m.ringPanelCount - 1
      angle = 2 * BGE.Math.PI * i / m.ringPanelCount
      m.addPanel(m.ringRadius * sin(angle), 0, -m.ringRadius * cos(angle), {
        rotationY: angle,
        ' every other one gets a white border, to show an outline drawn over a fill
        outlined: (i mod 2) = 0
      })
    end for

    ' A row in front of the ring showing the three fill/outline combinations a
    ' DrawableRectangle supports: filled, filled with an outline, and outline only.
    rowZ = 500
    rowY = -420
    m.addPanel(-500, rowY, rowZ, {color: BGE.ColorsRGB.Red})
    m.addPanel(0, rowY, rowZ, {color: BGE.ColorsRGB.Lime, outlined: true})
    m.addPanel(500, rowY, rowZ, {color: BGE.ColorsRGB.Cyan, outlineOnly: true})
  end sub

  private sub addPanel(x as float, y as float, z as float, args = {} as roAssociativeArray)
    panel = new RectanglePanel(m.game)
    panel.position = BGE.Math.VectorOps.create(x, y, z)
    if invalid <> args.rotationY
      panel.rotation.y = args.rotationY
    end if
    args.size = m.panelSize
    ' Panels created after the draw mode has been cycled need to start on the current
    ' mode, or the newly added ones would draw differently to everything else.
    args.drawMode = m.drawMode
    m.game.addEntity(panel, args)
    m.panels.push(panel)
  end sub

  private sub clearPanels()
    for each panel in m.panels
      panel.invalidate()
    end for
    m.panels = []
  end sub

end class
