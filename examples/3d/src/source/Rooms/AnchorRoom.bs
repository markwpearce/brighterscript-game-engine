' Demonstrates BGE.Drawable.setAnchor(): two directScaled billboards sitting at the same
' "ground" y-position, one left at the default top-left anchor and one anchored at
' (0.5, 1) - bottom-center. Move the camera closer (up arrow) and the default billboard's
' visual mass stays fixed on its position while it grows downward from there, but the
' bottom-anchored one keeps its base planted at ground level as it scales - the effect
' the standing "locked position... trees" TODO in SceneObjectBillboard was about.
class AnchorRoom extends BaseRoom

  billboards = []

  sub new(game as BGE.Game)
    super(game)
    m.name = "AnchorRoom"
    m.instructions = "Left: default anchor (0,0) | Right: setAnchor(0.5, 1) | Move camera closer with up"
  end sub

  override sub onCreate(args as roAssociativeArray)
    groundY = -150
    rokuBitmap = m.game.getBitmap("roku")

    defaultAnchor = new BGE.GameEntity(m.game)
    defaultAnchor.name = "DefaultAnchorBillboard"
    defaultAnchor.position = BGE.Math.VectorOps.create(-300, groundY, 0)
    defaultRegion = CreateObject("roRegion", rokuBitmap, 0, 0, rokuBitmap.getWidth(), rokuBitmap.getHeight())
    defaultAnchor.addImage("logo", defaultRegion, {
      scale: BGE.Math.VectorOps.create(0.5, 0.5, 1),
      drawMode: BGE.SceneObjectDrawMode.directScaled
    })
    m.game.addEntity(defaultAnchor)
    m.billboards.push(defaultAnchor)

    bottomAnchor = new BGE.GameEntity(m.game)
    bottomAnchor.name = "BottomAnchorBillboard"
    bottomAnchor.position = BGE.Math.VectorOps.create(100, groundY, 0)
    bottomRegion = CreateObject("roRegion", rokuBitmap, 0, 0, rokuBitmap.getWidth(), rokuBitmap.getHeight())
    bottomImage = bottomAnchor.addImage("logo", bottomRegion, {
      scale: BGE.Math.VectorOps.create(0.5, 0.5, 1),
      drawMode: BGE.SceneObjectDrawMode.directScaled
    })
    bottomImage.setAnchor(0.5, 1)
    m.game.addEntity(bottomAnchor)
    m.billboards.push(bottomAnchor)
  end sub

  override sub onChangeRoom(newRoom as BGE.Room)
    for each obj in m.billboards
      obj.invalidate()
    end for
    m.billboards = []
  end sub

end class
