' Shows off BGE.DrawableCircle/DrawableSphere in 3D, and what each SceneObjectDrawMode
' does to them.
'
' The ring alternates CirclePanel (a flat disc) and SpherePanel (always round) facing
' outwards from the center, so as you orbit the camera (arrows) the circles visibly
' foreshorten into ellipses in the oriented draw modes while the spheres right next to
' them stay perfectly round - that comparison is the point of this room. A front row of
' three shows the fill/outline combinations a DrawableCircle supports.
'
'   matchCamera            - follow the camera (a Camera3d means `oriented`)
'   directToCamera         - stay a perfect circle however they're rotated
'   directScaled           - as above, but shrinking with distance
'   oriented               - turn in 3D; circles foreshorten into ellipses edge-on
'   orientedDrawBackFace   - as above, but back faces are drawn too
'   wireFrame              - outlines only
'   solid                  - visually identical to oriented for a circle (both use the
'                            same cached texture warp - see SceneObjectCircle)
class CirclesRoom extends BaseRoom

  ringPanelCount = 6
  ringRadius = 900
  panelRadius = 80

  panels = []

  sub new(game as BGE.Game)
    super(game)
    m.name = "CirclesRoom"
    m.instructions = "Rotation Toggle: OK | Redraw Panels: *"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.addPanels()
  end sub

  override sub onChangeRoom(newRoom as BGE.Room)
    m.clearPanels()
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("options")
      m.clearPanels()
      m.addPanels()
    end if
    super.onInput(input)
  end sub

  private sub addPanels()
    ' The ring: alternating circle/sphere, each turned to face outwards from the
    ' center, so every orientation relative to the camera is covered - and the
    ' circle/sphere difference is directly comparable at every angle.
    for i = 0 to m.ringPanelCount - 1
      angle = 2 * BGE.Math.PI * i / m.ringPanelCount
      x = m.ringRadius * sin(angle)
      z = -m.ringRadius * cos(angle)
      if (i mod 2) = 0
        m.addCirclePanel(x, 0, z, {rotationY: angle, outlined: true})
      else
        m.addSpherePanel(x, 0, z, {outlined: true})
      end if
    end for

    ' A row in front showing the fill/outline combinations a DrawableCircle supports,
    ' plus a sphere alongside for a direct, non-rotated comparison.
    rowZ = 500
    rowY = -420
    m.addCirclePanel(-500, rowY, rowZ, {color: BGE.ColorsRGB.Red})
    m.addCirclePanel(0, rowY, rowZ, {color: BGE.ColorsRGB.Lime, outlined: true})
    m.addSpherePanel(500, rowY, rowZ, {color: BGE.ColorsRGB.Cyan, outlined: true})
  end sub

  private sub addCirclePanel(x as float, y as float, z as float, args = {} as roAssociativeArray)
    panel = new CirclePanel(m.game)
    panel.position = BGE.Math.VectorOps.create(x, y, z)
    if invalid <> args.rotationY
      panel.rotation.y = args.rotationY
    end if
    args.radius = m.panelRadius
    ' Panels created after the draw mode has been cycled need to start on the current
    ' mode, or the newly added ones would draw differently to everything else.
    args.drawMode = m.drawMode
    m.game.addEntity(panel, args)
    m.panels.push(panel)
  end sub

  private sub addSpherePanel(x as float, y as float, z as float, args = {} as roAssociativeArray)
    panel = new SpherePanel(m.game)
    panel.position = BGE.Math.VectorOps.create(x, y, z)
    args.radius = m.panelRadius
    m.game.addEntity(panel, args)
    m.panels.push(panel)
  end sub

  private sub clearPanels()
    for each panel in m.panels
      panel.invalidate()
    end for
    m.panels = []
  end sub

end class
