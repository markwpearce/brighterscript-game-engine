class CarScene extends BaseScene

  car as CarModel3d

  sub new(game as BGE.Game)
    super(game)
    m.name = "CarScene"
    m.instructions = "Rotation Toggle: OK"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.car = new CarModel3d(m.game)
    m.game.addEntity(m.car)
  end sub

  override sub onChangeScene(newScene as BGE.Scene)
    m.car.invalidate()
  end sub

end class
