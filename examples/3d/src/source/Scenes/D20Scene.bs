class D20Scene extends BaseScene

  d20 as D20Model3d

  sub new(game as BGE.Game)
    super(game)
    m.name = "D20Scene"
    m.instructions = "Rotation Toggle: OK"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.d20 = new D20Model3d(m.game)
    m.game.addEntity(m.d20)
  end sub

  override sub onChangeScene(newScene as BGE.Scene)
    m.d20.invalidate()
  end sub

end class
