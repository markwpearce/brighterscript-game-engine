' The game's entry point - a real title screen (big "ASTEROIDS" heading,
' control hint, a focus-driven Start Game button) rather than a bare
' "Press OK To Play" prompt drawn over gameplay, matching examples/
' platformer's TitleScene pattern. MainScene itself still has its own
' lightweight in-place "Press OK To Play"/"Game Over!" prompt for restarting
' after death without leaving back to this screen - see
' MainScene.updateStartScreenLabels().
'
' Every widget below is centered via horizAlign/vertAlign (the engine's own
' layout - see UiWidget.getWorldPosition()) rather than hand-measuring text
' width, so each widget is added straight to gameUi with customPosition left
' false - horizAlign="center"/vertAlign positions it relative to its parent
' (gameUi, which spans the whole canvas), the same pattern
' examples/platformer's TitleScene uses for its own hint/button stack.
class TitleScene extends BGE.Scene

  backgroundImage as BGE.Image

  sub new(game as BGE.Game)
    super(game)
    m.name = "TitleScene"
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' gameUi persists across a scene change (unlike entities) - clear it in
    ' case this scene is ever re-entered later, matching
    ' examples/platformer's TitleScene.
    m.game.gameUi.clearChildren()

    screenWidth = m.game.canvas.getWidth()
    screenHeight = m.game.canvas.getHeight()
    backgroundBmp = m.game.getBitmap("background")
    region = CreateObject("roRegion", backgroundBmp, 0, 0, backgroundBmp.getWidth(), backgroundBmp.getHeight())
    region.SetScaleMode(1)
    region.SetPreTranslation(-backgroundBmp.getWidth() / 2, -backgroundBmp.getHeight() / 2)
    m.backgroundImage = m.addImage("background", region)
    m.backgroundImage.offset.x = screenWidth / 2
    m.backgroundImage.offset.y = screenHeight / 2
    m.backgroundImage.offset.z = -10
    m.backgroundImage.scale = BGE.Math.createScaleVector(screenHeight / backgroundBmp.getHeight())

    ' Big, centered at the top. A plain Label can't carry its own font size -
    ' UiWidget.applyThemeFont() applies the resolved theme's font the first
    ' time any widget draws, unconditionally overwriting an explicit
    ' setFont() call the very same frame (only a widget's *container* can
    ' override the theme it resolves - see UiWidget.resolveTheme()) - so the
    ' heading needs its own UiContainer with a theme.font override, the same
    ' way examples/platformer's TitleScene sizes its own hint text
    ' differently than its buttons.
    titleFont = m.game.getFont("title")
    headingContainer = new BGE.UI.UiContainer(m.game)
    headingContainer.showBackground = false
    headingContainer.theme = new BGE.UI.Theme()
    headingContainer.theme.font = titleFont
    headingContainer.width = screenWidth
    headingContainer.height = titleFont.GetOneLineHeight()
    headingContainer.horizAlign = "center"
    headingContainer.vertAlign = "top"
    headingContainer.margin.top = screenHeight * 0.08
    m.game.gameUi.addChild(headingContainer)

    heading = new BGE.UI.Label(m.game)
    heading.setText("ASTEROIDS")
    heading.horizAlign = "center"
    headingContainer.addChild(heading)

    hint = new BGE.UI.Label(m.game)
    hint.setText("Move: Arrows/Stick" + Chr(10) + "Shoot: OK/A")
    hint.horizAlign = "center"
    hint.vertAlign = "center"
    m.game.gameUi.addChild(hint)

    startButton = new BGE.UI.Button(m.game)
    startButton.setLabel("Start Game")
    startFont = m.game.getFont("hud")
    startButton.width = startFont.GetOneLineWidth("Start Game", 10000) + 48.0
    startButton.height = startFont.GetOneLineHeight() + 24.0
    startButton.horizAlign = "center"
    startButton.vertAlign = "bottom"
    startButton.margin.bottom = screenHeight * 0.12
    startButton.onActivate = sub(button as BGE.UI.Button)
      button.game.changeScene("MainScene")
    end sub
    m.game.gameUi.addChild(startButton)

    ' Focuses the Start button immediately rather than leaving it unfocused
    ' until the player's first directional press - see
    ' FocusManager.ensureFocusSeeded().
    m.game.focusManager.ensureFocusSeeded()
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    end if
  end sub

end class
