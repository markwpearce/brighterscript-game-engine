sub Main()
  ' 1280x720, matching every other example's canvas - asteroids previously
  ' used a one-off 1920x1080 canvas, which turned out to make BGE.UI widget
  ' text (Label/MessagePanel, drawn via Renderer.drawTransformedObject())
  ' visibly flicker on/off on real hardware; confirmed independent of font
  ' choice (reproduced with the engine's own default font too) and confirmed
  ' gone at 1280x720 - see issue #226.
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.fitCanvasToScreen()
  game.enableControllerInput()

  ' "move" falls back to the remote d-pad automatically when no stick input is
  ' present (ControlMap.getAxis()), so a real Bluetooth gamepad's analog stick
  ' or examples/controller's web page both drive the ship smoothly, with the
  ' plain remote d-pad still working exactly as before.
  game.controls.bindAxis("move", "1", 0, "Move")
  ' "ok" (a gamepad's face button the controller-web page sends for the
  ' engine's canonical OK) and "a" (a real Bluetooth gamepad's own A face
  ' button, which the controller-web page never sends) - either fires.
  game.controls.bindAction("fire", "OK", ["ok", "a"], 0, "Fire")
  ' "back" now opens the pause panel (Resume/Quit) rather than quitting
  ' instantly - quitting only happens via the panel's own Quit button
  ' (PauseHandler.open()), matching examples/breakout's convention.
  game.controls.bindAction("pause", ["play", "back"], ["play", "start", "b"], 0, "Pause")

  ' Reuses the same "move" axis for the pause panel's Resume/Quit navigation -
  ' see FocusManager.updateAnalogCursor()/BGE.UI.FocusNavigationMode. Focus
  ' stays in the default "list" mode (a d-pad-style step through the buttons),
  ' so this only lets an analog stick drive that same stepping.
  game.focusManager.analogAxisName = "move"

  game.loadBitmap("rocket", "pkg:/sprites/rocket_off.png")
  game.loadBitmap("rocket_on", "pkg:/sprites/rocket_on.png")
  game.loadBitmap("rock", "pkg:/sprites/rock_a.png")
  game.loadBitmap("boom", "pkg:/sprites/boom3.png")
  game.loadBitmap("background", "pkg:/sprites/spacebackground.jpg")
  game.loadBitmap("smoke", "pkg:/sprites/smoke1.png")
  game.loadSound("die", "pkg:/sounds/big_explosion_3.wav")
  game.loadSound("laser", "pkg:/sounds/laser.wav")
  game.loadSound("engine", "pkg:/sounds/engine.wav")

  for i = 1 to 9
    explosionSoundName = "explosion0" + stri(i).trim()
    game.loadSound(explosionSoundName, `pkg:/sounds/explosions/${explosionSoundName}.wav`)
  end for

  ' Looping background music for the whole session (title screen + gameplay) -
  ' Game itself doesn't track per-scene music state, so this is a one-shot call
  ' here rather than something scenes start/stop on their own, matching
  ' examples/platformer/breakout's own convention.
  game.musicPlay("pkg:/sounds/a_start_to_spacev3.24.mp3", true)

  ' "hud" (score readout, on-screen prompts), "heading" (pause panel title),
  ' and "title" (TitleScene's big "ASTEROIDS" logo text) - see Theme.font doc
  ' comment: a UiContainer.theme override is what gives a specific container
  ' its own font size, since a single Theme only carries one font.
  game.registerFont("pkg:/fonts/LEMONMILK-Regular.otf")
  game.loadFont("hud", "LEMON MILK", 36, false, false)
  game.loadFont("heading", "LEMON MILK", 48, false, false)
  game.loadFont("title", "LEMON MILK", 140, false, false)
  game.defaultTheme.font = game.getFont("hud")

  ' Deep-space palette (dark navy panels, cyan accents, the rocket's own red
  ' for focus) instead of the engine's default gray/white/silver, so the
  ' pause panel and its Resume/Quit buttons match the rest of the game.
  game.defaultTheme.backgroundColor = &h0B1220E6
  game.defaultTheme.borderColor = &h3AB6C9FF
  game.defaultTheme.focusedBorderColor = &hFF4433FF
  game.defaultTheme.hoveredBackgroundColor = &h1B2A3AFF

  game.defineScene(new TitleScene(game))
  game.defineScene(new MainScene(game))
  game.changeScene("TitleScene")
  game.enableStandardDebugUi()

  game.Play()

end sub
