' Asteroids' BGE.GameSession: counts rocks hit, keeps the best score and shows the restart
' prompt after the ship's destroyed ("fire" starts a new game in place).
class ScoreHandler extends BGE.GameSession

  ' A BGE.UI.Label rather than a raw Renderer.DrawText() call each frame - the
  ' Label caches its rendered text bitmap and only re-rasterizes it when the
  ' string actually changes (see DrawableText.getTextImage()), unlike a raw
  ' DrawText() call, which re-rasterizes this example's custom font from
  ' scratch every single frame - visibly flickered on real hardware.
  scoreLabel as BGE.UI.Label

  ' The best score so far, on the line under the score.
  bestLabel as BGE.UI.Label

  sub new(game as BGE.Game)
    super(game, {prompts: true, startAction: "fire"})
    m.name = "ScoreHandler"
    m.readyPrompt = "Press OK To Play" + Chr(10) + "Move: Arrows | " + m.bindingText("fire")
    m.overPrompt = "Game Over!" + Chr(10) + m.readyPrompt
    m.persistHighScore("bge-asteroids")
    m.scoreLabel = new BGE.UI.Label(m.game)
    m.bestLabel = new BGE.UI.Label(m.game)
  end sub

  override sub onCreate(args as roAssociativeArray)
    super.onCreate(args)
    ' Title-safe margin (~10% horizontal, ~5% vertical on a 16x9 display) -
    ' see Game.drawSafeZones()/debugDrawSafeZones().
    m.scoreLabel.customPosition = true
    m.scoreLabel.customX = m.game.uiCanvas.getWidth() * 0.1
    m.scoreLabel.customY = m.game.uiCanvas.getHeight() * 0.05
    ' scene UI: removed with the scene, like this entity
    m.game.getScene().addUi(m.scoreLabel)

    m.bestLabel.customPosition = true
    m.bestLabel.customX = m.scoreLabel.customX
    m.bestLabel.customY = m.scoreLabel.customY + m.game.getFont("hud").GetOneLineHeight()
    m.game.getScene().addUi(m.bestLabel)
    m.setBestText()
  end sub

  override sub onGameEvent(event as string, data as object)
    if event = "rock_hit"
      m.addScore()
      m.scoreLabel.setText(`Score: ${m.score}`)
    else if event = "game_over"
      m.gameOver()
    end if
  end sub

  ' A new game hides the score until the first hit; game over shows the new best.
  override sub onStateChanged(previousState as BGE.GameSessionState, newState as BGE.GameSessionState)
    if newState = BGE.GameSessionState.playing and m.score = 0
      m.scoreLabel.setText("")
    else if newState = BGE.GameSessionState.over
      m.setBestText()
    end if
  end sub

  private sub setBestText()
    m.bestLabel.setText(`Best: ${m.highScore}`)
  end sub

  ' A bound action's legend text from the control map, e.g. "Shoot: OK / A".
  private function bindingText(name as string) as string
    for each binding in m.game.controls.describeBindings()
      if binding.name = name
        return binding.text
      end if
    end for
    return ""
  end function

end class
