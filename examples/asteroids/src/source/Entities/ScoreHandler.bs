class ScoreHandler extends BGE.GameEntity

  score = 0

  ' A BGE.UI.Label rather than a raw Renderer.DrawText() call each frame - the
  ' Label caches its rendered text bitmap and only re-rasterizes it when the
  ' string actually changes (see DrawableText.getTextImage()), unlike a raw
  ' DrawText() call, which re-rasterizes this example's custom font from
  ' scratch every single frame - visibly flickered on real hardware.
  scoreLabel as BGE.UI.Label

  sub new(game as BGE.Game)
    super(game)
    m.name = "ScoreHandler"
    m.scoreLabel = new BGE.UI.Label(m.game)
  end sub

  override sub onCreate(args as roAssociativeArray)
    ' Title-safe margin (~10% horizontal, ~5% vertical on a 16x9 display) -
    ' see Game.drawSafeZones()/debugDrawSafeZones().
    m.scoreLabel.customPosition = true
    m.scoreLabel.customX = m.game.uiCanvas.getWidth() * 0.1
    m.scoreLabel.customY = m.game.uiCanvas.getHeight() * 0.05
    m.game.gameUi.addChild(m.scoreLabel)
  end sub

  override sub onGameEvent(event as string, data as object)
    if event = "rock_hit"
      m.score++
      m.scoreLabel.setText(`Score: ${m.score}`)
    end if

    if event = "game_start"
      m.score = 0
      m.scoreLabel.setText("")
    end if
  end sub

end class
