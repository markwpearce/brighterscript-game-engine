
class Player extends SpaceEntity

  rocketCollider = invalid
  rocketImage = invalid
  rocketOnImage = invalid
  smoke as BGE.DrawableParticles
  smokeTimer = new BGE.CountdownTimer()
  smokeDuration = 10.0
  thrust = 0
  dead = false
  width = 100
  height = 100

  ' rocket_off.png/rocket_on.png are 110x177/110x246 native pixels - sized
  ' back when this example used a 1920x1080 canvas. At the current 1280x720
  ' canvas (see main.bs), the same native pixel size reads noticeably larger
  ' on screen, so the rocket (and its collider, kept proportional to the
  ' visual size) is scaled down to compensate.
  shipScale = 0.6

  acceleration = 120
  rotationAdjustment = BGE.Math.HALF_PI ' rocket image points up, so it adds 90 degrees

  sub new(game as BGE.Game)
    super(game)
    m.name = "Player"
  end sub


  override sub onCreate(args as roAssociativeArray)
    m.position.y = m.game.getCanvas().GetHeight() / 2
    m.position.x = m.game.getCanvas().GetWidth() / 2
    rocketBitmap = m.game.getBitmap("rocket")
    rocketOnBitmap = m.game.getBitmap("rocket_on")
    m.width = rocketBitmap.GetWidth()
    m.height = rocketBitmap.GetHeight()
    rocketOnHeight = rocketOnBitmap.getHeight()
    m.rocketCollider = m.addCircleCollider("rocket", m.width * m.shipScale / 3)

    region = CreateObject("roRegion", rocketBitmap, 0, 0, m.width, m.height)
    region.SetPreTranslation(-m.width / 2, -m.height / 2)
    m.rocketImage = m.addImage("rocket", region)
    m.rocketImage.scale = BGE.Math.createScaleVector(m.shipScale)
    regionRocketOn = CreateObject("roRegion", rocketOnBitmap, 0, 0, m.width, rocketOnHeight)
    regionRocketOn.SetPreTranslation(-m.width / 2, -m.height / 2)
    m.rocketOnImage = m.addImage("rocket_on", regionRocketOn)
    m.rocketOnImage.scale = BGE.Math.createScaleVector(m.shipScale)

    ' Engine-exhaust smoke, only ever emitted while spinning out to death
    ' (see onCollision()/onUpdate() below) - not a thrust effect. Kept to a
    ' modest spawnRate/alpha - a higher rate left enough overlapping
    ' full-brightness particles alive at once to blow out into a solid white
    ' flash instead of reading as individual smoke puffs.
    m.smoke = m.addParticles("smoke", BGE.ParticleShape.Image, {
      image: m.game.getBitmap("smoke"),
      spawnRate: 10.0,
      lifetime: 0.8,
      lifetimeSpread: 0.2,
      velocitySpreadMagnitude: 50.0,
      startColor: &hAAAAAA,
      endColor: &h555555,
      startAlpha: 130.0,
      endAlpha: 0.0,
      startSize: 0.25,
      endSize: 0.6,
      rotationSpeed: 45.0
    })
  end sub

  override sub onCollision(thisCollider as BGE.Collider, otherCollider as BGE.Collider, other_entity as BGE.GameEntity)
    if other_entity.name = "Rock" and not m.dead
      rockObj = other_entity as SpaceEntity
      m.dead = true
      m.thrust = 0
      m.rotationalThrust = rockObj.rotationalThrust
      m.smoke.start()
      m.smokeTimer.start(m.smokeDuration)
      m.game.postGameEvent("game_over")
    end if
  end sub


  override sub onUpdate(deltaTime as float)
    super.onUpdate(deltaTime)
    rocketRot = m.getRocketRadRotation()
    m.velocity.x += deltaTime * m.thrust * cos(rocketRot) * m.acceleration
    m.velocity.y += deltaTime * m.thrust * sin(rocketRot) * m.acceleration
    m.rocketImage.enabled = (0 = m.thrust)
    m.rocketOnImage.enabled = (0 <> m.thrust)
    if m.dead
      ' make it spin out in to space
      scale = (10.0 - deltaTime) / 10.0
      m.rocketImage.scale = BGE.Math.createScaleVector(scale * m.rocketImage.scale.x)

      m.smokeTimer.tick(deltaTime)
      if not m.smokeTimer.isActive()
        m.smoke.stop()
      end if
    end if
  end sub


  override sub onControls(controls as BGE.Controller.ControlMap)
    if m.dead
      return
    end if
    move = controls.getAxis("move")
    m.rotationalThrust = -move.x
    if move.y > 0
      m.thrust = move.y
      m.game.playSound("engine", 50)
    else
      m.thrust = 0
    end if
    if controls.isActionPressed("fire")
      m.shoot()
    end if
  end sub

  function getRocketRadRotation() as float
    return (m.rotation.z + m.rotationAdjustment)
  end function


  override sub shoot()
    bulletPosition = BGE.Math.VectorOps.copy(m.position)
    rocketRot = m.getRocketRadRotation()

    bulletPosition.x += m.rocketCollider.radius * 1.3 * cos(rocketRot)
    bulletPosition.y += m.rocketCollider.radius * 1.3 * sin(rocketRot)

    bulletRotation = BGE.Math.VectorOps.add(m.rotation, {x: 0, y: 0, z: m.rotationAdjustment})

    m.game.addEntity(new Bullet(m.game), {
      position: bulletPosition,
      rotation: bulletRotation,
      speed: 600 + Abs(m.velocity.x * m.velocity.y) / 60
    })
  end sub
end class
