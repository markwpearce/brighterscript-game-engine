' Handles pause ("play"/"back") via a focus-driven pause panel (Resume/Quit) -
' matching examples/breakout's PauseHandler pattern. Persistent/non-pauseable
' since it's meta/housekeeping, not gameplay.
class PauseHandler extends BGE.GameEntity

  panel as BGE.UI.MessagePanel
  isOpen = false

  sub new(game as BGE.Game)
    super(game)
    m.name = "PauseHandler"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.persistent = true
    m.pauseable = false
  end sub

  override sub onControls(controls as BGE.Controller.ControlMap)
    if not controls.isActionPressed("pause")
      return
    end if
    if m.isOpen
      m.close()
    else
      m.open()
    end if
  end sub

  ' Builds a fresh panel every time (see BGE.UI.MessagePanel's own doc comment for why -
  ' its buttons must stay out of the shared FocusManager's registry while the panel
  ' isn't shown).
  private sub open()
    width = m.game.uiCanvas.getWidth()
    height = m.game.uiCanvas.getHeight()

    resumeButton = new BGE.UI.MessagePanelButton("Resume", sub(button as BGE.UI.Button)
      handler = button.game.getEntityByName("PauseHandler") as PauseHandler
      handler.close()
    end sub)
    quitButton = new BGE.UI.MessagePanelButton("Quit", sub(button as BGE.UI.Button)
      button.game.End()
    end sub)

    m.panel = new BGE.UI.MessagePanel(m.game, 320.0, 230.0, [resumeButton, quitButton], "Paused")
    ' MessagePanel hardcodes its own backgroundRGBA rather than reading
    ' Game.defaultTheme, so match the deep-space palette (main.bs) here too.
    m.panel.backgroundRGBA = &h0B1220E6
    m.panel.show(m.game.gameUi, width, height)
    ' FocusManager only auto-seeds focus once ever (the very first focusable
    ' widget registered in the whole game), not once per freshly-rebuilt
    ' panel - without this, reopening the pause panel after the first time
    ' would leave nothing focused. buttonWidgets[0] is Resume (first in the
    ' array passed to the MessagePanel constructor above).
    m.game.focusManager.focusWidget(m.panel.buttonWidgets[0])
    m.isOpen = true
    m.game.pause()
  end sub

  private sub close()
    m.isOpen = false
    m.panel.hide(m.game.gameUi)
    m.game.resume()
  end sub

end class
