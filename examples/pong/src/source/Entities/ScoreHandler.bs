class ScoreHandler extends BGE.GameEntity

  scores = {
    player: 0,
    computer: 0
  }

  ' Pong has no game over, so its high score is the longest rally (paddle hits between points).
  profile as BGE.SaveProfile = invalid
  rally = 0

  sub new(game as BGE.Game)
    super(game)
    m.name = "ScoreHandler"
    m.profile = new BGE.SaveProfile("bge-pong")
  end sub

  override sub onGameEvent(event as string, data as object)
    if event = "score"
      if data.team = 0
        m.scores.player++
      else
        m.scores.computer++
      end if
      m.profile.recordHighScore("rally", m.rally)
      m.rally = 0
    else if event = "rallyHit"
      m.rally++
    end if
  end sub

  override sub onDrawEnd(renderer as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")

    uiSize = uiRenderObj.getCanvasSize()

    uiRenderObj.DrawText(m.scores.player.ToStr(), uiSize.x / 2 - 200, 100, BGE.Colors.White, font, "center")
    uiRenderObj.DrawText(m.scores.computer.ToStr(), uiSize.x / 2 + 200, 100, BGE.Colors.White, font, "center")
    uiRenderObj.DrawText("Best rally " + m.profile.getHighScore("rally").ToStr(), uiSize.x / 2, 100, BGE.Colors.White, font, "center")
  end sub

end class
