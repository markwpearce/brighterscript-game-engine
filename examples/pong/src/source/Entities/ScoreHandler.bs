' Pong's BGE.GameSession. Its `score` is the player's; the computer's is kept beside it.
' There are no lives or game over: play starts straight away and goes on.
class ScoreHandler extends BGE.GameSession

  computerScore = 0

  sub new(game as BGE.Game)
    super(game)
    m.name = "ScoreHandler"
  end sub

  override sub onGameEvent(event as string, data as object)
    if event = "score"
      if data.team = 0
        m.addScore()
      else
        m.computerScore++
      end if
    end if
  end sub

  override sub onDrawEnd(renderer as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")

    uiSize = uiRenderObj.getCanvasSize()

    uiRenderObj.DrawText(m.score.ToStr(), uiSize.x / 2 - 200, 100, BGE.Colors.White, font, "center")
    uiRenderObj.DrawText(m.computerScore.ToStr(), uiSize.x / 2 + 200, 100, BGE.Colors.White, font, "center")
  end sub

end class
