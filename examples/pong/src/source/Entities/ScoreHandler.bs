' Pong's BGE.GameSession. Its `score` is the player's; the computer's is kept beside it.
' There are no lives or game over: play starts straight away and goes on.
class ScoreHandler extends BGE.GameSession

  computerScore = 0

  ' BGE.UI.Labels cache their text bitmap, so unlike a DrawText() each frame they don't flicker on device
  playerLabel as BGE.UI.Label
  computerLabel as BGE.UI.Label

  sub new(game as BGE.Game)
    super(game)
    m.name = "ScoreHandler"
  end sub

  override sub onCreate(args as roAssociativeArray)
    super.onCreate(args)
    ' Either side of centre, at least 10% down so it's title safe
    y = BGE.Math.Max(100, m.game.uiCanvas.getHeight() * 0.1)
    m.playerLabel = m.addScoreLabel(y)
    m.computerLabel = m.addScoreLabel(y)
    m.refreshText()
  end sub

  override sub onGameEvent(event as string, data as object)
    if event = "score"
      if data.team = 0
        m.addScore()
      else
        m.computerScore++
      end if
      m.refreshText()
    end if
  end sub

  ' A score label in the default font; refreshText() places it across
  private function addScoreLabel(y as float) as BGE.UI.Label
    label = new BGE.UI.Label(m.game)
    label.setFont(m.game.getFont("default"))
    label.horizAlign = "center"
    label.customPosition = true
    label.customY = y
    m.game.getScene().addUi(label)
    return label
  end function

  private sub refreshText()
    m.setCenteredText(m.playerLabel, m.score.ToStr(), m.game.uiCanvas.getWidth() / 2 - 200)
    m.setCenteredText(m.computerLabel, m.computerScore.ToStr(), m.game.uiCanvas.getWidth() / 2 + 200)
  end sub

  ' Centres a label on x (it's horizAlign "center").
  private sub setCenteredText(label as BGE.UI.Label, text as string, centerX as float)
    label.setText(text)
    label.customX = centerX
  end sub

end class
