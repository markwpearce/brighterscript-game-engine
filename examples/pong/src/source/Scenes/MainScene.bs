class MainScene extends BGE.GameScene

  session as ScoreHandler
  ' Delay before each serve; game time, so it waits while paused
  ballSpawnTimer as BGE.CountdownTimer = invalid
  ball_direction = -1
  ball = invalid

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainScene"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.game.addEntity(new Player(m.game))
    m.game.addEntity(new Computer(m.game))
    m.game.addEntity(new BGE.PauseMenu(m.game, {style: "text"}))

    m.session = new ScoreHandler(m.game)
    m.game.addEntity(m.session)
    m.session.start()
    m.ballSpawnTimer = new BGE.CountdownTimer()
    m.ballSpawnTimer.start(1.0)
    m.ball_direction = -1
    m.ball = invalid
  end sub

  override sub onUpdate(dt as float)
    m.ballSpawnTimer.tick(dt)
    if m.session.isPlaying() and not BGE.isValidEntity(m.ball) and not m.ballSpawnTimer.isActive()
      ballEntity = new Ball(m.game)
      m.ball = m.game.addEntity(ballEntity, {direction: m.ball_direction})
    end if
  end sub

  override sub onDrawBegin(renderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    offset = 50

    screenSize = renderer.getCanvasSize()

    renderer.drawRectangle(0, 0, screenSize.x, offset, &hFFFFFFFF)
    renderer.drawRectangle(0, screenSize.y - offset, m.game.canvas.getWidth(), offset, &hFFFFFFFF)
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.isRemoteBack()
      m.game.End()
    end if
    if input.press and input.isButton("options")
      showingDebug = not m.game.isDebugUiEnabled()
      m.game.debugDrawEntityDetails(showingDebug)
      m.game.debugDrawColliders(showingDebug)
      m.game.debugShowUi(showingDebug)
    end if
  end sub

  override sub onGameEvent(event as string, data as object)
    if event = "score"
      if data.team = 0
        m.ball_direction = -1
      else
        m.ball_direction = 1
      end if
      m.ball = invalid
      m.ballSpawnTimer.start(1.0)
    end if
  end sub

end class
