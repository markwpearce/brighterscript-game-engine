' Shapes of the rpg's own story data. Engine-free apart from BGE.Story's types, so its tests can use them.
import "pkg:/source/story/StoryTypes.bs"
import "pkg:/source/story/StoryFlags.bs"
import "pkg:/source/story/Inventory.bs"

' What a Player entity has that the story reads and changes (tests pass a plain AA).
interface PlayerStats
  health as integer
  maxHealth as integer
  coins as integer
end interface

interface RpgItemDefinition extends BGE.Story.ItemDefinition
  name as string
  icon as string
  ' 16px spin frames (8, in a 64x32 sheet) a Pickup plays on the floor instead of the icon
  optional spinSheet as string
  optional onUse as BGE.Story.StoryEffect[]
end interface

' A dialogue choice: "shop" opens the shop, "credits" rolls the credits, once the dialogue closes.
interface RpgChoice extends BGE.Story.StoryChoice
  optional open as string
end interface

interface ShopItem
  itemId as string
  price as integer
end interface

interface QuestDefinition extends roAssociativeArray
  id as string
  title as string
  stageFlag as string
  ' stage number (as a string) -> objective text
  stages as roAssociativeArray
end interface

interface SaveData extends roAssociativeArray
  version as integer
  scene as string
  spawn as string
  flags as roAssociativeArray
  inventory as roAssociativeArray
  ' node visit counts (version 2 saves on)
  optional visits as roAssociativeArray
  player as PlayerStats
end interface

' The outcome of buying or using an item.
interface ActionResult
  ok as boolean
  ' why not, when ok is false
  reason as string
  ' what the item's effects did (pass it on to be settled, posted and saved)
  result as BGE.Story.StoryResult
end interface

interface StoryCheckpoint
  flags as BGE.Story.StoryFlags
  inventory as BGE.Story.Inventory
  coins as integer
end interface

' An open panel that the Story forwards its buttons' actions to.
interface StoryPanel
  sub onAction(actionId as string)
end interface
