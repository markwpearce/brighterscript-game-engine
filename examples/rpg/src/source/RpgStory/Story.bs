' examples/rpg/src/source/RpgStory/Story.bs
import "pkg:/source/story/ValueKinds.bs"
import "pkg:/source/story/StoryTypes.bs"
import "pkg:/source/story/StoryState.bs"
import "pkg:/source/story/Effects.bs"
import "pkg:/source/story/DialogueRunner.bs"
import "pkg:/source/story/StorySession.bs"
import "Items.bs"
import "StoryData.bs"
import "RpgVocabulary.bs"
import "QuestData.bs"
import "ShopData.bs"
import "SaveData.bs"
import "Checkpoints.bs"
import "RpgStoryTypes.bs"
import "../Maps/MapTypes.bs"
import "../Entities/Player.bs"
import "../Entities/Npc.bs"
import "../UI/DialogueBox.bs"
import "../UI/ShopPanel.bs"
import "../UI/InventoryPanel.bs"
import "../Audio/PlayAudio.bs"

' The rpg's story session: the engine's StorySession settles each step, posts the rules' posts
' as game events, feeds it enemyKilled/roomCleared/switchPressed and posts storyUpdated. This adds
' the rpg's vocabulary (coins, health), opens the dialogue/shop/inventory panels, and autosaves
' (onStoryChanged). Persistent and never paused, so it keeps working while a panel has the game
' paused.
class Story extends BGE.Story.StorySession

  ' Kept as aliases of the state's, which never replaces them.
  flags as BGE.Story.StoryFlags = invalid
  inventory as BGE.Story.Inventory = invalid
  private vocab as RpgVocabularyContext = invalid
  ' A choice's open ("shop", "credits") to act on when the dialogue closes.
  private pendingOpen as string = ""
  ' The save: Continue reads it, autosaves write it. Disabled (enabled = false) while a --param
  ' deep link is active, so testing never overwrites a real save.
  slot as RpgSaveSlot = invalid
  private sceneName as string = ""
  private spawn as string = ""
  ' Deep-link testing: skip enemy placements (--param peaceful=1).
  peaceful as boolean = false
  ' Deep-link testing: a panel to open once the first area has faded in ("inventory").
  openOnArrival as string = ""
  ' message effects and showMessage() lines waiting for every panel to close
  private queuedMessages as BGE.Story.StoryMessage[] = []
  ' A scripted conversation waiting for every panel to close (see startScripted).
  private pendingScripted as string = ""
  private pendingCredits as boolean = false
  private talkingNpc as Npc = invalid

  sub new(game as BGE.Game)
    super(game, getStoryData(), {name: "Story"})
    m.slot = new RpgSaveSlot(SAVE_SECTION, SAVE_KEY, SAVE_VERSION)
    m.vocab = {player: invalid}
    registerRpgVocabulary(m.state, m.vocab)
    m.flags = m.state.flags
    m.inventory = m.state.inventory
    m.listenTo(["enemyKilled", "roomCleared", "switchPressed"])
  end sub

  ' The story state, with the rpg's vocabulary pointed at the current Player. Use this, not m.state,
  ' for anything that evaluates conditions or applies effects.
  function storyState() as BGE.Story.StoryState
    m.vocab.player = m.getPlayer()
    return m.state
  end function

  sub newGame()
    m.storyState().reset()
    m.getPlayer().resetForNewGame()
    m.syncPlayer()
  end sub

  ' @param {SaveData} save - from readSave()
  sub loadSave(save as SaveData)
    m.storyState().loadSaveData({flags: save.flags, inventory: save.inventory, visits: save.visits})
    ' Saves from before rats.kills was always set would read "Kill rats (/4)".
    if m.flags.getInt("rats.stage") >= 1 and BGE.Story.valueKind(m.flags.get("rats.kills")) = "invalid"
      m.flags.set("rats.kills", 0)
    end if
    m.getPlayer().applySavedStats(save.player)
    m.syncPlayer()
  end sub

  ' Jumps to a numbered story checkpoint (--param stage=N).
  sub applyCheckpoint(n as integer)
    m.newGame()
    state = checkpointState(n)
    m.flags.loadAA(state.flags.toAA())
    m.inventory.loadAA(state.inventory.toAA())
    m.getPlayer().coins = state.coins
    m.syncPlayer()
  end sub

  ' @return {SaveData} the saved game, or invalid if there's none (or it's unreadable)
  function readSave() as SaveData
    save = m.slot.read(validateSaveData) as SaveData
    if save = invalid
      return invalid
    end if
    ' A save naming a scene that no longer exists is as good as none.
    for each sceneName in m.game.getSceneNames()
      if sceneName = save.scene
        return save
      end if
    end for
    return invalid
  end function

  sub deleteSave()
    m.slot.delete()
  end sub

  ' Called by an area once it's built: remembers where to resume, and saves.
  sub arrivedAt(sceneName as string, spawn as string)
    m.sceneName = sceneName
    m.spawn = spawn
    m.save()
  end sub

  sub save()
    if m.sceneName = ""
      return
    end if
    if m.slot.write(buildSaveData(m.sceneName, m.spawn, m.state, m.getPlayer()))
      m.game.postGameEvent("storySaved")
    end if
  end sub

  override sub onGameEvent(eventName as string, data as roAssociativeArray)
    if eventName = "talkRequested"
      m.startDialogue(data.npcId)
    else if eventName = "inventoryRequested"
      m.openInventory()
    else
      super.onGameEvent(eventName, data)
    end if
  end sub

  ' The session's entry points run conditions and effects, so each points the vocabulary at the
  ' current Player first (storyState()).
  ' Points the vocabulary at the current Player before every story step.
  protected override sub beforeStep()
    m.storyState()
  end sub

  ' Also remembers the choice's "open" ("shop", "credits") to act on when the dialogue closes.
  override function choose(index as integer) as BGE.Story.StoryResult
    views = m.runner.choices()
    if index >= 0 and index < views.count()
      choice = views[index].choice as RpgChoice
      if BGE.Story.valueKind(choice.open) = "string" and choice.open <> ""
        m.pendingOpen = choice.open
      end if
    end if
    return super.choose(index)
  end function

  ' Keeps the player's sword in step with the inventory, and autosaves.
  override sub onStoryChanged(result as BGE.Story.StoryResult)
    m.syncPlayer()
    m.save()
  end sub

  ' Runs story effects for something in the world (a pickup, a switch, a door).
  sub runEffects(effects as BGE.Story.StoryEffect[])
    m.applyEffects(effects)
  end sub

  ' Called when the player walks into a gate: runs its effects if its conditions pass, or says
  ' why it won't open.
  sub tryUnlock(unlock as GateUnlock)
    if m.game.isModalOpen()
      return
    end if
    if m.storyState().evaluate(unlock.when)
      m.runEffects(unlock.effects)
    else
      m.showMessage(unlock.lockedMessage)
    end if
  end sub

  ' Shows a dialogue box (with no speaker unless one is given) once nothing else is open.
  sub showMessage(text as string, speaker = "" as string)
    ' after any message effects already waiting, so they show in order
    m.queuedMessages.append(m.takeMessages())
    m.queuedMessages.push({text: text, speaker: speaker})
  end sub

  ' Called by the DialogueBox once the runner is no longer active.
  sub dialogueEnded()
    opens = m.pendingOpen
    m.pendingOpen = ""
    if opens = "credits"
      m.pendingCredits = true
    end if
    ' Open the shop before releasing the dialogue's modal so the game never resumes in between.
    if opens = "shop"
      m.openShop()
    end if
    m.endTalking()
    m.game.popModal()
  end sub

  ' Called by the DialogueBox when the player backs out. Nothing further runs, but the effects of
  ' any node whose last line was already read have run.
  sub cancelDialogue()
    m.runner.cancel()
    m.pendingOpen = ""
    m.endTalking()
    m.game.popModal()
  end sub

  ' Called by the shop and inventory panels once they've closed themselves.
  sub panelClosed()
    m.game.popModal()
  end sub

  ' Reopens the shop after a purchase so its labels show what's owned. The shop's modal is still
  ' open (the panel closed without popping it), so this doesn't push another.
  sub reopenShop()
    m.showShop()
  end sub

  override sub onUpdate(deltaTime as float)
    m.queuedMessages.append(m.takeMessages())
    canOpen = not m.game.isModalOpen() and not m.game.isTransitioning()
    if canOpen and m.pendingCredits
      m.pendingCredits = false
      m.game.changeSceneWithFade("CreditsScene", {})
    else if canOpen and m.queuedMessages.count() > 0
      message = m.queuedMessages.Shift()
      m.runner.startNode({speaker: message.speaker, lines: [message.text]})
      m.openDialogue()
    else if canOpen and m.pendingScripted <> ""
      npcId = m.pendingScripted
      m.pendingScripted = ""
      m.startDialogue(npcId)
    else if canOpen and m.openOnArrival = "inventory" and m.sceneName <> ""
      m.openOnArrival = ""
      m.openInventory()
    end if
  end sub

  ' Starts a conversation without the player talking to anyone (a scene's cutscene line),
  ' once nothing else is open and the area has faded in. Nothing happens if no page passes.
  '
  ' @param {string} npcId - a getDialogueData() id
  sub startScripted(npcId as string)
    m.pendingScripted = npcId
  end sub

  private sub endTalking()
    if m.talkingNpc <> invalid and m.talkingNpc.isValid()
      m.talkingNpc.setTalking(false)
    end if
    m.talkingNpc = invalid
  end sub

  function shopItems() as ShopItem[]
    return getShopItems()
  end function

  function priceOf(itemId as string) as integer
    for each row in getShopItems()
      if row.itemId = itemId
        return row.price
      end if
    end for
    return 0
  end function

  function buy(itemId as string) as ActionResult
    state = m.storyState()
    result = buyItem(itemId, m.priceOf(itemId), state, m.getPlayer())
    if result.ok
      playSfx(m.game, "purchase")
      m.applyActionResult(result)
    end if
    return result
  end function

  function use(itemId as string) as ActionResult
    state = m.storyState()
    result = useItem(itemId, state, m.getPlayer())
    if result.ok
      m.applyActionResult(result)
    end if
    return result
  end function

  ' A purchase or use always changes the story (coins, the inventory), whatever its effects did.
  private sub applyActionResult(action as ActionResult)
    result = BGE.Story.newStoryResult()
    result.changed = true
    BGE.Story.mergeStoryResult(result, action.result)
    m.apply(result)
  end sub

  function objectives() as string[]
    return currentObjectives(getQuestData(), m.flags)
  end function

  private sub syncPlayer()
    m.getPlayer().swordDamage = swordDamageFor(m.inventory)
  end sub

  private sub startDialogue(npcId as string)
    if m.game.isModalOpen()
      return
    end if
    ' Settles and posts before the box opens; a node with nothing to say just runs its effects.
    m.start(npcId)
    if not m.runner.isActive()
      return
    end if
    for each entity in m.game.getEntitiesByTag("npc")
      npcEntity = entity as Npc
      if npcEntity.npcId = npcId
        m.talkingNpc = npcEntity
      end if
    end for
    playerEntity = m.getPlayer()
    if m.talkingNpc <> invalid
      m.talkingNpc.setTalking(true)
      m.talkingNpc.faceToward(playerEntity.position.x, playerEntity.position.y)
    end if
    m.openDialogue()
  end sub

  private sub openDialogue()
    m.game.pushModal()
    dialogue = new DialogueBox(m.game, m.runner)
    dialogue.open(m.game.gameUi)
  end sub

  private sub openShop()
    m.game.pushModal()
    m.showShop()
  end sub

  private sub showShop()
    panel = new ShopPanel(m.game)
    panel.open(m.game.gameUi)
  end sub

  private sub openInventory()
    if m.game.isModalOpen() or m.game.isTransitioning() or m.getPlayer().isDefeated()
      return
    end if
    m.game.pushModal()
    panel = new InventoryPanel(m.game)
    panel.open(m.game.gameUi)
  end sub

  private function getPlayer() as Player
    return m.game.getEntityByName("Player") as Player
  end function

end class
