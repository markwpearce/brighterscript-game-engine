' examples/rpg/src/source/RpgStory/ShopData.bs
import "pkg:/source/story/StoryState.bs"
import "pkg:/source/story/Effects.bs"
import "RpgStoryTypes.bs"

' Hilde's wares, in display order.
'
' @return {ShopItem[]}
function getShopItems() as ShopItem[]
  return [
    {itemId: "steelSword", price: 10},
    {itemId: "heartContainer", price: 15},
    {itemId: "potion", price: 4}
  ]
end function

' @return {string} "" if it can be bought, otherwise why not
function canBuy(itemId as string, price as integer, state as BGE.Story.StoryState, stats as PlayerStats) as string
  if not state.inventory.canAdd(itemId)
    definition = state.items[itemId] as RpgItemDefinition
    if definition.max = 1
      return "Already owned"
    end if
    return "Can't carry more"
  end if
  if stats.coins < price
    return "Not enough coins"
  end if
  return ""
end function

' @return {ActionResult}
function buyItem(itemId as string, price as integer, state as BGE.Story.StoryState, stats as PlayerStats) as ActionResult
  reason = canBuy(itemId, price, state, stats)
  if reason <> ""
    return {ok: false, reason: reason, result: BGE.Story.newStoryResult()}
  end if
  result = state.applyEffects([{takeCoins: price}, {giveItem: itemId}])
  return {ok: true, reason: "", result: result}
end function

' @return {string} "" if it can be used now, otherwise why not
function canUse(itemId as string, state as BGE.Story.StoryState, stats as PlayerStats) as string
  if not state.inventory.has(itemId)
    return "You have none"
  end if
  definition = state.items[itemId] as RpgItemDefinition
  if type(definition.onUse) <> "roArray"
    return "Can't be used"
  end if
  if definition.onUse.count() = 0
    return "Can't be used"
  end if
  for each effect in definition.onUse
    if effect.DoesExist("heal") and stats.health >= stats.maxHealth
      return "Already at full health"
    end if
  end for
  return ""
end function

' @return {ActionResult}
function useItem(itemId as string, state as BGE.Story.StoryState, stats as PlayerStats) as ActionResult
  reason = canUse(itemId, state, stats)
  if reason <> ""
    return {ok: false, reason: reason, result: BGE.Story.newStoryResult()}
  end if
  state.inventory.remove(itemId)
  definition = state.items[itemId] as RpgItemDefinition
  result = state.applyEffects(definition.onUse)
  ' Removing the item changed the story even if its effects didn't.
  result.changed = true
  return {ok: true, reason: "", result: result}
end function
