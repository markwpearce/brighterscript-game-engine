import "../Audio/PlayAudio.bs"
' World size of a coin (the 9x9 icon at 2x - main.bs's "coinWorld" bitmap).
const COIN_SIZE = 18.0
const COIN_BOB_HEIGHT = 2.0

' A coin dropped by an enemy. Walking over it collects it: it posts a "coinCollected" game
' event, which the player counts.
class Coin extends BGE.GameEntity

  private time as float = 0.0
  private image as BGE.Image = invalid

  sub new(game as BGE.Game)
    super(game)
    m.name = "Coin"
  end sub

  ' @param {roAssociativeArray} args - {x, y}: bottom-centre
  override sub onCreate(args as roAssociativeArray)
    m.position.x = args.x
    m.position.y = args.y
    m.position.z = -args.y
    bitmap = m.game.getBitmap("coinWorld")
    m.image = m.addImage("coin", CreateObject("roRegion", bitmap, 0, 0, COIN_SIZE, COIN_SIZE), {
      offset: BGE.Math.VectorOps.create(-COIN_SIZE / 2, COIN_SIZE),
      drawMode: BGE.SceneObjectDrawMode.matchCamera
    })
    m.addRectangleCollider("pickup", COIN_SIZE - 4, COIN_SIZE - 4, -(COIN_SIZE - 4) / 2, COIN_SIZE - 4)
  end sub

  override sub onUpdate(dt as float)
    m.time += dt
    m.image.offset.y = COIN_SIZE + COIN_BOB_HEIGHT + Sin(m.time * 5) * COIN_BOB_HEIGHT
  end sub

  override sub onCollisionEnter(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if otherEntity.name = "Player" and otherCollider.name = "feet" and m.isValid()
      playSfx(m.game, "coin")
      m.game.postGameEvent("coinCollected")
      m.invalidate()
    end if
  end sub

end class
