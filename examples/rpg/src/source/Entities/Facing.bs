' Which way a character faces. The values are also the suffixes of each character's
' animation names (e.g. "run_" + facing).
enum FacingDirection
  up = "up"
  down = "down"
  left = "left"
  right = "right"
end enum

' Which way the player faces for a movement direction (world +y up). On an exact diagonal the
' current facing is kept, so walking diagonally along a wall doesn't flicker between two facings.
'
' @param {float} x
' @param {float} y
' @param {FacingDirection} current
' @return {FacingDirection}
function facingFor(x as float, y as float, current as FacingDirection) as FacingDirection
  if Abs(x) > Abs(y)
    if x > 0
      return FacingDirection.right
    end if
    return FacingDirection.left
  else if Abs(y) > Abs(x)
    if y > 0
      return FacingDirection.up
    end if
    return FacingDirection.down
  end if
  return current
end function
