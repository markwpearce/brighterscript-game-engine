import "Enemy.bs"
import "Facing.bs"

const BAT_SPEED = 55.0
const BAT_WOBBLE_SPEED = 35.0
const BAT_CHASE_RANGE = 160.0
' How high above its shadow the bat is drawn.
const BAT_HEIGHT = 24.0
const BAT_BOX_W = 20.0

' A bat that flutters toward the player, flying over walls and props (but staying inside the
' map). One hit defeats it. Its position is the point on the ground under it, where its shadow
' is, so it depth-sorts like anything else standing there.
'
' bat.png: 48x64 cells, 3 flap frames per row, rows facing up/right/down/left.
class Bat extends Enemy

  private facing as string = "down"
  private time as float = 0.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "Bat"
  end sub

  override sub onCreate(args as roAssociativeArray)
    super.onCreate(args)
    m.health = 1
    m.boxW = BAT_BOX_W
    m.time = Rnd(0) * 6
    ' A circle's offset is its top-left corner, so this centres it on the ground point.
    m.addCircle("shadow", 5, {color: &h000000, alpha: 150, offset: BGE.Math.VectorOps.create(-5, 7)})
    m.sprite = m.addSprite("body", m.game.getBitmap("bat"), 48, 64)
    ' The body's middle is at about (24, 30) of each cell; lift it BAT_HEIGHT above the shadow.
    m.sprite.applyPreTranslation(-24, -30 - BAT_HEIGHT)
    rowFacings = ["up", "right", "down", "left"]
    for i = 0 to 3
      first = i * 3
      m.sprite.addAnimation("fly_" + rowFacings[i], [first, first + 1, first + 2, first + 1], 10, BGE.SpritePlayMode.Loop)
    end for
    m.sprite.playAnimation("fly_down")
    ' Covers the shadow up to the body, so the sword connects wherever it looks like it should.
    m.addRectangleCollider("body", BAT_BOX_W, BAT_HEIGHT + 16, -BAT_BOX_W / 2, BAT_HEIGHT + 16)
  end sub

  protected override sub moveEnemy(dt as float)
    m.time += dt
    wobble = Sin(m.time * 6) * BAT_WOBBLE_SPEED
    moveX = wobble
    moveY = Cos(m.time * 4) * BAT_WOBBLE_SPEED / 2
    target = m.getPlayer()
    if target <> invalid
      dx = target.position.x - m.position.x
      dy = target.position.y - m.position.y
      distance = Sqr(dx * dx + dy * dy)
      if distance < BAT_CHASE_RANGE and distance > 1
        dirX = dx / distance
        dirY = dy / distance
        ' Toward the player, weaving side to side across the line of travel.
        moveX = dirX * BAT_SPEED - dirY * wobble
        moveY = dirY * BAT_SPEED + dirX * wobble
      end if
    end if
    m.applyMove(moveX * dt, moveY * dt, {})
    m.facing = facingFor(moveX, moveY, m.facing)
    m.sprite.playAnimation("fly_" + m.facing)
  end sub

  ' Flies over solids, just staying inside the map.
  protected override sub applyMove(dx as float, dy as float, options as BGE.SlideOptions)
    m.position.x = m.clamp(m.position.x + dx, BAT_BOX_W / 2, m.mapWidth - BAT_BOX_W / 2)
    m.position.y = m.clamp(m.position.y + dy, 0, m.mapHeight - BAT_HEIGHT - 40)
    m.position.z = -m.position.y
  end sub

  private function clamp(value as float, low as float, high as float) as float
    if value < low
      return low
    else if value > high
      return high
    end if
    return value
  end function

end class
