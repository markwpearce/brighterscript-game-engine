import "Facing.bs"
import "Shapes.bs"

' Pure combat maths shared by the player and enemies, kept free of engine state so it can be
' unit tested. Rectangles are {x, y, w, h}: (x, y) is the bottom-left corner, world +y up.

' How far the sword reaches out from the feet box, and how wide its arc is.
const SWORD_REACH = 28.0
const SWORD_SPAN = 32.0
' The player's feet box is 20x12, centred on the feet point.
const SWORD_FEET_HALF_W = 10.0
const SWORD_FEET_H = 12.0

' The sword's hitbox for a facing, relative to the player's feet point (the bottom-centre of
' the feet box).
'
' @param {FacingDirection} facing
' @return {Rect}
function swordBox(facing as FacingDirection) as Rect
  midY = SWORD_FEET_H / 2 - SWORD_SPAN / 2
  if facing = FacingDirection.up
    return {x: -SWORD_SPAN / 2, y: SWORD_FEET_H, w: SWORD_SPAN, h: SWORD_REACH}
  else if facing = FacingDirection.left
    return {x: -SWORD_FEET_HALF_W - SWORD_REACH, y: midY, w: SWORD_REACH, h: SWORD_SPAN}
  else if facing = FacingDirection.right
    return {x: SWORD_FEET_HALF_W, y: midY, w: SWORD_REACH, h: SWORD_SPAN}
  end if
  return {x: -SWORD_SPAN / 2, y: -SWORD_REACH, w: SWORD_SPAN, h: SWORD_REACH}
end function

' A push of `distance` pointing from the source to the target. If they're in the same place it
' pushes down, rather than dividing by zero.
'
' @param {float} fromX - what did the hitting
' @param {float} fromY
' @param {float} toX - what got hit
' @param {float} toY
' @param {float} distance
' @return {Point}
function knockbackVector(fromX as float, fromY as float, toX as float, toY as float, distance as float) as Point
  dx = toX - fromX
  dy = toY - fromY
  length = Sqr(dx * dx + dy * dy)
  if length < 0.001
    return {x: 0.0, y: -distance}
  end if
  return {x: dx / length * distance, y: dy / length * distance}
end function

' What each heart in the HUD shows, two health points per heart.
'
' @param {integer} health
' @param {integer} maxHealth - an even number
' @return {string[]} "full", "half" or "empty" for each heart, left to right
function heartStates(health as integer, maxHealth as integer) as string[]
  states = [] as string[]
  for i = 0 to maxHealth / 2 - 1
    points = health - i * 2
    if points >= 2
      states.push("full")
    else if points = 1
      states.push("half")
    else
      states.push("empty")
    end if
  end for
  return states
end function
