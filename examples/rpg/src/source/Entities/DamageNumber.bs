const DAMAGE_NUMBER_MS = 800
' How far it floats up over its lifetime.
const DAMAGE_NUMBER_RISE = 20.0

' A "-1" that floats up from where something got hurt and fades out, then removes itself.
' Both are tweens (Game.tweenManager), so it needs no onUpdate of its own.
'
' @example
' damage = new DamageNumber(m.game)
' m.game.addEntity(damage, {x: m.position.x, y: m.position.y + 30, amount: 1})
class DamageNumber extends BGE.GameEntity

  private label as BGE.DrawableText = invalid

  sub new(game as BGE.Game)
    super(game)
    m.name = "DamageNumber"
  end sub

  ' @param {roAssociativeArray} args - {x, y: where it starts (bottom-centre of the text),
  '   amount: the damage, color: packed RGB tint (default white)}
  override sub onCreate(args as roAssociativeArray)
    m.position.x = args.x
    m.position.y = args.y
    ' In front of whoever got hurt and anything just below them. Not much more, or it would
    ' reach the camera's own z and be culled.
    m.position.z = -args.y + 60
    color = &hFFFFFF
    if args.color <> invalid
      color = args.color
    end if
    m.label = new BGE.DrawableText(m, "-" + args.amount.toStr(), m.game.getFont("damage"), {
      color: color,
      drawMode: BGE.SceneObjectDrawMode.matchCamera
    })
    m.label.setAnchor(0.5, 1)
    m.addDrawable("label", m.label)

    ' The label's own offset, not the entity's position, which the engine may replace.
    m.game.tweenManager.to(m.label.offset, {y: DAMAGE_NUMBER_RISE}, DAMAGE_NUMBER_MS, BGE.Tweens.Easing.QuadraticEaseOut, {owner: m})
    m.game.tweenManager.to(m.label, {alpha: 0.0}, DAMAGE_NUMBER_MS, BGE.Tweens.Easing.LinearTween, {
      owner: m,
      onComplete: sub(targetObj as object)
        label = targetObj as BGE.DrawableText
        if label.owner <> invalid and label.owner.isValid()
          label.owner.invalidate()
        end if
      end sub
    })
  end sub

end class
