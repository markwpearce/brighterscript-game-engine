import "Enemy.bs"
import "Facing.bs"
import "Shadow.bs"

const RAT_SPEED = 45.0
const RAT_CHASE_SPEED = 75.0
const RAT_CHASE_RANGE = 120.0
const RAT_BOX_W = 16.0
const RAT_BOX_H = 10.0

' A rat that wanders about and chases the player when close. Walks through the area's solids
' like the player does. Takes two hits.
'
' rat.png: 32x32 cells, 3 walk frames per row, rows facing up/right/down/left. The middle frame
' is the standing pose.
class Rat extends Enemy

  private facing as FacingDirection = FacingDirection.down
  private wanderX as float = 0.0
  private wanderY as float = 0.0
  private wanderTimer as BGE.CountdownTimer = new BGE.CountdownTimer()

  sub new(game as BGE.Game)
    super(game)
    m.name = "Rat"
  end sub

  override sub onCreate(args as roAssociativeArray)
    super.onCreate(args)
    m.health = 2
    m.boxW = RAT_BOX_W
    m.boxH = RAT_BOX_H
    m.headHeight = 20
    addGroundShadow(m, 7)
    m.sprite = m.addSprite("body", m.game.getBitmap("rat"), 32, 32)
    ' Pins the rat's feet (16, 28 within each cell) onto the entity's position.
    m.sprite.applyPreTranslation(-16, -28)
    rowFacings = [FacingDirection.up, FacingDirection.right, FacingDirection.down, FacingDirection.left]
    for i = 0 to 3
      first = i * 3
      m.sprite.addAnimation("walk_" + rowFacings[i], [first, first + 1, first + 2, first + 1], 10, BGE.SpritePlayMode.Loop)
      m.sprite.addAnimation("idle_" + rowFacings[i], [first + 1], 1, BGE.SpritePlayMode.Loop)
    end for
    m.sprite.playAnimation("idle_down")
    m.addRectangleCollider("body", RAT_BOX_W, RAT_BOX_H, -RAT_BOX_W / 2, RAT_BOX_H)
    ' Staggered, so rats placed together don't all turn at once.
    m.wanderTimer.start(Rnd(0) * 2)
  end sub

  protected override sub moveEnemy(dt as float)
    target = m.getPlayer()
    if target <> invalid and not m.isRetreating()
      dx = target.position.x - m.position.x
      dy = target.position.y - m.position.y
      distance = Sqr(dx * dx + dy * dy)
      if distance < RAT_CHASE_RANGE and distance > 1
        m.walk(dx / distance * RAT_CHASE_SPEED * dt, dy / distance * RAT_CHASE_SPEED * dt)
        return
      end if
    end if

    m.wanderTimer.tick(dt)
    if not m.wanderTimer.isActive()
      m.pickWanderDirection()
    end if
    m.walk(m.wanderX * RAT_SPEED * dt, m.wanderY * RAT_SPEED * dt)
  end sub

  ' One of the four directions, or a pause, for the next second or two.
  private sub pickWanderDirection()
    choice = Rnd(5)
    m.wanderX = 0.0
    m.wanderY = 0.0
    if choice = 1
      m.wanderY = 1.0
    else if choice = 2
      m.wanderX = 1.0
    else if choice = 3
      m.wanderY = -1.0
    else if choice = 4
      m.wanderX = -1.0
    end if
    m.wanderTimer.start(1 + Rnd(0))
  end sub

  private sub walk(dx as float, dy as float)
    if dx = 0 and dy = 0
      m.sprite.playAnimation("idle_" + m.facing)
      return
    end if
    m.applyMove(dx, dy, {})
    m.facing = facingFor(dx, dy, m.facing)
    m.sprite.playAnimation("walk_" + m.facing)
  end sub

end class
