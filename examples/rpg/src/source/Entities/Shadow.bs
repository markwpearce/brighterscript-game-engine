' Adds a dark, translucent circle on the ground, centred on the entity's position (its feet).
' Call it before adding the entity's sprite, so the shadow draws underneath.
'
' @param {BGE.GameEntity} entity
' @param {float} radius
' @param {integer} [alpha=120] - 0-255
sub addGroundShadow(entity as BGE.GameEntity, radius as float, alpha = 120 as integer)
  ' A circle's offset is its top-left corner. Lifted 2px so it peeks out behind the feet.
  entity.addCircle("shadow", radius, {color: &h000000, alpha: alpha, offset: BGE.Math.VectorOps.create(-radius, radius + 2)})
end sub
