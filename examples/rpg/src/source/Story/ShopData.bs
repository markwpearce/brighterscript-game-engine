' examples/rpg/src/source/Story/ShopData.bs
import "Effects.bs"
import "StoryTypes.bs"

' Hilde's wares, in display order.
'
' @return {ShopItem[]}
function getShopItems() as ShopItem[]
  return [
    {itemId: "steelSword", price: 10},
    {itemId: "heartContainer", price: 15},
    {itemId: "potion", price: 4}
  ]
end function

' @return {string} "" if it can be bought, otherwise why not
function canBuy(itemId as string, price as integer, ctx as StoryContext) as string
  if not ctx.inventory.canAdd(itemId)
    definition = ctx.items[itemId] as ItemDefinition
    if definition.max = 1
      return "Already owned"
    end if
    return "Can't carry more"
  end if
  if ctx.player.coins < price
    return "Not enough coins"
  end if
  return ""
end function

' @return {ActionResult}
function buyItem(itemId as string, price as integer, ctx as StoryContext) as ActionResult
  reason = canBuy(itemId, price, ctx)
  if reason <> ""
    return {ok: false, reason: reason}
  end if
  applyEffects([{takeCoins: price}, {giveItem: itemId}], ctx)
  return {ok: true, reason: ""}
end function

' @return {string} "" if it can be used now, otherwise why not
function canUse(itemId as string, ctx as StoryContext) as string
  if not ctx.inventory.has(itemId)
    return "You have none"
  end if
  definition = ctx.items[itemId] as ItemDefinition
  for each effect in definition.onUse
    if effect.DoesExist("heal") and ctx.player.health >= ctx.player.maxHealth
      return "Already at full health"
    end if
  end for
  return ""
end function

' @return {ActionResult}
function useItem(itemId as string, ctx as StoryContext) as ActionResult
  reason = canUse(itemId, ctx)
  if reason <> ""
    return {ok: false, reason: reason}
  end if
  ctx.inventory.remove(itemId)
  definition = ctx.items[itemId] as ItemDefinition
  applyEffects(definition.onUse, ctx)
  return {ok: true, reason: ""}
end function
