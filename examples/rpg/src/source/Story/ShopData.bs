' examples/rpg/src/source/Story/ShopData.bs
import "pkg:/source/story/StoryState.bs"
import "RpgStoryTypes.bs"

' Hilde's wares, in display order.
'
' @return {ShopItem[]}
function getShopItems() as ShopItem[]
  return [
    {itemId: "steelSword", price: 10},
    {itemId: "heartContainer", price: 15},
    {itemId: "potion", price: 4}
  ]
end function

' @return {string} "" if it can be bought, otherwise why not
function canBuy(itemId as string, price as integer, state as BGE.Story.StoryState, player as PlayerStats) as string
  if not state.inventory.canAdd(itemId)
    definition = state.items[itemId] as RpgItemDefinition
    if definition.max = 1
      return "Already owned"
    end if
    return "Can't carry more"
  end if
  if player.coins < price
    return "Not enough coins"
  end if
  return ""
end function

' @return {ActionResult}
function buyItem(itemId as string, price as integer, state as BGE.Story.StoryState, player as PlayerStats) as ActionResult
  reason = canBuy(itemId, price, state, player)
  if reason <> ""
    return {ok: false, reason: reason}
  end if
  state.applyEffects([{takeCoins: price}, {giveItem: itemId}])
  return {ok: true, reason: ""}
end function

' @return {string} "" if it can be used now, otherwise why not
function canUse(itemId as string, state as BGE.Story.StoryState, player as PlayerStats) as string
  if not state.inventory.has(itemId)
    return "You have none"
  end if
  definition = state.items[itemId] as RpgItemDefinition
  for each effect in definition.onUse
    if effect.DoesExist("heal") and player.health >= player.maxHealth
      return "Already at full health"
    end if
  end for
  return ""
end function

' @return {ActionResult}
function useItem(itemId as string, state as BGE.Story.StoryState, player as PlayerStats) as ActionResult
  reason = canUse(itemId, state, player)
  if reason <> ""
    return {ok: false, reason: reason}
  end if
  state.inventory.remove(itemId)
  definition = state.items[itemId] as RpgItemDefinition
  state.applyEffects(definition.onUse)
  return {ok: true, reason: ""}
end function
