import "StoryFlags.bs"
import "Inventory.bs"
import "Items.bs"
import "StoryTypes.bs"

' Story state at a numbered checkpoint, for jumping there with --param stage=N while testing.
' 0 new game, 1 hunting rats, 2 rats done (report to Bram), 3 vouched (no sword), 4 gate open, 5 met Mara in the keep, 6 goblin king beaten, 7 throne room door open, 8 witch defeated (report to Bram).
'
' @param {integer} n
' @return {StoryCheckpoint}
function checkpointState(n as integer) as StoryCheckpoint
  flags = new StoryFlags()
  carried = new Inventory(getItemDefinitions())
  coins = 0
  if n >= 1
    flags.set("rats.stage", 1)
  end if
  if n >= 2
    flags.set("rats.stage", 2)
    flags.set("rats.kills", 4)
  end if
  if n >= 3
    flags.set("rats.stage", 3)
    flags.set("bram.vouched", true)
    flags.set("gate.stage", 1)
    coins = 10
  end if
  if n >= 4
    carried.add("steelSword")
    flags.set("gate.open", true)
    flags.set("gate.stage", 2)
    coins = 0
  end if
  if n >= 5
    flags.set("keep.stage", 1)
    flags.set("gate.stage", 3)
  end if
  if n >= 6
    for each key in ["dng.guard.cleared", "dng.guard.keyTaken", "dng.L1.open", "dng.portcullis", "dng.ante.a", "dng.ante.b", "dng.ante.solved", "dng.ante.keyTaken", "dng.L2.open", "dng.kingDefeated"]
      flags.set(key, true)
    end for
    flags.set("keep.stage", 3)
    carried.add("throneKey")
  end if
  if n >= 7
    flags.set("dng.throneDoor.tried", true)
    flags.set("dng.throneDoor.open", true)
  end if
  if n >= 8
    flags.set("throne.introSeen", true)
    flags.set("witch.defeated", true)
    flags.set("keep.stage", 4)
  end if
  return {flags: flags, inventory: carried, coins: coins}
end function

' Where a checkpoint starts when no scene is given.
'
' @param {integer} n
' @return {string} scene name
function checkpointScene(n as integer) as string
  if n >= 8
    return "TownScene"
  else if n >= 7
    return "ThroneRoomScene"
  else if n >= 6
    return "KingsHallScene"
  else if n >= 5
    return "CastleScene"
  end if
  return "TownScene"
end function
