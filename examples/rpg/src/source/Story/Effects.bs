import "StoryFlags.bs"
import "Inventory.bs"
import "Items.bs"
import "StoryTypes.bs"

' Everything story data reads and changes.
'
' @param {StoryFlags} flags
' @param {Inventory} carried
' @param {PlayerStats} playerStats - the Player entity, or a plain AA in tests
' @return {StoryContext}
function newStoryContext(flags as StoryFlags, carried as Inventory, playerStats as PlayerStats) as StoryContext
  return {flags: flags, inventory: carried, player: playerStats, items: getItemDefinitions()}
end function

' Applies story data's "effects" lists in order. Effects: {set, value}, {add, amount},
' {giveItem}, {takeItem}, {giveCoins}, {takeCoins}, {heal}, {addMaxHealth}, {post}, {message}.
'
' @param {StoryEffect[]} effects - or invalid
' @param {StoryContext} ctx - newStoryContext()
' @return {StoryResult}
function applyEffects(effects as StoryEffect[], ctx as StoryContext) as StoryResult
  result = {changed: false, posts: [], messages: []} as StoryResult
  if effects = invalid
    return result
  end if
  for each effect in effects
    if applyEffect(effect, ctx, result)
      result.changed = true
    end if
  end for
  return result
end function

function applyEffect(effect as StoryEffect, ctx as StoryContext, result as StoryResult) as boolean
  stats = ctx.player
  if effect.DoesExist("set")
    return ctx.flags.set(effect.set, effect.value)
  else if effect.DoesExist("add")
    return ctx.flags.add(effect.add, effect.amount)
  else if effect.DoesExist("giveItem")
    if not ctx.inventory.add(effect.giveItem)
      return false
    end if
    acquiredItem = ctx.items[effect.giveItem] as ItemDefinition
    acquired = applyEffects(acquiredItem.onAcquire, ctx)
    for each eventName in acquired.posts
      result.posts.push(eventName)
    end for
    for each text in acquired.messages
      result.messages.push(text)
    end for
    return true
  else if effect.DoesExist("takeItem")
    return ctx.inventory.remove(effect.takeItem)
  else if effect.DoesExist("giveCoins")
    stats.coins += effect.giveCoins
    return effect.giveCoins <> 0
  else if effect.DoesExist("takeCoins")
    before = stats.coins
    stats.coins -= effect.takeCoins
    if stats.coins < 0
      stats.coins = 0
    end if
    return before <> stats.coins
  else if effect.DoesExist("heal")
    before = stats.health
    stats.health += effect.heal
    if stats.health > stats.maxHealth
      stats.health = stats.maxHealth
    end if
    return before <> stats.health
  else if effect.DoesExist("addMaxHealth")
    stats.maxHealth += effect.addMaxHealth
    return true
  else if effect.DoesExist("post")
    result.posts.push(effect.post)
    return false
  else if effect.DoesExist("message")
    result.messages.push(effect.message)
    return false
  end if
  print "[rpg] warning: unknown story effect " + FormatJson(effect)
  return false
end function
