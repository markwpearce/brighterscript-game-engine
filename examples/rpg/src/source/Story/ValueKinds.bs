' Real Roku and brs-engine name boxed/unboxed types differently (roInt vs roInteger vs Integer); fold each to one kind.
'
' @return {string} "integer", "float", "boolean", "string", or the lowercased type name
function valueKind(value as dynamic) as string
  valueType = LCase(type(value))
  if Left(valueType, 2) = "ro"
    valueType = Mid(valueType, 3)
  end if
  if valueType = "int" or valueType = "integer" or valueType = "longinteger"
    return "integer"
  else if valueType = "float" or valueType = "double"
    return "float"
  else if valueType = "boolean"
    return "boolean"
  else if valueType = "string"
    return "string"
  end if
  return valueType
end function
