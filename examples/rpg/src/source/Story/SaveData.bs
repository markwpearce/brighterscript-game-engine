' examples/rpg/src/source/Story/SaveData.bs
import "pkg:/source/story/ValueKinds.bs"
import "pkg:/source/story/StoryState.bs"
import "RpgStoryTypes.bs"

const SAVE_VERSION = 2
const SAVE_SECTION = "bge-rpg"
const SAVE_KEY = "save"

' @param {string} sceneName - the area to resume in
' @param {string} spawn - the spawn point to resume at
' @param {BGE.Story.StoryState} state
' @param {PlayerStats} playerStats
' @return {SaveData}
function buildSaveData(sceneName as string, spawn as string, state as BGE.Story.StoryState, playerStats as PlayerStats) as SaveData
  story = state.toSaveData()
  return {
    version: SAVE_VERSION,
    scene: sceneName,
    spawn: spawn,
    flags: story.flags,
    inventory: story.inventory,
    visits: story.visits,
    player: {health: playerStats.health, maxHealth: playerStats.maxHealth, coins: playerStats.coins}
  }
end function

' Checks a loaded save. Anything malformed or from an unknown version counts as no save; version 1 saves (no visits) still load.
'
' @param {dynamic} data - what registryRead() returned
' @return {SaveData} the save with health clamped to 1..maxHealth, or invalid
function validateSaveData(data as dynamic) as SaveData
  if type(data) <> "roAssociativeArray"
    return invalid
  end if
  if not isSaveInt(data.version)
    return invalid
  end if
  if data.version <> 1 and data.version <> SAVE_VERSION
    return invalid
  end if
  if not isSaveString(data.scene) or not isSaveString(data.spawn)
    return invalid
  end if
  if type(data.flags) <> "roAssociativeArray" or type(data.inventory) <> "roAssociativeArray" or type(data.player) <> "roAssociativeArray"
    return invalid
  end if
  if data.visits <> invalid and type(data.visits) <> "roAssociativeArray"
    return invalid
  end if
  ' flags/inventory/visits contents are not checked here: BGE.Story.StoryState.loadSaveData() sanitizes them on load.
  playerData = data.player
  if not isSaveInt(playerData.health) or not isSaveInt(playerData.maxHealth) or not isSaveInt(playerData.coins)
    return invalid
  end if
  ' Only compared once all three are known to be integers.
  if playerData.maxHealth < 1
    return invalid
  end if
  if playerData.health < 1
    playerData.health = 1
  else if playerData.health > playerData.maxHealth
    playerData.health = playerData.maxHealth
  end if
  return data
end function

function isSaveInt(value as dynamic) as boolean
  return BGE.Story.valueKind(value) = "integer"
end function

function isSaveString(value as dynamic) as boolean
  return BGE.Story.valueKind(value) = "string"
end function
