' Shapes of the story's data and results. Engine-free, so the story's unit tests can use them.
import "StoryFlags.bs"
import "Inventory.bs"

' What a Player entity has that the story reads and changes (tests pass a plain AA).
interface PlayerStats
  health as integer
  maxHealth as integer
  coins as integer
end interface

' Everything story data reads and changes (see newStoryContext()).
interface StoryContext
  flags as StoryFlags
  inventory as Inventory
  player as PlayerStats
  ' item id -> ItemDefinition
  items as roAssociativeArray
end interface

' One entry in a "when" list. Exactly one of flag/notFlag/hasItem/notItem/coinsGte is set;
' flag may add one of eq/gte/lt.
interface StoryCondition extends roAssociativeArray
  optional flag as string
  optional eq as boolean or integer or string
  optional gte as integer
  optional lt as integer
  optional notFlag as string
  optional hasItem as string
  optional notItem as string
  optional coinsGte as integer
end interface

' One entry in an "effects" list. Exactly one of set/add/giveItem/takeItem/giveCoins/takeCoins/
' heal/addMaxHealth/post/message is set; set takes value, add takes amount.
interface StoryEffect extends roAssociativeArray
  ' Shown in a speaker-less dialogue box once nothing else is open.
  optional message as string
  optional set as string
  optional value as boolean or integer or float or string
  optional add as string
  optional amount as integer
  optional giveItem as string
  optional takeItem as string
  optional giveCoins as integer
  optional takeCoins as integer
  optional heal as integer
  optional addMaxHealth as integer
  optional post as string
end interface

' A button at the end of a dialogue page.
interface DialogueChoice extends roAssociativeArray
  label as string
  optional effects as StoryEffect[]
  ' "shop" opens the shop once the dialogue closes.
  optional open as string
end interface

' One thing an NPC can say: the first page whose `when` passes is used.
interface DialoguePage extends roAssociativeArray
  optional when as StoryCondition[]
  speaker as string
  lines as string[]
  optional effects as StoryEffect[]
  optional choices as DialogueChoice[]
end interface

' A story change that happens on a game event, without dialogue.
interface EventRule extends roAssociativeArray
  event as string
  ' Each key must equal the same field of the event's data.
  optional match as roAssociativeArray
  optional when as StoryCondition[]
  effects as StoryEffect[]
end interface

interface ItemDefinition extends roAssociativeArray
  name as string
  icon as string
  max as integer
  optional onAcquire as StoryEffect[]
  optional onUse as StoryEffect[]
end interface

interface ShopItem
  itemId as string
  price as integer
end interface

interface QuestDefinition extends roAssociativeArray
  id as string
  title as string
  stageFlag as string
  ' stage number (as a string) -> objective text
  stages as roAssociativeArray
end interface

interface SaveData extends roAssociativeArray
  version as integer
  scene as string
  spawn as string
  flags as roAssociativeArray
  inventory as roAssociativeArray
  player as PlayerStats
end interface

' What a batch of effects or rules did.
interface StoryResult
  changed as boolean
  ' event names to post, in order
  posts as string[]
  ' message effects' text, in order
  messages as string[]
end interface

' The outcome of buying or using an item.
interface ActionResult
  ok as boolean
  ' why not, when ok is false
  reason as string
end interface

interface StoryCheckpoint
  flags as StoryFlags
  inventory as Inventory
  coins as integer
end interface

' An open panel that the Story forwards its buttons' actions to.
interface StoryPanel
  sub onAction(actionId as string)
end interface
