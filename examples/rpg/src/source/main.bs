import "Scenes/TownScene.bs"
import "Scenes/CastleScene.bs"
import "Entities/Player.bs"


sub Main(args = {} as object)
  game = new BGE.Game(640, 360)
  game.fitCanvasToScreen()
  game.loadBitmap("town", "pkg:/sprites/PathAndObjects.png")
  game.loadBitmap("castle", "pkg:/sprites/Castle2.png")
  game.loadBitmap("adventurer", "pkg:/sprites/adventurer.png")
  game.loadBitmap("rat", "pkg:/sprites/rat.png")
  game.loadBitmap("bat", "pkg:/sprites/bat.png")
  game.loadBitmap("heart", "pkg:/sprites/heart.png")
  game.loadBitmap("coin", "pkg:/sprites/coin.png")
  ' A 2x copy of the 9x9 coin for the world, so it matches the 32px tiles' pixel size.
  game.loadBitmap("coinWorld", {width: 18, height: 18, AlphaEnable: true})
  game.getBitmap("coinWorld").DrawScaledObject(0, 0, 2, 2, game.getBitmap("coin"))

  game.loadSound("sword", "pkg:/sounds/sword.wav")
  game.loadSound("enemyHit", "pkg:/sounds/enemy_hit.wav")
  game.loadSound("enemyDie", "pkg:/sounds/enemy_die.wav")
  game.loadSound("pain", "pkg:/sounds/pain.wav")
  game.loadSound("die", "pkg:/sounds/die.wav")
  game.loadSound("coin", "pkg:/sounds/coin.wav")
  game.loadSound("lowHealth", "pkg:/sounds/low_health.wav")

  game.registerFont("pkg:/fonts/quill-and-antler-expanded.ttf")
  game.loadFont("hud", "Quill and Antler Expanded", Int(game.uiCanvas.getHeight() / 20), false, false)
  game.enableControllerInput()
  game.controls.bindAxis("move", "1", 0, "Move")

  ' Created once and persistent - it survives every scene change.
  playerEntity = new Player(game)
  game.addEntity(playerEntity)

  town = new TownScene(game)
  game.defineScene(town)
  castle = new CastleScene(game)
  game.defineScene(castle)

  startScene = "TownScene"
  ' Deep link (e.g. rokubot launch dev --param scene=CastleScene) for checking one area directly.
  if args.scene <> invalid
    startScene = args.scene
  end if
  game.changeSceneWithFade(startScene, {spawn: "gate"})
  game.play()
end sub
