import "Scenes/TownScene.bs"
import "Scenes/CastleScene.bs"
import "Scenes/DungeonScenes.bs"
import "Scenes/SewerScene.bs"
import "Scenes/GoblinShowcaseScene.bs"
import "Scenes/TitleScene.bs"
import "World/PlayerSetup.bs"
import "UI/HeartsHud.bs"
import "UI/BossBar.bs"
import "UI/SaveIndicator.bs"
import "Story/Story.bs"
import "Story/Checkpoints.bs"
import "Story/DebugParams.bs"
import "UI/UiSkin.bs"


sub Main(args = {} as roAssociativeArray)
  game = new BGE.Game(640, 360)
  game.fitCanvasToScreen()
  game.loadBitmap("town", "pkg:/sprites/PathAndObjects.png")
  game.loadBitmap("castle", "pkg:/sprites/Castle2.png")
  game.loadBitmap("adventurer", "pkg:/sprites/adventurer.png")
  game.loadBitmap("rat", "pkg:/sprites/rat.png")
  game.loadBitmap("bat", "pkg:/sprites/bat.png")
  game.loadBitmap("heart", "pkg:/sprites/heart.png")
  game.loadBitmap("coin", "pkg:/sprites/coin.png")
  game.loadBitmap("npcs", "pkg:/sprites/npcs.png")
  game.loadBitmap("potion", "pkg:/sprites/items/potion.png")
  game.loadBitmap("swordSteel", "pkg:/sprites/items/swordSteel.png")
  game.loadBitmap("swordRusty", "pkg:/sprites/items/swordRusty.png")
  game.loadBitmap("goblin", "pkg:/sprites/goblin.png")
  game.loadBitmap("keys", "pkg:/sprites/items/keys.png")
  game.loadBitmap("indoor", "pkg:/sprites/indoorTiles.png")
  game.loadBitmap("title", "pkg:/images/title.jpg")
  ' A 2x copy of the 9x9 coin for the world, so it matches the 32px tiles' pixel size.
  game.loadBitmap("coinWorld", {width: 18, height: 18, AlphaEnable: true})
  game.getBitmap("coinWorld").DrawScaledObject(0, 0, 2, 2, game.getBitmap("coin"))
  ' 4x copies of the 9px heart and coin, close to the 34px item icons in the inventory.
  game.loadBitmap("heartIcon", {width: 36, height: 36, AlphaEnable: true})
  game.getBitmap("heartIcon").DrawScaledObject(0, 0, 4, 4, game.getBitmap("heart"))
  game.loadBitmap("coinIcon", {width: 36, height: 36, AlphaEnable: true})
  game.getBitmap("coinIcon").DrawScaledObject(0, 0, 4, 4, game.getBitmap("coin"))
  ' 32px icons cut from the key strip: the iron key and the gold heart key.
  game.loadBitmap("smallKey", {width: 32, height: 32, AlphaEnable: true})
  game.getBitmap("smallKey").DrawObject(0, 0, CreateObject("roRegion", game.getBitmap("keys"), 0, 0, 32, 32))
  game.loadBitmap("throneKey", {width: 32, height: 32, AlphaEnable: true})
  game.getBitmap("throneKey").DrawObject(0, 0, CreateObject("roRegion", game.getBitmap("keys"), 64, 0, 32, 32))
  ' The indoor sheet's 16px teal floor tile at 2x, for floor switches.
  game.loadBitmap("floorSwitch", {width: 32, height: 32, AlphaEnable: true})
  game.getBitmap("floorSwitch").DrawScaledObject(0, 0, 2, 2, CreateObject("roRegion", game.getBitmap("indoor"), 80, 96, 16, 16))

  game.loadSound("sword", "pkg:/sounds/sword.wav")
  game.loadSound("enemyHit", "pkg:/sounds/enemy_hit.wav")
  game.loadSound("enemyDie", "pkg:/sounds/enemy_die.wav")
  game.loadSound("pain", "pkg:/sounds/pain.wav")
  game.loadSound("die", "pkg:/sounds/die.wav")
  game.loadSound("coin", "pkg:/sounds/coin.wav")
  game.loadSound("lowHealth", "pkg:/sounds/low_health.wav")

  game.registerFont("pkg:/fonts/quill-and-antler-expanded.ttf")
  game.loadFont("hud", "Quill and Antler Expanded", Int(game.uiCanvas.getHeight() / 20), false, false)
  ' Button labels, 20% smaller than the hud text.
  game.loadFont("button", "Quill and Antler Expanded", Int(game.uiCanvas.getHeight() / 20 * 0.8), false, false)
  ' Labels and buttons draw with the theme font, so panels measure and draw with the same one.
  game.defaultTheme.font = game.getFont("hud")
  ' Every Button draws the red 9-patch; the focused one gets a gold ring.
  game.defaultTheme.backgroundImage = getButtonSkin(game)
  game.defaultTheme.focusedBorderColor = &hFFD966FF
  ' Drawn in the world, which the game canvas scales up 2-3x.
  game.loadFont("damage", "Quill and Antler Expanded", 14, false, false)
  game.enableControllerInput()
  game.controls.bindAxis("move", "1", 0, "Move")
  ' The left stick also steps menu focus (list mode); the d-pad still works.
  game.focusManager.analogAxisName = "move"
  game.focusManager.analogListRepeatDelay = 0.3

  ' gameUi survives scene changes, like the player, so the HUD is added once.
  hud = new HeartsHud(game)
  game.gameUi.addChild(hud)
  bossHealthBar = new BossBar(game)
  game.gameUi.addChild(bossHealthBar)
  saveNote = new SaveIndicator(game)
  game.gameUi.addChild(saveNote)
  ' Persistent and never paused - owns the story state and opens the dialogue/shop/inventory panels.
  storyEntity = new Story(game)
  game.addEntity(storyEntity)

  town = new TownScene(game)
  game.defineScene(town)
  castle = new CastleScene(game)
  game.defineScene(castle)
  sewer = new SewerScene(game)
  game.defineScene(sewer)
  guardroom = new GuardroomScene(game)
  game.defineScene(guardroom)
  storeroom = new StoreroomScene(game)
  game.defineScene(storeroom)
  barracks = new BarracksScene(game)
  game.defineScene(barracks)
  antechamber = new AntechamberScene(game)
  game.defineScene(antechamber)
  kingsHall = new KingsHallScene(game)
  game.defineScene(kingsHall)
  showcase = new GoblinShowcaseScene(game)
  game.defineScene(showcase)

  title = new TitleScene(game)
  game.defineScene(title)

  ' Deep links for checking an area or story point directly; they never touch the real save.
  ' e.g. rokubot launch dev --param scene=GuardroomScene --param stage=5 --param flags=dng.guard.cleared
  ' Also: spawn=<id>, items=smallKey:2,throneKey, peaceful=1 (no enemies), open=inventory.
  if args.scene <> invalid or args.stage <> invalid
    storyEntity.savingEnabled = false
    ensurePlayer(game)
    storyEntity.newGame()
    startScene = "TownScene"
    if args.stage <> invalid
      storyEntity.applyCheckpoint(args.stage.toInt())
      startScene = checkpointScene(args.stage.toInt())
    end if
    if args.scene <> invalid
      startScene = args.scene
    end if
    for each flagName in parseFlagList(args.flags)
      storyEntity.flags.set(flagName, true)
    end for
    items = parseItemList(args.items)
    for each itemId in items
      for i = 1 to items[itemId]
        storyEntity.inventory.add(itemId)
      end for
    end for
    storyEntity.peaceful = args.peaceful <> invalid and args.peaceful = "1"
    if args.open <> invalid
      storyEntity.openOnArrival = args.open
    end if
    spawn = "start"
    if args.spawn <> invalid
      spawn = args.spawn
    end if
    game.changeSceneWithFade(startScene, {spawn: spawn})
  else
    game.changeSceneWithFade("TitleScene", {})
  end if
  ' Toggled with the * (options) button - see AreaScene.onInput().
  game.enableStandardDebugUi({memory: false, garbageCollector: false, log: false})
  game.play()
end sub
