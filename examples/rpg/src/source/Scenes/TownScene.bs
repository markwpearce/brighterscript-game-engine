import "AreaScene.bs"
import "../Maps/MapData.bs"

class TownScene extends AreaScene

  sub new(game as BGE.Game)
    super(game)
    m.name = "TownScene"
  end sub

  override function getRows() as string[]
    return getTownRows()
  end function

  override function getPlacements() as object
    return getTownPlacements()
  end function

end class
