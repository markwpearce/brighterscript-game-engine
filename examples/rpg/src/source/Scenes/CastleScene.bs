import "AreaScene.bs"
import "../Maps/DungeonData.bs"

class CastleScene extends AreaScene

  sub new(game as BGE.Game)
    super(game)
    m.name = "CastleScene"
  end sub

  override function getRows() as string[]
    return getCastleRows()
  end function

  override function getPlacements() as MapPlacement[]
    return getCastlePlacements()
  end function

end class
