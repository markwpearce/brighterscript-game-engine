import "../UI/MenuPanel.bs"
import "../UI/ControlsPanel.bs"
import "../UI/TitleBackground.bs"
import "../UI/InputRoles.bs"
import "../Story/Story.bs"
import "../World/PlayerSetup.bs"

' The first screen: the key art with Continue (when there's a save), New Game and Controls on the left,
' below the logo. Back exits.
class TitleScene extends BGE.GameScene

  private background as TitleBackground = invalid
  private menu as MenuPanel = invalid
  private controlsPanel as ControlsPanel = invalid
  private leaving as boolean = false

  sub new(game as BGE.Game)
    super(game)
    m.name = "TitleScene"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.leaving = false
    m.background = new TitleBackground(m.game)
    m.game.gameUi.addChild(m.background)
    m.controlsPanel = invalid
    m.openMenu()
  end sub

  ' Left column, under the logo (which fills roughly the top third of the art).
  private sub openMenu()
    uiW = m.game.uiCanvas.getWidth()
    uiH = m.game.uiCanvas.getHeight()
    m.menu = new MenuPanel(m.game, uiW * UI_SAFE, uiH * 0.42, uiW * 0.24, "TitleScene")
    storyEntity = m.game.getEntityByName("Story") as Story
    if storyEntity.readSave() <> invalid
      m.menu.addAction("continue", "Continue")
    end if
    m.menu.addAction("newGame", "New Game")
    m.menu.addAction("controls", "Controls")
    m.menu.open(m.game.gameUi)
  end sub

  ' The menu is dropped while Controls is open so focus can't wander back onto its buttons.
  private sub openControls()
    m.closeMenu()
    m.controlsPanel = new ControlsPanel(m.game, "TitleScene")
    m.controlsPanel.open(m.game.gameUi)
  end sub

  private sub closeControls()
    if m.controlsPanel = invalid
      return
    end if
    m.controlsPanel.close(m.game.gameUi)
    m.controlsPanel = invalid
    m.openMenu()
    m.game.focusManager.focusWidget(m.menu.buttons[m.menu.buttons.count() - 1])
  end sub

  sub onMenuAction(actionId as string)
    if m.leaving
      return
    end if
    if actionId = "controls"
      m.openControls()
      return
    else if actionId = "closeControls"
      m.closeControls()
      return
    end if
    m.leaving = true
    storyEntity = m.game.getEntityByName("Story") as Story
    ' Drop the menu now (unregisters its buttons from focus) but keep the art up during the fade.
    m.closeMenu()
    ensurePlayer(m.game)
    if actionId = "continue"
      save = storyEntity.readSave()
      storyEntity.loadSave(save)
      m.game.changeSceneWithFade(save.scene, {spawn: save.spawn})
    else
      storyEntity.deleteSave()
      storyEntity.newGame()
      m.game.changeSceneWithFade("TownScene", {spawn: "start"})
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if m.leaving or m.game.isTransitioning()
      return
    end if
    if m.controlsPanel <> invalid
      if input.press and input.isButton("back")
        m.closeControls()
      end if
    else if isQuitButton(input.press, input.button)
      m.game.End()
    end if
  end sub

  ' Runs when the fade-out finishes and the next scene is about to be created.
  override sub onChangeScene(newScene as BGE.GameScene)
    m.leaveTitle()
  end sub

  override sub onDestroy()
    m.leaveTitle()
  end sub

  private sub closeMenu()
    if m.menu <> invalid
      m.menu.close(m.game.gameUi)
      m.menu = invalid
    end if
  end sub

  private sub leaveTitle()
    m.closeMenu()
    if m.controlsPanel <> invalid
      m.controlsPanel.close(m.game.gameUi)
      m.controlsPanel = invalid
    end if
    if m.background <> invalid
      m.game.gameUi.removeChild(m.background)
      m.background = invalid
    end if
  end sub

end class
