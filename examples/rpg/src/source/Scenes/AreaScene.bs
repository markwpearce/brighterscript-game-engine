import "../Maps/MapData.bs"
import "pkg:/source/engine/colliders/SolidWorld.bs"
import "../World/TileMapEntity.bs"
import "../World/Prop.bs"
import "../Entities/Player.bs"
import "../World/Door.bs"
import "../Entities/Rat.bs"
import "../Entities/Bat.bs"

' Outline colour for SolidWorld walls in the debug overlay (packed RGBA).
const SOLID_DEBUG_RGBA = &h00FFFFFF

' Shared setup for an area: builds the ground and props from map data, has the camera follow the
' player inside the map, and exits the channel on Back. Subclasses supply getRows()/getPlacements().
class AreaScene extends BGE.GameScene

  solidWorld as BGE.SolidWorld = invalid
  mapWidth as float = 0
  mapHeight as float = 0
  ' Spawn id -> {x, y, facing}: player feet position on arrival.
  spawns as roAssociativeArray = {}

  sub new(game as BGE.Game)
    super(game)
  end sub

  function getRows() as string[]
    return []
  end function

  function getPlacements() as object
    return []
  end function

  override sub onCreate(args as roAssociativeArray)
    rows = m.getRows()
    numRows = rows.count()
    m.mapWidth = rows[0].len() * TILE_SIZE
    m.mapHeight = numRows * TILE_SIZE
    m.solidWorld = new BGE.SolidWorld()
    m.spawns = {}

    tileMap = new TileMapEntity(m.game)
    m.game.addEntity(tileMap, {rows: rows, solidWorld: m.solidWorld})
    addPlacementSolids(m.solidWorld, m.getPlacements(), numRows)

    for each item in m.getPlacements()
      if item.atlasKey <> invalid
        newProp = new Prop(m.game)
        m.game.addEntity(newProp, {atlasKey: item.atlasKey, x: item.col * TILE_SIZE, y: cellBottomY(numRows, item.row), solidWorld: m.solidWorld})
      else if item.type = "door"
        newDoor = new Door(m.game)
        m.game.addEntity(newDoor, {x: item.col * TILE_SIZE, y: cellBottomY(numRows, item.row), w: item.w * TILE_SIZE, h: item.h * TILE_SIZE, target: item.target, spawn: item.spawn})
      else if item.type = "enemy"
        m.addEnemy(item, numRows)
      else if item.type = "spawn"
        ' Feet a little above the cell's bottom edge, so the 12px-tall feet box sits inside the cell.
        m.spawns[item.id] = {x: item.col * TILE_SIZE, y: cellBottomY(numRows, item.row) + 10, facing: item.facing}
      end if
    end for

    spawnId = args.spawn
    if spawnId = invalid or m.spawns[spawnId] = invalid
      spawnId = m.spawns.Keys()[0]
    end if
    spawn = m.spawns[spawnId]
    playerEntity = m.game.getEntityByName("Player") as Player
    playerEntity.placeAt(spawn.x, spawn.y, spawn.facing, m.solidWorld, spawnId)
    camera = m.game.canvas.renderer.camera as BGE.Camera2d
    camera.setBounds(0, 0, m.mapWidth, m.mapHeight)
    camera.follow(playerEntity)
  end sub

  private sub addEnemy(item as object, numRows as integer)
    feet = enemySpawnPoint(item, numRows)
    args = {x: feet.x, y: feet.y, solidWorld: m.solidWorld, mapWidth: m.mapWidth, mapHeight: m.mapHeight}
    if item.kind = "bat"
      newBat = new Bat(m.game)
      m.game.addEntity(newBat, args)
    else
      newRat = new Rat(m.game)
      m.game.addEntity(newRat, args)
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    else if input.press and input.isButton("play")
      m.game.postGameEvent("inventoryRequested")
    else if input.press and input.isButton("options")
      ' Fps/input overlays, collider outlines, and (below) the SolidWorld's walls.
      showDebug = not m.game.isDebugUiEnabled()
      m.game.debugShowUi(showDebug, true)
      m.game.debugDrawColliders(showDebug)
    end if
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    if not m.game.isDebugUiEnabled() or m.solidWorld = invalid
      return
    end if
    for each solid in m.solidWorld.getSolids()
      ' Outlines are drawn from the top-left corner, which is (x, y + h) in world +y up.
      topLeft = gameRenderer.worldPointToCanvasPoint(BGE.Math.VectorOps.create(solid.x, solid.y + solid.h))
      if topLeft <> invalid
        gameRenderer.drawRectangleOutline(topLeft.x, topLeft.y, solid.w, solid.h, SOLID_DEBUG_RGBA)
      end if
    end for
  end sub

end class
