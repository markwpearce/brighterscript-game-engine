import "../Maps/MapData.bs"
import "pkg:/source/engine/colliders/SolidWorld.bs"
import "../World/TileMapEntity.bs"
import "../World/Prop.bs"
import "../Entities/Player.bs"
import "../UI/InputRoles.bs"
import "../World/Door.bs"
import "../Entities/Rat.bs"
import "../Entities/Bat.bs"
import "../Entities/Goblin.bs"
import "../Entities/GoblinKing.bs"
import "../Entities/Npc.bs"
import "../Story/Story.bs"
import "../Story/Conditions.bs"
import "../Maps/MapTypes.bs"
import "../Entities/Shapes.bs"
import "../Maps/LivePlacements.bs"
import "../World/Gate.bs"
import "../World/Pickup.bs"
import "../World/FloorSwitch.bs"
import "../World/Pot.bs"
import "../Entities/Enemy.bs"

' Outline colour for SolidWorld walls in the debug overlay (packed RGBA).
const SOLID_DEBUG_RGBA = &h00FFFFFF

' Shared setup for an area: builds the ground and props from map data, has the camera follow the
' player inside the map, and exits the channel on Back. Subclasses supply getRows()/getPlacements().
class AreaScene extends BGE.GameScene

  solidWorld as BGE.SolidWorld = invalid
  mapWidth as float = 0
  mapHeight as float = 0
  ' Spawn id -> {x, y, facing}: player feet position on arrival.
  spawns as roAssociativeArray = {}
  ' Feet points {x, y} of every `drain` placement (where the sewer's new rats come from).
  drains as Point[] = []
  ' Every placement, so live ones can be built later by index.
  placements as MapPlacement[] = []
  ' Placement index (as a string) -> the entity built for each live placement present now.
  liveEntities as roAssociativeArray = {}
  private numRows as integer = 0
  private enemiesPlaced as integer = 0

  sub new(game as BGE.Game)
    super(game)
  end sub

  function getRows() as string[]
    return []
  end function

  function getPlacements() as MapPlacement[]
    return []
  end function

  override sub onCreate(args as roAssociativeArray)
    rows = m.getRows()
    numRows = rows.count()
    m.mapWidth = rows[0].len() * TILE_SIZE
    m.mapHeight = numRows * TILE_SIZE
    m.solidWorld = new BGE.SolidWorld()
    m.spawns = {}
    m.drains = [] as Point[]
    m.enemiesPlaced = 0

    m.numRows = numRows
    tileMap = new TileMapEntity(m.game)
    m.game.addEntity(tileMap, {rows: rows, solidWorld: m.solidWorld})
    storyEntity = m.game.getEntityByName("Story") as Story
    m.placements = m.getPlacements()
    built = filterPlacements(nonLivePlacements(m.placements), storyEntity.context())
    addPlacementSolids(m.solidWorld, built, numRows)
    for each item in built
      m.buildPlacement(item, numRows)
    end for
    m.liveEntities = {}
    m.refreshLivePlacements()

    spawnId = args.spawn
    if spawnId = invalid or m.spawns[spawnId] = invalid
      spawnId = m.spawns.Keys()[0]
    end if
    spawn = m.spawns[spawnId]
    playerEntity = m.game.getEntityByName("Player") as Player
    playerEntity.placeAt(spawn.x, spawn.y, spawn.facing, m.solidWorld, spawnId)
    camera = m.game.canvas.renderer.camera as BGE.Camera2d
    camera.setBounds(0, 0, m.mapWidth, m.mapHeight)
    camera.follow(playerEntity)
    storyEntity.arrivedAt(m.name, spawnId)
  end sub

  private function addEnemy(item as MapPlacement, numRows as integer) as BGE.GameEntity
    feet = enemySpawnPoint(item, numRows)
    args = {x: feet.x, y: feet.y, solidWorld: m.solidWorld, mapWidth: m.mapWidth, mapHeight: m.mapHeight}
    if item.kind = "bat"
      newBat = new Bat(m.game)
      m.game.addEntity(newBat, args)
      return newBat
    else if item.kind = "goblinKing"
      newKing = new GoblinKing(m.game)
      m.game.addEntity(newKing, args)
      return newKing
    else if item.kind = "goblin"
      newGoblin = new Goblin(m.game)
      m.game.addEntity(newGoblin, args)
      return newGoblin
    end if
    newRat = new Rat(m.game)
    m.game.addEntity(newRat, args)
    return newRat
  end function

  ' Builds one placement's entity (or records its spawn/drain point).
  '
  ' @return {BGE.GameEntity} the entity added, or invalid
  protected function buildPlacement(item as MapPlacement, numRows as integer) as BGE.GameEntity
    storyEntity = m.game.getEntityByName("Story") as Story
    x = item.col * TILE_SIZE
    y = cellBottomY(numRows, item.row)
    if item.atlasKey <> invalid
      newProp = new Prop(m.game)
      m.game.addEntity(newProp, {atlasKey: item.atlasKey, x: x, y: y, solidWorld: m.solidWorld})
      return newProp
    else if item.type = "door"
      newDoor = new Door(m.game)
      m.game.addEntity(newDoor, {x: x, y: y, w: item.w * TILE_SIZE, h: item.h * TILE_SIZE, target: item.target, spawn: item.spawn})
      return newDoor
    else if item.type = "enemy"
      if storyEntity.peaceful
        return invalid
      end if
      m.enemiesPlaced++
      return m.addEnemy(item, numRows)
    else if item.type = "drain"
      m.drains.push(enemySpawnPoint(item, numRows))
    else if item.type = "npc"
      feet = npcSpawnPoint(item, numRows)
      newNpc = new Npc(m.game)
      m.game.addEntity(newNpc, {npcId: item.npcId, character: item.character, x: feet.x, y: feet.y, facing: item.facing, wander: item.wander * 1.0, solidWorld: m.solidWorld})
      return newNpc
    else if item.type = "spawn"
      ' Feet a little above the cell's bottom edge, so the 12px-tall feet box sits inside the cell.
      m.spawns[item.id] = {x: x, y: y + 10, facing: item.facing}
    else if item.type = "gate"
      newGate = new Gate(m.game)
      m.game.addEntity(newGate, {x: x, y: y, w: item.w * TILE_SIZE, h: item.h * TILE_SIZE, style: item.style, side: item.side, unlock: item.unlock, solidWorld: m.solidWorld})
      return newGate
    else if item.type = "pickup"
      feet = enemySpawnPoint(item, numRows)
      newPickup = new Pickup(m.game)
      m.game.addEntity(newPickup, {x: feet.x, y: feet.y, item: item.item, icon: item.icon, effects: item.effects})
      return newPickup
    else if item.type = "pot"
      feet = enemySpawnPoint(item, numRows)
      newPot = new Pot(m.game)
      m.game.addEntity(newPot, {x: feet.x, y: feet.y, solidWorld: m.solidWorld})
      return newPot
    else if item.type = "switch"
      newSwitch = new FloorSwitch(m.game)
      m.game.addEntity(newSwitch, {x: x, y: y, id: item.id, flag: item.flag, effects: item.effects})
      return newSwitch
    end if
    return invalid
  end function

  ' Brings live placements in line with the story: builds the ones whose `when` now passes and
  ' removes (opens, for a gate) the ones whose `when` no longer does.
  private sub refreshLivePlacements()
    storyEntity = m.game.getEntityByName("Story") as Story
    diff = diffLivePlacements(m.placements, m.liveEntities, storyEntity.context())
    for each index in diff.remove
      key = index.toStr()
      entity = m.liveEntities[key] as BGE.GameEntity
      m.liveEntities.Delete(key)
      if entity <> invalid and entity.isValid()
        if entity.name = "Gate"
          (entity as Gate).open()
        else
          entity.invalidate()
        end if
      end if
    end for
    for each index in diff.add
      built = m.buildPlacement(m.placements[index], m.numRows)
      if built <> invalid
        m.liveEntities[index.toStr()] = built
      end if
    end for
  end sub

  override sub onGameEvent(eventName as string, data as roAssociativeArray)
    if eventName = "storyUpdated"
      m.refreshLivePlacements()
    else if eventName = "enemyKilled" and m.enemiesPlaced > 0
      ' The dying enemy is still an entity this frame, so count only the ones not dying.
      for each entity in m.game.getEntitiesByTag("enemy")
        if not (entity as Enemy).isDying
          return
        end if
      end for
      m.enemiesPlaced = 0
      m.game.postGameEvent("roomCleared", {room: m.name})
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if isQuitButton(input.press, input.button)
      m.game.End()
    else if isInventoryButton(input.press, input.button)
      m.game.postGameEvent("inventoryRequested")
    else if input.press and input.isButton("options")
      ' Fps/input overlays, collider outlines, and (below) the SolidWorld's walls.
      showDebug = not m.game.isDebugUiEnabled()
      m.game.debugShowUi(showDebug, true)
      m.game.debugDrawColliders(showDebug)
    end if
  end sub

  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    if not m.game.isDebugUiEnabled() or m.solidWorld = invalid
      return
    end if
    for each solid in m.solidWorld.getSolids()
      ' Outlines are drawn from the top-left corner, which is (x, y + h) in world +y up.
      topLeft = gameRenderer.worldPointToCanvasPoint(BGE.Math.VectorOps.create(solid.x, solid.y + solid.h))
      if topLeft <> invalid
        gameRenderer.drawRectangleOutline(topLeft.x, topLeft.y, solid.w, solid.h, SOLID_DEBUG_RGBA)
      end if
    end for
  end sub

end class
