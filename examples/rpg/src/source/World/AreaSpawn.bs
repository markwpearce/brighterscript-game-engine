import "pkg:/source/engine/sceneFlow/SpawnPoint.bs"
import "pkg:/source/math/vector.bs"
import "../Entities/Facing.bs"

' A spawn point and the way the player faces on arrival. Its position is the player's feet.
class AreaSpawn extends BGE.SpawnPoint

  facing as FacingDirection = FacingDirection.down

  sub new(id as string, position as BGE.Math.Vector, facing as FacingDirection)
    super(id, position, 0.0)
    m.facing = facing
  end sub

end class
