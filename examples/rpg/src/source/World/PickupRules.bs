import "pkg:/source/story/Inventory.bs"

' Whether walking over a pickup collects it. A pickup for an item already at its cap stays put.
'
' @param {dynamic} itemId - the pickup's item, or invalid for one that isn't an inventory item
' @param {BGE.Story.Inventory} carried
' @return {boolean}
function canCollectPickup(itemId as dynamic, carried as BGE.Story.Inventory) as boolean
  if itemId = invalid
    return true
  end if
  return carried.canAdd(itemId)
end function
