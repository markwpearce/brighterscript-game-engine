import "PickupRules.bs"
import "../Story/Story.bs"
import "../Story/StoryTypes.bs"
import "../Audio/PlayAudio.bs"

' How big a pickup's icon is drawn in the world (icons are 32-36px).
const PICKUP_SIZE = 20.0
const PICKUP_BOB_HEIGHT = 2.0
' Spinning pickups (keys): 16px frames drawn at 2x, like the tiles.
const PICKUP_SPIN_FRAME = 16
const PICKUP_SPIN_SCALE = 2.0

' Something on the floor that runs story effects when the player walks over it: a key, a potion,
' a heart container.
class Pickup extends BGE.GameEntity

  private itemId as dynamic = invalid
  private effects as StoryEffect[] = []
  private time as float = 0.0
  private art as BGE.Drawable = invalid
  ' The art's offset.y at rest, before the bob.
  private restY as float = 0.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "Pickup"
  end sub

  ' @param {roAssociativeArray} args - {x, y (bottom-centre), effects, item (optional), icon (optional)}
  override sub onCreate(args as roAssociativeArray)
    m.position.x = args.x
    m.position.y = args.y
    m.position.z = -args.y
    m.itemId = args.item
    m.effects = args.effects
    iconName = args.icon
    spinSheet = invalid
    if m.itemId <> invalid
      storyEntity = m.game.getEntityByName("Story") as Story
      definition = storyEntity.context().items[m.itemId] as ItemDefinition
      if iconName = invalid
        iconName = definition.icon
      end if
      spinSheet = definition.spinSheet
    end if
    if spinSheet <> invalid
      spinner = m.addSprite("spin", m.game.getBitmap(spinSheet), PICKUP_SPIN_FRAME, PICKUP_SPIN_FRAME)
      ' Bottom-centre on the entity, then scaled up from there.
      spinner.applyPreTranslation(-PICKUP_SPIN_FRAME / 2, -PICKUP_SPIN_FRAME)
      spinner.scale = BGE.Math.VectorOps.create(PICKUP_SPIN_SCALE, PICKUP_SPIN_SCALE, 1)
      spinner.addAnimation("spin", [0, 1, 2, 3, 4, 5, 6, 7], 10, BGE.SpritePlayMode.Loop)
      spinner.playAnimation("spin")
      m.art = spinner
    else
      bitmap = m.game.getBitmap(iconName)
      scale = PICKUP_SIZE / bitmap.GetWidth()
      m.art = m.addImage("icon", CreateObject("roRegion", bitmap, 0, 0, bitmap.GetWidth(), bitmap.GetHeight()), {
        offset: BGE.Math.VectorOps.create(-PICKUP_SIZE / 2, PICKUP_SIZE),
        scale: BGE.Math.VectorOps.create(scale, scale, 1),
        drawMode: BGE.SceneObjectDrawMode.matchCamera
      })
    end if
    m.restY = m.art.offset.y
    m.addRectangleCollider("pickup", PICKUP_SIZE - 4, PICKUP_SIZE - 4, -(PICKUP_SIZE - 4) / 2, PICKUP_SIZE - 4)
  end sub

  override sub onUpdate(dt as float)
    m.time += dt
    m.art.offset.y = m.restY + PICKUP_BOB_HEIGHT + Sin(m.time * 5) * PICKUP_BOB_HEIGHT
  end sub

  override sub onCollisionEnter(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    if otherEntity.name <> "Player" or otherCollider.name <> "feet" or not m.isValid()
      return
    end if
    storyEntity = m.game.getEntityByName("Story") as Story
    if not canCollectPickup(m.itemId, storyEntity.inventory)
      return
    end if
    playSfx(m.game, "coin")
    ' Invalidate first so the storyUpdated diff sees this pickup already gone.
    m.invalidate()
    storyEntity.runEffects(m.effects)
  end sub

end class
