import "pkg:/source/engine/sceneFlow/SceneExits.bs"
import "pkg:/source/engine/sceneFlow/SceneExit.bs"
import "pkg:/source/engine/sceneFlow/ExitArea.bs"
import "pkg:/source/engine/colliders/CircleSeparation.bs"
import "pkg:/source/engine/Game.bs"
import "../Entities/Player.bs"
import "../Audio/PlayAudio.bs"

' An area's doors: fades to another area when the player's feet walk into one, with the door
' sound. Spawn points sit just outside doors, since arriving on top of one would count as
' walking in.
class DoorExits extends BGE.SceneExits

  sub new(game as BGE.Game)
    super(game)
  end sub

  ' A door from its bottom-left corner and size, arriving at `spawn` in `target`. Grown by the
  ' feet box, so the player's position (the middle of the bottom of its feet) is in it as soon
  ' as the feet overlap the door.
  '
  ' @return {BGE.SceneExit}
  function addDoor(x as float, y as float, w as float, h as float, target as string, spawn as string) as BGE.SceneExit
    area = new BGE.RectExitArea(x - PLAYER_BOX_W / 2, y - PLAYER_BOX_H, w + PLAYER_BOX_W, h + PLAYER_BOX_H, BGE.SeparationPlane.xy)
    return m.add(area, target, {spawn: spawn})
  end function

  protected override sub onLeave(sceneExit as BGE.SceneExit)
    playSfx(m.game, "door")
  end sub

end class
