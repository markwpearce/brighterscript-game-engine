' A trigger zone that fades to another area when the player's feet walk into it. Spawn points
' sit just outside doors, since arriving on top of one would count as walking in.
class Door extends BGE.GameEntity

  target as string = ""
  spawn as string = ""

  sub new(game as BGE.Game)
    super(game)
    m.name = "Door"
  end sub

  ' @param {roAssociativeArray} args - {x, y (bottom-left), w, h, target (scene name), spawn (spawn id)}
  override sub onCreate(args as roAssociativeArray)
    m.position.x = args.x
    m.position.y = args.y
    m.target = args.target
    m.spawn = args.spawn
    m.addRectangleCollider("zone", args.w, args.h, 0, args.h)
  end sub

  override sub onCollisionEnter(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
    ' Only the feet - the sword's hitbox reaching into a door shouldn't walk through it.
    if otherEntity.name = "Player" and otherCollider.name = "feet"
      m.game.changeSceneWithFade(m.target, {spawn: m.spawn})
    end if
  end sub

end class
