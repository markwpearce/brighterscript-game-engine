' examples/rpg/src/source/UI/MenuPanel.bs
import "pkg:/source/engine/ui/MenuList.bs"
import "pkg:/source/engine/ui/Button.bs"
import "pkg:/source/engine/ui/UiActionListener.bs"

' Every panel stays this fraction in from each edge of the UI canvas.
const UI_SAFE = 0.1
const MENU_PADDING = 40.0
const MENU_BUTTON_H = 60.0
const MENU_BUTTON_GAP = 10.0
const MENU_TEXT_RGBA = &hF5E6C8FF
const MENU_TITLE_RGBA = &hFFD966FF
const MENU_BACKGROUND_RGBA = &h1A120CE6

' A button in the smaller "button" font, which it keeps over the theme's hud font.
function newMenuButton(game as BGE.Game) as BGE.UI.Button
  button = new BGE.UI.Button(game)
  button.setFont(game.getFont("button"))
  return button
end function

' The game's MenuList: left-aligned at a fixed spot and width, with the hud font for its text
' and the smaller button font for its buttons. The stone frame and colors come from the theme
' (set in main.bs). Picking an item calls listener.onUiAction(id, button).
class MenuPanel extends BGE.UI.MenuList

  sub new(game as BGE.Game, x as float, y as float, w as float, listener as BGE.UI.UiActionListener)
    super(game)
    m.customX = x
    m.customY = y
    m.setSize(w, 0)
    m.listener = listener
    m.contentAlign = "left"
    m.panelPadding = MENU_PADDING
    m.sectionGap = MENU_BUTTON_GAP
    m.itemHeight = MENU_BUTTON_H
    m.itemGap = MENU_BUTTON_GAP
  end sub

  protected override function createButton(item as BGE.UI.MenuItem) as BGE.UI.Button
    return newMenuButton(m.game)
  end function

  protected override function headingFont() as roFont
    return m.game.getFont("hud")
  end function

  protected override function bodyFont() as roFont
    return m.game.getFont("hud")
  end function

end class
