' examples/rpg/src/source/UI/ShopPanel.bs
import "MenuPanel.bs"
import "../RpgStory/Items.bs"
import "../RpgStory/RpgStoryTypes.bs"
import "../RpgStory/Story.bs"
import "../Audio/PlayAudio.bs"

' Hilde's wares: one button per item with its price, then Leave. A refusal (too few coins,
' already owned) shows in the message line.
class ShopPanel extends MenuPanel

  sub new(game as BGE.Game)
    uiW = game.uiCanvas.getWidth()
    uiH = game.uiCanvas.getHeight()
    super(game, uiW * 0.3, uiH * UI_SAFE, uiW * 0.4, invalid)
    m.listener = m
    m.name = "ShopPanel"
    m.title = "Hilde's Wares"
    m.message = "What'll it be?"
  end sub

  override sub open(parent = invalid as BGE.UI.UiContainer)
    storyEntity = m.game.getEntityByName("Story") as Story
    definitions = getItemDefinitions()
    for each row in storyEntity.shopItems()
      definition = definitions[row.itemId] as RpgItemDefinition
      label = definition.name + " - " + row.price.toStr()
      if not storyEntity.inventory.canAdd(row.itemId)
        if definition.max = 1
          label = label + " (owned)"
        else
          label = label + " (full)"
        end if
      end if
      m.addItem(row.itemId, label)
    end for
    m.addItem("leave", "Leave")
    super.open(parent)
  end sub

  sub onUiAction(actionId as string, button as BGE.UI.Button)
    storyEntity = m.game.getEntityByName("Story") as Story
    if actionId = "leave"
      m.leave()
      return
    end if
    result = storyEntity.buy(actionId)
    if result.ok
      ' Rebuilt so the labels show (owned)/(full); the story has already saved.
      m.leave()
      storyEntity.reopenShop()
    else
      playSfx(m.game, "refuse")
      m.setMessage(result.reason)
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    super.onInput(input)
    input.consume()
    if input.press and input.isButton("back")
      m.leave()
    end if
  end sub

  private sub leave()
    m.close()
    ' The panel is its own listener; drop that so it can be freed.
    m.listener = invalid
    storyEntity = m.game.getEntityByName("Story") as Story
    storyEntity.panelClosed()
  end sub

end class
