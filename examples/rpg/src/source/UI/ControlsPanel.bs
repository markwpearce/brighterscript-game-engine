' examples/rpg/src/source/UI/ControlsPanel.bs
import "pkg:/source/engine/ui/UiContainer.bs"
import "pkg:/source/engine/ui/Label.bs"
import "pkg:/source/utils/qrcode/QrRenderHelpers.bs"
import "MenuPanel.bs"

' The title screen's Controls popup: a QR code for the phone controller on the left, the remote
' and gamepad button lists on the right, and a Close button. Build it fresh on each open and
' close() it, since its button registers with the FocusManager as soon as it's added.
class ControlsPanel extends BGE.UI.UiContainer

  closeButton as ActionButton = invalid
  private frame as BGE.UI.NinePatchImage = invalid
  private qr as BGE.QrCode.QrCode = invalid
  private connectionInfo as string = ""
  private listenerName as string = ""
  ' The UI canvas is the screen's size (720p or 1080p), so everything scales off its height.
  private qrSize as float = 0

  sub new(game as BGE.Game, listenerName as string)
    super(game)
    m.listenerName = listenerName
    m.customPosition = true
    m.backgroundRGBA = MENU_BACKGROUND_RGBA
    m.frame = getFrameSkin(game)
    m.showBackground = m.frame = invalid
    m.connectionInfo = game.getControllerConnectionInfo()
    m.qr = BGE.QrCode.qrEncodeText(m.connectionInfo, BGE.QrCode.EccLevel.medium)
  end sub

  sub open(parent as BGE.UI.UiContainer)
    m.clearChildren()
    uiW = m.game.uiCanvas.getWidth()
    uiH = m.game.uiCanvas.getHeight()
    m.customX = uiW * UI_SAFE
    m.customY = uiH * UI_SAFE
    m.width = uiW * (1 - UI_SAFE * 2)
    m.height = uiH * (1 - UI_SAFE * 2)

    ' A whole number of pixels per module, or the modules show gaps.
    m.qrSize = Int(uiH * 0.3 / m.qr.size) * m.qr.size
    lineHeight = m.game.getFont("hud").GetOneLineHeight()
    rightX = MENU_PADDING + m.qrSize + MENU_PADDING
    restW = m.width - rightX - MENU_PADDING
    columnW = restW * 0.45

    m.addList("Roku remote", [
      "Arrows: move",
      "OK: sword / talk",
      "Play: inventory",
      "Back: back / quit",
      "*: debug overlay"
    ], rightX, MENU_PADDING, columnW)
    m.addList("Gamepad", [
      "Stick / D-pad: move",
      "A: sword / talk",
      "B: cancel / close",
      "Y: inventory"
    ], rightX + columnW, MENU_PADDING, restW - columnW)
    m.addList("Phone", [
      "Stick: move",
      "A: same as OK"
    ], rightX, MENU_PADDING + lineHeight * 7.5, restW)

    m.closeButton = new ActionButton(m.game)
    m.closeButton.actionId = "closeControls"
    m.closeButton.listenerName = m.listenerName
    m.closeButton.setLabel("Close")
    m.closeButton.customPosition = true
    m.closeButton.width = 260
    m.closeButton.height = MENU_BUTTON_H
    m.closeButton.customX = m.width - MENU_PADDING - m.closeButton.width
    m.closeButton.customY = m.height - MENU_PADDING - MENU_BUTTON_H
    m.addChild(m.closeButton)

    parent.addChild(m)
    m.game.focusManager.focusWidget(m.closeButton)
  end sub

  private sub addList(heading as string, lines as object, x as float, y as float, w as float)
    headingLabel = new BGE.UI.Label(m.game)
    headingLabel.customPosition = true
    headingLabel.customX = x
    headingLabel.customY = y
    headingLabel.drawableText.textColor = MENU_TITLE_RGBA
    headingLabel.setText(heading)
    m.addChild(headingLabel)
    body = new BGE.UI.Label(m.game)
    body.customPosition = true
    body.customX = x
    body.customY = y + m.game.getFont("hud").GetOneLineHeight() + MENU_BUTTON_GAP
    body.wrapWidth = w - MENU_BUTTON_GAP
    body.drawableText.textColor = MENU_TEXT_RGBA
    body.setText(lines.Join(Chr(10)))
    m.addChild(body)
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    if m.frame <> invalid
      m.frame.draw(m.canvas.renderer, m.position.x, m.position.y, m.width, m.height)
    end if
    super.draw(parent)
    renderer = m.canvas.renderer
    font = m.game.getFont("hud")
    qrX = m.position.x + MENU_PADDING
    qrY = m.position.y + MENU_PADDING
    renderer.incrementDrawCalls(BGE.QrCode.qrDrawModules(renderer.getDraw2d(), m.qr, qrX, qrY, m.qrSize))
    centerX = qrX + m.qrSize / 2.0
    textY = qrY + m.qrSize + MENU_BUTTON_GAP
    urlY = m.position.y + m.height - MENU_PADDING - MENU_BUTTON_H + (MENU_BUTTON_H - font.GetOneLineHeight()) / 2.0
    renderer.drawText(m.connectionInfo, qrX, urlY, MENU_TEXT_RGBA, font, "left")
    caption = BGE.UI.wrapText("Scan to use your phone as a controller", font, m.qrSize + MENU_PADDING)
    for each captionLine in caption
      renderer.drawText(captionLine, centerX, textY, MENU_TEXT_RGBA, font, "center")
      textY += font.GetOneLineHeight()
    end for
  end sub

  sub close(parent as BGE.UI.UiContainer)
    parent.removeChild(m)
  end sub

end class
