' examples/rpg/src/source/UI/DialogueBox.bs
import "pkg:/source/engine/ui/UiContainer.bs"
import "pkg:/source/engine/ui/Label.bs"
import "pkg:/source/engine/ui/TextWrap.bs"
import "pkg:/source/engine/ui/Button.bs"
import "UiSkin.bs"
import "MenuPanel.bs"
import "pkg:/source/story/ValueKinds.bs"
import "pkg:/source/story/StoryTypes.bs"
import "pkg:/source/story/DialogueRunner.bs"
import "../Story/RpgStoryTypes.bs"
import "../Story/Story.bs"
import "../Audio/PlayAudio.bs"

const DIALOGUE_LINES_PER_PAGE = 3
' Clears the 9-patch border (its corners are ~36px).
const DIALOGUE_PADDING = 40.0

' A conversation along the bottom of the screen, played by the Story's DialogueRunner: the
' speaker's name, then each line three wrapped lines at a time. OK turns the page; on a line's last
' page OK moves the runner on (to the next line, the choices, or the end). Back leaves without the
' node's effects. The Story pauses the game while it's open.
class DialogueBox extends BGE.UI.UiContainer

  private runner as BGE.Story.DialogueRunner = invalid
  private speakerLabel as BGE.UI.Label = invalid
  ' The text of each screen, up to DIALOGUE_LINES_PER_PAGE lines joined by newlines.
  private pages as string[] = []
  private pageIndex as integer = 0
  private body as BGE.UI.Label = invalid
  private more as BGE.UI.Label = invalid
  private choiceButtons as ActionButton[] = []
  ' Frames to wait before adding choice buttons (-1 = none pending). See showPage().
  private choicesDelay as integer = -1
  private parentUi as BGE.UI.UiContainer = invalid
  private ninePatch as BGE.UI.NinePatchImage = invalid

  ' @param {BGE.Story.DialogueRunner} runner - already started
  sub new(game as BGE.Game, runner as BGE.Story.DialogueRunner)
    super(game)
    m.name = "DialogueBox"
    m.runner = runner
    m.customPosition = true
    m.backgroundRGBA = MENU_BACKGROUND_RGBA
    m.ninePatch = getDialogueSkin(game)
    ' Fall back to the flat fill if the 9-patch didn't load.
    m.showBackground = m.ninePatch = invalid
    uiW = game.uiCanvas.getWidth()
    uiH = game.uiCanvas.getHeight()
    font = game.getFont("hud")
    lineHeight = font.GetOneLineHeight()
    m.width = uiW * (1 - UI_SAFE * 2)
    m.height = DIALOGUE_PADDING * 2 + lineHeight * (DIALOGUE_LINES_PER_PAGE + 1) + MENU_BUTTON_GAP + 8
    m.customX = uiW * UI_SAFE
    m.customY = uiH * (1 - UI_SAFE) - m.height
  end sub

  sub onAction(actionId as string)
    if Left(actionId, 6) = "choice"
      m.chooseIndex(Mid(actionId, 7).toInt())
    end if
  end sub

  sub open(parent as BGE.UI.UiContainer)
    m.parentUi = parent
    font = m.game.getFont("hud")
    lineHeight = font.GetOneLineHeight()
    m.speakerLabel = new BGE.UI.Label(m.game)
    m.speakerLabel.customPosition = true
    m.speakerLabel.customX = DIALOGUE_PADDING
    m.speakerLabel.customY = DIALOGUE_PADDING
    m.speakerLabel.drawableText.textColor = MENU_TITLE_RGBA
    m.addChild(m.speakerLabel)
    m.body = new BGE.UI.Label(m.game)
    m.body.customPosition = true
    m.body.customX = DIALOGUE_PADDING
    m.body.customY = DIALOGUE_PADDING + lineHeight + MENU_BUTTON_GAP
    m.body.drawableText.textColor = MENU_TEXT_RGBA
    m.addChild(m.body)
    m.more = new BGE.UI.Label(m.game)
    m.more.customPosition = true
    m.more.customX = m.width - DIALOGUE_PADDING - font.GetOneLineWidth("...", 1000)
    m.more.customY = m.height - DIALOGUE_PADDING - lineHeight
    m.more.drawableText.textColor = MENU_TITLE_RGBA
    m.addChild(m.more)
    if m.runner.isChoosing()
      m.afterStep()
    else
      m.loadLine(false)
    end if
    parent.addChild(m)
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    if m.ninePatch <> invalid
      m.ninePatch.draw(m.canvas.renderer, m.position.x, m.position.y, m.width, m.height)
    end if
    super.draw(parent)
  end sub

  override sub onInput(input as BGE.GameInput)
    super.onInput(input)
    input.consume()
    if not input.press
      return
    end if
    if input.isButton("back")
      m.close()
      storyEntity = m.game.getEntityByName("Story") as Story
      storyEntity.cancelDialogue()
    else if input.isButton("ok") and m.choicesDelay < 0 and m.choiceButtons.count() = 0
      if m.pageIndex < m.pages.count() - 1
        m.showPage(m.pageIndex + 1)
      else
        storyEntity = m.game.getEntityByName("Story") as Story
        storyEntity.dialogueStepped(m.runner.advance())
        m.afterStep()
      end if
    end if
  end sub

  override sub onUpdate(deltaTime as float)
    super.onUpdate(deltaTime)
    if m.choicesDelay = 0
      m.choicesDelay = -1
      m.showChoices()
    else if m.choicesDelay > 0
      m.choicesDelay--
    end if
  end sub

  ' Called by a choice button (through the Story's onMenuAction).
  '
  ' @param {integer} index - into runner.choices()
  sub chooseIndex(index as integer)
    view = m.runner.choices()[index]
    choice = view.choice as RpgChoice
    open = ""
    if BGE.Story.valueKind(choice.open) = "string"
      open = choice.open
    end if
    result = m.runner.choose(index)
    storyEntity = m.game.getEntityByName("Story") as Story
    storyEntity.dialogueChose(result, open)
    m.afterStep()
  end sub

  ' Pages the runner's current line: each DIALOGUE_LINES_PER_PAGE wrapped lines is one page.
  private sub loadLine(turned as boolean)
    font = m.game.getFont("hud")
    innerWidth = m.width - DIALOGUE_PADDING * 2
    line = m.runner.currentLine()
    m.speakerLabel.setText(line.speaker)
    m.pages = [] as string[]
    wrapped = BGE.UI.wrapText(line.text, font, innerWidth)
    for i = 0 to wrapped.count() - 1 step DIALOGUE_LINES_PER_PAGE
      lastIndex = i + DIALOGUE_LINES_PER_PAGE - 1
      if lastIndex > wrapped.count() - 1
        lastIndex = wrapped.count() - 1
      end if
      pageLines = [] as string[]
      for j = i to lastIndex
        pageLines.push(wrapped[j])
      end for
      m.pages.push(pageLines.join(Chr(10)))
    end for
    if m.pages.count() = 0
      m.pages.push("")
    end if
    if turned
      playSfx(m.game, "dialogue")
    end if
    m.showPage(0)
  end sub

  ' After advance() or choose(): shows the next line, the choices, or closes.
  private sub afterStep()
    m.removeChoiceButtons()
    if not m.runner.isActive()
      m.close()
      storyEntity = m.game.getEntityByName("Story") as Story
      storyEntity.dialogueEnded()
    else if m.runner.isChoosing()
      ' The FocusManager handles this frame's OK press after UI onInput, so a button added
      ' now would be clicked by the press that turned the page. Wait a frame first.
      m.choicesDelay = 1
      m.more.setText("")
    else
      m.loadLine(true)
    end if
  end sub

  private sub showPage(index as integer)
    if index > 0
      playSfx(m.game, "dialogue")
    end if
    m.pageIndex = index
    m.body.setText(m.pages[index])
    if index < m.pages.count() - 1
      m.more.setText("...")
    else
      m.more.setText("")
      ' Show a node's choices with its last line rather than after another OK.
      if m.runner.choicesFollow()
        storyEntity = m.game.getEntityByName("Story") as Story
        storyEntity.dialogueStepped(m.runner.advance())
        m.afterStep()
      end if
    end if
  end sub

  ' A row of buttons along the bottom, one per enabled choice, under the last line read.
  private sub showChoices()
    views = m.runner.choices()
    enabledIndexes = [] as integer[]
    for i = 0 to views.count() - 1
      if views[i].enabled
        enabledIndexes.push(i)
      end if
    end for
    if enabledIndexes.count() = 0
      return
    end if
    buttonW = (m.width - DIALOGUE_PADDING * 2 - MENU_BUTTON_GAP * (enabledIndexes.count() - 1)) / enabledIndexes.count()
    for slot = 0 to enabledIndexes.count() - 1
      viewIndex = enabledIndexes[slot]
      button = new ActionButton(m.game)
      ' The actionId holds the index into runner.choices().
      button.actionId = "choice" + viewIndex.toStr()
      button.listenerName = "Story"
      button.setLabel(views[viewIndex].label)
      button.customPosition = true
      button.customX = DIALOGUE_PADDING + slot * (buttonW + MENU_BUTTON_GAP)
      button.customY = m.height - DIALOGUE_PADDING - MENU_BUTTON_H
      button.width = buttonW
      button.height = MENU_BUTTON_H
      m.addChild(button)
      m.choiceButtons.push(button)
    end for
    m.game.focusManager.focusWidget(m.choiceButtons[0])
  end sub

  private sub removeChoiceButtons()
    for each button in m.choiceButtons
      m.removeChild(button)
    end for
    m.choiceButtons = []
  end sub

  private sub close()
    if m.parentUi <> invalid
      m.parentUi.removeChild(m)
      m.parentUi = invalid
    end if
  end sub

end class
