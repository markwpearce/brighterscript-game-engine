import "pkg:/source/engine/ui/UiWidget.bs"
import "../Entities/Combat.bs"
import "../Entities/Player.bs"

' Tint for an empty heart (packed RGBA).
const HUD_EMPTY_HEART_RGBA = &h404040FF
const HUD_TEXT_RGBA = &hF5E6C8FF
' Icon pixels per 180px of UI canvas height: 4x at 720p, 6x at 1080p.
const HUD_PIXELS_PER_SCALE = 180

' The player's hearts and coin count, in the top-left title-safe corner. Reads the player each
' frame, so nothing has to tell it when health or coins change.
class HeartsHud extends BGE.UI.UiWidget

  private heart as roBitmap = invalid
  private halfHeart as roRegion = invalid
  private coin as roBitmap = invalid

  sub new(game as BGE.Game)
    super(game)
    m.heart = game.getBitmap("heart")
    ' The left 5 columns of the 9px heart, including its middle column.
    m.halfHeart = CreateObject("roRegion", m.heart, 0, 0, 5, 9)
    m.coin = game.getBitmap("coin")
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    if m.game.getAllEntities("Player").count() = 0
      return
    end if
    playerEntity = m.game.getEntityByName("Player") as Player
    renderer = m.canvas.renderer
    canvasW = m.canvas.getWidth()
    canvasH = m.canvas.getHeight()
    scale = Int(canvasH / HUD_PIXELS_PER_SCALE)
    if scale < 1
      scale = 1
    end if
    iconSize = 9 * scale
    gap = 2 * scale
    left = Int(canvasW * 0.1)
    top = Int(canvasH * 0.1)

    states = heartStates(playerEntity.health, playerEntity.maxHealth)
    for i = 0 to states.count() - 1
      x = left + i * (iconSize + gap)
      if states[i] = "full"
        renderer.drawScaledObject(x, top, scale, scale, m.heart)
      else
        renderer.drawScaledObject(x, top, scale, scale, m.heart, HUD_EMPTY_HEART_RGBA)
        if states[i] = "half"
          renderer.drawScaledObject(x, top, scale, scale, m.halfHeart)
        end if
      end if
    end for

    coinTop = top + iconSize + gap * 2
    renderer.drawScaledObject(left, coinTop, scale, scale, m.coin)
    renderer.drawText(playerEntity.coins.toStr(), left + iconSize + gap * 2, coinTop + iconSize / 2, HUD_TEXT_RGBA, m.game.getFont("hud"), "left", "center")
  end sub

end class
