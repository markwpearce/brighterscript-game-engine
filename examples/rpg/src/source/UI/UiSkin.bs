' examples/rpg/src/source/UI/UiSkin.bs
import "pkg:/source/engine/ui/NinePatchLoader.bs"

' Each 9-patch is parsed once and cached on the global AA (invalid if it fails to load).
function getSkin(key as string, path as string) as BGE.UI.NinePatchImage
  globals = GetGlobalAA()
  if globals.rpgSkins = invalid
    globals.rpgSkins = {}
  end if
  if not globals.rpgSkins.doesExist(key)
    globals.rpgSkins[key] = {image: BGE.UI.loadNinePatchImage(path)}
  end if
  return globals.rpgSkins[key].image
end function

' The red button art, used as the theme's backgroundImage.
function getButtonSkin(game as BGE.Game) as BGE.UI.NinePatchImage
  return getSkin("button", "pkg:/sprites/ui/button.9.png")
end function

' The stone frame behind menu panels.
function getFrameSkin(game as BGE.Game) as BGE.UI.NinePatchImage
  return getSkin("frame", "pkg:/sprites/ui/frame.9.png")
end function

' The blue box behind the dialogue.
function getDialogueSkin(game as BGE.Game) as BGE.UI.NinePatchImage
  return getSkin("dialogue", "pkg:/sprites/ui/box.9.png")
end function
