import "pkg:/source/engine/ui/Meter.bs"
import "../Entities/Enemy.bs"

const BOSS_BAR_BACK_RGBA = &h202020C0
const BOSS_BAR_FILL_RGBA = &hD03020FF
const BOSS_BAR_TEXT_RGBA = &hF5E6C8FF

' The current boss's health (any enemy tagged `boss`) across the top of the screen while it's alive, with its name
' centred above. Title-safe: centred, 40% of the width, 10% down from the top.
class BossBar extends BGE.UI.Meter

  sub new(game as BGE.Game)
    super(game)
    m.fillColor = BOSS_BAR_FILL_RGBA
    m.backColor = BOSS_BAR_BACK_RGBA
    m.labelColor = BOSS_BAR_TEXT_RGBA
    m.labelFontName = "hud"
    m.labelAlign = "center"
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    boss = invalid
    for each entity in m.game.getEntitiesByTag("boss")
      candidate = entity as Enemy
      if not candidate.isDying
        boss = candidate
      end if
    end for
    if boss = invalid
      return
    end if
    canvasW = m.canvas.getWidth()
    canvasH = m.canvas.getHeight()
    font = m.game.getFont("hud")
    barW = Int(canvasW * 0.4)
    barH = Int(canvasH * 0.02)
    left = Int((canvasW - barW) / 2)
    labelTop = Int(canvasH * 0.1)
    top = labelTop + font.GetOneLineHeight() + 4
    m.label = boss.displayName
    ' health is an integer: make it a float so the fraction isn't integer division
    m.setValue(boss.health * 1.0, boss.maxHealth * 1.0)
    m.drawAt(m.canvas.renderer, left, top, barW, barH)
  end sub

end class
