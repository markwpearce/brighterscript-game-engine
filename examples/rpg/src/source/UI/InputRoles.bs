' Engine-free input roles, so a gamepad can share menus without quitting the channel.

' A press of the remote's Back. Gamepad B also aliases to back (cancel), but must not exit the channel.
function isQuitButton(press as boolean, rawButton as string) as boolean
  return press and LCase(rawButton) = "back"
end function

' A press of the remote's Play/Pause or the gamepad's Y.
function isInventoryButton(press as boolean, rawButton as string) as boolean
  lowered = LCase(rawButton)
  return press and (lowered = "play" or lowered = "y")
end function
