' Shapes of the map and atlas data. Engine-free, so the map's unit tests can use them.
import "../Entities/Facing.bs"
import "../Entities/Shapes.bs"
import "../Story/StoryTypes.bs"

' One thing placed on a map. A prop has atlasKey; everything else has type ("solid", "door",
' "spawn", "enemy", "drain", "npc", "gate", "switch", "pickup" or "pot") and only that type's fields. See MapData.bs.
interface MapPlacement extends roAssociativeArray
  optional atlasKey as string
  optional type as string
  ' The bottom cell row and the column; either may be fractional.
  col as float
  row as float
  ' solid and door: size in cells
  optional w as float
  optional h as float
  ' Only placed while these pass.
  optional when as StoryCondition[]
  ' door
  optional target as string
  optional spawn as string
  ' spawn and switch
  optional id as string
  ' spawn and npc
  optional facing as FacingDirection
  ' enemy: "rat", "bat", "goblin" or "goblinKing"
  optional kind as string
  ' npc
  optional npcId as string
  optional character as string
  optional wander as float
  ' Re-checked whenever the story changes, not only when the area loads (see LivePlacements.bs).
  optional live as boolean
  ' gate: "bars", "shutter", "locked" or "great"
  optional style as string
  ' gate: the wall it's in - "n", "e", "w" or "s"
  optional side as string
  ' gate: what walking into it does
  optional unlock as GateUnlock
  ' switch: set to true once it's pressed
  optional flag as string
  ' pickup: the inventory item it represents (stays put while that item is at its cap)
  optional item as string
  ' pickup: bitmap name, when it isn't an inventory item's icon
  optional icon as string
  ' switch and pickup: run when stepped on
  optional effects as StoryEffect[]
end interface

' What walking into a gate does: runs effects if `when` passes, otherwise shows lockedMessage.
interface GateUnlock extends roAssociativeArray
  optional when as StoryCondition[]
  effects as StoryEffect[]
  lockedMessage as string
end interface

' A scene and a spawn point in it.
interface SpawnTarget extends roAssociativeArray
  scene as string
  spawn as string
end interface

' A named region of a tile sheet.
interface AtlasEntry extends roAssociativeArray
  sheet as string
  x as integer
  y as integer
  w as integer
  h as integer
  ' The solid part of a prop, relative to the image's bottom-left corner, or invalid.
  footprint as Rect
end interface

' The top-left of a 96x96 3x3 auto-tile set.
interface SurfaceSet
  sheet as string
  x as integer
  y as integer
end interface
