import "pkg:/source/engine/colliders/SolidWorld.bs"
import "../Entities/Facing.bs"

' Map data for the town and the castle interior. The ground layer is one string per row of
' 32px cells (row 0 = top). Legend:
'   .  grass                         c  grey cobble (auto-tiled)
'   w  white cobble (auto-tiled)     t  tan cobble (auto-tiled)
'   d  dirt (auto-tiled)             s  castle stone floor
'   ~  water (solid)                 #  solid, art supplied by a prop over it (castle walls)
'   b  brick wall (solid)            x  solid void, drawn dark
' Auto-tiled paths are written at least two cells wide - a 3x3 edge set has no one-cell-wide pieces (see BGE.TileMap.getEdgePiece3x3()).
'
' Placements put props, doors, extra solids, spawn points and enemies on the map. A prop's/door's/solid's
' `row` is its bottom cell row; `col` (and a door's/solid's `w`/`h`) may be fractional, for
' shapes that don't line up with the grid.

const TILE_SIZE = 32
' Ground chunks sit behind everything that depth-sorts by feet position.
const GROUND_Z = -9000

