namespace tests
  @suite("town castle gate")
  class TownGateTests extends rooibos.BaseTestSuite

    private world as BGE.SolidWorld
    private door as object
    private gateOpen as boolean = true

    ' Builds the town's collision the way AreaScene/TileMapEntity do: every solid ground cell,
    ' plus the placement solids.
    protected override function beforeEach()
      m.gateOpen = true
      m.buildWorld()
    end function

    private sub buildWorld()
      rows = getTownRows()
      numRows = rows.count()
      m.world = new BGE.SolidWorld()
      for r = 0 to numRows - 1
        for c = 0 to rows[r].len() - 1
          if isSolidGroundChar(rows[r].mid(c, 1))
            m.world.addSolid(c * TILE_SIZE, cellBottomY(numRows, r), TILE_SIZE, TILE_SIZE)
          end if
        end for
      end for
      flags = new StoryFlags()
      if m.gateOpen
        flags.set("gate.open", true)
      end if
      ctx = newStoryContext(flags, new Inventory(getItemDefinitions()), {health: 6, maxHealth: 6, coins: 0})
      placements = filterPlacements(getTownPlacements(), ctx)
      addPlacementSolids(m.world, placements, numRows)
      for each item in placements
        if item.atlasKey = invalid and item.type = "door" and item.target = "CastleScene"
          m.door = {x: item.col * TILE_SIZE, y: cellBottomY(numRows, item.row), w: item.w * TILE_SIZE, h: item.h * TILE_SIZE}
        end if
      end for
    end sub

    @describe("walking straight up the road into the gate")

    ' Lanes across the part of the road the arch's opening spans (world x ~464-528).
    @it("reaches the door from any lane under the arch")
    @params(468.0)
    @params(480.0)
    @params(496.0)
    @params(512.0)
    @params(524.0)
    function _(laneCentreX)
      feetBox = {x: laneCentreX - 10, y: cellBottomY(22, 5) + 10, w: 20.0, h: 12.0}
      reached = false
      ' Two seconds of walking at PLAYER_SPEED (180px/s) and 60fps.
      for frame = 1 to 120
        result = m.world.moveAndSlide(feetBox, 0, 3.0)
        feetBox.x = result.x
        feetBox.y = result.y
        if feetBox.x < m.door.x + m.door.w and feetBox.x + feetBox.w > m.door.x and feetBox.y + feetBox.h > m.door.y
          reached = true
          exit for
        end if
      end for
      m.assertTrue(reached, "stuck at x=" + feetBox.x.toStr() + " y=" + feetBox.y.toStr())
    end function

    @it("blocks the centre lane before the door while the gate is shut")
    function _()
      m.gateOpen = false
      m.buildWorld()
      feetBox = {x: 496.0 - 10, y: cellBottomY(22, 5) + 10, w: 20.0, h: 12.0}
      for frame = 1 to 120
        result = m.world.moveAndSlide(feetBox, 0, 3.0)
        feetBox.x = result.x
        feetBox.y = result.y
        m.assertFalse(feetBox.x < m.door.x + m.door.w and feetBox.x + feetBox.w > m.door.x and feetBox.y + feetBox.h > m.door.y, "reached the door")
      end for
      m.assertTrue(feetBox.y < cellBottomY(22, 4), "got to y=" + feetBox.y.toStr())
    end function

  end class
end namespace
