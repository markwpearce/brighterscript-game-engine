' examples/rpg/tests/Shop.spec.bs
namespace tests
  @suite("shop")
  class ShopTests extends rooibos.BaseTestSuite

    private vocab as object
    private state as BGE.Story.StoryState

    protected override function beforeEach()
      m.vocab = {player: {health: 6, maxHealth: 6, coins: 12}}
      m.state = newRpgStoryState(m.vocab)
    end function

    @describe("buying")

    @it("buys the sword when there's enough coin")
    function _()
      result = buyItem("steelSword", 10, m.state, m.vocab.player)
      m.assertTrue(result.ok)
      m.assertEqual(2, m.vocab.player.coins)
      m.assertTrue(m.state.inventory.has("steelSword"))
    end function

    @it("returns what the purchase's effects did")
    function _()
      result = buyItem("steelSword", 10, m.state, m.vocab.player)
      m.assertTrue(result.result.changed)
    end function

    @it("refuses without enough coin, changing nothing")
    function _()
      result = buyItem("heartContainer", 15, m.state, m.vocab.player)
      m.assertFalse(result.ok)
      m.assertEqual("Not enough coins", result.reason)
      m.assertEqual(12, m.vocab.player.coins)
    end function

    @it("refuses a one-off item already owned")
    function _()
      m.state.inventory.add("steelSword")
      m.assertEqual("Already owned", canBuy("steelSword", 10, m.state, m.vocab.player))
    end function

    @it("refuses potions past the carry limit")
    function _()
      m.vocab.player.coins = 100
      buyItem("potion", 4, m.state, m.vocab.player)
      buyItem("potion", 4, m.state, m.vocab.player)
      buyItem("potion", 4, m.state, m.vocab.player)
      m.assertEqual("Can't carry more", canBuy("potion", 4, m.state, m.vocab.player))
    end function

    @it("runs the heart container's onAcquire")
    function _()
      m.vocab.player.coins = 15
      buyItem("heartContainer", 15, m.state, m.vocab.player)
      m.assertEqual(8, m.vocab.player.maxHealth)
    end function

    @describe("using")

    @it("won't drink a potion at full health")
    function _()
      m.state.inventory.add("potion")
      m.assertEqual("Already at full health", canUse("potion", m.state, m.vocab.player))
    end function

    @it("drinks a potion when hurt")
    function _()
      m.state.inventory.add("potion")
      m.vocab.player.health = 1
      m.assertTrue(useItem("potion", m.state, m.vocab.player).ok)
      m.assertEqual(5, m.vocab.player.health)
      m.assertEqual(0, m.state.inventory.count("potion"))
    end function

    @it("won't use an item with no onUse, and keeps it")
    function _()
      m.state.inventory.add("steelSword")
      m.assertEqual("Can't be used", canUse("steelSword", m.state, m.vocab.player))
      result = useItem("steelSword", m.state, m.vocab.player)
      m.assertFalse(result.ok)
      m.assertFalse(result.result.changed)
      m.assertTrue(m.state.inventory.has("steelSword"))
    end function

    @it("can't use what you don't have")
    function _()
      m.vocab.player.health = 1
      m.assertEqual("You have none", canUse("potion", m.state, m.vocab.player))
    end function

  end class
end namespace
