namespace tests
  @suite("value kinds")
  class ValueKindsTests extends rooibos.BaseTestSuite

    @describe("valueKind")

    @it("folds boxed and unboxed numbers to one kind")
    function _()
      boxed = CreateObject("roInt")
      boxed.SetInt(3)
      m.assertEqual("integer", valueKind(3))
      m.assertEqual("integer", valueKind(boxed))
      m.assertEqual("integer", valueKind(ParseJson("{""a"":3}").a))
      m.assertEqual("float", valueKind(1.5))
      m.assertEqual("float", valueKind(1.5#))
      m.assertEqual("string", valueKind("x"))
      m.assertEqual("string", valueKind(CreateObject("roString")))
      m.assertEqual("boolean", valueKind(true))
    end function

  end class
end namespace
