' examples/rpg/tests/EventRules.spec.bs
namespace tests
  @suite("rpg story event rules")
  class EventRulesTests extends rooibos.BaseTestSuite

    private vocab as object
    private state as BGE.Story.StoryState

    protected override function beforeEach()
      m.vocab = {player: {health: 6, maxHealth: 6, coins: 0}}
      m.state = newRpgStoryState(m.vocab)
    end function

    private function killRat() as object
      return m.state.runEvent("enemyKilled", {kind: "rat"})
    end function

    @describe("the rats quest")

    @it("ignores rat kills before the quest starts")
    function _()
      m.assertFalse(m.killRat().changed)
      m.assertEqual(0, m.state.flags.getInt("rats.kills"))
    end function

    @it("counts rat kills while hunting, but not bats")
    function _()
      m.state.flags.set("rats.stage", 1)
      m.killRat()
      m.state.runEvent("enemyKilled", {kind: "bat"})
      m.assertEqual(1, m.state.flags.getInt("rats.kills"))
    end function

    @it("moves to stage 2 on the fourth kill, in the same event")
    function _()
      m.state.flags.set("rats.stage", 1)
      m.state.flags.set("rats.kills", 3)
      m.killRat()
      m.assertEqual(2, m.state.flags.getInt("rats.stage"))
    end function

    @it("stops counting after stage 1")
    function _()
      m.state.flags.set("rats.stage", 2)
      m.state.flags.set("rats.kills", 4)
      m.killRat()
      m.assertEqual(4, m.state.flags.getInt("rats.kills"))
    end function

    @describe("the gate")

    @it("opens when Bram vouches after the sword is bought")
    function _()
      m.state.inventory.add("steelSword")
      m.state.flags.set("bram.vouched", true)
      result = m.state.settle()
      m.assertTrue(m.state.flags.isSet("gate.open"))
      m.assertEqual(["gateOpened"], result.posts)
      m.assertEqual(2, m.state.flags.getInt("gate.stage"))
    end function

    @it("asks for a sword when vouched without one, then opens when it's bought")
    function _()
      m.state.flags.set("bram.vouched", true)
      m.state.settle()
      m.assertEqual(1, m.state.flags.getInt("gate.stage"))
      m.assertFalse(m.state.flags.isSet("gate.open"))
      m.state.inventory.add("steelSword")
      m.state.settle()
      m.assertTrue(m.state.flags.isSet("gate.open"))
    end function

    @it("posts gateOpened only once")
    function _()
      m.state.inventory.add("steelSword")
      m.state.flags.set("bram.vouched", true)
      m.state.settle()
      m.assertEqual(0, m.state.settle().posts.count())
    end function

    @describe("the keep")

    @it("clears the guardroom on roomCleared")
    function _()
      m.state.runEvent("roomCleared", {room: "GuardroomScene"})
      m.assertTrue(m.state.flags.isSet("dng.guard.cleared"))
    end function

    @it("marks the king defeated when he dies")
    function _()
      m.state.runEvent("enemyKilled", {kind: "goblinking"})
      m.assertTrue(m.state.flags.isSet("dng.kingDefeated"))
    end function

    @it("solves the antechamber only once both switches are down")
    function _()
      m.state.flags.set("dng.ante.a", true)
      m.state.settle()
      m.assertFalse(m.state.flags.isSet("dng.ante.solved"))
      m.state.flags.set("dng.ante.b", true)
      result = m.state.settle()
      m.assertTrue(m.state.flags.isSet("dng.ante.solved"))
      m.assertEqual(1, result.messages.count())
    end function

    @it("moves the keep quest on as doors open and the key is found")
    function _()
      m.state.flags.set("keep.stage", 1)
      m.state.flags.set("dng.L2.open", true)
      m.state.settle()
      m.assertEqual(2, m.state.flags.getInt("keep.stage"))
      m.state.inventory.add("throneKey")
      m.state.settle()
      m.assertEqual(3, m.state.flags.getInt("keep.stage"))
    end function

    @it("retires the gate quest once the keep quest starts")
    function _()
      m.state.flags.set("gate.open", true)
      m.state.flags.set("keep.stage", 1)
      m.state.settle()
      m.assertEqual(["Find a way through the keep"], currentObjectives(getQuestData(), m.state.flags))
    end function

    @it("ends the witch and sends the player back to Bram")
    function _()
      m.state.flags.set("keep.stage", 3)
      result = m.state.runEvent("enemyKilled", {kind: "witch"})
      m.assertTrue(m.state.flags.isSet("witch.defeated"))
      m.assertEqual(4, m.state.flags.getInt("keep.stage"))
      m.assertEqual(1, result.messages.count())
      m.assertEqual(["Return to Elder Bram"], currentObjectives(getQuestData(), m.state.flags))
    end function

    @it("drops the keep quest from the log once Bram has spoken")
    function _()
      m.state.flags.set("keep.stage", 5)
      m.assertEqual(0, currentObjectives(getQuestData(), m.state.flags).count())
    end function

    @it("settles to no further change at every checkpoint")
    @params(0)
    @params(1)
    @params(2)
    @params(3)
    @params(4)
    @params(5)
    @params(6)
    @params(7)
    @params(8)
    function _(checkpoint)
      cp = checkpointState(checkpoint)
      m.vocab.player.coins = cp.coins
      m.state.flags = cp.flags
      m.state.inventory = cp.inventory
      m.state.settle()
      m.assertFalse(m.state.settle().changed)
    end function

    @it("starts each late checkpoint in the right place")
    function _()
      m.assertEqual("TownScene", checkpointScene(4))
      m.assertEqual("CastleScene", checkpointScene(5))
      m.assertEqual("KingsHallScene", checkpointScene(6))
      m.assertEqual("ThroneRoomScene", checkpointScene(7))
      m.assertEqual("TownScene", checkpointScene(8))
      m.assertEqual(["Enter the throne room"], currentObjectives(getQuestData(), checkpointState(6).flags))
      m.assertEqual(["Return to Elder Bram"], currentObjectives(getQuestData(), checkpointState(8).flags))
    end function
  end class
end namespace
