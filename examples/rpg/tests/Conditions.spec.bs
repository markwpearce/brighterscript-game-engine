namespace tests
  @suite("rpg story conditions")
  class ConditionsTests extends rooibos.BaseTestSuite

    private vocab as object
    private state as BGE.Story.StoryState

    protected override function beforeEach()
      m.vocab = {player: {health: 6, maxHealth: 6, coins: 5}}
      m.state = newRpgStoryState(m.vocab)
    end function

    @describe("coinsGte")

    @it("checks the player's coins")
    function _()
      m.assertTrue(m.state.evaluate([{coinsGte: 5}]))
      m.assertFalse(m.state.evaluate([{coinsGte: 6}]))
      m.vocab.player.coins = 6
      m.assertTrue(m.state.evaluate([{coinsGte: 6}]))
    end function

    @describe("filterPlacements")

    @it("drops placements whose when fails, keeps ones with no when")
    function _()
      placements = [{type: "npc", id: "knight", col: 1, row: 1, when: [{notFlag: "gate.open"}]}, {type: "spawn", id: "gate", col: 2, row: 1}]
      m.assertEqual(2, filterPlacements(placements, m.state).count())
      m.state.flags.set("gate.open", true)
      kept = filterPlacements(placements, m.state)
      m.assertEqual(1, kept.count())
      m.assertEqual("spawn", kept[0].type)
    end function

  end class
end namespace
