namespace tests
  @suite("rpg story effects")
  class EffectsTests extends rooibos.BaseTestSuite

    private vocab as object
    private state as BGE.Story.StoryState

    protected override function beforeEach()
      m.vocab = {player: {health: 3, maxHealth: 6, coins: 5}}
      m.state = newRpgStoryState(m.vocab)
    end function

    @describe("rpg vocabulary")

    @it("gives coins and never takes below 0")
    function _()
      m.assertTrue(m.state.applyEffects([{giveCoins: 10}]).changed)
      m.assertEqual(15, m.vocab.player.coins)
      m.state.applyEffects([{takeCoins: 100}])
      m.assertEqual(0, m.vocab.player.coins)
      m.assertFalse(m.state.applyEffects([{takeCoins: 1}]).changed)
    end function

    @it("heals up to maxHealth")
    function _()
      m.state.applyEffects([{heal: 10}])
      m.assertEqual(6, m.vocab.player.health)
      m.assertFalse(m.state.applyEffects([{heal: 1}]).changed)
    end function

    @it("raises maxHealth")
    function _()
      m.assertTrue(m.state.applyEffects([{addMaxHealth: 2}]).changed)
      m.assertEqual(8, m.vocab.player.maxHealth)
    end function

    @describe("items")

    @it("runs the heart container's onAcquire when it's given")
    function _()
      result = m.state.applyEffects([{giveItem: "heartContainer"}])
      m.assertTrue(result.changed)
      m.assertTrue(m.state.inventory.has("heartContainer"))
      m.assertEqual(8, m.vocab.player.maxHealth)
      m.assertEqual(5, m.vocab.player.health)
    end function

    @it("carries up to three small keys and one throne key")
    function _()
      for i = 1 to 4
        m.state.applyEffects([{giveItem: "smallKey"}])
      end for
      m.state.applyEffects([{giveItem: "throneKey"}, {giveItem: "throneKey"}])
      m.assertEqual(3, m.state.inventory.count("smallKey"))
      m.assertEqual(1, m.state.inventory.count("throneKey"))
    end function

  end class
end namespace
