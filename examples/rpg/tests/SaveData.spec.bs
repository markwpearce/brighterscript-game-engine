' examples/rpg/tests/SaveData.spec.bs
namespace tests
  @suite("save data")
  class SaveDataTests extends rooibos.BaseTestSuite

    private vocab as object
    private state as BGE.Story.StoryState

    protected override function beforeEach()
      m.vocab = {player: {health: 4, maxHealth: 6, coins: 7}}
      m.state = newRpgStoryState(m.vocab)
    end function

    private function sample() as object
      m.state.flags.set("rats.stage", 2)
      m.state.inventory.add("potion")
      m.state.recordVisit("bram#6")
      return buildSaveData("TownScene", "gate", m.state, m.vocab.player)
    end function

    @describe("validateSaveData")

    @it("round-trips through JSON")
    function _()
      save = validateSaveData(ParseJson(FormatJson(m.sample())))
      m.assertNotInvalid(save)
      m.assertEqual("TownScene", save.scene)
      m.assertEqual("gate", save.spawn)
      m.assertEqual(2, save.flags["rats.stage"])
      m.assertEqual(1, save.inventory.potion)
      m.assertEqual(7, save.player.coins)
    end function

    @it("rejects invalid, a string and an array")
    function _()
      m.assertInvalid(validateSaveData(invalid))
      m.assertInvalid(validateSaveData("save"))
      m.assertInvalid(validateSaveData([1, 2]))
    end function

    @it("rejects a different version")
    function _()
      data = m.sample()
      data.version = 99
      m.assertInvalid(validateSaveData(data))
    end function

    @it("rejects a missing field")
    function _()
      data = m.sample()
      data.Delete("player")
      m.assertInvalid(validateSaveData(data))
    end function

    @it("rejects a wrong type for coins")
    function _()
      data = m.sample()
      data.player.coins = "lots"
      m.assertInvalid(validateSaveData(data))
    end function

    @it("clamps health into 1..maxHealth")
    function _()
      data = m.sample()
      data.player.health = 0
      m.assertEqual(1, validateSaveData(data).player.health)
      data.player.health = 50
      m.assertEqual(6, validateSaveData(data).player.health)
    end function

    @it("loads a hostile inventory clamped and without unknown items")
    function _()
      data = m.sample()
      data.inventory = {potion: 99, banana: 1}
      save = validateSaveData(data)
      m.assertNotInvalid(save)
      carried = new BGE.Story.Inventory(getItemDefinitions())
      carried.loadAA(save.inventory)
      m.assertEqual(3, carried.count("potion"))
      m.assertEqual(0, carried.count("banana"))
    end function

    @it("rejects maxHealth below 1")
    function _()
      data = m.sample()
      data.player.maxHealth = 0
      m.assertInvalid(validateSaveData(data))
    end function

    @it("accepts a version 1 save, which has no visits")
    function _()
      data = m.sample()
      data.version = 1
      data.Delete("visits")
      save = validateSaveData(data)
      m.assertNotInvalid(save)
      m.state.loadSaveData(save)
      m.assertEqual(2, m.state.flags.getInt("rats.stage"))
      m.assertEqual(0, m.state.visitCount("bram#6"))
    end function

    @it("round-trips visits")
    function _()
      save = validateSaveData(ParseJson(FormatJson(m.sample())))
      fresh = newRpgStoryState(m.vocab)
      fresh.loadSaveData(save)
      m.assertEqual(1, fresh.visitCount("bram#6"))
    end function

    @it("rejects visits that aren't an object")
    function _()
      data = m.sample()
      data.visits = [1]
      m.assertInvalid(validateSaveData(data))
    end function

    @it("rejects a wrong-typed version")
    function _()
      data = m.sample()
      data.version = "1"
      m.assertInvalid(validateSaveData(data))
    end function

  end class
end namespace
