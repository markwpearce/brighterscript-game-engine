namespace tests
  @suite("enemy placements")
  class EnemyPlacementTests extends rooibos.BaseTestSuite

    ' Every solid an area has at runtime: solid ground cells, placement solids, prop footprints
    ' (as Prop.onCreate adds them) and the map bounds.
    private function buildWorld(rows as string[], placements as object) as BGE.SolidWorld
      numRows = rows.count()
      world = new BGE.SolidWorld()
      for r = 0 to numRows - 1
        for c = 0 to rows[r].len() - 1
          if isSolidGroundChar(rows[r].mid(c, 1))
            world.addSolid(c * TILE_SIZE, cellBottomY(numRows, r), TILE_SIZE, TILE_SIZE)
          end if
        end for
      end for
      addPlacementSolids(world, placements, numRows)
      for each item in placements
        if item.atlasKey <> invalid
          fp = getAtlas()[item.atlasKey].footprint
          if fp <> invalid
            world.addSolid(item.col * TILE_SIZE + fp.x, cellBottomY(numRows, item.row) + fp.y, fp.w, fp.h)
          end if
        end if
      end for
      world.addBounds(0, 0, rows[0].len() * TILE_SIZE, numRows * TILE_SIZE)
      return world
    end function

    private function newGameContext() as object
      return newStoryContext(new StoryFlags(), new Inventory(getItemDefinitions()), {health: 6, maxHealth: 6, coins: 0})
    end function

    ' Returns how many enemies were checked, so an area with none fails.
    private function assertEnemiesStartFree(rows as string[], placements as object) as integer
      world = m.buildWorld(rows, placements)
      numRows = rows.count()
      checked = 0
      for each item in placements
        if item.type = "enemy"
          feet = enemySpawnPoint(item, numRows)
          m.assertTrue(world.isAreaFree(feet.x - ENEMY_SPAWN_CLEARANCE / 2, feet.y, ENEMY_SPAWN_CLEARANCE, ENEMY_SPAWN_CLEARANCE), item.kind + " at col " + item.col.toStr() + " row " + item.row.toStr() + " starts inside a solid")
          checked++
        end if
      end for
      return checked
    end function

    @describe("enemy spawn points")

    @it("puts every town enemy on open ground")
    function _()
      m.assertTrue(m.assertEnemiesStartFree(getTownRows(), filterPlacements(getTownPlacements(), m.newGameContext())) > 0, "town has no enemies")
    end function

    @it("puts every castle enemy on open ground")
    function _()
      m.assertTrue(m.assertEnemiesStartFree(getCastleRows(), getCastlePlacements()) > 0, "castle has no enemies")
    end function

    @it("puts every sewer enemy on open ground")
    function _()
      m.assertTrue(m.assertEnemiesStartFree(getSewerRows(), getSewerPlacements()) > 0, "sewer has no enemies")
    end function

    @it("puts every sewer drain on open ground")
    function _()
      rows = getSewerRows()
      placements = getSewerPlacements()
      world = m.buildWorld(rows, placements)
      checked = 0
      for each item in placements
        if item.type = "drain"
          feet = enemySpawnPoint(item, rows.count())
          m.assertTrue(world.isAreaFree(feet.x - ENEMY_SPAWN_CLEARANCE / 2, feet.y, ENEMY_SPAWN_CLEARANCE, ENEMY_SPAWN_CLEARANCE), "drain at col " + item.col.toStr() + " row " + item.row.toStr() + " is inside a solid")
          checked++
        end if
      end for
      m.assertEqual(4, checked)
    end function

    @it("leaves every spawn point free, with the gate shut or open")
    function _()
      areas = [
        {name: "town", rows: getTownRows(), placements: getTownPlacements()}
        {name: "castle", rows: getCastleRows(), placements: getCastlePlacements()}
        {name: "sewer", rows: getSewerRows(), placements: getSewerPlacements()}
      ]
      for each gateOpen in [false, true]
        flags = new StoryFlags()
        if gateOpen
          flags.set("gate.open", true)
        end if
        ctx = newStoryContext(flags, new Inventory(getItemDefinitions()), {health: 6, maxHealth: 6, coins: 0})
        for each area in areas
          placements = filterPlacements(area.placements, ctx)
          numRows = area.rows.count()
          world = m.buildWorld(area.rows, placements)
          for each item in placements
            if item.type = "spawn"
              y = cellBottomY(numRows, item.row) + 10
              m.assertTrue(world.isAreaFree(item.col * TILE_SIZE - 10, y, 20, 12), area.name + " spawn " + item.id + " is blocked (gate open: " + gateOpen.toStr() + ")")
            end if
          end for
        end for
      end for
    end function

    @it("puts every town NPC on open ground")
    function _()
      rows = getTownRows()
      placements = filterPlacements(getTownPlacements(), m.newGameContext())
      world = m.buildWorld(rows, placements)
      checked = 0
      for each item in placements
        if item.type = "npc"
          feet = npcSpawnPoint(item, rows.count())
          m.assertTrue(world.isAreaFree(feet.x - 10, feet.y, 20, 12), item.npcId + " starts inside a solid")
          checked++
        end if
      end for
      m.assertEqual(7, checked)
    end function

    @it("keeps every enemy clear of the still NPCs")
    function _()
      rows = getTownRows()
      numRows = rows.count()
      for each stillNpc in getTownPlacements()
        if stillNpc.type = "npc" and stillNpc.wander = 0
          npcFeet = npcSpawnPoint(stillNpc, numRows)
          for each enemy in getTownPlacements()
            if enemy.type = "enemy"
              feet = enemySpawnPoint(enemy, numRows)
              overlapX = Abs(feet.x - npcFeet.x) < (10 + ENEMY_SPAWN_CLEARANCE / 2)
              overlapY = feet.y < npcFeet.y + 12 and feet.y + ENEMY_SPAWN_CLEARANCE > npcFeet.y
              m.assertFalse(overlapX and overlapY, "rat at col " + enemy.col.toStr() + " spawns on " + stillNpc.npcId)
            end if
          end for
        end if
      end for
    end function

  end class
end namespace
