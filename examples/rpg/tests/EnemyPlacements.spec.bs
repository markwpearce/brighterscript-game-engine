namespace tests
  @suite("enemy placements")
  class EnemyPlacementTests extends rooibos.BaseTestSuite

    ' Every solid an area has at runtime: solid ground cells, placement solids, prop footprints
    ' (as Prop.onCreate adds them) and the map bounds.
    private function buildWorld(rows as string[], placements as object) as BGE.SolidWorld
      numRows = rows.count()
      world = new BGE.SolidWorld()
      for r = 0 to numRows - 1
        for c = 0 to rows[r].len() - 1
          if isSolidGroundChar(rows[r].mid(c, 1))
            world.addSolid(c * TILE_SIZE, cellBottomY(numRows, r), TILE_SIZE, TILE_SIZE)
          end if
        end for
      end for
      addPlacementSolids(world, placements, numRows)
      for each item in placements
        if item.atlasKey <> invalid
          fp = getAtlas()[item.atlasKey].footprint
          if fp <> invalid
            world.addSolid(item.col * TILE_SIZE + fp.x, cellBottomY(numRows, item.row) + fp.y, fp.w, fp.h)
          end if
        end if
      end for
      world.addBounds(0, 0, rows[0].len() * TILE_SIZE, numRows * TILE_SIZE)
      return world
    end function

    ' Returns how many enemies were checked, so an area with none fails.
    private function assertEnemiesStartFree(rows as string[], placements as object) as integer
      world = m.buildWorld(rows, placements)
      numRows = rows.count()
      checked = 0
      for each item in placements
        if item.type = "enemy"
          feet = enemySpawnPoint(item, numRows)
          m.assertTrue(world.isAreaFree(feet.x - ENEMY_SPAWN_CLEARANCE / 2, feet.y, ENEMY_SPAWN_CLEARANCE, ENEMY_SPAWN_CLEARANCE), item.kind + " at col " + item.col.toStr() + " row " + item.row.toStr() + " starts inside a solid")
          checked++
        end if
      end for
      return checked
    end function

    @describe("enemy spawn points")

    @it("puts every town enemy on open ground")
    function _()
      m.assertTrue(m.assertEnemiesStartFree(getTownRows(), getTownPlacements()) > 0, "town has no enemies")
    end function

    @it("puts every castle enemy on open ground")
    function _()
      m.assertTrue(m.assertEnemiesStartFree(getCastleRows(), getCastlePlacements()) > 0, "castle has no enemies")
    end function

  end class
end namespace
