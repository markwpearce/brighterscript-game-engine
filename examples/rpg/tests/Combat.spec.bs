namespace tests
  @suite("Combat helpers")
  class CombatTests extends rooibos.BaseTestSuite

    private sub assertBox(rect as object, x as float, y as float, w as float, h as float)
      m.assertEqual(x, rect.x * 1.0, "x")
      m.assertEqual(y, rect.y * 1.0, "y")
      m.assertEqual(w, rect.w * 1.0, "w")
      m.assertEqual(h, rect.h * 1.0, "h")
    end sub

    @describe("swordBox")

    @it("reaches above the feet box when facing up")
    function _()
      m.assertBox(swordBox("up"), -16.0, 12.0, 32.0, 28.0)
    end function

    @it("reaches below the feet when facing down")
    function _()
      m.assertBox(swordBox("down"), -16.0, -28.0, 32.0, 28.0)
    end function

    @it("reaches left of the feet box when facing left")
    function _()
      m.assertBox(swordBox("left"), -38.0, -10.0, 28.0, 32.0)
    end function

    @it("reaches right of the feet box when facing right")
    function _()
      m.assertBox(swordBox("right"), 10.0, -10.0, 28.0, 32.0)
    end function

    @describe("knockbackVector")

    @it("pushes away from the source, scaled to the distance")
    function _()
      push = knockbackVector(0, 0, 3, 4, 10)
      m.assertTrue(Abs(push.x - 6) < 0.001, "x " + push.x.toStr())
      m.assertTrue(Abs(push.y - 8) < 0.001, "y " + push.y.toStr())
    end function

    @it("pushes down when source and target are in the same place")
    function _()
      push = knockbackVector(5, 5, 5, 5, 10)
      m.assertTrue(Abs(push.x) < 0.001, "x " + push.x.toStr())
      m.assertTrue(Abs(push.y + 10) < 0.001, "y " + push.y.toStr())
    end function

    @describe("heartStates")

    @it("splits health points into hearts")
    @params(6, ["full", "full", "full"])
    @params(5, ["full", "full", "half"])
    @params(4, ["full", "full", "empty"])
    @params(3, ["full", "half", "empty"])
    @params(2, ["full", "empty", "empty"])
    @params(1, ["half", "empty", "empty"])
    @params(0, ["empty", "empty", "empty"])
    function _(health, expected)
      m.assertEqual(heartStates(health, 6), expected)
    end function

    @it("treats negative health as empty")
    function _()
      m.assertEqual(heartStates(-1, 4), ["empty", "empty"])
    end function

  end class
end namespace
