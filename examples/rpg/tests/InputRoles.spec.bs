import "pkg:/source/UI/InputRoles.bs"

namespace tests
  @suite("input roles")
  class InputRolesTests extends rooibos.BaseTestSuite

    @describe("isQuitButton")

    @it("quits on a remote back press only")
    @params(true, "back", true)
    @params(true, "b", false)
    @params(false, "back", false)
    @params(false, "b", false)
    @params(true, "ok", false)
    function _(press, rawButton, expected)
      m.assertEqual(isQuitButton(press, rawButton), expected)
    end function

    @describe("isInventoryButton")

    @it("opens on remote play or gamepad y presses")
    @params(true, "play", true)
    @params(true, "y", true)
    @params(false, "y", false)
    @params(false, "play", false)
    @params(true, "x", false)
    @params(true, "ok", false)
    function _(press, rawButton, expected)
      m.assertEqual(isInventoryButton(press, rawButton), expected)
    end function

  end class
end namespace
