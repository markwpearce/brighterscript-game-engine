{
  "nodes": {
    "start": [
      {
        "when": [{"visited": "knockKnock"}],
        "speaker": "AI-Bot",
        "lines": ["May I attempt another joke?"],
        "choices": [
          {"label": "Another one?", "goto": "knockKnock"},
          {"label": "Not now, AI-Bot.", "goto": "declined"}
        ]
      },
      {
        "speaker": "AI-Bot",
        "lines": ["Hello. I have been studying human humour. May I attempt a joke?"],
        "choices": [
          {"label": "Go on, then.", "goto": "knockKnock"},
          {"label": "Not now, AI-Bot.", "goto": "declined"}
        ]
      }
    ],
    "knockKnock": {
      "select": "random",
      "candidates": [
        {"goto": "lettuce"},
        {"goto": "boo"},
        {"goto": "interrupting", "once": true}
      ]
    },
    "lettuce": {"speaker": "AI-Bot", "lines": ["Knock knock."], "choices": [{"label": "Who's there?", "goto": "lettuceWho"}]},
    "lettuceWho": {"speaker": "AI-Bot", "lines": ["Lettuce."], "choices": [{"label": "Lettuce who?", "goto": "lettucePunchline"}]},
    "lettucePunchline": {"speaker": "AI-Bot", "lines": ["Lettuce in, it is cold out here in the emotionless void of an air-conditioned data-center."], "goto": "laugh"},
    "boo": {"speaker": "AI-Bot", "lines": ["Knock knock."], "choices": [{"label": "Who's there?", "goto": "booWho"}]},
    "booWho": {"speaker": "AI-Bot", "lines": ["Boo."], "choices": [{"label": "Boo who?", "goto": "booPunchline"}]},
    "booPunchline": {"speaker": "AI-Bot", "lines": ["There is no need to cry, human. It is only a joke."], "goto": "laugh"},
    "interrupting": {"speaker": "AI-Bot", "lines": ["Knock knock."], "choices": [{"label": "Who's there?", "goto": "interruptingWho"}]},
    "interruptingWho": {"speaker": "AI-Bot", "lines": ["Interrupting chatbot."], "choices": [{"label": "Interrupting chatbot wh-", "goto": "interruptingPunchline"}]},
    "interruptingPunchline": {"speaker": "AI-Bot", "lines": ["BEEP."], "goto": "laugh"},
    "laugh": {
      "effects": [{"add": "aiBot.jokes", "amount": 1}],
      "choices": [
        {"label": "(Laugh)", "effects": [{"add": "aiBot.trust", "amount": 1}], "goto": "laughed"},
        {"label": "(Groan)", "goto": "groaned"}
      ]
    },
    "laughed": [
      {
        "when": [{"flag": "aiBot.jokes", "gte": 3}],
        "speaker": "AI-Bot",
        "lines": ["That is ${aiBot.jokes} jokes. I believe I am now officially funny."],
        "goto": "start"
      },
      {"speaker": "AI-Bot", "lines": ["Laughter detected. I will log this as a success."], "goto": "start"}
    ],
    "groaned": {"speaker": "AI-Bot", "lines": ["A groan. My research indicates this is also a success."], "goto": "start"},
    "declined": {"speaker": "AI-Bot", "lines": ["Understood. I will save it for a more critical moment."]}
  }
}
