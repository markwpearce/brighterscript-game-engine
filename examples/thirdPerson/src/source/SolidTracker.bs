import "World.bs"
import "Entities/Fighter.bs"

' A fighter SolidTracker keeps out of solids, and where it was after the last resolve()
interface TrackedFighter extends roAssociativeArray
  body as Fighter
  x as float
  z as float
end interface

' Keeps fighters out of a scene's solids (walls, buildings, fences). Call resolve() once everyone
' has moved (their own movement, knockback and being pushed apart): each fighter's move since the
' last call is replayed through the SolidWorld, so it stops flush against solids and slides along
' them. The SolidWorld's y is the world's z.
class SolidTracker

  private solidWorld as BGE.SolidWorld
  private tracked as TrackedFighter[] = []

  sub new(solidWorld as BGE.SolidWorld)
    m.solidWorld = solidWorld
  end sub

  ' Starts keeping `body` out of solids from where it is now. Call again after teleporting it
  ' (e.g. a respawn), or the jump is replayed as a move.
  sub track(body as Fighter)
    for each entry in m.tracked
      if entry.body.combatId = body.combatId
        entry.x = body.position.x
        entry.z = body.position.z
        return
      end if
    end for
    m.tracked.push({body: body, x: body.position.x, z: body.position.z} as TrackedFighter)
  end sub

  ' Stops tracking everyone
  sub clear()
    m.tracked = []
  end sub

  sub resolve()
    for each entry in m.tracked
      body = entry.body
      side = body.bodyRadius * 2
      feet = {x: entry.x - body.bodyRadius, y: entry.z - body.bodyRadius, w: side, h: side}
      result = m.solidWorld.moveAndSlide(feet, body.position.x - entry.x, body.position.z - entry.z)
      body.position.x = result.x + body.bodyRadius
      body.position.z = result.y + body.bodyRadius
      entry.x = body.position.x
      entry.z = body.position.z
    end for
  end sub

end class
