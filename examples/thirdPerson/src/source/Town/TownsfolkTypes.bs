import "../Entities/Townsfolk.bs"

' The townspeople and the pig, as data: each sheet's anchor and frame columns, as
' tools/render-character.py printed them (see the README's "Town art").
namespace TownsfolkTypes

  ' Everyone who stands about in town, in the order TownScene picks from
  function people() as TownsfolkType[]
    return [
      TownsfolkTypes.peasantMale(),
      TownsfolkTypes.peasantFemale(),
      TownsfolkTypes.nobleman(),
      TownsfolkTypes.oldMan(),
      TownsfolkTypes.priest(),
      TownsfolkTypes.noblewoman()
    ]
  end function

  function peasantMale() as TownsfolkType
    return {atlas: "peasant_m", anchorX: 0.331, anchorY: 0.951, framesPerDirection: 4, idle: [0, 1, 2, 3], walk: [], mirrored: false}
  end function

  function peasantFemale() as TownsfolkType
    return {atlas: "peasant_f", anchorX: 0.445, anchorY: 0.91, framesPerDirection: 4, idle: [0, 1, 2, 3], walk: [], mirrored: false}
  end function

  function nobleman() as TownsfolkType
    return {atlas: "nobleman", anchorX: 0.216, anchorY: 0.955, framesPerDirection: 4, idle: [0, 1, 2, 3], walk: [], mirrored: true}
  end function

  function oldMan() as TownsfolkType
    return {atlas: "old_man", anchorX: 0.325, anchorY: 0.941, framesPerDirection: 4, idle: [0, 1, 2, 3], walk: [], mirrored: false}
  end function

  function priest() as TownsfolkType
    return {atlas: "priest", anchorX: 0.428, anchorY: 0.944, framesPerDirection: 4, idle: [0, 1, 2, 3], walk: [], mirrored: false}
  end function

  function noblewoman() as TownsfolkType
    return {atlas: "noblewoman", anchorX: 0.336, anchorY: 0.96, framesPerDirection: 4, idle: [0, 1, 2, 3], walk: [], mirrored: false}
  end function

  function pig() as TownsfolkType
    return {atlas: "pig", anchorX: 0.438, anchorY: 0.823, framesPerDirection: 12, idle: [0, 1, 2, 3], walk: [4, 5, 6, 7, 8, 9, 10, 11], mirrored: true}
  end function

end namespace
