import "../World.bs"
import "pkg:/source/engine/gridMaps/CharGrid.bs"

' The town as a text grid of 2 m cells, read from src/maps/town.txt (its key is the comment at the
' top). tools/town-ground.py paints the ground from the same file.
namespace TownMap

  const CELL_METRES = 2
  ' Kinds whose connected cells make one thing each
  const GROUP_KINDS = "HuKtG"
  ' Kinds placed one per cell
  const CELL_KINDS = "lnMPWY@"
  ' Kinds a door can open onto
  const STREET_KINDS = "=-"

  ' town.txt's rows, without its comments
  function readRows() as string[]
    rows = [] as string[]
    for each textLine in ReadAsciiFile("pkg:/maps/town.txt").split(Chr(10))
      textLine = textLine.trim()
      if textLine <> "" and Left(textLine, 1) <> "#"
        rows.push(textLine)
      end if
    end for
    return rows
  end function

end namespace

' A parsed town.txt (TownMap.readRows()). Nothing in it is solid by character.
class TownLayout extends BGE.CharGrid

  ' Every cell holding something placed one per cell (torches, people, pigs, the well, the start)
  cells as BGE.CharGridCell[]
  ' Houses, huts and the keep: each connected block of a group kind
  buildings as BGE.CharGridGroup[]
  towers as BGE.CharGridGroup[]
  gate as BGE.CharGridGroup

  sub new(rows as string[])
    super(rows, {cellSize: World.metres(TownMap.CELL_METRES), solidKinds: ""})
    m.cells = m.cellsOf(TownMap.CELL_KINDS)
    m.buildings = []
    m.towers = []
    for each group in m.findConnectedGroups(TownMap.GROUP_KINDS)
      if group.kind = "t"
        m.towers.push(group)
      else if group.kind = "G"
        m.gate = group
      else
        m.buildings.push(group)
      end if
    end for
  end sub

  ' The y rotation (radians) turning a model whose door faces +z to face the group's street side.
  ' A group as wide as `frontCells` faces +z or -z; otherwise it's turned to face +x or -x. A
  ' square one may face any way. Of the allowed sides, the door goes on the one with the most
  ' street or path along it.
  function doorTurn(group as BGE.CharGridGroup, frontCells as integer) as float
    sides = [] as roAssociativeArray[]
    if group.cols = frontCells
      sides.push({turn: 0, streetCells: m.streetAlong(group.col, group.row + group.rows, group.cols, 1)})
      sides.push({turn: BGE.Math.PI, streetCells: m.streetAlong(group.col, group.row - 1, group.cols, 1)})
    end if
    if group.rows = frontCells
      ' a quarter turn faces -x (BGE.Math.rotationForward())
      sides.push({turn: -BGE.Math.PI / 2, streetCells: m.streetAlong(group.col + group.cols, group.row, 1, group.rows)})
      sides.push({turn: BGE.Math.PI / 2, streetCells: m.streetAlong(group.col - 1, group.row, 1, group.rows)})
    end if
    best = sides[0]
    for each side in sides
      if side.streetCells > best.streetCells
        best = side
      end if
    end for
    return best.turn
  end function

  ' How many street or path cells are in a rectangle (off the grid counts as none)
  function streetAlong(col as integer, row as integer, cols as integer, rows as integer) as integer
    count = 0
    for r = row to row + rows - 1
      for c = col to col + cols - 1
        if m.isKindOf(c, r, TownMap.STREET_KINDS)
          count++
        end if
      end for
    end for
    return count
  end function

end class
