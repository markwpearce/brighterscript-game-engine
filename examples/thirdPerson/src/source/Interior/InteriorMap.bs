import "../World.bs"
import "pkg:/source/engine/gridMaps/CharGrid.bs"

namespace InteriorMap

  ' Cells are 2 m, finer than the crypt's, so there's room to lay out furniture
  const CELL_METRES = 2

end namespace

' An interior's text grid (see Interiors): walls, colliders, furniture and lights all come from
' it. `#` is solid.
class InteriorLayout extends BGE.CharGrid

  ' Every cell that isn't solid
  cells as BGE.CharGridCell[]
  ' The door cells (`E`), the way out
  exits as BGE.CharGridCell[]

  sub new(rows as string[])
    super(rows, {cellSize: World.metres(InteriorMap.CELL_METRES)})
    m.cells = m.cellsExcept("#")
    m.exits = m.cellsOf("E")
  end sub

end class
