import "../World.bs"

' A piece of furniture drawn as a plain box over its group of cells
interface InteriorFurniture extends roAssociativeArray
  ' Metres
  height as float
  ' How far in from its cells' edges, either side, along x and z (metres)
  insetX as float
  insetZ as float
  ' &hRRGGBBAA
  color as integer
end interface

' Something hung flat on a wall from a layout character: banners, windows
interface InteriorHanging extends roAssociativeArray
  ' Bitmap names, taken in turn by each cell of the character
  bitmaps as string[]
  ' Metres from the floor to its bottom
  bottom as float
  ' Drawn at full brightness, not lit by the room (stained glass)
  unlit as boolean
end interface

' One building's inside
interface InteriorPlace extends roAssociativeArray
  ' Passed back to the outside scene as `from`, so the knight comes out of the right door
  id as string
  ' The scene the door leads out to
  outside as string
  ' A text grid; its key is above Interiors.keep()
  layout as string[]
  wallMetres as float
  ambientColor as integer
  ambientIntensity as float
  ' Furniture by its layout character. Quote the keys: unquoted ones come back lower case from
  ' Keys(), and the layout is case-sensitive (`A` the altar).
  furniture as roAssociativeArray
  ' Bitmaps it loads, name -> path
  bitmaps as roAssociativeArray
  ' The door in its doorway (a bitmap name, as wide as the doorway, as tall as the walls)
  door as string
  ' InteriorHanging by layout character
  hangings as roAssociativeArray
end interface

' The buildings you can go inside.
namespace Interiors

  ' The place for an id ("keep" or "chapel"); the keep for anything else
  function get(id as string) as InteriorPlace
    if id = "chapel"
      return Interiors.chapel()
    end if
    return Interiors.keep()
  end function

  ' Row 0 is the far (-z) end; the doors are at the near end. `#` wall, `.` floor, `E` the door
  ' out (a gap in the outer wall, its door drawn at the far end), `t` a torch on the cell's first
  ' wall, `H` a hearth against its first wall, `c` a candle on a stand, `s` a spirit flame on a
  ' stone post, `R` a throne against its first wall, `L` the lord, `P` the priest; any of the
  ' place's furniture characters, one box per rectangle of them, and its hangings' characters
  ' (`f` a banner, `w` a window), each on the cell's first wall. Images: tools/interior-art.py.
  function keep() as InteriorPlace
    return {
      id: "keep",
      outside: "TownScene",
      layout: [
        "##############"
        "#.f.t.RL.t.f.#"
        "#f..........f#"
        "#..b=b..b=b..#"
        "#H.b=b..b=b.H#"
        "#f.b=b..b=b.f#"
        "#..b=b..b=b..#"
        "#t..........t#"
        "#..f......f..#"
        "######EE######"
      ],
      wallMetres: 5,
      ambientColor: &hC09070,
      ambientIntensity: 0.24,
      furniture: {
        "=": {height: 0.8, insetX: 0.15, insetZ: 0, color: &h8A5A34FF},
        "b": {height: 0.45, insetX: 0.6, insetZ: 0.1, color: &h6E4828FF}
      },
      bitmaps: {
        keepDoor: "pkg:/sprites/keep_door.webp",
        keepBanner: "pkg:/sprites/keep_banner.webp",
        keepBannerBlue: "pkg:/sprites/keep_banner_blue.webp"
      },
      door: "keepDoor",
      hangings: {
        "f": {bitmaps: ["keepBanner", "keepBannerBlue"], bottom: 1.5, unlit: false}
      }
    }
  end function

  ' Pews either side of the aisle, the altar at the far end with the priest before it, and
  ' stained glass down both sides and either side of the altar
  function chapel() as InteriorPlace
    return {
      id: "chapel",
      outside: "GraveyardScene",
      layout: [
        "#########"
        "#c.wAw.c#"
        "#...P...#"
        "#w.....w#"
        "#.pp.pp.#"
        "#t.....t#"
        "#.pp.pp.#"
        "#w.....w#"
        "#.pp.pp.#"
        "#s.....s#"
        "####E####"
      ],
      wallMetres: 6,
      ambientColor: &h8090C0,
      ambientIntensity: 0.22,
      furniture: {
        "p": {height: 0.55, insetX: 0.1, insetZ: 0.55, color: &h6E4828FF},
        "A": {height: 1.1, insetX: 0, insetZ: 0.4, color: &hA8A090FF}
      },
      bitmaps: {
        chapelDoor: "pkg:/sprites/chapel_door.webp",
        chapelWindow: "pkg:/sprites/chapel_window.webp"
      },
      door: "chapelDoor",
      hangings: {
        "w": {bitmaps: ["chapelWindow"], bottom: 1.8, unlit: true}
      }
    }
  end function

end namespace
