import "World.bs"
import "Entities/Fighter.bs"

' Keeps track of who's fighting: the player, the enemies, and which enemies may attack right
' now. Like a souls game, one enemy attacks at a time, with a breather between attacks, and
' preferably from where the camera can see it; the rest wait their turn.
class CombatDirector
  ' Where hit particles are played; FieldScene adds it
  bursts as BGE.ParticleBurstPool = invalid
  player as Fighter = invalid
  enemies as Fighter[] = []
  ' Attack slots: one at a time, and after an attack ends nobody else may start one for a while
  attackTokens as BGE.TokenPool = new BGE.TokenPool(1, 1.2)
  ' Where the camera looks (World heading), set each frame by the scene
  viewHeading as float = 0
  ' Enemies further than this either side of the view can't start an attack
  viewHalfAngle as float = BGE.Math.PI * 0.45
  ' After this long with nobody attacking, enemies out of view may attack too, so looking away
  ' isn't a hiding place
  offscreenAttackSeconds as float = 4

  private nextCombatId as integer = 1

  sub add(combatant as Fighter)
    combatant.combatId = m.nextCombatId
    m.nextCombatId++
  end sub

  sub setPlayer(combatant as Fighter)
    m.add(combatant)
    m.player = combatant
  end sub

  sub addEnemy(combatant as Fighter)
    m.add(combatant)
    m.enemies.push(combatant)
  end sub

  ' Forgets an foe (e.g. once it has died); its body stops blocking.
  sub removeEnemy(combatant as Fighter)
    m.releaseAttack(combatant)
    for i = m.enemies.Count() - 1 to 0 step -1
      if m.enemies[i].combatId = combatant.combatId
        m.enemies.Delete(i)
      end if
    end for
  end sub

  ' Removes every foe from the game.
  sub clearEnemies()
    for each foe in m.enemies
      foe.invalidate()
    end for
    m.enemies = []
    m.attackTokens.clear()
  end sub

  sub update(dt as float)
    m.attackTokens.update(dt)
  end sub

  ' True if `combatant` may start an attack now: a slot is free, and it's in view or the
  ' player has gone unattacked for offscreenAttackSeconds.
  function mayStartAttack(combatant as Fighter) as boolean
    if not m.canAttack(combatant)
      return false
    end if
    return m.isInView(combatant) or m.attackTokens.idleSeconds() >= m.offscreenAttackSeconds
  end function

  ' True if `combatant` holds an attack slot, or one is free.
  function canAttack(combatant as Fighter) as boolean
    return m.attackTokens.canRequest(combatant.combatId)
  end function

  ' True when `combatant` is roughly where the camera looks, seen from the player.
  function isInView(combatant as Fighter) as boolean
    if invalid = m.player
      return true
    end if
    return Abs(m.viewAngleOf(combatant)) <= m.viewHalfAngle
  end function

  ' Radians from the view heading to `combatant`, seen from the player; positive is to the right.
  function viewAngleOf(combatant as Fighter) as float
    return BGE.Math.wrapAngle(BGE.Math.headingOf(m.player.directionTo(combatant)) - m.viewHeading)
  end function

  ' Takes an attack slot if one is free. Release it with releaseAttack() when the attack is over.
  function requestAttack(combatant as Fighter) as boolean
    return m.attackTokens.request(combatant.combatId)
  end function

  sub releaseAttack(combatant as Fighter)
    m.attackTokens.release(combatant.combatId)
  end sub

  ' Living enemies within `reach` (plus their body radius) of `attacker` and within halfAngle
  ' radians of where it faces.
  function enemiesInArc(attacker as Fighter, reach as float, halfAngle as float) as Fighter[]
    targets = []
    for each foe in m.enemies
      if foe.isAlive() and attacker.isInArc(foe, reach, halfAngle)
        targets.push(foe)
      end if
    end for
    return targets
  end function

  ' The living enemy to lock onto from `from`: within `range` and `halfAngle` radians of the
  ' view heading, nearest first (an enemy straight ahead counts as closer). invalid if none.
  function lockOnCandidate(from as Fighter, range as float, halfAngle as float) as Fighter
    best = invalid
    bestScore = 0
    for each foe in m.enemies
      angle = Abs(BGE.Math.wrapAngle(BGE.Math.headingOf(from.directionTo(foe)) - m.viewHeading))
      distance = from.distanceTo(foe)
      if foe.isAlive() and distance <= range and angle <= halfAngle
        score = distance * (1 + angle)
        if invalid = best or score < bestScore
          best = foe
          bestScore = score
        end if
      end if
    end for
    return best
  end function

  ' The living enemy within `range` of `from` whose bearing is next round from `current`'s, to
  ' the right (`side` 1) or left (-1). invalid if there's none that way.
  function nextLockTarget(from as Fighter, current as Fighter, side as float, range as float) as Fighter
    currentHeading = BGE.Math.headingOf(from.directionTo(current))
    best = invalid
    bestTurn = 0
    for each foe in m.enemies
      if foe.isAlive() and foe.combatId <> current.combatId and from.distanceTo(foe) <= range
        turn = BGE.Math.wrapAngle(BGE.Math.headingOf(from.directionTo(foe)) - currentHeading) * side
        if turn > 0 and (invalid = best or turn < bestTurn)
          best = foe
          bestTurn = turn
        end if
      end if
    end for
    return best
  end function

  ' Pushes overlapping bodies apart, so nobody walks through anybody else. The lighter body
  ' moves further.
  sub separateBodies()
    bodies = []
    if invalid <> m.player and m.player.isAlive()
      bodies.push({position: m.player.position, radius: m.player.bodyRadius, mass: m.player.mass})
    end if
    for each foe in m.enemies
      if foe.isAlive()
        bodies.push({position: foe.position, radius: foe.bodyRadius, mass: foe.mass})
      end if
    end for
    BGE.separateCircles(bodies)
  end sub

  function livingEnemyCount() as integer
    count = 0
    for each foe in m.enemies
      if foe.isAlive()
        count++
      end if
    end for
    return count
  end function

end class
