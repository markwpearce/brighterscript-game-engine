import "pkg:/source/utils/SaveSlot.bs"
import "GameSave.bs"

' The player's settings, kept apart from the saved game so a new game doesn't reset them. Get the
' shared one with Settings.current(). Volumes are 0-100.
class GameSettings

  profile as BGE.SaveProfile = new BGE.SaveProfile(SaveData.SECTION, "settings")

  function musicVolume() as integer
    return m.profile.get("musicVolume", 80)
  end function

  function soundVolume() as integer
    return m.profile.get("soundVolume", 80)
  end function

  ' Writes the volumes that changed
  sub setVolumes(music as integer, sound as integer)
    if music <> m.musicVolume()
      m.profile.set("musicVolume", music)
    end if
    if sound <> m.soundVolume()
      m.profile.set("soundVolume", sound)
    end if
  end sub

end class

namespace Settings

  ' The player's settings, read the first time anything asks for them
  function current() as GameSettings
    globals = GetGlobalAA()
    if invalid = globals.gameSettings
      globals.gameSettings = new GameSettings()
    end if
    return globals.gameSettings
  end function

end namespace
