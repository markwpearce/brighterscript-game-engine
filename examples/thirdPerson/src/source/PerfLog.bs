' Prints the game renderer's average frame time and stage times (Renderer.profileStages) to
' the console every few seconds. Turned on with the `perf=1` deep link.
class PerfLog

  intervalSeconds as float = 3

  private renderer as BGE.Renderer
  private elapsed as float = 0
  private frames as integer = 0
  private stageTotals as roAssociativeArray = {}
  private stageCounts as roAssociativeArray = {}

  sub new(rendererObj as BGE.Renderer)
    m.renderer = rendererObj
    rendererObj.profileStages = true
  end sub

  ' Adds last frame's stage times (render runs after the update this is called from)
  sub update(dt as float)
    m.frames++
    m.elapsed += dt
    stageMs = m.renderer.getStageMsLastFrame()
    stageCounts = m.renderer.getStageCountsLastFrame()
    for each name in stageMs
      if m.stageTotals[name] = invalid
        m.stageTotals[name] = 0
        m.stageCounts[name] = 0
      end if
      m.stageTotals[name] += stageMs[name]
      m.stageCounts[name] += stageCounts[name]
    end for
    if m.elapsed < m.intervalSeconds
      return
    end if
    frameMs = 1000 * m.elapsed / m.frames
    line = `PERF fps ${(m.frames / m.elapsed).toStr()} frameMs ${frameMs.toStr()} objects ${m.renderer.getSceneObjectCount().toStr()}`
    for each name in m.stageTotals
      avgMs = m.stageTotals[name] / m.frames
      avgCount = m.stageCounts[name] / m.frames
      line += ` | ${name} ${avgMs.toStr()}ms x${avgCount.toStr()}`
    end for
    print line
    m.elapsed = 0
    m.frames = 0
    m.stageTotals = {}
    m.stageCounts = {}
  end sub

end class
