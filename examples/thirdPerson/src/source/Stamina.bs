' A stamina pool: actions spend it, and it refills after a short pause. Any stamina left is
' enough to start an action, which can take it down to zero (souls-style).
class Stamina

  max as float = 100
  current as float = 100
  ' Per second, once regenDelaySeconds have passed since the last spend
  regenPerSecond as float = 50
  regenDelaySeconds as float = 0.6
  ' Fraction of the regen rate while slowed (e.g. holding a block)
  slowedRegenFactor as float = 0.35

  ' Counts down after an action was refused for lack of stamina, for the HUD to flash
  deniedSeconds as float = 0

  private sinceSpendSeconds as float = 0

  function canAct() as boolean
    return m.current > 0
  end function

  ' Takes `amount`, never below zero. Returns false (and spends nothing) when empty.
  function spend(amount as float) as boolean
    if not m.canAct()
      m.deniedSeconds = 0.4
      return false
    end if
    m.current = BGE.Math.Max(0, m.current - amount)
    m.sinceSpendSeconds = 0
    return true
  end function

  ' Takes `amount` whether or not there's enough. Returns true if it all came out of the pool,
  ' false if it ran dry (e.g. a broken block).
  function drain(amount as float) as boolean
    covered = m.current >= amount
    m.current = BGE.Math.Max(0, m.current - amount)
    m.sinceSpendSeconds = 0
    return covered
  end function

  sub update(dt as float, slowed = false as boolean)
    m.deniedSeconds = BGE.Math.Max(0, m.deniedSeconds - dt)
    m.sinceSpendSeconds += dt
    if m.sinceSpendSeconds < m.regenDelaySeconds
      return
    end if
    rate = m.regenPerSecond
    if slowed
      rate *= m.slowedRegenFactor
    end if
    m.current = BGE.Math.Min(m.max, m.current + rate * dt)
  end sub

  sub refill()
    m.current = m.max
    m.sinceSpendSeconds = 0
  end sub

  function fraction() as float
    return m.current / m.max
  end function

end class
