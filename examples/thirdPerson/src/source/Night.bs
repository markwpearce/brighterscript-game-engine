import "pkg:/source/engine/GameScene.bs"
' The night: moonlight and a blue sky fill.
namespace Night

  ' Where the moon is in the sky texture (tools/night-sky.py draws it there). Heading 0 faces -z.
  const MOON_YAW_DEGREES = -30
  const MOON_ELEVATION_DEGREES = 20

  ' The way moonlight travels: from the moon, down across the field.
  function moonlightDirection() as BGE.Math.Vector
    towardMoon = BGE.Math.directionFromYawPitch(BGE.Math.DegreesToRadians(Night.MOON_YAW_DEGREES), BGE.Math.DegreesToRadians(Night.MOON_ELEVATION_DEGREES))
    return BGE.Math.VectorOps.scale(towardMoon, -1)
  end function

  ' Adds the moon and the sky's fill light to a scene, which removes them when it ends
  sub addLights(scene as BGE.GameScene)
    moon = new BGE.DirectionalLight(Night.moonlightDirection(), &h9DB4F0, 0.75)
    scene.addLight(moon)
    sky = new BGE.AmbientLight(&h3A4C8A, 0.7)
    scene.addLight(sky)
  end sub

end namespace
