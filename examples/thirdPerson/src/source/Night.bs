' The night: moonlight and a blue sky fill, and how the cut-out characters are tinted by them.
namespace Night

  ' Where the moon is in the sky texture (tools/night-sky.py draws it there). Heading 0 faces -z.
  const MOON_YAW_DEGREES = -30
  const MOON_ELEVATION_DEGREES = 20

  ' The way moonlight travels: from the moon, down across the field.
  function moonlightDirection() as BGE.Math.Vector
    yaw = BGE.Math.DegreesToRadians(Night.MOON_YAW_DEGREES)
    elevation = BGE.Math.DegreesToRadians(Night.MOON_ELEVATION_DEGREES)
    return BGE.Math.VectorOps.create(-Sin(yaw) * Cos(elevation), -Sin(elevation), Cos(yaw) * Cos(elevation))
  end function

  ' Adds the moon and the sky's fill light to the game. Remove them in the scene's onDestroy().
  function addLights(game as BGE.Game) as BGE.Light[]
    lights = [
      new BGE.DirectionalLight(Night.moonlightDirection(), &h9DB4F0, 0.75),
      new BGE.AmbientLight(&h3A4C8A, 0.7)
    ] as BGE.Light[]
    for each light in lights
      game.addLight(light)
    end for
    return lights
  end function

  ' The renderer doesn't shade sprites, so the characters are tinted here: lit as if they
  ' faced the camera, with "wrapped" light so a back-lit figure is dim rather than black.
  '
  ' @return {integer} RGB tint to multiply into the sprite's colour
  function spriteTint(rendererObj as BGE.Renderer, point as BGE.Math.Vector) as integer
    lights = rendererObj.getPreparedLights()
    if lights.Count() = 0
      return &hFFFFFF
    end if
    normal = BGE.Math.flatDirection(point, rendererObj.camera.position)
    r = 0.0
    g = 0.0
    b = 0.0
    for each light in lights
      amount = 1.0
      if light.type = BGE.LightType.directional
        amount = BGE.Math.VectorOps.dotProduct(normal, light.toLight) * 0.5 + 0.5
      else if light.type = BGE.LightType.point
        toLight = BGE.Math.VectorOps.subtract(light.position, point)
        distance = BGE.Math.VectorOps.length(toLight)
        if distance > 0
          amount = BGE.Math.VectorOps.dotProduct(normal, toLight) / distance * 0.5 + 0.5
        end if
        if light.range > 0
          amount = amount * BGE.Math.Max(0, 1 - distance / light.range)
        end if
      end if
      r += light.r * amount
      g += light.g * amount
      b += light.b * amount
    end for
    return (cint(BGE.Math.Min(r, 1) * 255) << 16) + (cint(BGE.Math.Min(g, 1) * 255) << 8) + cint(BGE.Math.Min(b, 1) * 255)
  end function

  ' Two RGB colours multiplied together, channel by channel.
  function multiplyRGB(a as integer, b as integer) as integer
    red = ((a >> 16) and &hFF) * ((b >> 16) and &hFF) \ 255
    green = ((a >> 8) and &hFF) * ((b >> 8) and &hFF) \ 255
    blue = (a and &hFF) * (b and &hFF) \ 255
    return (red << 16) + (green << 8) + blue
  end function

end namespace
