import "World.bs"
import "Entities/Fence.bs"
import "Entities/Pillar.bs"
import "Entities/Prop.bs"
import "Entities/PropModel.bs"
import "Entities/Torch.bs"

' The scenery the town and the graveyard place the same way: picket fences, trees, torches on
' wall brackets and stone lantern posts. Each adds its solids to the scene's SolidWorld.
namespace Dressing

  ' The tree images (load them as bitmaps), `tree1` to `tree5`
  function treeBitmapPaths() as roAssociativeArray
    return {
      tree1: "pkg:/sprites/tree_1.webp",
      tree2: "pkg:/sprites/tree_2.webp",
      tree3: "pkg:/sprites/tree_3.webp",
      tree4: "pkg:/sprites/tree_4.webp",
      tree5: "pkg:/sprites/tree_5.webp"
    }
  end function

  ' A tree, its trunk's foot at x, z. `pick` and `size` in [0, 1) choose the image and its height
  ' (7-9 m to the top of the image), so a number fixed per cell gives the same tree every time.
  sub addTree(game as BGE.Game, x as float, z as float, pick as float, size as float, solids as BGE.SolidWorld)
    ' Where each image's trunk meets the ground (tools/trees.js): some trees' low branches hang
    ' below it
    anchors = [[0.51, 0.86], [0.52, 0.89], [0.51, 0.99], [0.42, 0.99], [0.49, 0.99]]
    which = Int(pick * anchors.Count())
    anchor = anchors[which]
    tall = World.metres(7 + size * 2)
    tree = new Prop(game)
    game.addEntity(tree, {x: x, z: z, bitmap: `tree${which + 1}`, scale: tall / 320, anchorX: anchor[0], anchorY: anchor[1]})
    half = World.metres(0.3)
    solids.addSolid(x - half, z - half, half * 2, half * 2)
  end sub

  ' The picket image, copied out of the props atlas (load "propsAtlas" first) so a fence can
  ' repeat it
  function picketRegion(game as BGE.Game) as roRegion
    atlas = game.getBitmap("propsAtlas")
    ' Alpha blending off, so the gaps between the pickets are copied as transparent
    pickets = CreateObject("roBitmap", {width: 62, height: 62, AlphaEnable: false})
    pickets.DrawObject(-193, -193, atlas)
    pickets.Finish()
    return CreateObject("roRegion", pickets, 0, 0, 62, 62)
  end function

  ' A straight picket fence from the centre of one cell to another (a row or column apart), and
  ' a thin solid along it
  sub addFence(game as BGE.Game, first as BGE.Math.Vector, last as BGE.Math.Vector, pickets as roRegion, solids as BGE.SolidWorld)
    thickness = World.metres(0.3)
    solids.addSolid(first.x - thickness / 2, first.z - thickness / 2, last.x - first.x + thickness, last.z - first.z + thickness)
    picketFence = new Fence(game)
    game.addEntity(picketFence, {from: first, to: last, region: pickets})
  end sub

  ' A torch on a bracket (the "torchWall" model; load it first) fixed to a wall at x, z, pointing
  ' out along `turn` (+z at 0), its flame at the bracket's tip
  sub addWallTorch(game as BGE.Game, x as float, z as float, turn as float, kind as FlameKind)
    bracket = new PropModel(game)
    game.addEntity(bracket, {
      x: x,
      z: z,
      model: "torchWall",
      width: World.metres(0.2),
      height: World.metres(2.8),
      depth: World.metres(0.2),
      turn: turn,
      blocksCamera: false
    })
    ' The model's tip is 0.4 m out from the wall and 2.75 m up
    flame = new Torch(game)
    game.addEntity(flame, {x: x + Sin(turn) * World.metres(0.4), y: World.metres(2.75), z: z + Cos(turn) * World.metres(0.4), kind: kind})
  end sub

  ' A knee-high stone post with a flame burning on top (`size` against a torch's), and its solid
  sub addLanternPost(game as BGE.Game, x as float, z as float, kind as FlameKind, solids as BGE.SolidWorld, size = 1.0 as float)
    width = World.metres(0.45)
    height = World.metres(1)
    post = new Pillar(game)
    game.addEntity(post, {x: x, z: z, width: width, height: height})
    solids.addSolid(x - width / 2, z - width / 2, width, width)
    flame = new Torch(game)
    game.addEntity(flame, {x: x, y: height, z: z, kind: kind, size: size})
  end sub

end namespace
