' Deep link `strips=1` (#556): lets every model's impostor redraw as vertical strips, tuned by
' stripStep (px), stripWidth (px), stripKnots, stripError (px), stripMax, stripAngle (degrees),
' blitScale, blitAngle (degrees), blitAngleScale, stripScale, blitRoll (rotate the single blit
' only for camera roll), stripLinear (the first, linear strip fit), stripPoints (most vertices a fit uses), stripLevel=0 (fit and draw the strips upright on the canvas, not in a level view) and newFace=0 (don't redraw
' for a side turning into view) - see BGE.DrawableModel.useImpostorStrips. main() keeps the
' launch values in GetGlobalAA().impostorStrips.
sub applyImpostorStrips(drawable as BGE.DrawableModel)
  strips = GetGlobalAA().impostorStrips
  if invalid = strips
    return
  end if
  drawable.useImpostorStrips = strips.strips = "1" or strips.strips = "true"
  if invalid <> strips.stripStep
    drawable.impostorStripStepPx = strips.stripStep.toFloat()
  end if
  if invalid <> strips.stripWidth
    drawable.impostorStripWidth = strips.stripWidth.toInt()
  end if
  if invalid <> strips.stripKnots
    drawable.impostorStripKnots = strips.stripKnots.toInt()
  end if
  if invalid <> strips.stripError
    drawable.impostorStripMaxError = strips.stripError.toFloat()
  end if
  if invalid <> strips.stripMax
    drawable.impostorStripMaxStrips = strips.stripMax.toInt()
  end if
  if invalid <> strips.stripAngle
    drawable.impostorStripMaxAngleDegrees = strips.stripAngle.toFloat()
  end if
  if invalid <> strips.blitScale
    drawable.impostorBlitErrorScale = strips.blitScale.toFloat()
  end if
  if invalid <> strips.blitAngle
    drawable.impostorBlitMaxAngleDegrees = strips.blitAngle.toFloat()
  end if
  if invalid <> strips.stripScale
    drawable.impostorStripErrorScale = strips.stripScale.toFloat()
  end if
  if invalid <> strips.blitRoll
    drawable.impostorBlitRollOnly = strips.blitRoll = "1" or strips.blitRoll = "true"
  end if
  if invalid <> strips.newFace
    drawable.impostorRedrawOnNewFace = not (strips.newFace = "0" or strips.newFace = "false")
  end if
  if invalid <> strips.blitAngleScale
    drawable.impostorBlitAngleScale = strips.blitAngleScale.toFloat()
  end if
  if invalid <> strips.stripPoints
    drawable.impostorStripMaxPoints = strips.stripPoints.toInt()
  end if
  if invalid <> strips.stripLevel
    drawable.impostorStripLevel = not (strips.stripLevel = "0" or strips.stripLevel = "false")
  end if
  if invalid <> strips.stripLinear
    drawable.impostorStripPerspective = not (strips.stripLinear = "1" or strips.stripLinear = "true")
  end if
end sub
