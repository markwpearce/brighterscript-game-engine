' Something the knight can own: a weapon, a shield, a key item or an upgrade (used at once).
' Weapons and shields only change his numbers; the sprite keeps the same sword and shield.
interface ItemInfo extends roAssociativeArray
  id as string
  name as string
  ' An ItemKind
  kind as string
  description as string
  ' Its picture in pkg:/images/item_icons.png (ItemIcons)
  icon as integer
  ' Weapons: a swing's damage, its length in seconds and its stamina
  damage as float
  swingSeconds as float
  stamina as float
  ' Shields: the fraction of a blocked hit let through, the stamina each point blocked costs, and
  ' the stamina regen rate while it's raised (a fraction of the normal rate)
  blockLeak as float
  blockStaminaPerDamage as float
  raisedRegen as float
end interface

enum ItemKind
  weapon = "weapon"
  shield = "shield"
  key = "key"
  upgrade = "upgrade"
end enum

' Every item in the game, by id. Grant one with RunState.grantItem().
namespace Items

  const LONGSWORD = "longsword"
  const ORC_CLEAVER = "orcCleaver"
  const WARDENS_BLADE = "wardensBlade"
  const HEATER_SHIELD = "heaterShield"
  const TOWER_SHIELD = "towerShield"
  const CHIEFTAINS_TUSK = "chieftainsTusk"
  ' +1 healing draught (to MAX_DRAUGHTS)
  const BARROW_FLASK = "barrowFlask"

  const MAX_DRAUGHTS = 5
  ' A draught heals this fraction of his max health
  const DRAUGHT_HEAL = 0.4

  ' Pictures in item_icons.png that aren't items
  const ICON_DRAUGHT = 5
  const ICON_COIN = 6

  function all() as ItemInfo[]
    return [
      Items.weapon(Items.LONGSWORD, "Longsword", 0, 30, 0.5833, 22, "A knight's sword, well balanced. Nothing fancy, nothing lacking."),
      Items.weapon(Items.ORC_CLEAVER, "Orc Cleaver", 1, 40, 0.7, 30, "A slab of iron with an edge. Hits hard, swings slow, tires the arm."),
      Items.weapon(Items.WARDENS_BLADE, "Warden's Blade", 2, 26, 0.48, 18, "Light steel from the old crypt wardens. Quick in the hand, a little less bite."),
      Items.shield(Items.HEATER_SHIELD, "Heater Shield", 3, 0.2, 1.5, 0.35, "A plain kite of oak and iron. Turns most of a blow."),
      Items.shield(Items.TOWER_SHIELD, "Tower Shield", 4, 0.08, 1.2, 0.2, "A wall to hide behind. Blocks nearly everything, but breath comes slowly behind it."),
      Items.other(Items.CHIEFTAINS_TUSK, "Chieftain's Tusk", ItemKind.key, 7, "Torn from the orc chieftain's jaw. Proof enough for anyone who doubts you."),
      Items.other(Items.BARROW_FLASK, "Barrow Flask", ItemKind.upgrade, 8, "An old clay flask. Carry one more healing draught.")
    ]
  end function

  ' The item with this id, or invalid
  function get(id as string) as ItemInfo
    for each item in Items.all()
      if item.id = id
        return item
      end if
    end for
    return invalid
  end function

  ' A weapon's or shield's numbers as short lines for the inventory
  function statLines(item as ItemInfo) as string[]
    if item.kind = ItemKind.weapon
      return [`Damage ${Int(item.damage)}`, `Swing ${Int(item.swingSeconds * 100 + 0.5) / 100} s`, `Stamina ${Int(item.stamina)}`]
    else if item.kind = ItemKind.shield
      return [`Blocks ${Int((1 - item.blockLeak) * 100 + 0.5)}%`, `Guard cost ${item.blockStaminaPerDamage} per hit point`, `Regen raised ${Int(item.raisedRegen * 100 + 0.5)}%`]
    end if
    return []
  end function

  function weapon(id as string, name as string, icon as integer, damage as float, swingSeconds as float, stamina as float, description as string) as ItemInfo
    item = Items.other(id, name, ItemKind.weapon, icon, description)
    item.damage = damage
    item.swingSeconds = swingSeconds
    item.stamina = stamina
    return item
  end function

  function shield(id as string, name as string, icon as integer, blockLeak as float, blockStaminaPerDamage as float, raisedRegen as float, description as string) as ItemInfo
    item = Items.other(id, name, ItemKind.shield, icon, description)
    item.blockLeak = blockLeak
    item.blockStaminaPerDamage = blockStaminaPerDamage
    item.raisedRegen = raisedRegen
    return item
  end function

  function other(id as string, name as string, kind as ItemKind, icon as integer, description as string) as ItemInfo
    return {id: id, name: name, kind: kind, description: description, icon: icon, damage: 0, swingSeconds: 0, stamina: 0, blockLeak: 0, blockStaminaPerDamage: 0, raisedRegen: 0}
  end function

end namespace

' The item pictures, 64 x 64 each in one strip (tools/item-icons.py), loaded once and kept
namespace ItemIcons

  const SIZE = 64

  ' Picture `index`, or invalid if the strip didn't load. Made once each (the HUD asks every
  ' frame).
  function region(index as integer) as roRegion
    globals = GetGlobalAA()
    if invalid = globals.itemIconRegions
      globals.itemIconRegions = {}
    end if
    key = index.toStr()
    if invalid <> globals.itemIconRegions[key]
      return globals.itemIconRegions[key]
    end if
    if invalid = globals.itemIconsBitmap
      globals.itemIconsBitmap = CreateObject("roBitmap", "pkg:/images/item_icons.png")
      if invalid = globals.itemIconsBitmap
        return invalid
      end if
    end if
    picture = CreateObject("roRegion", globals.itemIconsBitmap, index * ItemIcons.SIZE, 0, ItemIcons.SIZE, ItemIcons.SIZE)
    if invalid <> picture
      picture.SetScaleMode(1)
      globals.itemIconRegions[key] = picture
    end if
    return picture
  end function

end namespace
