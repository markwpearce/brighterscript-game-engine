import "../World.bs"
import "Torch.bs"

' The coins the knight dropped when he died: a small spirit flame on the ground where he fell.
' Walking onto it picks them up (ThirdPersonScene.updateDroppedCoins()).
class CoinMarker extends Torch

  sub new(game as BGE.Game)
    super(game)
    m.name = "CoinMarker"
  end sub

  ' args: x, z
  override sub onCreate(args as roAssociativeArray)
    super.onCreate({x: args.x, y: World.metres(0.05), z: args.z, kind: FlameKind.spirit, size: 0.45})
  end sub

end class
