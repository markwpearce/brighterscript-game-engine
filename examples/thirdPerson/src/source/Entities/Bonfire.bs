import "../World.bs"
import "Torch.bs"

' A checkpoint: a ring of stones with a sword stuck in the middle (bonfire.obj, from
' tools/make-props.py) and a big Torch flame with its warm light. The scene makes it something
' to rest at (ThirdPersonScene.addBonfires()).
class Bonfire extends BGE.GameEntity

  bonfireId as string = ""
  flame as Torch = invalid

  sub new(game as BGE.Game)
    super(game)
    m.name = "Bonfire"
  end sub

  ' args: x, z, id (a Bonfires id). Needs the "bonfire" model loaded.
  override sub onCreate(args as roAssociativeArray)
    m.bonfireId = args.id
    m.isStatic = true
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    model = new BGE.DrawableModel(m, m.game.get3dModel("bonfire"), {})
    model.scale = BGE.Math.createScaleVector(World.UNITS_PER_METRE)
    m.addDrawable("model", model)
    flame = new Torch(m.game)
    m.game.addEntity(flame, {x: args.x, y: World.metres(0.05), z: args.z, kind: FlameKind.fire, size: 1.7})
    ' dimmer than a torch's: it's at knee height, and the knight stands right beside it
    flame.light.intensity = 0.9
    flame.light.range = World.metres(9)
    m.flame = flame
  end sub

end class
