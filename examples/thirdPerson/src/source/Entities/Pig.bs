import "Townsfolk.bs"

' A pig in its pen: stands about, and now and then ambles to another spot in the pen.
class Pig extends Townsfolk

  speed as float = World.metres(0.6)

  ' The pen's inside, in world x/z
  private minX as float
  private maxX as float
  private minZ as float
  private maxZ as float
  private target as BGE.Math.Vector
  private waitSeconds as float = 0
  private walking as boolean = false

  sub new(game as BGE.Game)
    super(game)
    m.name = "Pig"
  end sub

  ' args: as Townsfolk, plus minX, maxX, minZ, maxZ (the pen's inside)
  override sub onCreate(args as roAssociativeArray)
    super.onCreate(args)
    m.minX = args.minX
    m.maxX = args.maxX
    m.minZ = args.minZ
    m.maxZ = args.maxZ
    m.waitSeconds = 1 + Rnd(0) * 4
  end sub

  override sub onUpdate(dt as float)
    if not m.walking
      m.waitSeconds -= dt
      if m.waitSeconds <= 0 and m.type.walk.Count() > 0
        m.target = BGE.Math.VectorOps.create(m.minX + Rnd(0) * (m.maxX - m.minX), 0, m.minZ + Rnd(0) * (m.maxZ - m.minZ))
        m.walking = true
        m.sprite.playOrientedAnimation("walk")
        return
      end if
      ' Standing: idles only near the camera, like the townsfolk
      super.onUpdate(dt)
      return
    end if
    toTarget = BGE.Math.VectorOps.subtract(m.target, m.position)
    toTarget.y = 0
    distance = BGE.Math.VectorOps.length(toTarget)
    if distance < World.metres(0.2)
      m.walking = false
      m.waitSeconds = 2 + Rnd(0) * 6
      m.idling = false
      m.checkIn = 0
      m.sprite.playOrientedAnimation("still")
      return
    end if
    m.rotation.y = BGE.Math.turnToward(m.rotation.y, BGE.Math.headingOf(toTarget), 3 * dt)
    stride = BGE.Math.Min(distance, m.speed * dt)
    forward = BGE.Math.headingForward(m.rotation.y)
    ' Kept inside the pen whatever the turn does
    m.position.x = BGE.Math.Clamp(m.position.x + forward.x * stride, m.minX, m.maxX)
    m.position.z = BGE.Math.Clamp(m.position.z + forward.z * stride, m.minZ, m.maxZ)
  end sub

end class
