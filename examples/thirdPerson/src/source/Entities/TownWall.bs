import "../World.bs"

' The town's stone wall, as seen from inside: its straight runs as one set of level walls (the
' knight never gets outside, so the wall models' far sides and tops would only cost draw time),
' with a camera blocker along each run. Level walls cost what they cover on screen, where a
' textured wall drawable per run redrew each run whole every frame the camera moved.
class TownWall extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "TownWall"
  end sub

  ' args: sides (an array of [from, to] pairs of BGE.Math.Vector, each run's ends on the ground,
  ' axis-aligned), height, region (the stone texture)
  override sub onCreate(args as roAssociativeArray)
    m.isStatic = true
    m.position = BGE.Math.VectorOps.create(0, 0, 0)
    segments = [] as BGE.WallSegment[]
    thickness = World.metres(1)
    index = 0
    for each side in args.sides
      from = side[0] as BGE.Math.Vector
      target = side[1] as BGE.Math.Vector
      segments.push(BGE.createWallSegment(from, target, 0, args.height, "stone", {
        tileWidth: World.metres(4),
        tileHeight: World.metres(4),
        twoSided: true
      }))
      body = m.addBoxCollider3d(`body${index}`, Abs(target.x - from.x) + thickness, args.height, Abs(target.z - from.z) + thickness, (from.x + target.x) / 2, args.height / 2, (from.z + target.z) / 2)
      body.memberFlags = World.CAMERA_BLOCKER
      index++
    end for
    m.addDrawable("walls", new BGE.DrawableWalls(m, segments, {stone: args.region}, {}))
  end sub

end class
