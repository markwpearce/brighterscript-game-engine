import "../World.bs"

' A straight run of the town's stone wall, as seen from inside: one tall textured wall (the knight
' never gets outside, so the wall models' far sides and tops would only cost draw time), and a
' camera blocker along it.
class TownWall extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "TownWall"
  end sub

  ' args: from, to (BGE.Math.Vector, its ends on the ground, axis-aligned), height, region (the
  ' stone texture)
  override sub onCreate(args as roAssociativeArray)
    m.isStatic = true
    from = args.from as BGE.Math.Vector
    target = args.to as BGE.Math.Vector
    m.position = BGE.Math.VectorOps.create((from.x + target.x) / 2, 0, (from.z + target.z) / 2)
    start = BGE.Math.VectorOps.subtract(from, m.position)
    finish = BGE.Math.VectorOps.subtract(target, m.position)
    m.addDrawable("wall", new BGE.DrawableWall(m, args.region, start, finish, 0, args.height, {
      tileWidth: World.metres(4),
      tileHeight: World.metres(4)
    }))
    thickness = World.metres(1)
    body = m.addBoxCollider3d("body", Abs(finish.x - start.x) + thickness, args.height, Abs(finish.z - start.z) + thickness, 0, args.height / 2, 0)
    body.memberFlags = World.CAMERA_BLOCKER
  end sub

end class
