import "../World.bs"
import "Enemy.bs"

' The enemies the field spawns. Cell sizes and anchors are what tools/prepare-sheet.js printed.
namespace EnemyTypes

  ' Sword and shield. Works round to your side before swinging, and sometimes blocks.
  function skeleton() as EnemyType
    return {
      name: "Skeleton",
      bitmap: "skeleton",
      cellWidth: 128,
      cellHeight: 90,
      anchorX: 0.551,
      anchorY: 0.678,
      height: World.metres(2.1),
      maxHealth: 90,
      bodyRadius: World.metres(0.4),
      mass: 1.5,
      speed: World.metres(3),
      turnSpeed: 6,
      approach: EnemyApproach.flank,
      afterAttack: EnemyAfterAttack.stay,
      retreatSeconds: 0,
      waitDistance: World.metres(4),
      blockChance: 0.35,
      flinchSeconds: 0.35,
      staggerSeconds: 1.5,
      attack: {
        range: World.metres(1.4),
        reach: World.metres(1.7),
        arcDegrees: 60,
        windupSeconds: 0.7,
        strikeSeconds: 0.25,
        recoverSeconds: 0.8,
        damage: 20,
        lunge: World.metres(0.6)
      }
    }
  end function

  ' Slow and tough, hits hard after a long wind-up, and comes straight at you.
  function orc() as EnemyType
    return {
      name: "Orc",
      bitmap: "orc",
      cellWidth: 86,
      cellHeight: 86,
      anchorX: 0.573,
      anchorY: 0.629,
      height: World.metres(2.1),
      maxHealth: 160,
      bodyRadius: World.metres(0.5),
      mass: 3,
      speed: World.metres(2.2),
      turnSpeed: 3,
      approach: EnemyApproach.direct,
      afterAttack: EnemyAfterAttack.stay,
      retreatSeconds: 0,
      waitDistance: World.metres(5),
      blockChance: 0,
      ' Shrugs off most hits
      flinchSeconds: 0.1,
      staggerSeconds: 2,
      attack: {
        range: World.metres(1.5),
        reach: World.metres(1.9),
        arcDegrees: 75,
        windupSeconds: 1.1,
        strikeSeconds: 0.3,
        recoverSeconds: 1.2,
        damage: 35,
        lunge: World.metres(0.4)
      }
    }
  end function

  ' Fast and fragile: leaps in from a distance, bites, then backs off.
  function spider() as EnemyType
    return {
      name: "Spider",
      bitmap: "spider",
      cellWidth: 90,
      cellHeight: 87,
      anchorX: 0.52,
      anchorY: 0.74,
      height: World.metres(1.2),
      maxHealth: 45,
      bodyRadius: World.metres(0.45),
      mass: 0.6,
      speed: World.metres(5.5),
      turnSpeed: 10,
      approach: EnemyApproach.direct,
      afterAttack: EnemyAfterAttack.retreat,
      retreatSeconds: 1.2,
      waitDistance: World.metres(6),
      blockChance: 0,
      flinchSeconds: 0.4,
      staggerSeconds: 1.5,
      attack: {
        range: World.metres(4.5),
        reach: World.metres(1),
        arcDegrees: 45,
        windupSeconds: 0.5,
        strikeSeconds: 0.35,
        recoverSeconds: 0.5,
        damage: 12,
        lunge: World.metres(4)
      }
    }
  end function

  function all() as EnemyType[]
    return [EnemyTypes.skeleton(), EnemyTypes.orc(), EnemyTypes.spider()]
  end function

end namespace
