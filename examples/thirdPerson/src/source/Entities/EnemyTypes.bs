import "../World.bs"
import "Enemy.bs"

' The enemies the field spawns. Anchors and frame columns are what
' tools/render-character.py printed.
namespace EnemyTypes

  ' Sword and shield. Works round to your side before swinging, and sometimes blocks.
  function skeleton() as EnemyType
    return {
      name: "Skeleton",
      atlas: "skeleton",
      anchorX: 0.5,
      anchorY: 0.865,
      framesPerDirection: 26,
      frames: {
        idle: [0, 1, 2, 3],
        run: [4, 5, 6, 7, 8, 9, 10, 11],
        windup: [12, 13, 14, 15],
        strike: [16, 17, 18, 19],
        guard: [20],
        hit: [21],
        die: [22, 23, 24, 25]
      },
      height: World.metres(1.85),
      bloodColor: &hD8D0B8,
      maxHealth: 90,
      bodyRadius: World.metres(0.4),
      mass: 1.2,
      speed: World.metres(2.6),
      turnSpeed: 6,
      approach: EnemyApproach.flank,
      afterAttack: EnemyAfterAttack.stay,
      retreatSeconds: 0,
      waitDistance: World.metres(4),
      blockChance: 0.35,
      flinchSeconds: 0.4,
      backOffSeconds: 0.6,
      staggerSeconds: 1.5,
      attack: {
        range: World.metres(1.4),
        reach: World.metres(1.7),
        arcDegrees: 60,
        windupSeconds: 0.7,
        strikeSeconds: 0.25,
        recoverSeconds: 0.8,
        damage: 20,
        lunge: World.metres(0.6)
      }
    }
  end function

  ' Hand axe, no armour. Quick to close in, chops, then backs off to try again.
  function orc() as EnemyType
    return {
      name: "Orc",
      atlas: "orc",
      anchorX: 0.467,
      anchorY: 0.89,
      framesPerDirection: 25,
      frames: {
        idle: [0, 1, 2, 3],
        run: [4, 5, 6, 7, 8, 9, 10, 11],
        windup: [12, 13, 14, 15],
        strike: [16, 17, 18, 19],
        ' Never blocks
        guard: [20],
        hit: [20],
        die: [21, 22, 23, 24]
      },
      height: World.metres(1.85),
      bloodColor: &h7A0E0E,
      maxHealth: 110,
      bodyRadius: World.metres(0.45),
      mass: 1.5,
      speed: World.metres(3),
      turnSpeed: 7,
      approach: EnemyApproach.direct,
      afterAttack: EnemyAfterAttack.retreat,
      retreatSeconds: 0.8,
      waitDistance: World.metres(5),
      blockChance: 0,
      flinchSeconds: 0.4,
      backOffSeconds: 0.5,
      staggerSeconds: 1.5,
      attack: {
        range: World.metres(1.4),
        reach: World.metres(1.6),
        arcDegrees: 60,
        windupSeconds: 0.55,
        strikeSeconds: 0.25,
        recoverSeconds: 0.6,
        damage: 18,
        lunge: World.metres(0.8)
      }
    }
  end function

  ' Armour, shield and a bigger axe. Slow, shrugs off hits, blocks often and hits hard after
  ' a long wind-up: parry it, or hit it while it recovers.
  function heavyOrc() as EnemyType
    return {
      name: "Heavy Orc",
      atlas: "orc_heavy",
      anchorX: 0.5,
      anchorY: 0.871,
      framesPerDirection: 22,
      frames: {
        idle: [0, 1],
        run: [2, 3, 4, 5, 6, 7, 8, 9],
        windup: [10, 11, 12, 13],
        strike: [14, 15, 16, 17],
        guard: [18],
        hit: [19],
        die: [19, 20, 21]
      },
      height: World.metres(2),
      bloodColor: &h7A0E0E,
      maxHealth: 200,
      bodyRadius: World.metres(0.55),
      mass: 3,
      speed: World.metres(2.1),
      turnSpeed: 3,
      approach: EnemyApproach.direct,
      afterAttack: EnemyAfterAttack.stay,
      retreatSeconds: 0,
      waitDistance: World.metres(5),
      blockChance: 0.5,
      ' Shrugs off hits
      flinchSeconds: 0,
      backOffSeconds: 0,
      staggerSeconds: 2,
      attack: {
        range: World.metres(1.6),
        reach: World.metres(2),
        arcDegrees: 50,
        windupSeconds: 1.1,
        strikeSeconds: 0.3,
        recoverSeconds: 1.2,
        damage: 40,
        lunge: World.metres(0.4)
      }
    }
  end function

  function all() as EnemyType[]
    return [EnemyTypes.skeleton(), EnemyTypes.orc(), EnemyTypes.heavyOrc()]
  end function

end namespace
