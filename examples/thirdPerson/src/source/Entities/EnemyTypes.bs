    hobgoblin = EnemyTypes.goblin()
    hobgoblin.name = "Hobgoblin"
    ' TODO(#754): hobgoblin.voice = "bite" (from the goblin), once EnemyType has voices
    hobgoblin.coins = 30
    hobgoblin.atlas = "hobgoblin"
    hobgoblin.anchorX = 0.494
    hobgoblin.anchorY = 0.875
    hobgoblin.height = World.metres(1.6)
    hobgoblin.bloodColor = &h7A0E0E
    hobgoblin.maxHealth = 95
    hobgoblin.bodyRadius = World.metres(0.38)
    hobgoblin.mass = 1.1
    hobgoblin.speed = World.metres(3.1)
    hobgoblin.turnSpeed = 7
    hobgoblin.approach = EnemyApproach.direct
    hobgoblin.afterAttack = EnemyAfterAttack.stay
    hobgoblin.retreatSeconds = 0
    hobgoblin.blockChance = 0.15
    hobgoblin.flinchSeconds = 0.35
    hobgoblin.backOffSeconds = 0.5
    hobgoblin.staggerSeconds = 1.5
    hobgoblin.comboChance = 0.6
    hobgoblin.attack = {
      range: World.metres(1.2),
      reach: World.metres(1.4),
      arcDegrees: 50,
      windupSeconds: 0.5,
      strikeSeconds: 0.2,
      recoverSeconds: 0.7,
      damage: 15,
      lunge: World.metres(0.5)
    }
    return hobgoblin
  end function

  ' The forest's elite: fast, a long reach and a huge leaping swipe; hard to stagger and
  ' rarely flinches. Unarmed and symmetric enough to draw its left side mirrored.
  function werewolf() as EnemyType
    ' TODO(#754): voice: "beast", once EnemyType has voices
    return {
      name: "Werewolf",
      coins: 120,
      atlas: "werewolf",
      anchorX: 0.455,
      anchorY: 0.892,
      framesPerDirection: 29,
      mirrored: true,
      frames: {
        idle: [0, 1, 2, 3],
        run: [4, 5, 6, 7, 8, 9, 10, 11],
        windup: [12, 13, 14, 15, 16, 17, 18, 19],
        strike: [20, 21, 22, 23],
        ' Never blocks
        guard: [24],
        hit: [24],
        die: [25, 26, 27, 28]
      },
      height: World.metres(1.9),
      bloodColor: &h6A0A0A,
      maxHealth: 240,
      bodyRadius: World.metres(0.5),
      mass: 2.5,
      speed: World.metres(4.2),
      turnSpeed: 8,
      approach: EnemyApproach.flank,
      afterAttack: EnemyAfterAttack.retreat,
      retreatSeconds: 1,
      waitDistance: World.metres(6),
      blockChance: 0,
      flinchSeconds: 0.15,
      backOffSeconds: 0.3,
      ' A parry barely rocks it
      staggerSeconds: 0.8,
      attack: {
        range: World.metres(2.6),
        reach: World.metres(2.4),
        arcDegrees: 70,
        windupSeconds: 0.65,
        strikeSeconds: 0.3,
        recoverSeconds: 0.9,
        damage: 32,
        lunge: World.metres(2)
      }
    }
  end function

  function all() as EnemyType[]
    return [EnemyTypes.skeleton(), EnemyTypes.orc(), EnemyTypes.heavyOrc()]
  end function

  ' The kinds `names` lists (skeleton, orc, heavyOrc, ghoul, graveBrute, goblin, hobgoblin,
  ' werewolf, orcChieftain; any case), skipping any it doesn't know
  function named(names as string[]) as EnemyType[]
    makers = {
      skeleton: EnemyTypes.skeleton,
      orc: EnemyTypes.orc,
      heavyOrc: EnemyTypes.heavyOrc,
      ghoul: EnemyTypes.ghoul,
      graveBrute: EnemyTypes.graveBrute,
      goblin: EnemyTypes.goblin,
      hobgoblin: EnemyTypes.hobgoblin,
      werewolf: EnemyTypes.werewolf,
      orcChieftain: EnemyTypes.orcChieftain
    }
    kinds = [] as EnemyType[]
    for each name in names
      if invalid <> makers[name]
        maker = makers[name]
        kinds.push(maker())
      end if
    end for
    return kinds
  end function

end namespace
