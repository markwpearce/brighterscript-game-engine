import "../World.bs"
import "Enemy.bs"

' The enemies the field spawns. Anchors and frame columns are what
' tools/render-character.py printed.
namespace EnemyTypes

  ' Sword and shield. Works round to your side before swinging, and sometimes blocks.
  function skeleton() as EnemyType
    return {
      name: "Skeleton",
      atlas: "skeleton",
      anchorX: 0.5,
      anchorY: 0.865,
      framesPerDirection: 30,
      frames: {
        idle: [0, 1, 2, 3],
        run: [4, 5, 6, 7, 8, 9, 10, 11],
        windup: [12, 13, 14, 15, 16, 17, 18, 19],
        strike: [20, 21, 22, 23],
        guard: [24],
        hit: [25],
        die: [26, 27, 28, 29]
      },
      height: World.metres(1.85),
      bloodColor: &hD8D0B8,
      maxHealth: 90,
      bodyRadius: World.metres(0.4),
      mass: 1.2,
      speed: World.metres(2.6),
      turnSpeed: 6,
      approach: EnemyApproach.flank,
      afterAttack: EnemyAfterAttack.stay,
      retreatSeconds: 0,
      waitDistance: World.metres(4),
      blockChance: 0.35,
      flinchSeconds: 0.4,
      backOffSeconds: 0.6,
      staggerSeconds: 1.5,
      attack: {
        range: World.metres(1.4),
        reach: World.metres(1.7),
        arcDegrees: 60,
        windupSeconds: 0.7,
        strikeSeconds: 0.25,
        recoverSeconds: 0.8,
        damage: 20,
        lunge: World.metres(0.6)
      }
    }
  end function

  ' Hand axe, no armour. Quick to close in, chops, then backs off to try again.
  function orc() as EnemyType
    return {
      name: "Orc",
      atlas: "orc",
      anchorX: 0.5,
      anchorY: 0.892,
      framesPerDirection: 29,
      frames: {
        idle: [0, 1, 2, 3],
        run: [4, 5, 6, 7, 8, 9, 10, 11],
        windup: [12, 13, 14, 15, 16, 17, 18, 19],
        strike: [20, 21, 22, 23],
        ' Never blocks
        guard: [24],
        hit: [24],
        die: [25, 26, 27, 28]
      },
      height: World.metres(1.85),
      bloodColor: &h7A0E0E,
      maxHealth: 110,
      bodyRadius: World.metres(0.45),
      mass: 1.5,
      speed: World.metres(3),
      turnSpeed: 7,
      approach: EnemyApproach.direct,
      afterAttack: EnemyAfterAttack.retreat,
      retreatSeconds: 0.8,
      waitDistance: World.metres(5),
      blockChance: 0,
      flinchSeconds: 0.4,
      backOffSeconds: 0.5,
      staggerSeconds: 1.5,
      attack: {
        range: World.metres(1.4),
        reach: World.metres(1.6),
        arcDegrees: 60,
        windupSeconds: 0.55,
        strikeSeconds: 0.25,
        recoverSeconds: 0.6,
        damage: 18,
        lunge: World.metres(0.8)
      }
    }
  end function

  ' Armour, shield and a bigger axe. Slow, shrugs off hits, blocks often and hits hard after
  ' a long wind-up: parry it, or hit it while it recovers.
  function heavyOrc() as EnemyType
    return {
      name: "Heavy Orc",
      atlas: "orc_heavy",
      anchorX: 0.5,
      anchorY: 0.871,
      framesPerDirection: 26,
      frames: {
        idle: [0, 1],
        run: [2, 3, 4, 5, 6, 7, 8, 9],
        windup: [10, 11, 12, 13, 14, 15, 16, 17],
        strike: [18, 19, 20, 21],
        guard: [22],
        hit: [23],
        die: [23, 24, 25]
      },
      height: World.metres(2),
      bloodColor: &h7A0E0E,
      maxHealth: 200,
      bodyRadius: World.metres(0.55),
      mass: 3,
      speed: World.metres(2.1),
      turnSpeed: 3,
      approach: EnemyApproach.direct,
      afterAttack: EnemyAfterAttack.stay,
      retreatSeconds: 0,
      waitDistance: World.metres(5),
      blockChance: 0.5,
      ' Shrugs off hits
      flinchSeconds: 0,
      backOffSeconds: 0,
      staggerSeconds: 2,
      attack: {
        range: World.metres(1.6),
        reach: World.metres(2),
        arcDegrees: 50,
        windupSeconds: 1.1,
        strikeSeconds: 0.3,
        recoverSeconds: 1.2,
        damage: 40,
        lunge: World.metres(0.4)
      }
    }
  end function

  ' The crypt's guardian: a skeleton half again as big, pale with grave-cold. Never flinches,
  ' reaches far, and often follows a swing with a quicker second one, so dodge twice or block
  ' the second. Bait the first, roll, then hit it while it recovers.
  function cryptWarden() as EnemyType
    warden = EnemyTypes.skeleton()
    warden.name = "Crypt Warden"
    warden.scale = 1.45
    warden.tint = &hB8CCF0
    warden.glow = 0.3
    warden.height = World.metres(2.7)
    warden.maxHealth = 210 ' 7 knight hits
    warden.bodyRadius = World.metres(0.6)
    warden.mass = 4
    warden.speed = World.metres(2.3)
    warden.turnSpeed = 3.5
    warden.approach = EnemyApproach.direct
    warden.afterAttack = EnemyAfterAttack.stay
    warden.waitDistance = World.metres(5)
    warden.blockChance = 0.2
    warden.flinchSeconds = 0
    warden.backOffSeconds = 0
    warden.staggerSeconds = 2
    warden.comboChance = 0.5
    warden.attack = {
      range: World.metres(2),
      reach: World.metres(2.6),
      arcDegrees: 70,
      windupSeconds: 0.95,
      strikeSeconds: 0.3,
      recoverSeconds: 1.1,
      damage: 34,
      lunge: World.metres(1.2)
    }
    return warden
  end function

  ' A tomb robber the crypt kept: the orc, grey and pale. Quicker and frailer than one, and comes
  ' at you in a rush.
  function ghoul() as EnemyType
    ghoul = EnemyTypes.orc()
    ghoul.name = "Ghoul"
    ghoul.tint = &hA8B4B0
    ghoul.glow = 0.2
    ghoul.bloodColor = &h3A4A30
    ghoul.maxHealth = 80
    ghoul.speed = World.metres(3.4)
    ghoul.retreatSeconds = 0.6
    ghoul.attack.windupSeconds = 0.45
    ghoul.attack.damage = 14
    return ghoul
  end function

  ' The heavy orc gone grey in the dark: as slow and tough, and it hits as hard.
  function graveBrute() as EnemyType
    brute = EnemyTypes.heavyOrc()
    brute.name = "Grave Brute"
    brute.tint = &hA0A8B0
    brute.glow = 0.2
    brute.bloodColor = &h3A4A30
    return brute
  end function

  ' The last tomb's lord: the heavy orc half again as big, bronze-dark, with a slow, crushing
  ' swing that often comes twice. Blocks often; hit it as it recovers.
  function barrowKing() as EnemyType
    king = EnemyTypes.heavyOrc()
    king.name = "The Barrow King"
    king.scale = 1.5
    king.tint = &hD0B090
    king.glow = 0.3
    king.bloodColor = &h3A4A30
    king.height = World.metres(3)
    king.maxHealth = 520
    king.bodyRadius = World.metres(0.75)
    king.mass = 6
    king.speed = World.metres(2.2)
    king.blockChance = 0.4
    king.staggerSeconds = 2.2
    king.comboChance = 0.4
    king.attack = {
      range: World.metres(2.2),
      reach: World.metres(2.9),
      arcDegrees: 80,
      windupSeconds: 1.15,
      strikeSeconds: 0.35,
      recoverSeconds: 1.3,
      damage: 45,
      lunge: World.metres(0.8)
    }
    return king
  end function

  function all() as EnemyType[]
    return [EnemyTypes.skeleton(), EnemyTypes.orc(), EnemyTypes.heavyOrc()]
  end function

end namespace
