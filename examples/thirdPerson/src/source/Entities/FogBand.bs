import "../World.bs"

' One layer of night mist: a wide, see-through gradient that stands on the ground a fixed
' distance in front of the camera and follows it. Everything farther away is drawn first, so
' it ends up behind the band; a few bands at rising distances thicken the mist with distance
' and hide where the ground and fading objects end.
class FogBand extends BGE.GameEntity

  ' World units in front of the camera
  distance as float = 0.0

  sub new(game as BGE.Game)
    super(game)
    m.name = "FogBand"
  end sub

  ' args: distance, height (world units), region (the gradient, see FogBand.makeGradient())
  override sub onCreate(args as roAssociativeArray)
    m.distance = args.distance
    region = args.region as roRegion
    image = m.addImage("mist", region, {
      drawMode: BGE.SceneObjectDrawMode.axisAligned,
      fadesWithDistance: false
    })
    image.setAnchor(0.5, 1)
    ' Wider than a 90 degree view at its distance, so turning never shows an edge
    width = m.distance * 2.6
    image.scale = BGE.Math.createScaleVector(width / region.GetWidth(), args.height / region.GetHeight())
    m.follow()
  end sub

  override sub onDrawBegin(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    m.follow()
  end sub

  ' On the ground straight ahead of the camera. Run before drawing, after the camera has
  ' moved this frame, so the band never lags it.
  private sub follow()
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    forward = camera.orientation
    flat = Sqr(forward.x * forward.x + forward.z * forward.z)
    if flat < 0.001
      return
    end if
    ' Sunk a little, so the ground's far edge is covered too
    m.position = BGE.Math.VectorOps.create(camera.position.x + forward.x / flat * m.distance, -World.metres(1), camera.position.z + forward.z / flat * m.distance)
    m.updateTransformationMatrix()
  end sub

end class

' How the mist is laid out: bands at `distances` (metres), each `height` metres tall and
' `rgb` at `alpha` (0-255) at its thickest
interface FogStyle
  distances as float[]
  height as float
  rgb as integer
  alpha as integer
end interface

namespace FogBands

  ' The look `name` picks, for the `fog=<name>` deep link: "bands" (the default), "edge",
  ' "thick", "low" or "dark"
  function style(name as string) as FogStyle
    if name = "edge"
      ' One dense band at the draw distance: only hides where things end
      return {distances: [30], height: 14, rgb: &h1C2842, alpha: 230}
    else if name = "thick"
      ' Many thin layers from close in: mist that builds steadily with distance
      return {distances: [8, 12, 16, 20, 24, 28, 31], height: 10, rgb: &h1C2842, alpha: 55}
    else if name = "low"
      ' Ground mist: short bands that roofs and towers rise out of
      return {distances: [10, 15, 20, 25, 30], height: 3.5, rgb: &h2A3858, alpha: 110}
    else if name = "dark"
      ' Fades into darkness rather than mist
      return {distances: [14, 20, 26, 31], height: 12, rgb: &h060A18, alpha: 110}
    end if
    return {distances: [14, 20, 26, 31], height: 10, rgb: &h1C2842, alpha: 80}
  end function

  ' A gradient for FogBand: `rgb` at `alpha` (0-255) in its lower half, thinning to clear at
  ' the top
  function makeGradient(rgb as integer, alpha as integer) as roRegion
    height = 64
    bmp = CreateObject("roBitmap", {width: 4, height: height, AlphaEnable: false})
    for row = 0 to height - 1
      ' 0 at the top, 1 from halfway down
      solid = BGE.Math.Min(1.0, row / (height * 0.5))
      bmp.DrawRect(0, row, 4, 1, (rgb << 8) + Int(alpha * solid * solid))
    end for
    bmp.Finish()
    return CreateObject("roRegion", bmp, 0, 0, 4, height)
  end function

end namespace
