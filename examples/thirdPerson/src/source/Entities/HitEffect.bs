import "../World.bs"

' What a burst of HitEffect particles looks like.
interface HitEffectStyle
  count as integer
  ' Rectangles (blood, dust) or lines (sparks, drawn along their velocity)
  shape as BGE.ParticleShape
  startColor as integer
  endColor as integer
  ' Pixels for rectangles, world units for lines
  startSize as float
  endSize as float
  lifetime as float
  ' Outward speed, and how much of it goes upward
  speed as float
  lift as float
  ' Radians either side of the spray direction
  spread as float
  gravity as float
end interface

namespace HitEffects

  ' Blood, or bone dust: whatever `color` a fighter bleeds.
  function blood(color as integer) as HitEffectStyle
    return {
      count: 18,
      shape: BGE.ParticleShape.Rectangle,
      startColor: color,
      endColor: color,
      startSize: 10,
      endSize: 3,
      lifetime: 0.5,
      speed: World.metres(3.5),
      lift: World.metres(2.5),
      spread: BGE.Math.PI * 0.35,
      gravity: World.metres(12)
    }
  end function

  ' Steel on steel: a few sparks for a blocked hit.
  function blockSparks() as HitEffectStyle
    return {
      count: 8,
      shape: BGE.ParticleShape.Line,
      startColor: &hFFF0C0,
      endColor: &hFF8020,
      startSize: World.metres(0.12),
      endSize: World.metres(0.04),
      lifetime: 0.25,
      speed: World.metres(5),
      lift: World.metres(2),
      spread: BGE.Math.PI * 0.5,
      gravity: World.metres(8)
    }
  end function

  ' A parry: a bigger, brighter shower than a block.
  function parrySparks() as HitEffectStyle
    return {
      count: 22,
      shape: BGE.ParticleShape.Line,
      startColor: &hFFFFFF,
      endColor: &hFFB030,
      startSize: World.metres(0.3),
      endSize: World.metres(0.05),
      lifetime: 0.4,
      speed: World.metres(7),
      lift: World.metres(3),
      spread: BGE.Math.PI * 0.8,
      gravity: World.metres(8)
    }
  end function

end namespace

' A one-off burst of particles where a blow lands, sprayed along a direction on the ground and
' falling back down. Removes itself once they've faded.
class HitEffect extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "HitEffect"
  end sub

  ' args: position, direction (unit vector on the ground), style (HitEffectStyle)
  override sub onCreate(args as roAssociativeArray)
    style = args.style
    m.position = args.position
    ' Particles start from the world position, which is otherwise only updated next frame
    m.updateTransformationMatrix()
    emitter = m.addParticles("burst", style.shape, {
      lifetime: style.lifetime,
      startColor: style.startColor,
      endColor: style.endColor,
      startAlpha: 255.0,
      endAlpha: 0.0,
      startSize: style.startSize,
      endSize: style.endSize,
      acceleration: BGE.Math.VectorOps.create(0, -style.gravity, 0),
      maxParticles: style.count
    })
    ' The emitter's own spread only fans out in x/y, so the particles are made here, fanned
    ' round the spray direction
    heading = BGE.Math.headingOf(args.direction)
    for i = 1 to style.count
      across = BGE.Math.headingForward(heading + (Rnd(0) * 2 - 1) * style.spread)
      speed = style.speed * (0.4 + Rnd(0) * 0.6)
      emitter.particles.push({
        position: BGE.Math.VectorOps.copy(m.position),
        velocity: BGE.Math.VectorOps.create(across.x * speed, style.lift * (0.3 + Rnd(0) * 0.7), across.z * speed),
        age: 0.0,
        lifetime: style.lifetime * (0.6 + Rnd(0) * 0.4),
        startColor: style.startColor,
        endColor: style.endColor,
        startAlpha: 255.0,
        endAlpha: 0.0,
        startSize: style.startSize,
        endSize: style.endSize,
        rotation: 0.0
      })
    end for
    m.invalidateAfter(Int(style.lifetime * 1000) + 100)
  end sub

end class
