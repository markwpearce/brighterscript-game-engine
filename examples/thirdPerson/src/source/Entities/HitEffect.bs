import "../World.bs"

' The particle bursts where blows land, played through FieldScene's BGE.ParticleBurstPool
' (CombatDirector.bursts). Each is sprayed in a cone away from the attacker and falls back down.
namespace HitEffects

  ' Blood, or bone dust: whatever `color` a fighter bleeds.
  function blood(color as integer) as BGE.ParticleBurstStyle
    return {
      shape: BGE.ParticleShape.Rectangle,
      count: 18,
      startColor: color,
      endColor: color,
      startSize: 10,
      endSize: 3,
      lifetime: 0.5 * 0.8,
      lifetimeSpread: 0.5 * 0.2,
      speed: World.metres(3.5) * 0.7,
      speedSpread: World.metres(3.5) * 0.3,
      lift: World.metres(2.5) * 0.65,
      liftSpread: World.metres(2.5) * 0.35,
      spreadRadians: BGE.Math.PI * 0.35,
      acceleration: BGE.Math.VectorOps.create(0, -World.metres(12), 0)
    }
  end function

  ' Steel on steel: a few sparks for a blocked hit.
  function blockSparks() as BGE.ParticleBurstStyle
    return {
      shape: BGE.ParticleShape.Line,
      count: 8,
      startColor: &hFFF0C0,
      endColor: &hFF8020,
      startSize: World.metres(0.12),
      endSize: World.metres(0.04),
      lifetime: 0.25 * 0.8,
      lifetimeSpread: 0.25 * 0.2,
      speed: World.metres(5) * 0.7,
      speedSpread: World.metres(5) * 0.3,
      lift: World.metres(2) * 0.65,
      liftSpread: World.metres(2) * 0.35,
      spreadRadians: BGE.Math.PI * 0.5,
      acceleration: BGE.Math.VectorOps.create(0, -World.metres(8), 0)
    }
  end function

  ' A parry: a bigger, brighter shower than a block.
  function parrySparks() as BGE.ParticleBurstStyle
    return {
      shape: BGE.ParticleShape.Line,
      count: 22,
      startColor: &hFFFFFF,
      endColor: &hFFB030,
      startSize: World.metres(0.3),
      endSize: World.metres(0.05),
      lifetime: 0.4 * 0.8,
      lifetimeSpread: 0.4 * 0.2,
      speed: World.metres(7) * 0.7,
      speedSpread: World.metres(7) * 0.3,
      lift: World.metres(3) * 0.65,
      liftSpread: World.metres(3) * 0.35,
      spreadRadians: BGE.Math.PI * 0.8,
      acceleration: BGE.Math.VectorOps.create(0, -World.metres(8), 0)
    }
  end function

end namespace
