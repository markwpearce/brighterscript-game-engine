import "../World.bs"

' A plain stone pillar for the camera to bump into, until the field has real buildings.
' Static, with a BoxCollider3d on the CAMERA_BLOCKER flag (see the camera boom in FieldScene).
class Pillar extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "Pillar"
  end sub

  ' args: x, z, width, height, style ("model" (default), "cull" or "rect")
  override sub onCreate(args as roAssociativeArray)
    m.isStatic = true
    width = args.width
    height = args.height
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    style = args.style
    if style = invalid
      style = "model"
    end if
    if style = "model"
      m.addDrawable("body", new BGE.DrawableModel(m, m.buildBoxModel(width, height)))
    else
      m.addSideRectangles(width, height, style = "rect")
    end if
    body = m.addBoxCollider3d("body", width, height, width, 0, height / 2, 0)
    body.memberFlags = World.CAMERA_BLOCKER
  end sub

  ' Four walls as one model: back faces are culled per face, and the impostor reuses the
  ' last drawing while the camera moves (rectangles redraw every frame it does).
  private function buildBoxModel(width as float, height as float) as BGE.Model3d
    up = BGE.Math.VectorOps.create(0, height, 0)
    faces = [] as BGE.Model3dFace[]
    for each normal in [BGE.Math.VectorOps.create(0, 0, 1), BGE.Math.VectorOps.create(1, 0, 0), BGE.Math.VectorOps.create(0, 0, -1), BGE.Math.VectorOps.create(-1, 0, 0)]
      ' Counter-clockwise seen from outside, so the winding agrees with the outward normal
      right = BGE.Math.VectorOps.scale(BGE.Math.VectorOps.crossProduct(BGE.Math.VectorOps.create(0, 1, 0), normal), width / 2)
      center = BGE.Math.VectorOps.scale(normal, width / 2)
      bottomLeft = BGE.Math.VectorOps.subtract(center, right)
      bottomRight = BGE.Math.VectorOps.add(center, right)
      topRight = BGE.Math.VectorOps.add(bottomRight, up)
      topLeft = BGE.Math.VectorOps.add(bottomLeft, up)
      for each corners in [[bottomLeft, bottomRight, topRight], [bottomLeft, topRight, topLeft]]
        face = BGE.Model3dFaceOps.create(corners, normal)
        face.color = &h8C8478FF
        faces.push(face)
      end for
    end for
    model = new BGE.Model3d(faces)
    model.name = "pillar"
    return model
  end function

  ' The first version: four rectangles, drawing back faces too unless `cull`
  private sub addSideRectangles(width as float, height as float, drawBackFaces as boolean)
    drawMode = BGE.SceneObjectDrawMode.oriented
    if drawBackFaces
      drawMode = BGE.SceneObjectDrawMode.orientedDrawBackFace
    end if
    ' Four sides; each is a vertical rectangle turned a quarter further round
    sides = [
      {x: 0, z: width / 2, turn: 0},
      {x: width / 2, z: 0, turn: BGE.Math.HALF_PI},
      {x: 0, z: -width / 2, turn: BGE.Math.PI},
      {x: -width / 2, z: 0, turn: -BGE.Math.HALF_PI}
    ]
    for i = 0 to sides.Count() - 1
      side = sides[i]
      face = m.addRectangle("side" + i.toStr(), width, height, {
        offset: BGE.Math.VectorOps.create(side.x, height / 2, side.z),
        rotation: BGE.Math.VectorOps.create(0, side.turn, 0),
        color: &h8C8478,
        isShaded: true,
        drawMode: drawMode
      })
      face.setAnchor(0.5, 0.5)
    end for
  end sub

end class
