import "../World.bs"
import "../CombatDirector.bs"
import "../Stamina.bs"
import "Fighter.bs"

enum KnightState
  idle = "idle"
  run = "run"
  attack = "attack"
  block = "block"
  parry = "parry"
  dodge = "dodge"
  hurt = "hurt"
  dead = "dead"
end enum

' The player: Flare's male hero knight, re-rendered from its Blender sources by
' tools/render-character.py (sprites/knight.json) and shown as a 16-direction oriented sprite. Moves
' relative to the camera and has light attacks (chained), a held block, a timed parry and a dodge,
' all paid for with stamina. Locked onto an enemy, he faces it (unless running away) and swings at it.
class Knight extends Fighter

  cameraRig as BGE.OrbitCamera = invalid
  state as KnightState = KnightState.idle
  ' True during the middle of a dodge
  invulnerable as boolean = false
  ' The enemy he's locked onto, or invalid
  lockTarget as Fighter = invalid
  ' Locks onto enemies this close, roughly where the camera looks
  lockRange as float = World.metres(15)
  lockHalfAngle as float = BGE.Math.PI * 0.4
  ' Drops the lock past this
  lockBreakRange as float = World.metres(20)
  ' Locked on, he only keeps facing the target while running within this of it
  lockRunHalfAngle as float = BGE.Math.PI * 0.25

  runSpeed as float = World.metres(3.5)
  blockWalkSpeed as float = World.metres(1.5)
  turnSpeed as float = 12 ' radians/sec
  ' Animation rates; the attack's frames fit attackSeconds, and the parry lasts as long as its 4 frames
  frameRate as float = 12
  runFrameRate as float = World.runFrameRate(World.metres(3.5))
  idleFrameRate as float = 5
  attackSeconds as float = 0.5833
  attackLunge as float = World.metres(0.6)
  parrySeconds as float = 4 / 12.0
  dodgeSeconds as float = 0.4
  dodgeDistance as float = World.metres(4)
  attackDamage as float = 30
  attackReach as float = World.metres(1.6)
  ' Either side of where he faces
  attackHalfAngle as float = BGE.Math.PI * 0.4
  ' Fraction of a hit the shield lets through
  blockLeak as float = 0.2
  hurtSeconds as float = 0.35

  stamina as Stamina = new Stamina()
  attackStamina as float = 22
  dodgeStamina as float = 28
  parryStamina as float = 15
  ' Stamina a blocked hit costs, per point of the hit's damage
  blockStaminaPerDamage as float = 1.5
  ' Stunned this long when a block runs out of stamina
  guardBreakSeconds as float = 0.9

  private stateSeconds as float = 0
  private attackQueued as boolean = false
  private attackLanded as boolean = false
  private dodgeDirection as BGE.Math.Vector = BGE.Math.VectorOps.create()
  private hurtForSeconds as float = 0
  ' The look stick has been centred since the last target switch
  private switchReady as boolean = true

  sub new(game as BGE.Game)
    super(game)
    m.name = "Knight"
    ' 23 frames per direction: idle 0-3, run 4-11, attack 12-20, block 21-22.
    m.framesPerDirection = 23
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position = BGE.Math.VectorOps.create(args.x ?? 0, 0, args.z ?? 0)
    m.rotation = BGE.Math.VectorOps.create(0, args.heading ?? 0, 0)
    m.director = args.director
    m.director.setPlayer(m)

    m.sprite = m.addOrientedSprite("body", m.game.getSpriteAtlasFrames("knight"), 0, 0, m.numDirections, 1, {
      drawMode: BGE.SceneObjectDrawMode.axisAligned
    })
    ' Stands upright and foreshortens as the camera looks down; full height at the 12
    ' degrees render-character.py renders from
    m.sprite.axisAlignedFullHeightPitch = 12
    ' Anchor at the feet, as printed by render-character.py. He's rendered 64 px tall, which
    ' is already 2 m at 32 units per metre.
    m.sprite.setAnchor(0.5, 0.896)

    m.sprite.addOrientedAnimationColumns("idle", [0, 1, 2, 3], m.framesPerDirection, m.idleFrameRate, BGE.SpritePlayMode.PingPong)
    m.sprite.addOrientedAnimationColumns("run", [4, 5, 6, 7, 8, 9, 10, 11], m.framesPerDirection, m.runFrameRate)
    m.sprite.addOrientedAnimationColumns("attack", [12, 13, 14, 15, 16, 17, 18, 19, 20], m.framesPerDirection, BGE.frameRateFor(9, m.attackSeconds), BGE.SpritePlayMode.Forward)
    m.sprite.addOrientedAnimationColumns("block", [22], m.framesPerDirection, m.frameRate)
    m.sprite.addOrientedAnimationColumns("parry", [21, 22, 22, 21], m.framesPerDirection, m.frameRate, BGE.SpritePlayMode.Forward)
    m.sprite.addOrientedAnimationColumns("roll", [4, 5, 6, 7, 8, 9, 10, 11], m.framesPerDirection, m.frameRate)
    m.sprite.addOrientedAnimationColumns("backstep", [11, 10, 9, 8, 7, 6, 5, 4], m.framesPerDirection, m.frameRate)
    ' There's no hit or death art, so these hold a frame and the colour does the rest
    m.sprite.addOrientedAnimationColumns("hurt", [21], m.framesPerDirection, m.frameRate)
    m.sprite.addOrientedAnimationColumns("dead", [22], m.framesPerDirection, m.frameRate)
    m.sprite.playOrientedAnimation("idle")
  end sub

  override sub onUpdate(dt as float)
    controls = m.game.controls
    m.stateSeconds += dt
    move = m.cameraRelativeMove()
    m.updateLockOn()

    if m.state = KnightState.dead
      ' Waits for the scene to respawn him
    else if m.state = KnightState.hurt
      if m.stateSeconds >= m.hurtForSeconds
        m.setState(KnightState.idle)
      end if
    else if m.state = KnightState.attack
      m.updateAttack(dt, controls.isActionPressed("attack"))
    else if m.state = KnightState.parry
      if m.stateSeconds >= m.parrySeconds
        m.setState(KnightState.idle)
      end if
    else if m.state = KnightState.dodge
      m.updateDodge(dt)
    else if controls.isActionPressed("dodge") and m.stamina.spend(m.dodgeStamina)
      m.startDodge(move)
    else if controls.isActionPressed("attack") and m.stamina.spend(m.attackStamina)
      m.startAttack(move)
    else if controls.isActionPressed("parry") and m.stamina.spend(m.parryStamina)
      m.setState(KnightState.parry)
    else if controls.isActionHeld("block")
      m.setState(KnightState.block)
      ' Walk slowly behind the shield without turning, unless locked on
      m.faceLockTarget(dt)
      m.moveBy(move, m.blockWalkSpeed * dt)
    else if BGE.Math.VectorOps.length(move) > 0.25
      ' Always full speed: there's only a run animation, so slower would slide the feet
      direction = BGE.Math.VectorOps.scale(move, 1 / BGE.Math.VectorOps.length(move))
      m.setState(KnightState.run)
      ' Locked on, he keeps facing the target while running roughly toward it. Running away or
      ' sideways turns him to run that way: there's no strafe or backpedal animation.
      if not (m.isRunningAtLockTarget(direction) and m.faceLockTarget(dt))
        m.rotation.y = BGE.Math.turnToward(m.rotation.y, BGE.Math.headingOf(direction), m.turnSpeed * dt)
      end if
      m.moveBy(direction, m.runSpeed * dt)
    else
      m.setState(KnightState.idle)
      m.faceLockTarget(dt)
    end if

    ' Holding the shield up slows recovery
    m.stamina.update(dt, m.state = KnightState.block)
    m.updateCombatEffects(dt)
  end sub

  ' Lock-on presses, target switching with the look stick, and dropping a target that died or
  ' got away.
  private sub updateLockOn()
    controls = m.game.controls
    if invalid <> m.lockTarget and (not m.isAlive() or not m.lockTarget.isValid() or not m.lockTarget.isAlive() or m.distanceTo(m.lockTarget) > m.lockBreakRange)
      m.setLockTarget(invalid)
    end if
    if not m.isAlive() or invalid = m.director
      return
    end if
    if controls.isActionPressed("lockOn")
      if invalid <> m.lockTarget
        m.setLockTarget(invalid)
      else
        m.setLockTarget(m.director.lockOnCandidate(m, m.lockRange, m.lockHalfAngle))
        if invalid = m.lockTarget and invalid <> m.cameraRig
          ' Nothing to lock onto: a souls game recenters instead
          m.cameraRig.recenter()
        end if
      end if
    end if
    ' A flick of the look stick switches to the next enemy that way
    lookX = controls.getRawAxis("look").x
    if Abs(lookX) < 0.3
      m.switchReady = true
    else if Abs(lookX) > 0.7 and m.switchReady and invalid <> m.lockTarget
      m.switchReady = false
      side = 1
      if lookX < 0
        side = -1
      end if
      nextTarget = m.director.nextLockTarget(m, m.lockTarget, side, m.lockRange, m.lockHalfAngle)
      if invalid <> nextTarget
        m.setLockTarget(nextTarget)
      end if
    end if
  end sub

  ' Locks the knight and the camera onto `target`, or releases both with invalid.
  sub setLockTarget(target as Fighter)
    m.lockTarget = target
    if invalid = m.cameraRig
      return
    end if
    if invalid = target
      m.cameraRig.releaseLock()
    else
      m.cameraRig.lockOn(target)
    end if
  end sub

  ' Whether there's a lock target within lockRunHalfAngle of `direction`.
  private function isRunningAtLockTarget(direction as BGE.Math.Vector) as boolean
    if invalid = m.lockTarget
      return false
    end if
    toward = BGE.Math.headingOf(m.directionTo(m.lockTarget))
    return Abs(BGE.Math.wrapAngle(BGE.Math.headingOf(direction) - toward)) <= m.lockRunHalfAngle
  end function

  ' Turns toward the lock target, if there is one; returns whether there was.
  private function faceLockTarget(dt as float) as boolean
    if invalid = m.lockTarget
      return false
    end if
    m.rotation.y = BGE.Math.turnToward(m.rotation.y, BGE.Math.headingOf(m.directionTo(m.lockTarget)), m.turnSpeed * dt)
    return true
  end function

  ' Move stick turned into a world direction relative to the camera (length 0..1).
  private function cameraRelativeMove() as BGE.Math.Vector
    axis = m.game.controls.getAxis("move")
    heading = m.rotation.y
    if invalid <> m.cameraRig
      heading = m.cameraRig.heading
    end if
    return BGE.Math.cameraRelativeMove(axis, heading)
  end function

  ' `restart` re-enters the current state, e.g. to chain an attack.
  private sub setState(state as KnightState, restart = false as boolean)
    if m.state = state and not restart
      return
    end if
    m.state = state
    m.stateSeconds = 0
    m.invulnerable = false
    if state <> KnightState.dodge
      m.sprite.playOrientedAnimation(state, restart)
    end if
  end sub

  private sub startAttack(move as BGE.Math.Vector)
    ' Swings at the lock target, or where the stick points
    if invalid <> m.lockTarget
      m.rotation.y = BGE.Math.headingOf(m.directionTo(m.lockTarget))
    else if BGE.Math.VectorOps.length(move) > 0.3
      m.rotation.y = BGE.Math.headingOf(move)
    end if
    m.attackQueued = false
    m.attackLanded = false
    m.setState(KnightState.attack, true)
  end sub

  private sub updateAttack(dt as float, attackPressed as boolean)
    ' Any press during a swing is buffered to chain the next one
    if attackPressed
      m.attackQueued = true
    end if
    lungeSeconds = m.attackSeconds * 0.5
    if m.stateSeconds < lungeSeconds
      m.moveBy(BGE.Math.headingForward(m.rotation.y), m.attackLunge * dt / lungeSeconds)
    end if
    ' The blade connects about halfway through the swing
    if not m.attackLanded and m.stateSeconds >= m.attackSeconds * 0.45
      m.attackLanded = true
      if invalid <> m.director
        for each target in m.director.enemiesInArc(m, m.attackReach, m.attackHalfAngle)
          target.receiveHit(m.attackDamage, m)
        end for
      end if
    end if
    if m.stateSeconds >= m.attackSeconds
      if m.attackQueued and m.stamina.spend(m.attackStamina)
        m.startAttack(m.cameraRelativeMove())
      else
        m.setState(KnightState.idle)
      end if
    end if
  end sub

  ' Rolls toward the stick, or steps back (still facing forward) with the stick centred.
  private sub startDodge(move as BGE.Math.Vector)
    m.setState(KnightState.dodge)
    if BGE.Math.VectorOps.length(move) > 0.3
      m.dodgeDirection = BGE.Math.VectorOps.scale(move, 1 / BGE.Math.VectorOps.length(move))
      m.rotation.y = BGE.Math.headingOf(move)
      m.sprite.playOrientedAnimation("roll")
    else
      m.dodgeDirection = BGE.Math.VectorOps.scale(BGE.Math.headingForward(m.rotation.y), -1)
      m.sprite.playOrientedAnimation("backstep")
    end if
  end sub

  private sub updateDodge(dt as float)
    t = m.stateSeconds / m.dodgeSeconds
    m.invulnerable = t > 0.1 and t < 0.75
    ' Fast out, easing to a stop
    speed = 2 * (1 - BGE.Math.Min(t, 1)) * m.dodgeDistance / m.dodgeSeconds
    m.moveBy(m.dodgeDirection, speed * dt)
    if t >= 1
      m.setState(KnightState.idle)
    end if
  end sub

  override function receiveHit(damage as float, attacker as Fighter) as HitResult
    if not m.isAlive() or m.invulnerable
      return HitResult.dodged
    end if
    if m.state = KnightState.parry and m.stateSeconds < m.parrySeconds and m.isFacing(attacker, BGE.Math.PI / 2)
      attacker.parried()
      m.spray(HitEffects.parrySparks(), attacker)
      return HitResult.parried
    end if
    guardBroken = false
    if m.state = KnightState.block and m.isFacing(attacker, BGE.Math.PI * 0.45)
      guardBroken = not m.stamina.drain(damage * m.blockStaminaPerDamage)
      push = World.metres(0.5)
      if guardBroken
        push = World.metres(1.2)
      end if
      m.takeDamage(damage * m.blockLeak, attacker, push)
      m.spray(HitEffects.blockSparks(), attacker)
      result = HitResult.blocked
    else
      m.takeDamage(damage, attacker, World.metres(1))
      m.spray(HitEffects.blood(m.bloodColor), attacker)
      result = HitResult.hit
    end if
    if not m.isAlive()
      m.setState(KnightState.dead)
    else if guardBroken
      m.hurtForSeconds = m.guardBreakSeconds
      m.setState(KnightState.hurt, true)
    else if result = HitResult.hit
      m.hurtForSeconds = m.hurtSeconds
      m.setState(KnightState.hurt, true)
    end if
    return result
  end function

  protected override function attackArc() as AttackArc
    if m.state = KnightState.attack
      return {reach: m.attackReach, halfAngle: m.attackHalfAngle}
    end if
    return invalid
  end function

  ' Back on his feet at full health.
  sub respawn(x as float, z as float)
    m.setLockTarget(invalid)
    m.health = m.maxHealth
    m.stamina.refill()
    m.position = BGE.Math.VectorOps.create(x, 0, z)
    m.knockback.stop()
    m.setState(KnightState.idle)
  end sub

  ' A white dot on the locked-on enemy's chest.
  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    super.onDrawEnd(gameRenderer, uiRenderer)
    if invalid <> m.lockTarget
      target = m.lockTarget
      chest = BGE.Math.VectorOps.create(target.position.x, target.height * 0.6, target.position.z)
      gameRenderer.drawWorldBar(chest, 6, 6, 1, &hFFFFFFFF, &h000000C0)
    end if
  end sub

  protected override function restingColor() as integer
    if m.state = KnightState.dead
      return &h803030
    end if
    return &hFFFFFF
  end function

end class
