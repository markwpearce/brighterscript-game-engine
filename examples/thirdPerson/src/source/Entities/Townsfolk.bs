import "../World.bs"
import "../Town/TownMap.bs"

' How one kind of townsperson (or animal) is drawn: its packed sprite atlas (pkg:/sprites/<atlas>.json)
' and the frame columns tools/render-character.py printed for it.
interface TownsfolkType extends roAssociativeArray
  atlas as string
  anchorX as float
  anchorY as float
  framesPerDirection as integer
  idle as integer[]
  ' Frame columns of a walk cycle, or empty for none
  walk as integer[]
  ' Rendered with --mirror: only the front-to-back half of the 16 directions
  mirrored as boolean
end interface

' A townsperson standing about, playing an idle loop. Not a fighter: nothing hits them, and they
' don't react to the knight yet.
class Townsfolk extends BGE.GameEntity

  sprite as BGE.DrawableOrientedSprite
  type as TownsfolkType

  ' Only this close to the camera (world units) do they play their idle loop, rechecked every
  ' checkSeconds
  idleDistance as float = World.metres(10)
  checkSeconds as float = 0.5

  protected idling as boolean = false
  protected checkIn as float = 0

  sub new(game as BGE.Game)
    super(game)
    m.name = "Townsfolk"
  end sub

  ' args: type (TownsfolkType), x, z, heading (radians, 0 faces -z), idleRate (optional frames
  ' per second, so a crowd doesn't bob in step)
  override sub onCreate(args as roAssociativeArray)
    m.type = args.type
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    m.rotation = BGE.Math.VectorOps.create(0, args.heading ?? 0, 0)
    m.sprite = m.addOrientedSprite("body", m.game.getSpriteAtlasFrames(m.type.atlas), 0, 0, 16, 1, {
      drawMode: BGE.SceneObjectDrawMode.axisAligned,
      isShaded: true,
      lightWrap: 0.5,
      ambientBrightness: 0,
      mirrorBuckets: m.type.mirrored
    })
    ' Rendered from the same 12 degrees as the knight, at the same scale
    m.sprite.axisAlignedFullHeightPitch = 12
    m.sprite.setAnchor(m.type.anchorX, m.type.anchorY)
    m.sprite.addOrientedAnimation("idle", m.sprite.framesForColumns(m.type.idle, m.type.framesPerDirection), args.idleRate ?? 4, BGE.SpritePlayMode.PingPong)
    if m.type.walk.Count() > 0
      m.sprite.addOrientedAnimation("walk", m.sprite.framesForColumns(m.type.walk, m.type.framesPerDirection), 8)
    end if
    ' One frame, for when they're too far off for the idle loop to be worth its cost
    m.sprite.addOrientedAnimation("still", m.sprite.framesForColumns([m.type.idle[0]], m.type.framesPerDirection), 1)
    m.sprite.playOrientedAnimation("still")
    ' Spread the distance checks over frames, so the crowd doesn't check at once
    m.checkIn = TownMap.cellRandom(Int(args.x), Int(args.z), 7) * m.checkSeconds
  end sub

  override sub onUpdate(dt as float)
    m.checkIn -= dt
    if m.checkIn > 0
      return
    end if
    m.checkIn = m.checkSeconds
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    dx = camera.position.x - m.position.x
    dz = camera.position.z - m.position.z
    near = dx * dx + dz * dz < m.idleDistance * m.idleDistance
    if near <> m.idling
      m.idling = near
      if near
        m.sprite.playOrientedAnimation("idle")
      else
        m.sprite.playOrientedAnimation("still")
      end if
    end if
  end sub

end class
