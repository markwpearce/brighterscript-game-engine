import "../World.bs"

' A building or other big prop: a loaded .obj model (in metres, scaled to the world) that the chase
' camera can't pass through.
class PropModel extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "PropModel"
  end sub

  ' args: x, z (the middle of its base), model (a loaded model's name), width, height, depth (its
  ' size in world units, for the camera blocker), shiftZ (optional: world units to move the model
  ' forward so its base is centred on x, z), turn (optional: y rotation in quarter turns' radians,
  ' the front facing +z at 0), occluder (optional: true to hide what's behind it from the
  ' renderer), blocksCamera (optional, true by default: false for no camera blocker)
  override sub onCreate(args as roAssociativeArray)
    m.name = args.model
    occluder = args.occluder = true
    ' Props never move: static skips their collision checks, and only static drawables occlude
    m.isStatic = true
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    turn = args.turn ?? 0
    m.rotation = BGE.Math.VectorOps.create(0, turn, 0)
    model = new BGE.DrawableModel(m, m.game.get3dModel(args.model), {isOccluder: occluder})
    model.scale = BGE.Math.createScaleVector(World.UNITS_PER_METRE)
    if args.shiftZ <> invalid
      model.offset = BGE.Math.VectorOps.create(0, 0, args.shiftZ)
    end if
    m.addDrawable("model", model)
    width = args.width
    depth = args.depth
    if Abs(Sin(turn)) > 0.5
      ' Turned a quarter: the camera blocker is axis-aligned, so swap its sides
      width = args.depth
      depth = args.width
    end if
    if args.blocksCamera <> false
      body = m.addBoxCollider3d("body", width, args.height, depth, 0, args.height / 2, 0)
      body.memberFlags = World.CAMERA_BLOCKER
    end if
  end sub

end class
