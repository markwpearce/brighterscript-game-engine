import "../World.bs"

enum HitResult
  hit = "hit"
  blocked = "blocked"
  parried = "parried"
  dodged = "dodged"
end enum

' Anything that fights: the knight and the enemies. Each has health, a round body that others
' can't walk through (see CombatDirector.separateBodies()), knockback and a hit flash.
class Fighter extends BGE.GameEntity

  sprite as BGE.DrawableOrientedSprite
  maxHealth as float = 100
  health as float = 100
  bodyRadius as float = World.metres(0.4)
  ' When two bodies overlap the lighter one is pushed further
  mass as float = 1
  ' Set by CombatDirector.add()
  combatId as integer = 0

  ' Untyped: `as BGE.Math.Vector` here gives a bogus "Cannot find name 'Vector'" in bsc 1.0.0-alpha.57
  protected knockback = BGE.Math.VectorOps.create()
  protected flashSeconds as float = 0

  ' Without its own constructor bsc 1.0.0-alpha.57 fails to transpile this class (GameEntity's inherited `args as roAssociativeArray`)
  sub new(game as BGE.Game)
    super(game)
  end sub

  function isAlive() as boolean
    return m.health > 0
  end function

  ' Called by the attacker when a swing connects. Subclasses decide whether it's blocked,
  ' parried or dodged.
  function receiveHit(damage as float, attacker as Fighter) as HitResult
    m.takeDamage(damage, attacker, World.metres(1))
    return HitResult.hit
  end function

  ' Called when this fighter's strike is parried.
  sub parried()
  end sub

  protected sub takeDamage(damage as float, attacker as Fighter, push as float)
    m.health = BGE.Math.Max(0, m.health - damage)
    m.flashSeconds = 0.15
    m.pushAwayFrom(attacker, push)
  end sub

  ' Shoves this fighter `distance` away from `other`, eased out over a moment.
  sub pushAwayFrom(other as Fighter, distance as float)
    away = World.flatDirection(other.position, m.position)
    m.knockback = BGE.Math.VectorOps.scale(away, distance * 6)
  end sub

  ' Unit vector from this fighter toward `other`, on the ground.
  function directionTo(other as Fighter) as BGE.Math.Vector
    return World.flatDirection(m.position, other.position)
  end function

  function distanceTo(other as Fighter) as float
    return World.flatDistance(m.position, other.position)
  end function

  ' True when `other` is within halfAngle radians either side of where this fighter faces.
  function isFacing(other as Fighter, halfAngle as float) as boolean
    heading = World.headingOf(m.directionTo(other))
    return Abs(World.wrapAngle(heading - m.rotation.y)) <= halfAngle
  end function

  ' Knockback and the hit flash; call once per update.
  protected sub updateCombatEffects(dt as float)
    if BGE.Math.VectorOps.length(m.knockback) > 1
      m.position.x += m.knockback.x * dt
      m.position.z += m.knockback.z * dt
      m.knockback = BGE.Math.VectorOps.scale(m.knockback, BGE.Math.Max(0, 1 - 10 * dt))
    end if
    if m.flashSeconds > 0
      m.flashSeconds -= dt
    end if
    if invalid <> m.sprite
      if m.flashSeconds > 0
        m.sprite.color = &hFF5050
      else
        m.sprite.color = m.restingColor()
      end if
    end if
  end sub

  protected function restingColor() as integer
    return &hFFFFFF
  end function

  protected sub moveBy(direction as BGE.Math.Vector, distance as float)
    m.position.x += direction.x * distance
    m.position.z += direction.z * distance
  end sub

end class
