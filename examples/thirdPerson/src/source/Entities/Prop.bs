import "../World.bs"

' A prop drawn from one image at 32 px per metre (times `scale`): a camera-facing cut-out standing
' on the ground (rubble, bones, the altar, graves, trees), or, given `turn`, flat against a wall
' facing out of it (an alcove).
class Prop extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "Prop"
  end sub

  ' args: x, z, bitmap (a bitmap name), turn (optional: y rotation to hang it on a wall, facing
  ' +z at 0), scale (optional, 1 by default), anchorX/anchorY (optional: the point of the image
  ' on the ground, 0.5/1 by default)
  override sub onCreate(args as roAssociativeArray)
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    bmp = m.game.getBitmap(args.bitmap)
    region = CreateObject("roRegion", bmp, 0, 0, bmp.GetWidth(), bmp.GetHeight())
    if args.turn <> invalid
      ' On a wall it never moves, so it sorts against the walls in the static tree
      m.isStatic = true
      image = m.addImage("image", region, {
        rotation: BGE.Math.VectorOps.create(0, args.turn, 0),
        drawMode: BGE.SceneObjectDrawMode.oriented,
        isShaded: true
      })
    else
      image = m.addImage("image", region, {
        drawMode: BGE.SceneObjectDrawMode.axisAligned,
        isShaded: true,
        lightWrap: 0.5
      })
    end if
    if args.scale <> invalid
      image.scale = BGE.Math.createScaleVector(args.scale)
    end if
    image.setAnchor(args.anchorX ?? 0.5, args.anchorY ?? 1)
  end sub

end class
