import "../World.bs"

enum FlameKind
  ' Warm firelight
  fire = "fire"
  ' Cold blue spirit fire
  spirit = "spirit"
end enum

' How a FlameKind looks and lights its surroundings
interface FlameStyle extends roAssociativeArray
  ' RGB, particles fade from start to end
  startColor as integer
  endColor as integer
  ' RGB
  lightColor as integer
  intensity as float
  range as float
end interface

' A flame (rising particles) with a point light that pools on the ground round it. The light
' never moves or flickers: a changing light relights everything it reaches every frame.
class Torch extends BGE.GameEntity

  light as BGE.PointLight

  sub new(game as BGE.Game)
    super(game)
    m.name = "Torch"
  end sub

  ' args: x, y, z (the base of the flame), kind (a FlameKind, fire by default)
  override sub onCreate(args as roAssociativeArray)
    m.position = BGE.Math.VectorOps.create(args.x, args.y, args.z)
    kind = args.kind
    if kind = invalid
      kind = FlameKind.fire
    end if

    flame = {
      startColor: &hFFE89A,
      endColor: &hC02808,
      lightColor: &hFF9440,
      intensity: 1.6,
      range: World.metres(9)
    } as FlameStyle
    if kind = FlameKind.spirit
      flame = {
        startColor: &hE0F4FF,
        endColor: &h2050FF,
        lightColor: &h5A8CFF,
        intensity: 1.8,
        range: World.metres(11)
      } as FlameStyle
    end if

    particles = new BGE.DrawableParticles(m, BGE.ParticleShape.Rectangle, {
      spawnRate: 16,
      lifetime: 0.55,
      lifetimeSpread: 0.2,
      velocity: BGE.Math.VectorOps.create(0, World.metres(1.3), 0),
      velocitySpreadAngleDegrees: 18,
      velocitySpreadMagnitude: World.metres(0.4),
      startColor: flame.startColor,
      endColor: flame.endColor,
      startAlpha: 240,
      endAlpha: 0,
      startSize: 26,
      endSize: 8,
      maxParticles: 10
    })
    m.addDrawable("flame", particles)
    particles.start()

    lightPosition = BGE.Math.VectorOps.create(m.position.x, m.position.y + World.metres(0.4), m.position.z)
    m.light = new BGE.PointLight(lightPosition, flame.range, flame.lightColor, flame.intensity)
    m.game.addLight(m.light)
  end sub

  override sub onDestroy()
    m.game.removeLight(m.light)
  end sub

  ' Lights belong to the game, not the scene, so they outlive this entity unless removed
  override sub onChangeScene(newScene as BGE.GameScene)
    m.game.removeLight(m.light)
  end sub

end class
