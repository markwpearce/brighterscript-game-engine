import "../World.bs"
import "pkg:/source/engine/drawables/ProceduralFrames.bs"

enum FlameKind
  ' Warm firelight
  fire = "fire"
  ' Cold blue spirit fire
  spirit = "spirit"
  ' Sickly green grave fire, deep in the crypt
  grave = "grave"
end enum

' How a FlameKind looks and lights its surroundings
interface FlameStyle extends roAssociativeArray
  ' RGB, the flame cools from start to end
  startColor as integer
  endColor as integer
  ' RGB
  lightColor as integer
  intensity as float
  range as float
end interface

' A flame (a looping animation of rising, fading squares) with a point light that pools on the ground round it. The light
' never moves or flickers: a changing light relights everything it reaches every frame.
class Torch extends BGE.GameEntity

  light as BGE.PointLight

  sub new(game as BGE.Game)
    super(game)
    m.name = "Torch"
  end sub

  ' args: x, y, z (the base of the flame), kind (a FlameKind, fire by default), post (optional:
  ' true for a post from the ground up to the flame), size (optional: the flame's size against
  ' a torch's, e.g. 0.4 for a candle; its light reaches less far too)
  override sub onCreate(args as roAssociativeArray)
    m.position = BGE.Math.VectorOps.create(args.x, args.y, args.z)
    kind = args.kind
    if kind = invalid
      kind = FlameKind.fire
    end if

    flame = {
      startColor: &hFFE89A,
      endColor: &hC02808,
      lightColor: &hFF9440,
      intensity: 1.6,
      range: World.metres(9)
    } as FlameStyle
    if kind = FlameKind.spirit
      flame = {
        startColor: &hE0F4FF,
        endColor: &h2050FF,
        lightColor: &h5A8CFF,
        intensity: 1.8,
        range: World.metres(11)
      } as FlameStyle
    end if
    if kind = FlameKind.grave
      flame = {
        startColor: &hE8FFD0,
        endColor: &h208040,
        lightColor: &h70E080,
        intensity: 1.6,
        range: World.metres(10)
      } as FlameStyle
    end if

    ' One looping animated image, unlit as it's the light: a particle emitter cost about 1 ms a
    ' frame per torch
    frames = FlameFrames.get(m.game, kind, flame)
    image = m.addAnimatedImage("flame", frames, {
      drawMode: BGE.SceneObjectDrawMode.axisAligned,
      animationDurationMs: FlameFrames.LOOP_MS,
      ' it gives off light, so it shows through the fog twice as far as everything else (#530)
      fadeDistanceScale: 2
    })
    image.setAnchor(0.5, 1)
    size = args.size ?? 1.0
    image.scale = BGE.Math.createScaleVector(size * World.metres(FlameFrames.WIDTH_METRES) / frames[0].GetWidth())
    if args.post = true
      m.addPost()
    end if

    lightPosition = BGE.Math.VectorOps.create(m.position.x, m.position.y + World.metres(0.4) * size, m.position.z)
    m.light = new BGE.PointLight(lightPosition, flame.range * (0.5 + size / 2), flame.lightColor, flame.intensity)
    ' the entity's own, so it goes with the torch
    m.addLight(m.light)
  end sub

  ' A wooden post from the ground up to the flame, as a flat upright image
  private sub addPost()
    strip = m.game.getBitmap("torchPost")
    if strip = invalid
      strip = CreateObject("roBitmap", {width: 4, height: 16, AlphaEnable: false})
      strip.Clear(&h3A2616FF)
      ' a lit edge, so it reads as round
      strip.DrawRect(1, 0, 1, 16, &h5C3C22FF)
      strip.Finish()
      m.game.loadBitmap("torchPost", strip)
    end if
    region = CreateObject("roRegion", strip, 0, 0, 4, 16)
    post = m.addImage("post", region, {drawMode: BGE.SceneObjectDrawMode.axisAligned, isShaded: true, ambientBrightness: 0.3})
    post.setAnchor(0.5, 1)
    ' the entity sits at the flame's base
    post.offset = BGE.Math.VectorOps.create(0, -m.position.y, 0)
    post.scale = BGE.Math.createScaleVector(World.metres(0.18) / 4, m.position.y / 16)
  end sub

end class

' The flame's animation, shared by every torch of a FlameKind
namespace FlameFrames

  const LOOP_MS = 560
  ' The world width a frame is drawn at
  const WIDTH_METRES = 0.8

  function get(game as BGE.Game, kind as string, flame as FlameStyle) as roRegion[]
    return BGE.ProceduralFrames.flame(game, "flameFrames_" + kind, {startColor: flame.startColor, endColor: flame.endColor})
  end function

end namespace
