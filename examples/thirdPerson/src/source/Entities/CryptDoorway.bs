import "../World.bs"

' A stone doorway frame: two square posts and a lintel across the top, as one flat-coloured
' model. Stands across a gap `width` wide, facing along `turn` (y rotation, 0 faces +z).
class CryptDoorway extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "CryptDoorway"
  end sub

  ' args: x, z (the middle of the gap, on the floor), turn, width (world units)
  override sub onCreate(args as roAssociativeArray)
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    m.rotation = BGE.Math.VectorOps.create(0, args.turn, 0)
    post = World.metres(0.6)
    height = World.metres(3.6)
    half = args.width / 2
    faces = [] as BGE.Model3dFace[]
    m.addBox(faces, -half, 0, post, height)
    m.addBox(faces, half, 0, post, height)
    m.addBox(faces, 0, height, args.width + post, post)
    model = new BGE.Model3d(faces)
    model.name = "cryptDoorway"
    frame = new BGE.DrawableModel(m, model)
    frame.isShaded = true
    m.addDrawable("frame", frame)
  end sub

  ' A box `width` along x, `height` up from `bottom`, `post` deep, centred on x
  private sub addBox(faces as BGE.Model3dFace[], x as float, bottom as float, width as float, height as float)
    depth = World.metres(0.6)
    halfSize = BGE.Math.VectorOps.create(width / 2, height / 2, depth / 2)
    center = BGE.Math.VectorOps.create(x, bottom + height / 2, 0)
    axes = [BGE.Math.VectorOps.create(1, 0, 0), BGE.Math.VectorOps.create(0, 1, 0), BGE.Math.VectorOps.create(0, 0, 1)]
    for axis = 0 to 2
      for each sign in [1, -1]
        normal = BGE.Math.VectorOps.scale(axes[axis], sign)
        ' Two axes across the face, ordered so the corners run counter-clockwise from outside
        u = axes[(axis + 1) mod 3]
        v = axes[(axis + 2) mod 3]
        if sign < 0
          u = axes[(axis + 2) mod 3]
          v = axes[(axis + 1) mod 3]
        end if
        faceCenter = BGE.Math.VectorOps.add(center, m.scaleByAxes(normal, halfSize))
        du = m.scaleByAxes(u, halfSize)
        dv = m.scaleByAxes(v, halfSize)
        c0 = BGE.Math.VectorOps.subtract(BGE.Math.VectorOps.subtract(faceCenter, du), dv)
        c1 = BGE.Math.VectorOps.subtract(BGE.Math.VectorOps.add(faceCenter, du), dv)
        c2 = BGE.Math.VectorOps.add(BGE.Math.VectorOps.add(faceCenter, du), dv)
        c3 = BGE.Math.VectorOps.add(BGE.Math.VectorOps.subtract(faceCenter, du), dv)
        for each corners in [[c0, c1, c2], [c0, c2, c3]]
          face = BGE.Model3dFaceOps.create(corners, normal)
          face.color = &h6E675EFF
          faces.push(face)
        end for
      end for
    end for
  end sub

  ' `direction` (a signed unit axis) scaled per axis by `size`
  private function scaleByAxes(direction as BGE.Math.Vector, size as BGE.Math.Vector) as BGE.Math.Vector
    return BGE.Math.VectorOps.create(direction.x * size.x, direction.y * size.y, direction.z * size.z)
  end function

end class
