import "../World.bs"
import "../ImpostorStrips.bs"

' A stone doorway frame: two square posts and a lintel across the top, flat-coloured. Stands
' across a gap `width` wide, facing along `turn` (y rotation, 0 faces +z). Each piece is its own
' model: the renderer sorts a model by the centre of its bounds, and one model's would be the
' middle of the gap, so a post would draw over the knight standing in front of it (#564).
class CryptDoorway extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "CryptDoorway"
  end sub

  ' args: x, z (the middle of the gap, on the floor), turn, width (world units)
  override sub onCreate(args as roAssociativeArray)
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    m.rotation = BGE.Math.VectorOps.create(0, args.turn, 0)
    post = World.metres(0.6)
    height = World.metres(3.6)
    half = args.width / 2
    m.addPiece("postLeft", -half, 0, post, height)
    m.addPiece("postRight", half, 0, post, height)
    m.addPiece("lintel", 0, height, args.width + post, post)
  end sub

  ' One box, `width` along x, `height` up from `bottom` and 0.6 m deep, as its own model and drawable
  private sub addPiece(name as string, x as float, bottom as float, width as float, height as float)
    center = BGE.Math.VectorOps.create(x, bottom + height / 2, 0)
    size = BGE.Math.VectorOps.create(width, height, World.metres(0.6))
    model = new BGE.Model3d(BGE.Model3dOps.boxFaces(center, size, &h6E675EFF))
    model.name = "cryptDoorway-" + name
    piece = new BGE.DrawableModel(m, model)
    piece.isShaded = true
    applyImpostorStrips(piece)
    m.addDrawable(name, piece)
  end sub

end class
