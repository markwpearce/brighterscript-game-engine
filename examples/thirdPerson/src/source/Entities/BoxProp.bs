import "../World.bs"

' One box of a BoxProp, in world units relative to the entity
interface PropBox extends roAssociativeArray
  ' The middle of its base
  x as float
  y as float
  z as float
  ' Along x and z
  width as float
  depth as float
  height as float
  ' &hRRGGBBAA
  color as integer
  ' A bitmap name (propWood or propStone: tools/prop-art.py, 2 x 2 m) to tile over it instead of the flat colour
  optional texture as string
end interface

' Plain coloured boxes (a top and four sides each): furniture with no art of its own, lit like
' everything else. Never checks collisions; its solids are the scene's business.
class BoxProp extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "BoxProp"
  end sub

  ' args: x, z, boxes (PropBox[]), name (optional)
  override sub onCreate(args as roAssociativeArray)
    if invalid <> args.name
      m.name = args.name
    end if
    m.isStatic = true
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    index = 0
    ' A model per box: models sort by their bounds' centre, and one model for every bench in a
    ' hall would sort by the middle of the room and draw over the knight beside a bench (#564)
    for each piece in args.boxes
      center = BGE.Math.VectorOps.create(piece.x, piece.y + piece.height / 2, piece.z)
      size = BGE.Math.VectorOps.create(piece.width, piece.height, piece.depth)
      model = new BGE.Model3d(BGE.Model3dOps.boxFaces(center, size, piece.color, {omit: ["bottom"]}))
      model.name = m.name
      if invalid <> piece.texture
        m.mapTexture(model, piece)
      end if
      m.addDrawable(`box${index}`, new BGE.DrawableModel(m, model))
      index++
    end for
  end sub

  ' UVs from world position, one repeat per 2 m, so every box shares the texture's scale; the
  ' grain runs along each box's longer side on top, and across the sides
  private sub mapTexture(model as BGE.Model3d, piece as PropBox)
    tile = World.metres(2)
    left = piece.x - piece.width / 2
    back = piece.z - piece.depth / 2
    alongZ = piece.depth > piece.width
    for each face in model.faces
      points = [] as BGE.Math.Vector[]
      for each corner in face.vertices
        across = corner.x - left
        along = corner.z - back
        if Abs(face.normal.y) > 0.5
          if alongZ
            points.push(BGE.Math.VectorOps.create(along / tile, across / tile, 0))
          else
            points.push(BGE.Math.VectorOps.create(across / tile, along / tile, 0))
          end if
        else
          side = across
          if Abs(face.normal.x) > 0.5
            side = along
          end if
          points.push(BGE.Math.VectorOps.create(side / tile, (corner.y - piece.y) / tile, 0))
        end if
      end for
      face.Texture = new BGE.Model3dTexture(BGE.RendererHelpers.createRegionWithId(invalid, ""), points)
    end for
    BGE.Model3dOps.applyTexture(model, m.game.getBitmap(piece.texture), piece.texture)
  end sub

end class
