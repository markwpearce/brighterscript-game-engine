import "../World.bs"

' One box of a BoxProp, in world units relative to the entity
interface PropBox extends roAssociativeArray
  ' The middle of its base
  x as float
  y as float
  z as float
  ' Along x and z
  width as float
  depth as float
  height as float
  ' &hRRGGBBAA
  color as integer
end interface

' Plain coloured boxes (a top and four sides each): furniture with no art of its own, lit like
' everything else. Never checks collisions; its solids are the scene's business.
class BoxProp extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "BoxProp"
  end sub

  ' args: x, z, boxes (PropBox[]), name (optional)
  override sub onCreate(args as roAssociativeArray)
    if invalid <> args.name
      m.name = args.name
    end if
    m.isStatic = true
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    index = 0
    ' A model per box: models sort by their bounds' centre, and one model for every bench in a
    ' hall would sort by the middle of the room and draw over the knight beside a bench (#564)
    for each piece in args.boxes
      center = BGE.Math.VectorOps.create(piece.x, piece.y + piece.height / 2, piece.z)
      size = BGE.Math.VectorOps.create(piece.width, piece.height, piece.depth)
      model = new BGE.Model3d(BGE.Model3dOps.boxFaces(center, size, piece.color, {omit: ["bottom"]}))
      model.name = m.name
      m.addDrawable(`box${index}`, new BGE.DrawableModel(m, model))
      index++
    end for
  end sub

end class
