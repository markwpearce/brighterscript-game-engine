import "../World.bs"

' One box of a BoxProp, in world units relative to the entity
interface PropBox extends roAssociativeArray
  ' The middle of its base
  x as float
  y as float
  z as float
  ' Along x and z
  width as float
  depth as float
  height as float
  ' &hRRGGBBAA
  color as integer
end interface

' Plain coloured boxes as one model (a top and four sides each): furniture with no art of its
' own, lit like everything else. Static, so it never checks collisions; its solids are the
' scene's business.
class BoxProp extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "BoxProp"
  end sub

  ' args: x, z, boxes (PropBox[]), name (optional)
  override sub onCreate(args as roAssociativeArray)
    if invalid <> args.name
      m.name = args.name
    end if
    m.isStatic = true
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    faces = [] as BGE.Model3dFace[]
    for each piece in args.boxes
      m.addBoxFaces(faces, piece)
    end for
    model = new BGE.Model3d(faces)
    model.name = m.name
    m.addDrawable("boxes", new BGE.DrawableModel(m, model))
  end sub

  private sub addBoxFaces(faces as BGE.Model3dFace[], piece as PropBox)
    halfW = piece.width / 2
    halfD = piece.depth / 2
    halfH = piece.height / 2
    middle = BGE.Math.VectorOps.create(piece.x, piece.y + halfH, piece.z)
    ' Each side as its outward normal and two half-extents u and v with u x v along the normal,
    ' so the corners go counter-clockwise seen from outside
    sides = [
      [BGE.Math.VectorOps.create(0, 1, 0), BGE.Math.VectorOps.create(0, 0, halfD), BGE.Math.VectorOps.create(halfW, 0, 0)],
      [BGE.Math.VectorOps.create(0, 0, 1), BGE.Math.VectorOps.create(halfW, 0, 0), BGE.Math.VectorOps.create(0, halfH, 0)],
      [BGE.Math.VectorOps.create(0, 0, -1), BGE.Math.VectorOps.create(-halfW, 0, 0), BGE.Math.VectorOps.create(0, halfH, 0)],
      [BGE.Math.VectorOps.create(1, 0, 0), BGE.Math.VectorOps.create(0, 0, -halfD), BGE.Math.VectorOps.create(0, halfH, 0)],
      [BGE.Math.VectorOps.create(-1, 0, 0), BGE.Math.VectorOps.create(0, 0, halfD), BGE.Math.VectorOps.create(0, halfH, 0)]
    ]
    for each side in sides
      normal = side[0]
      u = side[1]
      v = side[2]
      ' How far the face's centre is from the box's middle along its normal
      reach = Abs(normal.x) * halfW + Abs(normal.y) * halfH + Abs(normal.z) * halfD
      center = BGE.Math.VectorOps.add(middle, BGE.Math.VectorOps.scale(normal, reach))
      a = BGE.Math.VectorOps.subtract(BGE.Math.VectorOps.subtract(center, u), v)
      b = BGE.Math.VectorOps.subtract(BGE.Math.VectorOps.add(center, u), v)
      c = BGE.Math.VectorOps.add(BGE.Math.VectorOps.add(center, u), v)
      d = BGE.Math.VectorOps.add(BGE.Math.VectorOps.subtract(center, u), v)
      for each corners in [[a, b, c], [a, c, d]]
        face = BGE.Model3dFaceOps.create(corners, normal)
        face.color = piece.color
        faces.push(face)
      end for
    end for
  end sub

end class
