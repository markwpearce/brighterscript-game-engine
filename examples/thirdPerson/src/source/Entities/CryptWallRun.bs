import "../World.bs"
import "../Crypt/CryptMap.bs"

' A straight stretch of crypt wall as one quad, its stone texture tiled along it: the fewer
' quads the cheaper, since every warped quad costs a few milliseconds on device. Lit evenly
' along its length (a quad is shaded at its centre). Static, so it occludes what's behind it.
class CryptWallRun extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "CryptWallRun"
    m.isStatic = true
  end sub

  ' args: x, z (middle of the run, on the floor), side (the CryptMap side it faces out of),
  ' region (roRegion: the texture tiled to the run's length), style ("image", the default, or
  ' "model")
  override sub onCreate(args as roAssociativeArray)
    m.position = BGE.Math.VectorOps.create(args.x, 0, args.z)
    region = args.region
    if args.style = "model"
      m.addModelWall(args.side, region)
    else
      height = World.metres(CryptMap.WALL_METRES)
      face = m.addImage("wall", region, {
        offset: BGE.Math.VectorOps.create(0, height / 2, 0),
        rotation: BGE.Math.VectorOps.create(0, CryptMap.sideTurn(args.side), 0),
        drawMode: BGE.SceneObjectDrawMode.oriented,
        isShaded: true,
        isOccluder: true
      })
      face.setAnchor(0.5, 0.5)
    end if
  end sub

  ' The same quad as a two-triangle textured model, whose impostor is reused while the camera
  ' moves a little
  private sub addModelWall(side as string, region as roRegion)
    width = region.GetWidth()
    height = region.GetHeight()
    normal = CryptMap.sideNormal(side)
    right = BGE.Math.VectorOps.scale(BGE.Math.VectorOps.crossProduct(BGE.Math.VectorOps.create(0, 1, 0), normal), width / 2)
    up = BGE.Math.VectorOps.create(0, height, 0)
    bottomLeft = BGE.Math.VectorOps.scale(right, -1)
    bottomRight = right
    topRight = BGE.Math.VectorOps.add(bottomRight, up)
    topLeft = BGE.Math.VectorOps.add(bottomLeft, up)
    texture = {region: region, id: `cryptWall${width}`} as BGE.RendererHelpers.RegionWithId
    ' Counter-clockwise seen from the floor side; texture points are pixels in the region
    pixelBottomLeft = BGE.Math.VectorOps.create(0, height, 0)
    pixelBottomRight = BGE.Math.VectorOps.create(width, height, 0)
    pixelTopRight = BGE.Math.VectorOps.create(width, 0, 0)
    pixelTopLeft = BGE.Math.VectorOps.create(0, 0, 0)
    faces = [
      m.texturedFace([bottomLeft, bottomRight, topRight], [pixelBottomLeft, pixelBottomRight, pixelTopRight], normal, texture)
      m.texturedFace([bottomLeft, topRight, topLeft], [pixelBottomLeft, pixelTopRight, pixelTopLeft], normal, texture)
    ] as BGE.Model3dFace[]
    model = new BGE.Model3d(faces)
    model.name = "cryptWallRun"
    wall = new BGE.DrawableModel(m, model)
    wall.isShaded = true
    wall.isOccluder = true
    m.addDrawable("wall", wall)
  end sub

  private function texturedFace(corners as BGE.Math.Vector[], pixels as BGE.Math.Vector[], normal as BGE.Math.Vector, texture as BGE.RendererHelpers.RegionWithId) as BGE.Model3dFace
    face = BGE.Model3dFaceOps.create(corners, normal)
    face.Texture = new BGE.Model3dTexture(texture, pixels)
    return face
  end function

end class
