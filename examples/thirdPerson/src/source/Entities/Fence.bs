import "../World.bs"

' A straight piece of wooden fence: a see-through, double-sided wall with the picket image repeated
' every 3 m.
class Fence extends BGE.GameEntity

  sub new(game as BGE.Game)
    super(game)
    m.name = "Fence"
  end sub

  ' args: from, to (BGE.Math.Vector, ends on the ground), region (the picket image)
  override sub onCreate(args as roAssociativeArray)
    ' Never moves, so it sorts through the static tree
    m.isStatic = true
    height = World.metres(1.2)
    wall = new BGE.DrawableWall(m, args.region, args.from, args.to, 0, height, {
      tileWidth: World.metres(3),
      tileHeight: height
    })
    ' You can see through the gaps between the pickets
    wall.isOccluder = false
    m.addDrawable("wall", wall)
  end sub

end class
