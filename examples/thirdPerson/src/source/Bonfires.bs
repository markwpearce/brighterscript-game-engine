' A bonfire: where it is, and where the knight wakes beside it
interface BonfireSpot extends roAssociativeArray
  id as string
  ' Shown nowhere yet; for the inventory and a travel menu later
  name as string
  scene as string
  ' The crypt level it's on, 0 elsewhere
  level as integer
  ' Its cell in the scene's grid
  col as integer
  row as integer
  ' A neighbouring cell: the knight wakes 2 m from the fire toward it, facing the fire
  wakeCol as integer
  wakeRow as integer
end interface

' Every bonfire in the game. A scene places its own with ThirdPersonScene.addBonfires(); changing
' to Bonfires.sceneArgs(spot) brings the knight in beside one.
namespace Bonfires

  function all() as BonfireSpot[]
    return [
      ' By the well in the square
      {id: "town", name: "Town Square", scene: "TownScene", level: 0, col: 19, row: 14, wakeCol: 18, wakeRow: 14},
      ' Just inside the gap in the fence
      {id: "graveyard", name: "Graveyard Gate", scene: "GraveyardScene", level: 0, col: 9, row: 20, wakeCol: 9, wakeRow: 19},
      ' Beside the way up
      {id: "crypt1", name: "Crypt Entrance", scene: "CryptScene", level: 1, col: 2, row: 11, wakeCol: 3, wakeRow: 11},
      ' Down the corridor from the King's hall
      {id: "crypt3", name: "Deep Tomb", scene: "CryptScene", level: 3, col: 2, row: 6, wakeCol: 3, wakeRow: 6}
    ]
  end function

  ' The bonfire with this id, or invalid
  function get(id as string) as BonfireSpot
    for each spot in Bonfires.all()
      if spot.id = id
        return spot
      end if
    end for
    return invalid
  end function

  ' Which place it's in, as ThirdPersonScene.placeKey() names it
  function placeKey(spot as BonfireSpot) as string
    if spot.level > 0
      return spot.scene + spot.level.toStr()
    end if
    return spot.scene
  end function

  ' The scene change args that wake the knight beside it
  function sceneArgs(spot as BonfireSpot) as roAssociativeArray
    args = {bonfire: spot.id}
    if spot.level > 0
      args.level = spot.level
    end if
    return args
  end function

end namespace
