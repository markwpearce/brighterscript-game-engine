import "Items.bs"

' Coins left where the knight died, waiting to be picked up
interface DroppedCoins extends roAssociativeArray
  ' The place key (ThirdPersonScene.placeKey(): the scene's name, and the crypt's level)
  scene as string
  x as float
  z as float
  amount as integer
end interface

' What this run carries between scenes: coins, healing draughts, gear, key items, the bonfire to
' wake at and the coins left at the last death. GameSave writes it to and reads it from the save. Get the shared
' one with RunData.current().
class RunState

  coins as integer = 0
  draughts as integer = 3
  maxDraughts as integer = 3
  ' The last bonfire rested at (a Bonfires id), "" before the first
  bonfireId as string = ""
  ' Bonfire ids rested at at least once
  litBonfires as string[] = []
  ' invalid when there are none to pick up
  droppedCoins as DroppedCoins = invalid
  ' Weapons and shields owned (Items ids), and the one in each slot (ItemKind.weapon/shield -> id)
  ownedGear as string[] = [Items.LONGSWORD, Items.HEATER_SHIELD]
  equippedGear as roAssociativeArray = {weapon: Items.LONGSWORD, shield: Items.HEATER_SHIELD}
  keyItems as string[] = []
  ' The merchant's one-off wares bought (Items ids)
  purchases as string[] = []

  ' Gives the knight an item: gear and key items join the inventory, a Barrow Flask adds a
  ' draught. False when it does nothing (already owned, or draughts at their max).
  function grantItem(id as string) as boolean
    item = Items.get(id)
    if invalid = item
      return false
    end if
    if item.kind = ItemKind.upgrade
      return m.upgradeFlask()
    end if
    list = m.keyItems
    if item.kind = ItemKind.weapon or item.kind = ItemKind.shield
      list = m.ownedGear
    end if
    if RunData.contains(list, id)
      return false
    end if
    list.push(id)
    return true
  end function

  ' Owns this weapon, shield or key item
  function owns(id as string) as boolean
    return RunData.contains(m.ownedGear, id) or RunData.contains(m.keyItems, id)
  end function

  ' Puts an owned weapon or shield in its slot; false if it isn't owned gear
  function equip(id as string) as boolean
    item = Items.get(id)
    if invalid = item or not RunData.contains(m.ownedGear, id)
      return false
    end if
    m.equippedGear[item.kind] = id
    return true
  end function

  ' The weapon or shield in a slot (ItemKind.weapon or ItemKind.shield)
  function equipped(slot as string) as ItemInfo
    item = invalid
    if invalid <> m.equippedGear[slot]
      item = Items.get(m.equippedGear[slot])
    end if
    if invalid = item
      if slot = ItemKind.shield
        return Items.get(Items.HEATER_SHIELD)
      end if
      return Items.get(Items.LONGSWORD)
    end if
    return item
  end function

  function isEquipped(id as string) as boolean
    for each slot in m.equippedGear
      if m.equippedGear[slot] = id
        return true
      end if
    end for
    return false
  end function

  ' One more draught to carry (and one more now), up to Items.MAX_DRAUGHTS
  function upgradeFlask() as boolean
    if m.maxDraughts >= Items.MAX_DRAUGHTS
      return false
    end if
    m.maxDraughts++
    m.draughts++
    return true
  end function

  ' Uses up a draught; false with none left
  function drink() as boolean
    if m.draughts <= 0
      return false
    end if
    m.draughts--
    return true
  end function

  sub addCoins(amount as integer)
    m.coins += amount
  end sub

  function isLit(bonfireId as string) as boolean
    return RunData.contains(m.litBonfires, bonfireId)
  end function

  ' Rests at a bonfire: it becomes the one to wake at, the draughts are refilled. True the first
  ' time it's rested at.
  function rest(bonfireId as string) as boolean
    m.bonfireId = bonfireId
    m.draughts = m.maxDraughts
    if m.isLit(bonfireId)
      return false
    end if
    m.litBonfires.push(bonfireId)
    return true
  end function

  ' Dying: every coin carried drops at `place` x/z, replacing (and losing) any left last time
  sub dropCoins(place as string, x as float, z as float)
    m.droppedCoins = invalid
    if m.coins > 0
      m.droppedCoins = {scene: place, x: x, z: z, amount: m.coins}
    end if
    m.coins = 0
  end sub

  ' Picks up the dropped coins; returns how many
  function recoverCoins() as integer
    if invalid = m.droppedCoins
      return 0
    end if
    amount = m.droppedCoins.amount
    m.coins += amount
    m.droppedCoins = invalid
    return amount
  end function

end class

namespace RunData

  ' This run's state, made the first time anything asks for it
  function current() as RunState
    globals = GetGlobalAA()
    if invalid = globals.runState
      globals.runState = new RunState()
    end if
    return globals.runState
  end function

  function contains(list as string[], id as string) as boolean
    for each entry in list
      if entry = id
        return true
      end if
    end for
    return false
  end function

  ' A fresh run: no coins, full draughts, the starting gear, no bonfire
  function reset() as RunState
    state = new RunState()
    GetGlobalAA().runState = state
    return state
  end function

end namespace
