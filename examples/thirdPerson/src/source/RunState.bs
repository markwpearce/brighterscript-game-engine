' Coins left where the knight died, waiting to be picked up
interface DroppedCoins extends roAssociativeArray
  ' The place key (ThirdPersonScene.placeKey(): the scene's name, and the crypt's level)
  scene as string
  x as float
  z as float
  amount as integer
end interface

' What this run carries between scenes: coins, healing draughts, the bonfire to wake at and the
' coins left at the last death. GameSave writes it to and reads it from the save. Get the shared
' one with RunData.current().
class RunState

  coins as integer = 0
  draughts as integer = 3
  maxDraughts as integer = 3
  ' The last bonfire rested at (a Bonfires id), "" before the first
  bonfireId as string = ""
  ' Bonfire ids rested at at least once
  litBonfires as string[] = []
  ' invalid when there are none to pick up
  droppedCoins as DroppedCoins = invalid

  sub addCoins(amount as integer)
    m.coins += amount
  end sub

  function isLit(bonfireId as string) as boolean
    for each id in m.litBonfires
      if id = bonfireId
        return true
      end if
    end for
    return false
  end function

  ' Rests at a bonfire: it becomes the one to wake at, the draughts are refilled. True the first
  ' time it's rested at.
  function rest(bonfireId as string) as boolean
    m.bonfireId = bonfireId
    m.draughts = m.maxDraughts
    if m.isLit(bonfireId)
      return false
    end if
    m.litBonfires.push(bonfireId)
    return true
  end function

  ' Dying: every coin carried drops at `place` x/z, replacing (and losing) any left last time
  sub dropCoins(place as string, x as float, z as float)
    m.droppedCoins = invalid
    if m.coins > 0
      m.droppedCoins = {scene: place, x: x, z: z, amount: m.coins}
    end if
    m.coins = 0
  end sub

  ' Picks up the dropped coins; returns how many
  function recoverCoins() as integer
    if invalid = m.droppedCoins
      return 0
    end if
    amount = m.droppedCoins.amount
    m.coins += amount
    m.droppedCoins = invalid
    return amount
  end function

end class

namespace RunData

  ' This run's state, made the first time anything asks for it
  function current() as RunState
    globals = GetGlobalAA()
    if invalid = globals.runState
      globals.runState = new RunState()
    end if
    return globals.runState
  end function

  ' A fresh run: no coins, full draughts, no bonfire
  function reset() as RunState
    state = new RunState()
    GetGlobalAA().runState = state
    return state
  end function

end namespace
