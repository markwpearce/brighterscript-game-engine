import "pkg:/source/engine/drawables/ParticlePresets.bs"
import "pkg:/source/engine/sceneFlow/ExitArea.bs"
import "pkg:/source/engine/gridMaps/CharGrid.bs"

' World scale shared by everything in the example: 32 world units per metre, so the
' 2 m tall player is 64 units tall.
namespace World

  const UNITS_PER_METRE = 32
  ' Collider memberFlags bit for things the chase camera can't pass through
  const CAMERA_BLOCKER = 2
  ' The town and graveyard fog colour, a dusky blue
  const FOG_RGB = &h1C2842

  function metres(value as float) as float
    return value * World.UNITS_PER_METRE
  end function

  ' A scene exit over a block of a map's cells
  function cellsArea(grid as BGE.CharGrid, col as integer, row as integer, cols = 1 as integer, rows = 1 as integer) as BGE.GridCellsExitArea
    return new BGE.GridCellsExitArea(grid.origin.x, grid.origin.z, grid.cellSize, col, row, cols, rows)
  end function

  ' A scene exit over a group of a map's cells
  function groupArea(grid as BGE.CharGrid, group as BGE.CharGridGroup) as BGE.GridCellsExitArea
    return World.cellsArea(grid, group.col, group.row, group.cols, group.rows)
  end function

  ' Frames per second for an 8-frame Flare run cycle at `speed` (units/sec), so the feet don't
  ' slide: one cycle covers about 3.3 m.
  function runFrameRate(speed as float) as float
    if speed <= 0
      return 1
    end if
    return BGE.frameRateForStride(8, World.metres(3.3), speed)
  end function

  ' Scales BGE.ParticlePresets (authored in metres) to this world.
  function particleUnits() as BGE.ParticlePresetOptions
    return {unitsPerMetre: World.metres(1)}
  end function

end namespace
