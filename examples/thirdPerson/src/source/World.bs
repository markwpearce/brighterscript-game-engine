' World scale shared by everything in the example: 32 world units per metre, so the
' 2 m tall player is 64 units tall.
namespace World

  const UNITS_PER_METRE = 32

  function metres(value as float) as float
    return value * World.UNITS_PER_METRE
  end function

  ' Heading convention used by DrawableOrientedSprite and Camera3d: a heading of 0 faces -z,
  ' and forward is (sin(heading), 0, -cos(heading)).
  function headingForward(heading as float) as BGE.Math.Vector
    return BGE.Math.VectorOps.create(Sin(heading), 0, -Cos(heading))
  end function

  function headingRight(heading as float) as BGE.Math.Vector
    return BGE.Math.VectorOps.create(Cos(heading), 0, Sin(heading))
  end function

  function headingOf(direction as BGE.Math.Vector) as float
    return BGE.Math.Atan2(direction.x, -direction.z)
  end function

  ' Wraps an angle into -PI..PI.
  function wrapAngle(angle as float) as float
    while angle > BGE.Math.PI
      angle -= 2 * BGE.Math.PI
    end while
    while angle < -BGE.Math.PI
      angle += 2 * BGE.Math.PI
    end while
    return angle
  end function

  ' Turns `current` toward `target` by at most maxStep radians, the short way round.
  function turnToward(current as float, target as float, maxStep as float) as float
    diff = World.wrapAngle(target - current)
    if Abs(diff) <= maxStep
      return target
    end if
    if diff > 0
      return current + maxStep
    end if
    return current - maxStep
  end function

end namespace
