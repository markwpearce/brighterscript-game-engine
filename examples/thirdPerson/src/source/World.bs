' World scale shared by everything in the example: 32 world units per metre, so the
' 2 m tall player is 64 units tall.
namespace World

  const UNITS_PER_METRE = 32

  function metres(value as float) as float
    return value * World.UNITS_PER_METRE
  end function

  ' Frames per second for an 8-frame Flare run cycle at `speed` (units/sec), so the feet don't
  ' slide: one cycle covers about 3.3 m. Whole numbers only: sprite frame rates are integers.
  function runFrameRate(speed as float) as integer
    return BGE.Math.Max(1, Cint(8 * speed / World.metres(3.3)))
  end function

  ' The slowest whole frame rate that plays `frameCount` frames within `seconds`.
  function frameRateWithin(frameCount as integer, seconds as float) as integer
    return -Int(-frameCount / seconds)
  end function

end namespace
