' World scale shared by everything in the example: 32 world units per metre, so the
' 2 m tall player is 64 units tall.
namespace World

  const UNITS_PER_METRE = 32
  ' Collider memberFlags bit for things the chase camera can't pass through
  const CAMERA_BLOCKER = 2

  function metres(value as float) as float
    return value * World.UNITS_PER_METRE
  end function

  ' Frames per second for an 8-frame Flare run cycle at `speed` (units/sec), so the feet don't
  ' slide: one cycle covers about 3.3 m.
  function runFrameRate(speed as float) as float
    if speed <= 0
      return 1
    end if
    return BGE.frameRateFor(8, World.metres(3.3) / speed)
  end function

end namespace
