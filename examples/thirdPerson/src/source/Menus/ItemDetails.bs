import "pkg:/source/engine/ui/TextWrap.bs"
import "pkg:/source/engine/ui/Theme.bs"
import "../Items.bs"

' What the inventory and the shop draw beside their lists: an item's picture, name, numbers and
' description
namespace ItemDetails

  ' Draws `item` in a column `width` wide from x, y (screen pixels); returns the y below it.
  ' `unit` scales with the UI canvas height (720 = 1).
  function draw(game as BGE.Game, renderer as BGE.Renderer, theme as BGE.UI.Theme, item as ItemInfo, x as float, y as float, width as float, unit as float) as float
    nameFont = game.getFontOr("default")
    smallFont = game.getFontOr("small")
    iconSize = ItemIcons.SIZE * unit
    ItemDetails.drawIcon(renderer, theme, item.icon, x, y, iconSize)
    textX = x + iconSize + 16 * unit
    renderer.drawText(item.name, textX, y, theme.panelTitleColor, nameFont)
    kindLine = ItemDetails.kindLabel(item.kind)
    renderer.drawText(kindLine, textX, y + nameFont.GetOneLineHeight(), theme.foregroundColor, smallFont)
    nextY = y + BGE.Math.Max(iconSize, nameFont.GetOneLineHeight() + smallFont.GetOneLineHeight()) + 12 * unit
    lineHeight = smallFont.GetOneLineHeight()
    for each statLine in Items.statLines(item)
      renderer.drawText(statLine, x, nextY, theme.panelTextColor, smallFont)
      nextY += lineHeight
    end for
    nextY += 8 * unit
    for each textLine in BGE.UI.wrapText(item.description, smallFont, width)
      renderer.drawText(textLine, x, nextY, theme.foregroundColor, smallFont)
      nextY += lineHeight
    end for
    return nextY
  end function

  ' An item picture `size` square on a dark tile with a gold edge
  sub drawIcon(renderer as BGE.Renderer, theme as BGE.UI.Theme, icon as integer, x as float, y as float, size as float)
    renderer.drawRoundedRectangle(x, y, size, size, size * 0.12, &h00000090)
    renderer.drawRectangleOutline(x, y, size, size, theme.borderColor, 2)
    picture = ItemIcons.region(icon)
    if invalid <> picture
      scale = size / ItemIcons.SIZE
      renderer.drawScaledObject(x, y, scale, scale, picture)
    end if
  end sub

  function kindLabel(kind as string) as string
    labels = {weapon: "Weapon", shield: "Shield", key: "Key item", upgrade: "Upgrade"}
    if labels.DoesExist(kind)
      return labels[kind]
    end if
    return ""
  end function

end namespace
