import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/ui/UiContainer.bs"
import "pkg:/source/engine/ui/TextButton.bs"
import "pkg:/source/engine/ui/UiActionListener.bs"
import "pkg:/source/math/math.bs"
import "pkg:/source/utils/strings.bs"

' One of the title screen's items: its label centred in its cell, bright and underlined while focused
class TitleMenuButton extends BGE.UI.TextButton

  underlineColor as integer = &h9FC3D8FF
  shadowColor as integer = &h000000B0

  sub new(game as BGE.Game)
    super(game)
    m.marker = ""
    m.textColor = &hA8A096FF
    m.focusedColor = &hF4ECDCFF
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    font = m.font
    if invalid = font
      font = m.game.getFontOr("default")
    end if
    color = m.textColor
    if m.disabled
      color = m.disabledColor
    else if m.focused or m.hovered
      color = m.focusedColor
    end if
    renderer = m.game.uiCanvas.renderer
    label = m.getLabel()
    lineHeight = font.GetOneLineHeight()
    centerX = m.position.x + m.width / 2
    y = m.position.y + (m.height - lineHeight) / 2
    shadow = BGE.Math.Max(1, lineHeight * 0.04)
    renderer.drawText(label, centerX + shadow, y + shadow, m.shadowColor, font, "center")
    renderer.drawText(label, centerX, y, color, font, "center")
    if m.focused and not m.disabled
      textWidth = font.GetOneLineWidth(label, BGE.TEXT_MAX_LINE_SIZE)
      thickness = BGE.Math.Max(2, lineHeight * 0.05)
      renderer.drawRectangle(centerX - textWidth / 2, y + lineHeight * 0.98, textWidth, thickness, m.underlineColor)
    end if
  end sub

end class

' The title screen's menu: a row of text items along the bottom of the key art. Left and right
' move along it (the focus manager steps through them in order); OK calls
' `listener.onUiAction(id, button)`.
class TitleMenu extends BGE.UI.UiContainer

  listener as BGE.UI.UiActionListener = invalid
  ' Space between items, as a fraction of the font's line height
  gap as float = 1.6

  private items = [] as roAssociativeArray[]
  private buttons = [] as TitleMenuButton[]
  private ownerScene as BGE.GameScene = invalid

  sub new(game as BGE.Game)
    super(game)
    m.customPosition = true
    m.showBackground = false
  end sub

  sub addItem(id as string, label as string)
    m.items.push({id: id, label: label})
  end sub

  ' Lays the items out centred on `centerY` across the UI canvas, adds the row to the current
  ' scene and focuses its first item
  sub open(centerY as float)
    font = m.game.getFontOr("titleMenu")
    lineHeight = font.GetOneLineHeight()
    canvasWidth = m.game.uiCanvas.getWidth()
    textWidths = [] as float[]
    textTotal = 0.0
    for each item in m.items
      textWidth = font.GetOneLineWidth(item.label, BGE.TEXT_MAX_LINE_SIZE)
      textWidths.push(textWidth)
      textTotal += textWidth
    end for
    ' narrower gaps if the row would leave the title-safe 80% of the width
    gapWidth = lineHeight * m.gap
    if m.items.count() > 0
      gapWidth = BGE.Math.Max(0, BGE.Math.Min(gapWidth, (canvasWidth * 0.8 - textTotal) / m.items.count()))
    end if
    widths = [] as float[]
    total = 0.0
    for each textWidth in textWidths
      widths.push(textWidth + gapWidth)
      total += textWidth + gapWidth
    end for
    m.width = total
    m.height = lineHeight * 1.4
    m.customX = (canvasWidth - total) / 2
    m.customY = centerY - m.height / 2
    x = 0.0
    for i = 0 to m.items.count() - 1
      item = m.items[i]
      button = new TitleMenuButton(m.game)
      button.font = font
      button.setLabel(item.label)
      button.actionId = item.id
      button.listener = m.listener
      button.customPosition = true
      button.customX = x
      button.customY = 0
      button.width = widths[i]
      button.height = m.height
      m.addChild(button)
      m.buttons.push(button)
      x += widths[i]
    end for
    m.ownerScene = m.game.getScene()
    m.ownerScene.addUi(m)
    if m.buttons.count() > 0
      m.game.focusManager.focusWidget(m.buttons[0])
    end if
  end sub

  sub close()
    if invalid <> m.ownerScene
      m.ownerScene.removeUi(m)
      m.ownerScene = invalid
    end if
  end sub

  ' Focuses the item `id`, if it's there
  sub focusItem(id as string)
    for each button in m.buttons
      if button.actionId = id
        m.game.focusManager.focusWidget(button)
        return
      end if
    end for
  end sub

  override sub onDestroy()
    for each button in m.buttons
      button.listener = invalid
    end for
    m.buttons = []
    m.ownerScene = invalid
    super.onDestroy()
  end sub

end class
