import "pkg:/source/engine/ui/Theme.bs"

namespace MenuTheme

  ' The game's look for panels, menus and the dialogue box: a dark panel, gold titles, cream text
  sub apply(theme as BGE.UI.Theme)
    theme.panelBackgroundColor = &h0A0806E0
    theme.panelTitleColor = &hE0B050FF
    theme.panelTextColor = &hE8E4DCFF
    theme.backgroundColor = &h1A1410FF
    theme.foregroundColor = &hD8D0C0FF
    theme.borderColor = &hA08040FF
    theme.focusedBorderColor = &hF0C860FF
    theme.hoveredBackgroundColor = &h3A2A18FF
    theme.disabledColor = &h707070FF
  end sub

end namespace
