import "pkg:/source/engine/ui/MenuList.bs"
import "pkg:/source/engine/ui/TextWrap.bs"
import "pkg:/source/engine/controller/ControlMap.bs"
import "ControlPictures.bs"

' One action's label beside a picture, with a leader line to its button. Panel-local pixels.
interface PlacedControlLabel extends roAssociativeArray
  lines as string[]
  side as string
  buttonX as float
  buttonY as float
  ' The text's edge nearest the picture, and its top
  textX as float
  textY as float
  height as float
  ' Stacking order down the side: by height, then nearest the side first, so leader lines
  ' don't cross
  order as float
end interface

' A picture laid out in the panel, with its caption, trigger tabs and labels. Panel-local pixels.
interface PlacedControlPicture extends roAssociativeArray
  image as roRegion
  x as float
  y as float
  scale as float
  caption as string
  captionX as float
  captionY as float
  tabs as ControlRect[]
  labels as PlacedControlLabel[]
end interface

' The controls: the Roku remote and a gamepad side by side, each button labelled with what it
' does (from the control map, so it can't drift from the bindings), over a Done button, which
' goes to the listener as "done".
class ControlsPanel extends BGE.UI.MenuList

  private pictures as PlacedControlPicture[] = []
  ' Layout units scale with the UI canvas height (720 = 1)
  private unit as float = 1
  ' Between a label and the picture, and between stacked labels
  private labelGap as float = 14
  private labelSpacing as float = 6

  sub new(game as BGE.Game)
    super(game)
    m.title = "Controls"
    m.centered = true
    m.addItem("done", "Done")
    uiWidth = game.uiCanvas.getWidth()
    uiHeight = game.uiCanvas.getHeight()
    m.unit = uiHeight / 720.0
    ' Title-safe: the whole panel within 80% of the canvas
    m.setSize(uiWidth * 0.8, 0)
    titleHeight = m.headingFont().GetOneLineHeight()
    m.contentHeight = uiHeight * 0.78 - m.panelPadding * 2 - titleHeight - m.sectionGap * 2 - m.itemHeight
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    super.draw(parent)
    if not m.isOpen()
      return
    end if
    theme = m.effectiveTheme()
    for each picture in m.pictures
      m.drawPicture(picture, theme)
    end for
  end sub

  override sub onDestroy()
    m.pictures = []
    super.onDestroy()
  end sub

  ' Lays the two pictures out in the content space above the Done button
  protected override sub buildChildren()
    super.buildChildren()
    entries = ControlPictures.entries(m.game.controls)
    halfWidth = (m.width - m.panelPadding * 2) / 2
    top = m.contentTop
    m.pictures = []
    m.pictures.push(m.layOut(ControlPictures.REMOTE_IMAGE, "Roku remote", ControlPictures.remoteSpots(), m.remoteButtonsOf(entries), [], m.panelPadding, top, halfWidth, m.contentHeight))
    m.pictures.push(m.layOut(ControlPictures.GAMEPAD_IMAGE, "Controller", ControlPictures.gamepadSpots(), m.controllerButtonsOf(entries), ControlPictures.triggerTabs(), m.panelPadding + halfWidth, top, halfWidth, m.contentHeight))
  end sub

  ' button name -> label, for the remote's buttons
  private function remoteButtonsOf(entries as ControlEntry[]) as roAssociativeArray
    result = {}
    for each item in entries
      for each buttonName in item.remoteButtons
        result[buttonName] = item.label
      end for
    end for
    return result
  end function

  ' button name -> label, for the gamepad's buttons
  private function controllerButtonsOf(entries as ControlEntry[]) as roAssociativeArray
    result = {}
    for each item in entries
      for each buttonName in item.controllerButtons
        result[buttonName] = item.label
      end for
    end for
    return result
  end function

  ' Fits a picture and its labels into a box: labels either side, the picture as big as fits
  ' between them under the caption
  private function layOut(path as string, caption as string, spots as roAssociativeArray, buttonLabels as roAssociativeArray, tabs as ControlRect[], boxX as float, boxY as float, boxWidth as float, boxHeight as float) as PlacedControlPicture
    font = m.labelFont()
    lineHeight = font.GetOneLineHeight()
    gap = m.labelGap * m.unit
    maxLabelWidth = boxWidth * 0.28

    labels = [] as PlacedControlLabel[]
    sideWidth = {left: 0.0, right: 0.0}
    for each buttonName in buttonLabels.Keys()
      if spots.DoesExist(buttonName)
        buttonSpot = spots[buttonName] as ControlSpot
        lines = BGE.UI.wrapText(buttonLabels[buttonName], font, maxLabelWidth)
        for each textLine in lines
          sideWidth[buttonSpot.side] = BGE.Math.Max(sideWidth[buttonSpot.side], font.GetOneLineWidth(textLine, BGE.TEXT_MAX_LINE_SIZE))
        end for
        labels.push({lines: lines, side: buttonSpot.side, buttonX: buttonSpot.x, buttonY: buttonSpot.y, textX: 0, textY: 0, height: lines.count() * lineHeight, order: 0})
      end if
    end for

    image = m.loadImage(path)
    imageWidth = 1.0
    imageHeight = 1.0
    if invalid <> image
      imageWidth = image.GetWidth()
      imageHeight = image.GetHeight()
    end if
    for each label in labels
      inset = label.buttonX
      if label.side = "right"
        inset = imageWidth - label.buttonX
      end if
      label.order = label.buttonY + inset * 0.5
    end for
    ' the trigger tabs stick out above the picture
    above = 0.0
    for each tabRect in tabs
      above = BGE.Math.Max(above, -tabRect.y)
    end for

    captionHeight = lineHeight + gap
    leftWidth = sideWidth.left
    rightWidth = sideWidth.right
    availableWidth = boxWidth - leftWidth - rightWidth - gap * 4
    ' clear of the Done button below
    availableHeight = boxHeight - captionHeight - gap
    scale = BGE.Math.Min(availableWidth / imageWidth, availableHeight / (imageHeight + above))
    scale = BGE.Math.Min(scale, 1.5 * m.unit)

    totalWidth = leftWidth + gap * 2 + imageWidth * scale + gap * 2 + rightWidth
    startX = boxX + (boxWidth - totalWidth) / 2
    pictureX = startX + leftWidth + gap * 2
    pictureY = boxY + captionHeight + (availableHeight - (imageHeight + above) * scale) / 2 + above * scale

    for each label in labels
      label.buttonX = pictureX + label.buttonX * scale
      label.buttonY = pictureY + label.buttonY * scale
      if label.side = "left"
        label.textX = startX + leftWidth
      else
        label.textX = pictureX + imageWidth * scale + gap * 2
      end if
    end for
    m.stackLabels(labels, "left", boxY + captionHeight, boxY + boxHeight - gap)
    m.stackLabels(labels, "right", boxY + captionHeight, boxY + boxHeight - gap)

    return {
      image: image,
      x: pictureX,
      y: pictureY,
      scale: scale,
      caption: caption,
      captionX: pictureX + imageWidth * scale / 2,
      captionY: boxY,
      tabs: tabs,
      labels: labels
    }
  end function

  ' Puts one side's labels level with their buttons, pushed apart so none overlap, and kept
  ' between top and bottom
  private sub stackLabels(labels as PlacedControlLabel[], side as string, top as float, bottom as float)
    column = [] as PlacedControlLabel[]
    for each label in labels
      if label.side = side
        label.textY = label.buttonY - label.height / 2
        column.push(label)
      end if
    end for
    column.SortBy("order")
    spacing = m.labelSpacing * m.unit
    nextY = top
    for each label in column
      label.textY = BGE.Math.Max(label.textY, nextY)
      nextY = label.textY + label.height + spacing
    end for
    ' pushed off the bottom: shift back up
    limit = bottom
    for i = column.count() - 1 to 0 step -1
      label = column[i]
      label.textY = BGE.Math.Min(label.textY, limit - label.height)
      limit = label.textY - spacing
    end for
  end sub

  private sub drawPicture(picture as PlacedControlPicture, theme as BGE.UI.Theme)
    renderer = m.canvas.renderer
    originX = m.position.x
    originY = m.position.y
    font = m.labelFont()
    lineHeight = font.GetOneLineHeight()
    lineColor = theme.panelTitleColor
    s = picture.scale

    renderer.drawText(picture.caption, originX + picture.captionX, originY + picture.captionY, theme.panelTitleColor, m.bodyFont(), "center")
    for each tabRect in picture.tabs
      renderer.drawRoundedRectangle(originX + picture.x + tabRect.x * s, originY + picture.y + tabRect.y * s, tabRect.width * s, tabRect.height * s, 3 * s, theme.foregroundColor)
    end for
    if invalid <> picture.image
      renderer.drawScaledObject(originX + picture.x, originY + picture.y, s, s, picture.image)
    end if

    for each label in picture.labels
      buttonX = originX + label.buttonX
      buttonY = originY + label.buttonY
      textX = originX + label.textX
      textY = originY + label.textY
      lineY = textY + lineHeight / 2
      lineStartX = textX + 6 * m.unit
      if label.side = "right"
        lineStartX = textX - 6 * m.unit
      end if
      ' two pixels wide, so it holds up on a TV
      renderer.drawLine(lineStartX, lineY, buttonX, buttonY, lineColor)
      renderer.drawLine(lineStartX, lineY + 1, buttonX, buttonY + 1, lineColor)
      renderer.drawCircle(buttonX, buttonY, 4 * m.unit, lineColor)
      for each textLine in label.lines
        if label.side = "left"
          renderer.drawText(textLine, textX, textY, theme.panelTextColor, font, "right")
        else
          renderer.drawText(textLine, textX, textY, theme.panelTextColor, font, "left")
        end if
        textY += lineHeight
      end for
    end for
  end sub

  private function labelFont() as roFont
    return m.game.getFontOr("small")
  end function

  private function loadImage(path as string) as roRegion
    bitmap = CreateObject("roBitmap", path)
    if invalid = bitmap
      return invalid
    end if
    region = CreateObject("roRegion", bitmap, 0, 0, bitmap.GetWidth(), bitmap.GetHeight())
    ' smooth scaling keeps the thin outlines whole
    region.SetScaleMode(1)
    return region
  end function

end class
