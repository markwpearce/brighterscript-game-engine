import "pkg:/source/engine/ui/MenuList.bs"
import "../Items.bs"
import "../RunState.bs"
import "../GameSave.bs"
import "ItemDetails.bs"

' The inventory, from the pause menu: the weapons and shields owned on the left (picking one
' equips it, which saves), and on the right the focused one's details, the healing draughts and
' the key items. Done goes to the listener as "done".
class InventoryPanel extends BGE.UI.MenuList

  private unit as float = 1

  sub new(game as BGE.Game)
    super(game)
    uiWidth = game.uiCanvas.getWidth()
    uiHeight = game.uiCanvas.getHeight()
    m.unit = uiHeight / 720.0
    m.title = "Inventory"
    m.centered = true
    m.contentAlign = "left"
    ' title-safe: within 80% of the canvas
    width = uiWidth * 0.72
    m.setSize(width, uiHeight * 0.72)
    m.itemWidth = (width - m.panelPadding * 2) * 0.45
    m.itemHeight = 44 * m.unit
    m.itemGap = 8 * m.unit
    state = RunData.current()
    for each item in Items.all()
      if (item.kind = ItemKind.weapon or item.kind = ItemKind.shield) and state.owns(item.id)
        m.addItem("equip:" + item.id, m.gearLabel(item, state), true, item.id)
      end if
    end for
    m.addItem("done", "Done")
  end sub

  ' Focuses the gear in use, the weapon first
  override sub open(parent = invalid as BGE.UI.UiContainer)
    super.open(parent)
    m.focusItem("equip:" + RunData.current().equipped(ItemKind.weapon).id)
  end sub

  ' The gear buttons come here; Done stays with the listener
  sub onUiAction(actionId as string, button as BGE.UI.Button)
    if Left(actionId, 6) <> "equip:"
      return
    end if
    state = RunData.current()
    if not state.equip(button.value)
      return
    end if
    ' the knight takes the new numbers
    m.game.postGameEvent("gearChanged")
    SaveData.current().saveProgress(m.game)
    for each other in m.buttons
      if invalid <> other.value
        other.setLabel(m.gearLabel(Items.get(other.value), state))
      end if
    end for
  end sub

  protected override sub buildChildren()
    super.buildChildren()
    for each button in m.buttons
      if invalid <> button.value
        button.listener = m
      end if
    end for
  end sub

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    super.draw(parent)
    if not m.isOpen()
      return
    end if
    theme = m.effectiveTheme()
    renderer = m.canvas.renderer
    state = RunData.current()
    gap = 32 * m.unit
    x = m.position.x + m.panelPadding + m.itemWidth + gap
    width = m.width - m.panelPadding * 2 - m.itemWidth - gap
    y = m.position.y + m.contentTop
    item = m.focusedItem()
    if invalid = item
      item = state.equipped(ItemKind.weapon)
    end if
    ItemDetails.draw(m.game, renderer, theme, item, x, y, width, m.unit)

    ' the draughts and key items along the bottom of the column
    font = m.game.getFontOr("default")
    smallFont = m.game.getFontOr("small")
    iconSize = 40 * m.unit
    rowHeight = iconSize + 8 * m.unit
    keyItems = state.keyItems
    rows = 2 + BGE.Math.Max(keyItems.count(), 1)
    rowY = m.position.y + m.height - m.panelPadding - rows * rowHeight
    ItemDetails.drawIcon(renderer, theme, Items.ICON_DRAUGHT, x, rowY, iconSize)
    textY = rowY + (iconSize - font.GetOneLineHeight()) / 2
    renderer.drawText(`Healing draughts  ${state.draughts} / ${state.maxDraughts}`, x + iconSize + 12 * m.unit, textY, theme.panelTextColor, font)
    rowY += rowHeight
    renderer.drawText("Key items", x, rowY + (iconSize - font.GetOneLineHeight()) / 2, theme.panelTitleColor, font)
    rowY += rowHeight
    if keyItems.count() = 0
      renderer.drawText("None", x, rowY + (iconSize - smallFont.GetOneLineHeight()) / 2, theme.foregroundColor, smallFont)
    end if
    for each id in keyItems
      keyItem = Items.get(id)
      if invalid <> keyItem
        ItemDetails.drawIcon(renderer, theme, keyItem.icon, x, rowY, iconSize)
        renderer.drawText(keyItem.name, x + iconSize + 12 * m.unit, rowY + (iconSize - smallFont.GetOneLineHeight()) / 2, theme.panelTextColor, smallFont)
      end if
      rowY += rowHeight
    end for
  end sub

  private function gearLabel(item as ItemInfo, state as RunState) as string
    if state.isEquipped(item.id)
      return item.name + "  (equipped)"
    end if
    return item.name
  end function

  ' The gear whose button has focus, or invalid
  private function focusedItem() as ItemInfo
    for each button in m.buttons
      if button.focused and invalid <> button.value
        return Items.get(button.value)
      end if
    end for
    return invalid
  end function

end class
