' A button in one of the engine's controller pictures, in the picture's pixels, and which side
' of the picture its label goes on ("left" or "right")
interface ControlSpot extends roAssociativeArray
  x as float
  y as float
  side as string
end interface

' A rectangle in a picture's pixels
interface ControlRect extends roAssociativeArray
  x as float
  y as float
  width as float
  height as float
end interface

' One action and the buttons it's on, by the names ControlMap.describeBindings() gives them
' ("OK", "X", "L1") plus "D-pad", "L stick" and "R stick" for the axes
interface ControlEntry extends roAssociativeArray
  label as string
  remoteButtons as string[]
  controllerButtons as string[]
end interface

' The engine's remote and gamepad pictures (its input debug window's), with where each button
' is. The positions are the highlight positions in BGE.Debug.InputDisplay.
namespace ControlPictures

  const REMOTE_IMAGE = "pkg:/source/engine/debug/images/roku-remote.png"
  const GAMEPAD_IMAGE = "pkg:/source/engine/debug/images/gamepad.png"

  ' The remote's buttons in roku-remote.png (200 x 400); the D-pad points at its left arrow, and
  ' Play at its lower half, so its leader line passes under Fast-forward
  function remoteSpots() as roAssociativeArray
    return {
      "Back": spot(57.5, 78, "left"),
      "D-pad": spot(47, 197, "left"),
      "OK": spot(100, 197, "right"),
      "Replay": spot(40, 318, "left"),
      "*": spot(155, 318, "right"),
      "Rewind": spot(37, 370, "left"),
      "Play": spot(101, 382, "right"),
      "FF": spot(162, 370, "right")
    }
  end function

  ' The gamepad's buttons in gamepad.png (295 x 208). The picture has no triggers: L2 and R2
  ' are tabs drawn above it (triggerTabs()).
  function gamepadSpots() as roAssociativeArray
    return {
      "L2": spot(69, -12.5, "left"),
      "L1": spot(69, 19, "left"),
      "L stick": spot(71, 58, "left"),
      "D-pad": spot(93, 107, "left"),
      "Select": spot(126, 59, "left"),
      "R2": spot(226, -12.5, "right"),
      "R1": spot(226, 19, "right"),
      "Start": spot(168, 59, "right"),
      "Y": spot(224, 38, "right"),
      "X": spot(204, 59, "right"),
      "B": spot(245, 59, "right"),
      "A": spot(224, 79, "right"),
      "R stick": spot(187, 102, "right")
    }
  end function

  ' L2 and R2, above gamepad.png
  function triggerTabs() as ControlRect[]
    return [
      {x: 50, y: -18, width: 38, height: 11},
      {x: 207, y: -18, width: 38, height: 11}
    ]
  end function

  ' Every action with its buttons: the control map's bound actions, the move and camera axes
  ' (the remote's D-pad moves; it has no camera stick), and the raw Back (pause; a gamepad's Select
  ' sends it), which isn't an action
  function entries(controls as BGE.Controller.ControlMap) as ControlEntry[]
    axisLabels = controls.getLabels()
    result = [] as ControlEntry[]
    result.push(entry(labelOr(axisLabels, "move", "Move"), ["D-pad"], ["L stick", "D-pad"]))
    result.push(entry(labelOr(axisLabels, "look", "Camera"), [], ["R stick"]))
    for each binding in controls.describeBindings()
      result.push(entry(binding.label, binding.remoteButtons, binding.controllerButtons))
    end for
    result.push(entry("Pause", ["Back"], ["Select"]))
    return result
  end function

  function spot(x as float, y as float, side as string) as ControlSpot
    return {x: x, y: y, side: side}
  end function

  function entry(label as string, remoteButtons as string[], controllerButtons as string[]) as ControlEntry
    return {label: label, remoteButtons: remoteButtons, controllerButtons: controllerButtons}
  end function

  function labelOr(labels as roAssociativeArray, name as string, fallback as string) as string
    if labels.DoesExist(name)
      return labels[name]
    end if
    return fallback
  end function

end namespace
