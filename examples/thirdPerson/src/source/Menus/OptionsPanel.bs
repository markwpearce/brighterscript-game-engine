import "pkg:/source/engine/ui/MenuList.bs"
import "pkg:/source/engine/ui/Slider.bs"
import "../GameSettings.bs"

' The options: music and sound volume sliders over a Done button. Left and right change the
' focused slider; save() writes them to the settings. Done goes to the listener as "done".
class OptionsPanel extends BGE.UI.MenuList

  musicSlider as BGE.UI.Slider = invalid
  soundSlider as BGE.UI.Slider = invalid

  ' Each slider's label, then its bar
  private labelHeight as float = 36
  private barHeight as float = 20
  private sliderGap as float = 24

  sub new(game as BGE.Game)
    super(game)
    m.title = "Options"
    m.centered = true
    m.addItem("done", "Done")
    m.setSize(game.uiCanvas.getWidth() * 0.4, 0)
    m.contentHeight = 2 * (m.labelHeight + m.barHeight + m.sliderGap)
  end sub

  ' Builds the panel, then focuses the music slider
  override sub open(parent = invalid as BGE.UI.UiContainer)
    super.open(parent)
    m.game.focusManager.focusWidget(m.musicSlider)
  end sub

  ' Writes the sliders' volumes to the settings
  sub save()
    if invalid <> m.musicSlider
      Settings.current().setVolumes(Int(m.musicSlider.getValue()), Int(m.soundSlider.getValue()))
    end if
  end sub

  override sub onUpdate(deltaTime as float)
    super.onUpdate(deltaTime)
    m.updateLabel(m.musicSlider, "Music volume")
    m.updateLabel(m.soundSlider, "Sound volume")
  end sub

  ' The sliders go in the content space above the Done button, and before it in focus order
  protected override sub buildChildren()
    super.buildChildren()
    prefs = Settings.current()
    m.musicSlider = m.makeSlider(0, prefs.musicVolume())
    m.soundSlider = m.makeSlider(1, prefs.soundVolume())
    m.updateLabel(m.musicSlider, "Music volume")
    m.updateLabel(m.soundSlider, "Sound volume")
  end sub

  private function makeSlider(index as integer, value as integer) as BGE.UI.Slider
    slider = new BGE.UI.Slider(m.game)
    slider.step = 10
    slider.setValue(value)
    slider.customPosition = true
    slider.customX = m.panelPadding
    slider.customY = m.contentTop + index * (m.labelHeight + m.barHeight + m.sliderGap) + m.labelHeight
    slider.width = m.width - m.panelPadding * 2
    slider.height = m.barHeight
    m.addChild(slider)
    if m.buttons.count() > 0
      focus = m.game.focusManager
      focus.unregister(slider)
      focus.registerBefore(slider, m.buttons[0])
    end if
    return slider
  end function

  ' The label with the value, set only when it changes (it's drawn to an image)
  private sub updateLabel(slider as BGE.UI.Slider, name as string)
    if invalid = slider
      return
    end if
    text = name + ": " + Int(slider.getValue()).toStr()
    if slider.drawableText.text <> text
      slider.setLabel(text)
    end if
  end sub

end class
