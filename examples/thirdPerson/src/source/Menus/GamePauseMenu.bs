import "pkg:/source/engine/PauseMenu.bs"
import "OptionsPanel.bs"
import "ControlsPanel.bs"

' The pause menu, on the remote's Back (a browser gamepad's Start sends it too): Resume, Inventory
' (not yet), Options, Controls and Quit to Title.
' Kept across scenes; it doesn't open on the title screen or over a conversation (another modal).
class GamePauseMenu extends BGE.PauseMenu

  ' The options or controls panel while it's up in place of the menu, and the item that opened it
  private panel as BGE.UI.MenuList = invalid
  private panelItem as string = ""

  sub new(game as BGE.Game)
    ' No "pause" action: a remote binding would match a gamepad's B (parry) too, as an alias of
    ' Back, so the menu reads the button itself
    super(game, {action: "", button: "back", buttons: ["resume"], titleScene: "TitleScene"})
    m.addButton("inventory", "Inventory")
    m.addButton("options", "Options")
    m.addButton("controls", "Controls")
    m.addButton("title", "Quit to Title")
    m.persistent = true
    m.blockWhen = function(game as BGE.Game) as boolean
      scene = game.getScene()
      return invalid = scene or scene.name = "TitleScene"
    end function
  end sub

  ' Back leaves a panel for the menu
  override sub onInput(input as BGE.GameInput)
    if invalid <> m.panel and input.press and input.isButton("back")
      input.consume()
      m.closePanel()
      return
    end if
    super.onInput(input)
  end sub

  override sub close()
    m.dropPanel()
    super.close()
  end sub

  ' The scene change took the panel with the scene's UI
  override sub onChangeScene(newScene as BGE.GameScene)
    super.onChangeScene(newScene)
    m.panel = invalid
    m.panelItem = ""
  end sub

  override sub onAction(actionId as string, clicked as BGE.UI.Button)
    if actionId = "options"
      options = new OptionsPanel(m.game)
      m.openPanel(options, actionId)
    else if actionId = "controls"
      controls = new ControlsPanel(m.game)
      m.openPanel(controls, actionId)
    else if actionId = "done"
      m.closePanel()
    end if
  end sub

  ' Inventory waits for the inventory (#385)
  protected override function createMenu() as BGE.UI.MenuList
    menu = super.createMenu()
    for each item in menu.items
      if item.id = "inventory"
        item.enabled = false
      end if
    end for
    return menu
  end function

  ' Swaps the menu for a panel
  private sub openPanel(panel as BGE.UI.MenuList, itemId as string)
    if invalid <> m.menu
      m.menu.close()
      m.menu = invalid
    end if
    panel.listener = m
    panel.open()
    m.panel = panel
    m.panelItem = itemId
  end sub

  ' Brings the menu back, focused on the item that opened the panel
  private sub closePanel()
    if invalid = m.panel
      return
    end if
    itemId = m.panelItem
    m.dropPanel()
    m.menu = m.createMenu()
    m.menu.open()
    m.menu.focusItem(itemId)
  end sub

  ' Closes the panel, saving the options if it's theirs
  private sub dropPanel()
    if invalid = m.panel
      return
    end if
    if m.panelItem = "options"
      options = m.panel as OptionsPanel
      options.save()
    end if
    m.panel.close()
    m.panel = invalid
    m.panelItem = ""
  end sub

end class
