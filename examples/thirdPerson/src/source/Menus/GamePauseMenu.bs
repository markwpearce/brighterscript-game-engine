import "pkg:/source/engine/PauseMenu.bs"
import "OptionsPanel.bs"

' The pause menu, on the remote's Back (a browser gamepad's Start sends it too): Resume, Inventory
' (not yet), Options and Quit to Title.
' Kept across scenes; it doesn't open on the title screen or over a conversation (another modal).
class GamePauseMenu extends BGE.PauseMenu

  ' The options panel while it's up in place of the menu
  private options as OptionsPanel = invalid

  sub new(game as BGE.Game)
    ' No "pause" action: a remote binding would match a gamepad's B (parry) too, as an alias of
    ' Back, so the menu reads the button itself
    super(game, {action: "", button: "back", buttons: ["resume"], titleScene: "TitleScene"})
    m.addButton("inventory", "Inventory")
    m.addButton("options", "Options")
    m.addButton("title", "Quit to Title")
    m.persistent = true
    m.blockWhen = function(game as BGE.Game) as boolean
      scene = game.getScene()
      return invalid = scene or scene.name = "TitleScene"
    end function
  end sub

  ' Back leaves the options for the menu
  override sub onInput(input as BGE.GameInput)
    if invalid <> m.options and input.press and input.isButton("back")
      input.consume()
      m.closeOptions()
      return
    end if
    super.onInput(input)
  end sub

  override sub close()
    if invalid <> m.options
      m.options.save()
      m.options.close()
      m.options = invalid
    end if
    super.close()
  end sub

  ' The scene change took the panel with the scene's UI
  override sub onChangeScene(newScene as BGE.GameScene)
    super.onChangeScene(newScene)
    m.options = invalid
  end sub

  override sub onAction(actionId as string, clicked as BGE.UI.Button)
    if actionId = "options"
      m.openOptions()
    else if actionId = "done"
      m.closeOptions()
    end if
  end sub

  ' Inventory waits for the inventory (#385)
  protected override function createMenu() as BGE.UI.MenuList
    menu = super.createMenu()
    for each item in menu.items
      if item.id = "inventory"
        item.enabled = false
      end if
    end for
    return menu
  end function

  ' Swaps the menu for the options panel
  private sub openOptions()
    if invalid <> m.menu
      m.menu.close()
      m.menu = invalid
    end if
    panel = new OptionsPanel(m.game)
    panel.listener = m
    panel.open()
    m.options = panel
  end sub

  ' Saves the options and brings the menu back, focused on Options
  private sub closeOptions()
    if invalid = m.options
      return
    end if
    m.options.save()
    m.options.close()
    m.options = invalid
    m.menu = m.createMenu()
    m.menu.open()
    m.menu.focusItem("options")
  end sub

end class
