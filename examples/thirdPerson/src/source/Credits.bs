import "pkg:/source/engine/ui/CreditsView.bs"

' The credits, shown from the title menu and after the ending (see CREDITS.md for the files)
namespace GameCredits

  ' Every entry; `ending` adds "The End" before them and a thank-you after
  '
  ' @param {boolean} ending
  ' @return {BGE.UI.CreditsEntry[]}
  function entries(ending as boolean) as BGE.UI.CreditsEntry[]
    list = [] as BGE.UI.CreditsEntry[]
    if ending
      list.push({text: "The Barrow King is slain, and the dead sleep."})
      list.push({text: ""})
      list.push({text: "The End", style: "title"})
      list.push({text: ""})
      list.push({text: ""})
    end if
    list.append([
      {text: "Night of the Barrow King", style: "title"},
      {text: ""},
      {text: "Made with", style: "heading"},
      {text: "the BrighterScript Game Engine"},
      {text: ""},
      {text: "The knight, the skeleton and the goblin", style: "heading"},
      {text: "Clint Bellanger (CC-BY 3.0, CC-BY-SA 3.0)"},
      {text: ""},
      {text: "The orcs", style: "heading"},
      {text: "johndh (CC-BY-SA 3.0)"},
      {text: ""},
      {text: "The hobgoblin and the werewolf", style: "heading"},
      {text: "VWolfdog (CC-BY 3.0)"},
      {text: ""},
      {text: "The townsfolk", style: "heading"},
      {text: "Danimal, Clint Bellanger, Tiziana and Quaternius (CC-BY-SA 3.0)"},
      {text: ""},
      {text: "Music", style: "heading"},
      {text: "HitCtrl (CC-BY 3.0), from OpenGameArt:"},
      {text: "The March upon the Red Mountain, The Lost Town,"},
      {text: "Foreboding Ambiance, The Wraiths of Winter"},
      {text: ""},
      {text: "Sound effects", style: "heading"},
      {text: "RPG Sound Pack by artisticdude (CC0)"},
      {text: ""},
      {text: "Title art", style: "heading"},
      {text: "Mark Pearce"},
      {text: ""},
      {text: "Fonts", style: "heading"},
      {text: "Bluu Next by Jean-Baptiste Morizot, Velvetyne (SIL OFL 1.1)"},
      {text: "EB Garamond by Georg Duffner and Octavio Pardo (SIL OFL 1.1)"},
      {text: ""},
      {text: "Everything else", style: "heading"},
      {text: "made for this game (CC0)"}
    ] as BGE.UI.CreditsEntry[])
    if ending
      list.push({text: ""})
      list.push({text: ""})
      list.push({text: "Thank you for playing", style: "heading"})
    end if
    return list
  end function

end namespace
