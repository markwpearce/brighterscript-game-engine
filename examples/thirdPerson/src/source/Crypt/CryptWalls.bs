import "../World.bs"
import "../Entities/Fighter.bs"
import "CryptMap.bs"

' A fighter CryptWalls keeps out of walls, and where it was after the last resolve()
interface CryptTrackedFighter extends roAssociativeArray
  body as Fighter
  x as float
  z as float
end interface

' Keeps fighters out of the crypt's solid cells. Call resolve() once everyone has moved (their
' own movement, knockback and being pushed apart): each fighter's move since the last call is
' replayed through a SolidWorld, so it stops flush against walls and slides along them.
class CryptWalls

  private solidWorld = new BGE.SolidWorld()
  private tracked as CryptTrackedFighter[] = []

  sub new(layout as CryptLayout)
    size = World.metres(CryptMap.CELL_METRES)
    for each cell in layout.solids
      center = CryptMap.cellCenter(layout, cell.col, cell.row)
      ' SolidWorld's y is the world's z
      m.solidWorld.addSolid(center.x - size / 2, center.z - size / 2, size, size)
    end for
    ' The exit's gap in the outer wall leads out of the grid
    m.solidWorld.addBounds(-layout.cols * size / 2, -layout.rows * size / 2, layout.cols * size, layout.rows * size, size)
  end sub

  ' Starts keeping `body` out of walls from where it is now. Call again after teleporting it
  ' (e.g. a respawn), or the jump is replayed as a move.
  sub track(body as Fighter)
    for each entry in m.tracked
      if entry.body.combatId = body.combatId
        entry.x = body.position.x
        entry.z = body.position.z
        return
      end if
    end for
    m.tracked.push({body: body, x: body.position.x, z: body.position.z} as CryptTrackedFighter)
  end sub

  sub resolve()
    for each entry in m.tracked
      body = entry.body
      side = body.bodyRadius * 2
      feet = {x: entry.x - body.bodyRadius, y: entry.z - body.bodyRadius, w: side, h: side}
      result = m.solidWorld.moveAndSlide(feet, body.position.x - entry.x, body.position.z - entry.z)
      body.position.x = result.x + body.bodyRadius
      body.position.z = result.y + body.bodyRadius
      entry.x = body.position.x
      entry.z = body.position.z
    end for
  end sub

end class
