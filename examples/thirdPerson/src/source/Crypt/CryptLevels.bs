import "../World.bs"
import "../Entities/Torch.bs"
import "../Entities/EnemyTypes.bs"

' One level of the crypt: its grid, its light, and what guards it
interface CryptLevel extends roAssociativeArray
  ' Shown as you arrive
  name as string
  ' A text grid; its key is above CryptLevels.layout1()
  layout as string[]
  ' The cold light that keeps unlit stone from pure black
  ambientColor as integer
  ambientIntensity as float
  ' What its `T` torches burn
  torchKind as FlameKind
  ' Who stands on its `W`, if anyone
  optional boss as EnemyType
  ' Shown when the boss dies
  optional bossBanner as string
end interface

' The crypt's levels, from the top down. Each level's `E` leads up (to the graveyard from the
' first) and its `D` down to the next; a level's `D` stays sealed while its boss lives.
namespace CryptLevels

  function count() as integer
    return 3
  end function

  ' Level 1 to count()
  function get(level as integer) as CryptLevel
    if level = 2
      return {
        name: "THE OSSUARY",
        layout: CryptLevels.layout2(),
        ambientColor: &h8090B0,
        ambientIntensity: 0.16,
        torchKind: FlameKind.spirit
      }
    else if level = 3
      return {
        name: "THE DEEP TOMB",
        layout: CryptLevels.layout3(),
        ambientColor: &h80B090,
        ambientIntensity: 0.16,
        torchKind: FlameKind.grave,
        boss: EnemyTypes.barrowKing(),
        bossBanner: "THE BARROW KING FALLS"
      }
    end if
    return {
      name: "THE CRYPT",
      layout: CryptLevels.layout1(),
      ambientColor: &h8090B0,
      ambientIntensity: 0.12,
      torchKind: FlameKind.fire,
      boss: EnemyTypes.cryptWarden(),
      bossBanner: "THE WARDEN FALLS"
    }
  end function

  ' Row 0 is the far (-z) edge, column 0 the -x edge. `#` solid, `.` floor, `S` start, `E` the
  ' way up and `D` the way down (gaps in the outer wall), `T` a torch on the cell's first wall,
  ' `A` an altar, `k` a skeleton alcove, `r` rubble, `b` bones; asleep until they see the
  ' knight: `u` a skeleton, `g` a ghoul, `o` a grave brute, `W` the level's boss. Walls are
  ' found in the order n, e, s, w.
  function layout1() as string[]
    return [
      "#############"
      "##A##b..u..T#"
      "#T.T#.#####.#"
      "D.W.#.#k..#.#"
      "#.....#.#.#.#"
      "##.##.u.#u..#"
      "#k.####.#####"
      "#T#...#...#T#"
      "###.#.#.#.#.#"
      "#u..#.u.#...#"
      "###.#T###.#.#"
      "#T......S.Tr#"
      "#E###########"
    ]
  end function

  ' Bones stacked in the walls; ghouls and a brute among the skeletons, and no boss
  function layout2() as string[]
    return [
      "###E###########"
      "#T.....#..u..T#"
      "#.###.##.###..#"
      "#.#k#.u..#b#..#"
      "#...#.##.#.#.g#"
      "###.#..T.#...##"
      "#u..##.###.#..#"
      "#.#..g.#...#o.#"
      "#.##.###.###..#"
      "#T..u...b..T..D"
      "###############"
    ]
  end function

  ' The last tomb: the Barrow King's hall at the top, its altar beyond
  function layout3() as string[]
    return [
      "###########"
      "####A######"
      "##T...T#..#"
      "##..W..#u.#"
      "##.....#..#"
      "####.###.##"
      "#T.....o..#"
      "#.###.###.#"
      "#g#u..#.#.#"
      "#.#.#.#u..#"
      "#...#T#.#T#"
      "###.#...#.#"
      "###E#######"
    ]
  end function

end namespace
