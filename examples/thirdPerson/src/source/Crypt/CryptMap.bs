import "../World.bs"
import "pkg:/source/engine/gridMaps/CharGrid.bs"

' The crypt's cell sizes, in metres
namespace CryptMap

  const CELL_METRES = 6
  const WALL_METRES = 4
  const SEGMENT_METRES = 2

end namespace

' A crypt level's text grid (CryptLevels): walls, colliders, torches and props all come from it.
' `#` is solid.
class CryptLayout extends BGE.CharGrid

  ' Every cell that isn't solid
  cells as BGE.CharGridCell[]
  ' The `S` cell, if there is one
  startCell as BGE.CharGridCell
  ' The way up (`E`) and down (`D`, if any)
  exitCell as BGE.CharGridCell
  downCell as BGE.CharGridCell

  sub new(rows as string[])
    super(rows, {cellSize: World.metres(CryptMap.CELL_METRES)})
    m.cells = m.cellsExcept("#")
    for each cell in m.cells
      if cell.kind = "S"
        m.startCell = cell
      else if cell.kind = "E"
        m.exitCell = cell
      else if cell.kind = "D"
        m.downCell = cell
      end if
    end for
  end sub

end class
