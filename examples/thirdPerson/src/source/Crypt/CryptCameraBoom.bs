import "../World.bs"
import "CryptMap.bs"

' A camera boom that pulls in at the crypt's walls by marching through its grid, rather than
' raycasting colliders: no wall colliders means no per-frame collision checks for them.
class CryptCameraBoom extends BGE.CameraBoom

  ' How far apart (world units) the march samples the line to the camera
  stepLength as float = World.metres(0.2)

  private layout as CryptLayout

  sub new(game as BGE.Game, layout as CryptLayout, args as roAssociativeArray)
    super(game, args)
    m.layout = layout
  end sub

  ' The farthest the camera can be along `direction` before its probe circle enters a solid cell
  protected override function unblockedDistance(lookAt as BGE.Math.Vector, direction as BGE.Math.Vector, wanted as float) as float
    allowed = wanted
    distance = 0.0
    while distance < wanted + m.stepLength
      along = BGE.Math.Min(distance, wanted)
      if m.isBlockedAt(lookAt.x + direction.x * along, lookAt.z + direction.z * along)
        allowed = along - m.stepLength
        exit while
      end if
      distance += m.stepLength
    end while
    return BGE.Math.Clamp(allowed, BGE.Math.Min(m.minDistance, wanted), wanted)
  end function

  ' Whether a probeRadius square round (x, z) touches a solid cell
  private function isBlockedAt(x as float, z as float) as boolean
    r = m.probeRadius
    for each corner in [[x - r, z - r], [x + r, z - r], [x - r, z + r], [x + r, z + r]]
      cell = CryptMap.cellAt(m.layout, corner[0], corner[1])
      if CryptMap.isSolid(m.layout, cell[0], cell[1])
        return true
      end if
    end for
    return false
  end function

end class
