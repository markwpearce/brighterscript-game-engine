import "../World.bs"
import "../GameAudio.bs"
import "../Dressing.bs"
import "../Entities/BoxProp.bs"
import "../Entities/Prop.bs"
import "../Entities/Torch.bs"
import "../Entities/Townsfolk.bs"
import "../Interior/InteriorMap.bs"
import "../Interior/Interiors.bs"
import "pkg:/source/engine/gridMaps/GridSides.bs"
import "../Town/TownsfolkTypes.bs"
import "ThirdPersonScene.bs"

' Inside a building (args.place: "keep" or "chapel", see Interiors): stone walls from its text
' grid, furniture as plain boxes, firelight, and whoever lives there. Its door leads back out
' to the scene it came from, in front of the same door.
class InteriorScene extends ThirdPersonScene

  ' World units per floor texel
  floorTexelScale as float = 2

  private place as InteriorPlace
  private layout as InteriorLayout
  private bitmapPaths as roAssociativeArray = {
    cryptFloor: "pkg:/sprites/crypt_floor.webp",
    cryptWall: "pkg:/sprites/crypt_wall.webp"
  }
  private modelPaths as roAssociativeArray = {
    torchWall: "pkg:/models/props/torch_wall.obj"
  }
  ' hangings placed so far, to take their bitmaps in turn
  private hangingCount as integer = 0
  private lord as TownsfolkType = TownsfolkTypes.nobleman()
  private priest as TownsfolkType = TownsfolkTypes.priest()

  sub new(game as BGE.Game)
    super(game)
    m.name = "InteriorScene"
    m.musicTrack = MusicTrack.town
    ' small rooms with no fighting: a lower frame rate buys a higher quality level
    m.qualityOptions = {targetFps: 15, fixedDrawDistance: true}
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    m.place = Interiors.get(args.place ?? "keep")
    m.loadSceneAtlas(loader, "knight", true)
    for each kind in m.peopleHere()
      m.loadSceneAtlas(loader, kind.atlas)
    end for
    m.loadSceneBitmaps(loader, m.bitmapPaths)
    m.loadSceneBitmaps(loader, m.place.bitmaps)
    m.loadSceneModels(loader, m.modelPaths)
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.readCommonArgs(args)
    m.game.setBackgroundColor(&h000000FF)
    layout = new InteriorLayout(m.place.layout)
    m.layout = layout
    ' scenes are reused
    m.hangingCount = 0

    floorBmp = m.game.getBitmap("cryptFloor")
    floor = new BGE.DrawablePlane(m, CreateObject("roRegion", floorBmp, 0, 0, floorBmp.GetWidth(), floorBmp.GetHeight()), {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {
      fillMode: BGE.PlaneFillMode.tiledImage,
      scale: BGE.Math.VectorOps.create(m.floorTexelScale, m.floorTexelScale, 1)
    })
    floor.isShaded = true
    m.addDrawable("Floor", floor)

    m.addLight(new BGE.AmbientLight(m.place.ambientColor, m.place.ambientIntensity))

    solids = m.layout.toSolidWorld()
    m.addWalls()
    m.addDoor()
    m.addFurniture(solids)
    for each cell in m.layout.cells
      m.addCellContents(cell, solids)
    end for

    ' Just inside the door, facing into the room
    door = m.layout.exits[0]
    inside = m.layout.cellCenter(door.col + (m.layout.exits.Count() - 1) / 2, door.row - 1)
    heading = 0.0
    at = m.parseAt()
    if invalid <> at
      ' Measuring: starts in another cell
      inside = m.layout.cellCenter(at.col, at.row)
      heading = at.heading
    end if
    m.addKnight(inside.x, inside.z, heading)
    ' Each door cell leads back out to where he came in
    for each doorCell in m.layout.exits
      m.exits.add(World.cellsArea(m.layout, doorCell.col, doorCell.row), m.place.outside, {from: m.place.id})
    end for
    ' Long enough to see across the keep's hall from its door
    m.setUpCamera(m.drawDistance(30), 0.5, m.wallTopCameraTilt)
    m.useDarkFog()
    m.useSolids(solids)
  end sub

  ' Every wall from the grid, as one drawable: the crypt's stone, one 2 m tile to a cell
  private sub addWalls()
    tile = m.game.getBitmap("cryptWall")
    region = CreateObject("roRegion", tile, 0, 0, tile.GetWidth(), tile.GetHeight())
    size = World.metres(InteriorMap.CELL_METRES)
    map = new BGE.GridWallsMap(m.place.layout, {
      cellSize: size,
      wallHeight: World.metres(m.place.wallMetres),
      origin: m.layout.origin,
      solid: {"#": "stone"}
    })
    m.wallsMap = map
    walls = new BGE.DrawableGridWalls(m, map, {stone: region}, {isShaded: true, lightWrap: 0.5, castsFogSilhouette: true})
    m.addDrawable("Walls", walls)
  end sub

  ' One box per rectangle of each furniture character, all of a kind in one entity, and a solid
  ' for each
  private sub addFurniture(solids as BGE.SolidWorld)
    kinds = ""
    for each key in m.place.furniture
      kinds += key
    end for
    if kinds = ""
      return
    end if
    boxesByKind = {}
    size = World.metres(InteriorMap.CELL_METRES)
    for each group in m.layout.findRectGroups(kinds)
      piece = m.furnitureFor(group.kind)
      center = m.layout.groupCenter(group)
      width = group.cols * size - 2 * World.metres(piece.insetX)
      depth = group.rows * size - 2 * World.metres(piece.insetZ)
      if invalid = boxesByKind[group.kind]
        boxesByKind[group.kind] = []
      end if
      boxesByKind[group.kind].push({x: center.x, y: 0, z: center.z, width: width, depth: depth, height: World.metres(piece.height), color: piece.color} as PropBox)
      solids.addSolid(center.x - width / 2, center.z - depth / 2, width, depth)
    end for
    for each kind in boxesByKind
      furniture = new BoxProp(m.game)
      m.game.addEntity(furniture, {x: 0, z: 0, boxes: boxesByKind[kind], name: "furniture"})
    end for
  end sub

  ' The furniture a layout character stands for
  private function furnitureFor(kind as string) as InteriorFurniture
    ' AA keys ignore case, so a place can't have furniture for both `p` and `P`
    return m.place.furniture[kind]
  end function

  ' The door, at the outer end of the doorway's gap, facing in. Assumes one doorway, its `E`
  ' cells side by side on the grid's edge.
  private sub addDoor()
    exits = m.layout.exits
    if exits.Count() = 0
      return
    end if
    first = exits[0]
    outward = "s"
    for each side in BGE.GridSides.all()
      delta = BGE.GridSides.offset(side)
      if not m.layout.isInside(first.col + delta[0], first.row + delta[1])
        outward = side
      end if
    end for
    ' the middle of the gap's cells
    middle = m.layout.cellCenter(first.col, first.row)
    last = m.layout.cellCenter(exits[exits.Count() - 1].col, exits[exits.Count() - 1].row)
    middle = BGE.Math.VectorOps.create((middle.x + last.x) / 2, 0, (middle.z + last.z) / 2)
    spot = m.onWall(middle, outward, World.metres(0.05))
    doorProp = new Prop(m.game)
    m.game.addEntity(doorProp, {x: spot.x, z: spot.z, bitmap: m.place.door, turn: BGE.GridSides.wallRotation(outward)})
  end sub

  ' A banner or window flat on the cell's first wall
  private sub addHanging(hanging as InteriorHanging, center as BGE.Math.Vector, side as string)
    spot = m.onWall(center, side, World.metres(0.05))
    bitmap = hanging.bitmaps[m.hangingCount mod hanging.bitmaps.Count()]
    m.hangingCount++
    hung = new Prop(m.game)
    m.game.addEntity(hung, {x: spot.x, z: spot.z, y: World.metres(hanging.bottom), bitmap: bitmap, turn: BGE.GridSides.wallRotation(side), unlit: hanging.unlit})
  end sub

  ' Torches, the hearth, candles, the throne, hangings and the people
  private sub addCellContents(cell as BGE.CharGridCell, solids as BGE.SolidWorld)
    center = m.layout.cellCenter(cell.col, cell.row)
    wallSides = m.layout.wallSides(cell.col, cell.row)
    ' AA lookups ignore case: don't let `F` take `f`'s hanging
    hanging = m.place.hangings[cell.kind] as InteriorHanging
    if invalid <> hanging and LCase(cell.kind) = cell.kind and wallSides.Count() > 0
      m.addHanging(hanging, center, wallSides[0])
    else if cell.kind = "t" and wallSides.Count() > 0
      spot = m.onWall(center, wallSides[0], 0)
      Dressing.addWallTorch(m.game, spot.x, spot.z, BGE.GridSides.wallRotation(wallSides[0]), FlameKind.fire)
    else if cell.kind = "H" and wallSides.Count() > 0
      m.addHearth(center, wallSides[0], solids)
    else if cell.kind = "c"
      Dressing.addLanternPost(m.game, center.x, center.z, FlameKind.fire, solids, 0.4)
    else if cell.kind = "R" and wallSides.Count() > 0
      m.addThrone(center, wallSides[0], solids)
    else if cell.kind = "L"
      m.addTalker(m.addPerson(m.lord, center, solids), "lord", "Lord Aldric")
    else if cell.kind = "P"
      m.addTalker(m.addPerson(m.priest, center, solids), "priest", "Father Edmund")
    end if
  end sub

  ' A point `inset` in from the middle of a cell's wall on `side`
  private function onWall(center as BGE.Math.Vector, side as string, inset as float) as BGE.Math.Vector
    delta = BGE.GridSides.offset(side)
    reach = World.metres(InteriorMap.CELL_METRES) / 2 - inset
    return BGE.Math.VectorOps.create(center.x + delta[0] * reach, 0, center.z + delta[1] * reach)
  end function

  ' A stone fireplace against the wall, a fire on the floor in front of it
  private sub addHearth(center as BGE.Math.Vector, side as string, solids as BGE.SolidWorld)
    delta = BGE.GridSides.offset(side)
    ' The block's long side along the wall
    alongX = delta[0] = 0
    deep = World.metres(0.9)
    wide = World.metres(2)
    back = m.onWall(center, side, deep / 2)
    slab = {x: back.x, y: 0, z: back.z, width: deep, depth: wide, height: World.metres(1.4), color: &h7A746CFF} as PropBox
    if alongX
      slab.width = wide
      slab.depth = deep
    end if
    m.addBoxes([slab], solids)
    fireSpot = m.onWall(center, side, deep + World.metres(0.3))
    fire = new Torch(m.game)
    m.game.addEntity(fire, {x: fireSpot.x, y: World.metres(0.05), z: fireSpot.z, kind: FlameKind.fire, size: 0.9})
    ' Not walked through
    half = World.metres(0.3)
    solids.addSolid(fireSpot.x - half, fireSpot.z - half, half * 2, half * 2)
  end sub

  ' A high-backed wooden throne against the wall
  private sub addThrone(center as BGE.Math.Vector, side as string, solids as BGE.SolidWorld)
    delta = BGE.GridSides.offset(side)
    alongX = delta[0] = 0
    backSpot = m.onWall(center, side, World.metres(0.15))
    seatSpot = m.onWall(center, side, World.metres(0.7))
    wood = &h6A4428FF
    back = {x: backSpot.x, y: 0, z: backSpot.z, width: World.metres(0.25), depth: World.metres(1.2), height: World.metres(2.4), color: wood} as PropBox
    seat = {x: seatSpot.x, y: 0, z: seatSpot.z, width: World.metres(0.9), depth: World.metres(1.2), height: World.metres(0.55), color: wood} as PropBox
    if alongX
      back.width = World.metres(1.2)
      back.depth = World.metres(0.25)
      seat.width = World.metres(1.2)
      seat.depth = World.metres(0.9)
    end if
    m.addBoxes([back, seat], solids)
  end sub

  private sub addBoxes(boxes as PropBox[], solids as BGE.SolidWorld)
    for each piece in boxes
      solids.addSolid(piece.x - piece.width / 2, piece.z - piece.depth / 2, piece.width, piece.depth)
    end for
    furniture = new BoxProp(m.game)
    m.game.addEntity(furniture, {x: 0, z: 0, boxes: boxes})
  end sub

  ' Someone standing still, facing the door
  private function addPerson(kind as TownsfolkType, center as BGE.Math.Vector, solids as BGE.SolidWorld) as Townsfolk
    person = new Townsfolk(m.game)
    m.game.addEntity(person, {type: kind, x: center.x, z: center.z, heading: BGE.Math.PI, idleRate: 4})
    half = World.metres(0.3)
    solids.addSolid(center.x - half, center.z - half, half * 2, half * 2)
    return person
  end function

  ' The people standing in this place's layout (`L` the lord, `P` the priest)
  private function peopleHere() as TownsfolkType[]
    people = [] as TownsfolkType[]
    lord = false
    priest = false
    for each line in m.place.layout
      ' Case-sensitive: `p` is a pew
      lord = lord or Instr(1, line, "L") > 0
      priest = priest or Instr(1, line, "P") > 0
    end for
    if lord
      people.push(m.lord)
    end if
    if priest
      people.push(m.priest)
    end if
    return people
  end function

  override sub onUpdate(dt as float)
    if m.beginUpdate(dt)
      return
    end if
    m.exits.update(m.knight.position)
  end sub

end class
