import "../World.bs"
import "../Entities/Torch.bs"
import "../Entities/Prop.bs"
import "../Entities/CryptDoorway.bs"
import "../Entities/Enemy.bs"
import "../Entities/EnemyTypes.bs"
import "../Crypt/CryptMap.bs"
import "../Crypt/CryptLevels.bs"
import "../Crypt/CryptCameraBoom.bs"
import "ThirdPersonScene.bs"
import "pkg:/source/engine/sceneFlow/SpawnPoints.bs"

' A torch-lit stone maze under the graveyard, three levels deep (CryptLevels; args.level, 1 by
' default). The undead sleep in its corridors until they see the knight, then find their way
' round the walls to him; a boss guards the first level's way down and the last level's altar.
' Each level's `E` leads up (to the graveyard from the first) and its `D` down.
class CryptScene extends ThirdPersonScene

  ' World units per floor texel, as the field's grass
  floorTexelScale as float = 2
  ' Skeletons wake when the knight is this close and in sight
  wakeDistance as float = World.metres(12)
  ' A boss wakes when he's this close: inside its hall
  bossWakeDistance as float = World.metres(8)
  ' Which CryptLevels level this visit is, from 1
  level as integer = 1

  private layout as CryptLayout
  ' For the undead: paths round the walls, and whether they can see the knight
  private nav as BGE.NavGrid
  private levelInfo as CryptLevel
  ' The enemy kinds by their layout character, made once per visit
  private enemyKinds as roAssociativeArray = {}
  ' Every cell an enemy starts on, boss included
  private enemySpots as CryptCell[] = []
  private boss as Enemy = invalid
  private showEnemies as boolean = true
  ' While the boss lives, a solid and a wall of spirit fire close the way down
  private sealSolidId as string = ""
  private sealInside as CryptCell
  private sealFlames as Torch[] = []
  private bitmapPaths as roAssociativeArray = {
    cryptFloor: "pkg:/sprites/crypt_floor.webp",
    cryptWall: "pkg:/sprites/crypt_wall.webp",
    cryptAlcove: "pkg:/sprites/crypt_alcove.webp",
    cryptRubble: "pkg:/sprites/crypt_rubble.webp",
    cryptBones: "pkg:/sprites/crypt_bones.webp",
    cryptAltar: "pkg:/sprites/crypt_altar.webp"
  }

  sub new(game as BGE.Game)
    super(game)
    m.name = "CryptScene"
    ' a fixed draw distance, so walls don't reach farther or cut off nearer as the level changes
    m.qualityOptions = {targetFps: 20, fixedDrawDistance: true}
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    m.level = m.levelFrom(args)
    m.levelInfo = CryptLevels.get(m.level)
    m.enemyKinds = m.enemyKindsIn(m.levelInfo)
    m.loadKnightAtlas(loader)
    for each key in m.enemyKinds
      kind = m.enemyKinds[key] as EnemyType
      m.loadSceneAtlas(loader, kind.atlas)
    end for
    m.loadSceneBitmaps(loader, m.bitmapPaths)
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.readCommonArgs(args)
    m.hud.showBanner(m.levelInfo.name, 4)
    m.boss = invalid
    m.enemySpots = []
    m.sealSolidId = ""
    m.sealFlames = []
    m.game.setBackgroundColor(&h000000FF)
    m.layout = CryptMap.parse(m.levelInfo.layout)

    floorBmp = m.game.getBitmap("cryptFloor")
    floorRegion = CreateObject("roRegion", floorBmp, 0, 0, floorBmp.GetWidth(), floorBmp.GetHeight())
    floor = new BGE.DrawablePlane(m, floorRegion, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {
      fillMode: BGE.PlaneFillMode.tiledImage,
      scale: BGE.Math.VectorOps.create(m.floorTexelScale, m.floorTexelScale, 1)
    })
    floor.isShaded = true
    m.addDrawable("Floor", floor)

    ' Just enough cold light that unlit stone isn't pure black
    m.addSceneLight(new BGE.AmbientLight(m.levelInfo.ambientColor, m.levelInfo.ambientIntensity))

    m.addWalls()
    for each cell in m.layout.cells
      m.addCellContents(cell)
    end for

    ' Where he arrives, by the way he came in (args.from). Down from above (or the graveyard):
    ' just inside the way up, facing into the maze. Up from below: just inside the way down -
    ' unless its boss still lives (only by deep link), which would wake beside you. A fresh
    ' start: the `S` cell, or the way up without one.
    spawns = new BGE.SpawnPoints("from")
    if invalid <> m.layout.startCell
      spawns.add("start", m.centerOf(m.layout.startCell), m.openHeading(m.layout.startCell))
    end if
    bossAlive = invalid <> m.levelInfo.boss and not m.isBossSlain()
    belowOpen = invalid <> m.layout.downCell and not bossAlive
    if invalid <> m.layout.exitCell
      wayUp = m.centerOf(m.insideOf(m.layout.exitCell))
      upHeading = m.awayFrom(m.layout.exitCell)
      spawns.add("above", wayUp, upHeading)
      spawns.add("graveyard", wayUp, upHeading)
      if not belowOpen
        spawns.add("below", wayUp, upHeading)
      end if
    end if
    if belowOpen
      spawns.add("below", m.centerOf(m.insideOf(m.layout.downCell)), m.awayFrom(m.layout.downCell))
    end if
    spawn = spawns.resolve(args, "start")
    startCenter = spawn.position
    heading = spawn.heading
    at = m.parseAt()
    if invalid <> at
      start = {col: at.col, row: at.row, kind: "."} as CryptCell
      startCenter = m.centerOf(start)
      heading = m.openHeading(start)
      if at.hasHeading
        heading = at.heading
      end if
    end if
    m.addKnight(startCenter.x, startCenter.z, heading)
    ' Back up the way in (to the graveyard from the first level), and down the way down
    if invalid <> m.layout.exitCell
      if m.level = 1
        m.exits.add(CryptMap.cellArea(m.layout, m.layout.exitCell), "GraveyardScene", {from: "crypt"})
      else
        m.exits.add(CryptMap.cellArea(m.layout, m.layout.exitCell), "CryptScene", {level: m.level - 1, from: "below"})
      end if
    end if
    if invalid <> m.layout.downCell
      m.exits.add(CryptMap.cellArea(m.layout, m.layout.downCell), "CryptScene", {level: m.level + 1, from: "above"})
    end if
    ' Short: the maze's corridors turn every cell or two, so little past it would show
    m.setUpCamera(m.drawDistance(24), 0.5, m.wallTopCameraTilt)
    m.useDarkFog()
    solids = CryptMap.solidWorld(m.layout)
    m.useSolids(solids)
    ' Grown by the biggest body, so paths keep every body clear of the walls
    agentRadius = World.metres(0.4)
    for each key in m.enemyKinds
      agentRadius = BGE.Math.Max(agentRadius, m.enemyKinds[key].bodyRadius)
    end for
    m.nav = new BGE.NavGrid(solids, {cellSize: World.metres(1), agentRadius: agentRadius})
    ' Measuring: `enemies=0` leaves the undead out
    m.showEnemies = args.enemies <> "0"
    m.addUndead()
    if invalid <> m.layout.downCell and invalid <> m.boss
      m.sealWayDown(solids)
    end if
  end sub

  ' Level from args.level: an integer from a scene change, a string from a deep link
  private function levelFrom(args as roAssociativeArray) as integer
    params = new BGE.LaunchParams(args)
    return params.getInt("level", 1, 1, CryptLevels.count())
  end function

  ' Which EnemyType each enemy character in the level's layout stands for
  private function enemyKindsIn(info as CryptLevel) as roAssociativeArray
    makers = {u: EnemyTypes.skeleton, g: EnemyTypes.ghoul, o: EnemyTypes.graveBrute}
    kinds = {}
    for each row in info.layout
      for i = 1 to Len(row)
        ch = Mid(row, i, 1)
        if ch = "W" and invalid <> info.boss
          kinds["W"] = info.boss
        else if invalid <> makers[ch] and invalid = kinds[ch]
          maker = makers[ch]
          kinds[ch] = maker()
        end if
      end for
    end for
    return kinds
  end function

  ' The heading that walks out of a doorway cell into the maze
  private function awayFrom(doorway as CryptCell) as float
    delta = CryptMap.sideStep(m.firstOpenSide(doorway))
    return BGE.Math.headingOf(BGE.Math.VectorOps.create(delta[0], 0, delta[1]))
  end function

  ' World x/z of the middle of a cell
  private function centerOf(cell as CryptCell) as BGE.Math.Vector
    return CryptMap.cellCenter(m.layout, cell.col, cell.row)
  end function

  ' The floor cell next to a doorway cell (`E` or `D`), into the maze
  private function insideOf(cell as CryptCell) as CryptCell
    delta = CryptMap.sideStep(m.firstOpenSide(cell))
    return {col: cell.col + delta[0], row: cell.row + delta[1], kind: "."} as CryptCell
  end function

  ' An enemy on each of the level's enemy cells, asleep and facing the way in to their cell;
  ' the boss only until it has been killed
  private sub addUndead()
    m.boss = invalid
    if not m.showEnemies
      return
    end if
    for each cell in m.enemySpots
      kind = m.enemyKinds[cell.kind] as EnemyType
      if cell.kind <> "W"
        m.addEnemy(kind, cell, m.wakeDistance)
      else if not m.isBossSlain()
        m.boss = m.addEnemy(kind, cell, m.bossWakeDistance)
      end if
    end for
  end sub

  ' Blocks the way down with a solid and a row of spirit flames across the doorway
  private sub sealWayDown(solids as BGE.SolidWorld)
    cell = m.layout.downCell
    size = World.metres(CryptMap.CELL_METRES)
    center = CryptMap.cellCenter(m.layout, cell.col, cell.row)
    m.sealSolidId = solids.addSolid(center.x - size / 2, center.z - size / 2, size, size)
    m.sealInside = m.insideOf(cell)
    side = m.firstOpenSide(cell)
    doorway = m.onWall(center, side, World.metres(0.3))
    ' Along the doorway: across the side's normal
    delta = CryptMap.sideStep(side)
    for i = -1 to 1
      flame = new Torch(m.game)
      offset = i * World.metres(1.6)
      m.game.addEntity(flame, {x: doorway.x + delta[1] * offset, y: World.metres(0.2), z: doorway.z + delta[0] * offset, kind: FlameKind.spirit})
      m.sealFlames.push(flame)
    end for
  end sub

  private sub unsealWayDown()
    if m.sealSolidId <> ""
      m.walls.removeSolid(m.sealSolidId)
      m.sealSolidId = ""
    end if
    for each flame in m.sealFlames
      flame.invalidate()
    end for
    m.sealFlames = []
  end sub

  private function addEnemy(kind as EnemyType, cell as CryptCell, wakeDistance as float) as Enemy
    spot = CryptMap.cellCenter(m.layout, cell.col, cell.row)
    foe = new Enemy(m.game)
    m.game.addEntity(foe, {
      type: kind,
      director: m.director,
      x: spot.x,
      z: spot.z,
      heading: m.openHeading(cell),
      wakeDistance: wakeDistance,
      nav: m.nav
    })
    m.trackBody(foe)
    return foe
  end function

  ' Once killed, a boss stays dead for the rest of the run, even after the knight dies
  private function isBossSlain() as boolean
    slain = GetGlobalAA().cryptBossesSlain
    return invalid <> slain and slain[m.level.toStr()] = true
  end function

  ' Remembered for the run (so the boss stays dead) and posted for the story's rules
  ' (town.json: cryptBossSlain by level)
  private sub markBossSlain()
    globals = GetGlobalAA()
    if invalid = globals.cryptBossesSlain
      globals.cryptBossesSlain = {}
    end if
    globals.cryptBossesSlain[m.level.toStr()] = true
    m.game.postGameEvent("cryptBossSlain", {level: m.level.toStr()})
  end sub

  ' Every wall from the same grid: one drawable however many walls there are
  private sub addWalls()
    tile = m.game.getBitmap("cryptWall")
    ' The 2 m tile three times across a cell, so texels stay square
    tilesPerCell = CryptMap.CELL_METRES / CryptMap.SEGMENT_METRES
    bmp = CreateObject("roBitmap", {width: tile.GetWidth() * tilesPerCell, height: tile.GetHeight(), AlphaEnable: false})
    for i = 0 to tilesPerCell - 1
      bmp.DrawObject(i * tile.GetWidth(), 0, tile)
    end for
    bmp.Finish()
    region = CreateObject("roRegion", bmp, 0, 0, bmp.GetWidth(), bmp.GetHeight())
    size = World.metres(CryptMap.CELL_METRES)
    map = new BGE.GridWallsMap(m.levelInfo.layout, {
      cellSize: size,
      wallHeight: World.metres(CryptMap.WALL_METRES),
      origin: BGE.Math.VectorOps.create(-m.layout.cols * size / 2, 0, -m.layout.rows * size / 2),
      solid: {"#": "stone"}
    })
    ' Torches hang just off a wall, so their own wall is lit edge-on; wrap lets it glow
    walls = new BGE.DrawableGridWalls(m, map, {stone: region}, {isShaded: true, lightWrap: 0.5, castsFogSilhouette: true})
    m.addDrawable("Walls", walls)
  end sub

  ' Torches, props and doorways for one floor cell
  private sub addCellContents(cell as CryptCell)
    center = CryptMap.cellCenter(m.layout, cell.col, cell.row)
    wallSides = CryptMap.wallSides(m.layout, cell.col, cell.row)
    if cell.kind = "T" and wallSides.Count() > 0
      m.addTorch(center, wallSides[0], m.levelInfo.torchKind)
    else if cell.kind = "k" and wallSides.Count() > 0
      spot = m.onWall(center, wallSides[0], World.metres(0.05))
      cryptProp = new Prop(m.game)
      m.game.addEntity(cryptProp, {x: spot.x, z: spot.z, bitmap: "cryptAlcove", turn: CryptMap.sideTurn(wallSides[0]) + BGE.Math.PI})
    else if cell.kind = "A" and wallSides.Count() > 0
      spot = m.onWall(center, wallSides[0], World.metres(1))
      cryptProp = new Prop(m.game)
      m.game.addEntity(cryptProp, {x: spot.x, z: spot.z, bitmap: "cryptAltar"})
      m.addTorch(center, wallSides[0], FlameKind.spirit)
      m.addDoorway(cell)
    else if cell.kind = "r" or cell.kind = "b"
      bitmap = "cryptRubble"
      if cell.kind = "b"
        bitmap = "cryptBones"
      end if
      ' Off to one side, out of the middle of the corridor
      spot = center
      if wallSides.Count() > 0
        spot = m.onWall(center, wallSides[0], World.metres(0.8))
      end if
      cryptProp = new Prop(m.game)
      m.game.addEntity(cryptProp, {x: spot.x, z: spot.z, bitmap: bitmap})
    else if cell.kind = "E" or cell.kind = "D"
      m.addDoorway(cell)
    else if invalid <> m.enemyKinds[cell.kind]
      m.enemySpots.push(cell)
    end if
  end sub

  ' A point `inset` in from the middle of a cell's wall on `side`
  private function onWall(center as BGE.Math.Vector, side as string, inset as float) as BGE.Math.Vector
    delta = CryptMap.sideStep(side)
    reach = World.metres(CryptMap.CELL_METRES) / 2 - inset
    return BGE.Math.VectorOps.create(center.x + delta[0] * reach, 0, center.z + delta[1] * reach)
  end function

  private sub addTorch(center as BGE.Math.Vector, side as string, kind as FlameKind)
    spot = m.onWall(center, side, World.metres(0.2))
    flame = new Torch(m.game)
    m.game.addEntity(flame, {x: spot.x, y: World.metres(2.4), z: spot.z, kind: kind})
  end sub

  ' A doorway frame across the cell's way in (its first open side)
  private sub addDoorway(cell as CryptCell)
    side = m.firstOpenSide(cell)
    center = CryptMap.cellCenter(m.layout, cell.col, cell.row)
    spot = m.onWall(center, side, 0)
    doorway = new CryptDoorway(m.game)
    m.game.addEntity(doorway, {x: spot.x, z: spot.z, turn: CryptMap.sideTurn(side), width: World.metres(CryptMap.CELL_METRES)})
  end sub

  private function firstOpenSide(cell as CryptCell) as string
    for each side in CryptMap.sides()
      delta = CryptMap.sideStep(side)
      if not CryptMap.isSolid(m.layout, cell.col + delta[0], cell.row + delta[1])
        return side
      end if
    end for
    return "n"
  end function

  ' The heading that looks out of a cell through its first open side
  private function openHeading(cell as CryptCell) as float
    delta = CryptMap.sideStep(m.firstOpenSide(cell))
    return BGE.Math.headingOf(BGE.Math.VectorOps.create(delta[0], 0, delta[1]))
  end function

  override sub onDestroy()
    super.onDestroy()
    m.sealFlames = []
  end sub

  ' Start over: the undead back in their places and asleep
  protected override sub onRespawn()
    m.addUndead()
  end sub

  override sub onUpdate(dt as float)
    skip = m.beginUpdate(dt)
    m.updateBoss(dt)
    if skip
      return
    end if
    m.exits.update(m.knight.position)
  end sub

  private function isCell(colRow as integer[], cell as CryptCell) as boolean
    return invalid <> cell and colRow[0] = cell.col and colRow[1] = cell.row
  end function

  ' True when the knight stands next to the sealed way down
  private function isAtSeal() as boolean
    if m.sealSolidId = "" or not m.knight.isAlive()
      return false
    end if
    here = CryptMap.cellAt(m.layout, m.knight.position.x, m.knight.position.z)
    return m.isCell(here, m.sealInside)
  end function

  ' Notices the boss's death: remembered for the run, announced, and the way down opens
  private sub updateBoss(dt as float)
    if invalid <> m.boss and not m.boss.isAlive()
      m.markBossSlain()
      m.boss = invalid
      if invalid <> m.levelInfo.bossBanner
        m.hud.showBanner(m.levelInfo.bossBanner, 5)
      else
        m.hud.hideBanner()
      end if
      m.unsealWayDown()
    end if
  end sub

  ' The level's name as you arrive, the boss's health along the bottom once it wakes, and the
  ' banner when it falls
  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    super.onDrawEnd(renderObj, uiRenderObj)
    font = m.game.getFont("default")
    if invalid <> m.boss and m.boss.isAwake() and m.knight.isAlive()
      m.hud.drawBossBar(uiRenderObj, m.boss.name, m.boss.health.current, m.boss.health.max)
    end if
    ' a banner doesn't outlive the knight
    if not m.knight.isAlive()
      m.hud.hideBanner()
    end if
    m.hud.drawBanner(uiRenderObj)
    if m.isAtSeal()
      center = uiRenderObj.getCanvasCenter()
      uiRenderObj.DrawText("Spirit fire seals the way down", center.x, center.y * 1.4, &hC8D8FFFF, font, "center")
    end if
  end sub

  ' Walls stop the camera by the grid, so they need no colliders
  protected override function makeCameraBoom(args as roAssociativeArray) as BGE.CameraBoom
    return new CryptCameraBoom(m.game, m.layout, args)
  end function

end class
