import "../World.bs"
import "../Night.bs"
import "../Entities/Enemy.bs"
import "../Entities/EnemyTypes.bs"
import "../Entities/Pillar.bs"
import "../Entities/Prop.bs"
import "../Entities/PropModel.bs"
import "../Entities/Torch.bs"
import "../Dressing.bs"
import "../Graveyard/GraveyardMap.bs"
import "../Town/TownMap.bs"
import "ThirdPersonScene.bs"
import "pkg:/source/engine/sceneFlow/SpawnPoints.bs"
import "pkg:/source/engine/sceneFlow/ExitArea.bs"

' A building GraveyardScene places on a group of cells: its size in metres, and how far its .obj's
' origin is from the middle of its base
interface GraveyardBuilding extends roAssociativeArray
  model as string
  width as float
  height as float
  depth as float
  ' The model's base runs from -depth/2 + centerZ to depth/2 + centerZ
  centerZ as float
  ' Whether the camera boom pulls in front of it (default true): each blocker costs a ray test
  optional blocksCamera as boolean
end interface

' A fenced churchyard at night above the crypt, laid out by GraveyardMap: graves, trees, a chapel,
' the gravedigger's hut and the mausoleum whose door leads down into the crypt. Skeletons stand
' among the graves until the knight comes near. The gap in the fence leads back to the town.
class GraveyardScene extends ThirdPersonScene

  ' World units per grass texel, as the field
  groundTexelScale as float = 2
  ' Skeletons wake when the knight is this close
  wakeDistance as float = World.metres(10)

  protected layout as GraveyardLayout
  private skeletonType as EnemyType = EnemyTypes.skeleton()
  private skeletonSpots as BGE.CharGridCell[] = []
  ' The way in from the town (`@`)
  private gateCell as BGE.CharGridCell
  ' The middle of the chapel's doorway on its front wall (it faces +z)
  private chapelDoor as BGE.Math.Vector
  private showSkeletons as boolean = true

  ' Bitmaps other scenes use too (the field's grass, the town's props), kept when the scene ends
  private sharedBitmapPaths as roAssociativeArray = {
    grass: "pkg:/sprites/grass.webp",
    nightSky: "pkg:/sprites/night_sky.webp",
    propsAtlas: "pkg:/models/props/props_atlas.png"
  }
  ' Bitmaps only this scene uses, freed when it ends
  private bitmapPaths as roAssociativeArray = {
    graveSlab: "pkg:/models/props/grave_slab.png",
    graveCross: "pkg:/models/props/grave_cross.png",
    graveBroken: "pkg:/models/props/grave_broken.png",
    ' white, clear at the top and bottom: the fog backdrop's soft edges
    fog: "pkg:/sprites/fog.webp"
  }
  private modelPaths as roAssociativeArray = {
    chapel: "pkg:/models/chapel/chapel.obj",
    mausoleum: "pkg:/models/props/crypt.obj",
    hut: "pkg:/models/props/hut.obj",
    well: "pkg:/models/props/well.obj",
    bonfire: "pkg:/models/props/bonfire.obj"
  }
  private graveBitmaps as string[] = ["graveSlab", "graveCross", "graveBroken"]

  sub new(game as BGE.Game)
    super(game)
    m.name = "GraveyardScene"
    m.qualityOptions = {targetFps: 20}
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    m.loadSceneAtlas(loader, "knight", true)
    m.loadSceneAtlas(loader, m.skeletonType.atlas)
    m.loadWorld(loader)
  end sub

  ' The graveyard's bitmaps and models, without the characters (the title screen's backdrop)
  protected sub loadWorld(loader as BGE.AssetLoader)
    m.loadSceneBitmaps(loader, m.sharedBitmapPaths, true)
    m.loadSceneBitmaps(loader, m.bitmapPaths)
    m.loadSceneBitmaps(loader, Dressing.treeBitmapPaths())
    m.loadSceneModels(loader, m.modelPaths)
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.readCommonArgs(args)
    solids = m.buildWorld()
    m.addBonfires(m.layout, solids)

    ' Where he arrives, by the scene he came from (args.from)
    spawns = new BGE.SpawnPoints("from")
    ' Through the gap in the fence from the town, or a fresh start: by the gate, facing in
    spawns.add("town", m.layout.cellCenter(m.gateCell.col, m.gateCell.row))
    if invalid <> m.chapelDoor
      ' Out of the chapel: a few metres from its door, facing away from it
      spawns.add("chapel", BGE.Math.VectorOps.add(m.chapelDoor, BGE.Math.VectorOps.create(0, 0, World.metres(2.5))), BGE.Math.PI)
    end if
    ' Up from the crypt: a few metres out from the mausoleum's door, facing away from it, so the
    ' camera behind him isn't inside the mausoleum
    doorstep = m.layout.groups.D as BGE.CharGridGroup
    spawns.add("crypt", m.layout.cellCenter(doorstep.col + (doorstep.cols - 1) / 2, doorstep.row + doorstep.rows + 2), BGE.Math.PI)
    spawn = spawns.resolve(args, "town")
    spot = spawn.position
    heading = spawn.heading
    wake = m.bonfireWake(args)
    if invalid <> wake
      spot = BGE.Math.VectorOps.create(wake.x, 0, wake.z)
      heading = wake.heading
    end if
    at = m.parseAt()
    if invalid <> at
      ' Measuring: starts in another cell
      spot = m.layout.cellCenter(at.col, at.row)
      heading = at.heading
    end if
    m.addKnight(spot.x, spot.z, heading)
    ' Down into the crypt, back through the fence to the town, and walking up to the chapel's door
    m.exits.add(World.groupArea(m.layout, doorstep), "CryptScene", {from: "graveyard"})
    m.exits.add(World.groupArea(m.layout, m.layout.groups.E as BGE.CharGridGroup), "TownScene", {from: "graveyard"})
    if invalid <> m.chapelDoor
      m.exits.add(new BGE.CircleExitArea(m.chapelDoor, World.metres(1.2)), "InteriorScene", {place: "chapel"})
    end if
    ' Short like the town's, its end hidden by the same fog: the chapel and trees cost a lot to
    ' redraw while the camera moves
    m.setUpCamera(m.drawDistance(32), 0.5, 0)
    m.useTownFog(args)
    m.useSolids(solids)
    ' Measuring: `enemies=0` leaves the skeletons out
    m.showSkeletons = args.enemies <> "0"
    m.addSkeletons()
  end sub

  ' The graveyard without anyone in it: ground, sky, lights, fences, buildings, graves, trees and
  ' torches. Returns the solids bodies keep out of.
  protected function buildWorld() as BGE.SolidWorld
    m.skeletonSpots = []
    ' The sky texture's zenith, for anything past its top
    m.game.setBackgroundColor(&h080E28FF)
    layout = new GraveyardLayout(GraveyardMap.layout())
    m.layout = layout

    grassBmp = m.game.getBitmap("grass")
    ground = new BGE.DrawablePlane(m, CreateObject("roRegion", grassBmp, 0, 0, grassBmp.GetWidth(), grassBmp.GetHeight()), {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {
      fillMode: BGE.PlaneFillMode.tiledImage,
      scale: BGE.Math.VectorOps.create(m.groundTexelScale, m.groundTexelScale, 1)
    })
    ground.isShaded = true
    m.addDrawable("Ground", ground)
    skyBmp = m.game.getBitmap("nightSky")
    m.addDrawable("Sky", new BGE.DrawableSkybox(m, CreateObject("roRegion", skyBmp, 0, 0, skyBmp.GetWidth(), skyBmp.GetHeight())))
    Night.addLights(m)

    ' just the wall round the grid: nothing is solid by its character
    solids = m.layout.toSolidWorld()
    m.addFences(solids)
    m.addBuildings(solids)
    for each cell in m.layout.cells
      m.addCellContents(cell, solids)
    end for
    return solids
  end function

  ' One wall per straight run of fence, a thin solid along it, and a stone post either side of the
  ' gate
  private sub addFences(solids as BGE.SolidWorld)
    pickets = Dressing.picketRegion(m.game)
    for each fenceRun in m.layout.fenceRuns
      first = m.layout.cellCenter(fenceRun.col, fenceRun.row)
      last = m.layout.cellCenter(fenceRun.col + fenceRun.cols - 1, fenceRun.row + fenceRun.rows - 1)
      Dressing.addFence(m.game, first, last, pickets, solids)
    end for

    gate = m.layout.groups.E as BGE.CharGridGroup
    for each col in [gate.col - 1, gate.col + gate.cols]
      spot = m.layout.cellCenter(col, gate.row)
      post = new Pillar(m.game)
      width = World.metres(0.5)
      ' Static rectangles, like the lantern posts: too small to need blocking the camera
      m.game.addEntity(post, {x: spot.x, z: spot.z, width: width, height: World.metres(1.6), style: "rect", blocksCamera: false})
      solids.addSolid(spot.x - width / 2, spot.z - width / 2, width, width)
    end for
  end sub

  ' The chapel, mausoleum and hut, each centred on its group of cells
  private sub addBuildings(solids as BGE.SolidWorld)
    buildings = {
      ' The chapel's .obj runs from z -5.35 (the tower) to 7.6 (the door)
      p: {model: "chapel", width: 6.8, height: 13.2, depth: 12.95, centerZ: 1.125},
      c: {model: "mausoleum", width: 3.6, height: 3.6, depth: 4.5, centerZ: 0},
      h: {model: "hut", width: 4, height: 4.6, depth: 5, centerZ: 0}
    }
    for each kind in buildings
      group = m.layout.groups[kind] as BGE.CharGridGroup
      if group <> invalid
        building = buildings[kind] as GraveyardBuilding
        center = m.layout.groupCenter(group)
        m.addBuilding(center, building, solids)
        if kind = "p"
          m.chapelDoor = BGE.Math.VectorOps.create(center.x, 0, center.z + World.metres(building.depth / 2))
        end if
        if kind = "h"
          ' A torch on a post beside the hut's door: its walls are too low for a wall bracket
          flame = new Torch(m.game)
          spotX = center.x + World.metres(1.6)
          spotZ = center.z + World.metres(building.depth / 2 + 0.7)
          m.game.addEntity(flame, {x: spotX, y: World.metres(1.9), z: spotZ, kind: FlameKind.fire, post: true})
          half = World.metres(0.15)
          solids.addSolid(spotX - half, spotZ - half, half * 2, half * 2)
        end if
      end if
    end for
  end sub

  private sub addBuilding(center as BGE.Math.Vector, building as GraveyardBuilding, solids as BGE.SolidWorld)
    width = World.metres(building.width)
    depth = World.metres(building.depth)
    entity = new PropModel(m.game)
    m.game.addEntity(entity, {
      x: center.x,
      z: center.z,
      model: building.model,
      width: width,
      height: World.metres(building.height),
      depth: depth,
      shiftZ: -World.metres(building.centerZ),
      castsFog: true,
      blocksCamera: building.blocksCamera ?? true
    })
    solids.addSolid(center.x - width / 2, center.z - depth / 2, width, depth)
  end sub

  ' Graves, trees, the well, lantern posts, and where skeletons and the knight start
  private sub addCellContents(cell as BGE.CharGridCell, solids as BGE.SolidWorld)
    center = m.layout.cellCenter(cell.col, cell.row)
    jitter = World.metres(GraveyardMap.CELL_METRES) * 0.3
    if cell.kind = "g"
      x = center.x + (BGE.Math.hash2(cell.col, cell.row, 1) - 0.5) * jitter
      z = center.z + (BGE.Math.hash2(cell.col, cell.row, 2) - 0.5) * jitter
      bitmap = m.graveBitmaps[Int(BGE.Math.hash2(cell.col, cell.row, 3) * m.graveBitmaps.Count())]
      grave = new Prop(m.game)
      ' The 32 x 48 px stones are drawn at 0.6 x 0.9 m
      m.game.addEntity(grave, {x: x, z: z, bitmap: bitmap, scale: World.metres(0.9) / 48})
      half = World.metres(0.3)
      solids.addSolid(x - half, z - half, half * 2, half * 2)
    else if cell.kind = "T"
      x = center.x + (BGE.Math.hash2(cell.col, cell.row, 1) - 0.5) * jitter
      z = center.z + (BGE.Math.hash2(cell.col, cell.row, 2) - 0.5) * jitter
      Dressing.addTree(m.game, x, z, BGE.Math.hash2(cell.col, cell.row, 3), BGE.Math.hash2(cell.col, cell.row, 4), solids)
    else if cell.kind = "W"
      ' Too low to need blocking the camera, as in the town
      m.addBuilding(center, {model: "well", width: 1.8, height: 2.4, depth: 1.8, centerZ: 0, blocksCamera: false} as GraveyardBuilding, solids)
    else if cell.kind = "s"
      Dressing.addLanternPost(m.game, center.x, center.z, FlameKind.spirit, solids)
    else if cell.kind = "l"
      Dressing.addLanternPost(m.game, center.x, center.z, FlameKind.fire, solids)
    else if cell.kind = "S"
      m.skeletonSpots.push(cell)
    else if cell.kind = "@"
      m.gateCell = cell
    end if
  end sub

  ' A skeleton on each `S`, facing the gate, asleep until the knight comes near; every other one
  ' lies as a heap of bones until then
  private sub addSkeletons()
    if not m.showSkeletons
      return
    end if
    for i = 0 to m.skeletonSpots.Count() - 1
      cell = m.skeletonSpots[i]
      spot = m.layout.cellCenter(cell.col, cell.row)
      skeleton = new Enemy(m.game)
      m.game.addEntity(skeleton, {
        type: m.skeletonType,
        director: m.director,
        x: spot.x,
        z: spot.z,
        heading: BGE.Math.PI,
        wakeDistance: m.wakeDistance,
        rise: i mod 2 = 0
      })
      m.trackBody(skeleton)
    end for
  end sub

  ' Start over: every skeleton back on its feet and asleep
  protected override sub onRespawn()
    m.addSkeletons()
  end sub

  override sub onUpdate(dt as float)
    if m.beginUpdate(dt)
      return
    end if
    m.exits.update(m.knight.position)
  end sub

end class
