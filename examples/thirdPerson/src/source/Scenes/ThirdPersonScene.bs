import "../World.bs"
import "../Entities/Knight.bs"
import "../CombatDirector.bs"
import "../Hud.bs"
import "../PerfLog.bs"
import "../TownStory.bs"
import "pkg:/source/story/DialogueView.bs"
import "pkg:/source/utils/Interactables.bs"
import "pkg:/source/engine/ui/Theme.bs"
import "pkg:/source/engine/colliders/SolidWorld.bs"
import "pkg:/source/engine/sceneFlow/SceneExits.bs"
import "pkg:/source/utils/RespawnTimer.bs"
import "pkg:/source/utils/deviceRenderTier.bs"
import "pkg:/source/engine/renderer/cameras/GridWallsCameraBoom.bs"

' The `at=<col>,<row>[,<heading in degrees>]` deep link (see ThirdPersonScene.parseAt())
interface AtCell extends roAssociativeArray
  col as integer
  row as integer
  ' Radians, when given
  heading as float
  hasHeading as boolean
end interface

' What every playable scene shares: the knight, the chase camera, the HUD, the control hints,
' respawning and the walls bodies slide along. Subclasses load in onLoad() with
' loadSceneBitmaps()/loadSceneAtlas()/loadSceneModels() (the engine frees what a visit owns and
' its lights, added with addLight(), when the game leaves the scene), build
' their world in onCreate() and call addKnight(), then add their ways out to `exits`, and
' setUpCamera(), start onUpdate() with beginUpdate() then `m.exits.update(m.knight.position)`,
' and call super.onDestroy().
class ThirdPersonScene extends BGE.GameScene

  knight as Knight
  cameraRig as BGE.OrbitCamera
  director as CombatDirector = new CombatDirector()
  hud as Hud = invalid
  ' Bodies slide along these (useSolids()); invalid in a scene with no walls
  walls as BGE.SolidWorld = invalid
  ' The wait after a death before the knight is back where he started (delaySeconds)
  respawnTimer as BGE.RespawnTimer = new BGE.RespawnTimer(3.0)
  ' How far up the camera may tilt (radians) under the 4 m walls of the crypt and the interiors,
  ' so it stays below their tops
  wallTopCameraTilt as float = 0.45

  ' Ways out of the scene, cleared by addKnight(); once one is taken there's nothing more to do
  ' this visit
  protected exits as BGE.SceneExits
  ' Grid walls (crypt, interiors), set before setUpCamera() so the camera boom marches them
  protected wallsMap as BGE.GridWallsMap
  ' Where addKnight() put him, and where he respawns
  protected startX as float = 0
  protected startZ as float = 0

  ' People the knight can talk to (addTalker()), the one in reach, and the dialogue box while a
  ' conversation is open (it pauses the game)
  talkers as BGE.Interactables = new BGE.Interactables()
  talkTarget as BGE.Interactable = invalid
  talkView as BGE.Story.DialogueView = invalid
  ' How far away, and how far either side of where he faces, someone can be talked to
  talkReach as float = World.metres(2.4)

  ' Camera spin speed with no input (deep link `orbit`), for repeatable measurements
  autoOrbit as float = 0
  ' Stop-start orbit (deep link `orbitPause=<still s>,<move s>`), for the still-to-moving frames
  orbitStillSeconds as float = 0
  orbitMoveSeconds as float = 0
  orbitClock as float = 0
  ' Walk straight forward then back, this many seconds each way (deep link `walk`), for
  ' repeatable measurements moving along models rather than round them
  walkSeconds as float = 0
  walkClock as float = 0
  ' The camera's starting tilt in radians (deep link `tilt`), looking down past its rest
  startTilt as float = 0
  ' Locked on, the middle of the screen the enemy can move in without the camera turning, as a
  ' fraction of its width (deep link `lockZone`, 0 keeps it centred)
  lockDeadZone as float = 0.2
  perfLog as PerfLog
  ' This visit's args, set by readCommonArgs() (which every scene's onCreate() calls first)
  protected params as BGE.LaunchParams = new BGE.LaunchParams()

  sub new(game as BGE.Game)
    super(game)
    m.hud = new Hud(game)
    m.exits = new BGE.SceneExits(game)
  end sub

  ' Deep links every scene takes: `orbit=<-1..1>`, `walk=<seconds>`, `tilt=<radians>`, `lockZone=<0..1>`, `zoom=<camera zoom>` and `perf=1` (or `perf=phases`, frame rate only;
  ' `runid=<id>` tags its console lines)
  protected sub readCommonArgs(args as roAssociativeArray)
    params = new BGE.LaunchParams(args)
    m.params = params
    m.autoOrbit = params.getFloat("orbit", m.autoOrbit)
    m.walkSeconds = params.getFloat("walk", m.walkSeconds)
    m.startTilt = params.getFloat("tilt", m.startTilt)
    m.lockDeadZone = params.getFloat("lockZone", m.lockDeadZone)
    if params.has("zoom")
      m.game.canvas.renderer.camera.zoom = params.getFloat("zoom", 1.0)
    end if
    pause = params.getFloatList("orbitPause")
    if invalid <> pause and pause.count() > 0
      m.orbitStillSeconds = pause[0]
      m.orbitMoveSeconds = pause[pause.count() - 1]
    end if
    perf = params.getString("perf")
    if perf = "1" or perf = "phases"
      m.perfLog = new PerfLog(m.game.canvas.renderer, perf = "1", params.getString("runid"))
    end if
  end sub

  ' The `at=<col>,<row>[,<heading in degrees>]` measuring deep link, or invalid. Where it's
  ' given it wins over where a scene change would put the knight.
  protected function parseAt() as AtCell
    parts = m.params.getFloatList("at")
    if invalid = parts or parts.count() < 2
      return invalid
    end if
    at = {col: Int(parts[0]), row: Int(parts[1]), heading: 0.0, hasHeading: parts.count() > 2} as AtCell
    if at.hasHeading
      at.heading = BGE.Math.DegreesToRadians(parts[2])
    end if
    return at
  end function

  ' A scene's draw distance in world units: `draw=<metres>` (measuring) overrides `metres`
  protected function drawDistance(metres as float) as float
    draw = m.params.getFloat("draw")
    if draw > 0
      metres = draw
    end if
    return World.metres(metres)
  end function

  ' Queues `paths` (name: path) for this visit (see GameScene.loadSceneBitmap()); `shared` ones,
  ' which other scenes use too, are kept after it
  protected sub loadSceneBitmaps(loader as BGE.AssetLoader, paths as roAssociativeArray, shared = false as boolean)
    ' Smaller on an HD Roku (64 MB of texture memory, #685): the 2048x512 sky is drawn upscaled anyway
    hdSizes = {nightSky: {width: 1024, height: 256}}
    tier = BGE.getDeviceRenderTier()
    hd = tier = BGE.DeviceRenderTier.hd or tier = BGE.DeviceRenderTier.sd
    for each name in paths
      options = {} as BGE.BitmapLoadOptions
      if hd and invalid <> hdSizes[name]
        options = hdSizes[name]
      end if
      m.loadSceneBitmap(loader, name, paths[name], options, shared)
    end for
  end sub

  ' Queues pkg:/sprites/<name>.json for this visit, or for good if `shared`
  protected sub loadSceneAtlas(loader as BGE.AssetLoader, name as string, shared = false as boolean)
    m.loadSceneSpriteAtlas(loader, name, `pkg:/sprites/${name}.json`, {}, shared)
  end sub

  ' Queues `paths` (name: .obj path) for this visit
  protected sub loadSceneModels(loader as BGE.AssetLoader, paths as roAssociativeArray)
    for each name in paths
      m.loadSceneModel(loader, name, paths[name])
    end for
  end sub

  ' Bodies slide along `solids` from now on, the knight's included (call after addKnight())
  protected sub useSolids(solids as BGE.SolidWorld)
    m.walls = solids
    m.trackBody(m.knight)
  end sub

  ' Keeps `entity` out of the walls, if the scene has any
  protected sub trackBody(entity as Fighter)
    if invalid <> m.walls
      m.walls.track(entity, entity.bodyRadius)
    end if
  end sub

  ' The end of a visit, even a change to this same scene (a new crypt level): the fog and talkers
  ' go (the engine removes the lights and this visit's assets after this)
  override sub onDestroy()
    m.clearFog()
    ' ends a conversation still open (cancelling it, and un-pausing the game) before the scene's
    ' people go
    if invalid <> m.talkView
      m.talkView.close()
    end if
    m.talkView = invalid
    ' held on to, this visit's people and enemies would keep their sprites in memory after their
    ' atlases unload
    m.talkers = new BGE.Interactables()
    m.talkTarget = invalid
    m.walls = invalid
    m.director = new CombatDirector()
    m.knight = invalid
    m.cameraRig = invalid
  end sub

  ' Call first thing in onUpdate(). What every scene does each frame: the combat director, the
  ' HUD, conversations and respawning. True when the rest of the scene's update should be
  ' skipped: while he's dead or talking, or once the scene is leaving.
  protected function beginUpdate(dt as float) as boolean
    m.director.viewHeading = m.cameraRig.heading
    m.hud.update(dt, m.knight)
    m.director.update(dt)
    if not m.knight.isAlive()
      ' a conversation doesn't carry on past a death
      if invalid <> m.talkView
        m.talkView.close()
      end if
      m.respawnTimer.start()
      if m.respawnTimer.update(dt)
        m.respawnKnight()
      end if
      return true
    end if
    return m.updateTalk() or m.exits.hasLeft()
  end function

  ' Once respawnTimer runs out: no enemies, the knight back where he started, then onRespawn()
  private sub respawnKnight()
    m.director.clearEnemies()
    if invalid <> m.walls
      m.walls.untrackAll()
    end if
    m.knight.respawn(m.startX, m.startZ)
    m.trackBody(m.knight)
    m.onRespawn()
  end sub

  ' After a respawn, e.g. to put the enemies back
  protected sub onRespawn()
  end sub

  ' The knight (heading in radians, 0 faces -z), and the particle bursts hits spray. Call before
  ' adding enemies and exits: it starts a fresh CombatDirector and clears the exits, since
  ' scenes are reused and the last visit's are gone.
  protected sub addKnight(x as float, z as float, heading as float)
    m.startX = x
    m.startZ = z
    m.respawnTimer.cancel()
    m.exits.clear()
    m.director = new CombatDirector()
    bursts = new BGE.ParticleBurstPool(m.game)
    m.game.addEntity(bursts)
    m.director.bursts = bursts

    player = new Knight(m.game)
    m.game.addEntity(player, {x: x, z: z, heading: heading, director: m.director})
    m.knight = player
  end sub

  ' Someone the knight can walk up to and talk to (OK), starting the story at `node`
  protected sub addTalker(entity as BGE.GameEntity, node as string, name as string)
    m.talkers.add(entity, entity.id, "talk to " + name, node)
  end sub

  ' beginUpdate() calls this, before the knight moves. Finds who's in reach and starts a
  ' conversation on OK (instead of a swing). True if one opened.
  private function updateTalk() as boolean
    m.talkTarget = m.talkerInReach()
    if invalid <> m.talkTarget and m.game.controls.isActionPressed("attack")
      return m.startTalk(m.talkTarget)
    end if
    return false
  end function

  ' Opens the dialogue box on the target's node. The box is modal, so the game is paused until the
  ' conversation ends, and the OK that closed it can't swing: popModal() blocks held buttons until
  ' they're released.
  private function startTalk(target as BGE.Interactable) as boolean
    view = new BGE.Story.DialogueView(m.game, TownStory.session(m.game))
    view.theme = m.talkTheme()
    view.speakerFontName = "default"
    view.textFontName = "default"
    view.boxPadding = 16
    ' choices as a list of lines under the question, like the old conversation box
    view.choiceLayout = "list"
    ' read the line, then OK brings the choices up under it
    view.choicesWithLastLine = false
    ' a gamepad's attack button (the one that started the talk) turns pages and picks too
    view.advanceAction = "attack"
    view.listTextColor = &hD8D0C0FF
    view.listFocusedColor = &hF0C860FF
    view.listener = m
    ' start() runs the node even when nothing shows (a blessing with no lines), so its posts still go out
    if not view.start(target.data as string)
      return false
    end if
    m.talkView = view
    m.knight.faceToward(target.entity.position)
    return true
  end function

  ' The box's colours: a dark panel, gold speaker, cream text
  private function talkTheme() as BGE.UI.Theme
    theme = new BGE.UI.Theme()
    theme.panelBackgroundColor = &h0A0806E0
    theme.panelTitleColor = &hE0B050FF
    theme.panelTextColor = &hE8E4DCFF
    theme.backgroundColor = &h1A1410FF
    theme.foregroundColor = &hD8D0C0FF
    theme.borderColor = &hA08040FF
    theme.focusedBorderColor = &hF0C860FF
    theme.hoveredBackgroundColor = &h3A2A18FF
    theme.disabledColor = &h707070FF
    return theme
  end function

  ' The DialogueView's listener: the conversation has ended (or been left)
  sub onDialogueEnded(view as BGE.Story.DialogueView, cancelled as boolean)
    m.talkView = invalid
  end sub

  ' The nearest talker in front of the knight and within talkReach, while he's free to talk
  private function talkerInReach() as BGE.Interactable
    if not m.knight.isAlive() or (m.knight.clock.state <> KnightState.idle and m.knight.clock.state <> KnightState.run)
      return invalid
    end if
    return m.talkers.nearestInArc(m.knight.position, m.knight.rotation.y, m.talkReach, BGE.Math.PI / 3)
  end function

  ' The town's fog, which the graveyard shares: buildings fade into it rather than turning
  ' see-through, and casters stay on the skyline past the draw distance. Its backdrop uses the
  ' scene's "fog" bitmap, when loaded. Measuring: `hull=0` gives the buildings box silhouettes
  ' instead of their outlines, `lead=<n>` sets Fog.silhouetteOpacityLead.
  ' `fog=0` leaves it off, in both.
  protected sub useTownFog(args as roAssociativeArray)
    ' kept for the whole run: walking through the gate doesn't carry launch args
    globals = GetGlobalAA()
    if args.fog <> invalid
      globals.fogOff = args.fog = "0"
    end if
    if globals.fogOff = true
      return
    end if
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.fog.enabled = true
    camera.fog.color = World.FOG_RGB
    camera.fog.backdropHeight = World.metres(8)
    fogBmp = m.game.getBitmap("fog")
    if invalid <> fogBmp
      camera.fog.backdropRegion = CreateObject("roRegion", fogBmp, 0, 0, fogBmp.GetWidth(), fogBmp.GetHeight())
    end if
    ' solid buildings: their fog makes up their faded opacity soon, so the sky never shows through
    camera.fog.silhouetteOpacityLead = 4
    if args.hull <> invalid
      globals.fogHulls = args.hull <> "0"
    end if
    if args.lead <> invalid
      globals.fogLead = args.lead.toFloat()
    end if
    if globals.fogHulls <> invalid
      camera.fog.silhouetteHulls = globals.fogHulls
    end if
    if globals.fogLead <> invalid
      camera.fog.silhouetteOpacityLead = globals.fogLead
    end if
  end sub

  ' Black fog for the walled places (crypt, interiors): fading walls fade to black rather than
  ' showing the floor through them. Reach 1: nothing is drawn past the draw distance, where black
  ' fog would only match the background.
  protected sub useDarkFog()
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.fog.enabled = true
    camera.fog.color = &h000000
    camera.fog.silhouetteReach = 1
  end sub

  ' Puts a fresh, disabled fog on the camera, which all scenes share, so none inherits another's
  ' settings. onDestroy() calls it: it also lets go of the region holding the fog bitmap.
  protected sub clearFog()
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    noFog = new BGE.Fog()
    camera.fog = noFog
  end sub

  ' The chase camera, after addKnight(). `fadeFraction` 0 keeps the default fade; `maxTilt`
  ' (radians) 0 keeps the OrbitCamera's default.
  protected sub setUpCamera(drawDistance as float, fadeFraction as float, maxTilt as float)
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.maxDrawDistance = drawDistance
    if fadeFraction > 0
      camera.drawDistanceFadeFraction = fadeFraction
    end if
    camera.fieldOfViewDegrees = 90
    ' the chase camera tilts down, which would sort a tall prop's centre in front of the knight
    ' standing nearer than it (#564)
    camera.sortsByGroundDistance = true
    ' 4 m behind and 1.8 m up, looking at 1.2 m, so the knight fills about half the screen.
    ' The boom pulls it in front of anything on the CAMERA_BLOCKER flag.
    options = {
      distance: World.metres(4),
      height: World.metres(1.8),
      lookHeight: World.metres(1.2),
      minHeight: World.metres(0.3),
      ' Locked on, look down at the ground between him and the enemy to judge the distance
      lockTilt: 0.35,
      ' Small moves of the enemy don't turn the whole view (a full redraw); further off, the
      ' camera turns back quickly at first, then slows as the enemy nears the middle
      lockDeadZone: m.lockDeadZone,
      lockEase: 4,
      boom: m.makeCameraBoom({
        probeRadius: World.metres(0.3),
        minDistance: World.metres(0.8),
        collidableFlags: World.CAMERA_BLOCKER
      })
    } as BGE.OrbitCameraOptions
    if maxTilt > 0
      options.maxTilt = maxTilt
    end if
    cameraRig = new BGE.OrbitCamera(camera, m.knight, options)
    m.cameraRig = cameraRig
    if m.startTilt <> 0
      cameraRig.tilt = BGE.Math.Clamp(m.startTilt, cameraRig.minTilt, cameraRig.maxTilt)
    end if
    m.knight.cameraRig = cameraRig
  end sub

  ' The boom that keeps the camera in front of walls: it marches wallsMap's grid when a scene has
  ' one (no colliders needed), else raycasts CAMERA_BLOCKER colliders
  protected function makeCameraBoom(args as roAssociativeArray) as BGE.CameraBoom
    if invalid <> m.wallsMap
      args.stepLength = World.metres(0.2)
      return new BGE.GridWallsCameraBoom(m.game, m.wallsMap, args)
    end if
    return new BGE.CameraBoom(m.game, args)
  end function

  ' Everyone has moved: push bodies apart, let the scene correct positions, then the camera
  ' follows the knight's final position
  override sub onPostUpdate(dt as float)
    m.director.separateBodies()
    m.afterBodiesMoved(dt)
    look = m.game.controls.getRawAxis("look")
    if m.autoOrbit <> 0 and look.x = 0 and look.y = 0 and m.isOrbitMoving(dt)
      look = BGE.Math.VectorOps.create(m.autoOrbit, 0, 0)
    end if
    m.cameraRig.update(dt, look)
    if m.walkSeconds > 0
      m.walkClock += dt
      if m.walkClock >= 2 * m.walkSeconds
        m.walkClock -= 2 * m.walkSeconds
      end if
      ' the camera follows him round when he turns back, so back is down the stick
      stickY = 1.0
      if m.walkClock >= m.walkSeconds
        stickY = -1.0
      end if
      m.knight.scriptedMove = BGE.Math.VectorOps.create(0, stickY, 0)
    end if
    if m.perfLog <> invalid
      m.perfLog.update(dt, m.game.renderQuality.getLevel())
    end if
  end sub

  ' Whether the stop-start orbit is in its moving part (always, without `orbitPause`)
  private function isOrbitMoving(dt as float) as boolean
    period = m.orbitStillSeconds + m.orbitMoveSeconds
    if period <= 0
      return true
    end if
    m.orbitClock += dt
    if m.orbitClock >= period
      m.orbitClock -= period
    end if
    return m.orbitClock >= m.orbitStillSeconds
  end function

  ' After bodies are pushed apart, before the camera moves: slides them back out of the walls
  protected sub afterBodiesMoved(dt as float)
    if invalid <> m.walls
      m.walls.resolveTracked()
    end if
  end sub

  ' The control hints, top right: the bound actions from the control map, two to a line, then the
  ' stick axes and the remote-only debug key, which aren't actions
  protected function hintLines() as string[]
    lines = ["Move: L stick / D-pad    Camera: R stick"]
    texts = [] as string[]
    for each binding in m.game.controls.describeBindings()
      texts.push(binding.text)
    end for
    texts.push("Debug (cycle): *")
    for i = 0 to texts.count() - 1 step 2
      hintLine = texts[i]
      if i + 1 < texts.count()
        hintLine += "    " + texts[i + 1]
      end if
      lines.push(hintLine)
    end for
    return lines
  end function

  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")
    ' The UI canvas is screen-sized; the hints sit top right (the HUD bars are top left), inside
    ' the title-safe area
    center = uiRenderObj.getCanvasCenter()
    lineHeight = font.GetOneLineHeight()
    hintsRight = center.x * 2 * 0.9
    y = center.y * 2 * 0.1
    for each textLine in m.hintLines()
      uiRenderObj.DrawText(textLine, hintsRight, y, BGE.Colors.White, font, "right")
      y += lineHeight
    end for

    m.hud.draw(uiRenderObj)
    ' the dialogue box draws itself while it's open
    if invalid = m.talkView and invalid <> m.talkTarget
      uiRenderObj.DrawText(m.talkers.promptFor(m.talkTarget, "OK / X"), center.x, center.y * 2 * 0.82, &hF0E0B0FF, font, "center")
    end if
    if not m.knight.isAlive()
      uiRenderObj.DrawText("YOU DIED", center.x, center.y, &hC02828FF, font, "center")
    end if
  end sub

end class
