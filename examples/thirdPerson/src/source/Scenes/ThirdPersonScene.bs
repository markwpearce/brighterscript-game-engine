import "../World.bs"
import "../Entities/Knight.bs"
import "../CombatDirector.bs"
import "../Hud.bs"
import "../PerfLog.bs"

' What every playable scene shares: the knight, the chase camera, the HUD, the control hints and
' the debug toggle. Subclasses build their world in onCreate() and call addKnight() and
' setUpCamera().
class ThirdPersonScene extends BGE.GameScene

  knight as Knight
  cameraRig as BGE.OrbitCamera
  director as CombatDirector = new CombatDirector()
  hud as Hud = new Hud()

  ' Camera spin speed with no input (deep link `orbit`), for repeatable measurements
  autoOrbit as float = 0
  perfLog as PerfLog

  sub new(game as BGE.Game)
    super(game)
  end sub

  ' Deep links every scene takes: `orbit=<-1..1>` and `perf=1`
  protected sub readCommonArgs(args as roAssociativeArray)
    if args.orbit <> invalid
      m.autoOrbit = args.orbit.toFloat()
    end if
    if args.perf = "1"
      m.perfLog = new PerfLog(m.game.canvas.renderer)
    end if
  end sub

  ' The knight (heading in radians, 0 faces -z), and the particle bursts hits spray
  protected sub addKnight(x as float, z as float, heading as float)
    bursts = new BGE.ParticleBurstPool(m.game)
    m.game.addEntity(bursts)
    m.director.bursts = bursts

    player = new Knight(m.game)
    m.game.addEntity(player, {x: x, z: z, heading: heading, director: m.director})
    m.knight = player
  end sub

  ' The chase camera, after addKnight(). `fadeFraction` 0 keeps the default fade; `maxTilt`
  ' (radians) 0 keeps the OrbitCamera's default.
  protected sub setUpCamera(drawDistance as float, fadeFraction as float, maxTilt as float)
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.maxDrawDistance = drawDistance
    if fadeFraction > 0
      camera.drawDistanceFadeFraction = fadeFraction
    end if
    camera.fieldOfViewDegrees = 90
    ' 4 m behind and 1.8 m up, looking at 1.2 m, so the knight fills about half the screen.
    ' The boom pulls it in front of anything on the CAMERA_BLOCKER flag.
    options = {
      distance: World.metres(4),
      height: World.metres(1.8),
      lookHeight: World.metres(1.2),
      minHeight: World.metres(0.3),
      ' Locked on, look down at the ground between him and the enemy to judge the distance
      lockTilt: 0.35,
      boom: m.makeCameraBoom({
        probeRadius: World.metres(0.3),
        minDistance: World.metres(0.8),
        collidableFlags: World.CAMERA_BLOCKER
      })
    } as BGE.OrbitCameraOptions
    if maxTilt > 0
      options.maxTilt = maxTilt
    end if
    cameraRig = new BGE.OrbitCamera(camera, m.knight, options)
    m.cameraRig = cameraRig
    m.knight.cameraRig = cameraRig
  end sub

  ' The boom that keeps the camera in front of walls: by default it raycasts CAMERA_BLOCKER
  ' colliders
  protected function makeCameraBoom(args as roAssociativeArray) as BGE.CameraBoom
    return new BGE.CameraBoom(m.game, args)
  end function

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("options")
      m.cycleDebug()
    end if
  end sub

  ' `*` cycles: nothing, just the FPS panel, then every panel with entity details and colliders
  private sub cycleDebug()
    full = false
    if not m.game.isDebugUiEnabled()
      m.game.debugUi.clearChildren()
      m.game.enableStandardDebugUi({input: false, memory: false, garbageCollector: false, log: false})
      m.game.debugShowUi(true)
    else if not m.game.isDebugDrawingColliders()
      m.game.debugUi.clearChildren()
      m.game.enableStandardDebugUi()
      full = true
    else
      m.game.debugShowUi(false)
    end if
    m.game.debugDrawEntityDetails(full)
    m.game.debugDrawColliders(full)
  end sub

  ' Everyone has moved: push bodies apart, let the scene correct positions, then the camera
  ' follows the knight's final position
  override sub onPostUpdate(dt as float)
    m.director.separateBodies()
    m.afterBodiesMoved(dt)
    look = m.game.controls.getRawAxis("look")
    if m.autoOrbit <> 0 and look.x = 0 and look.y = 0
      look = BGE.Math.VectorOps.create(m.autoOrbit, 0, 0)
    end if
    m.cameraRig.update(dt, look)
    if m.perfLog <> invalid
      m.perfLog.update(dt)
    end if
  end sub

  ' After bodies are pushed apart, before the camera moves
  protected sub afterBodiesMoved(dt as float)
  end sub

  ' The control hints, top right
  protected function hintLines() as string[]
    return [
      "Move: L stick / D-pad    Camera: R stick"
      "Lock on / recenter: L2 / Rewind    Debug (cycle): *"
      "Attack: X / OK    Block (hold): L1 / Play"
      "Parry: B / Fast-fwd    Dodge: A / Back / Replay"
    ]
  end function

  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")
    ' The UI canvas is screen-sized; the hints sit top right (the HUD bars are top left), inside
    ' the title-safe area
    center = uiRenderObj.getCanvasCenter()
    lineHeight = font.GetOneLineHeight()
    hintsRight = center.x * 2 * 0.9
    y = center.y * 2 * 0.1
    for each textLine in m.hintLines()
      uiRenderObj.DrawText(textLine, hintsRight, y, BGE.Colors.White, font, "right")
      y += lineHeight
    end for

    m.hud.draw(uiRenderObj, m.knight)
    if not m.knight.isAlive()
      uiRenderObj.DrawText("YOU DIED", center.x, center.y, &hC02828FF, font, "center")
    end if
  end sub

end class
