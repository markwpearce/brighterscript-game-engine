import "../World.bs"
import "../Entities/Knight.bs"
import "../CombatDirector.bs"
import "../Hud.bs"
import "../PerfLog.bs"
import "../Conversation.bs"

' What every playable scene shares: the knight, the chase camera, the HUD, the control hints and
' the debug toggle. Subclasses build their world in onCreate() and call addKnight() and
' setUpCamera().
class ThirdPersonScene extends BGE.GameScene

  knight as Knight
  cameraRig as BGE.OrbitCamera
  director as CombatDirector = new CombatDirector()
  hud as Hud = new Hud()

  ' People the knight can talk to (addTalker()), the one in reach, and the conversation if one's
  ' going
  talkers as Talker[] = []
  talkTarget as Talker = invalid
  conversation as Conversation = invalid
  ' How far away, and how far either side of where he faces, someone can be talked to
  talkReach as float = World.metres(2.4)

  ' Camera spin speed with no input (deep link `orbit`), for repeatable measurements
  autoOrbit as float = 0
  ' Stop-start orbit (deep link `orbitPause=<still s>,<move s>`), for the still-to-moving frames
  orbitStillSeconds as float = 0
  orbitMoveSeconds as float = 0
  orbitClock as float = 0
  perfLog as PerfLog

  sub new(game as BGE.Game)
    super(game)
  end sub

  ' Deep links every scene takes: `orbit=<-1..1>` and `perf=1` (or `perf=phases`, frame rate only;
  ' `runid=<id>` tags its console lines)
  protected sub readCommonArgs(args as roAssociativeArray)
    if args.orbit <> invalid
      m.autoOrbit = args.orbit.toFloat()
    end if
    if args.orbitPause <> invalid
      pause = args.orbitPause.split(",")
      m.orbitStillSeconds = pause[0].toFloat()
      m.orbitMoveSeconds = pause[pause.count() - 1].toFloat()
    end if
    if args.perf = "1" or args.perf = "phases"
      runId = ""
      if args.runid <> invalid
        runId = args.runid
      end if
      m.perfLog = new PerfLog(m.game.canvas.renderer, args.perf = "1", runId)
    end if
  end sub

  ' The knight (heading in radians, 0 faces -z), and the particle bursts hits spray. Call before
  ' adding enemies: it starts a fresh CombatDirector, since scenes are reused and the last
  ' visit's enemies are gone. Forgets the last visit's talkers too, keeping any added this visit.
  protected sub addKnight(x as float, z as float, heading as float)
    m.director = new CombatDirector()
    for i = m.talkers.Count() - 1 to 0 step -1
      if not m.talkers[i].entity.isValid()
        m.talkers.Delete(i)
      end if
    end for
    m.talkTarget = invalid
    m.conversation = invalid
    bursts = new BGE.ParticleBurstPool(m.game)
    m.game.addEntity(bursts)
    m.director.bursts = bursts

    player = new Knight(m.game)
    m.game.addEntity(player, {x: x, z: z, heading: heading, director: m.director})
    m.knight = player
  end sub

  ' Someone the knight can walk up to and talk to (OK), starting the story at `node`
  protected sub addTalker(entity as BGE.GameEntity, node as string, name as string)
    m.talkers.push({entity: entity, node: node, name: name} as Talker)
  end sub

  ' Call first thing in onUpdate(), before the knight moves. Finds who's in reach, starts a
  ' conversation on OK (instead of a swing), and runs one that's going. True while talking:
  ' skip the rest of the scene's update then.
  protected function updateTalk() as boolean
    controls = m.game.controls
    if invalid <> m.conversation
      if m.conversation.isActive()
        m.conversation.update(controls)
        m.takeStoryPosts()
        return true
      end if
      m.takeStoryPosts()
      m.conversation = invalid
      ' Still held this frame from the last line: don't swing at the air as it closes
      m.knight.talking = controls.isActionPressed("attack") or controls.isActionPressed("dodge")
      return m.knight.talking
    end if
    m.knight.talking = false
    m.talkTarget = m.talkerInReach()
    if invalid <> m.talkTarget and controls.isActionPressed("attack")
      chat = new Conversation()
      started = chat.start(m.talkTarget.node)
      ' A node with nothing to say can still post (a blessing with no lines)
      m.conversation = chat
      m.takeStoryPosts()
      if started
        m.knight.talking = true
        m.knight.faceToward(m.talkTarget.entity.position)
        return true
      end if
      m.conversation = invalid
    end if
    return false
  end function

  ' The nearest talker in front of the knight and within talkReach, while he's free to talk
  private function talkerInReach() as Talker
    if not m.knight.isAlive() or (m.knight.state <> KnightState.idle and m.knight.state <> KnightState.run)
      return invalid
    end if
    best = invalid
    bestDistance = m.talkReach
    for each talker in m.talkers
      if talker.entity.isValid()
        distance = BGE.Math.flatDistance(m.knight.position, talker.entity.position)
        if distance < bestDistance
          toward = BGE.Math.headingOf(BGE.Math.flatDirection(m.knight.position, talker.entity.position))
          if Abs(BGE.Math.wrapAngle(toward - m.knight.rotation.y)) < BGE.Math.PI / 3
            best = talker
            bestDistance = distance
          end if
        end if
      end if
    end for
    return best
  end function

  ' What the story asked the world to do
  private sub takeStoryPosts()
    for each name in m.conversation.posts
      if name = "heal"
        m.knight.health = m.knight.maxHealth
        m.knight.stamina.refill()
      end if
    end for
    m.conversation.posts = []
  end sub

  ' The town's fog, which the graveyard shares: buildings fade into it rather than turning
  ' see-through, and casters stay on the skyline past the draw distance. Its backdrop uses the
  ' scene's "fog" bitmap, when loaded. Measuring: `hull=0` gives the buildings box silhouettes
  ' instead of their outlines, `lead=<n>` sets Fog.silhouetteOpacityLead.
  protected sub useTownFog(args as roAssociativeArray)
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.fog.enabled = true
    camera.fog.color = World.FOG_RGB
    camera.fog.backdropHeight = World.metres(8)
    fogBmp = m.game.getBitmap("fog")
    if invalid <> fogBmp
      camera.fog.backdropRegion = CreateObject("roRegion", fogBmp, 0, 0, fogBmp.GetWidth(), fogBmp.GetHeight())
    end if
    ' solid buildings: their fog makes up their faded opacity soon, so the sky never shows through
    camera.fog.silhouetteOpacityLead = 4
    ' kept for the whole run: walking through the gate doesn't carry launch args
    globals = GetGlobalAA()
    if args.hull <> invalid
      globals.fogHulls = args.hull <> "0"
    end if
    if args.lead <> invalid
      globals.fogLead = args.lead.toFloat()
    end if
    if globals.fogHulls <> invalid
      camera.fog.silhouetteHulls = globals.fogHulls
    end if
    if globals.fogLead <> invalid
      camera.fog.silhouetteOpacityLead = globals.fogLead
    end if
  end sub

  ' Puts a fresh, disabled fog on the camera, which all scenes share, so none inherits another's
  ' settings. Call from onDestroy(): it also lets go of the region holding the fog bitmap.
  protected sub clearFog()
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    noFog = new BGE.Fog()
    camera.fog = noFog
  end sub

  ' The chase camera, after addKnight(). `fadeFraction` 0 keeps the default fade; `maxTilt`
  ' (radians) 0 keeps the OrbitCamera's default.
  protected sub setUpCamera(drawDistance as float, fadeFraction as float, maxTilt as float)
    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.maxDrawDistance = drawDistance
    if fadeFraction > 0
      camera.drawDistanceFadeFraction = fadeFraction
    end if
    camera.fieldOfViewDegrees = 90
    ' 4 m behind and 1.8 m up, looking at 1.2 m, so the knight fills about half the screen.
    ' The boom pulls it in front of anything on the CAMERA_BLOCKER flag.
    options = {
      distance: World.metres(4),
      height: World.metres(1.8),
      lookHeight: World.metres(1.2),
      minHeight: World.metres(0.3),
      ' Locked on, look down at the ground between him and the enemy to judge the distance
      lockTilt: 0.35,
      boom: m.makeCameraBoom({
        probeRadius: World.metres(0.3),
        minDistance: World.metres(0.8),
        collidableFlags: World.CAMERA_BLOCKER
      })
    } as BGE.OrbitCameraOptions
    if maxTilt > 0
      options.maxTilt = maxTilt
    end if
    cameraRig = new BGE.OrbitCamera(camera, m.knight, options)
    m.cameraRig = cameraRig
    m.knight.cameraRig = cameraRig
  end sub

  ' The boom that keeps the camera in front of walls: by default it raycasts CAMERA_BLOCKER
  ' colliders
  protected function makeCameraBoom(args as roAssociativeArray) as BGE.CameraBoom
    return new BGE.CameraBoom(m.game, args)
  end function

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("options")
      m.cycleDebug()
    end if
  end sub

  ' `*` cycles: nothing, just the FPS panel, then every panel with entity details and colliders
  private sub cycleDebug()
    full = false
    if not m.game.isDebugUiEnabled()
      m.game.debugUi.clearChildren()
      m.game.enableStandardDebugUi({input: false, memory: false, garbageCollector: false, log: false})
      m.game.debugShowUi(true)
    else if not m.game.isDebugDrawingColliders()
      m.game.debugUi.clearChildren()
      m.game.enableStandardDebugUi()
      full = true
    else
      m.game.debugShowUi(false)
    end if
    m.game.debugDrawEntityDetails(full)
    m.game.debugDrawColliders(full)
  end sub

  ' Everyone has moved: push bodies apart, let the scene correct positions, then the camera
  ' follows the knight's final position
  override sub onPostUpdate(dt as float)
    m.director.separateBodies()
    m.afterBodiesMoved(dt)
    look = m.game.controls.getRawAxis("look")
    if m.autoOrbit <> 0 and look.x = 0 and look.y = 0 and m.isOrbitMoving(dt)
      look = BGE.Math.VectorOps.create(m.autoOrbit, 0, 0)
    end if
    m.cameraRig.update(dt, look)
    if m.perfLog <> invalid
      m.perfLog.update(dt, m.game.renderQuality.getLevel())
    end if
  end sub

  ' Whether the stop-start orbit is in its moving part (always, without `orbitPause`)
  private function isOrbitMoving(dt as float) as boolean
    period = m.orbitStillSeconds + m.orbitMoveSeconds
    if period <= 0
      return true
    end if
    m.orbitClock += dt
    if m.orbitClock >= period
      m.orbitClock -= period
    end if
    return m.orbitClock >= m.orbitStillSeconds
  end function

  ' After bodies are pushed apart, before the camera moves
  protected sub afterBodiesMoved(dt as float)
  end sub

  ' The control hints, top right
  protected function hintLines() as string[]
    return [
      "Move: L stick / D-pad    Camera: R stick"
      "Lock on / recenter: L2 / Rewind    Debug (cycle): *"
      "Attack: X / OK    Block (hold): L1 / Play"
      "Parry: B / Fast-fwd    Dodge: A / Back / Replay"
    ]
  end function

  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")
    ' The UI canvas is screen-sized; the hints sit top right (the HUD bars are top left), inside
    ' the title-safe area
    center = uiRenderObj.getCanvasCenter()
    lineHeight = font.GetOneLineHeight()
    hintsRight = center.x * 2 * 0.9
    y = center.y * 2 * 0.1
    for each textLine in m.hintLines()
      uiRenderObj.DrawText(textLine, hintsRight, y, BGE.Colors.White, font, "right")
      y += lineHeight
    end for

    m.hud.draw(uiRenderObj, m.knight)
    if invalid <> m.conversation
      m.conversation.draw(uiRenderObj, font)
    else if invalid <> m.talkTarget
      uiRenderObj.DrawText(`OK / X: talk to ${m.talkTarget.name}`, center.x, center.y * 2 * 0.82, &hF0E0B0FF, font, "center")
    end if
    if not m.knight.isAlive()
      uiRenderObj.DrawText("YOU DIED", center.x, center.y, &hC02828FF, font, "center")
    end if
  end sub

end class
