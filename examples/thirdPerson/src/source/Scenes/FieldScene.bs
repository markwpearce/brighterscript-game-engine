import "../World.bs"
import "../ThirdPersonCamera.bs"
import "../Entities/Knight.bs"
import "../Entities/Enemy.bs"
import "../Entities/EnemyTypes.bs"
import "../Entities/Pillar.bs"
import "../CombatDirector.bs"

' A flat night field to try out the knight's movement and combat. Enemies keep spawning
' 20-50 m away (a skeleton, an orc and a heavy orc in turn), up to maxEnemies at once.
class FieldScene extends BGE.GameScene

  knight as Knight
  cameraRig as ThirdPersonCamera
  director as CombatDirector = new CombatDirector()

  maxEnemies as integer = 3
  spawnIntervalSeconds as float = 8
  respawnSeconds as float = 3

  private enemyTypes as EnemyType[] = EnemyTypes.all()
  private nextEnemyType as integer = 0
  private spawnSeconds as float = 1
  private deadSeconds as float = 0

  sub new(game as BGE.Game)
    super(game)
    m.name = "FieldScene"
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    if m.game.Bitmaps["knight"] = invalid
      loader.loadBitmap("knight", "pkg:/sprites/knight.png")
    end if
    if m.game.Bitmaps["grass"] = invalid
      loader.loadBitmap("grass", "pkg:/sprites/grass.png")
    end if
    for each enemyType in m.enemyTypes
      if m.game.Bitmaps[enemyType.bitmap] = invalid
        loader.loadBitmap(enemyType.bitmap, `pkg:/sprites/${enemyType.bitmap}.png`)
      end if
    end for
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.game.setBackgroundColor(&h0B1324FF)

    groundPlaneDef = {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}
    grassBmp = m.game.getBitmap("grass")
    grassRegion = CreateObject("roRegion", grassBmp, 0, 0, grassBmp.GetWidth(), grassBmp.GetHeight())
    ground = new BGE.DrawablePlane(m, grassRegion, groundPlaneDef, {fillMode: BGE.PlaneFillMode.tiledImage})
    m.addDrawable("Ground", ground)

    ' Test pillars for the camera to pull in front of
    for each spot in [[6, -2], [-7, 4], [0.5, 3.2], [-4, -10], [12, 6]]
      column = new Pillar(m.game)
      m.game.addEntity(column, {x: World.metres(spot[0]), z: World.metres(spot[1]), width: World.metres(1.4), height: World.metres(5)})
    end for

    bursts = new BGE.ParticleBurstPool(m.game)
    m.game.addEntity(bursts)
    m.director.bursts = bursts

    player = new Knight(m.game)
    m.game.addEntity(player, {x: 0, z: 0, heading: 0, director: m.director})
    m.knight = player

    camera = m.game.canvas.renderer.camera as BGE.Camera3d
    camera.maxDrawDistance = World.metres(40)
    cameraRig = new ThirdPersonCamera(camera, m.game.controls, player)
    m.cameraRig = cameraRig
    player.cameraRig = cameraRig
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("options")
      showingDebug = not m.game.isDebugUiEnabled()
      m.game.debugShowUi(showingDebug)
      m.game.debugDrawEntityDetails(showingDebug)
      m.game.debugDrawColliders(showingDebug)
    end if
  end sub

  override sub onUpdate(dt as float)
    if m.game.controls.isActionPressed("recenter")
      m.cameraRig.recenter()
    end if
    m.director.viewHeading = m.cameraRig.heading
    m.director.update(dt)
    if m.knight.isAlive()
      m.updateSpawner(dt)
    else
      ' Start over: full health, an empty field
      m.deadSeconds += dt
      if m.deadSeconds >= m.respawnSeconds
        m.deadSeconds = 0
        m.director.clearEnemies()
        m.knight.respawn(0, 0)
        m.spawnSeconds = 1
      end if
    end if
  end sub

  ' Everyone has moved: push bodies apart, then the camera follows the knight's final position
  override sub onPostUpdate(dt as float)
    m.director.separateBodies()
    m.cameraRig.update(dt)
  end sub

  private sub updateSpawner(dt as float)
    m.spawnSeconds -= dt
    if m.spawnSeconds > 0
      return
    end if
    m.spawnSeconds = m.spawnIntervalSeconds
    if m.director.livingEnemyCount() >= m.maxEnemies
      return
    end if
    heading = Rnd(0) * 2 * BGE.Math.PI
    distance = World.metres(20 + Rnd(0) * 30)
    offset = BGE.Math.VectorOps.scale(BGE.Math.headingForward(heading), distance)
    enemyType = m.enemyTypes[m.nextEnemyType]
    m.nextEnemyType = (m.nextEnemyType + 1) mod m.enemyTypes.Count()
    spawned = new Enemy(m.game)
    m.game.addEntity(spawned, {
      type: enemyType,
      director: m.director,
      x: m.knight.position.x + offset.x,
      z: m.knight.position.z + offset.z
    })
  end sub

  override sub onDrawEnd(renderObj as BGE.Renderer, uiRenderObj as BGE.Renderer)
    font = m.game.getFont("default")
    lines = [
      "Move: L stick / D-pad    Camera: R stick"
      "Recenter: R3 / Y / Rewind    Debug: *"
      "Attack: R1 / A / OK    Block (hold): L1 / Play"
      "Parry: L2 / Fast-fwd    Dodge: B / Back / Replay"
      `State: ${m.knight.state}    Enemies: ${m.director.livingEnemyCount()}`
    ]
    ' The UI canvas is screen-sized; keep the hints inside the title-safe top edge
    center = uiRenderObj.getCanvasCenter()
    lineHeight = font.GetOneLineHeight()
    y = center.y * 2 * 0.1
    for each textLine in lines
      uiRenderObj.DrawText(textLine, center.x, y, BGE.Colors.White, font, "center")
      y += lineHeight
    end for

    ' Health bar, bottom left inside the action-safe area
    barWidth = center.x * 0.6
    barX = center.x * 2 * 0.07
    barY = center.y * 2 * 0.9
    uiRenderObj.drawRectangle(barX - 2, barY - 2, barWidth + 4, 18, &h000000C0)
    uiRenderObj.drawRectangle(barX, barY, barWidth * m.knight.health / m.knight.maxHealth, 14, &hC02828FF)
    if not m.knight.isAlive()
      uiRenderObj.DrawText("YOU DIED", center.x, center.y, &hC02828FF, font, "center")
    end if
  end sub

end class
