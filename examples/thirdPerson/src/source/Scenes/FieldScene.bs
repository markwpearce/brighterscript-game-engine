import "../World.bs"
import "../Entities/Knight.bs"
import "../Entities/Enemy.bs"
import "../Entities/EnemyTypes.bs"
import "../Entities/Pillar.bs"
import "../Entities/Torch.bs"
import "../Night.bs"
import "ThirdPersonScene.bs"

' A flat night field to try out the knight's movement and combat. Enemies keep spawning
' 20-50 m away (a skeleton, an orc and a heavy orc in turn), up to maxEnemies at once.
class FieldScene extends ThirdPersonScene

  maxEnemies as integer = 3
  spawnIntervalSeconds as float = 8
  respawnSeconds as float = 3
  ' World units per grass texel. The device caps the ground's bitmaps in texels, so 2 lets it
  ' reach twice as far (60 m at Ultra on HD, not 31 m), at 16 texels per metre.
  groundTexelScale as float = 2
  ' Pillars for the camera to pull in front of; `pillars=0` measures the frame rate without them
  showPillars as boolean = true
  ' "model", "cull" or "rect" (deep link `pillarStyle`) - see Pillar
  pillarStyle as string = "model"
  ' Moon, sky light and torches (deep link `night=0` for the old unlit field)
  showNight as boolean = true

  private enemyTypes as EnemyType[] = EnemyTypes.all()
  private nextEnemyType as integer = 0
  private spawnSeconds as float = 1
  private nightLights as BGE.Light[] = []
  private deadSeconds as float = 0

  sub new(game as BGE.Game)
    super(game)
    m.name = "FieldScene"
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    loader.loadSpriteAtlas("knight", "pkg:/sprites/knight.json")
    if m.game.Bitmaps["grass"] = invalid
      loader.loadBitmap("grass", "pkg:/sprites/grass.webp")
    end if
    if m.game.Bitmaps["nightSky"] = invalid
      loader.loadBitmap("nightSky", "pkg:/sprites/night_sky.webp")
    end if
    for each enemyType in m.enemyTypes
      loader.loadSpriteAtlas(enemyType.atlas, `pkg:/sprites/${enemyType.atlas}.json`)
    end for
  end sub

  override sub onCreate(args as roAssociativeArray)
    if args.night <> invalid
      m.showNight = args.night <> "0"
    end if
    if m.showNight
      ' The sky texture's zenith, for anything past its top
      m.game.setBackgroundColor(&h080E28FF)
    else
      m.game.setBackgroundColor(&h0B1324FF)
    end if
    if args.pillars <> invalid
      m.showPillars = args.pillars = "1"
    end if
    if args.enemies <> invalid
      m.maxEnemies = args.enemies.toInt()
    end if
    if args.pillarStyle <> invalid
      m.pillarStyle = args.pillarStyle
    end if
    m.readCommonArgs(args)

    groundPlaneDef = {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}
    grassBmp = m.game.getBitmap("grass")
    grassRegion = CreateObject("roRegion", grassBmp, 0, 0, grassBmp.GetWidth(), grassBmp.GetHeight())
    ground = new BGE.DrawablePlane(m, grassRegion, groundPlaneDef, {
      fillMode: BGE.PlaneFillMode.tiledImage,
      scale: BGE.Math.VectorOps.create(m.groundTexelScale, m.groundTexelScale, 1)
    })
    m.addDrawable("Ground", ground)

    if m.showNight
      ground.isShaded = true
      skyBmp = m.game.getBitmap("nightSky")
      sky = new BGE.DrawableSkybox(m, CreateObject("roRegion", skyBmp, 0, 0, skyBmp.GetWidth(), skyBmp.GetHeight()))
      m.addDrawable("Sky", sky)
      m.nightLights = Night.addLights(m.game)
    end if

    if m.showPillars
      ' x, z (metres) and the flame on its side facing the start, if any
      for each spot in [[6, -2, FlameKind.fire], [-7, 4, FlameKind.fire], [0.5, 3.2, ""], [-4, -10, FlameKind.spirit], [12, 6, ""]]
        x = World.metres(spot[0])
        z = World.metres(spot[1])
        width = World.metres(1.4)
        column = new Pillar(m.game)
        m.game.addEntity(column, {x: x, z: z, width: width, height: World.metres(5), style: m.pillarStyle})
        if m.showNight and spot[2] <> ""
          out = BGE.Math.flatDirection(BGE.Math.VectorOps.create(x, 0, z), BGE.Math.VectorOps.create())
          flame = new Torch(m.game)
          m.game.addEntity(flame, {x: x + out.x * (width / 2 + World.metres(0.2)), y: World.metres(2.4), z: z + out.z * (width / 2 + World.metres(0.2)), kind: spot[2]})
        end if
      end for
    end if

    m.addKnight(0, 0, 0)
    fadeFraction = 0
    if m.showNight
      ' Fade the far half into the dark, not just the last stretch
      fadeFraction = 0.5
    end if
    m.setUpCamera(World.metres(40), fadeFraction, 0)
  end sub

  override sub onDestroy()
    for each light in m.nightLights
      m.game.removeLight(light)
    end for
    m.nightLights = []
  end sub

  override sub onUpdate(dt as float)
    m.director.viewHeading = m.cameraRig.heading
    m.hud.update(dt, m.knight)
    m.director.update(dt)
    if m.knight.isAlive()
      m.updateSpawner(dt)
    else
      ' Start over: full health, an empty field
      m.deadSeconds += dt
      if m.deadSeconds >= m.respawnSeconds
        m.deadSeconds = 0
        m.director.clearEnemies()
        m.knight.respawn(0, 0)
        m.spawnSeconds = 1
      end if
    end if
  end sub

  private sub updateSpawner(dt as float)
    m.spawnSeconds -= dt
    if m.spawnSeconds > 0
      return
    end if
    m.spawnSeconds = m.spawnIntervalSeconds
    if m.director.livingEnemyCount() >= m.maxEnemies
      return
    end if
    heading = Rnd(0) * 2 * BGE.Math.PI
    distance = World.metres(20 + Rnd(0) * 30)
    offset = BGE.Math.VectorOps.scale(BGE.Math.headingForward(heading), distance)
    enemyType = m.enemyTypes[m.nextEnemyType]
    m.nextEnemyType = (m.nextEnemyType + 1) mod m.enemyTypes.Count()
    spawned = new Enemy(m.game)
    m.game.addEntity(spawned, {
      type: enemyType,
      director: m.director,
      x: m.knight.position.x + offset.x,
      z: m.knight.position.z + offset.z
    })
  end sub

  protected override function hintLines() as string[]
    lines = super.hintLines()
    lines.push(`State: ${m.knight.state}    Enemies: ${m.director.livingEnemyCount()}`)
    return lines
  end function

end class
