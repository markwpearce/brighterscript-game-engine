import "pkg:/source/story/StorySession.bs"
import "pkg:/source/story/StoryLoader.bs"

' The town's story (pkg:/story/town.json), kept as one session for the whole run: what's been said
' and done carries from scene to scene. The session listens for `cryptBossSlain` (posted by the crypt
' when a boss falls) and the story's rules turn it into flags.
namespace TownStory

  const SESSION_NAME = "townStory"

  ' The session, made and added to the game the first time anything asks for it. main() asks at
  ' launch, so a boss killed in any scene reaches it.
  '
  ' @param {BGE.Game} game
  ' @return {BGE.Story.StorySession}
  function session(game as BGE.Game) as BGE.Story.StorySession
    found = game.getAllEntities(TownStory.SESSION_NAME)
    if found.count() > 0
      return found[0] as BGE.Story.StorySession
    end if
    story = BGE.Story.loadStory("pkg:/story/town.json")
    if invalid = story
      ' loadStory has said why; nobody talks
      story = {nodes: {}} as BGE.Story.StoryData
    end if
    created = new BGE.Story.StorySession(game, story, {name: TownStory.SESSION_NAME})
    created.listenTo(["cryptBossSlain"])
    game.addEntity(created)
    return created
  end function

end namespace
