import "Entities/Knight.bs"

interface HudBarFill
  fraction as float
  color as integer
end interface

' Souls-style HUD: health and stamina bars in the top left, inside the title-safe area. Lost
' health shows as a pale chunk that drains after a moment, and the stamina bar flashes when an
' action is refused for lack of it.
class Hud

  healthColor as integer = &hB02020FF
  healthLagColor as integer = &hE8C070FF
  staminaColor as integer = &h3C9C46FF
  staminaDeniedColor as integer = &hE8E8E8FF
  backColor as integer = &h000000B0

  ' Where the lag chunk ends, as a fraction of max health
  private lagFraction as float = 1
  private lagHoldSeconds as float = 0
  private lastHealthFraction as float = 1

  sub update(dt as float, player as Knight)
    healthFraction = player.health / player.maxHealth
    ' Each new hit holds the chunk for a moment again
    if healthFraction < m.lastHealthFraction
      m.lagHoldSeconds = 0
    end if
    m.lastHealthFraction = healthFraction
    if healthFraction >= m.lagFraction
      m.lagFraction = healthFraction
      return
    end if
    m.lagHoldSeconds += dt
    if m.lagHoldSeconds > 0.6
      m.lagFraction = BGE.Math.Max(healthFraction, m.lagFraction - 0.5 * dt)
    end if
  end sub

  sub draw(uiRenderObj as BGE.Renderer, player as Knight)
    center = uiRenderObj.getCanvasCenter()
    screenWidth = center.x * 2
    left = screenWidth * 0.1
    top = center.y * 2 * 0.1

    healthWidth = screenWidth * 0.3
    m.drawBar(uiRenderObj, left, top, healthWidth, 14, [
      {fraction: m.lagFraction, color: m.healthLagColor},
      {fraction: player.health / player.maxHealth, color: m.healthColor}
    ])

    staminaPool = player.stamina
    staminaColor = m.staminaColor
    ' Blink while an action is being refused
    if staminaPool.deniedSeconds > 0 and fix(staminaPool.deniedSeconds * 10) mod 2 = 0
      staminaColor = m.staminaDeniedColor
    end if
    m.drawBar(uiRenderObj, left, top + 22, screenWidth * 0.25, 10, [
      {fraction: staminaPool.fraction(), color: staminaColor}
    ])
  end sub

  ' A backed bar; fills are drawn in order, so put the longest first.
  private sub drawBar(uiRenderObj as BGE.Renderer, x as float, y as float, width as float, height as float, fills as HudBarFill[])
    uiRenderObj.drawRectangle(x - 2, y - 2, width + 4, height + 4, m.backColor)
    for each fill in fills
      fillWidth = width * BGE.Math.Clamp(fill.fraction, 0, 1)
      if fillWidth > 0
        uiRenderObj.drawRectangle(x, y, fillWidth, height, fill.color)
      end if
    end for
  end sub

end class
