import "pkg:/source/engine/ui/Meter.bs"
import "pkg:/source/engine/ui/Banner.bs"
import "Entities/Knight.bs"
import "RunData.bs"

' Souls-style HUD: health and stamina bars in the top left, inside the title-safe area. Lost
' health shows as a pale chunk that drains after a moment, and the stamina bar flashes when an
' action is refused for lack of it. Also a boss's health along the bottom, a banner across the
' middle, and the coins carried bottom right. The bars are BGE.UI.Meter and the banner
' BGE.UI.Banner, drawn from the scene's draw hook at fixed positions (update() each frame first).
class Hud

  private healthMeter as BGE.UI.Meter = invalid
  private staminaMeter as BGE.UI.Meter = invalid
  private bossMeter as BGE.UI.Meter = invalid
  private banner as BGE.UI.Banner = invalid
  ' The stamina pool's deniedRemaining() last frame: a jump up is a fresh refusal
  private lastDeniedSeconds as float = 0
  private game as BGE.Game

  sub new(game as BGE.Game)
    m.game = game
    m.healthMeter = new BGE.UI.Meter(game)
    m.healthMeter.fillColor = &hB02020FF
    m.healthMeter.lagEnabled = true

    m.staminaMeter = new BGE.UI.Meter(game)
    m.staminaMeter.fillColor = &h3C9C46FF
    m.staminaMeter.blinkColor = &hE8E8E8FF

    m.bossMeter = new BGE.UI.Meter(game)
    m.bossMeter.fillColor = &h9C1C1CFF
    m.bossMeter.labelFontName = "default"

    m.banner = new BGE.UI.Banner(game)
    m.banner.fontName = "default"
  end sub

  sub update(dt as float, player as Knight)
    m.healthMeter.setValue(player.health.current, player.health.max)
    m.healthMeter.update(dt)

    pool = player.stamina
    ' the refusal flash lasts as long as the pool's denied window
    m.staminaMeter.refuseSeconds = pool.deniedSeconds
    m.staminaMeter.setValue(pool.current, pool.max)
    if pool.deniedRemaining() > m.lastDeniedSeconds
      m.staminaMeter.refuse()
    end if
    m.lastDeniedSeconds = pool.deniedRemaining()
    m.staminaMeter.update(dt)

    m.banner.update(dt)
  end sub

  sub draw(uiRenderObj as BGE.Renderer)
    center = uiRenderObj.getCanvasCenter()
    screenWidth = center.x * 2
    left = screenWidth * 0.1
    top = center.y * 2 * 0.1

    m.healthMeter.drawAt(uiRenderObj, left, top, screenWidth * 0.3, 14)
    m.staminaMeter.drawAt(uiRenderObj, left, top + 22, screenWidth * 0.25, 10)

    ' the coins carried, bottom right inside the title-safe area
    font = m.game.getFont("default")
    coinsY = center.y * 2 * 0.9 - font.GetOneLineHeight()
    uiRenderObj.DrawText(`Coins  ${RunData.current().coins}`, screenWidth * 0.9, coinsY, &hF0C860FF, font, "right")
  end sub

  ' A boss's name and health along the bottom of the screen, inside the title-safe area.
  sub drawBossBar(uiRenderObj as BGE.Renderer, name as string, health as float, maxHealth as float)
    center = uiRenderObj.getCanvasCenter()
    screenWidth = center.x * 2
    width = screenWidth * 0.6
    left = center.x - width / 2
    barTop = center.y * 2 * 0.9 - 12

    m.bossMeter.label = name
    m.bossMeter.setValue(health, maxHealth)
    m.bossMeter.drawAt(uiRenderObj, left, barTop, width, 12)
  end sub

  ' Shows `text` for `seconds` (fades in and out), replacing any banner showing.
  sub showBanner(text as string, seconds as float)
    m.banner.show(text, seconds)
  end sub

  sub hideBanner()
    m.banner.hide()
  end sub

  ' Draws the banner, if one is showing.
  sub drawBanner(uiRenderObj as BGE.Renderer)
    m.banner.drawOn(uiRenderObj)
  end sub

end class
