import "pkg:/source/utils/SaveSlot.bs"
import "pkg:/source/story/StorySession.bs"
import "TownStory.bs"
import "RunState.bs"
import "Bonfires.bs"

' Where Continue (or a respawn) takes the knight: a scene and the args that place him
interface ResumePoint extends roAssociativeArray
  scene as string
  args as roAssociativeArray
end interface

' The one saved game. Every field is plain data, safe for BGE.SaveSlot.
interface GameSaveData extends roAssociativeArray
  ' The scene to resume in, and the args that bring the knight in at its entrance ({from},
  ' {place}, {level, from})
  scene as string
  entrance as roAssociativeArray
  ' TownStory's StorySession.toSaveData()
  story as BGE.Story.StorySessionSave
  ' Ids of the bosses killed ("crypt1"...), which stay dead
  optional bossesKilled as string[]
  ' RunState: the bonfire to wake at, the ones rested at, coins, healing draughts, and coins
  ' dropped at a death
  optional bonfireId as string
  optional litBonfires as string[]
  optional coins as integer
  optional draughts as integer
  optional maxDraughts as integer
  ' Weapons and shields owned (Items ids), the one in each slot (slot -> id), key items, and the
  ' merchant's one-off wares bought
  optional ownedGear as string[]
  optional equippedGear as roAssociativeArray
  optional keyItems as string[]
  optional purchases as string[]
  optional droppedCoins as DroppedCoins
end interface

' Reads and writes the game's one save slot. Get the shared one with SaveData.current().
class GameSave

  slot as BGE.SaveSlot = new BGE.SaveSlot(SaveData.SECTION, "save", 1)

  ' The save, or invalid if there's none it can use
  function read() as GameSaveData
    return m.slot.read(SaveData.validate)
  end function

  function exists() as boolean
    return m.slot.exists(SaveData.validate)
  end function

  function write(data as GameSaveData) as boolean
    return m.slot.write(data)
  end function

  ' Saves arriving in a scene: where (`entrance` picks the args that place the knight), and the
  ' progress (see saveProgress()). Anything else already in the save is kept.
  function saveArrival(game as BGE.Game, sceneName as string, args as roAssociativeArray) as boolean
    if not m.slot.enabled
      return false
    end if
    data = m.read()
    if invalid = data
      data = {} as GameSaveData
    end if
    entrance = {}
    for each key in ["from", "place", "level", "bonfire"]
      if invalid <> args[key]
        entrance[key] = args[key]
      end if
    end for
    data.scene = sceneName
    data.entrance = entrance
    m.fillProgress(game, data)
    return m.write(data)
  end function

  ' Saves the progress, keeping where the save resumes: the story, the bosses killed and the
  ' RunState (bonfire, coins, draughts, gear, key items, dropped coins). On resting, a boss's
  ' death, the knight's death, picking up dropped coins, equipping and buying. Does nothing before the first arrival has saved.
  function saveProgress(game as BGE.Game) as boolean
    if not m.slot.enabled
      return false
    end if
    data = m.read()
    if invalid = data
      return false
    end if
    m.fillProgress(game, data)
    return m.write(data)
  end function

  private sub fillProgress(game as BGE.Game, data as GameSaveData)
    data.story = TownStory.session(game).toSaveData()
    data.bossesKilled = SaveData.bossesKilled()
    state = RunData.current()
    data.bonfireId = state.bonfireId
    data.litBonfires = state.litBonfires
    data.coins = state.coins
    data.draughts = state.draughts
    data.maxDraughts = state.maxDraughts
    data.droppedCoins = state.droppedCoins
    data.ownedGear = state.ownedGear
    data.equippedGear = state.equippedGear
    data.keyItems = state.keyItems
    data.purchases = state.purchases
  end sub

  ' Where Continue takes the knight: beside the last bonfire he rested at, else where he last
  ' came into a scene
  function resumePoint(data as GameSaveData) as ResumePoint
    spot = invalid
    if invalid <> data.bonfireId and data.bonfireId <> ""
      spot = Bonfires.get(data.bonfireId)
    end if
    if invalid <> spot
      return {scene: spot.scene, args: Bonfires.sceneArgs(spot)}
    end if
    return {scene: data.scene, args: data.entrance}
  end function

  ' Puts the game back as `data` left it (call before changing to data.scene)
  sub restore(game as BGE.Game, data as GameSaveData)
    TownStory.session(game).loadSaveData(data.story)
    slain = {}
    if invalid <> data.bossesKilled
      for each id in data.bossesKilled
        if Left(id, 5) = "crypt"
          slain[Mid(id, 6)] = true
        end if
      end for
    end if
    GetGlobalAA().cryptBossesSlain = slain
    state = RunData.reset()
    state.bonfireId = data.bonfireId ?? ""
    if invalid <> data.litBonfires
      state.litBonfires = data.litBonfires
    end if
    state.coins = data.coins ?? 0
    state.maxDraughts = data.maxDraughts ?? state.maxDraughts
    state.draughts = data.draughts ?? state.maxDraughts
    state.droppedCoins = data.droppedCoins
    ' the starting gear stays owned and equipped unless the save says otherwise
    if invalid <> data.ownedGear
      for each id in data.ownedGear
        state.grantItem(id)
      end for
    end if
    if invalid <> data.equippedGear
      for each slot in data.equippedGear
        state.equip(data.equippedGear[slot])
      end for
    end if
    if invalid <> data.keyItems
      for each id in data.keyItems
        state.grantItem(id)
      end for
    end if
    if invalid <> data.purchases
      state.purchases = data.purchases
    end if
  end sub

  ' Wipes the save and starts the story, bosses and run afresh
  sub startNew(game as BGE.Game)
    m.slot.delete()
    TownStory.session(game).loadSaveData(invalid)
    GetGlobalAA().cryptBossesSlain = {}
    RunData.reset()
  end sub

end class

namespace SaveData

  ' The registry section for the save and the settings
  const SECTION = "nightOfTheBarrowKing"

  ' The game's save, made the first time anything asks for it
  function current() as GameSave
    globals = GetGlobalAA()
    if invalid = globals.gameSave
      globals.gameSave = new GameSave()
    end if
    return globals.gameSave
  end function

  ' The bosses killed this run, as save ids
  function bossesKilled() as string[]
    ids = [] as string[]
    slain = GetGlobalAA().cryptBossesSlain
    if invalid <> slain
      for each level in slain
        if slain[level] = true
          ids.push("crypt" + level)
        end if
      end for
    end if
    return ids
  end function

  ' SaveSlot's validate: the save if it names a scene, else invalid
  function validate(data as dynamic) as dynamic
    if type(data) <> "roAssociativeArray"
      return invalid
    end if
    if type(data.scene) <> "roString" and type(data.scene) <> "String"
      return invalid
    end if
    if data.scene = ""
      return invalid
    end if
    if type(data.entrance) <> "roAssociativeArray"
      data.entrance = {}
    end if
    return data
  end function

end namespace
