import "../World.bs"
import "pkg:/source/engine/gridMaps/CharGrid.bs"
import "pkg:/source/engine/colliders/SolidWorld.bs"

' The forest north of the town as a text grid of 2 m cells, read from src/maps/forest.txt (its key
' is the comment at the top). tools/forest-ground.py paints the ground from the same file.
namespace ForestMap

  const CELL_METRES = 2
  ' Kinds placed one per cell: trees, enemies, camp props, the bonfire and the way in
  const CELL_KINDS = "YghwoOCFtcl@"

  ' forest.txt's rows, without its comments (which start "# ": a row of dense forest starts with
  ' "#" too)
  function readRows() as string[]
    rows = [] as string[]
    for each textLine in ReadAsciiFile("pkg:/maps/forest.txt").split(Chr(10))
      textLine = textLine.trim()
      if textLine <> "" and Left(textLine, 2) <> "# "
        rows.push(textLine)
      end if
    end for
    return rows
  end function

end namespace

' A parsed forest.txt (ForestMap.readRows()). Dense forest (`#`) is solid.
class ForestLayout extends BGE.CharGrid

  ' Every cell holding something placed one per cell (ForestMap.CELL_KINDS), row by row
  cells as BGE.CharGridCell[]
  ' Each tent's 2x2 block of `T`
  tents as BGE.CharGridGroup[]
  ' Straight runs of the camp's palisade
  palisadeRuns as BGE.CharGridGroup[]
  ' The way back to the town (`E`), invalid without one
  exit as BGE.CharGridGroup

  sub new(rows as string[])
    super(rows, {cellSize: World.metres(ForestMap.CELL_METRES), solidKinds: "#"})
    m.cells = m.cellsOf(ForestMap.CELL_KINDS)
    m.tents = m.findConnectedGroups("T")
    m.palisadeRuns = m.findRuns("p")
    m.exit = m.boundsOf("E")
  end sub

  ' The dense forest as solids: each row's run of `#` is one, so there are far fewer than one per
  ' cell, plus the wall round the grid
  function denseSolids() as BGE.SolidWorld
    solids = new BGE.SolidWorld()
    size = m.cellSize
    for row = 0 to m.rowCount - 1
      runStart = -1
      for col = 0 to m.colCount
        solid = col < m.colCount and m.isSolid(col, row)
        if solid and runStart < 0
          runStart = col
        else if not solid and runStart >= 0
          corner = m.cellCenter(runStart, row)
          solids.addSolid(corner.x - size / 2, corner.z - size / 2, (col - runStart) * size, size)
          runStart = -1
        end if
      end for
    end for
    solids.addBounds(m.origin.x, m.origin.z, m.colCount * size, m.rowCount * size, size)
    return solids
  end function

end class
