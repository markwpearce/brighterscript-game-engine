import "../World.bs"
import "pkg:/source/engine/gridMaps/CharGrid.bs"

namespace GraveyardMap

  const CELL_METRES = 2
  ' Kinds whose cells make one rectangle each
  const GROUP_KINDS = "pchDE"

  ' Row 0 is the far (-z) edge, column 0 the -x edge. `,` outside the fence, `.` grass, `f` fence,
  ' `E` the gap in the fence out to the town, `g` a grave, `T` a tree, `p` the chapel, `c` the
  ' mausoleum over the crypt (its door faces +z), `D` the mausoleum's doorstep (down to the crypt),
  ' `h` the gravedigger's hut, `W` the well, `l` a fire on a stone post, `s` a spirit flame on a
  ' stone post (only beside the crypt's door: blue light means the crypt), `S` a skeleton,
  ' `@` the way in from the field.
  function layout() as string[]
    return [
      ",,,T,,,,,,,,T,,,,,,,T,,,"
      ",ffffffffffffffffffffff,"
      ",f.T..g.g...cc...g.g..f,"
      "Tf.....S....cc.....S..f,"
      ",f..g.g.....cc....g.g.f,"
      ",fl........sDDs......lf,"
      ",f....................fT"
      ",f.pppp...g.g.g..g.g..f,"
      ",f.pppp...............f,"
      "Tf.pppp...g...g..g....f,"
      ",f.pppp..T..........T.f,"
      ",f.pppp.....g.g....g..fT"
      ",f.pppp...............f,"
      ",f.pppp...g..Sg..g.g..f,"
      "Tf.......l............f,"
      ",f...T.........hh.....f,"
      ",f.g.g.........hh..W..fT"
      ",f......T......hh.....f,"
      ",f..g.g...............f,"
      ",f....................f,"
      ",fT..........@.......Tf,"
      ",f....................f,"
      ",fffffffffffEEfffffffff,"
      ",,,,T,,,,,,,,,,,,,T,,,,,"
    ]
  end function

end namespace

' The graveyard as a text grid (GraveyardMap.layout()): fences, buildings, graves, trees, lights,
' skeletons and the ways out all come from it. Nothing in it is solid by character.
class GraveyardLayout extends BGE.CharGrid

  ' Every cell that isn't grass or outside
  cells as BGE.CharGridCell[]
  ' The rectangle round each building and doorway kind (GraveyardMap.GROUP_KINDS), by kind
  groups as roAssociativeArray
  ' Straight runs of fence, each one cell wide
  fenceRuns as BGE.CharGridGroup[]

  sub new(rows as string[])
    super(rows, {cellSize: World.metres(GraveyardMap.CELL_METRES), solidKinds: ""})
    m.cells = m.cellsExcept(".,")
    m.groups = {}
    for i = 1 to Len(GraveyardMap.GROUP_KINDS)
      kind = Mid(GraveyardMap.GROUP_KINDS, i, 1)
      group = m.boundsOf(kind)
      if invalid <> group
        m.groups[kind] = group
      end if
    end for
    m.fenceRuns = m.findRuns("f")
  end sub

end class
