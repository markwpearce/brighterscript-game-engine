' A character's packed sheets, as written by tools/render-character.py --packed: the sheet
' bitmap names and every frame's rect (see BGE.SpriteFrames).
interface CharacterAtlas
  sheets as string[]
  frames as BGE.SpriteFrameRect[]
end interface

' Loads the knight's and monsters' packed sprite sheets (pkg:/sprites/<name>.json and its PNGs).
namespace CharacterSprites

  ' The atlas pkg:/sprites/<name>.json, read once
  function atlas(name as string) as CharacterAtlas
    globals = GetGlobalAA()
    if invalid = globals.characterAtlases
      globals.characterAtlases = {}
    end if
    cached = globals.characterAtlases[name]
    if invalid = cached
      path = `pkg:/sprites/${name}.json`
      parsed = ParseJson(ReadAsciiFile(path))
      sheets = [] as string[]
      frames = [] as BGE.SpriteFrameRect[]
      if invalid = parsed or invalid = parsed.sheets or invalid = parsed.frames
        print `CharacterSprites: ${path} is missing or not a sprite atlas`
      else
        for each file in parsed.sheets
          sheets.push(file.Replace(".png", ""))
        end for
        frames = parsed.frames
      end if
      cached = {sheets: sheets, frames: frames}
      globals.characterAtlases[name] = cached
    end if
    return cached
  end function

  ' Queues whichever of the atlas's sheets aren't loaded yet
  sub load(game as BGE.Game, loader as BGE.AssetLoader, name as string)
    for each sheet in CharacterSprites.atlas(name).sheets
      if invalid = game.Bitmaps[sheet]
        loader.loadBitmap(sheet, `pkg:/sprites/${sheet}.png`)
      end if
    end for
  end sub

  ' The atlas's frames, shared by every sprite made from them, or invalid if a sheet isn't loaded
  function frames(game as BGE.Game, name as string) as BGE.SpriteFrames
    atlas = CharacterSprites.atlas(name)
    if atlas.sheets.Count() = 0
      return invalid
    end if
    frames = game.getSpriteFrames(atlas.sheets, 0, 0, atlas.frames)
    if invalid = frames
      print `CharacterSprites: a sheet of ${name} (${atlas.sheets.Join(", ")}) isn't loaded`
    end if
    return frames
  end function

end namespace
