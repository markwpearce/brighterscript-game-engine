import "World.bs"

' Chase camera: sits behind and a little above the target, looking slightly down.
' The look stick orbits it (x) and tilts it (y); with no look input it drifts back
' behind a moving target.
class ThirdPersonCamera

  camera as BGE.Camera3d
  target as BGE.GameEntity
  ' Direction the camera looks along (World heading convention).
  heading as float = 0

  distance as float = World.metres(4.3)
  height as float = World.metres(1.9)
  lookHeight as float = World.metres(1.4)
  orbitSpeed as float = 2.6 ' radians/sec at full stick
  followSpeed as float = 1.2 ' radians/sec drift back behind a moving target
  recenterSpeed as float = 8.0
  ' Tilt added to the resting angle, in radians; positive looks further down on the target
  tilt as float = 0
  tiltSpeed as float = 1.6 ' radians/sec at full stick
  minTilt as float = -0.3
  maxTilt as float = 0.8

  private controls as BGE.Controller.ControlMap
  private recentering as boolean = false

  sub new(camera as BGE.Camera3d, controls as BGE.Controller.ControlMap, target as BGE.GameEntity)
    m.camera = camera
    m.controls = controls
    m.target = target
    m.heading = target.rotation.y
    m.camera.fieldOfViewDegrees = 90
    m.apply()
  end sub

  sub recenter()
    m.recentering = true
  end sub

  ' @param {float} dt
  ' @param {float} targetSpeed - how fast the target is moving, 0..1 of full speed
  sub update(dt as float, targetSpeed as float)
    look = m.controls.getRawAxis("look")
    behind = m.target.rotation.y
    if look.y <> 0
      ' Stick up looks up, so the camera drops
      m.tilt = BGE.Math.Clamp(m.tilt - look.y * m.tiltSpeed * dt, m.minTilt, m.maxTilt)
    end if
    if look.x <> 0 or look.y <> 0
      m.recentering = false
      m.heading = World.wrapAngle(m.heading + look.x * m.orbitSpeed * dt)
    else if m.recentering
      m.heading = World.turnToward(m.heading, behind, m.recenterSpeed * dt)
      m.tilt = World.turnToward(m.tilt, 0, m.recenterSpeed * dt * 0.25)
      m.recentering = World.wrapAngle(behind - m.heading) <> 0 or m.tilt <> 0
    else if targetSpeed > 0
      m.heading = World.turnToward(m.heading, behind, m.followSpeed * targetSpeed * dt)
    end if
    m.apply()
  end sub

  ' Swings the camera around the look-at point on a sphere, so tilting keeps the target framed.
  private sub apply()
    rise = m.height - m.lookHeight
    radius = Sqr(m.distance * m.distance + rise * rise)
    elevation = BGE.Math.Atan2(rise, m.distance) + m.tilt
    back = World.headingForward(m.heading)
    horizontal = -radius * Cos(elevation)
    focus = m.target.position
    lookAt = BGE.Math.VectorOps.create(focus.x, focus.y + m.lookHeight, focus.z)
    ' Never below 0.3 m off the ground
    cameraY = BGE.Math.Max(focus.y + World.metres(0.3), lookAt.y + radius * Sin(elevation))
    m.camera.position = BGE.Math.VectorOps.create(lookAt.x + back.x * horizontal, cameraY, lookAt.z + back.z * horizontal)
    m.camera.setTarget(lookAt)
  end sub

end class
