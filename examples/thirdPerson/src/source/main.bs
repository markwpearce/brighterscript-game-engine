import "Scenes/FieldScene.bs"
import "Scenes/CryptScene.bs"

sub main(args as dynamic)
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.fitCanvasToScreen()
  game.setCamera(new BGE.Camera3d())
  game.enableControllerInput()
  game.setCombineRemoteInputs(true)

  if args <> invalid and args.quality <> invalid
    ' Deep link `quality=<0-4>` pins the render quality level (basic to ultra) for measuring
    game.setQualityLevel(args.quality.toInt() as BGE.RenderQualityLevel)
  else
    ' Hold the default 20fps target by moving the render quality level automatically
    game.enableAdaptiveQuality()
  end if

  ' Gamepad first (souls-style shoulder buttons), still playable on a remote.
  game.controls.bindAxis("move", "1", 0, "Move")
  game.controls.bindAxis("look", "2", 0, "Camera")
  game.controls.bindAction("attack", "OK", "x", 0, "Attack")
  game.controls.bindAction("block", "play", "l1", 0, "Block")
  game.controls.bindAction("parry", "fastforward", "b", 0, "Parry")
  game.controls.bindAction("dodge", ["back", "replay"], "a", 0, "Dodge")
  ' Locks on, or recenters the camera with nothing to lock onto. The browser controller page
  ' sends an unaliased L2 as its button index, "6".
  game.controls.bindAction("lockOn", "rewind", ["l2", "6"], 0, "Lock on")

  game.defineScene(new FieldScene(game))
  game.defineScene(new CryptScene(game))
  ' `scene=crypt` starts in the crypt (`at=<col>,<row>`). Measuring deep links: `pillars=0|1`
  ' (`pillarStyle=model|cull|rect`), `night=0`, `enemies=0`, `perf=1` (stage times on the console)
  ' and `orbit=<-1..1>` (spins the camera by itself)
  sceneArgs = {}
  startScene = "FieldScene"
  if args <> invalid
    for each key in ["pillars", "pillarStyle", "enemies", "perf", "orbit", "night", "at"]
      if args[key] <> invalid
        sceneArgs[key] = args[key]
      end if
    end for
    if args.scene = "crypt"
      startScene = "CryptScene"
    end if
  end if
  game.changeScene(startScene, sceneArgs)

  ' FPS, input/controls, memory, GC and log panels; `*` shows them (FieldScene)
  game.enableStandardDebugUi()
  game.debugShowUi(false)

  game.play()
end sub
