import "Scenes/FieldScene.bs"
import "Scenes/CryptScene.bs"
import "Scenes/GraveyardScene.bs"
import "Scenes/TownScene.bs"
import "Scenes/InteriorScene.bs"
import "Scenes/TitleScene.bs"
import "TownStory.bs"
import "GameSave.bs"
import "Menus/GamePauseMenu.bs"
import "Menus/MenuTheme.bs"

sub main(args as dynamic)
  ' Deep link `res=480` or `res=360` draws the world at 854 x 480 or 640 x 360, scaled up to the screen
  params = new BGE.LaunchParams(args)
  canvasWidth = 1280
  canvasHeight = 720
  res = params.getString("res")
  if res = "480"
    canvasWidth = 854
    canvasHeight = 480
  else if res = "360"
    canvasWidth = 640
    canvasHeight = 360
  end if
  game = new BGE.Game(canvasWidth, canvasHeight) ' This initializes the game engine
  game.fitCanvasToScreen()
  game.setCamera(new BGE.Camera3d())
  game.enableControllerInput()
  game.setCombineRemoteInputs(true)

  ' Deep link `quality=<0-4>` pins the render quality level (basic to ultra) for measuring
  if not game.applyLaunchQuality(params)
    ' Hold a frame rate by moving the render quality level automatically: 20fps, or a scene's own
    ' (`qualityOptions`)
    game.enableAdaptiveQuality()
  end if

  ' Gamepad first (souls-style shoulder buttons), still playable on a remote.
  game.controls.bindAxis("move", "1", 0, "Move")
  game.controls.bindAxis("look", "2", 0, "Camera")
  game.controls.bindAction("attack", "OK", "x", 0, "Attack")
  game.controls.bindAction("block", "play", "l1", 0, "Block")
  game.controls.bindAction("parry", "fastforward", "b", 0, "Parry")
  ' (Back is the pause menu)
  game.controls.bindAction("dodge", "rewind", "a", 0, "Dodge")
  ' Locks on, or recenters the camera with nothing to lock onto. The browser controller page
  ' sends an unaliased L2 as its button index, "6".
  game.controls.bindAction("lockOn", "replay", ["l2", "6"], 0, "Lock on / recenter")
  ' the move stick (or d-pad) steps through dialogue choices and menus
  game.focusManager.analogAxisName = "move"

  ' The title's logo and headings in Bluu Next; menus, dialogue and banners in EB Garamond
  ' (smaller for the controls page's labels)
  game.loadFont("logo", "Bluu Next", Int(game.uiCanvas.getHeight() / 12), false, false)
  game.loadFont("heading", "Bluu Next", Int(game.uiCanvas.getHeight() / 20), false, false)
  game.loadFont("default", "EB Garamond Medium", 30, false, false)
  game.loadFont("titleMenu", "EB Garamond Medium", Int(game.uiCanvas.getHeight() / 15), false, false)
  game.loadFont("small", "EB Garamond Medium", Int(game.uiCanvas.getHeight() / 32), false, false)
  MenuTheme.apply(game.defaultTheme)
  game.defaultTheme.font = game.getFont("default")
  pauseMenu = new GamePauseMenu(game)
  game.addEntity(pauseMenu)

  game.defineScene(new TitleScene(game))
  game.defineScene(new FieldScene(game))
  game.defineScene(new CryptScene(game))
  game.defineScene(new GraveyardScene(game))
  game.defineScene(new TownScene(game))
  game.defineScene(new InteriorScene(game))
  ' The title screen is the start. Deep links skip it, and don't save: `scene=town` starts in the town, `scene=graveyard` starts in the graveyard, `scene=crypt` in the crypt (`level=<1-3>` for a deeper level), `scene=keep` or `scene=chapel` inside one, and `scene=field` on the
  ' combat field (`at=<col>,<row>[,<heading degrees>]` starts in another cell of the town, graveyard, crypt or an interior). Measuring deep links: `pillars=0|1`
  ' (`pillarStyle=model|cull|rect`), `occlusion=1` (town, `occlusionDebug=1` to see what it hides), `draw=<metres>` (any scene), `fog=0`, `hull=0`, `lead=<n>` and `groundfade=0` (town and graveyard fog), `night=0`, `enemies=0` (none; on the field a number caps them), `perf=1` (stage times on the console; `perf=phases` for just the game loop phases, without per-object timers)
  ' `orbit=<-1..1>` (spins the camera by itself) `walk=<seconds>` (walks forward, then back, by himself) `tilt=<radians>` (starts the camera looking down) `lockZone=<0..1>` (the middle of the screen a locked-on enemy moves in without the camera turning) and `zoom=<n>` (the camera zoom)
  sceneArgs = params.pick(["level", "pillars", "pillarStyle", "enemies", "perf", "runid", "orbit", "walk", "tilt", "lockZone", "zoom", "orbitPause", "night", "at", "occlusion", "occlusionDebug", "fog", "draw", "hull", "lead", "groundfade"])
  sceneAliases = {title: "TitleScene", town: "TownScene", crypt: "CryptScene", graveyard: "GraveyardScene", field: "FieldScene", keep: "InteriorScene", chapel: "InteriorScene"}
  startScene = params.sceneName(game.getSceneNames(), "TitleScene", sceneAliases)
  if params.has("at") and startScene = "TitleScene"
    startScene = "TownScene"
  end if
  if startScene <> "TitleScene"
    SaveData.current().slot.enabled = false
  end if
  place = LCase(params.getString("scene"))
  if place = "keep" or place = "chapel"
    sceneArgs.place = place
  end if
  if params.has("strips")
    strips = params.pick(["strips", "impostor", "stripStep", "stripWidth", "stripKnots", "stripPoints", "stripError", "stripMax", "stripAngle", "stripScale", "stripLinear", "stripLevel", "blitScale", "blitAngle", "blitAngleScale", "blitDepth", "blitRoll", "newFace", "newFaceArea"])
    GetGlobalAA().impostorStrips = strips
    print "[thirdPerson] impostor strips: "; FormatJson(strips)
  end if
  ' The town's story, made now so a boss killed in any scene reaches it
  TownStory.session(game)
  game.changeScene(startScene, sceneArgs)

  ' `*` cycles: nothing, just the FPS panel, then every panel (FPS, input, memory, GC, log) with
  ' entity details and colliders
  fpsOnly = {input: false, memory: false, garbageCollector: false, log: false}
  game.enableDebugToggle({levels: [
    {},
    {showUi: true, panels: fpsOnly},
    {showUi: true, panels: {}, entityDetails: true, colliders: true}
  ]})
  perf = params.getString("perf")
  if perf = "1" or perf = "phases"
    ' game loop phases too: input, update and collisions, drawing, the buffer swap
    game.debugPrintPerfStats(true, 3)
  end if

  game.applyLaunchSplash(params)
  game.play()
end sub
