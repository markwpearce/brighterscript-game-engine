import "Scenes/FieldScene.bs"
import "Scenes/CryptScene.bs"
import "Scenes/GraveyardScene.bs"
import "Scenes/TownScene.bs"

sub main(args as dynamic)
  ' Deep link `res=480` or `res=360` draws the world at 854 x 480 or 640 x 360, scaled up to the screen
  canvasWidth = 1280
  canvasHeight = 720
  if args <> invalid and args.res = "480"
    canvasWidth = 854
    canvasHeight = 480
  else if args <> invalid and args.res = "360"
    canvasWidth = 640
    canvasHeight = 360
  end if
  game = new BGE.Game(canvasWidth, canvasHeight) ' This initializes the game engine
  game.fitCanvasToScreen()
  game.setCamera(new BGE.Camera3d())
  game.enableControllerInput()
  game.setCombineRemoteInputs(true)

  if args <> invalid and args.quality <> invalid
    ' Deep link `quality=<0-4>` pins the render quality level (basic to ultra) for measuring
    game.setQualityLevel(args.quality.toInt() as BGE.RenderQualityLevel)
  else
    ' Hold the default 20fps target by moving the render quality level automatically
    game.enableAdaptiveQuality()
  end if

  ' Gamepad first (souls-style shoulder buttons), still playable on a remote.
  game.controls.bindAxis("move", "1", 0, "Move")
  game.controls.bindAxis("look", "2", 0, "Camera")
  game.controls.bindAction("attack", "OK", "x", 0, "Attack")
  game.controls.bindAction("block", "play", "l1", 0, "Block")
  game.controls.bindAction("parry", "fastforward", "b", 0, "Parry")
  game.controls.bindAction("dodge", ["back", "replay"], "a", 0, "Dodge")
  ' Locks on, or recenters the camera with nothing to lock onto. The browser controller page
  ' sends an unaliased L2 as its button index, "6".
  game.controls.bindAction("lockOn", "rewind", ["l2", "6"], 0, "Lock on")

  game.defineScene(new FieldScene(game))
  game.defineScene(new CryptScene(game))
  game.defineScene(new GraveyardScene(game))
  game.defineScene(new TownScene(game))
  ' The town is the start. `scene=graveyard` starts in the graveyard, `scene=crypt` in the crypt and `scene=field` on the
  ' combat field (`at=<col>,<row>` starts in another cell of the town, graveyard or crypt). Measuring deep links: `pillars=0|1`
  ' (`pillarStyle=model|cull|rect`), `occlusion=1` and `fog=0|<style>` (town), `night=0`, `enemies=0`, `perf=1` (stage times on the console)
  ' and `orbit=<-1..1>` (spins the camera by itself)
  sceneArgs = {}
  startScene = "TownScene"
  if args <> invalid
    for each key in ["pillars", "pillarStyle", "enemies", "perf", "orbit", "night", "at", "occlusion", "fog"]
      if args[key] <> invalid
        sceneArgs[key] = args[key]
      end if
    end for
    if args.scene = "crypt"
      startScene = "CryptScene"
    else if args.scene = "graveyard"
      startScene = "GraveyardScene"
    else if args.scene = "field"
      startScene = "FieldScene"
    end if
  end if
  game.changeScene(startScene, sceneArgs)

  ' FPS, input/controls, memory, GC and log panels; `*` cycles through just FPS and all of them
  game.enableStandardDebugUi()
  game.debugShowUi(false)
  if args <> invalid and args.perf = "1"
    ' game loop phases too: input, update and collisions, drawing, the buffer swap
    game.debugPrintPerfStats(true, 3)
  end if

  game.play()
end sub
