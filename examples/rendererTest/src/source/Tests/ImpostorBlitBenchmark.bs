' What it would cost to draw a cached model bitmap (an impostor) instead of redrawing the
' model, at roughly examples/terrain's chapel size on screen (#345): a non-uniform scaled
' blit, a rotate+scale blit, and an exact corner pin onto a slightly perspective-skewed quad.
' Each pass draws into an offscreen bitmap and Finish()es it, so queued GPU work is counted.
class ImpostorBlitBenchmark extends RendererTest

  private width = 360
  private height = 300
  private blitCount = 60
  ' the exact warp is slow enough to trip the "app not responding" watchdog in bulk
  private pinCount = 6

  private resultLines as string[] = []

  sub new()
    super("Impostor Blit Benchmark")
  end sub

  override sub setup(renderer as BGE.Renderer)
    source = CreateObject("roBitmap", {width: m.width, height: m.height, alphaEnable: true})
    source.Clear(&h00000000)
    ' something chapel-ish: a wall, a roof, a tower, with transparent space around them
    source.DrawRect(40, 120, 280, 170, &h9A8C7AFF)
    source.DrawRect(60, 60, 240, 60, &h5A4A3AFF)
    source.DrawRect(140, 0, 80, 120, &hB0A08AFF)
    region = CreateObject("roRegion", source, 0, 0, m.width, m.height)
    regionWithId = BGE.RendererHelpers.createRegionWithId(region, "impostor-benchmark")
    target = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
    timer = CreateObject("roTimespan")

    timer.Mark()
    for i = 0 to m.blitCount - 1
      scaleX = 0.8 + 0.4 * i / m.blitCount
      renderer.drawScaledObjectTo(target, 400 + i, 200, scaleX, 1.0 + 0.1 * scaleX, region, &hFFFFFFFF)
    end for
    target.Finish()
    scaledMs = timer.TotalMilliseconds()

    timer.Mark()
    for i = 0 to m.blitCount - 1
      renderer.drawTransformedObjectTo(target, 400 + i, 200, 0.9, 1.05, 0.002 * i, region, &hFFFFFFFF)
    end for
    target.Finish()
    transformedMs = timer.TotalMilliseconds()

    timer.Mark()
    for i = 0 to m.pinCount - 1
      ' a camera a few degrees off the capture view: one side a little taller than the other
      skew = 4 + 3 * i
      quad = new BGE.Math.CornerPoints()
      quad.topLeft = BGE.Math.VectorOps.create(400, 200 - skew)
      quad.topRight = BGE.Math.VectorOps.create(400 + m.width * 0.9, 200)
      quad.bottomLeft = BGE.Math.VectorOps.create(400, 200 + m.height + skew)
      quad.bottomRight = BGE.Math.VectorOps.create(400 + m.width * 0.9, 200 + m.height)
      renderer.drawPinnedCornersTo(target, quad, regionWithId, {}, &hFFFFFFFF)
    end for
    target.Finish()
    pinnedMs = timer.TotalMilliseconds()

    ' the same quad turned 20 degrees - the exact warp's cost depends on rotation
    rotatedPinCount = 3
    timer.Mark()
    for i = 0 to rotatedPinCount - 1
      quad = new BGE.Math.CornerPoints()
      angle = BGE.Math.DegreesToRadians(20 + i)
      cx = 640
      cy = 360
      quad.topLeft = m.rotated(cx, cy, -m.width * 0.45, -m.height / 2, angle)
      quad.topRight = m.rotated(cx, cy, m.width * 0.45, -m.height / 2, angle)
      quad.bottomLeft = m.rotated(cx, cy, -m.width * 0.45, m.height / 2, angle)
      quad.bottomRight = m.rotated(cx, cy, m.width * 0.45, m.height / 2, angle)
      renderer.drawPinnedCornersTo(target, quad, regionWithId, {}, &hFFFFFFFF)
    end for
    target.Finish()
    rotatedPinnedMs = timer.TotalMilliseconds()

    m.resultLines = [
      `${m.width}x${m.height} source, drawn into an offscreen 1280x720 bitmap`,
      "",
      `DrawScaledObject (non-uniform):  ${m.perOp(scaledMs, m.blitCount)} ms each (${m.blitCount})`,
      `DrawTransformedObject:           ${m.perOp(transformedMs, m.blitCount)} ms each (${m.blitCount})`,
      `drawPinnedCorners (skewed quad): ${m.perOp(pinnedMs, m.pinCount)} ms each (${m.pinCount})`,
      `drawPinnedCorners (rotated 20):  ${m.perOp(rotatedPinnedMs, rotatedPinCount)} ms each (${rotatedPinCount})`
    ]
    print "=== Impostor Blit Benchmark ==="
    for each line in m.resultLines
      print line
    end for
    print "=== end ==="
  end sub

  private function rotated(cx as float, cy as float, dX as float, dY as float, angle as float) as BGE.Math.Vector
    return BGE.Math.VectorOps.create(cx + dX * cos(angle) - dY * sin(angle), cy + dX * sin(angle) + dY * cos(angle))
  end function

  private function perOp(totalMs as integer, iterations as integer) as string
    return Str(totalMs / iterations).trim()
  end function

  override sub draw(renderer as BGE.Renderer)
    y = 80
    for each line in m.resultLines
      renderer.drawText(line, 60, y, BGE.Colors.White)
      y += 28
    end for
  end sub

end class
