' Demonstrates Renderer.drawFogBands() - a cheap screen-space distance-fog
' approximation for horizon-style scenes, built entirely from a handful of
' stacked, translucent DrawRect calls rather than any per-object color
' blending. Up/Down changes bandCount live so the falloff/cost tradeoff is
' visible directly in the timing line under this demo.
class FogBandsTest extends RendererTest

  bandCount as integer = 8
  fogEndY as float = 320

  sub new()
    super("Drawing: Fog Bands")
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "up"
      m.bandCount++
    else if buttonName = "down" and m.bandCount > 1
      m.bandCount--
    end if
  end sub

  override sub draw(renderer as BGE.Renderer)
    ' A placeholder "ground" below the horizon, so the fog band has
    ' something distinct to fade toward.
    renderer.drawRectangle(0, m.fogEndY, 1280, 720 - m.fogEndY, BGE.Colors.Green)
    renderer.drawFogBands(BGE.ColorsRGB.Silver, m.fogEndY, m.bandCount)
    renderer.drawText(`bandCount: ${m.bandCount} (Up/Down to change)`, 20, 20, BGE.Colors.White)
  end sub

end class
