' Stands in for the slice of BGE.Game a bare GameEntity owner touches, for demos that
' still use one (QualityLevelsTest). A real Game would create a second roScreen and
' steal the display from main.bs. New demos can use ownerless drawables (#231) instead.
class BenchmarkGameStub

  private nextEntityId = 0

  function getNextGameEntityId() as string
    id = m.nextEntityId.ToStr()
    m.nextEntityId++
    return id
  end function

  sub log(message as string, level = 0 as dynamic)
    print "[benchmark owner] "; message
  end sub

  function getDebugValue(debugKey as string) as dynamic
    return invalid
  end function

end class
