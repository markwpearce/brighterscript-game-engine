' Checks that a negative scale mirrors an image (issue #237). The top row calls the native
' draw call directly, showing how this device handles a negative scale: it mirrors at a
' rotation of 0, but real hardware turns the region half way round instead once it is also
' rotated. The bottom row is four directScaled billboards with flipped scales, drawn
' through the full SceneObject path, labelled with their scale. The red corner marks the image's own top left, so it
' should end up where each label says. OK rolls the camera, banking the billboards.
class NegativeScaleTest extends RendererTest

  renderer as BGE.Renderer
  camera as BGE.Camera3d
  previousCamera as BGE.Camera
  marker as roBitmap
  images = []
  sceneObjects = []

  sub new()
    super("Negative Scale Mirroring (OK: roll camera)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.renderer = renderer
    m.marker = m.createMarker()

    ' main.bs shares one Renderer across every demo, so put its camera back in teardown().
    m.previousCamera = renderer.camera
    m.camera = new BGE.Camera3d()
    renderer.setCamera(m.camera)

    scales = [[1, 1], [-1, 1], [1, -1], [-1, -1]]
    for i = 0 to scales.count() - 1
      region = CreateObject("roRegion", m.marker, 0, 0, m.marker.GetWidth(), m.marker.GetHeight())
      ' centre-anchored, so each one flips in place
      region.SetPretranslation(-m.marker.GetWidth() / 2, -m.marker.GetHeight() / 2)
      image = new BGE.Image(invalid, region, {
        offset: BGE.Math.VectorOps.create(-510 + 340 * i, -150, 0),
        scale: BGE.Math.VectorOps.create(scales[i][0], scales[i][1], 1),
        drawMode: BGE.SceneObjectDrawMode.directScaled,
        banksWithCameraRoll: true
      })
      m.images.push(image)
      sceneObj = image.addToRenderer(renderer)
      if invalid <> sceneObj
        m.sceneObjects.push(sceneObj)
      end if
    end for
  end sub

  override sub draw(renderer as BGE.Renderer)
    renderer.setupCameraForFrame()
    renderer.render()

    ' Each panel's draw position is marked in yellow. A region drawn at a negative scale
    ' extends left of (or above) that point.
    screen = m.screenRef
    small = 0.6
    size = m.marker.GetWidth() * small
    top = 100
    panels = [
      {x: 140, y: top, sx: 1, sy: 1, deg: 0, label: "1,1 at 0 deg", expect: "red top left"},
      {x: 420 + size, y: top, sx: -1, sy: 1, deg: 0, label: "-1,1 at 0 deg", expect: "red top right"},
      {x: 700, y: top + size, sx: 1, sy: -1, deg: 0, label: "1,-1 at 0 deg", expect: "red bottom left"},
      {x: 980 + size, y: top, sx: -1, sy: 1, deg: 360, label: "-1,1 at 360 deg", expect: "mirror: red top right"}
    ]
    for each panel in panels
      screen.DrawTransformedObject(panel.x, panel.y, panel.deg, panel.sx * small, panel.sy * small, m.marker)
      screen.DrawRect(panel.x - 3, panel.y - 3, 6, 6, &hFFFF00FF)
      labelX = panel.x + size / 2
      if panel.sx < 0
        labelX = panel.x - size / 2
      end if
      renderer.drawText(panel.label, labelX, top + size + 8, BGE.Colors.White, invalid, "center")
      renderer.drawText(panel.expect, labelX, top + size + 38, BGE.Colors.Gray, invalid, "center")
    end for

    corners = ["red top left", "red top right", "red bottom left", "red bottom right"]
    for i = 0 to m.sceneObjects.count() - 1
      bounds = (m.sceneObjects[i] as BGE.SceneObjectImage).getCanvasPoints().getBounds()
      x = (bounds[0].x + bounds[1].x) / 2
      scale = m.images[i].scale
      renderer.drawText("scale " + scale.x.toStr() + "," + scale.y.toStr(), x, bounds[1].y + 8, BGE.Colors.White, invalid, "center")
      renderer.drawText(corners[i], x, bounds[1].y + 38, BGE.Colors.Gray, invalid, "center")
    end for
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "OK"
      if m.camera.rollDegrees = 0
        m.camera.rollDegrees = 20
      else
        m.camera.rollDegrees = 0
      end if
    end if
  end sub

  override sub teardown(renderer as BGE.Renderer)
    for each sceneObj in m.sceneObjects
      renderer.removeSceneObject(sceneObj)
    end for
    m.sceneObjects = []
    m.images = []
    renderer.setCamera(m.previousCamera)
  end sub

  ' The Roku logo (asymmetric text, so a mirror is obvious) with a red top left corner.
  private function createMarker() as roBitmap
    size = 160
    logo = CreateObject("roBitmap", "pkg:/sprites/roku-logo-purple.png")
    marker = CreateObject("roBitmap", {width: size, height: size, alphaEnable: true})
    marker.DrawScaledObject(0, 0, size / logo.GetWidth(), size / logo.GetHeight(), logo)
    marker.DrawRect(0, 0, 40, 40, BGE.Colors.Red)
    return marker
  end function

end class
