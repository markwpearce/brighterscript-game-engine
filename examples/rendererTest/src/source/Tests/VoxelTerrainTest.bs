' Voxel terrain (BGE.DrawableVoxelTerrain, #637; spike #549): a generated 256 map, flown over
' with a Camera3d, with trees and balloons as billboards that hide behind the hills.
'
' Controls: left/right turn (and bank), up/down pitch by 5 degrees, rewind/fast forward height,
' options (*) cycles the quality level, OK switches pitchMode (horizonShift / exact), play pauses.
'
' Launch params:
'   quality=basic|low|medium|high|ultra   start level (default high)
'   pitchMode=horizonShift|exact    pitch=  degrees, up positive (default -10)
'   bank=                   degrees: holds the roll instead of banking into turns
'   objects=                how many billboards (default 160)
'   fog=1                   Camera3d fog in the sky colour instead of the terrain's own fade
'   still=1                 hold the camera still but render every frame, log a `VOXEL still` line
'   sweep=1                 fly through every case of qualityList= (default all five levels) x
'                           pitchModes= (default horizonShift,exact), warmup= then samples=
'                           frames each, logging a `VOXEL case` line per case
'   runid=                  printed first, as the console replays old output
class VoxelTerrainTest extends RendererTest

  private cellSize as float = 4.0
  private heightScale as float = 1.5
  private skyRgb as integer = &h8EC5F0
  private qualityNames = ["basic", "low", "medium", "high", "ultra"] as string[]
  private qualityIndex as integer = 3
  private pitchModes = ["horizonShift", "exact"] as string[]

  private rendererRef as BGE.Renderer
  private camera as BGE.Camera3d
  private previousCamera as BGE.Camera
  private terrain as BGE.DrawableVoxelTerrain
  private terrainObj as BGE.SceneObjectVoxelTerrain
  private map as BGE.VoxelMap
  private font as roFont

  ' camera, in world units and radians
  private camX as float = 0
  private camZ as float = 0
  private camY as float = 270
  private heading as float = 0
  private pitchDegrees as float = -10
  private turnRate as float = 0
  private fixedBank as dynamic = invalid
  private flySpeed as float = 240
  private flying as boolean = true
  private still as boolean = false

  private sweeping as boolean = false
  private sweepCases = [] as roAssociativeArray[]
  private sweepIndex as integer = 0
  private warmupFrames as integer = 20
  private sampleFrames as integer = 60
  private frameCount as integer = 0
  private sample as roAssociativeArray = {}
  private frameClock = CreateObject("roTimespan")
  private sweepDone as boolean = false
  private lastFrameUs as integer = 0
  private lastRenderUs as integer = 0
  private renderClock = CreateObject("roTimespan")

  sub new()
    super("Voxel Terrain (#637)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    params = m.launchParams
    print "VOXEL start "; params.runid
    m.rendererRef = renderer
    m.font = CreateObject("roFontRegistry").GetDefaultFont(20, false, false)
    canvas = renderer.getCanvasSize()

    m.camera = new BGE.Camera3d()
    m.camera.setFrameSize(canvas.x, canvas.y)
    m.camera.fieldOfViewDegrees = 90
    m.camera.maxDrawDistance = 2400
    m.camera.drawDistanceFadeFraction = 0.1
    m.camera.drawDistanceTransitionSeconds = 0
    if params.fog = "1"
      m.camera.fog.enabled = true
      m.camera.fog.color = m.skyRgb
    end if
    m.previousCamera = renderer.camera
    renderer.setCamera(m.camera)
    renderer.profileStages = true

    clock = CreateObject("roTimespan")
    generator = new BGE.VoxelMapGenerator({size: 256, seed: 12345})
    m.map = generator.generate()
    print "VOXEL generated 256 in "; clock.TotalMilliseconds(); " ms"
    ' the games' path: a baked file
    m.map.saveToFile("tmp:/voxel-demo.bvox")
    clock.Mark()
    loaded = BGE.VoxelMaps.fromFile("tmp:/voxel-demo.bvox")
    print "VOXEL loaded 256 .bvox in "; clock.TotalMilliseconds(); " ms"
    if invalid <> loaded
      m.map = loaded
    end if

    fade = {color: m.skyRgb, start: 0.5}
    m.terrain = new BGE.DrawableVoxelTerrain(invalid, m.map, {cellSize: m.cellSize, heightScale: m.heightScale, fade: fade})
    m.terrainObj = m.terrain.addToRenderer(renderer) as BGE.SceneObjectVoxelTerrain

    objectCount = 160
    if invalid <> params.objects
      objectCount = params.objects.toInt()
    end if
    m.scatterObjects(renderer, objectCount)

    if invalid <> params.quality
      m.qualityIndex = m.indexOf(m.qualityNames, params.quality, m.qualityIndex)
    end if
    if invalid <> params.pitchMode
      m.terrain.pitchMode = params.pitchMode
    end if
    if invalid <> params.pitch
      m.pitchDegrees = params.pitch.toFloat()
    end if
    if invalid <> params.bank
      m.fixedBank = params.bank.toFloat()
    end if
    if invalid <> params.warmup
      m.warmupFrames = params.warmup.toInt()
    end if
    if invalid <> params.samples
      m.sampleFrames = params.samples.toInt()
    end if
    worldSize = m.map.size * m.cellSize
    m.camX = worldSize / 2
    m.camZ = worldSize / 2
    m.still = params.still = "1"
    if m.still
      m.flying = false
    end if
    m.sample = {terrain: 0, objects: 0, frame: 0, render: 0, swap: 0, spans: 0, steps: 0, redraws: 0, hidden: 0, stages: {}}

    m.sweeping = params.sweep = "1"
    if m.sweeping
      names = m.qualityNames
      if invalid <> params.qualityList and params.qualityList <> ""
        names = params.qualityList.split(",")
      end if
      modes = m.pitchModes
      if invalid <> params.pitchModes and params.pitchModes <> ""
        modes = params.pitchModes.split(",")
      end if
      for each mode in modes
        for each name in names
          m.sweepCases.push({quality: m.indexOf(m.qualityNames, name, 3), pitchMode: mode})
        end for
      end for
      m.startCase()
    end if
    m.applyQuality()
  end sub

  override sub teardown(renderer as BGE.Renderer)
    for each sceneObj in renderer.getSceneObjectsCopy()
      renderer.removeSceneObject(sceneObj)
    end for
    renderer.profileStages = false
    renderer.setQualitySettings(BGE.getRenderQualityPreset(BGE.RenderQualityLevel.high))
    renderer.setCamera(m.previousCamera)
  end sub

  private function indexOf(names as string[], name as string, fallback as integer) as integer
    for i = 0 to names.count() - 1
      if names[i] = name
        return i
      end if
    end for
    return fallback
  end function

  private sub applyQuality()
    m.rendererRef.setQualitySettings(BGE.getRenderQualityPreset(m.qualityIndex as BGE.RenderQualityLevel))
  end sub

  private sub startCase()
    c = m.sweepCases[m.sweepIndex]
    m.qualityIndex = c.quality
    m.terrain.pitchMode = c.pitchMode
    m.applyQuality()
    m.frameCount = 0
    m.sample = {terrain: 0, objects: 0, frame: 0, render: 0, swap: 0, spans: 0, steps: 0, redraws: 0, hidden: 0, stages: {}}
  end sub

  ' Trees on grass and a few balloons over anything, as billboards standing on the terrain
  private sub scatterObjects(renderer as BGE.Renderer, count as integer)
    tree = m.createTreeSprite()
    balloon = m.createBalloonSprite()
    treeRegion = CreateObject("roRegion", tree, 0, 0, tree.GetWidth(), tree.GetHeight())
    balloonRegion = CreateObject("roRegion", balloon, 0, 0, balloon.GetWidth(), balloon.GetHeight())
    seed = 777&
    placed = 0
    attempts = 0
    worldSize = m.map.size * m.cellSize
    while placed < count and attempts < count * 20
      attempts++
      seed = (seed * 1103515245& + 12345&) mod 2147483648&
      x = (seed / 2147483648.0) * worldSize
      seed = (seed * 1103515245& + 12345&) mod 2147483648&
      z = (seed / 2147483648.0) * worldSize
      cellHeight = m.map.heightAt(x / m.cellSize, z / m.cellSize)
      region = invalid
      y = m.terrain.heightAt(x, z)
      scale = 0.5
      if placed mod 10 = 9
        region = balloonRegion
        y += 120 + (placed mod 7) * 20
        scale = 1.0
      else if cellHeight >= 80 and cellHeight < 160
        region = treeRegion
      end if
      if invalid <> region
        ' directScaled: one scaled blit each, like the spike's sprites (they stay upright under roll)
        image = new BGE.Image(invalid, region, {
          offset: BGE.Math.VectorOps.create(x, y, z),
          scale: BGE.Math.VectorOps.create(scale, scale, 1),
          drawMode: BGE.SceneObjectDrawMode.directScaled
        })
        image.setAnchor(0.5, 1)
        image.addToRenderer(renderer)
        placed++
      end if
    end while
    print "VOXEL objects "; placed
  end sub

  private function createTreeSprite() as roBitmap
    bmp = CreateObject("roBitmap", {width: 32, height: 48, alphaEnable: true})
    bmp.Clear(&h00000000)
    bmp.DrawRect(13, 36, 6, 12, &h5A3A1EFF)
    for row = 0 to 35
      half = 2 + row * 14 / 35
      shade = &h1F5A1EFF
      if row mod 12 > 8
        shade = &h17461AFF
      end if
      bmp.DrawRect(16 - half, row, half * 2, 1, shade)
    end for
    return bmp
  end function

  private function createBalloonSprite() as roBitmap
    bmp = CreateObject("roBitmap", {width: 32, height: 44, alphaEnable: true})
    bmp.Clear(&h00000000)
    for row = 0 to 31
      dy = (row - 15.5) / 16
      half = cint(16 * sqr(BGE.Math.Max(0, 1 - dy * dy)))
      color = &hE04030FF
      if (row \ 6) mod 2 = 1
        color = &hF0C040FF
      end if
      bmp.DrawRect(16 - half, row, half * 2, 1, color)
    end for
    bmp.DrawRect(10, 32, 1, 6, &h333333FF)
    bmp.DrawRect(21, 32, 1, 6, &h333333FF)
    bmp.DrawRect(11, 37, 10, 7, &h7A5230FF)
    return bmp
  end function

  override sub onInput(buttonName as string)
    if buttonName = "left"
      m.turnRate = BGE.Math.Min(m.turnRate + 0.3, 0.9)
    else if buttonName = "right"
      m.turnRate = BGE.Math.Max(m.turnRate - 0.3, -0.9)
    else if buttonName = "up"
      m.pitchDegrees = BGE.Math.Min(m.pitchDegrees + 5, 60)
    else if buttonName = "down"
      m.pitchDegrees = BGE.Math.Max(m.pitchDegrees - 5, -60)
    else if buttonName = "fastforward"
      m.camY += 60
    else if buttonName = "rewind"
      m.camY -= 60
    else if buttonName = "options"
      m.qualityIndex = (m.qualityIndex + 1) mod m.qualityNames.count()
      m.applyQuality()
    else if buttonName = "OK"
      if m.terrain.pitchMode = BGE.VoxelPitchMode.exact
        m.terrain.pitchMode = BGE.VoxelPitchMode.horizonShift
      else
        m.terrain.pitchMode = BGE.VoxelPitchMode.exact
      end if
    else if buttonName = "play"
      m.flying = not m.flying
    end if
  end sub

  override sub update(dt as float)
    if dt > 0.1
      dt = 0.1
    end if
    if m.flying or m.sweeping
      m.camX -= sin(m.heading) * m.flySpeed * dt
      m.camZ -= cos(m.heading) * m.flySpeed * dt
      if m.sweeping
        m.turnRate = 0.15
      end if
    end if
    if m.turnRate <> 0
      m.heading += m.turnRate * dt
      if not m.sweeping
        decay = 0.45 * dt
        if abs(m.turnRate) <= decay
          m.turnRate = 0
        else if m.turnRate > 0
          m.turnRate -= decay
        else
          m.turnRate += decay
        end if
      end if
    end if
    ground = m.terrain.heightAt(m.camX, m.camZ) + 30
    if m.camY < ground
      m.camY = ground
    end if
    roll = -m.turnRate * 30
    if invalid <> m.fixedBank
      roll = m.fixedBank
    end if
    pitch = BGE.Math.DegreesToRadians(m.pitchDegrees)
    m.camera.position = BGE.Math.VectorOps.create(m.camX, m.camY, m.camZ)
    m.camera.orientation = BGE.Math.VectorOps.create(-sin(m.heading) * cos(pitch), sin(pitch), -cos(m.heading) * cos(pitch))
    m.camera.rollDegrees = roll
  end sub

  override sub draw(renderer as BGE.Renderer)
    canvas = renderer.getCanvasSize()
    renderer.getDraw2d().DrawRect(0, 0, canvas.x, canvas.y, (m.skyRgb << 8) + 255)
    renderer.setupCameraForFrame()
    m.renderClock.Mark()
    renderer.render()
    m.lastRenderUs = m.renderClock.TotalMicroseconds()
    m.lastFrameUs = m.frameClock.TotalMicroseconds()
    m.frameClock.Mark()
    stages = renderer.getStageMsLastFrame()
    terrainMs = stages.terrain ?? 0
    objectsMs = (stages.objects ?? 0) + (stages.clusters ?? 0)
    view = m.terrainObj.view
    if m.sweeping or m.still
      m.recordFrame(terrainMs, objectsMs, view)
    end if
    levels = ""
    for each level in view.getBandLevels()
      levels += Str(level).trim()
    end for
    lines = [
      `${m.qualityNames[m.qualityIndex]} (${view.columns} columns, ${view.bandSteps} steps/band)  ${m.terrain.pitchMode} pitch ${cint(m.pitchDegrees)}  roll ${cint(m.camera.rollDegrees)}`
      `terrain ${terrainMs} ms  objects ${objectsMs} ms  frame ${m.lastFrameUs \ 1000} ms  spans ${view.spanCount}  steps ${view.stepCount}  redraws ${m.terrainObj.redrawsLastFrame}  hidden ${renderer.getOccludedCountLastFrame()}  mips ${levels}`
      "L/R turn  U/D pitch  RW/FF height  * quality  OK pitch mode  Play pause"
    ]
    if m.sweeping
      lines[2] = `sweep ${m.sweepIndex + 1}/${m.sweepCases.count()}`
      if m.sweepDone
        lines[2] = "sweep done"
      end if
    end if
    y = 60
    for each line in lines
      renderer.drawText(line, 100, y, BGE.Colors.White, m.font)
      y += 26
    end for
  end sub

  ' With still=1 or sweep=1: averages sampleFrames frames after warmupFrames, then logs a `VOXEL`
  ' line (still: once; sweep: per case, moving to the next)
  private sub recordFrame(terrainMs as integer, objectsMs as integer, view as BGE.VoxelTerrainView)
    if m.sweepDone
      return
    end if
    m.frameCount++
    if m.frameCount <= m.warmupFrames or m.frameCount > m.warmupFrames + m.sampleFrames
      return
    end if
    s = m.sample
    s.terrain += terrainMs
    s.objects += objectsMs
    s.frame += m.lastFrameUs
    stages = m.rendererRef.getStageMsLastFrame()
    for each name in stages
      s.stages[name] = (s.stages[name] ?? 0) + stages[name]
    end for
    s.render += m.lastRenderUs
    s.swap += m.lastSwapMs
    s.spans += view.spanCount
    s.steps += view.stepCount
    s.redraws += m.terrainObj.redrawsLastFrame
    s.hidden += m.rendererRef.getOccludedCountLastFrame()
    if m.frameCount < m.warmupFrames + m.sampleFrames
      return
    end if
    n = m.sampleFrames
    kind = "still"
    if m.sweeping
      kind = "case"
    end if
    frameMs = cint(s.frame / n / 100) / 10
    fps = cint(10000000 / (s.frame / n)) / 10
    print `VOXEL ${kind} ${m.qualityNames[m.qualityIndex]} ${m.terrain.pitchMode} pitch ${cint(m.pitchDegrees)} bank ${cint(m.camera.rollDegrees)} steps ${cint(s.steps / n)} spans ${cint(s.spans / n)} redraws ${cint(s.redraws / n)} hidden ${cint(s.hidden / n)} terrain ${cint(s.terrain / n * 10) / 10} ms objects ${cint(s.objects / n * 10) / 10} ms render ${cint(s.render / n / 100) / 10} ms swap ${cint(s.swap / n * 10) / 10} ms frame ${frameMs} ms fps ${fps} columns ${m.terrainObj.view.columns}`
    stageText = ""
    for each name in s.stages
      stageText += ` ${name}=${cint(s.stages[name] / n * 10) / 10}`
    end for
    print `VOXEL stages${stageText}`
    if not m.sweeping
      print "VOXEL end"
      m.sweepDone = true
      return
    end if
    m.sweepIndex++
    if m.sweepIndex >= m.sweepCases.count()
      m.sweepDone = true
      print "VOXEL end"
      return
    end if
    m.startCase()
  end sub

end class
