' Demonstrates Renderer.drawRoundedRectangle() at a range of radii, including a radius
' large enough to exceed half of a rectangle's width/height (the clamped-to-a-"stadium"
' shape on the far right) and radius 0 (a plain rectangle, far left) - see issue #102.
class RoundedRectangleTest extends RendererTest

  sub new()
    super("Rounded Rectangle")
  end sub

  override sub draw(renderer as BGE.Renderer)
    canvasCenter = renderer.getCanvasCenter()

    width = 220
    height = 140
    radii = [0, 10, 30, 60, 200]
    colors = [BGE.Colors.White, BGE.Colors.Cyan, BGE.Colors.Yellow, BGE.Colors.Green, BGE.Colors.Magenta]

    startX = canvasCenter.x - ((radii.count() * (width + 20)) / 2)
    y = canvasCenter.y - (height / 2)

    for i = 0 to radii.count() - 1
      x = startX + (i * (width + 20))
      renderer.drawRoundedRectangle(x, y, width, height, radii[i], colors[i])
      renderer.drawText("radius " + radii[i].toStr(), x + (width / 2), y + height + 15, BGE.Colors.Gray, invalid, "center")
    end for
  end sub

end class
