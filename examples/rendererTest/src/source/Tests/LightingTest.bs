' Shaded models and a billboard lit by BGE lights (#189). The models stand still while
' a red point light orbits them, so every frame relights them without any movement.
' OK cycles the lights: camera-facing (none), directional, point, all. The ground plane
' is only shaded by lights, so it's unlit with none.
class LightingTest extends RendererTest

  private ownerGameStub as object
  private owner as BGE.GameEntity
  private camera as BGE.Camera3d
  private previousCamera as BGE.Camera
  private rendererRef as BGE.Renderer
  private sun as BGE.DirectionalLight
  private lamp as BGE.PointLight
  private ambient as BGE.AmbientLight
  private setupIndex as integer = 3
  private setupNames = ["none (camera-facing)", "directional", "point", "directional + point + ambient"]
  private orbit as float = 0

  sub new()
    super("Lighting (OK: next light setup)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.rendererRef = renderer
    m.ownerGameStub = new BenchmarkGameStub()
    m.owner = new BGE.GameEntity((m.ownerGameStub as dynamic), {name: "LightingOwner"})

    m.camera = new BGE.Camera3d()
    m.camera.position = BGE.Math.VectorOps.create(0, 120, 500)
    m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, 0))
    m.camera.maxDrawDistance = 1500
    m.previousCamera = renderer.camera
    renderer.setCamera(m.camera)

    sphere = new BGE.DrawableModel(m.owner, m.createSphereModel(90, 12, 8, BGE.Colors.White), {drawMode: BGE.SceneObjectDrawMode.solid})
    sphere.offset = BGE.Math.VectorOps.create(-130, 0, 0)
    sphere.addToRenderer(renderer)

    cube = new BGE.DrawableModel(m.owner, m.createCubeModel(70, &hE0C080FF), {drawMode: BGE.SceneObjectDrawMode.solid, rotation: BGE.Math.VectorOps.create(0.4, 0.6, 0)})
    cube.offset = BGE.Math.VectorOps.create(130, 0, 0)
    cube.addToRenderer(renderer)

    ' tiled ground, tinted by the sun and ambient light, with a pool under the lamp
    tile = CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: false})
    tile.Clear(&hB0B0B0FF)
    tile.DrawRect(0, 0, 32, 32, &hE0E0E0FF)
    tile.DrawRect(32, 32, 32, 32, &hE0E0E0FF)
    ground = new BGE.DrawablePlane(m.owner, CreateObject("roRegion", tile, 0, 0, 64, 64), {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: -100, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage, isShaded: true})
    ground.addToRenderer(renderer)

    ' a flat panel behind them, so billboards show the lighting too
    panel = new BGE.DrawableRectangle(m.owner, 500, 200, {drawMode: BGE.SceneObjectDrawMode.solid, color: BGE.ColorsRGB.Silver, isShaded: true, rotation: BGE.Math.VectorOps.create(-0.3, 0, 0)})
    panel.offset = BGE.Math.VectorOps.create(-250, 100, -200)
    panel.addToRenderer(renderer)

    m.sun = new BGE.DirectionalLight(BGE.Math.VectorOps.create(-1, -1, -0.5), &h6080FF, 0.8)
    m.lamp = new BGE.PointLight(BGE.Math.VectorOps.create(0, 0, 200), 600, BGE.ColorsRGB.Red, 1.5)
    m.ambient = new BGE.AmbientLight(BGE.ColorsRGB.White, 0.15)
    m.applySetup()
  end sub

  private sub applySetup()
    m.rendererRef.clearLights()
    if m.setupIndex = 1 or m.setupIndex = 3
      m.rendererRef.addLight(m.sun)
    end if
    if m.setupIndex = 2 or m.setupIndex = 3
      m.rendererRef.addLight(m.lamp)
    end if
    if m.setupIndex = 3
      m.rendererRef.addLight(m.ambient)
    end if
  end sub

  ' A UV sphere, each face wound so its normal points outward.
  private function createSphereModel(radius as float, slices as integer, stacks as integer, color as integer) as BGE.Model3d
    points = []
    for stack = 0 to stacks
      phi = BGE.Math.PI * stack / stacks
      row = []
      for slice = 0 to slices
        theta = 2 * BGE.Math.PI * slice / slices
        row.push(BGE.Math.VectorOps.create(radius * sin(phi) * cos(theta), radius * cos(phi), radius * sin(phi) * sin(theta)))
      end for
      points.push(row)
    end for
    faces = [] as BGE.Model3dFace[]
    for stack = 0 to stacks - 1
      for slice = 0 to slices - 1
        a = points[stack][slice]
        b = points[stack][slice + 1]
        c = points[stack + 1][slice + 1]
        d = points[stack + 1][slice]
        if stack > 0
          faces.push(m.outwardFace(a, b, c, color))
        end if
        if stack < stacks - 1
          faces.push(m.outwardFace(a, c, d, color))
        end if
      end for
    end for
    return new BGE.Model3d(faces)
  end function

  private function createCubeModel(halfSize as float, color as integer) as BGE.Model3d
    s = halfSize
    corners = []
    for each c in [[-s, -s, -s], [s, -s, -s], [s, s, -s], [-s, s, -s], [-s, -s, s], [s, -s, s], [s, s, s], [-s, s, s]]
      corners.push(BGE.Math.VectorOps.create(c[0], c[1], c[2]))
    end for
    faces = [] as BGE.Model3dFace[]
    for each quad in [[0, 1, 2, 3], [4, 5, 6, 7], [0, 1, 5, 4], [3, 2, 6, 7], [0, 3, 7, 4], [1, 2, 6, 5]]
      faces.push(m.outwardFace(corners[quad[0]], corners[quad[1]], corners[quad[2]], color))
      faces.push(m.outwardFace(corners[quad[0]], corners[quad[2]], corners[quad[3]], color))
    end for
    return new BGE.Model3d(faces)
  end function

  ' Every shape here is centered on the origin, so outward means away from it.
  private function outwardFace(a as BGE.Math.Vector, b as BGE.Math.Vector, c as BGE.Math.Vector, color as integer) as BGE.Model3dFace
    face = BGE.Model3dFaceOps.create([a, b, c])
    center = BGE.Math.VectorOps.create((a.x + b.x + c.x) / 3, (a.y + b.y + c.y) / 3, (a.z + b.z + c.z) / 3)
    if BGE.Math.VectorOps.dotProduct(face.normal, center) < 0
      face = BGE.Model3dFaceOps.create([b, a, c])
    end if
    face.color = color
    return face
  end function

  override sub update(dt as float)
    m.orbit += dt * 1.2
    m.lamp.position = BGE.Math.VectorOps.create(cos(m.orbit) * 260, 60, sin(m.orbit) * 260)
  end sub

  override sub draw(renderer as BGE.Renderer)
    renderer.setupCameraForFrame()
    m.owner.updateTransformationMatrix()
    renderer.render()
    renderer.drawText(`Lights: ${m.setupNames[m.setupIndex]}`, 20, 80, BGE.Colors.White)
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "OK"
      m.setupIndex = (m.setupIndex + 1) mod 4
      m.applySetup()
    end if
  end sub

  override sub teardown(renderer as BGE.Renderer)
    for each sceneObj in renderer.getSceneObjectsCopy()
      renderer.removeSceneObject(sceneObj)
    end for
    renderer.clearLights()
    renderer.setCamera(m.previousCamera)
  end sub

end class
