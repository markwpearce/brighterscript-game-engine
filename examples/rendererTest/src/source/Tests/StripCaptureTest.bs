' Draws the same texture columns straight to the screen and into bitmaps, side by side
' (#459). Strips several texels wide cut from their middle texel lose the grid lines in a
' bitmap, but the screen shows them (it blends in the neighbouring texels); cut from their
' whole slab, as QuadColumnDrawer does, all three match.
' Top row: unrotated, bottom row: rotated a little. OK cycles the strip width in texels, Play
' toggles cutting each strip from its whole slab or its middle texel.
class StripCaptureTest extends RendererTest

  private texture as roBitmap
  private columns = [] as roRegion[]
  private alphaBitmap as roBitmap
  private opaqueBitmap as roBitmap
  private stripTexels = 1
  ' cut each strip as its whole slab of texels, not just the middle one
  private wholeSlab = false
  private size = 256

  sub new()
    super("Strip Capture (OK: strip texels, Play: whole slab)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.texture = CreateObject("roBitmap", {width: 128, height: 128, alphaEnable: false})
    m.texture.DrawRect(0, 0, 64, 64, &hD04040FF)
    m.texture.DrawRect(64, 0, 64, 64, &h4060D0FF)
    m.texture.DrawRect(0, 64, 64, 64, &h40B040FF)
    m.texture.DrawRect(64, 64, 64, 64, &hE0E0E0FF)
    for i = 0 to 128 step 16
      m.texture.DrawRect(i, 0, 1, 128, &h202020FF)
      m.texture.DrawRect(0, i, 128, 1, &h202020FF)
    end for
    m.texture.Finish()
    m.alphaBitmap = CreateObject("roBitmap", {width: m.size + 40, height: m.size + 40, alphaEnable: true})
    m.opaqueBitmap = CreateObject("roBitmap", {width: m.size + 40, height: m.size + 40, alphaEnable: false})
    m.cutColumns()
  end sub

  private sub cutColumns()
    m.columns = []
    for x = 0 to 127 step m.stripTexels
      if m.wholeSlab
        region = CreateObject("roRegion", m.texture, x, 0, m.stripTexels, 128)
      else
        ' the middle texel, as TriangleColumnCuts does
        region = CreateObject("roRegion", m.texture, x + (m.stripTexels - 1) \ 2, 0, 1, 128)
      end if
      m.columns.push(region)
    end for
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "OK"
      m.stripTexels = m.stripTexels * 2
      if m.stripTexels > 8
        m.stripTexels = 1
      end if
      m.cutColumns()
    else if buttonName = "play"
      m.wholeSlab = not m.wholeSlab
      m.cutColumns()
    end if
  end sub

  private sub drawStrips(target as object, x as float, y as float, angle as float)
    n = m.columns.count()
    stepPx = m.size / n
    rad = angle * 0.0174533
    for k = 0 to n - 1
      ' along the rotated x axis
      px = x + k * stepPx * cos(rad)
      py = y - k * stepPx * sin(rad)
      target.DrawTransformedObject(px, py, angle, (stepPx + 1) / m.columns[k].GetWidth(), m.size / 128, m.columns[k], -1)
    end for
  end sub

  override sub draw(renderer as BGE.Renderer)
    screen = m.screenRef
    labels = ["screen", "alpha bitmap", "opaque bitmap", "whole region"]
    for row = 0 to 1
      angle = row * 8
      y = 150 + row * (m.size + 50)
      m.drawStrips(screen, 40, y, angle)

      m.alphaBitmap.Clear(0)
      m.drawStrips(m.alphaBitmap, 20, 20, angle)
      screen.DrawObject(330 - 20, y - 20, m.alphaBitmap)

      m.opaqueBitmap.Clear(&h000000FF)
      m.drawStrips(m.opaqueBitmap, 20, 20, angle)
      screen.DrawObject(620 - 20, y - 20, m.opaqueBitmap)

      ' the reference: the whole texture, scaled
      screen.DrawTransformedObject(910, y, angle, m.size / 128, m.size / 128, m.texture)
    end for
    for i = 0 to labels.count() - 1
      renderer.drawText(labels[i], 40 + 290 * i, 110, BGE.Colors.White)
    end for
    renderer.drawText(`strip ${m.stripTexels} texel(s), ${m.columns.count()} strips, whole slab ${m.wholeSlab}`, 40, 680, BGE.Colors.White)
  end sub

end class
