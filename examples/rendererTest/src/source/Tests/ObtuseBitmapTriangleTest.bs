' Renderer.drawBitmapTriangle() with an obtuse triangle (the chapel gable in examples/terrain,
' issue #341). Left: dest wound the same way as the source. Right: wound the other way, so
' it's drawn from a mirrored copy. Middle: that mirrored draw's second step done directly.
' Each should fill its yellow outline - on a real Roku the middle and right ones don't yet
' (issue #354).
class ObtuseBitmapTriangleTest extends RendererTest

  textureRegion as object

  sub new()
    super("Drawing: Obtuse Bitmap Triangles")
  end sub

  override sub setup(renderer as BGE.Renderer)
    bitmap = CreateObject("roBitmap", {width: 128, height: 192, alphaEnable: true})
    bitmap.Clear(&hCC2222FF)
    for y = 0 to 191 step 32
      for x = 0 to 127 step 32
        if ((x + y) / 32) mod 2 = 0
          bitmap.DrawRect(x, y, 32, 32, &h2222CCFF)
        end if
      end for
    end for
    region = CreateObject("roRegion", bitmap, 0, 0, 128, 192)
    m.textureRegion = BGE.RendererHelpers.createRegionWithId(region, "obtuseChecker")
  end sub

  override sub draw(renderer as BGE.Renderer)
    src = m.points([[40.7, 192], [40.7, 75.6], [128, 2.9]])
    same = m.points([[300, 600], [300, 400], [480, 270]])
    mirrored = m.points([[980, 600], [980, 400], [800, 270]])
    renderer.drawBitmapTriangle(m.textureRegion, src, same)
    renderer.drawBitmapTriangle(m.textureRegion, src, mirrored)
    ' the mirrored case's second step: its source points mirrored, wound like its dest
    preMirroredSrc = m.points([[87.3, 190], [87.3, 73.6], [0, 0.9]])
    preMirrored = m.points([[700, 600], [700, 400], [520, 270]])
    renderer.drawBitmapTriangle(m.textureRegion, preMirroredSrc, preMirrored)
    renderer.drawTriangleOutline(same, BGE.Colors.Yellow)
    renderer.drawTriangleOutline(mirrored, BGE.Colors.Yellow)
    renderer.drawTriangleOutline(preMirrored, BGE.Colors.Yellow)
  end sub

  private function points(coords as object) as BGE.Math.Vector[]
    result = [] as BGE.Math.Vector[]
    for each xy in coords
      result.push(BGE.Math.VectorOps.create(xy[0], xy[1]))
    end for
    return result
  end function

end class
