' DrawablePlane texture scale (issue #389): a tiled checkerboard ground with a 128x128
' decal (red/green/blue/yellow quadrants, white border) on top, both at the same scale.
' OK cycles the scale: 1x, 4x, then (1.5, 2), where the decal covers 192x256 world units
' and the ground draws 1.5x as far. The camera asks for far more ground than the device
' cap, so the "ground" readout shows how far this scale lets it reach.
class PlaneTextureScaleTest extends RendererTest

  private ownerGameStub as object
  private owner as BGE.GameEntity
  private camera as BGE.Camera3d
  private previousCamera as BGE.Camera
  private ground as BGE.DrawablePlane
  private decal as BGE.DrawablePlane
  private scales = [[1, 1], [4, 4], [1.5, 2]]
  private scaleIndex as integer = 0
  private time as float = 0

  sub new()
    super("Plane Texture Scale (OK: next scale)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.ownerGameStub = new BenchmarkGameStub()
    m.owner = new BGE.GameEntity((m.ownerGameStub as dynamic), {name: "PlaneScaleOwner"})

    m.camera = new BGE.Camera3d()
    ' far more than any device cap, so the ground goes as far as its scale allows
    m.camera.maxDrawDistance = 100000
    ' main.bs shares one Renderer across every demo, so put its camera back in teardown().
    m.previousCamera = renderer.camera
    renderer.setCamera(m.camera)

    tile = CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: false})
    tile.Clear(&h336633FF)
    tile.DrawRect(0, 0, 32, 32, &h66AA66FF)
    tile.DrawRect(32, 32, 32, 32, &h66AA66FF)
    m.ground = new BGE.DrawablePlane(m.owner, CreateObject("roRegion", tile, 0, 0, 64, 64), {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
    m.ground.addToRenderer(renderer)

    map = CreateObject("roBitmap", {width: 128, height: 128, alphaEnable: true})
    map.Clear(&hFFFFFFFF)
    map.DrawRect(4, 4, 60, 60, &hCC3333FF)
    map.DrawRect(64, 4, 60, 60, &h33CC33FF)
    map.DrawRect(4, 64, 60, 60, &h3366FFFF)
    map.DrawRect(64, 64, 60, 60, &hEEDD33FF)
    m.decal = new BGE.DrawablePlane(m.owner, CreateObject("roRegion", map, 0, 0, 128, 128), {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.staticImage})
    m.decal.addToRenderer(renderer)

    m.applyScale()
  end sub

  private sub applyScale()
    pair = m.scales[m.scaleIndex]
    m.ground.scale = BGE.Math.VectorOps.create(pair[0], pair[1], 1)
    m.decal.scale = BGE.Math.VectorOps.create(pair[0], pair[1], 1)
  end sub

  override sub update(dt as float)
    m.time += dt
    yaw = 0.3 * sin(m.time * 0.2)
    ' the decal is centred on the origin, ahead of the camera
    m.camera.position = BGE.Math.VectorOps.create(0, 60, 300)
    m.camera.setTarget(BGE.Math.VectorOps.create(sin(yaw) * 100, 45, 300 - cos(yaw) * 100))
  end sub

  override sub draw(renderer as BGE.Renderer)
    renderer.setupCameraForFrame()
    m.owner.updateTransformationMatrix()
    renderer.render()
    pair = m.scales[m.scaleIndex]
    texelScale = pair[0]
    if pair[1] < texelScale
      texelScale = pair[1]
    end if
    renderer.drawText(`scale: ${pair[0]} x ${pair[1]}  ground: ${cint(m.camera.getPlaneDrawDistanceForTexelScale(texelScale))}  objects: ${cint(m.camera.getEffectiveMaxDrawDistance())}`, 20, 80, BGE.Colors.White)
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "OK"
      m.scaleIndex = (m.scaleIndex + 1) mod m.scales.count()
      m.applyScale()
    end if
  end sub

  override sub teardown(renderer as BGE.Renderer)
    for each sceneObj in renderer.getSceneObjectsCopy()
      renderer.removeSceneObject(sceneObj)
    end for
    renderer.setCamera(m.previousCamera)
  end sub

end class
