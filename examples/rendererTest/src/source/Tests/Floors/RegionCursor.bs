' One roRegion moved about its bitmap with Offset(): creating a region per draw is too slow
' for the hundreds of row spans and slices FloorsBenchmark draws a frame.
class RegionCursor

  region as roRegion
  ' where the region is now; kept in step by anything that moves it by hand
  x as integer = 0
  y as integer = 0
  w as integer = 1
  h as integer = 1
  maxW as integer = 1
  maxH as integer = 1

  sub new(bmp as roBitmap)
    m.maxW = bmp.GetWidth()
    m.maxH = bmp.GetHeight()
    m.region = CreateObject("roRegion", bmp, 0, 0, 1, 1)
  end sub

  ' Moves the region to x, y, w, h, clipped to the bitmap. False if nothing is left.
  function moveTo(x as integer, y as integer, w as integer, h as integer) as boolean
    if x < 0
      w += x
      x = 0
    end if
    if y < 0
      h += y
      y = 0
    end if
    if x + w > m.maxW
      w = m.maxW - x
    end if
    if y + h > m.maxH
      h = m.maxH - y
    end if
    if w < 1 or h < 1
      return false
    end if
    m.region.Offset(x - m.x, y - m.y, w - m.w, h - m.h)
    m.x = x
    m.y = y
    m.w = w
    m.h = h
    return true
  end function

end class
