' The two head-on faces of examples/3d's D20, drawn with
' drawBitmapTriangleTo straight to the screen (top row) and into a bitmap sized to
' the face's bounds, as SceneObjectModel does, then blitted (bottom row).
class D20FaceTest extends RendererTest

  atlas as object
  faceBitmaps as object

  sub new()
    super("Drawing: D20 Faces (#345)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    bitmap = CreateObject("roBitmap", {width: 640, height: 512, alphaEnable: true})
    bitmap.Clear(&hFF8000FF)
    bitmap.DrawRect(128, 128, 128, 128, &h008080FF)
    bitmap.DrawRect(0, 384, 128, 128, &h8B4513FF)
    m.atlas = BGE.RendererHelpers.createRegionWithId(CreateObject("roRegion", bitmap, 0, 0, 640, 512), "d20test")
    renderer.drawDebugCells = false
  end sub

  private function faces() as object
    return [
      {
        src: [BGE.Math.VectorOps.create(128, 256), BGE.Math.VectorOps.create(256, 256), BGE.Math.VectorOps.create(128, 128)],
        dest: [BGE.Math.VectorOps.create(91, 0), BGE.Math.VectorOps.create(0, 59), BGE.Math.VectorOps.create(91, 118)],
        w: 92, h: 119
      },
      {
        src: [BGE.Math.VectorOps.create(0, 512), BGE.Math.VectorOps.create(128, 512), BGE.Math.VectorOps.create(0, 384)],
        dest: [BGE.Math.VectorOps.create(0, 118), BGE.Math.VectorOps.create(90, 59), BGE.Math.VectorOps.create(0, 0)],
        w: 91, h: 119
      }
    ]
  end function

  override sub draw(renderer as BGE.Renderer)
    x = 300
    for each face in m.faces()
      onScreen = []
      for each p in face.dest
        onScreen.push(BGE.Math.VectorOps.create(p.x + x, p.y + 150))
      end for
      renderer.drawBitmapTriangle(m.atlas, face.src, onScreen)

      faceBitmap = CreateObject("roBitmap", {width: face.w, height: face.h, alphaEnable: true})
      faceBitmap.Clear(0)
      renderer.drawBitmapTriangleTo(faceBitmap, m.atlas, face.src, face.dest)
      faceBitmap.Finish()
      renderer.drawObject(x, 350, faceBitmap)
      renderer.drawRectangleOutline(x - 1, 349, face.w + 2, face.h + 2, &hFFFFFF80)
      x += 200
    end for
  end sub

end class
