' Concave DrawablePolygons (#547) as scene objects on the default Camera2d: a 300px star, an
' L, a gear, and a pentagram under nonzero (solid) and even-odd (hollow centre). OK starts and
' stops them turning, so the cost at rest and moving can be compared. Prints a `CONCAVESCENE`
' console line (mean render() ms) every 60 frames.
class ConcavePolygonSceneTest extends RendererTest

  private renderer as BGE.Renderer
  private drawables as BGE.DrawablePolygon[] = []
  private sceneObjects as BGE.SceneObject[] = []
  private turning = false
  private renderTimer as roTimespan = CreateObject("roTimespan")
  private renderMsTotal = 0
  private renderFrames = 0

  sub new()
    super("Concave Polygons (OK: turn)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.renderer = renderer
    if m.launchParams.turning = "1"
      m.turning = true
    end if
    m.add(m.star(5, 150, 0.45), 230, 380, BGE.ColorsRGB.Yellow, BGE.PolygonFillRule.nonZero)
    ell = [] as BGE.Math.Vector[]
    for each p in [[-1.0, -1.0], [-0.4, -1.0], [-0.4, 0.4], [1.0, 0.4], [1.0, 1.0], [-1.0, 1.0]]
      ell.push(BGE.Math.VectorOps.create(p[0] * 100, p[1] * 100))
    end for
    m.add(ell, 560, 380, BGE.ColorsRGB.Cyan, BGE.PolygonFillRule.nonZero)
    m.add(m.star(12, 110, 0.8), 860, 380, BGE.ColorsRGB.Green, BGE.PolygonFillRule.nonZero)
    pentagram = [] as BGE.Math.Vector[]
    for i = 0 to 4
      a = 2 * BGE.Math.PI * (i * 2) / 5 + BGE.Math.HALF_PI
      pentagram.push(BGE.Math.VectorOps.create(80 * cos(a), 80 * sin(a)))
    end for
    m.add(pentagram, 1120, 500, BGE.ColorsRGB.Magenta, BGE.PolygonFillRule.nonZero)
    m.add(pentagram, 1120, 220, BGE.ColorsRGB.Magenta, BGE.PolygonFillRule.evenOdd)
  end sub

  override sub update(dt as float)
    if not m.turning
      return
    end if
    for i = 0 to m.drawables.count() - 1
      m.drawables[i].rotation.z += dt * (0.3 + 0.1 * i)
    end for
  end sub

  override sub draw(renderer as BGE.Renderer)
    m.renderTimer.Mark()
    renderer.setupCameraForFrame()
    renderer.render()
    m.renderMsTotal += m.renderTimer.TotalMilliseconds()
    m.renderFrames++
    if m.renderFrames >= 60
      state = "rest"
      if m.turning
        state = "turning"
      end if
      print `CONCAVESCENE ${state} render ${Str(m.renderMsTotal / m.renderFrames).trim()} ms`
      m.renderMsTotal = 0
      m.renderFrames = 0
    end if
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "OK"
      m.turning = not m.turning
      m.renderMsTotal = 0
      m.renderFrames = 0
    end if
  end sub

  override sub teardown(renderer as BGE.Renderer)
    for each sceneObj in m.sceneObjects
      renderer.removeSceneObject(sceneObj)
    end for
    m.sceneObjects = []
    m.drawables = []
  end sub

  private sub add(points as BGE.Math.Vector[], x as float, y as float, color as integer, fillRule as BGE.PolygonFillRule)
    ' Camera2d's world is y-up from the bottom left
    drawable = new BGE.DrawablePolygon(invalid, points, {
      offset: BGE.Math.VectorOps.create(x, 720 - y),
      color: color,
      concave: true,
      fillRule: fillRule
    })
    m.drawables.push(drawable)
    sceneObj = drawable.addToRenderer(m.renderer)
    if invalid <> sceneObj
      m.sceneObjects.push(sceneObj)
    end if
  end sub

  ' A star's outline: `tips` points of radius r, notches at r * inner
  private function star(tips as integer, r as float, inner as float) as BGE.Math.Vector[]
    pts = [] as BGE.Math.Vector[]
    for i = 0 to tips * 2 - 1
      radius = r
      if i mod 2 = 1
        radius = r * inner
      end if
      a = BGE.Math.PI * i / tips + BGE.Math.HALF_PI
      pts.push(BGE.Math.VectorOps.create(radius * cos(a), radius * sin(a)))
    end for
    return pts
  end function

end class
