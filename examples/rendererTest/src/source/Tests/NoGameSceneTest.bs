' A small 3D scene built entirely from drawables with no owner - no Game, Scene or
' GameEntity anywhere (issue #231). Each drawable is registered straight into the
' Renderer with addToRenderer(), and this demo does the per-frame work a Game would
' otherwise do for it: drawable.update(), then setupCameraForFrame() + render().
class NoGameSceneTest extends RendererTest

  renderer as BGE.Renderer
  camera as BGE.Camera3d
  previousCamera as BGE.Camera
  drawables = []
  sceneObjects = []

  orbitAngle = 0.0
  orbitSpeed = 0.4 ' radians/sec
  orbitRadius = 900
  orbiting = true

  sub new()
    super("Scene Without a Game (OK: pause orbit)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.renderer = renderer
    ' main.bs shares one Renderer across every demo, so put its camera back in teardown().
    m.previousCamera = renderer.camera
    m.camera = new BGE.Camera3d()
    renderer.setCamera(m.camera)
    m.updateCamera()

    ' Three flat-filled panels in a ring, turned to face outwards.
    panelColors = [BGE.ColorsRGB.Red, BGE.ColorsRGB.Green, BGE.ColorsRGB.Blue]
    for i = 0 to panelColors.count() - 1
      angle = 2 * BGE.Math.PI * i / panelColors.count()
      m.add(new BGE.DrawableRectangle(invalid, 220, 220, {
        offset: BGE.Math.VectorOps.create(380 * sin(angle), 10, -380 * cos(angle)),
        rotation: BGE.Math.VectorOps.create(0, angle, 0),
        color: panelColors[i],
        outlineRGBA: BGE.ColorsRGB.White,
        drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace
      }))
    end for

    ' A pole with a sphere on top, and a particle fountain above that.
    m.add(new BGE.DrawableLine(invalid, BGE.Math.VectorOps.create(0, -100, 0), BGE.Math.VectorOps.create(0, 200, 0), {
      color: BGE.ColorsRGB.White
    }))
    m.add(new BGE.DrawableSphere(invalid, 50, {
      offset: BGE.Math.VectorOps.create(0, 240, 0),
      color: BGE.ColorsRGB.Yellow
    }))
    particles = new BGE.DrawableParticles(invalid, BGE.ParticleShape.Rectangle, {
      offset: BGE.Math.VectorOps.create(0, 290, 0),
      spawnRate: 30,
      lifetime: 1.2,
      velocity: BGE.Math.VectorOps.create(0, 160, 0),
      velocitySpreadAngleDegrees: 35,
      acceleration: BGE.Math.VectorOps.create(0, -150, 0),
      startColor: BGE.ColorsRGB.Yellow,
      endColor: BGE.ColorsRGB.Red,
      startAlpha: 255,
      endAlpha: 0,
      startSize: 8,
      endSize: 2,
      maxParticles: 60
    })
    particles.start()
    m.add(particles)

    ' Camera-facing billboards: a still image and a 4-frame animation.
    logoBmp = CreateObject("roBitmap", "pkg:/sprites/roku-logo-purple.png")
    logoRegion = CreateObject("roRegion", logoBmp, 0, 0, logoBmp.GetWidth(), logoBmp.GetHeight())
    m.add(new BGE.Image(invalid, logoRegion, {
      offset: BGE.Math.VectorOps.create(-260, 60, 260),
      scale: BGE.Math.createScaleVector(0.5),
      drawMode: BGE.SceneObjectDrawMode.directScaled
    }))
    m.add(new BGE.AnimatedImage(invalid, m.createAnimationFrames(), {
      offset: BGE.Math.VectorOps.create(260, 60, 260),
      animationDurationMs: 1000,
      drawMode: BGE.SceneObjectDrawMode.directScaled
    }))

    ' No font passed, and no Game to get one from, so this uses the system default font.
    m.add(new BGE.DrawableText(invalid, "No Game, no GameEntities", invalid, {
      offset: BGE.Math.VectorOps.create(0, 400, 0),
      alignment: BGE.UI.HorizAlignment.center,
      drawMode: BGE.SceneObjectDrawMode.directScaled
    }))
  end sub

  override sub update(dt as float)
    if m.orbiting
      m.orbitAngle += m.orbitSpeed * dt
      m.updateCamera()
    end if
    ' A Game would call this for every entity's drawables - it's what advances the
    ' animation and spawns/simulates the particles.
    for each drawable in m.drawables
      drawable.update()
    end for
  end sub

  override sub draw(renderer as BGE.Renderer)
    renderer.setupCameraForFrame()
    renderer.render()
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "OK"
      m.orbiting = not m.orbiting
    end if
  end sub

  override sub teardown(renderer as BGE.Renderer)
    for each sceneObj in m.sceneObjects
      renderer.removeSceneObject(sceneObj)
    end for
    m.sceneObjects = []
    m.drawables = []
    renderer.setCamera(m.previousCamera)
  end sub

  private sub add(drawable as BGE.Drawable)
    m.drawables.push(drawable)
    sceneObj = drawable.addToRenderer(m.renderer)
    if invalid <> sceneObj
      m.sceneObjects.push(sceneObj)
    end if
  end sub

  private sub updateCamera()
    m.camera.position = BGE.Math.VectorOps.create(m.orbitRadius * sin(m.orbitAngle), 250, m.orbitRadius * cos(m.orbitAngle))
    m.camera.setTarget(BGE.Math.VectorOps.create(0, 80, 0))
  end sub

  ' Four solid-colored 64x64 cells, cycled by the AnimatedImage.
  private function createAnimationFrames() as roRegion[]
    frameColors = [BGE.Colors.Red, BGE.Colors.Yellow, BGE.Colors.Green, BGE.Colors.Blue]
    sheet = CreateObject("roBitmap", {width: 64 * frameColors.count(), height: 64, alphaEnable: true})
    frames = []
    for i = 0 to frameColors.count() - 1
      sheet.DrawRect(i * 64 + 4, 4, 56, 56, frameColors[i])
      frames.push(CreateObject("roRegion", sheet, i * 64, 0, 64, 64))
    end for
    return frames
  end function

end class
