' Checks Renderer.drawPinnedCorners() with mirrored quads (issue #269). Each quad's corner
' labels are swapped on one axis to mirror it, at a rotation of 0 (top row) and 25 degrees
' (bottom row). The image's red corner is its own top left, so it should land on the yellow
' dot (the quad's topLeft label) with no diagonal seam. "Both" swaps both axes, which is just
' a half turn, not a mirror. Drawn once into a cached bitmap in setup().
class MirroredPinnedCornersTest extends RendererTest

  cachedBitmap as roBitmap
  labels = []

  sub new()
    super("Corner Pin: Mirrored Quads")
  end sub

  override sub setup(renderer as BGE.Renderer)
    marker = m.createMarker()
    region = CreateObject("roRegion", marker, 0, 0, marker.GetWidth(), marker.GetHeight()) as roRegion
    region.SetAlphaEnable(true)
    markerRegion = BGE.RendererHelpers.createRegionWithId(region, "mirrorMarker")

    canvasSize = renderer.getCanvasSize()
    m.cachedBitmap = CreateObject("roBitmap", {width: canvasSize.x, height: canvasSize.y, alphaEnable: true})
    cacheRenderer = new BGE.Renderer(m.cachedBitmap)

    flips = [
      {name: "none", x: false, y: false},
      {name: "mirror X", x: true, y: false},
      {name: "mirror Y", x: false, y: true},
      {name: "both (half turn)", x: true, y: true}
    ]
    rotations = [0, 25]
    columnWidth = canvasSize.x * 0.8 / flips.count()
    half = 65
    for row = 0 to rotations.count() - 1
      centerY = canvasSize.y * (0.33 + 0.36 * row)
      for col = 0 to flips.count() - 1
        centerX = canvasSize.x * 0.1 + columnWidth * (col + 0.5)
        quad = m.makeQuad(centerX, centerY, half, rotations[row], flips[col].x, flips[col].y)
        cacheRenderer.drawPinnedCorners(quad, markerRegion)
        m.cachedBitmap.DrawRect(quad.topLeft.x - 4, quad.topLeft.y - 4, 8, 8, BGE.Colors.Yellow)
        m.labels.push({text: flips[col].name + ", " + rotations[row].toStr() + " deg", x: centerX, y: centerY + half + 30})
      end for
    end for
    m.cachedBitmap.Finish()
  end sub

  override sub draw(renderer as BGE.Renderer)
    renderer.drawObject(0, 0, m.cachedBitmap)
    for each label in m.labels
      renderer.drawText(label.text, label.x, label.y, BGE.Colors.White, invalid, "center")
    end for
  end sub

  ' A square of half-size `half` around (cx, cy), rotated, its labels swapped to mirror it.
  private function makeQuad(cx as float, cy as float, half as float, degrees as float, flipX as boolean, flipY as boolean) as BGE.Math.CornerPoints
    theta = BGE.Math.DegreesToRadians(degrees)
    c = cos(theta)
    s = sin(theta)
    left = -half
    right = half
    top = -half
    bottom = half
    if flipX
      left = half
      right = -half
    end if
    if flipY
      top = half
      bottom = -half
    end if
    return BGE.Math.createCornerPoints(
      BGE.Math.VectorOps.create(cx + left * c - top * s, cy + left * s + top * c),
      BGE.Math.VectorOps.create(cx + right * c - top * s, cy + right * s + top * c),
      BGE.Math.VectorOps.create(cx + left * c - bottom * s, cy + left * s + bottom * c),
      BGE.Math.VectorOps.create(cx + right * c - bottom * s, cy + right * s + bottom * c)
    )
  end function

  ' The Roku logo (asymmetric text, so a mirror is obvious) with a red top left corner.
  private function createMarker() as roBitmap
    size = 160
    logo = CreateObject("roBitmap", "pkg:/sprites/roku-logo-purple.png")
    marker = CreateObject("roBitmap", {width: size, height: size, alphaEnable: true})
    marker.Clear(&h303030FF)
    marker.DrawScaledObject(0, 0, size / logo.GetWidth(), size / logo.GetHeight(), logo)
    marker.DrawRect(0, 0, 40, 40, BGE.Colors.Red)
    return marker
  end function

end class
