' Times Renderer.render()'s static-geometry BSP path (Renderer.markStatic(), issue #107)
' against the plain sorted path, for a box of wall quads with "ball" quads moving inside
' it - the same shape as examples/collisions3d, built from ownerless drawables (#231).
'
' Each phase gets its own identical off-screen renderer, since hasStaticGeometry is a
' one-way latch. Phases run one after the other, one frame per update(), so nothing
' blocks long enough to trip the Roku watchdog and only one extra scratch pool is alive.
class StaticGeometryBspBenchmark extends RendererTest

  private ballCount = 10
  private warmupFrames = 5
  private timedFrames = 60
  private boxHalfSize = 150.0
  private surfaceWidth = 1280
  private surfaceHeight = 720
  private thumbScale = 0.375
  private safeX = 140
  private lineHeight = 26
  private font as roFont

  private phaseNames as string[] = ["Static BSP", "Plain sorted"]
  private phaseIndex = 0
  private frameIndex = 0
  private phaseMs as integer[] = [0, 0]
  private phaseDrawCalls as integer[] = [0, 0]
  private phaseBitmaps as roBitmap[] = []

  private phaseRenderer as BGE.Renderer
  private balls as BGE.DrawableRectangle[] = []

  sub new()
    super("Static Geometry BSP Benchmark")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.font = CreateObject("roFontRegistry").GetDefaultFont(20, false, false)
    m.startPhase()
  end sub

  override sub update(dt as float)
    if m.phaseIndex >= m.phaseNames.count()
      return
    end if

    m.moveBalls(m.frameIndex)
    timer = CreateObject("roTimespan")
    m.phaseRenderer.setupCameraForFrame()
    m.phaseRenderer.resetDrawCallCounter()
    m.phaseRenderer.render()
    ms = timer.TotalMilliseconds()

    if m.frameIndex >= m.warmupFrames
      m.phaseMs[m.phaseIndex] += ms
      m.phaseDrawCalls[m.phaseIndex] += m.phaseRenderer.getDrawCallsLastFrame()
    end if
    m.frameIndex++

    if m.frameIndex >= m.warmupFrames + m.timedFrames
      print `[BSP benchmark] ${m.resultLine(m.phaseIndex)}`
      m.phaseIndex++
      m.frameIndex = 0
      ' Free this phase's scratch pool before the next one allocates its own.
      m.phaseRenderer = invalid
      m.balls = []
      RunGarbageCollector()
      if m.phaseIndex < m.phaseNames.count()
        m.startPhase()
      end if
    end if
  end sub

  private sub startPhase()
    bitmap = CreateObject("roBitmap", {width: m.surfaceWidth, height: m.surfaceHeight, alphaEnable: false})
    m.phaseBitmaps.push(bitmap)
    m.phaseRenderer = new BGE.Renderer(bitmap)
    camera = new BGE.Camera3d()
    camera.position = BGE.Math.VectorOps.create(0, 0, -450)
    camera.setTarget(BGE.Math.VectorOps.create(0, 0, 0))
    m.phaseRenderer.setCamera(camera)
    m.buildWalls(m.phaseIndex = 0)
    m.buildBalls()
  end sub

  ' Walls are rotated into place about their centres, mirroring collisions3d's Wall.bs.
  ' The near wall is wireframe so the camera can see in, but it's still a BSP plane.
  private sub buildWalls(markAsStatic as boolean)
    h = m.boxHalfSize
    halfPi = BGE.Math.HALF_PI
    walls = [
      {center: [0, 0, h], rotation: [0, 0, 0], color: BGE.ColorsRGB.Navy, wireFrame: false},
      {center: [h, 0, 0], rotation: [0, halfPi, 0], color: BGE.ColorsRGB.Maroon, wireFrame: false},
      {center: [-h, 0, 0], rotation: [0, halfPi, 0], color: BGE.ColorsRGB.Green, wireFrame: false},
      {center: [0, h, 0], rotation: [halfPi, 0, 0], color: BGE.ColorsRGB.Purple, wireFrame: false},
      {center: [0, -h, 0], rotation: [halfPi, 0, 0], color: BGE.ColorsRGB.Teal, wireFrame: false},
      {center: [0, 0, -h], rotation: [0, 0, 0], color: BGE.ColorsRGB.White, wireFrame: true}
    ]
    for each wall in walls
      drawMode = BGE.SceneObjectDrawMode.orientedDrawBackFace
      if wall.wireFrame
        drawMode = BGE.SceneObjectDrawMode.wireFrameDrawBackFace
      end if
      drawable = new BGE.DrawableRectangle(invalid, h * 2, h * 2, {
        offset: BGE.Math.VectorOps.create(wall.center[0], wall.center[1], wall.center[2]),
        rotation: BGE.Math.VectorOps.create(wall.rotation[0], wall.rotation[1], wall.rotation[2]),
        color: wall.color,
        outlineRGBA: BGE.ColorsRGB.White,
        drawMode: drawMode
      })
      drawable.setAnchor(0.5, 0.5)
      sceneObj = drawable.addToRenderer(m.phaseRenderer)
      if markAsStatic
        m.phaseRenderer.markStatic(sceneObj)
      end if
    end for
  end sub

  private sub buildBalls()
    m.balls = []
    for i = 0 to m.ballCount - 1
      drawable = new BGE.DrawableRectangle(invalid, 24, 24, {
        color: BGE.ColorsRGB.Yellow,
        ' Unrotated, the quad faces away from this camera, so plain oriented culls it.
        drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace
      })
      drawable.setAnchor(0.5, 0.5)
      drawable.addToRenderer(m.phaseRenderer)
      m.balls.push(drawable)
    end for
  end sub

  ' Driven by frame index rather than dt so both phases draw identical frames.
  private sub moveBalls(frame as integer)
    t = frame * 0.05
    for i = 0 to m.balls.count() - 1
      angle = (2 * BGE.Math.PI) * (i / m.ballCount) + t
      m.balls[i].offset = BGE.Math.VectorOps.create(cos(angle) * 100, sin(angle * 2) * 60, sin(angle) * 120)
    end for
  end sub

  private function resultLine(index as integer) as string
    frames = m.timedFrames
    return `${m.phaseNames[index]}: ${m.phaseMs[index]} ms / ${frames} frames, ${m.phaseDrawCalls[index] / frames} draw calls/frame`
  end function

  override sub draw(renderer as BGE.Renderer)
    ' y=80 clears main.bs's title header (see QuadFillBenchmark.bs).
    y = 80
    for i = 0 to m.phaseNames.count() - 1
      if i < m.phaseIndex
        line = m.resultLine(i)
      else if i = m.phaseIndex
        line = `${m.phaseNames[i]}: running (${m.frameIndex}/${m.warmupFrames + m.timedFrames})`
      else
        line = `${m.phaseNames[i]}: waiting`
      end if
      renderer.drawText(line, m.safeX, y, BGE.Colors.White, m.font)
      y += m.lineHeight
    end for

    ' Each phase's last frame, so a blank (0 draw call) render is obvious.
    thumbWidth = m.surfaceWidth * m.thumbScale
    x = m.safeX
    y += 16
    for i = 0 to m.phaseBitmaps.count() - 1
      renderer.drawScaledObject(x, y, m.thumbScale, m.thumbScale, m.phaseBitmaps[i])
      renderer.drawText(m.phaseNames[i], x, y + m.surfaceHeight * m.thumbScale + 8, BGE.Colors.White, m.font)
      x += thumbWidth + 40
    end for
  end sub

end class
