' Renderer.drawWorldBar() and BGE.Math.isWithinArc() (issues #420, #422). A yellow wedge sweeps
' round the centre; posts it reaches turn green, the rest stay grey. Every post has a bar over
' it at a different, changing fraction, which should stay on top of its post as the camera
' orbits. OK pauses the orbit.
class CombatHelpersTest extends RendererTest

  private camera as BGE.Camera3d
  private previousCamera as BGE.Camera
  private time as float = 0
  private orbitTime as float = 0
  private orbiting as boolean = true
  private posts as BGE.Math.Vector[] = []

  private reach as float = 220
  private halfAngle as float = 0.6
  private postRadius as float = 20
  private postHeight as float = 80

  sub new()
    super("drawWorldBar + isWithinArc (OK: pause orbit)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.camera = new BGE.Camera3d()
    m.camera.maxDrawDistance = 2000
    ' main.bs shares one Renderer across every demo, so put its camera back in teardown().
    m.previousCamera = renderer.camera
    renderer.setCamera(m.camera)

    m.posts = []
    for i = 0 to 9
      angle = 2 * BGE.Math.PI * i / 10
      distance = 120 + 40 * (i mod 4)
      m.posts.push(BGE.Math.VectorOps.create(distance * Sin(angle), 0, -distance * Cos(angle)))
    end for
  end sub

  override sub update(dt as float)
    m.time += dt
    if m.orbiting
      m.orbitTime += dt
    end if
    yaw = m.orbitTime * 0.3
    distance = 650
    m.camera.position = BGE.Math.VectorOps.create(Sin(yaw) * distance, 320, Cos(yaw) * distance)
    m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, 0))
  end sub

  override sub draw(renderer as BGE.Renderer)
    renderer.setupCameraForFrame()
    m.drawGrid(renderer)

    origin = BGE.Math.VectorOps.create(0, 0, 0)
    heading = BGE.Math.wrapAngle(m.time * 0.7)
    renderer.drawWorldArc(origin, m.reach, heading - m.halfAngle, heading + m.halfAngle, &hFFDD33FF, true)

    hits = 0
    for i = 0 to m.posts.Count() - 1
      post = m.posts[i]
      color = &h888888FF
      if BGE.Math.isWithinArc(origin, heading, post, m.reach, m.halfAngle, m.postRadius)
        color = &h33EE55FF
        hits++
      end if
      renderer.drawWorldCircle(post, m.postRadius, color, 12)
      top = BGE.Math.VectorOps.create(post.x, m.postHeight, post.z)
      renderer.drawWorldPolyline([post, top], color)
      fraction = 0.5 + 0.6 * Sin(m.time * 0.8 + i)
      renderer.drawWorldBar(BGE.Math.VectorOps.create(post.x, m.postHeight + 8, post.z), 48, 8, fraction, &hD03030FF, &h000000C0)
    end for
    renderer.drawText(`posts in arc: ${hits}   bars clamp below 0 and above 1`, 200, 600, BGE.Colors.White)
  end sub

  private sub drawGrid(renderer as BGE.Renderer)
    for i = -3 to 3
      offset = i * 100
      renderer.drawWorldPolyline([BGE.Math.VectorOps.create(offset, 0, -300), BGE.Math.VectorOps.create(offset, 0, 300)], &h334433FF)
      renderer.drawWorldPolyline([BGE.Math.VectorOps.create(-300, 0, offset), BGE.Math.VectorOps.create(300, 0, offset)], &h334433FF)
    end for
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "OK"
      m.orbiting = not m.orbiting
    end if
  end sub

  override sub teardown(renderer as BGE.Renderer)
    renderer.setCamera(m.previousCamera)
  end sub

end class
