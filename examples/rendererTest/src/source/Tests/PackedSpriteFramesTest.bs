' Packed sprite frames (issue #397) and shared regions (#401). Blue figures animate from a
' padded grid sheet, green ones from the same frames trimmed and packed with offsets: both
' should stand on their red feet line and move identically. OK times making 20 sprites from a
' 1024x1024 sheet of 64x64 cells, each slicing its own regions vs sharing one SpriteFrames.
class PackedSpriteFramesTest extends RendererTest

  private camera as BGE.Camera3d
  private previousCamera as BGE.Camera
  private sprites as BGE.Sprite[] = []
  private time as float = 0
  private frame as integer = 0
  private gridBytes as integer = 0
  private packedBytes as integer = 0
  private spawnReport as string = "OK: time 20 sprite spawns"

  ' Each figure is 32x64, standing at the bottom of a 96x128 cell and sliding right frame by frame
  private cellW as integer = 96
  private cellH as integer = 128
  private figureW as integer = 32
  private figureH as integer = 64
  private frameCount as integer = 8

  sub new()
    super("Packed Sprite Frames (OK: time spawns)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.camera = new BGE.Camera3d()
    m.camera.maxDrawDistance = 1000
    ' main.bs shares one Renderer across every demo, so put its camera back in teardown().
    m.previousCamera = renderer.camera
    renderer.setCamera(m.camera)

    gridSheet = CreateObject("roBitmap", {width: m.cellW * m.frameCount, height: m.cellH, alphaEnable: true})
    gridSheet.Clear(&h00000000)
    packedSheet = CreateObject("roBitmap", {width: m.figureW * m.frameCount, height: m.figureH, alphaEnable: true})
    packedSheet.Clear(&h00000000)
    rects = []
    for i = 0 to m.frameCount - 1
      offsetX = 8 + i * 6
      offsetY = m.cellH - m.figureH
      m.drawFigure(gridSheet, i * m.cellW + offsetX, offsetY, i, &h3366FFFF)
      m.drawFigure(packedSheet, i * m.figureW, 0, i, &h33CC33FF)
      rects.push({x: i * m.figureW, y: 0, width: m.figureW, height: m.figureH, offsetX: offsetX, offsetY: offsetY, sourceWidth: m.cellW, sourceHeight: m.cellH})
    end for
    m.gridBytes = gridSheet.GetWidth() * gridSheet.GetHeight() * 4
    m.packedBytes = packedSheet.GetWidth() * packedSheet.GetHeight() * 4

    gridFrames = new BGE.SpriteFrames(gridSheet, m.cellW, m.cellH)
    packedFrames = new BGE.SpriteFrames(packedSheet, 0, 0, rects)
    for i = 0 to 5
      frames = gridFrames
      if i mod 2 = 1
        frames = packedFrames
      end if
      sprite = new BGE.Sprite(invalid, frames, 0, 0, {drawMode: BGE.SceneObjectDrawMode.axisAligned})
      sprite.offset = BGE.Math.VectorOps.create((i - 2.5) * 70, 0, 0)
      sprite.setAnchor(0.5, 1)
      sprite.addToRenderer(renderer)
      m.sprites.push(sprite)
    end for
  end sub

  private sub drawFigure(bmp as roBitmap, x as integer, y as integer, frameIndex as integer, shirt as integer)
    bmp.DrawRect(x + 10, y, 12, 12, &hF2C79AFF)
    bmp.DrawRect(x + 4, y + 12, 24, 28, shirt)
    ' one arm swings up and down through the frames
    bmp.DrawRect(x, y + 12 + (frameIndex mod 4) * 6, 4, 14, &hF2C79AFF)
    bmp.DrawRect(x + 6, y + 40, 8, 20, &h333333FF)
    bmp.DrawRect(x + 18, y + 40, 8, 20, &h333333FF)
    bmp.DrawRect(x, y + 60, m.figureW, 4, &hFF0000FF)
  end sub

  override sub update(dt as float)
    m.time += dt
    m.frame = Int(m.time * 6) mod m.frameCount
    for each sprite in m.sprites
      sprite.index = m.frame
      sprite.update()
    end for
    yaw = m.time * 0.2
    m.camera.position = BGE.Math.VectorOps.create(Sin(yaw) * 320, 140, Cos(yaw) * 320)
    m.camera.setTarget(BGE.Math.VectorOps.create(0, 50, 0))
  end sub

  override sub draw(renderer as BGE.Renderer)
    renderer.setupCameraForFrame()
    renderer.render()
    renderer.drawText(`blue: grid sheet ${m.gridBytes / 1024}KB   green: packed ${m.packedBytes / 1024}KB   frame ${m.frame}`, 20, 80, BGE.Colors.White)
    renderer.drawText(m.spawnReport, 20, 125, BGE.Colors.White)
  end sub

  override sub onInput(buttonName as string)
    if buttonName <> "OK"
      return
    end if
    sheet = CreateObject("roBitmap", {width: 1024, height: 1024, alphaEnable: true})
    timer = CreateObject("roTimespan")
    made = []
    for i = 1 to 20
      unshared = new BGE.Sprite(invalid, sheet, 64, 64)
      made.push(unshared)
    end for
    unsharedMs = timer.TotalMilliseconds()
    timer.Mark()
    frames = new BGE.SpriteFrames(sheet, 64, 64)
    for i = 1 to 20
      shared = new BGE.Sprite(invalid, frames, 0, 0)
      made.push(shared)
    end for
    sharedMs = timer.TotalMilliseconds()
    m.spawnReport = `20 spawns of 256 cells: ${unsharedMs}ms slicing each, ${sharedMs}ms sharing`
    print "[packed-sprite-frames] "; m.spawnReport
  end sub

  override sub teardown(renderer as BGE.Renderer)
    for each sceneObj in renderer.getSceneObjectsCopy()
      renderer.removeSceneObject(sceneObj)
    end for
    renderer.setCamera(m.previousCamera)
    m.sprites = []
  end sub

end class
