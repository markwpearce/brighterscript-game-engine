' Upright billboards (issue #391): green figures are axisAligned, blue ones are directScaled,
' all anchored at their feet on a tiled ground. The camera orbits and swings between level
' and steeply down: the green figures should stand up and foreshorten, the blue ones lean
' back at the camera like cardboard cutouts. OK rolls the camera: the green figures bank with
' the ground they stand on, the blue ones stay upright on screen.
class AxisAlignedBillboardTest extends RendererTest

  private ownerGameStub as object
  private owner as BGE.GameEntity
  private camera as BGE.Camera3d
  private previousCamera as BGE.Camera
  private time as float = 0
  private pitchDegrees as float = 0
  private rolled as boolean = false

  sub new()
    super("axisAligned Billboards (OK: roll camera)")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.ownerGameStub = new BenchmarkGameStub()
    m.owner = new BGE.GameEntity((m.ownerGameStub as dynamic), {name: "AxisAlignedOwner"})

    m.camera = new BGE.Camera3d()
    m.camera.maxDrawDistance = 1000
    ' main.bs shares one Renderer across every demo, so put its camera back in teardown().
    m.previousCamera = renderer.camera
    renderer.setCamera(m.camera)

    tile = CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: false})
    tile.Clear(&h336633FF)
    tile.DrawRect(0, 0, 32, 32, &h449944FF)
    tile.DrawRect(32, 32, 32, 32, &h449944FF)
    tileRegion = CreateObject("roRegion", tile, 0, 0, 64, 64)
    plane = new BGE.DrawablePlane(m.owner, tileRegion, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
    plane.addToRenderer(renderer)

    greenFigure = m.createFigure(&h33CC33FF)
    blueFigure = m.createFigure(&h3366FFFF)
    for i = 0 to 7
      angle = (2 * BGE.Math.PI) * (i / 8)
      isAligned = (i mod 2) = 0
      figure = blueFigure
      drawMode = BGE.SceneObjectDrawMode.directScaled
      if isAligned
        figure = greenFigure
        drawMode = BGE.SceneObjectDrawMode.axisAligned
      end if
      region = CreateObject("roRegion", figure, 0, 0, figure.GetWidth(), figure.GetHeight())
      image = new BGE.Image(m.owner, region, {drawMode: drawMode})
      image.offset = BGE.Math.VectorOps.create(cos(angle) * 150, 0, sin(angle) * 150)
      image.setAnchor(0.5, 1)
      image.addToRenderer(renderer)
    end for
  end sub

  ' A 48x96 figure in `shirtRGBA`, with a red bar at its feet so you can see it stays planted
  private function createFigure(shirtRGBA as integer) as roBitmap
    bmp = CreateObject("roBitmap", {width: 48, height: 96, alphaEnable: true})
    bmp.Clear(&h00000000)
    bmp.DrawRect(16, 0, 16, 16, &hF2C79AFF)
    bmp.DrawRect(8, 16, 32, 40, shirtRGBA)
    bmp.DrawRect(12, 56, 10, 34, &h333333FF)
    bmp.DrawRect(26, 56, 10, 34, &h333333FF)
    bmp.DrawRect(0, 90, 48, 6, &hFF0000FF)
    return bmp
  end function

  override sub update(dt as float)
    m.time += dt
    m.pitchDegrees = 30 - 30 * cos(m.time * 0.5)
    yaw = m.time * 0.25
    pitch = BGE.Math.DegreesToRadians(m.pitchDegrees)
    distance = 400
    m.camera.position = BGE.Math.VectorOps.create(sin(yaw) * distance * cos(pitch), 10 + distance * sin(pitch), cos(yaw) * distance * cos(pitch))
    m.camera.setTarget(BGE.Math.VectorOps.create(0, 10, 0))
    m.camera.rollDegrees = 0
    if m.rolled
      m.camera.rollDegrees = 20
    end if
  end sub

  override sub draw(renderer as BGE.Renderer)
    renderer.setupCameraForFrame()
    m.owner.updateTransformationMatrix()
    renderer.render()
    renderer.drawText(`green: axisAligned  blue: directScaled  pitch: ${cint(m.pitchDegrees)}  roll: ${cint(m.camera.rollDegrees)}`, 20, 80, BGE.Colors.White)
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "OK"
      m.rolled = not m.rolled
    end if
  end sub

  override sub teardown(renderer as BGE.Renderer)
    for each sceneObj in renderer.getSceneObjectsCopy()
      renderer.removeSceneObject(sceneObj)
    end for
    renderer.setCamera(m.previousCamera)
  end sub

end class
