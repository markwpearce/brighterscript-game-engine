' Times Doom/Wolfenstein-style wall drawing for a grid maze (thirdPerson's crypt): one ray
' per screen strip, stepped through the grid (DDA), then one DrawScaledObject of a single
' texture column per strip, darkened with distance. Perspective-correct whatever the wall
' count, and its cost depends on the number of strips, not walls.
'
' Each phase draws the same 60 frames (the camera turns a fixed step per frame, standing in
' a junction of the crypt) at one strip width, timing the ray casting and the drawing apart.
' Results go to the console and the screen; OK reruns, then up/down sets the width drawn live
' so the on-screen frame rate shows the real cost (draws are queued, so timing them misses some).
class RaycastWallsBenchmark extends RendererTest

  private grid = [
    "#########"
    "#A.T#b..#"
    "###.#.#.#"
    "#k..T.#.#"
    "#.###.#.#"
    "#...#...#"
    "#.#.###T#"
    "#T#...S.#"
    "#E#######"
  ]
  private solid as boolean[][] = []
  private columns as object[] = []
  private textureHeight as integer = 128

  private stripWidths = [4, 8, 16, 32]
  private framesPerPhase = 60
  ' Once timed, the width drawn live (up/down to change), to read the real frame rate
  private liveWidth as integer = 4
  private phase as integer = 0
  private frame as integer = 0
  private castMs as float = 0
  private drawMs as float = 0
  private resultLines as string[] = []
  private timer as roTimespan
  private font as roFont

  ' Camera, in cells: the junction at column 5, row 5, eye 1.8 of 4 m wall height
  private camX as float = 5.5
  private camY as float = 5.5
  private eyeFraction as float = 1.8 / 4
  ' Cells are 6 m and walls 4 m, so a wall is 4/6 of a cell tall
  private wallHeightCells as float = 4 / 6
  private fovRadians as float = BGE.Math.PI / 2
  ' Beyond this (cells) walls fade fully to black, like the crypt's draw distance
  private fadeCells as float = 4

  sub new()
    super("Raycast Walls Benchmark")
  end sub

  override sub setup(renderer as BGE.Renderer)
    m.timer = CreateObject("roTimespan")
    m.font = CreateObject("roFontRegistry").GetDefaultFont(20, false, false)
    m.solid = []
    for each row in m.grid
      cells = [] as boolean[]
      for col = 0 to Len(row) - 1
        cells.push(Mid(row, col + 1, 1) = "#")
      end for
      m.solid.push(cells)
    end for
    texture = CreateObject("roBitmap", "pkg:/sprites/crypt_wall.png")
    m.textureHeight = texture.GetHeight()
    m.columns = []
    for x = 0 to texture.GetWidth() - 1
      m.columns.push(CreateObject("roRegion", texture, x, 0, 1, m.textureHeight))
    end for
    m.restart()
  end sub

  override sub onInput(buttonName as string)
    if buttonName = "OK"
      m.restart()
    else if buttonName = "up" and m.liveWidth < 64
      m.liveWidth *= 2
    else if buttonName = "down" and m.liveWidth > 1
      m.liveWidth /= 2
    end if
  end sub

  private sub restart()
    m.phase = 0
    m.frame = 0
    m.castMs = 0
    m.drawMs = 0
    m.resultLines = ["running..."]
    print "=== Raycast Walls Benchmark ==="
  end sub

  override sub draw(renderer as BGE.Renderer)
    screen = m.screenRef
    width = 1280
    height = 720
    horizon = height / 2
    screen.DrawRect(0, 0, width, horizon, &h000000FF)
    screen.DrawRect(0, horizon, width, height - horizon, &h1A1816FF)

    stripWidth = m.stripWidths[m.phase mod m.stripWidths.Count()]
    if m.phase >= m.stripWidths.Count()
      stripWidth = m.liveWidth
    end if
    angle = m.frame * 0.105
    focal = (width / 2) / Tan(m.fovRadians / 2)
    dirX = Cos(angle)
    dirY = Sin(angle)
    planeX = -dirY
    planeY = dirX

    m.timer.Mark()
    hits = []
    for x = 0 to width - 1 step stripWidth
      across = (x + stripWidth / 2) / (width / 2) - 1
      hits.push(m.cast(dirX + planeX * across, dirY + planeY * across))
    end for
    castTime = m.timer.TotalMilliseconds()

    m.timer.Mark()
    x = 0
    for each hit in hits
      if hit.distance > 0 and hit.distance < m.fadeCells
        wallPixels = m.wallHeightCells * focal / hit.distance
        top = horizon - wallPixels * (1 - m.eyeFraction)
        light = Int(255 * (1 - hit.distance / m.fadeCells))
        column = m.columns[Int(hit.u * m.columns.Count()) mod m.columns.Count()]
        screen.DrawScaledObject(x, Int(top), stripWidth, wallPixels / m.textureHeight, column, (light << 24) + (light << 16) + (light << 8) + 255)
      end if
      x += stripWidth
    end for
    drawTime = m.timer.TotalMilliseconds()

    if m.phase < m.stripWidths.Count()
      m.castMs += castTime
      m.drawMs += drawTime
      m.frame++
      if m.frame >= m.framesPerPhase
        line = `${stripWidth}px strips (${hits.Count()} rays): cast ${m.castMs / m.framesPerPhase} ms, draw ${m.drawMs / m.framesPerPhase} ms per frame`
        print line
        if m.phase = 0
          m.resultLines = []
        end if
        m.resultLines.push(line)
        m.phase++
        m.frame = 0
        m.castMs = 0
        m.drawMs = 0
      end if
    else
      m.frame++
    end if

    y = 80
    lines = []
    lines.append(m.resultLines)
    if m.phase >= m.stripWidths.Count()
      lines.push(`live: ${stripWidth}px strips (up/down to change)`)
    end if
    for each line in lines
      screen.DrawRect(120, y - 2, 900, 30, &h000000C0)
      screen.DrawText(line, 130, y, &hFFFFFFFF, m.font)
      y += 32
    end for
  end sub

  ' Steps a ray through the grid from the camera (DDA). Returns the perpendicular distance to
  ' the first solid cell (cells) and where along that wall it hit (u, 0-1).
  private function cast(rayX as float, rayY as float) as object
    mapX = Int(m.camX)
    mapY = Int(m.camY)
    deltaX = 1e30
    if rayX <> 0
      deltaX = Abs(1 / rayX)
    end if
    deltaY = 1e30
    if rayY <> 0
      deltaY = Abs(1 / rayY)
    end if
    if rayX < 0
      stepX = -1
      sideX = (m.camX - mapX) * deltaX
    else
      stepX = 1
      sideX = (mapX + 1 - m.camX) * deltaX
    end if
    if rayY < 0
      stepY = -1
      sideY = (m.camY - mapY) * deltaY
    else
      stepY = 1
      sideY = (mapY + 1 - m.camY) * deltaY
    end if
    hitVertical = false
    for i = 0 to 20
      if sideX < sideY
        sideX += deltaX
        mapX += stepX
        hitVertical = true
      else
        sideY += deltaY
        mapY += stepY
        hitVertical = false
      end if
      if mapY < 0 or mapX < 0 or mapY >= m.solid.Count() or mapX >= m.solid[0].Count() or m.solid[mapY][mapX]
        exit for
      end if
    end for
    if hitVertical
      distance = sideX - deltaX
      u = m.camY + distance * rayY
    else
      distance = sideY - deltaY
      u = m.camX + distance * rayX
    end if
    return {distance: distance, u: u - Int(u)}
  end function

end class
