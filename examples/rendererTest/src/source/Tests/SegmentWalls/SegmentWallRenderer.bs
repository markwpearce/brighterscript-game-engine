' Spike for #468: walls as 2D floor segments, each with its own foot and top height, drawn
' DOOM-style. No ray is cast against the level: each frame the segments in view are walked
' nearest first, each is projected onto the fan of strips it spans, and every strip keeps an
' open window of elevation slopes ((height - eye) / forward depth) that nearer walls narrow.
' A strip whose window closes costs nothing more, so cost follows screen coverage, and a short
' wall leaves the window open above it for taller walls behind.
'
' All wall points on one strip's bearing lie in one vertical plane through the eye, which
' projects to one screen line, so the window is exact along that line at any pitch.
'
' Pieces are recorded front to back and drawn back to front: a piece partly behind a nearer
' wall is drawn whole and the nearer one paints over it; only wholly hidden pieces are skipped.
'
' Spike limits: segments are ordered by their nearest point (a 2D BSP would make this exact),
' no sprite hiding, lighting is cached per segment bucket and never invalidated.

interface WallSegment
  ax as float
  az as float
  bx as float
  bz as float
  bottom as float
  top as float
  texture as string
  ' World units one texture copy covers across, or 0 to stretch over the segment
  tileWidth as float
  ' Texture copies stacked up the wall (tileHeight rounded so a whole number fits)
  tileCount as integer
  ' The side a one-sided segment is seen from (unit)
  normalX as float
  normalZ as float
  twoSided as boolean
  length as float
end interface

function createWallSegment(ax as float, az as float, bx as float, bz as float, bottom as float, top as float, texture as string, tileWidth as float, tileHeight as float, twoSided as boolean) as WallSegment
  dx = bx - ax
  dz = bz - az
  length = sqr(dx * dx + dz * dz)
  tileCount = 1
  if tileHeight > 0
    tileCount = cint((top - bottom) / tileHeight)
    if tileCount < 1
      tileCount = 1
    end if
  end if
  ' facing the left of a -> b seen from above (+y): (dz, -dx) with -z forward
  return {
    ax: ax, az: az, bx: bx, bz: bz,
    bottom: bottom, top: top,
    texture: texture,
    tileWidth: tileWidth,
    tileCount: tileCount,
    normalX: dz / length,
    normalZ: -dx / length,
    twoSided: twoSided,
    length: length
  }
end function

class SegmentWallRenderer

  segments = [] as WallSegment[]
  ' Lowest foot of any segment: the area below a wall standing on it can't show anything further
  floorY as float = 0.0

  ' Stats of the last render()
  rayCount as integer = 0
  segmentsInView as integer = 0
  segmentsVisited as integer = 0
  pieces as integer = 0
  draws as integer = 0
  raysClosed as integer = 0
  castMs as integer = 0
  drawMs as integer = 0

  private textures as roAssociativeArray
  private columnsByTexture = {} as roAssociativeArray
  private segColumns = [] as dynamic[]
  ' Per segment and side, lit colour per bucket along it (invalid until lit)
  private lightCache = {} as roAssociativeArray
  private lightBucketLength as float = 64.0
  private timer as roTimespan
  private eyeY as float = 0.0

  ' Per ray, grown
  private rayLo = [] as float[]
  private rayHi = [] as float[]

  ' Per segment this frame
  private segFirst = [] as integer[]
  private segLast = [] as integer[]
  private segAf = [] as float[]
  private segAs = [] as float[]
  private segBf = [] as float[]
  private segBs = [] as float[]
  private order = [] as integer[]

  ' Per piece this frame, recorded front to back
  private pSeg = [] as integer[]
  private pS = [] as float[]
  private pFwd = [] as float[]
  ' the strip's foot on screen and its length foot to top
  private pFx = [] as float[]
  private pFy = [] as float[]
  private pLen = [] as float[]
  private pWidth = [] as float[]
  private pAngle = [] as float[]
  private pRgba = [] as integer[]

  ' Projection, read in render()
  private focal as float = 1.0
  private hw as float = 0.0
  private hh as float = 0.0
  private limit as float = -1.0
  private clipFootX as float = 0.0
  private clipFootY as float = 0.0
  private clipTopX as float = 0.0
  private clipTopY as float = 0.0

  sub new(segments as WallSegment[], textures as roAssociativeArray)
    m.segments = segments
    m.textures = textures
    m.timer = CreateObject("roTimespan")
    lowest = 1.0e30
    for each seg in segments
      if seg.bottom < lowest
        lowest = seg.bottom
      end if
    end for
    m.floorY = lowest
  end sub

  sub render(renderer as BGE.Renderer, camera as BGE.Camera3d, stripWidth as integer)
    m.timer.Mark()
    m.pieces = 0
    m.draws = 0
    m.segmentsVisited = 0
    m.segmentsInView = 0
    m.raysClosed = 0
    if m.castAndRecord(renderer, camera, stripWidth)
      m.castMs = m.timer.TotalMilliseconds()
      m.timer.Mark()
      m.drawPieces(renderer)
      m.drawMs = m.timer.TotalMilliseconds()
    else
      m.castMs = m.timer.TotalMilliseconds()
      m.drawMs = 0
    end if
  end sub

  private function castAndRecord(renderer as BGE.Renderer, camera as BGE.Camera3d, stripWidth as integer) as boolean
    orient = camera.orientation
    cosPitch = sqr(orient.x * orient.x + orient.z * orient.z)
    if cosPitch < 0.02
      m.rayCount = 0
      return false
    end if
    if invalid = camera.worldToCamera
      camera.computeWorldToCameraMatrix()
    end if
    mat = camera.worldToCamera
    m0 = mat[0]
    m1 = mat[1]
    m2 = mat[2]
    m3 = mat[3]
    eye = camera.position
    ox = eye.x
    oy = eye.y
    oz = eye.z
    m.eyeY = oy
    lfx = orient.x / cosPitch
    lfz = orient.z / cosPitch
    right = camera.getLevelRightVector()
    rx = right.x
    rz = right.z
    up = camera.getLevelUpVector()
    focal = camera.getFocalLength()
    hw = camera.frameSize.x * 0.5
    hh = camera.frameSize.y * 0.5
    m.focal = focal
    m.hw = hw
    m.hh = hh
    near = 1.0
    m.limit = -near * 0.01

    ' the fan, as GridWallsView.update()
    minTan = 1.0e30
    maxTan = -1.0e30
    for each sx in [-1, 1]
      for each sy in [-1, 1]
        cx = orient.x * focal + rx * hw * sx + up.x * hh * sy
        cz = orient.z * focal + rz * hw * sx + up.z * hh * sy
        fwd = cx * lfx + cz * lfz
        if fwd < focal * 0.01
          fwd = focal * 0.01
        end if
        t = (cx * rx + cz * rz) / fwd
        if t < minTan
          minTan = t
        end if
        if t > maxTan
          maxTan = t
        end if
      end for
    end for
    tanStep = stripWidth * cosPitch / focal
    firstTan = minTan - tanStep
    rayCount = int((maxTan + tanStep - firstTan) / tanStep) + 1
    maxRays = int(4 * camera.frameSize.x / stripWidth + 0.999)
    if rayCount > maxRays
      tanStep = (maxTan - minTan) / (maxRays - 3)
      firstTan = minTan - tanStep
      rayCount = maxRays
    end if
    m.rayCount = rayCount

    ' each ray's window: nothing yet below, the screen's top edge above
    lo = m.rayLo
    hi = m.rayHi
    for i = lo.count() to rayCount - 1
      lo.push(0.0)
      hi.push(0.0)
    end for
    c1y = m1[1]
    c1z = m1[2]
    for i = 0 to rayCount - 1
      t = firstTan + i * tanStep
      dx = lfx + rx * t
      dz = lfz + rz * t
      c0y = dx * m0[1] + dz * m2[1]
      c0z = dx * m0[2] + dz * m2[2]
      lo[i] = -1.0e30
      den = focal * c1y + hh * c1z
      hi[i] = 1.0e30
      if abs(den) > 1.0e-9
        e = (-hh * c0z - focal * c0y) / den
        if c0z + e * c1z < 0
          hi[i] = e + 0.001
        end if
      end if
    end for

    ' segments in view, keyed nearest first
    drawDistance = camera.getCurrentDrawDistance()
    segs = m.segments
    segCount = segs.count()
    m.growSegments(segCount)
    order = m.order
    order.Clear()
    mul = 2
    while mul <= segCount
      mul = mul * 2
    end while
    maxKey = int(2147483647 / mul) - 1
    scale = maxKey / (drawDistance * 2 + 1)
    segFirst = m.segFirst
    segLast = m.segLast
    for n = 0 to segCount - 1
      seg = segs[n]
      dax = seg.ax - ox
      daz = seg.az - oz
      dbx = seg.bx - ox
      dbz = seg.bz - oz
      if not seg.twoSided and dax * seg.normalX + daz * seg.normalZ > 0
        continue for
      end if
      af = dax * lfx + daz * lfz
      aS = dax * rx + daz * rz
      bf = dbx * lfx + dbz * lfz
      bS = dbx * rx + dbz * rz
      if af < near and bf < near
        continue for
      end if
      if af >= drawDistance and bf >= drawDistance
        continue for
      end if
      m.segAf[n] = af
      m.segAs[n] = aS
      m.segBf[n] = bf
      m.segBs[n] = bS
      ' clip to the near distance for the tangent range
      caf = af
      cas = aS
      cbf = bf
      cbs = bS
      if af < near
        u = (near - af) / (bf - af)
        caf = near
        cas = aS + (bS - aS) * u
      else if bf < near
        u = (near - af) / (bf - af)
        cbf = near
        cbs = aS + (bS - aS) * u
      end if
      ta = cas / caf
      tb = cbs / cbf
      if ta > tb
        tmp = ta
        ta = tb
        tb = tmp
      end if
      first = int((ta - firstTan) / tanStep)
      last = int((tb - firstTan) / tanStep)
      if last < 0 or first >= rayCount
        continue for
      end if
      if first < 0
        first = 0
      end if
      if last > rayCount - 1
        last = rayCount - 1
      end if
      segFirst[n] = first
      segLast[n] = last

      ' nearest point on the segment, in plan
      ex = dbx - dax
      ez = dbz - daz
      lenSq = ex * ex + ez * ez
      u = 0.0
      if lenSq > 0
        u = -(dax * ex + daz * ez) / lenSq
        if u < 0
          u = 0.0
        else if u > 1
          u = 1.0
        end if
      end if
      px = dax + ex * u
      pz = daz + ez * u
      q = int(sqr(px * px + pz * pz) * scale)
      if q > maxKey
        q = maxKey
      end if
      order.push(q * mul + n)
    end for
    m.segmentsInView = order.count()
    if order.count() > 1
      order.Sort()
    end if

    ' walk them nearest first, recording visible pieces and narrowing windows
    m.pieces = 0
    openRays = rayCount
    mask = mul - 1
    a00 = m0[0]
    a01 = m0[1]
    a02 = m0[2]
    a20 = m2[0]
    a21 = m2[1]
    a22 = m2[2]
    a10 = m1[0]
    a11 = m1[1]
    a12 = m1[2]
    t30 = m3[0]
    t31 = m3[1]
    t32 = m3[2]
    limit = m.limit
    hasLights = renderer.hasLights()
    m.growPieces(rayCount * 2)
    cap = m.pSeg.count()
    pc = 0
    pSeg = m.pSeg
    pS = m.pS
    pFwd = m.pFwd
    pFx = m.pFx
    pFy = m.pFy
    pLen = m.pLen
    pWidth = m.pWidth
    pAngle = m.pAngle
    pRgba = m.pRgba
    floorY = m.floorY
    canvasWidth = hw * 2
    canvasHeight = hh * 2
    segAfs = m.segAf
    segAss = m.segAs
    segBfs = m.segBf
    segBss = m.segBs
    visited = 0
    for each key in order
      if openRays <= 0
        exit for
      end if
      n = key and mask
      seg = segs[n]
      visited++
      af = segAfs[n]
      aS = segAss[n]
      dF = segBfs[n] - af
      dS = segBss[n] - aS
      bottom = seg.bottom
      top = seg.top
      standsOnFloor = bottom <= floorY
      ax = seg.ax
      az = seg.az
      ex = seg.bx - ax
      ez = seg.bz - az
      first = segFirst[n]
      last = segLast[n]
      rgbaBase = m.segmentShades(renderer, seg, n, ox, oz, hasLights)
      lastBucket = rgbaBase.count() - 1

      ' rays last..first, carrying the ray after's projection for the strip width
      nOk = false
      nfx = 0.0
      nfy = 0.0
      ntx = 0.0
      nty = 0.0
      startRay = last + 1
      for i = startRay to first step -1
        t = firstTan + i * tanStep
        den = dS - t * dF
        s = 0.0
        if abs(den) > 1.0e-9
          s = (t * af - aS) / den
        end if
        if s < 0
          s = 0.0
        else if s > 1
          s = 1.0
        end if
        fwd = af + s * dF
        hx = ax + ex * s
        hz = az + ez * s
        bcx = hx * a00 + hz * a20 + t30
        bcy = hx * a01 + hz * a21 + t31
        bcz = hx * a02 + hz * a22 + t32
        cxF = bcx + bottom * a10
        cyF = bcy + bottom * a11
        czF = bcz + bottom * a12
        cxT = bcx + top * a10
        cyT = bcy + top * a11
        czT = bcz + top * a12
        ok = false
        fx = 0.0
        fy = 0.0
        tx = 0.0
        ty = 0.0
        if czF <= limit and czT <= limit
          fx = hw + focal * cxF / -czF
          fy = hh - focal * cyF / -czF
          tx = hw + focal * cxT / -czT
          ty = hh - focal * cyT / -czT
          ok = true
        else if m.clipSegment(cxF, cyF, czF, cxT, cyT, czT)
          fx = m.clipFootX
          fy = m.clipFootY
          tx = m.clipTopX
          ty = m.clipTopY
          ok = true
        end if
        jOk = nOk
        jfx = nfx
        jfy = nfy
        jtx = ntx
        jty = nty
        nOk = ok
        nfx = fx
        nfy = fy
        ntx = tx
        nty = ty
        if i = startRay or not ok or fwd < near or fwd >= drawDistance
          continue for
        end if
        rLo = lo[i]
        rHi = hi[i]
        if rLo >= rHi
          continue for
        end if
        eB = (bottom - oy) / fwd
        eT = (top - oy) / fwd
        if eT <= rLo or eB >= rHi
          continue for
        end if

        ddx = tx - fx
        ddy = ty - fy
        length = sqr(ddx * ddx + ddy * ddy)
        if length >= 0.5
          sinA = -ddx / length
          cosA = -ddy / length
          width = stripWidth + 0.0
          if jOk
            reach = (jfx - fx) * cosA - (jfy - fy) * sinA
            topReach = (jtx - tx) * cosA - (jty - ty) * sinA
            if topReach > reach
              reach = topReach
            end if
            width = reach + 1
            if width < 1
              width = 1.0
            end if
          end if
          ' skip a strip wholly off the canvas (the fan reaches past it when pitched)
          wx = width * cosA
          wy = -width * sinA
          minX = fx
          maxX = fx
          if tx < minX
            minX = tx
          else if tx > maxX
            maxX = tx
          end if
          if wx < 0
            minX += wx
          else
            maxX += wx
          end if
          minY = fy
          maxY = fy
          if ty < minY
            minY = ty
          else if ty > maxY
            maxY = ty
          end if
          if wy < 0
            minY += wy
          else
            maxY += wy
          end if
          if maxX >= 0 and maxY >= 0 and minX <= canvasWidth and minY <= canvasHeight
            if cosA > 0
              angle = Atn(sinA / cosA)
            else
              angle = BGE.Math.Atan2(sinA, cosA)
            end if
            if pc >= cap
              m.growPieces(pc + rayCount)
              cap = pSeg.count()
            end if
            pSeg[pc] = n
            pS[pc] = s
            pFwd[pc] = fwd
            pFx[pc] = fx
            pFy[pc] = fy
            pLen[pc] = length
            pWidth[pc] = width
            pAngle[pc] = angle
            pRgba[pc] = rgbaBase[int(s * lastBucket + 0.5)]
            pc++
          end if
        end if

        ' narrow the window: a wall covering an end of it closes that end up to its far edge
        if eB <= rLo or standsOnFloor
          if eT > rLo
            rLo = eT
          end if
        end if
        if eT >= rHi
          if eB < rHi
            rHi = eB
          end if
        end if
        lo[i] = rLo
        hi[i] = rHi
        if rLo >= rHi
          openRays--
        end if
      end for
    end for
    m.pieces = pc
    m.segmentsVisited = visited
    m.raysClosed = rayCount - openRays
    m.applyFade(drawDistance, camera.drawDistanceFadeFraction)
    return true
  end function

  ' Fades pieces near the draw distance (as Camera3d.getDistanceFadeAlpha()).
  private sub applyFade(far as float, fraction as float)
    if fraction <= 0
      return
    end if
    if fraction > 1
      fraction = 1.0
    end if
    bandStart = far * (1 - fraction)
    fwds = m.pFwd
    rgbas = m.pRgba
    for k = 0 to m.pieces - 1
      fwd = fwds[k]
      if fwd > bandStart
        fade = (far - fwd) / (far - bandStart)
        shade = rgbas[k]
        rgbas[k] = (shade and &hFFFFFF00) or int((shade and &hFF) * fade + 0.5)
      end if
    end for
  end sub

  private sub drawPieces(renderer as BGE.Renderer)
    segs = m.segments
    draws = 0
    segColumns = m.segColumns
    for i = segColumns.count() to segs.count() - 1
      segColumns.push(m.getColumns(segs[i].texture, segs[i].tileCount))
    end for
    pSeg = m.pSeg
    pS = m.pS
    pFx = m.pFx
    pFy = m.pFy
    pLen = m.pLen
    pWidth = m.pWidth
    pAngle = m.pAngle
    pRgba = m.pRgba
    for k = m.pieces - 1 to 0 step -1
      n = pSeg[k]
      columns = segColumns[n]
      if invalid = columns
        continue for
      end if
      seg = segs[n]
      columnCount = columns.count()
      s = pS[k]
      u = s
      if seg.tileWidth > 0
        along = s * seg.length / seg.tileWidth
        u = along - int(along)
      end if
      ci = int(u * columnCount)
      if ci >= columnCount
        ci = columnCount - 1
      end if
      column = columns[ci]
      renderer.drawTransformedObject(pFx[k], pFy[k], pWidth[k], pLen[k] / column.GetHeight(), pAngle[k], column, pRgba[k])
      draws++
    end for
    m.draws = draws
  end sub

  ' Lit colours along a segment for the side the eye is on, cached per bucket.
  private function segmentShades(renderer as BGE.Renderer, seg as WallSegment, n as integer, ox as float, oz as float, hasLights as boolean) as integer[]
    nx = seg.normalX
    nz = seg.normalZ
    side = 0
    if (ox - seg.ax) * nx + (oz - seg.az) * nz < 0
      side = 1
      nx = -nx
      nz = -nz
    end if
    key = (n * 2 + side).toStr()
    shades = m.lightCache[key]
    if invalid <> shades
      return shades
    end if
    buckets = int(seg.length / m.lightBucketLength) + 1
    shades = [] as integer[]
    normal = BGE.Math.VectorOps.create(nx, 0, nz)
    for b = 0 to buckets
      f = b / buckets
      point = BGE.Math.VectorOps.create(seg.ax + (seg.bx - seg.ax) * f, (seg.bottom + seg.top) * 0.5, seg.az + (seg.bz - seg.az) * f)
      if hasLights
        shades.push(BGE.Lighting.shadeColor(&hFFFFFFFF, renderer.getPreparedLights(), point, normal, 0.15, 0.0))
      else
        shades.push(&hFFFFFFFF)
      end if
    end for
    m.lightCache[key] = shades
    return shades
  end function

  ' A texture's 1px columns, stacked tileCount times up, pre-translated so the foot is at the
  ' draw point: one draw covers a wall of tileCount copies.
  private function getColumns(name as string, tileCount as integer) as dynamic
    key = name + "x" + tileCount.toStr()
    columns = m.columnsByTexture[key]
    if invalid = columns
      columns = [] as roRegion[]
      region = m.textures[name]
      if invalid <> region
        texture = region as roRegion
        width = texture.GetWidth()
        tileHeight = texture.GetHeight()
        bitmap = texture.GetBitmap()
        x = texture.GetX()
        y = texture.GetY()
        if tileCount > 1
          stacked = CreateObject("roBitmap", {width: width, height: tileHeight * tileCount, alphaEnable: false})
          for t = 0 to tileCount - 1
            stacked.DrawObject(0, t * tileHeight, texture)
          end for
          stacked.Finish()
          bitmap = stacked
          x = 0
          y = 0
        end if
        height = tileHeight * tileCount
        for c = 0 to width - 1
          column = CreateObject("roRegion", bitmap, x + c, y, 1, height)
          column.SetPreTranslation(0, -height)
          columns.push(column)
        end for
      end if
      m.columnsByTexture[key] = columns
    end if
    if columns.count() = 0
      return invalid
    end if
    return columns
  end function

  private sub growSegments(count as integer)
    for i = m.segFirst.count() to count - 1
      m.segFirst.push(0)
      m.segLast.push(0)
      m.segAf.push(0.0)
      m.segAs.push(0.0)
      m.segBf.push(0.0)
      m.segBs.push(0.0)
    end for
  end sub

  private sub growPieces(count as integer)
    for i = m.pSeg.count() to count - 1
      m.pSeg.push(0)
      m.pS.push(0.0)
      m.pFwd.push(0.0)
      m.pFx.push(0.0)
      m.pFy.push(0.0)
      m.pLen.push(0.0)
      m.pWidth.push(1.0)
      m.pAngle.push(0.0)
      m.pRgba.push(-1)
    end for
  end sub

  ' As GridWallStripBuilder.clipSegment(): clips an end behind the camera and extends the
  ' visible part's screen line to where that end would map linearly.
  private function clipSegment(cx0 as float, cy0 as float, cz0 as float, cx1 as float, cy1 as float, cz1 as float) as boolean
    limit = m.limit
    if cz0 > limit and cz1 > limit
      return false
    end if
    startT = 0.0
    endT = 1.0
    if cz0 > limit
      startT = (limit - cz0) / (cz1 - cz0)
    else if cz1 > limit
      endT = (limit - cz0) / (cz1 - cz0)
    end if
    visible = endT - startT
    if visible < 0.001
      return false
    end if
    focal = m.focal
    ax = cx0 + (cx1 - cx0) * startT
    ay = cy0 + (cy1 - cy0) * startT
    az = cz0 + (cz1 - cz0) * startT
    bx = cx0 + (cx1 - cx0) * endT
    by = cy0 + (cy1 - cy0) * endT
    bz = cz0 + (cz1 - cz0) * endT
    sax = m.hw + focal * ax / -az
    say = m.hh - focal * ay / -az
    sbx = m.hw + focal * bx / -bz
    sby = m.hh - focal * by / -bz
    m.clipFootX = sax - (sbx - sax) * startT / visible
    m.clipFootY = say - (sby - say) * startT / visible
    m.clipTopX = sax + (sbx - sax) * (1 - startT) / visible
    m.clipTopY = say + (sby - say) * (1 - startT) / visible
    return true
  end function

end class
