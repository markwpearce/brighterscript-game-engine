sub main()
  screenWidth = 1280
  screenHeight = 720

  m.dummyScreen = CreateObject("roScreen", true, 0, 0)
  m.dummyScreen.setAlphaEnable(true)
  m.screen = CreateObject("roScreen", true, screenWidth, screenHeight)
  m.screen.setAlphaEnable(true)
  'testRendererDrawTransformedObject()
  'testDrawTransformedObject()
  'loadBmpTest2()
  'testCornerPin()
  'testCornerPin2()

  'testText()
  'testThirdRightTrianglePoint()
  'testIsInsideCanvas()
  testDrawRotatedImageWithCenterTo2()


end sub


sub loadBmpTest()
  size = 400
  num = 100
  screenWidth = m.screen.GetWidth()
  screenHeight = m.screen.GetHeight()
  font = CreateObject("roFontRegistry").GetDefaultFont(16, false, false)

  output = createObject("roBitmap", {width: screenWidth, height: screenHeight, alphaEnabled: true})


  for i = 0 to num
    bmp = CreateObject("roBitmap", {width: size, height: size, alphaEnabled: true})
    if invalid = bmp
      print "failed to load bitmap: " + i.toStr()
      output.Finish()
      RunGarbageCollector()
      sleep(100)
      output.Clear(0)
    else
      bmp.DrawText(i.toStr(), 0, 0, -1, font)
      row = i mod 12
      col = i \ 12
      output.drawObject(80 * row + 50, 20 * col + 50, bmp)
    end if
  end for
  output.Finish()
  m.screen.DrawObject(0, 0, output)
  m.screen.SwapBuffers()
  sleep(2000)
end sub


sub loadBmpTest2()
  screen = CreateObject("roScreen", true, 1280, 720)
  output = createObject("roBitmap", {width: 1280, height: 720, alphaEnabled: true})
  tmpBmpSize = 500
  font = CreateObject("roFontRegistry").GetDefaultFont(16, false, false)
  border = 40
  perRow = 16
  offset = (1280 - 2 * border) / perRow
  for i = 0 to 100
    tempBmp = CreateObject("roBitmap", {width: tmpBmpSize, height: tmpBmpSize, alphaEnabled: true})
    if tempBmp <> invalid
      ' We could create the temp bitmap. draw to it, then draw it to output
      tempBmp.drawText(i.toStr(), 0, 0, -1, font)
      tempBmp.finish()
      row = (i mod 16)
      col = (i \ 16)
      output.drawObject(row * offset + 50, col * 20 + 50, tempBmp)
    else
      print "Unable to create Bitmap - must be out of memory? "; i
      ' I would expect this to free the memory of all the tempBmp's created, since they are only referenced inside output
      output.finish()
      screen.drawObject(0, 0, output)
      screen.GetPng(0, 0, 1280, 720)
    end if
  end for
  screen.DrawObject(0, 0, output)
  screen.SwapBuffers()
  sleep(2000)
end sub


sub testRendererDrawTransformedObject()
  renderObj = new BGE.Renderer(m.screen)

  targetSize = 200
  offset = 100

  for i = 0 to 10
    renderObj.drawTriangle([
      {x: 0, y: 0},
      {x: targetSize, y: 0},
      {x: targetSize, y: targetSize},
    ], offset, offset, BGE.Colors().Red)

    triResourceScale = targetSize / BGE.RendererResourceSize
    m.screen.DrawTransformedObject(targetSize + 2 * offset, offset, 0, triResourceScale, triResourceScale, renderObj.resources.rightTriangle.bitmap)

    rndA = {x: rnd(targetSize * 2), y: rnd(targetSize * 2)}
    rndB = {x: rnd(targetSize * 2), y: rnd(targetSize * 2)}
    rndC = {x: rnd(targetSize * 2), y: rnd(targetSize * 2)}

    renderObj.drawTriangle([
      rndA,
      rndB,
      rndC,
    ], offset * 3 + targetSize * 2, offset, BGE.Colors().Green)

    m.screen.SwapBuffers()

    sleep(2000)
  end for
end sub


sub testDrawTransformedObject()
  image = CreateObject("roBitmap", "pkg:/images/rokuHomeScreen.jpg")
  fontRegistry = CreateObject("roFontRegistry")
  font = fontRegistry.GetDefaultFont(20, false, false)

  for i = 0 to 10
    deg = 45
    scaleX = 0.1 * i
    scaleY = 0.5
    m.screen.drawTransformedObject(200, 200, deg, scaleX, scaleY, image)
    m.screen.drawText("45 Deg rotation, changing x scale - x/y =" + (scaleX / scaleY).toStr(), 200, 600, -1, font)

    m.screen.SwapBuffers()
    sleep(1000)
  end for

  for i = 1 to 10
    deg = 45
    scaleX = 0.5
    scaleY = 0.5 * i
    m.screen.drawTransformedObject(200, 200, deg, scaleX, scaleY, image)
    m.screen.drawText("45 Deg rotation, changing y scale - x/y =" + (scaleX / scaleY).toStr(), 200, 600, -1, font)

    m.screen.SwapBuffers()
    sleep(1000)
  end for

  for i = 0 to 10
    deg = i * 5
    scaleX = 0.5
    scaleY = 0.5
    m.screen.drawTransformedObject(200, 200, deg, scaleX, scaleY, image)
    m.screen.drawText("Increasing rotation, constant equal scale (x/y = 1), deg =" + deg.toStr(), 200, 600, -1, font)

    m.screen.SwapBuffers()
    sleep(1000)
  end for

  for i = 0 to 10
    deg = i * 5
    scaleX = 0.2
    scaleY = 0.5
    m.screen.drawTransformedObject(200, 200, deg, scaleX, scaleY, image)
    m.screen.drawText("Increasing rotation, constant unequal scale - x/y =" + (scaleX / scaleY).toStr() + ", deg =" + deg.toStr(), 200, 600, -1, font)

    m.screen.SwapBuffers()
    sleep(1000)
  end for
end sub


sub testCornerPin()

  timer = CreateObject("roTimespan")


  output = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnabled: true})
  output.SetAlphaEnable(true)' = m.screen'
  output.DrawRect(0, 0, 1280, 720, BGE.Colors().navy)

  renderObj = new BGE.Renderer(output)
  'renderObj.drawDebugCells = true
  renderObj.dummyScreen = m.dummyScreen
  bitmap = CreateObject("roBitmap", "pkg:/sprites/roku-logo-purple.png")
  bitmap.SetAlphaEnable(true)
  region = CreateObject("roRegion", bitmap, 0, 0, bitmap.GetWidth(), bitmap.GetHeight()) as roRegion
  region.SetAlphaEnable(true)
  placementOffset = 80
  cols = 16
  for i = 0 to 25
    width = 50
    offset = placementOffset * (i mod cols)
    yOffset = (i \ cols) * placementOffset

    cornerPoints = BGE.Math.createCornerPoints({x: offset, y: width + yOffset}, {x: width + offset, y: width + yOffset}, {x: width + offset, y: 2 * width + yOffset}, {x: 2 * width + offset, y: 2 * width + yOffset})

    worked = renderObj.drawPinnedCornersTo(output,
    cornerPoints,
    {region: region, id: "logo"}, {})

    if not worked
      print "Failed to draw pinned corners for index: "; i
    end if
  end for
  m.screen.DrawObject(0, 0, output)


  'output2 = CreateObject("roBitmap", {width: 600, height: 600, alphaEnabled: true})
  ' m.screen.DrawObject(1, 1, output)
  'debugBMp = CreateObject("roBitmap", {width: 300, height: 300, alphaEnabled: true})
  'debugRegion = {
  '  region: createObject("roRegion", debugBMp, 0, 0, 300, 300)
  '}
  'debugRegion = m.bmpPool.getRegion(500, 500, originPoint.x > 0)

  'renderObj.drawRectangleTo(debugRegion.region, 20, 20, 80, 100, BGE.Colors().Lime)
  'm.screen.DrawObject(200, 600, debugRegion.region)

  m.screen.SwapBuffers()

  print timer.TotalMilliseconds().toStr() + " ms to draw corner pins"
  sleep(1000)
end sub


sub testCornerPin2()

  output = CreateObject("roBitmap", {width: 600, height: 600, alphaEnabled: true})

  bitmap = CreateObject("roBitmap", "pkg:/sprites/roku-logo-purple.png")
  region = CreateObject("roRegion", bitmap, 0, 0, 200, 200)

  renderObj = new BGE.Renderer(output)
  renderObj.drawDebugCells = true
  renderObj.dummyScreen = m.dummyScreen

  scratch = renderObj.bmpPool.getRegion(200, 200)

  scratch.region.DrawObject(0, 0, region)

  output.DrawRotatedObject(0, 0, -45, scratch.region)
  m.dummyScreen.drawObject(0, 0, output)
  m.dummyScreen.swapBuffers()

  m.screen.drawRect(0, 0, m.screen.getWidth(), m.screen.getHeight(), BGE.Colors().Pink)
  m.screen.drawObject(200, 200, output)

  m.screen.swapBuffers()

  sleep(1000)

end sub

sub testText()

  render = new BGE.Renderer(m.screen)

  fontRegistry = CreateObject("roFontRegistry")
  font = fontRegistry.GetDefaultFont(20, false, false)

  render.drawText("Hello World", 100, 100, -1, font, "center")
  render.drawText("Hello\nWorld", 100, 200, -1, font, "center")
  render.drawText("Hello" + CHR(10) + "World", 100, 300, -1, font, "center")
  m.screen.swapBuffers()
  sleep(1000)
end sub


function testThirdRightTrianglePoint()
  render = new BGE.Renderer(m.screen)


  for i = 0 to 20
    aPoint = BGE.Math.VectorOps.create(320, 385)'getRandomScreenPoint2(300, 300, 100, 200)
    bPoint = BGE.Math.VectorOps.create(619, 293)'getRandomScreenPoint2(300, 300, 100, 200)

    render.drawSquare(aPoint.x, aPoint.y, 10, BGE.Colors().Red)
    render.drawSquare(bPoint.x, bPoint.y, 10, BGE.Colors().Blue)


    aAngle = -rnd(0) * BGE.Math.HALF_PI

    originPoint = BGE.Math.TriangleOps.getThirdRightTrianglePoint(aPoint, bPoint, aAngle)
    if rodash.isNotInvalid(originPoint)
      render.drawLine(aPoint.x, aPoint.y, originPoint.x, originPoint.y, BGE.Colors().Pink)
      render.drawLine(bPoint.x, bPoint.y, originPoint.x, originPoint.y, BGE.Colors().Pink)
      render.drawSquare(originPoint.x, originPoint.y, 10, BGE.Colors().Pink)
    end if
    m.screen.swapBuffers()

    sleep(1000)
  end for


end function

function testIsInsideCanvas()
  destBmp = CreateObject("roBitmap", {width: 606, height: 350, alphaEnabled: true})


  for i = 10 to 100
    rotation = 0.3 * i
    worked = isInsideCanvas(destBmp, 283.101, 848.442, 1024, 1100, rotation)
    print "worked for rotation: "; worked; " - "; rotation
    m.screen.swapBuffers()
    sleep(100)
  end for


end function

function testIsInsideCanvas2()
  destBmp = CreateObject("roBitmap", {width: 80, height: 60, alphaEnabled: true})


  for i = 0 to 100
    rotation = 0.3 * i
    worked = isInsideCanvas(destBmp, 160, 200, 320, 320, rotation)
    print "worked for rotation: "; worked; " - "; rotation
    m.screen.swapBuffers()
    sleep(100)
  end for


end function


' Checks to see if a rectangle will be in a Draw2d Canvas
'
' @param {object} draw2d
' @param {float} originalX
' @param {float} originalY
' @param {float} width
' @param {float} height
' @param {float} [rotation=0] in radians
' @return {boolean} true if this rectangle overlaps with the canvas
function isInsideCanvas(draw2d as ifDraw2d, x as float, y as float, width as float, height as float, rotation = 0 as float) as boolean
  canvasWidth = draw2d.getWidth()
  canvasHeight = draw2d.getHeight()
  corners = [
    {x: x, y: y},
    {x: x + width, y: y},
    {x: x + width, y: y + height},
    {x: x, y: y + height},
  ]

  offsets = [
    {x: 0, y: 0},
    {x: width, y: 0},
    {x: width, y: height},
    {x: 0, y: height},
  ]

  bounds = corners
  if rotation <> 0
    negRot = rotation
    i = 0
    for each point in offsets
      rotatedX = cos(negRot) * (point.x) + sin(negRot) * (point.y)
      rotatedY = -sin(negRot) * (point.x) + cos(negRot) * (point.y)
      corners[i] = {x: x + rotatedX, y: y + rotatedY}
      i = i + 1
    end for
    boundingPoints = BGE.math.getBounds(corners)

    bounds = [
      {x: boundingPoints[0].x, y: boundingPoints[0].y},
      {x: boundingPoints[1].x, y: boundingPoints[0].y},
      {x: boundingPoints[1].x, y: boundingPoints[1].y},
      {x: boundingPoints[0].x, y: boundingPoints[1].y},
    ]
    width = boundingPoints[1].x - boundingPoints[0].x
    height = boundingPoints[1].y - boundingPoints[0].y
    x = boundingPoints[0].x
    y = boundingPoints[0].y
  end if
  offsetX = 400
  offsetY = 100
  m.screen.drawRect(bounds[0].x + offsetX, bounds[0].y + offsetY, bounds[2].x - bounds[0].x, bounds[2].y - bounds[0].y, BGE.colorOpacity(BGE.Colors().Yellow, 0.25))

  m.screen.drawRect(offsetX, offsetY, draw2d.getWidth(), draw2d.getHeight(), BGE.Colors().Pink)
  for each point in corners
    m.screen.drawRect(point.x + offsetX, point.y + offsetY, 10, 10, BGE.Colors().Green)
  end for
  for i = 0 to 3
    m.screen.drawLine(offsetX + corners[i].x, offsetY + corners[i].y, offsetX + corners[(i + 1) mod 4].x, offsetY + corners[(i + 1) mod 4].y, -1)
  end for


  ' check each corner
  insideCanvas = false
  for each point in bounds
    print "checking point: "; point.x; ", "; point.y
    m.screen.drawRect(point.x + offsetX, point.y + offsetY, 10, 10, BGE.Colors().Aqua)
    if point.x >= 0 and point.x <= canvasWidth and point.y >= 0 and point.y <= canvasHeight
      ' if one corner is in then this will be drawn
      insideCanvas = true
      exit for
    end if
  end for



  ' no corner is in the canvas, but this whole thing could overlap somehow
  if not insideCanvas and x < 0 and (x + width) > canvasWidth
    if y < 0
      insideCanvas = (y + height) >= 0
    else if y <= canvasHeight
      insideCanvas = true
    end if
  end if
  if not insideCanvas and y < 0 and (y + height) > canvasHeight
    if x < 0
      insideCanvas = (x + width) >= 0
    else if x <= canvasWidth
      insideCanvas = true
    end if
  end if

  return insideCanvas
end function



function testDrawRotatedImageWithCenterTo()
  destBmp = CreateObject("roBitmap", {width: 606, height: 350, alphaEnabled: true})

  map = CreateObject("roBitmap", "pkg:/sprites/SuperMarioKartMapMushroomCup1.png")

  topLeft = BGE.Math.VectorOps.create(400, 800)

  renderer = new BGE.Renderer(m.screen)
  m.renderer = renderer

  for i = 10 to 30

    rotation = 0.3 * i

    worked = drawRotatedImageWithCenterTo(destBmp, map, topLeft, rotation, BGE.Math.VectorOps.negative(topLeft))

    if not worked
      print "Failed to draw rotated image with center for index: "; i; " - rotation: "; rotation
    end if

    m.screen.drawObject(200, 200, destBmp)
    m.screen.swapBuffers()
    sleep(100)
  end for
end function


function testDrawRotatedImageWithCenterTo2()
  destBmp = CreateObject("roBitmap", {width: 300, height: 200, alphaEnabled: true})

  map = CreateObject("roBitmap", {width: 500, height: 500, alphaEnabled: true})
  map.DrawRect(0, 0, map.getWidth(), map.getHeight(), BGE.Colors().Navy)
  topLeft = BGE.Math.VectorOps.create(250, 250)
  translation = BGE.Math.VectorOps.negative(topLeft)

  renderer = new BGE.Renderer(m.screen)
  m.renderer = renderer

  for i = 10 to 30

    rotation = 0.3 * i

    worked = drawRotatedImageWithCenterTo(destBmp, map, topLeft, rotation, translation)

    if not worked
      print "Failed to draw rotated image with center for index: "; i; " - rotation: "; rotation
    end if

    m.screen.drawObject(200, 200, destBmp)
    m.screen.swapBuffers()
    sleep(100)
  end for
end function


' Rotates a region about a point, and draws it on a given draw2d with a given scale and translation
'
' @param {ifDraw2d} draw2d the final destination for the drawing
' @param {ifDraw2d} srcRegion the source region to draw from
' @param {BGE.Math.Vector} srcRotationPoint the position in srcRegion to rotate about, relative to the region's pretranslation
' @param {float} theta the angle to rotate by (in radians)
' @param {BGE.Math.Vector} [translation=BGE.Math.VectorOps.create()] the translation to apply after rotation
' @param {BGE.Math.Vector} [drawScale=BGE.Math.createScaleVector(1)] the scale to apply when drawing
' @return {boolean} did the drawing succeed
function drawRotatedImageWithCenterTo(draw2d as ifDraw2d, srcRegion as ifDraw2d, srcRotationPoint as BGE.Math.Vector, theta as float, translation = BGE.Math.VectorOps.create() as BGE.Math.Vector, drawScale = BGE.Math.createScaleVector(1) as BGE.Math.Vector) as boolean
  distanceToCenter = BGE.Math.VectorOps.length(srcRotationPoint)
  angleToCenter = BGE.Math.GetAngle(BGE.Math.VectorOps.create(), srcRotationPoint)
  centerRotationAngle = theta - angleToCenter
  rotatedCenter = BGE.Math.VectorOps.create(distanceToCenter * cos(centerRotationAngle), -distanceToCenter * sin(centerRotationAngle))
  finalTranslation = BGE.Math.VectorOps.add(translation, BGE.Math.VectorOps.subtract(srcRotationPoint, rotatedCenter))


  print "final translation: "; finalTranslation.x; ", "; finalTranslation.y; " - rotation: "; theta; " -rotated center: "; rotatedCenter.x; ", "; rotatedCenter.y
  print "draw2dSize: "; draw2d.getWidth(); ", "; draw2d.getHeight(); " - srcRegionSize: "; srcRegion.getWidth(); ", "; srcRegion.getHeight()
  ' if drawScale.x = 1 and drawScale.y = 1
  '   return m.renderer.drawRotatedObjectTo(draw2d, finalTranslation.x, finalTranslation.y, theta, srcRegion)
  ' end if
  'return m.renderer.drawTransformedObjectTo(draw2d, finalTranslation.x, finalTranslation.y, drawScale.x, drawScale.y, theta, srcRegion)
  worked = isInsideCanvas(draw2d, finalTranslation.x, finalTranslation.y, srcRegion.getWidth(), srcRegion.getHeight(), theta)
  offsetX = 400
  offsetY = 100

  (m.screen as ifDraw2D).DrawRotatedObject(finalTranslation.x + offsetX, finalTranslation.y + offsetY, BGE.Math.RadiansToDegrees(theta), srcRegion)

  m.screen.drawRect(finalTranslation.x + offsetX, finalTranslation.y + offsetY, 20, 20, BGE.Colors().Lime)
  return worked
end function

