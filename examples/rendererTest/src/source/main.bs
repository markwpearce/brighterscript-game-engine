' A scratch app for exercising BGE.Renderer directly - no BGE.Game/GameScene
' involved, since the point is to test the Renderer API in isolation. Each
' demo (see DemoList.bs) is a RendererTest subclass under Tests/; this file
' just runs the on-screen menu and drives whichever demo is currently active.
sub main(args as object)
  screen = CreateObject("roScreen", true, 1280, 720)
  screen.SetAlphaEnable(true)
  port = CreateObject("roMessagePort")
  screen.SetMessagePort(port)

  renderer = new BGE.Renderer(screen)
  helpFont = CreateObject("roFontRegistry").GetDefaultFont(16, false, false)
  demoGroups = GetDemoGroups()
  demoList = flattenDemoGroups(demoGroups)

  activeDemo = invalid
  activeDemoIndex = -1
  selectedIndex = 0

  params = new BGE.LaunchParams(args)
  requestedDemoId = params.getString("demo")
  if requestedDemoId <> ""
    for i = 0 to demoList.count() - 1
      if lcase(demoList[i].id) = lcase(requestedDemoId)
        selectedIndex = i
        activeDemoIndex = i
        activeDemo = demoList[i].create()
        activeDemo.screenRef = screen
        activeDemo.launchParams = params.toAA()
        activeDemo.setup(renderer)
        exit for
      end if
    end for
  end if

  timer = CreateObject("roTimespan")
  ' Times every demo's update/draw passes, so the cost of whatever a demo is doing is
  ' visible on screen without the demo having to measure anything itself.
  demoTimings = new FrameTimer()
  passTimings = new FrameTimer()

  while true
    msg = port.GetMessage() ' non-blocking - wait(0, port) would block forever, not return immediately
    if type(msg) = "roUniversalControlEvent" and msg.GetInt() < 100 ' pressed only
      buttonName = BGE.buttonNameFromCode(msg.GetInt())

      if invalid = activeDemo
        if buttonName = "down"
          selectedIndex = (selectedIndex + 1) mod demoList.count()
        else if buttonName = "up"
          selectedIndex = selectedIndex - 1
          if selectedIndex < 0
            selectedIndex = demoList.count() - 1
          end if
        else if buttonName = "left" or buttonName = "rewind"
          selectedIndex = firstDemoOfGroup(demoList, demoList[selectedIndex].groupIndex - 1, demoGroups.count())
        else if buttonName = "right" or buttonName = "fastforward"
          selectedIndex = firstDemoOfGroup(demoList, demoList[selectedIndex].groupIndex + 1, demoGroups.count())
        else if buttonName = "OK"
          activeDemoIndex = selectedIndex
          activeDemo = demoList[activeDemoIndex].create()
          activeDemo.screenRef = screen
          activeDemo.setup(renderer)
        end if
      else if buttonName = "back"
        activeDemo.teardown(renderer)
        activeDemo = invalid
        selectedIndex = activeDemoIndex
      else
        activeDemo.onInput(buttonName)
      end if
    end if

    dt = timer.TotalMilliseconds() / 1000
    frameMs = timer.TotalMilliseconds()
    timer.Mark()

    screen.Clear(&h000000FF)
    renderer.resetDrawCallCounter()

    updateMs = 0
    drawMs = 0
    if invalid = activeDemo
      drawMenu(renderer, demoGroups, demoList, selectedIndex, helpFont)
    else
      passTimings.mark()
      activeDemo.update(dt)
      updateMs = passTimings.elapsedMs()

      passTimings.mark()
      activeDemo.draw(renderer)
      drawMs = passTimings.elapsedMs()

      demoTimings.recordFrame(updateMs, drawMs, frameMs, renderer.getDrawCallsLastFrame())
      drawDemoHeader(renderer, activeDemo.title, helpFont, demoTimings)
    end if

    passTimings.mark()
    screen.SwapBuffers()
    if invalid <> activeDemo
      activeDemo.lastSwapMs = passTimings.elapsedMs()
    end if
    renderer.onSwapBuffers()
  end while
end sub


sub drawDemoHeader(renderer as BGE.Renderer, title as string, helpFont as roFont, timings as FrameTimer)
  canvasSize = renderer.getCanvasSize()
  renderer.drawText(title, canvasSize.x / 2, 20, BGE.Colors.White, invalid, "center")
  ' Cost of the running demo, averaged over a window of frames - see FrameTimer.
  renderer.drawText(timings.toStr(), canvasSize.x / 2, canvasSize.y - 54, BGE.Colors.Yellow, helpFont, "center")
  renderer.drawText("Back: return to menu", canvasSize.x / 2, canvasSize.y - 30, BGE.Colors.Gray, helpFont, "center")
end sub

' One menu row per demo, in group order, so selection can step through every demo with Up/Down.
function flattenDemoGroups(demoGroups as DemoGroup[]) as MenuDemo[]
  demoList = [] as MenuDemo[]
  titles = {}
  for groupIndex = 0 to demoGroups.count() - 1
    group = demoGroups[groupIndex]
    if titles.doesExist(group.title)
      print "WARNING: rendererTest has two demo groups titled "; group.title; " - merge them in DemoList.bs"
    end if
    titles[group.title] = true
    for each demo in group.demos
      demoList.push({id: demo.id, name: demo.name, create: demo.create, groupIndex: groupIndex})
    end for
  end for
  return demoList
end function

' Index of the first demo in a group, wrapping past either end of the group list.
function firstDemoOfGroup(demoList as MenuDemo[], groupIndex as integer, groupCount as integer) as integer
  groupIndex = (groupIndex + groupCount) mod groupCount
  for i = 0 to demoList.count() - 1
    if demoList[i].groupIndex = groupIndex
      return i
    end if
  end for
  return 0
end function

interface MenuDemo
  id as string
  name as string
  create as function
  groupIndex as integer
end interface

sub drawMenu(renderer as BGE.Renderer, demoGroups as DemoGroup[], demoList as MenuDemo[], selectedIndex as integer, helpFont as roFont)
  canvasSize = renderer.getCanvasSize()
  selectedGroup = demoList[selectedIndex].groupIndex

  renderer.drawText("Renderer Test Suite", canvasSize.x / 2, 40, BGE.Colors.White, invalid, "center")
  renderer.drawText("Up/Down: select     Left/Right: group     OK: run test", canvasSize.x / 2, 85, BGE.Colors.Gray, helpFont, "center")
  groupLine = demoGroups[selectedGroup].title + "  (" + (selectedGroup + 1).toStr() + "/" + demoGroups.count().toStr() + ")"
  renderer.drawText(groupLine, canvasSize.x / 2, 110, BGE.Colors.Yellow, helpFont, "center")

  ' Lay out every row first, then scroll so the selected demo stays in view.
  rows = []
  y = 0
  selectedY = 0
  lastGroup = -1
  for i = 0 to demoList.count() - 1
    demo = demoList[i]
    if demo.groupIndex <> lastGroup
      rows.push({text: demoGroups[demo.groupIndex].title, y: y, color: BGE.Colors.Yellow})
      y += 26
      lastGroup = demo.groupIndex
    end if

    textColor = BGE.Colors.White
    prefix = "     "
    if i = selectedIndex
      textColor = BGE.Colors.Lime
      prefix = " > "
      selectedY = y
    end if
    rows.push({text: prefix + demo.name + "   [" + demo.id + "]", y: y, color: textColor})
    y += 22
  end for
  listHeight = y
  ' bottom stays title-safe, with room for the "more" hint
  viewTop = 140
  viewBottom = canvasSize.y * 0.9 - 26
  viewHeight = viewBottom - viewTop
  scroll = selectedY - viewHeight / 2
  if scroll > listHeight - viewHeight
    scroll = listHeight - viewHeight
  end if
  if scroll < 0
    scroll = 0
  end if

  for each row in rows
    rowY = viewTop + row.y - scroll
    if rowY >= viewTop and rowY + 22 <= viewBottom
      renderer.drawText(row.text, 100, rowY, row.color, helpFont)
    end if
  end for
  if scroll > 0
    renderer.drawText("^ more", 100, viewTop - 26, BGE.Colors.Gray, helpFont)
  end if
  if scroll + viewHeight < listHeight
    renderer.drawText("v more", 100, viewBottom, BGE.Colors.Gray, helpFont)
  end if
end sub
