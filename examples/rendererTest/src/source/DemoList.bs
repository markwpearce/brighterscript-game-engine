' The single place to register a new renderer test. Add an entry to a group here and
' its RendererTest subclass under Tests/, and it shows up in the on-screen menu under that
' group's title, in the order listed. Left/Right on the menu jumps between groups.
'
' `id` can be passed as a launch/deep-link param (e.g.
' `rokubot launch dev --param demo=triangles`) to jump straight to that demo,
' skipping the menu - see the `demo` param in main.bs.
'
' @return {DemoGroup[]} the menu's groups, each with a unique title
function GetDemoGroups() as DemoGroup[]
  return [
    {
      title: "3D Benchmarks",
      demos: [
        {
          id: "fog-benchmark",
          name: "Fog Benchmark",
          create: function() as RendererTest
            return new FogTest(true)
          end function
        },
        {
          id: "walls-benchmark",
          name: "Walls Benchmark",
          create: function() as RendererTest
            return new WallsBenchmark()
          end function
        },
        {
          id: "segment-walls",
          name: "Segment Walls",
          create: function() as RendererTest
            return new SegmentWallsTest()
          end function
        },
