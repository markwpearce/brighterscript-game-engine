          end function
        },
        {
          id: "floors-benchmark",
          name: "Floors Benchmark",
          create: function() as RendererTest
            return new FloorsBenchmark()
          end function
        },
        {
          id: "plane-strips-benchmark",
          name: "Plane Strips Benchmark",
          create: function() as RendererTest
            return new PlaneStripsBenchmark()
          end function
        },
        {
          id: "voxel-terrain",
          name: "Voxel Terrain (#637)",
          create: function() as RendererTest
            return new VoxelTerrainTest()
          end function
