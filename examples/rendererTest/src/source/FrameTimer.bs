' Per-frame timing for whichever demo is running, so any of them can be judged on cost
' rather than on how it looks. main.bs feeds it each frame and draws the result in the
' demo header - no demo has to do anything to opt in.
'
' Draw costs on Roku differ by more than an order of magnitude between operations (a
' DrawRect or a plain bitmap blit runs into the tens of thousands per second, while
' rasterizing a rotated quad manages a few hundred), so "which of these two approaches is
' cheaper" is not a question to answer by reading the code. See
' https://github.com/markwpearce/roku-draw2d-performance for the underlying per-operation
' numbers, and the "Quad Fill Benchmark" demo for an example of timing two specific
' approaches against each other in one run.
class FrameTimer

  ' Frames to average over. Single-frame numbers jitter far too much to read off a TV.
  private windowSize = 30

  private timer as roTimespan
  private frames = 0
  private updateMsTotal = 0
  private drawMsTotal = 0
  private frameMsTotal = 0
  private drawCallsTotal = 0

  private reportedUpdateMs = 0.0
  private reportedDrawMs = 0.0
  private reportedFrameMs = 0.0
  private reportedDrawCalls = 0

  sub new()
    m.timer = CreateObject("roTimespan")
  end sub

  ' Starts timing a section (an update pass, a draw pass, a whole frame).
  sub mark()
    m.timer.Mark()
  end sub

  ' Milliseconds since the last mark().
  function elapsedMs() as integer
    return m.timer.TotalMilliseconds()
  end function

  ' Records one frame's measurements, and rolls them into the reported averages once a
  ' full window's worth has accumulated.
  '
  ' @param {integer} updateMs time spent in the demo's update()
  ' @param {integer} drawMs time spent in the demo's draw()
  ' @param {integer} frameMs total time for the frame, including the swap
  ' @param {integer} drawCalls draw calls the Renderer counted this frame
  sub recordFrame(updateMs as integer, drawMs as integer, frameMs as integer, drawCalls as integer)
    m.frames++
    m.updateMsTotal += updateMs
    m.drawMsTotal += drawMs
    m.frameMsTotal += frameMs
    m.drawCallsTotal += drawCalls

    if m.frames < m.windowSize
      return
    end if

    m.reportedUpdateMs = m.updateMsTotal / m.frames
    m.reportedDrawMs = m.drawMsTotal / m.frames
    m.reportedFrameMs = m.frameMsTotal / m.frames
    m.reportedDrawCalls = cint(m.drawCallsTotal / m.frames)

    m.frames = 0
    m.updateMsTotal = 0
    m.drawMsTotal = 0
    m.frameMsTotal = 0
    m.drawCallsTotal = 0
  end sub

  ' A one-line summary of the averaged cost of the current demo.
  '
  ' @return {string} e.g. "45 fps | frame 22.1ms | update 0.2ms | draw 18.6ms | 27 draw calls"
  function toStr() as string
    if m.reportedFrameMs <= 0
      return "measuring..."
    end if
    fps = cint(1000.0 / m.reportedFrameMs)
    return `${fps} fps | frame ${m.format(m.reportedFrameMs)}ms | update ${m.format(m.reportedUpdateMs)}ms | draw ${m.format(m.reportedDrawMs)}ms | ${m.reportedDrawCalls} draw calls`
  end function

  private function format(value as float) as string
    return Str(int(value * 10 + 0.5) / 10.0).trim()
  end function

end class
