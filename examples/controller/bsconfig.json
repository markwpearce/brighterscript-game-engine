{
    "extends": "../../bsconfig.build.json",
    "rootDir": "src",
    "outDir": "build",
    "files": [
        "**/*",
        {
            "src": "../../../src/source/**/*",
            "dest": "source"
        },
        {
            "src": "../../../src/components/**/*",
            "dest": "components"
        },
        "!../../../src/**/*.spec.bs"
        // ControllerServer.bs hardcodes "pkg:/source/controller-web" as its static
        // asset root. A real `ropm install` rewrites that literal to match wherever
        // ropm physically relocates the file (verified: ropm's regex-based pkg:/
        // string rewriter operates on any .bs/.brs source, not just component/class
        // names), so the literal is correct for real consumers. The split copy above
        // already places src/source/controller-web/** at the matching source/controller-web
        // destination, so no separate copy entry is needed for it.
    ],
    "emitDefinitions": false,
    "diagnosticFilters": [
        {
            "files": "../../../src/**/*"
        }
    ]
}
