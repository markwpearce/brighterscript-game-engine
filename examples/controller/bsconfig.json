{
    "extends": "../../bsconfig.build.json",
    "rootDir": "src",
    "outDir": "build",
    "files": [
        "**/*",
        {
            "src": "../../../src/**/*",
            "dest": "source/roku_modules"
        },
        "!../../../src/**/*.spec.bs",
        "!../../../src/components/**/*",
        // ControllerServer.bs hardcodes "pkg:/source/controller-web" as its static
        // asset root. A real `ropm install` rewrites that literal to match wherever
        // ropm physically relocates the file (verified: ropm's regex-based pkg:/
        // string rewriter operates on any .bs/.brs source, not just component/class
        // names), so the literal is correct for real consumers. This dev-only
        // file-copy shortcut does no such text rewriting, so it must instead place
        // the asset at the literal, unrewritten path the engine code expects.
        {
            "src": "../../../src/source/controller-web/**/*",
            "dest": "source/controller-web"
        }
    ],
    "emitDefinitions": false,
    "diagnosticFilters": [
        {
            "files": "../../../src/source/roku_modules/**/*"
        }
    ]
}
