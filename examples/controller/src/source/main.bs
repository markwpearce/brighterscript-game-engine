sub Main()
  game = new BGE.Game(1280, 720) ' This initializes the game engine
  game.fitCanvasToScreen()
  game.enableControllerInput()

  ' Player 1 (playerIndex 0): remote OK or controller button "ok" fires (see
  ' controller-web/index.html's two on-screen buttons, named after BGE's own
  ' canonical button names); move with the remote d-pad or the first
  ' connected browser's stick "1".
  game.controls.bindAction("fire1", "ok", "ok", 0, "Fire")
  game.controls.bindAxis("move1", "1", 0, "Move")

  ' Player 2 (playerIndex 1): a second connected browser fires via its own
  ' "ok" button. move2's stick-vs-remote fallback (see
  ' BGE.Controller.ControlMap.getAxis()) already lets this player move with
  ' a second paired remote or simulator gamepad's d-pad, with no separate
  ' axis binding needed.
  game.controls.bindAction("fire2", invalid, "ok", 1, "Fire")
  game.controls.bindAxis("move2", "1", 1, "Move")

  ' A second paired remote or simulator gamepad (not a browser) can also
  ' drive player 2 independently - remote-only binding, no controllerButton,
  ' bound to "rewind" rather than "ok" specifically because the built-in
  ' controller-web/index.html page never sends "rewind" for anything (its
  ' on-screen buttons only send "ok"/"b"/"back", and even a real Gamepad API
  ' device it detects sends numeric string indices, not named remote
  ' buttons) - a custom third-party controller page could still choose to
  ' send "rewind" too, same caveat that applies to any other button-name
  ' binding (see docs/controller-input.md). ship2 flashes yellow when this
  ' fires, distinguishing it on-screen from player 0's remote (ship1, never
  ' flashes) and from player 2's own browser "ok" button (ship2's base cyan
  ' color, no flash).
  game.controls.bindAction("fire2Remote", "rewind", invalid, 1, "Fire (2nd remote/gamepad, Rewind)")

  firstRoom = new MainRoom(game)
  game.defineRoom(firstRoom)
  game.changeRoom(firstRoom.name)

  game.enableStandardDebugUi({memory: false, garbageCollector: false})

  game.play()
end sub
