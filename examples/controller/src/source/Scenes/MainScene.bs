import "pkg:/source/engine/ui/ControllerQrWidget.bs"

' Demonstrates unified controller input (BGE.ControlMap, Game.enableControllerInput()) -
' two ships, each driven by its own move/fire binding (player 1: remote or controller
' button "a"; player 2: a second connected browser's button "a", or a second paired
' remote/simulator gamepad's own Rewind button - ship2 flashes yellow for that source).
' See main.bs for the bindings, which is also where each ship's controllerButton name
' is chosen.
class MainScene extends BGE.GameScene

  infoLabel as BGE.UI.Label
  remoteInfoLabel as BGE.UI.Label
  remoteInfoLabel2 as BGE.UI.Label
  qrX as float
  qrY as float
  qrWidth as float = 150.0
  ' The connection QR code, in gameUi. Its URL is encoded once, when it's made.
  qrWidget as BGE.UI.ControllerQrWidget = invalid
  inputDisplay as BGE.Debug.InputDisplay

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainScene"
    m.infoLabel = new BGE.UI.Label(m.game)
    m.remoteInfoLabel = new BGE.UI.Label(m.game)
    m.remoteInfoLabel2 = new BGE.UI.Label(m.game)
  end sub

  override sub onCreate(args as roAssociativeArray)
    ship1 = new ControlledShip(m.game, "move1", "fire1", BGE.ColorsRGB.White)
    m.game.addEntity(ship1) ' onCreate() sets position to canvas center - offset after, not before
    ship1.position.x -= 80

    ship2 = new ControlledShip(m.game, "move2", "fire2", BGE.ColorsRGB.Cyan, "fire2Remote")
    m.game.addEntity(ship2)
    ship2.position.x += 80

    m.qrX = m.game.uiCanvas.getWidth() * 0.1
    m.qrY = m.game.uiCanvas.getHeight() * 0.1
    m.qrWidget = new BGE.UI.ControllerQrWidget(m.game, "", m.qrWidth)
    m.qrWidget.caption = ""
    m.qrWidget.showUrl = false
    m.qrWidget.contentPadding = 0
    m.qrWidget.layout()
    m.qrWidget.customPosition = true
    m.qrWidget.customX = m.qrX
    m.qrWidget.customY = m.qrY
    m.game.gameUi.addChild(m.qrWidget)

    m.infoLabel.customPosition = true
    m.infoLabel.customX = m.qrX
    m.infoLabel.customY = m.qrY + m.qrWidget.getQrSize() + 10
    m.infoLabel.setText("...or scan for up to 2 controllers: " + m.game.getControllerConnectionInfo())
    m.game.gameUi.addChild(m.infoLabel)

    m.remoteInfoLabel.customPosition = true
    m.remoteInfoLabel.customX = m.qrX
    m.remoteInfoLabel.customY = m.infoLabel.customY + 30
    m.remoteInfoLabel.setText("Player 2 can also use a second paired remote or simulator")
    m.game.gameUi.addChild(m.remoteInfoLabel)

    m.remoteInfoLabel2.customPosition = true
    m.remoteInfoLabel2.customX = m.qrX
    m.remoteInfoLabel2.customY = m.remoteInfoLabel.customY + 30
    m.remoteInfoLabel2.setText("gamepad's Rewind button - cyan ship flashes yellow")
    m.game.gameUi.addChild(m.remoteInfoLabel2)
  end sub

  override sub onChangeScene(newScene as BGE.GameScene)
    m.game.gameUi.removeChild(m.qrWidget)
    m.game.gameUi.removeChild(m.infoLabel)
    m.game.gameUi.removeChild(m.remoteInfoLabel)
    m.game.gameUi.removeChild(m.remoteInfoLabel2)
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    end if
    if input.press and input.isButton("replay") and m.inputDisplay <> invalid
      m.inputDisplay.toggleMode()
    end if
  end sub

end class
