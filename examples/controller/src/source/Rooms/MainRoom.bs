' Demonstrates unified controller input (BGE.ControlMap, Game.enableControllerInput()) -
' two ships, each driven by its own move/fire binding (player 1: remote or controller
' button "a"; player 2: a second connected browser's button "a"). See main.bs for the
' bindings, which is also where each ship's controllerButton name is chosen.
class MainRoom extends BGE.Room

  infoLabel as BGE.UI.Label

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainRoom"
    m.infoLabel = new BGE.UI.Label(m.game)
  end sub

  override sub onCreate(args as roAssociativeArray)
    ship1 = new ControlledShip(m.game, "move1", "fire1", BGE.ColorsRGB.White)
    m.game.addEntity(ship1) ' onCreate() sets position to canvas center - offset after, not before
    ship1.position.x -= 80

    ship2 = new ControlledShip(m.game, "move2", "fire2", BGE.ColorsRGB.Cyan)
    m.game.addEntity(ship2)
    ship2.position.x += 80

    m.infoLabel.customPosition = true
    m.infoLabel.customX = m.game.canvas.getWidth() * 0.1
    m.infoLabel.customY = m.game.canvas.getHeight() * 0.1
    m.infoLabel.setText("Connect up to 2 controllers at: " + m.game.getControllerConnectionInfo())
    m.game.gameUi.addChild(m.infoLabel)
  end sub

  override sub onChangeRoom(newRoom as BGE.Room)
    m.game.gameUi.removeChild(m.infoLabel)
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    end if
  end sub

end class
