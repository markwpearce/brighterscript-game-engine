' Demonstrates unified controller input (BGE.ControlMap, Game.enableControllerInput()) -
' two ships, each driven by its own move/fire binding (player 1: remote or controller
' button "a"; player 2: a second connected browser's button "a"). See main.bs for the
' bindings, which is also where each ship's controllerButton name is chosen.
class MainRoom extends BGE.Room

  infoLabel as BGE.UI.Label
  qrX as float
  qrY as float
  qrWidth as float = 150.0
  ' Encoded once in onCreate, not re-encoded every frame - see onDrawEnd(). The
  ' connection URL never changes for the room's lifetime, and encoding (segment
  ' building, version-fit search, Reed-Solomon ECC, 8-mask penalty scoring) is
  ' the expensive part of BGE.QrCode.draw(), unlike the per-module blit.
  qr as BGE.QrCode.QrCode

  sub new(game as BGE.Game)
    super(game)
    m.name = "MainRoom"
    m.infoLabel = new BGE.UI.Label(m.game)
  end sub

  override sub onCreate(args as roAssociativeArray)
    ship1 = new ControlledShip(m.game, "move1", "fire1", BGE.ColorsRGB.White)
    m.game.addEntity(ship1) ' onCreate() sets position to canvas center - offset after, not before
    ship1.position.x -= 80

    ship2 = new ControlledShip(m.game, "move2", "fire2", BGE.ColorsRGB.Cyan)
    m.game.addEntity(ship2)
    ship2.position.x += 80

    m.qrX = m.game.canvas.getWidth() * 0.1
    m.qrY = m.game.canvas.getHeight() * 0.1
    m.qr = BGE.QrCode.qrEncodeText(m.game.getControllerConnectionInfo(), BGE.QrCode.EccLevel.medium)

    m.infoLabel.customPosition = true
    m.infoLabel.customX = m.qrX
    m.infoLabel.customY = m.qrY + m.qrWidth + 10
    m.infoLabel.setText("...or scan for up to 2 controllers: " + m.game.getControllerConnectionInfo())
    m.game.gameUi.addChild(m.infoLabel)
  end sub

  override sub onChangeRoom(newRoom as BGE.Room)
    m.game.gameUi.removeChild(m.infoLabel)
  end sub

  ' Draws the connection URL as a QR code every frame - see docs/qr-codes.md.
  ' qrDrawModules() (unlike draw()) takes an already-encoded QrCode, so this
  ' reuses onCreate()'s cached m.qr instead of re-running the expensive encode
  ' pipeline every frame; only the (much cheaper) per-module blit repeats.
  override sub onDrawEnd(gameRenderer as BGE.Renderer, uiRenderer as BGE.Renderer)
    draw2d = uiRenderer.getDraw2d()
    uiRenderer.incrementDrawCalls(BGE.QrCode.qrDrawModules(draw2d, m.qr, m.qrX, m.qrY, m.qrWidth))
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and input.isButton("back")
      m.game.End()
    end if
  end sub

end class
