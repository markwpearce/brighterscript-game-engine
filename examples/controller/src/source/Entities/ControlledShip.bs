' A simple entity driven by the unified BGE.ControlMap - see main.bs for the
' move/fire action names each ship reads. Works from either the Roku remote
' (d-pad + OK, player 1 only) or a connected phone/web controller (see
' Game.enableControllerInput()).
class ControlledShip extends BGE.GameEntity

  speed = 300 as float
  moveAxis as string
  fireAction as string
  fireActionAlt as string ' invalid unless this ship also demonstrates a second physical remote/gamepad
  color as integer
  body as BGE.DrawableRectangle
  flashTimer as BGE.CountdownTimer

  sub new(game as BGE.Game, moveAxis as string, fireAction as string, color as integer, fireActionAlt = invalid as dynamic)
    super(game)
    m.name = "ControlledShip"
    m.moveAxis = moveAxis
    m.fireAction = fireAction
    m.fireActionAlt = fireActionAlt
    m.color = color
    m.flashTimer = new BGE.CountdownTimer()
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.position = m.game.canvas.renderer.getCanvasCenter()
    m.body = m.addRectangle("body", 40, 40, {color: m.color})
  end sub

  ' Called once per frame with the game's ControlMap, before onUpdate() -
  ' the recommended way to read bound action/axis state (see
  ' docs/controller-input.md's "Mapping input" section).
  override sub onControls(controls as BGE.Controller.ControlMap)
    move = controls.getAxis(m.moveAxis)
    m.velocity.x = move.x * m.speed
    m.velocity.y = move.y * m.speed
    if controls.isActionPressed(m.fireAction)
      print "fire! (" + m.fireAction + ")"
    end if
    if m.fireActionAlt <> invalid and controls.isActionPressed(m.fireActionAlt)
      print "fire! (" + m.fireActionAlt + " - 2nd physical remote/gamepad)"
      m.flashTimer.start(0.3)
    end if
  end sub

  ' Flashes yellow briefly whenever fireActionAlt (a second physical
  ' remote/gamepad's own Rewind button) fires, so it's visually
  ' distinguishable on-screen from this ship's base color, which is all
  ' player 0's remote or a browser's "ok" button ever produce.
  override sub onUpdate(deltaTime as float)
    m.flashTimer.tick(deltaTime)
    if m.flashTimer.isActive()
      m.body.color = BGE.ColorsRGB.Yellow
    else
      m.body.color = m.color
    end if
  end sub

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
  end sub

end class
