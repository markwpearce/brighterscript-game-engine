' A simple entity driven by the unified BGE.ControlMap - see main.bs for the
' "move"/"fire" bindings. Works from either the Roku remote (d-pad + OK) or a
' connected phone/web controller (see Game.enableControllerInput()).
class ControlledShip extends BGE.GameEntity

  speed = 300 as float

  sub new(game as BGE.Game)
    super(game)
    m.name = "ControlledShip"
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.addRectangle("body", 40, 40, {color: BGE.ColorsRGB.White})
  end sub

  override sub onUpdate(deltaTime as float)
    move = m.game.controls.getAxis("move")
    m.velocity.x = move.x * m.speed
    m.velocity.y = move.y * m.speed
  end sub

  override sub onInput(input as BGE.GameInput)
    if input.press and m.game.controls.isActionPressed("fire")
      print "fire!"
    end if
  end sub

  override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
  end sub

end class
