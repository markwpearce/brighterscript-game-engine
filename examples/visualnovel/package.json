{
    "private": true,
    "scripts": {
        "build": "bsc",
        "test": "bsc --project bsconfig.test.json --create-package=false && node ../../scripts/run-tests-ci.js examples/visualnovel/test-build",
        "clean": "rimraf build && rimraf out",
        "package": "bsc && exampleName=`basename $PWD` && npx roku-deploy zip --dir ./build --out ./out/bge-${exampleName}.zip"
    },
    "ropm": {
        "rootDir": "src"
    },
    "devDependencies": {
        "brighterscript": "1.0.0-alpha.57",
        "rimraf": "^6.1.3",
        "roku-deploy": "4.0.0-alpha.10",
        "ropm": "^0.11.4"
    }
}
