namespace tests
  @suite("visual novel characters")
  class CharactersTests extends rooibos.BaseTestSuite

    @describe("portrait facing")

    @it("mirrors a portrait only when its art faces away from the middle")
    function _()
      ' Castell faces left, Sato and Voss face right, Husk faces front.
      m.assertTrue(shouldMirrorPortrait("castell", "left"))
      m.assertFalse(shouldMirrorPortrait("castell", "right"))
      m.assertFalse(shouldMirrorPortrait("sato", "left"))
      m.assertTrue(shouldMirrorPortrait("sato", "right"))
      m.assertTrue(shouldMirrorPortrait("voss", "right"))
      m.assertFalse(shouldMirrorPortrait("husk", "left"))
      m.assertFalse(shouldMirrorPortrait("husk", "right"))
    end function

    @it("gives every portrait a facing")
    function _()
      for each id in getPortraitIds()
        facing = portraitFacing(id)
        m.assertTrue(facing = "left" or facing = "right" or facing = "front", id)
      end for
      m.assertEqual(portraitFacing("nobody"), "front")
    end function

  end class
end namespace
