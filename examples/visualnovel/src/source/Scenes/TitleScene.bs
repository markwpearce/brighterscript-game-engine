import "pkg:/source/engine/GameScene.bs"
import "pkg:/source/engine/ui/Label.bs"
import "pkg:/source/engine/ui/UiContainer.bs"
import "pkg:/source/utils/registry.bs"
import "pkg:/source/story/StoryTypes.bs"
import "../Novel/VnSave.bs"
import "../Novel/Characters.bs"
import "../UI/Backdrop.bs"
import "../UI/ChoiceList.bs"
import "../UI/FontLabel.bs"

' The Mutiny's title: Continue (with a save), New Game, Credits, and the endings found. Back exits.
class TitleScene extends BGE.GameScene

  private backdrop as Backdrop = invalid
  private menu as ChoiceList = invalid
  private labels as BGE.UI.Label[] = []
  private actions as string[] = []

  sub new(game as BGE.Game)
    super(game)
    m.name = "TitleScene"
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    name = backgroundBitmapName("centaurBridge")
    if not m.game.Bitmaps.DoesExist(name)
      loader.loadBitmap(name, "pkg:/images/bg/centaurBridge.jpg")
    end if
    m.game.musicPlay("pkg:/music/Drifting.mp3", true, false)
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.backdrop = new Backdrop(m.game)
    m.backdrop.setBackground("centaurBridge")
    m.game.gameUi.addChild(m.backdrop)
    titleFont = m.game.getFont("vnTitle")
    title = new FontLabel(m.game, titleFont)
    m.placeLabel(title, "THE MUTINY", 128, 72)
    endings = new BGE.UI.Label(m.game)
    m.placeLabel(endings, UCase(endingsSeenText(BGE.registryRead(VN_SAVE_SECTION, "endings", {}))), 132, 72 + titleFont.GetOneLineHeight())
    m.actions = []
    views = [] as BGE.Story.ChoiceView[]
    if validateVnSave(BGE.registryRead(VN_SAVE_SECTION, "save")) <> invalid
      m.actions.push("continue")
      views.push({label: "Continue", enabled: true, choice: {}, index: 0})
    end if
    m.actions.push("newGame")
    views.push({label: "New Game", enabled: true, choice: {}, index: 0})
    m.actions.push("credits")
    views.push({label: "Credits", enabled: true, choice: {}, index: 0})
    m.menu = new ChoiceList(m.game)
    m.game.gameUi.addChild(m.menu)
    m.menu.show(views, m)
  end sub

  private sub placeLabel(label as BGE.UI.Label, text as string, x as float, y as float)
    label.customPosition = true
    label.customX = x
    label.customY = y
    label.setText(text)
    m.game.gameUi.addChild(label)
    m.labels.push(label)
  end sub

  sub chooseIndex(index as integer)
    if m.game.isTransitioning()
      return
    end if
    if m.actions[index] = "continue"
      m.game.changeSceneWithFade("StageScene", {continue: true})
    else if m.actions[index] = "credits"
      m.game.changeSceneWithFade("CreditsScene", {})
    else
      m.game.changeSceneWithFade("StageScene", {})
    end if
  end sub

  override sub onInput(input as BGE.GameInput)
    if m.game.isTransitioning()
      return
    end if
    ' Raw button: gamepad B is aliased to back but must not quit.
    if input.press and LCase(input.button) = "back"
      m.game.End()
    end if
  end sub

  ' The engine calls this, not onDestroy(), when the game leaves a scene.
  override sub onChangeScene(newScene as BGE.GameScene)
    super.onChangeScene(newScene)
    m.removeUi()
  end sub

  override sub onDestroy()
    m.removeUi()
  end sub

  ' Takes the widgets out of gameUi, so the menu's buttons stop taking focus.
  private sub removeUi()
    for each widget in [m.backdrop, m.menu]
      if widget <> invalid
        m.game.gameUi.removeChild(widget)
      end if
    end for
    m.backdrop = invalid
    m.menu = invalid
    for each label in m.labels
      m.game.gameUi.removeChild(label)
    end for
    m.labels = []
  end sub

end class
