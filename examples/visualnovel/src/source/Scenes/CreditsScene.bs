import "pkg:/source/engine/GameScene.bs"
import "pkg:/source/engine/ui/Label.bs"
import "pkg:/source/engine/ui/UiContainer.bs"
import "pkg:/source/engine/ui/CreditsView.bs"
import "../Novel/Characters.bs"
import "../UI/Backdrop.bs"

const CREDITS_PANEL_RGBA = &h050B12E0
const CREDITS_HEADING_RGBA = &h5FE0D0FF
const CREDITS_HINT_RGBA = &hA0AEBEFF
const CREDITS_PADDING = 24
' Space above each heading after the first
const CREDITS_HEADING_GAP = 10

' Who made what, over the title's backdrop. Back or OK returns to the title.
class CreditsScene extends BGE.GameScene

  private backdrop as Backdrop = invalid
  private panel as BGE.UI.UiContainer = invalid
  private credits as BGE.UI.CreditsView = invalid

  sub new(game as BGE.Game)
    super(game)
    m.name = "CreditsScene"
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    name = backgroundBitmapName("centaurBridge")
    if not m.game.Bitmaps.DoesExist(name)
      loader.loadBitmap(name, "pkg:/images/bg/centaurBridge.jpg")
    end if
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.backdrop = new Backdrop(m.game)
    m.backdrop.setBackground("centaurBridge")
    m.addUi(m.backdrop)

    ' The panel fills the title-safe area.
    m.panel = new BGE.UI.UiContainer(m.game)
    m.panel.customPosition = true
    m.panel.customX = 128
    m.panel.customY = 72
    m.panel.width = 1024
    m.panel.height = 576
    m.panel.showBackground = true
    m.panel.backgroundRGBA = CREDITS_PANEL_RGBA
    m.addUi(m.panel)

    ' The text is a static CreditsView inset by the padding, headings in capitals.
    entries = [] as BGE.UI.CreditsEntry[]
    for each entry in creditsEntries()
      style = "body"
      text = entry.text
      if entry.heading
        style = "heading"
        text = UCase(text)
      end if
      entries.push({text: text, style: style})
    end for
    m.credits = new BGE.UI.CreditsView(m.game, entries)
    m.credits.mode = "static"
    m.credits.textAlign = "left"
    m.credits.headingGap = CREDITS_HEADING_GAP
    m.credits.styleColors = {"heading": CREDITS_HEADING_RGBA, "body": &hFFFFFFFF}
    m.credits.styleFonts = {"heading": "default", "body": "default"}
    m.credits.customPosition = true
    m.credits.customX = CREDITS_PADDING
    m.credits.customY = CREDITS_PADDING
    m.credits.width = m.panel.width - CREDITS_PADDING * 2
    m.credits.height = m.panel.height - CREDITS_PADDING * 2
    m.panel.addChild(m.credits)

    ' The hint goes top right, beside the title.
    font = m.game.getFont("default")
    hint = UCase("Back to return")
    hintLabel = new BGE.UI.Label(m.game)
    hintLabel.customPosition = true
    hintLabel.customX = m.panel.width - CREDITS_PADDING - font.GetOneLineWidth(hint, m.panel.width)
    hintLabel.customY = CREDITS_PADDING
    hintLabel.drawableText.textColor = CREDITS_HINT_RGBA
    hintLabel.setText(hint)
    m.panel.addChild(hintLabel)
  end sub

  override sub onInput(input as BGE.GameInput)
    if not input.press or m.game.isTransitioning()
      return
    end if
    ' Remote Back, gamepad B (aliased to back) or OK
    if input.isButton("back") or input.isButton("ok")
      m.game.changeSceneWithFade("TitleScene", {})
    end if
  end sub

end class

interface CreditEntry
  text as string
  heading as boolean
end interface

' The credits, in order. Headings are shown in capitals. Details are in images/CREDITS.md.
function creditsEntries() as CreditEntry[]
  return [
    {text: "The Mutiny", heading: true}
    {text: "Story and code: Mark Pearce with Claude", heading: false}
    {text: "Art", heading: true}
    {text: "From OpenGameArt.org, resized and cropped:", heading: false}
    {text: "Portraits: Justin Nichol (CC-BY-SA 3.0)", heading: false}
    {text: "Ship bridges and lab: Tuomo Untinen (CC-BY-SA 3.0)", heading: false}
    {text: "Civilian spaceship: bull-1 (CC-BY-SA 4.0)", heading: false}
    {text: "Music", heading: true}
    {text: "Drifting Through the Nebula (Ambient): HitCtrl (CC-BY 3.0)", heading: false}
    {text: "Font", heading: true}
    {text: "Audiowide: Brian J. Bonislawsky, Astigmatic (SIL OFL 1.1)", heading: false}
    {text: "Built with the BrighterScript Game Engine", heading: true}
  ]
end function
