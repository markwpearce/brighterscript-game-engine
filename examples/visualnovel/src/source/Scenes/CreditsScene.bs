import "pkg:/source/engine/GameScene.bs"
import "pkg:/source/engine/ui/Label.bs"
import "pkg:/source/engine/ui/UiContainer.bs"
import "pkg:/source/engine/ui/TextWrap.bs"
import "../Novel/Characters.bs"
import "../UI/Backdrop.bs"

const CREDITS_PANEL_RGBA = &h050B12E0
const CREDITS_HEADING_RGBA = &h5FE0D0FF
const CREDITS_HINT_RGBA = &hA0AEBEFF
const CREDITS_PADDING = 24
' Space above each heading after the first
const CREDITS_HEADING_GAP = 10

' Who made what, over the title's backdrop. Back or OK returns to the title.
class CreditsScene extends BGE.GameScene

  private backdrop as Backdrop = invalid
  private panel as BGE.UI.UiContainer = invalid

  sub new(game as BGE.Game)
    super(game)
    m.name = "CreditsScene"
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    name = backgroundBitmapName("centaurBridge")
    if not m.game.Bitmaps.DoesExist(name)
      loader.loadBitmap(name, "pkg:/images/bg/centaurBridge.jpg")
    end if
  end sub

  override sub onCreate(args as roAssociativeArray)
    m.backdrop = new Backdrop(m.game)
    m.backdrop.setBackground("centaurBridge")
    m.game.gameUi.addChild(m.backdrop)

    ' The panel fills the title-safe area.
    m.panel = new BGE.UI.UiContainer(m.game)
    m.panel.customPosition = true
    m.panel.customX = 128
    m.panel.customY = 72
    m.panel.width = 1024
    m.panel.height = 576
    m.panel.showBackground = true
    m.panel.backgroundRGBA = CREDITS_PANEL_RGBA
    m.game.gameUi.addChild(m.panel)

    font = m.game.defaultTheme.font
    lineHeight = font.GetOneLineHeight()
    y = CREDITS_PADDING
    for each entry in creditsEntries()
      text = entry.text
      color = &hFFFFFFFF
      if entry.heading
        text = UCase(text)
        color = CREDITS_HEADING_RGBA
        if y > CREDITS_PADDING
          y += CREDITS_HEADING_GAP
        end if
      end if
      for each line in BGE.UI.wrapText(text, font, m.panel.width - CREDITS_PADDING * 2)
        m.addLabel(line, y, color)
        y += lineHeight
      end for
    end for
    ' The hint goes top right, beside the title.
    hint = UCase("Back to return")
    m.addLabel(hint, CREDITS_PADDING, CREDITS_HINT_RGBA, m.panel.width - CREDITS_PADDING - font.GetOneLineWidth(hint, m.panel.width))
  end sub

  private sub addLabel(text as string, y as float, color as integer, x = CREDITS_PADDING as float)
    label = new BGE.UI.Label(m.game)
    label.customPosition = true
    label.customX = x
    label.customY = y
    label.drawableText.textColor = color
    label.setText(text)
    m.panel.addChild(label)
  end sub

  override sub onInput(input as BGE.GameInput)
    if not input.press or m.game.isTransitioning()
      return
    end if
    ' Remote Back, gamepad B (aliased to back) or OK
    if input.isButton("back") or input.isButton("ok")
      m.game.changeSceneWithFade("TitleScene", {})
    end if
  end sub

  ' The engine calls this, not onDestroy(), when the game leaves a scene.
  override sub onChangeScene(newScene as BGE.GameScene)
    super.onChangeScene(newScene)
    m.removeUi()
  end sub

  override sub onDestroy()
    m.removeUi()
  end sub

  private sub removeUi()
    for each widget in [m.panel, m.backdrop]
      if widget <> invalid
        m.game.gameUi.removeChild(widget)
      end if
    end for
    m.panel = invalid
    m.backdrop = invalid
  end sub

end class

' The credits, in order. Headings are shown in capitals. Art details are in images/CREDITS.md.
function creditsEntries() as roAssociativeArray[]
  return [
    {text: "The Mutiny", heading: true}
    {text: "Story and code: Mark Pearce with Claude", heading: false}
    {text: "Portraits", heading: true}
    {text: "Husk, Sato, Castell: Justin Nichol (CC-BY-SA 3.0 or GPL 3.0)", heading: false}
    {text: "Voss: Justin Nichol (CC-BY-SA 3.0)", heading: false}
    {text: "Backgrounds", heading: true}
    {text: "Greyan bridge: Tuomo Untinen (CC-BY-SA 3.0)", heading: false}
    {text: "Research lab: Tuomo Untinen (CC-BY-SA 3.0)", heading: false}
    {text: "Centaur bridge: Tuomo Untinen (CC-BY or CC-BY-SA, 3.0 or 4.0)", heading: false}
    {text: "Art from OpenGameArt.org, resized and cropped.", heading: false}
    {text: "Font", heading: true}
    {text: "Audiowide: Brian J. Bonislawsky, Astigmatic (SIL OFL 1.1)", heading: false}
    {text: "Built with the BrighterScript Game Engine", heading: true}
  ]
end function
