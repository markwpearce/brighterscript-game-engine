import "pkg:/source/engine/GameScene.bs"
import "pkg:/source/utils/SaveSlot.bs"
import "pkg:/source/story/ValueKinds.bs"
import "pkg:/source/story/StorySession.bs"
import "pkg:/source/story/DebugState.bs"
import "pkg:/source/story/StoryLoader.bs"
import "../Novel/Characters.bs"
import "../Novel/VnSave.bs"
import "../UI/Backdrop.bs"
import "../UI/PortraitCard.bs"
import "../UI/TextBox.bs"
import "../UI/ChoiceList.bs"
import "../UI/BacklogPanel.bs"
import "pkg:/source/engine/ui/Button.bs"

' Plays mutiny.json: lines in the text box, choices above it, portraits and backgrounds from each
' line's background/left/right keys. OK reads on, * or Up opens the backlog, Back returns to the title.
'
' changeScene args: {continue: true} resumes the save, {node, flags, items} starts at a node with
' saving off (deep links; flags/items as BGE.Story.applyDebugState() takes them), {} starts a new
' game.
class StageScene extends BGE.GameScene

  ' Both off on deep links (a node given), so testing never touches the real save or endings.
  private slot as BGE.SaveSlot = invalid
  private endings as BGE.SaveProfile = invalid
  ' Settles each step and hands back what it posted (endings). Made per visit, not added to the
  ' game: nothing outside the scene needs it.
  private session as BGE.Story.StorySession = invalid
  ' Aliases of the session's.
  private state as BGE.Story.StoryState = invalid
  private runner as BGE.Story.DialogueRunner = invalid
  private stage as VnStage = invalid
  private backdrop as Backdrop = invalid
  private leftCard as PortraitCard = invalid
  private rightCard as PortraitCard = invalid
  private textBox as TextBox = invalid
  private choiceList as ChoiceList = invalid
  private backlog as BacklogPanel = invalid
  ' Set when a line's choices should show: they appear on the next onUpdate() (see refresh()).
  private choicesDue as boolean = false
  ' True from showing a line until its typing finishes, to show any choices that follow it.
  private lineTyping as boolean = false
  private ended as boolean = false

  sub new(game as BGE.Game)
    super(game)
    m.name = "StageScene"
  end sub

  override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    for each id in getBackgroundIds()
      m.loadSceneBitmap(loader, backgroundBitmapName(id), "pkg:/images/bg/" + id + ".jpg", {}, true)
    end for
    for each id in getPortraitIds()
      m.loadSceneBitmap(loader, portraitBitmapName(id), "pkg:/images/portraits/" + id + ".webp", {}, true)
    end for
  end sub

  override sub onCreate(args as roAssociativeArray)
    story = BGE.Story.loadStory("pkg:/story/mutiny.json")
    if story = invalid
      ' loadStory has said why; the stage shows The End
      story = {nodes: {}} as BGE.Story.StoryData
    end if
    m.session = new BGE.Story.StorySession(m.game, story, {name: "mutinySession"})
    m.state = m.session.state
    m.runner = m.session.runner
    m.stage = {background: "", left: "", right: ""}
    m.ended = false
    m.backlog = invalid
    m.lineTyping = false
    m.choicesDue = false
    m.buildUi()
    savingOn = BGE.Story.valueKind(args.node) <> "string"
    m.slot = newVnSlot()
    m.slot.enabled = savingOn
    m.endings = openVnProfile(savingOn)
    resumed = false
    if BGE.Story.isTrue(args.continue)
      save = m.slot.read(validateVnSave) as VnSave
      resumed = applyVnSave(save, m.state, m.runner)
      if resumed
        m.stage = save.stage
        m.showLastLineForChoices()
      end if
    end if
    if not resumed
      startNode = "start"
      if not savingOn
        startNode = args.node
        ' args["items"]: args.items would read as AA.Items()
        BGE.Story.applyDebugState(m.state, args.flags, args["items"])
      end if
      m.recordEndings(m.session.start(startNode))
    end if
    m.refresh()
  end sub

  ' Everything is added for this visit only (addUi), so it all goes when the game leaves the scene.
  private sub buildUi()
    m.backdrop = new Backdrop(m.game)
    m.addUi(m.backdrop)
    m.leftCard = new PortraitCard(m.game, "left")
    m.addUi(m.leftCard)
    m.rightCard = new PortraitCard(m.game, "right")
    m.addUi(m.rightCard)
    m.textBox = new TextBox(m.game)
    m.addUi(m.textBox)
    ' Opens itself with addUi() when there are choices to show.
    m.choiceList = new ChoiceList(m.game)
  end sub

  ' Resuming at a choice: show the line the choices followed.
  private sub showLastLineForChoices()
    if not m.runner.isChoosing()
      return
    end if
    for i = m.runner.backlog.count() - 1 to 0 step -1
      entry = m.runner.backlog[i]
      if not entry.isChoice
        m.textBox.showLine(entry.speaker, entry.text)
        m.textBox.finishTyping()
        m.applyStage(entry.speaker)
        return
      end if
    end for
    m.applyStage("")
  end sub

  override sub onInput(input as BGE.GameInput)
    if not input.press or m.game.isTransitioning()
      return
    end if
    if m.backlog <> invalid
      if input.isButton("up")
        m.backlog.scroll(-1)
      else if input.isButton("down")
        m.backlog.scroll(1)
      else if input.isButton("back") or input.isButton("ok") or input.isButton("options")
        m.closeBacklog()
      end if
      input.consume()
      return
    end if
    reading = m.runner.isActive() and not m.runner.isChoosing()
    if input.isButton("options") or (reading and input.isButton("up"))
      m.openBacklog()
      input.consume()
    else if input.isRemoteBack()
      ' Only the remote's Back quits; gamepad B is aliased to back but doesn't leave the stage.
      m.game.changeSceneWithFade("TitleScene", {})
    else if input.isButton("ok") and m.ended
      m.game.changeSceneWithFade("TitleScene", {})
    else if input.isButton("ok") and reading
      if m.textBox.isTyping()
        m.textBox.finishTyping()
      else
        m.recordEndings(m.session.advance())
        m.refresh()
      end if
    end if
  end sub

  override sub onUpdate(deltaTime as float)
    ' The text box may finish typing behind the backlog; its choices wait until the backlog closes.
    if m.backlog <> invalid or m.textBox = invalid or m.game.isTransitioning()
      return
    end if
    if m.lineTyping and not m.textBox.isTyping()
      m.lineTyping = false
      if m.runner.choicesFollow()
        ' The whole line is showing: bring its choices up under it.
        m.recordEndings(m.session.advance())
        m.refresh()
      end if
    end if
    if m.choicesDue
      m.choicesDue = false
      ' Ignore the buttons held now until released, so the OK that ended the line can't click a choice.
      m.game.suppressInputUntilRelease()
      m.choiceList.show(m.runner.choices(), m)
    end if
  end sub

  ' Called by a choice button; its value is the index into runner.choices().
  sub onUiAction(actionId as string, button as BGE.UI.Button)
    if m.game.isTransitioning()
      return
    end if
    index = button.value
    m.choiceList.clear()
    m.recordEndings(m.session.choose(index))
    m.refresh()
  end sub

  ' Records any endings a step reached (the profile ignores them on deep-link runs).
  '
  ' @param {BGE.Story.StoryResult} result - from the session, so already settled
  private sub recordEndings(result as BGE.Story.StoryResult)
    for each eventName in result.posts
      if Left(eventName, 7) = "ending:"
        m.endings.addToSet("endings", Mid(eventName, 8))
      end if
    end for
  end sub

  ' Shows whatever the runner is at now (a line, the choices, or the end) and autosaves.
  private sub refresh()
    if not m.runner.isActive()
      m.ended = true
      m.lineTyping = false
      m.choicesDue = false
      m.choiceList.clear()
      m.textBox.showLine("", "The End. Press OK to return to the title.")
      m.textBox.finishTyping()
      m.leftCard.setPortrait("")
      m.rightCard.setPortrait("")
      m.slot.delete()
      return
    end if
    if m.runner.isChoosing()
      ' The line the choices follow stays in the text box.
      m.choicesDue = true
    else
      line = m.runner.currentLine()
      m.updateStage(line)
      m.textBox.showLine(line.speaker, line.text)
      m.lineTyping = true
    end if
    m.save()
  end sub

  private sub updateStage(line as BGE.Story.StoryLineView)
    for each key in ["background", "left", "right"]
      if BGE.Story.valueKind(line.line[key]) = "string"
        m.stage[key] = line.line[key]
      end if
    end for
    m.applyStage(line.speaker)
  end sub

  ' Shows m.stage, lighting the speaker's card (both lit for narration).
  private sub applyStage(speaker as string)
    m.backdrop.setBackground(m.stage.background)
    m.leftCard.setPortrait(m.stage.left)
    m.rightCard.setPortrait(m.stage.right)
    speaking = portraitForSpeaker(speaker)
    m.leftCard.lit = speaking = "" or speaking = m.stage.left
    m.rightCard.lit = speaking = "" or speaking = m.stage.right
  end sub

  private sub save()
    data = buildVnSave(m.state, m.runner, m.stage)
    if data <> invalid
      m.slot.write(data)
    end if
  end sub

  private sub openBacklog()
    if m.runner.isChoosing()
      ' The focus manager sees input before the scene, so hide the buttons or OK/Up/Down would reach them.
      m.choiceList.clear()
      m.choicesDue = false
    end if
    m.backlog = new BacklogPanel(m.game, m.runner.backlog)
    m.addUi(m.backlog)
  end sub

  private sub closeBacklog()
    m.removeUi(m.backlog)
    m.backlog = invalid
    if m.runner.isChoosing()
      m.choicesDue = true
    end if
  end sub

end class
