import "pkg:/source/engine/ui/MenuList.bs"
import "pkg:/source/engine/ui/UiActionListener.bs"
import "pkg:/source/story/StoryTypes.bs"

const CHOICE_W = 720.0
const CHOICE_H = 52.0
const CHOICE_GAP = 10.0
' Bottom of the list sits just above the text box.
const CHOICE_BOTTOM = 470.0

' The choices, stacked and centred above the text box, with no panel behind them. Picking one
' calls listener.onUiAction("choice", button), with the choice's index in button.value.
' Disabled choices are drawn dimmed and can't be focused or picked.
class ChoiceList extends BGE.UI.MenuList

  sub new(game as BGE.Game)
    super(game)
    m.showBackground = false
    m.panelPadding = 0
    m.itemHeight = CHOICE_H
    m.itemGap = CHOICE_GAP
    m.setSize(CHOICE_W, 0)
    m.customX = (game.uiCanvas.getWidth() - CHOICE_W) / 2
  end sub

  ' Opens the list (owned by the current scene) with one button per view, focusing the first
  ' enabled one.
  sub show(views as BGE.Story.ChoiceView[], listener as BGE.UI.UiActionListener)
    m.clearItems()
    for i = 0 to views.count() - 1
      m.addItem("choice", UCase(views[i].label), views[i].enabled, i)
    end for
    m.listener = listener
    m.open()
  end sub

  ' Bottom-aligned at CHOICE_BOTTOM, however many items there are.
  override sub open(parent = invalid as BGE.UI.UiContainer)
    m.customY = CHOICE_BOTTOM - m.items.count() * (CHOICE_H + CHOICE_GAP)
    super.open(parent)
  end sub

  sub clear()
    m.close()
  end sub

end class
