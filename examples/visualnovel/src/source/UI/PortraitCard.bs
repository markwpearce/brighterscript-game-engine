import "pkg:/source/engine/ui/UiWidget.bs"
import "../Novel/Characters.bs"

const PORTRAIT_W = 360
const PORTRAIT_H = 480
const PORTRAIT_FRAME_RGB = &hC8D6E5
const PORTRAIT_FRAME_WIDTH = 4
' Alpha of the dim overlay on a card whose character isn't speaking
const PORTRAIT_DIM_ALPHA = &h99
' A new portrait slides in from the card's outer edge while fading in.
const PORTRAIT_APPEAR_SECONDS = 0.3
const PORTRAIT_SLIDE_PX = 48

' A framed portrait on the left or right. The speaker's card is lit; the other is dimmed.
' Portraits are mirrored where needed so both characters face the middle of the screen.
class PortraitCard extends BGE.UI.UiWidget

  portraitId as string = ""
  lit as boolean = true
  side as string = "left"
  ' -1 = not appearing; otherwise seconds into the slide-in
  private appearTime as float = -1

  ' @param {string} side - "left" or "right"
  sub new(game as BGE.Game, side as string)
    super(game)
    m.side = side
    m.customPosition = true
    uiW = game.uiCanvas.getWidth()
    m.customY = 76
    if side = "left"
      m.customX = 132
    else
      m.customX = uiW - 132 - PORTRAIT_W
    end if
    m.width = PORTRAIT_W
    m.height = PORTRAIT_H
  end sub

  sub setPortrait(id as string)
    if id <> "" and id <> m.portraitId
      m.appearTime = 0
    end if
    m.portraitId = id
  end sub

  override sub onUpdate(deltaTime as float)
    if m.appearTime < 0
      return
    end if
    ' A slow frame (loading the scene) mustn't skip the slide.
    if deltaTime > 1 / 30
      deltaTime = 1 / 30
    end if
    m.appearTime += deltaTime
    if m.appearTime >= PORTRAIT_APPEAR_SECONDS
      m.appearTime = -1
    end if
  end sub

  ' 0 -> 1 across the slide-in, eased out (cubic)
  private function appearProgress() as float
    if m.appearTime < 0
      return 1
    end if
    t = 1 - m.appearTime / PORTRAIT_APPEAR_SECONDS
    return 1 - t * t * t
  end function

  override sub draw(parent = invalid as BGE.UI.UiWidget)
    if m.portraitId = ""
      return
    end if
    art = m.getArt()
    if art = invalid
      return
    end if
    progress = m.appearProgress()
    alpha = Int(progress * 255)
    if alpha <= 0
      return
    end if
    slide = Int((1 - progress) * PORTRAIT_SLIDE_PX)
    if m.side = "left"
      slide = -slide
    end if
    x = m.position.x + slide
    y = m.position.y
    renderer = m.canvas.renderer
    ' The frame is a border, not a filled rectangle, so it doesn't show through a fading portrait.
    frameRGBA = (PORTRAIT_FRAME_RGB << 8) + alpha
    fw = PORTRAIT_FRAME_WIDTH
    renderer.drawRectangle(x - fw, y - fw, PORTRAIT_W + fw * 2, fw, frameRGBA)
    renderer.drawRectangle(x - fw, y + PORTRAIT_H, PORTRAIT_W + fw * 2, fw, frameRGBA)
    renderer.drawRectangle(x - fw, y, fw, PORTRAIT_H, frameRGBA)
    renderer.drawRectangle(x + PORTRAIT_W, y, fw, PORTRAIT_H, frameRGBA)
    renderer.drawScaledObject(x, y, PORTRAIT_W / (art.GetWidth() * 1.0), PORTRAIT_H / (art.GetHeight() * 1.0), art, &hFFFFFF00 + alpha)
    if not m.lit
      renderer.drawRectangle(x - fw, y - fw, PORTRAIT_W + fw * 2, PORTRAIT_H + fw * 2, Int(PORTRAIT_DIM_ALPHA * progress))
    end if
  end sub

  ' The portrait's bitmap, mirrored if its art faces away from the middle.
  private function getArt() as roBitmap
    if not shouldMirrorPortrait(m.portraitId, m.side)
      return m.game.getBitmap(portraitBitmapName(m.portraitId))
    end if
    name = mirroredPortraitBitmapName(m.portraitId)
    ' Bitmaps, not getBitmap(), which warns for a name not built yet.
    mirrored = m.game.Bitmaps[name]
    if mirrored = invalid
      mirrored = buildMirroredBitmap(m.game.getBitmap(portraitBitmapName(m.portraitId)))
      ' Kept in the game's bitmaps, so both cards share one copy.
      m.game.Bitmaps[name] = mirrored
    end if
    return mirrored
  end function

end class

' A left-right mirrored copy of a bitmap, built once rather than drawn at a negative scale each
' frame. Real Roku hardware mirrors a DrawScaledObject at scale -1 (no rotation) correctly.
function buildMirroredBitmap(source as roBitmap) as roBitmap
  if source = invalid
    return invalid
  end if
  width = source.GetWidth()
  mirrored = CreateObject("roBitmap", {width: width, height: source.GetHeight(), AlphaEnable: false})
  if mirrored = invalid
    return invalid
  end if
  mirrored.Clear(&h000000FF)
  mirrored.DrawScaledObject(width, 0, -1, 1, source)
  return mirrored
end function
