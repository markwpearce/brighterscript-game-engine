import "pkg:/source/engine/ui/Label.bs"

' A label in its own font instead of the theme's.
class FontLabel extends BGE.UI.Label

  sub new(game as BGE.Game, font as roFont)
    super(game)
    m.drawableText.setFont(font)
  end sub

  ' Keeps this label's font rather than taking the theme's.
  protected override sub applyThemeFont(theme as BGE.UI.Theme, drawableText as BGE.DrawableText)
  end sub

end class
