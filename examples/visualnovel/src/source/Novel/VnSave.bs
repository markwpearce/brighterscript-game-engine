' examples/visualnovel/src/source/Novel/VnSave.bs
import "pkg:/source/utils/registry.bs"
import "pkg:/source/utils/SaveSlot.bs"
import "pkg:/source/story/StoryState.bs"
import "pkg:/source/story/DialogueRunner.bs"

const VN_SAVE_VERSION = 1
const VN_SAVE_SECTION = "bge-visualnovel"
const VN_SAVE_KEY = "save"
const VN_ENDING_COUNT = 3

' What's on screen: background and portrait ids ("" for none).
interface VnStage
  background as string
  left as string
  right as string
end interface

interface VnSave extends roAssociativeArray
  state as BGE.Story.StorySaveData
  position as BGE.Story.RunnerPosition
  ' {text, speaker, isChoice} per entry
  backlog as roAssociativeArray[]
  stage as VnStage
end interface

' The save slot. Saves from before SaveSlot were the payload itself, with its own version field;
' SaveSlot hands them to migrate() as version 0, and one at this version loads unchanged.
class VnSaveSlot extends BGE.SaveSlot

  sub new()
    super(VN_SAVE_SECTION, VN_SAVE_KEY, VN_SAVE_VERSION)
  end sub

  override function migrate(fromVersion as integer, data as dynamic) as dynamic
    if fromVersion = 0 and type(data) = "roAssociativeArray" and BGE.isIntegerValue(data.version)
      if data.version = VN_SAVE_VERSION
        return data
      end if
    end if
    return invalid
  end function

end class

' @return {BGE.SaveSlot}
function newVnSlot() as BGE.SaveSlot
  return new VnSaveSlot()
end function

' The endings found, kept apart from the save so they outlast it. Endings the old "endings" key
' held are moved in (once) when the profile is opened with saving on.
'
' @param {boolean} enabled - false on deep links, which don't record endings
' @return {BGE.SaveProfile}
function openVnProfile(enabled as boolean) as BGE.SaveProfile
  profile = new BGE.SaveProfile(VN_SAVE_SECTION)
  profile.enabled = enabled
  if enabled
    legacy = BGE.registryRead(VN_SAVE_SECTION, "endings")
    if type(legacy) = "roAssociativeArray"
      merged = profile.get("endings")
      if type(merged) <> "roAssociativeArray"
        merged = {}
      end if
      merged.Append(legacy)
      ' only drop the old key once the profile has them, or they'd be lost
      if profile.set("endings", merged)
        BGE.registryDelete(VN_SAVE_SECTION, "endings")
      end if
    end if
  end if
  return profile
end function

' @return {VnSave} or invalid if there's nothing to resume (no conversation, or a one-off node)
function buildVnSave(state as BGE.Story.StoryState, runner as BGE.Story.DialogueRunner, stage as VnStage) as VnSave
  position = runner.getPosition()
  if position = invalid
    return invalid
  end if
  return {
    state: state.toSaveData(),
    position: position,
    backlog: backlogToSave(runner.backlog),
    stage: {background: stage.background, left: stage.left, right: stage.right}
  }
end function

' Checks a save's payload (what SaveSlot read() returned). The version is checked by the slot.
'
' @return {VnSave} the save if it has the right shape, else invalid
function validateVnSave(data as dynamic) as VnSave
  if type(data) <> "roAssociativeArray"
    return invalid
  end if
  if type(data.state) <> "roAssociativeArray" or type(data.position) <> "roAssociativeArray" or type(data.stage) <> "roAssociativeArray"
    return invalid
  end if
  for each key in ["background", "left", "right"]
    if BGE.Story.valueKind(data.stage[key]) <> "string"
      data.stage[key] = ""
    end if
  end for
  return data
end function

' Loads a save into the state and runner.
'
' @return {boolean} false if the saved position doesn't fit the story any more - start over
function applyVnSave(save as VnSave, state as BGE.Story.StoryState, runner as BGE.Story.DialogueRunner) as boolean
  if save = invalid
    return false
  end if
  state.loadSaveData(save.state)
  if not runner.restore(save.position)
    state.reset()
    return false
  end if
  runner.backlog = backlogFromSave(save.backlog)
  return true
end function

function backlogToSave(backlog as BGE.Story.StoryLineView[]) as roAssociativeArray[]
  entries = [] as roAssociativeArray[]
  for each view in backlog
    entries.push({text: view.text, speaker: view.speaker, isChoice: view.isChoice})
  end for
  return entries
end function

function backlogFromSave(data as dynamic) as BGE.Story.StoryLineView[]
  views = [] as BGE.Story.StoryLineView[]
  if type(data) <> "roArray"
    return views
  end if
  for each entry in data
    if type(entry) = "roAssociativeArray"
      if BGE.Story.valueKind(entry.text) = "string" and BGE.Story.valueKind(entry.speaker) = "string"
        views.push({text: entry.text, speaker: entry.speaker, line: {text: entry.text}, isChoice: BGE.Story.isTrue(entry.isChoice)})
      end if
    end if
  end for
  return views
end function

' @param {integer} count - endings found so far
' @return {string} "Endings found: n of 3", or "" before the first
function endingsSeenText(count as integer) as string
  if count = 0
    return ""
  end if
  return "Endings found: " + count.toStr() + " of " + VN_ENDING_COUNT.toStr()
end function
