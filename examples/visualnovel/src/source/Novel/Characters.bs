' Who's who: speaker names in mutiny.json -> portrait ids, and ids -> bitmap names.

function portraitForSpeaker(speaker as string) as string
  map = {"Husk": "husk", "Dr. Voss": "voss", "Chief Castell": "castell", "Lt. Sato": "sato"}
  if map.DoesExist(speaker)
    return map[speaker]
  end if
  return ""
end function

function backgroundBitmapName(id as string) as string
  return "bg_" + id
end function

function portraitBitmapName(id as string) as string
  return "portrait_" + id
end function

' Every background and portrait id, for loading.
function getBackgroundIds() as string[]
  return ["centaurBridge", "greyanBridge", "lab"]
end function

function getPortraitIds() as string[]
  return ["husk", "voss", "castell", "sato"]
end function

' Which way each portrait's art faces: "left", "right" or "front" (never mirrored).
function portraitFacing(id as string) as string
  ' Castell's head is turned to the left; Sato and Voss turn to the right; Husk faces front.
  map = {"husk": "front", "voss": "right", "castell": "left", "sato": "right"}
  if map.DoesExist(id)
    return map[id]
  end if
  return "front"
end function

' True when a portrait on this side ("left" or "right") must be mirrored to face the middle.
function shouldMirrorPortrait(id as string, side as string) as boolean
  facing = portraitFacing(id)
  return (side = "left" and facing = "left") or (side = "right" and facing = "right")
end function

function mirroredPortraitBitmapName(id as string) as string
  return portraitBitmapName(id) + "_mirrored"
end function
