import "Scenes/TitleScene.bs"
import "Scenes/StageScene.bs"
import "Scenes/CreditsScene.bs"
import "pkg:/source/story/ValueKinds.bs"

' The Mutiny. Deep link to a node for testing (saving off), e.g.
'   rokubot launch dev --param node=confrontation --param items=relayTap,navLog,accessRecord
sub Main(args = {} as roAssociativeArray)
  ' UI size passed too, or a 1080p device gets a 1920x1080 UI canvas and the layout draws shrunk.
  game = new BGE.Game(1280, 720, 1280, 720)
  game.fitCanvasToScreen()
  game.enableControllerInput()
  game.controls.bindAxis("move", "1", 0, "Move")
  ' The left stick steps focus through choices, like the d-pad.
  game.focusManager.analogAxisName = "move"
  game.focusManager.analogListRepeatDelay = 0.3

  ' The default Button focus is white text on light grey; use a dark palette with a clear focus fill.
  game.defaultTheme.backgroundColor = &h102030E6
  game.defaultTheme.hoveredBackgroundColor = &h1F6F78FF
  game.defaultTheme.foregroundColor = &hFFFFFFFF
  game.defaultTheme.focusedBorderColor = &h5FE0D0FF
  ' Labels, buttons and the text box's wrapping all use the theme font.
  game.registerFont("pkg:/fonts/Audiowide-Regular.ttf")
  game.loadFont("vn", "Audiowide", 26, false, false)
  game.defaultTheme.font = game.getFont("vn")
  ' The title screen's big title
  game.loadFont("vnTitle", "Audiowide", 96, false, false)

  ' Shown while StageScene loads its art, so New Game doesn't sit on a black screen.
  loading = new BGE.DefaultLoadingScreen(game.defaultTheme.font)
  loading.showAfterSeconds = 0.1
  loading.backgroundColor = &h0B1726FF
  loading.barBackgroundColor = &h2A3F55FF
  loading.barColor = &h5FE0D0FF
  loading.label = UCase("Loading...")
  game.loadingScreen = loading

  title = new TitleScene(game)
  game.defineScene(title)
  stage = new StageScene(game)
  game.defineScene(stage)
  credits = new CreditsScene(game)
  game.defineScene(credits)

  if args["node"] <> invalid
    game.changeSceneWithFade("StageScene", {node: args["node"], flags: splitList(args["flags"]), items: itemCounts(args["items"])})
  else
    game.changeSceneWithFade("TitleScene", {})
  end if
  game.play()
end sub

function splitList(text as dynamic) as string[]
  names = [] as string[]
  if BGE.Story.valueKind(text) <> "string"
    return names
  end if
  for each part in (text as string).Split(",")
    if part.Trim() <> ""
      names.push(part.Trim())
    end if
  end for
  return names
end function

' "a,b" -> {a: 1, b: 1}; StageScene adds one of each
function itemCounts(text as dynamic) as roAssociativeArray
  counts = {}
  for each name in splitList(text)
    counts[name] = 1
  end for
  return counts
end function
