{
    "rootDir": "src",
    "outDir": "./build",
    "retainStagingDir": true,
    "compilerOptions": {
        "sourceMap": true,
        "autoImportComponentScript": true,
        "emitDefinitions": true
    },
    "plugins": [
        "@rokucommunity/bslint"
    ],
    "diagnosticFilters": [
        {
            "files": "**/roku_modules/**"
        },
        {
            "files": "**/ropmConsumerFixture/**/*.*"
        },
        {
            "files": "**/*.spec.bs",
            "codes": [
                "function-name-too-long"
            ]
        }
    ]
}