import "StoryTypes.bs"
import "StorySession.bs"
import "DialogueRunner.bs"
import "../engine/Game.bs"
import "../engine/GameInput.bs"
import "../engine/ui/UiContainer.bs"
import "../engine/ui/Label.bs"
import "../engine/ui/Button.bs"
import "../engine/ui/TextWrap.bs"
import "../engine/ui/Theme.bs"
import "../math/math.bs"
import "../utils/strings.bs"
import "../engine/GameScene.bs"

namespace BGE.Story

  ' A dialogue box for a BGE.Story.StorySession: the speaker's name, the current line wrapped
  ' and split into pages, and the choices as buttons (disabled ones dimmed).
  '  - OK turns the page, then moves the conversation on. Up/down move between choices and
  '    OK picks one. Back leaves (`closeOnBack`).
  '  - It takes all input while it's open, opens a modal (Game.pushModal()) unless `modal`
  '    is false, and closes itself when the conversation ends.
  '  - Steps go through the session, so posts, messages and saving all happen there.
  '
  ' Colors come from the theme (panelBackgroundColor/Image, panelTitleColor for the speaker,
  ' panelTextColor), fonts from `speakerFontName`/`textFontName`. It sits along the bottom of
  ' the title-safe area unless you set customX/customY/width. Override onLine() and onEnded()
  ' (or set `listener`), createChoiceButton() and layoutChoices() to customize.
  '
  ' @example
  ' view = new BGE.Story.DialogueView(game, session)
  ' view.start("bram") ' opens if the node has something to say
  class DialogueView extends BGE.UI.UiContainer

    session as BGE.Story.StorySession
    ' Wrapped lines shown at once.
    linesPerPage as integer = 3
    boxPadding as float = 32.0
    ' Space between the speaker and the text.
    speakerGap as float = 8.0
    speakerFontName as string = "body"
    textFontName as string = "body"
    ' Shown in the bottom right while there's another page.
    moreText as string = "..."
    ' "column": stacked above the box. "row": side by side along the bottom of the box.
    choiceLayout as string = "column"
    choiceHeight as float = 52.0
    choiceGap as float = 10.0
    ' Column choices' width; 0 = 60% of the box.
    choiceWidth as float = 0.0
    ' List choices the story marks disabled (dimmed, not pickable)?
    showDisabledChoices as boolean = true
    closeOnBack as boolean = true
    ' Pause the game while open?
    modal as boolean = true
    ' Drawn behind the box instead of the theme's panel background, when set (a
    ' NinePatchImage or ImageBackground).
    backgroundImage as dynamic = invalid
    ' Optional object told about the conversation: onDialogueLine(view, line) and
    ' onDialogueEnded(view, cancelled), each only if it has the method.
    listener as dynamic = invalid

    ' The choice buttons on screen, in story order.
    choiceButtons as BGE.UI.Button[] = []

    protected speakerLabel as BGE.UI.Label = invalid
    protected textLabel as BGE.UI.Label = invalid
    protected moreLabel as BGE.UI.Label = invalid
    protected pages as string[] = []
    protected pageIndex as integer = 0
    private opened as boolean = false
    private ownerScene as BGE.GameScene = invalid

    ' @param {BGE.Game} game
    ' @param {BGE.Story.StorySession} session
    sub new(game as BGE.Game, session as BGE.Story.StorySession)
      super(game)
      m.session = session
      m.customPosition = true
      uiW = game.uiCanvas.getWidth()
      uiH = game.uiCanvas.getHeight()
      m.width = uiW * 0.8
      m.customX = uiW * 0.1
      m.height = m.boxHeight()
      m.customY = uiH * 0.9 - m.height
    end sub

    ' Starts a conversation at a node and opens the box if there's something to show.
    '
    ' @param {string} nodeId
    ' @param {BGE.UI.UiContainer} [parent=invalid] - see open()
    ' @return {boolean} true if it opened
    function start(nodeId as string, parent = invalid as BGE.UI.UiContainer) as boolean
      m.session.start(nodeId)
      if not m.session.runner.isActive()
        return false
      end if
      m.open(parent)
      return m.opened
    end function

    ' Opens the box on the session's current conversation. With no parent it's owned by the
    ' current scene (scene.addUi()).
    '
    ' @param {BGE.UI.UiContainer} [parent=invalid]
    sub open(parent = invalid as BGE.UI.UiContainer)
      if m.opened or not m.session.runner.isActive()
        return
      end if
      m.opened = true
      m.height = m.boxHeight()
      m.buildLabels()
      if m.modal
        m.game.pushModal()
      end if
      if parent = invalid and m.game.getScene() <> invalid
        m.ownerScene = m.game.getScene()
        m.ownerScene.addUi(m)
      else
        if parent = invalid
          parent = m.game.gameUi
        end if
        parent.addChild(m)
      end if
      m.showStep()
    end sub

    ' Closes the box, cancelling the conversation if it's still going.
    sub close()
      if not m.opened
        return
      end if
      cancelled = m.session.runner.isActive()
      if cancelled
        m.session.runner.cancel()
      end if
      m.finish(cancelled)
    end sub

    ' Is the box open?
    '
    ' @return {boolean}
    function isOpen() as boolean
      return m.opened
    end function

    ' Is there another page of the current line?
    '
    ' @return {boolean}
    function hasMorePages() as boolean
      return m.pageIndex < m.pages.count() - 1
    end function

    ' The page of text on screen.
    '
    ' @return {string}
    function getPageText() as string
      if m.pageIndex < m.pages.count()
        return m.pages[m.pageIndex]
      end if
      return ""
    end function

    ' Turns the page, or moves the conversation on from the last page. Does nothing while
    ' choices are up.
    sub next()
      if not m.opened or m.choiceButtons.count() > 0
        return
      end if
      if m.hasMorePages()
        m.showPage(m.pageIndex + 1)
      else
        m.session.advance()
        m.showStep()
      end if
    end sub

    ' Picks a choice by its index in runner.choices().
    '
    ' @param {integer} index
    sub choose(index as integer)
      if not m.opened
        return
      end if
      views = m.session.runner.choices()
      if index < 0 or index >= views.count() or not views[index].enabled
        return
      end if
      m.session.choose(index)
      m.showStep()
    end sub

    sub onUiAction(actionId as string, button as BGE.UI.Button)
      m.choose(button.value)
    end sub

    override sub onInput(input as BGE.GameInput)
      super.onInput(input)
      if not m.opened
        return
      end if
      input.consume()
      if not input.press
        return
      end if
      if m.closeOnBack and input.isButton("back")
        m.close()
      else if input.isButton("ok")
        m.next()
      end if
    end sub

    ' Also runs when the parent removes the box, e.g. on a scene change.
    override sub onDestroy()
      super.onDestroy()
      if m.opened
        m.opened = false
        m.ownerScene = invalid
        if m.modal
          m.game.popModal()
        end if
      end if
      m.choiceButtons = []
    end sub

    override sub draw(parent = invalid as BGE.UI.UiWidget)
      theme = m.effectiveTheme()
      if m.backgroundImage <> invalid
        m.backgroundImage.draw(m.canvas.renderer, m.position.x, m.position.y, m.width, m.height)
      else if theme.panelBackgroundImage <> invalid
        theme.panelBackgroundImage.draw(m.canvas.renderer, m.position.x, m.position.y, m.width, m.height)
      else
        m.canvas.renderer.drawRectangle(m.position.x, m.position.y, m.width, m.height, theme.panelBackgroundColor)
      end if
      m.children.sortBy("zIndex")
      for each child in m.children
        if invalid <> child and child.enabled
          child.repositionBasedOnParent(m)
          child.draw(m)
        end if
      end for
    end sub

    ' Called for each line as it's shown (e.g. to set portraits). Tells the listener.
    '
    ' @param {BGE.Story.StoryLineView} line
    sub onLine(line as BGE.Story.StoryLineView)
      if m.listener <> invalid and m.listener.onDialogueLine <> invalid
        m.listener.onDialogueLine(m, line)
      end if
    end sub

    ' Called once the box has closed. Tells the listener.
    '
    ' @param {boolean} cancelled - true if the player left before the end
    sub onEnded(cancelled as boolean)
      if m.listener <> invalid and m.listener.onDialogueEnded <> invalid
        m.listener.onDialogueEnded(m, cancelled)
      end if
    end sub

    ' Makes the button for one choice. The view sets its position, size, actionId, value and
    ' listener afterwards.
    '
    ' @param {BGE.Story.ChoiceView} choice
    ' @param {integer} index - in runner.choices()
    ' @return {BGE.UI.Button}
    protected function createChoiceButton(choice as BGE.Story.ChoiceView, index as integer) as BGE.UI.Button
      button = new BGE.UI.Button(m.game)
      button.setLabel(choice.label)
      return button
    end function

    ' Positions the choice buttons (relative to the box) per `choiceLayout`.
    '
    ' @param {BGE.UI.Button[]} buttons
    protected sub layoutChoices(buttons as BGE.UI.Button[])
      count = buttons.count()
      if count = 0
        return
      end if
      if m.choiceLayout = "row"
        width = (m.width - m.boxPadding * 2 - m.choiceGap * (count - 1)) / count
        for i = 0 to count - 1
          buttons[i].customX = m.boxPadding + i * (width + m.choiceGap)
          buttons[i].customY = m.height - m.boxPadding - m.choiceHeight
          buttons[i].width = width
          buttons[i].height = m.choiceHeight
        end for
        return
      end if
      width = m.choiceWidth
      if width <= 0
        width = m.width * 0.6
      end if
      top = -m.choiceGap - count * (m.choiceHeight + m.choiceGap) + m.choiceGap
      for i = 0 to count - 1
        buttons[i].customX = (m.width - width) / 2
        buttons[i].customY = top + i * (m.choiceHeight + m.choiceGap)
        buttons[i].width = width
        buttons[i].height = m.choiceHeight
      end for
    end sub

    ' After a step: the next line, the choices, or the end.
    protected sub showStep()
      m.removeChoices()
      runner = m.session.runner
      if not runner.isActive()
        m.finish(false)
      else if runner.isChoosing()
        m.showChoices()
      else
        m.showLine()
      end if
    end sub

    protected sub showLine()
      line = m.session.runner.currentLine()
      m.speakerLabel.setText(line.speaker)
      font = m.fontNamed(m.textFontName)
      wrapped = BGE.UI.wrapText(line.text, font, m.width - m.boxPadding * 2)
      m.pages = [] as string[]
      for i = 0 to wrapped.count() - 1 step m.linesPerPage
        lastIndex = BGE.Math.Min(i + m.linesPerPage - 1, wrapped.count() - 1)
        pageLines = [] as string[]
        for j = i to lastIndex
          pageLines.push(wrapped[j])
        end for
        m.pages.push(pageLines.join(Chr(10)))
      end for
      if m.pages.count() = 0
        m.pages.push("")
      end if
      m.onLine(line)
      if m.opened
        m.showPage(0)
      end if
    end sub

    protected sub showPage(index as integer)
      m.pageIndex = index
      m.textLabel.setText(m.pages[index])
      if m.hasMorePages()
        m.moreLabel.setText(m.moreText)
        return
      end if
      m.moreLabel.setText("")
      ' a node's choices come up with its last line rather than after another OK
      if m.session.runner.choicesFollow()
        m.session.advance()
        if m.session.runner.isChoosing()
          m.removeChoices()
          m.showChoices()
        else
          m.showStep()
        end if
      end if
    end sub

    protected sub showChoices()
      m.moreLabel.setText("")
      views = m.session.runner.choices()
      for i = 0 to views.count() - 1
        if views[i].enabled or m.showDisabledChoices
          button = m.createChoiceButton(views[i], i)
          button.customPosition = true
          button.actionId = "choice"
          button.value = i
          button.listener = m
          button.setDisabled(not views[i].enabled)
          m.choiceButtons.push(button)
        end if
      end for
      m.layoutChoices(m.choiceButtons)
      for each button in m.choiceButtons
        m.addChild(button)
      end for
      ' the OK that brought the choices up mustn't also pick one
      m.game.suppressInputUntilRelease()
      for each button in m.choiceButtons
        if not button.disabled
          m.game.focusManager.focusWidget(button)
          exit for
        end if
      end for
    end sub

    protected sub removeChoices()
      for each button in m.choiceButtons
        m.removeChild(button)
      end for
      m.choiceButtons = []
    end sub

    protected function fontNamed(name as string) as roFont
      font = m.game.getFontOr(name)
      return font
    end function

    private function boxHeight() as float
      speakerFont = m.fontNamed(m.speakerFontName)
      textFont = m.fontNamed(m.textFontName)
      height = m.boxPadding * 2 + speakerFont.GetOneLineHeight() + m.speakerGap + textFont.GetOneLineHeight() * m.linesPerPage
      if m.choiceLayout = "row"
        height += m.choiceGap + m.choiceHeight
      end if
      return height
    end function

    private sub buildLabels()
      m.clearChildren()
      m.choiceButtons = []
      theme = m.effectiveTheme()
      speakerFont = m.fontNamed(m.speakerFontName)
      textFont = m.fontNamed(m.textFontName)
      m.speakerLabel = m.makeLabel(speakerFont, theme.panelTitleColor, m.boxPadding, m.boxPadding)
      m.textLabel = m.makeLabel(textFont, theme.panelTextColor, m.boxPadding, m.boxPadding + speakerFont.GetOneLineHeight() + m.speakerGap)
      moreX = m.width - m.boxPadding - textFont.GetOneLineWidth(m.moreText, BGE.TEXT_MAX_LINE_SIZE)
      m.moreLabel = m.makeLabel(textFont, theme.panelTitleColor, moreX, m.height - m.boxPadding - textFont.GetOneLineHeight())
    end sub

    private function makeLabel(font as roFont, color as integer, x as float, y as float) as BGE.UI.Label
      label = new BGE.UI.Label(m.game)
      label.setFont(font)
      label.customPosition = true
      label.customX = x
      label.customY = y
      label.drawableText.textColor = color
      m.addChild(label)
      return label
    end function

    ' The modal is released after onEnded(), so a panel opened from there keeps the game paused.
    private sub finish(cancelled as boolean)
      holdsModal = m.opened and m.modal
      m.opened = false
      owner = m.ownerScene
      parent = m.parentContainer
      m.ownerScene = invalid
      if owner <> invalid
        owner.removeUi(m)
      else if parent <> invalid
        (parent as BGE.UI.UiContainer).removeChild(m)
      end if
      m.onEnded(cancelled)
      if holdsModal
        m.game.popModal()
      end if
    end sub

  end class

end namespace
