import "ValueKinds.bs"
import "StoryTypes.bs"

namespace BGE.Story

  ' What the player is carrying: item id -> count, capped by each item's definition.
  class Inventory

    ' item id -> count
    private counts as roAssociativeArray = {}
    ' item id -> ItemDefinition
    private definitions as roAssociativeArray = invalid

    ' @param {roAssociativeArray} definitions - item id -> ItemDefinition (at least a max)
    sub new(definitions as roAssociativeArray)
      m.definitions = definitions
      m.clear()
    end sub

    ' Empties the inventory.
    sub clear()
      m.counts = {}
    end sub

    ' @param {string} id - an item id from the story's items
    ' @return {integer} how many are carried
    function count(id as string) as integer
      if m.counts.DoesExist(id)
        return m.counts[id]
      end if
      return 0
    end function

    ' @param {string} id - an item id from the story's items
    ' @return {boolean} true if at least one is carried
    function has(id as string) as boolean
      return m.count(id) > 0
    end function

    ' @param {string} id - an item id from the story's items
    ' @return {boolean} true if the item is defined and fewer than its max are carried
    function canAdd(id as string) as boolean
      definition = m.definitions[id] as ItemDefinition
      return definition <> invalid and m.count(id) < definition.max
    end function

    ' Adds one of an item. This doesn't run its onAcquire effects - the giveItem effect does.
    '
    ' @param {string} id - an item id from the story's items
    ' @return {boolean} false if the item isn't defined or its max is already carried
    function add(id as string) as boolean
      if not m.canAdd(id)
        return false
      end if
      m.counts[id] = m.count(id) + 1
      return true
    end function

    ' Removes one of an item.
    '
    ' @param {string} id - an item id from the story's items
    ' @return {boolean} false if none was carried
    function remove(id as string) as boolean
      if not m.has(id)
        return false
      end if
      m.counts[id] = m.count(id) - 1
      return true
    end function

    ' A copy of what is carried, e.g. to save or list on an inventory screen.
    '
    ' @return {roAssociativeArray} item id -> count (items not carried are left out)
    function toAA() as roAssociativeArray
      copy = {}
      copy.Append(m.counts)
      return copy
    end function

    ' Replaces the contents with saved ones (from toAA()). Unknown items and non-integer counts
    ' are dropped, and counts are capped at each item's max.
    '
    ' @param {roAssociativeArray} data - item id -> count
    sub loadAA(data as roAssociativeArray)
      m.clear()
      if type(data) <> "roAssociativeArray"
        return
      end if
      for each id in data
        definition = m.definitions[id] as ItemDefinition
        if definition <> invalid and valueKind(data[id]) = "integer"
          amount = data[id]
          if amount > definition.max
            amount = definition.max
          end if
          if amount > 0
            m.counts[id] = amount
          end if
        end if
      end for
    end sub

  end class

end namespace
