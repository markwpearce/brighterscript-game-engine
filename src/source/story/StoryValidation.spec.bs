namespace tests
  @suite("BGE.Story.validateStory")
  class StoryValidationTests extends rooibos.BaseTestSuite

    private state as BGE.Story.StoryState

    protected override function beforeEach()
      m.state = new BGE.Story.StoryState()
    end function

    private function errorsFor(story as dynamic) as string[]
      return BGE.Story.validateStory(story, m.state)
    end function

    private sub assertSomeErrorContains(errors as string[], text as string)
      for each e in errors
        if Instr(1, e, text) > 0
          return
        end if
      end for
      m.fail("no error contains '" + text + "'; got: " + errors.join(" | "))
    end sub

    @describe("validateStory")

    @it("accepts a well-formed story")
    function _()
      errors = m.errorsFor({
        nodes: {
          start: {lines: ["a", {text: "b", portrait: "x"}], choices: [{label: "Go", "goto": "chat", when: [{any: [{flag: "x"}, {visited: "chat"}]}]}, {"call": "chat"}]},
          chat: {select: "random", candidates: [{lines: ["c"]}, {lines: ["d"], effects: [{set: "y", value: 1}]}]},
          routes: [{when: [{flag: "z"}], "goto": "start"}, {"end": true}]
        },
        rules: [{event: "storyChanged", when: [{hasItem: "clue"}], effects: [{post: "found"}]}],
        items: {clue: {max: 1, onAcquire: [{add: "clues", amount: 1}]}}
      })
      m.assertEqual(0, errors.count())
    end function

    @it("rejects a story without nodes")
    function _()
      m.assertEqual(1, m.errorsFor(invalid).count())
      m.assertEqual(1, m.errorsFor({}).count())
    end function

    @it("reports unknown goto and call targets")
    function _()
      errors = m.errorsFor({nodes: {start: {lines: ["a"], "goto": "nowhere", choices: [{label: "x", "call": "gone"}]}}})
      m.assertEqual(2, errors.count())
      m.assertSomeErrorContains(errors, "nowhere")
      m.assertSomeErrorContains(errors, "gone")
    end function

    @it("reports unknown conditions and effects, nested ones too")
    function _()
      errors = m.errorsFor({nodes: {start: {lines: ["a"], when: [{any: [{coinsGte: 3}]}], effects: [{heal: 2}]}}})
      m.assertEqual(2, errors.count())
      m.assertSomeErrorContains(errors, "coinsGte")
      m.assertSomeErrorContains(errors, "heal")
    end function

    @it("accepts registered vocabulary")
    function _()
      m.state.registerCondition("coinsGte", function(item as roAssociativeArray, state as object, context as dynamic) as boolean
        return true
      end function)
      m.assertEqual(0, m.errorsFor({nodes: {start: {lines: ["a"], when: [{coinsGte: 3}]}}}).count())
    end function

    @it("reports bad groups, empty nodes, bad lines and bad ids")
    function _()
      errors = m.errorsFor({nodes: {
        badSelect: {select: "loudest", candidates: [{lines: ["a"]}]},
        empty: {candidates: []},
        nothing: {speaker: "x"},
        badLine: {lines: [7]},
        "a#b": {lines: ["a"]},
        notANode: "text"
      }})
      m.assertEqual(6, errors.count())
      for each id in ["badSelect", "empty", "nothing", "badLine", "a#b", "notANode"]
        m.assertSomeErrorContains(errors, id)
      end for
    end function

    @it("reports malformed lists and items")
    function _()
      errors = m.errorsFor({
        nodes: {start: {lines: ["a"], when: {flag: "x"}, choices: ["not a choice"]}},
        rules: [{effects: []}],
        items: {thing: {name: "no max"}}
      })
      m.assertEqual(4, errors.count())
      m.assertSomeErrorContains(errors, "when must be a list")
      m.assertSomeErrorContains(errors, "isn't an object")
      m.assertSomeErrorContains(errors, "has no event")
      m.assertSomeErrorContains(errors, "needs an integer max")
    end function

    @it("reports mistyped condition fields")
    function _()
      errors = m.errorsFor({nodes: {x: {lines: ["a"], when: [
        {flag: 3}, {notFlag: true}, {hasItem: 1}, {notItem: {}}, {visited: 2}, {notVisited: []},
        {flag: "f", gte: "2"}, {flag: "f", lt: 1.5}, {flag: "f", eq: 1.5}, {any: [{flag: 9}]}
      ]}}})
      m.assertEqual(10, errors.count())
      m.assertSomeErrorContains(errors, "node 'x' has a condition whose flag isn't a string: ")
      for each key in ["notFlag", "hasItem", "notItem", "visited", "notVisited"]
        m.assertSomeErrorContains(errors, "whose " + key + " isn't a string")
      end for
      m.assertSomeErrorContains(errors, "whose gte isn't an integer")
      m.assertSomeErrorContains(errors, "whose lt isn't an integer")
      m.assertSomeErrorContains(errors, "whose eq isn't a boolean, integer or string")
    end function

    @it("reports mistyped effect fields")
    function _()
      errors = m.errorsFor({nodes: {x: {lines: ["a"], effects: [
        {set: 1, value: true}, {add: "n", amount: "1"}, {add: "n"}, {giveItem: 2}, {takeItem: true},
        {post: 4}, {message: 5}, {message: "hi", speaker: 6}, {set: "f", value: {}}, {set: "f"}
      ]}}})
      m.assertEqual(10, errors.count())
      m.assertSomeErrorContains(errors, "node 'x' has an effect whose set isn't a string: ")
      m.assertSomeErrorContains(errors, "whose amount isn't an integer")
      m.assertSomeErrorContains(errors, "whose add has no amount")
      for each key in ["giveItem", "takeItem", "post", "message", "speaker"]
        m.assertSomeErrorContains(errors, "whose " + key + " isn't a string")
      end for
      m.assertSomeErrorContains(errors, "whose value isn't a boolean, number or string")
      m.assertSomeErrorContains(errors, "whose set has no value")
    end function

    @it("skips type checks for a key a registered handler takes over")
    function _()
      m.state.registerCondition("flag", function(item as roAssociativeArray, state as object, context as dynamic) as boolean
        return true
      end function)
      m.assertEqual(0, m.errorsFor({nodes: {x: {lines: ["a"], when: [{flag: 3}]}}}).count())
    end function

    @it("reports rule match values that aren't scalars")
    function _()
      errors = m.errorsFor({nodes: {x: {lines: ["a"]}}, rules: [
        {event: "e", match: {kind: {a: 1}, ok: "rat"}},
        {event: "e", match: "rat"}
      ]})
      m.assertEqual(2, errors.count())
      m.assertSomeErrorContains(errors, "rule 0 match 'kind' isn't a string, number or boolean")
      m.assertSomeErrorContains(errors, "rule 1: match must be an object")
    end function

    @it("reports scalar when and effects without crashing")
    function _()
      errors = m.errorsFor({nodes: {start: {lines: ["a"], when: 5, effects: "x"}}})
      m.assertEqual(2, errors.count())
      m.assertSomeErrorContains(errors, "when must be a list")
      m.assertSomeErrorContains(errors, "effects must be a list")
    end function

  end class
end namespace
