import "pkg:/source/story/DebugState.bs"
import "pkg:/source/story/StoryState.bs"

namespace tests
  @suite("BGE.Story.applyDebugState")
  class DebugStateTests extends rooibos.BaseTestSuite

    private function newState() as BGE.Story.StoryState
      return new BGE.Story.StoryState({
        items: {"smallKey": {"max": 3}, "throneKey": {"max": 1}},
        nodes: {},
        rules: [{"event": "storyChanged", "when": [{"flag": "gate.open"}], "effects": [{"set": "town.safe", "value": true}]}]
      })
    end function

    @describe("flags")

    @it("sets flags from a string, with typed values, then settles")
    function _()
      state = m.newState()
      BGE.Story.applyDebugState(state, "gate.open, kills=4, ratio=0.5, name=Bram, off=false")
      m.assertTrue(state.flags.get("gate.open"))
      m.assertEqual(4, state.flags.get("kills"))
      m.assertEqual(0.5, state.flags.get("ratio"))
      m.assertEqual("Bram", state.flags.get("name"))
      m.assertFalse(state.flags.get("off"))
      m.assertTrue(state.flags.get("town.safe"))
    end function

    @it("takes an array of names or an AA of values")
    function _()
      state = m.newState()
      BGE.Story.applyDebugState(state, ["a", "b"])
      m.assertTrue(state.flags.get("b"))
      BGE.Story.applyDebugState(state, {"c": 3})
      m.assertEqual(3, state.flags.get("c"))
    end function

    @describe("items")

    @it("gives items from a string with counts")
    function _()
      state = m.newState()
      BGE.Story.applyDebugState(state, invalid, "smallKey:2,throneKey")
      m.assertEqual(2, state.inventory.count("smallKey"))
      m.assertEqual(1, state.inventory.count("throneKey"))
    end function

    @it("gives items from an array or an AA of counts")
    function _()
      state = m.newState()
      BGE.Story.applyDebugState(state, invalid, ["smallKey", "smallKey"])
      m.assertEqual(2, state.inventory.count("smallKey"))
      state2 = m.newState()
      BGE.Story.applyDebugState(state2, invalid, {"smallKey": 3})
      m.assertEqual(3, state2.inventory.count("smallKey"))
    end function

    @it("ignores invalid and junk")
    function _()
      state = m.newState()
      BGE.Story.applyDebugState(state, invalid, invalid)
      BGE.Story.applyDebugState(state, 42, 7)
      m.assertEqual(0, state.inventory.count("smallKey"))
    end function

  end class
end namespace
