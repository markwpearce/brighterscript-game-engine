namespace tests
  @suite("BGE.Story.valueKind")
  class ValueKindsTests extends rooibos.BaseTestSuite

    @describe("valueKind")

    @it("folds boxed and unboxed numbers to one kind")
    function _()
      boxed = CreateObject("roInt")
      boxed.SetInt(3)
      m.assertEqual("integer", BGE.Story.valueKind(3))
      m.assertEqual("integer", BGE.Story.valueKind(boxed))
      m.assertEqual("integer", BGE.Story.valueKind(ParseJson("{""a"":3}").a))
      m.assertEqual("float", BGE.Story.valueKind(1.5))
      m.assertEqual("float", BGE.Story.valueKind(1.5#))
      m.assertEqual("string", BGE.Story.valueKind("x"))
      m.assertEqual("string", BGE.Story.valueKind(CreateObject("roString")))
      m.assertEqual("boolean", BGE.Story.valueKind(true))
    end function

    @it("isTrue is true only for a boolean true")
    function _()
      m.assertTrue(BGE.Story.isTrue(true))
      m.assertFalse(BGE.Story.isTrue(false))
      m.assertFalse(BGE.Story.isTrue(invalid))
      m.assertFalse(BGE.Story.isTrue(1))
      m.assertFalse(BGE.Story.isTrue("true"))
    end function

  end class
end namespace
