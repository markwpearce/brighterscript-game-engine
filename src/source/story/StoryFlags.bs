import "ValueKinds.bs"

namespace BGE.Story

  ' The story's blackboard: named values (booleans, integers, floats, strings) that story data reads
  ' with conditions and changes with effects - quest stages, who you've talked to, what you chose.
  class StoryFlags

    private values as roAssociativeArray = invalid

    ' Starts empty. Flag names are case-sensitive.
    sub new()
      m.clear()
    end sub

    ' Removes every flag.
    sub clear()
      m.values = {}
      m.values.SetModeCaseSensitive()
    end sub

    ' Reads a flag as stored.
    '
    ' @param {string} key - the flag name
    ' @return {dynamic} the value, or invalid if the flag isn't set
    function get(key as string) as dynamic
      return m.values[key]
    end function

    ' Reads a flag as a number, e.g. a quest stage or a counter.
    '
    ' @param {string} key - the flag name
    ' @return {integer} the value (a float is truncated), or 0 if it's missing or not a number
    function getInt(key as string) as integer
      value = m.values[key]
      valueType = type(value)
      if valueType = "Integer" or valueType = "roInt" or valueType = "roInteger" or valueType = "LongInteger" or valueType = "roLongInteger"
        return value
      end if
      if valueType = "Float" or valueType = "Double" or valueType = "roFloat" or valueType = "roDouble"
        return Int(value)
      end if
      return 0
    end function

    ' Whether a flag is set, the same test the `flag` condition uses.
    '
    ' @param {string} key - the flag name
    ' @return {boolean} true for true, a non-zero number or a non-empty string
    function isSet(key as string) as boolean
      value = m.values[key]
      valueType = type(value)
      if valueType = "Boolean" or valueType = "roBoolean"
        return value
      end if
      if valueType = "String" or valueType = "roString"
        return value <> ""
      end if
      return m.getInt(key) <> 0
    end function

    ' Sets a flag.
    '
    ' @param {string} key - the flag name
    ' @param {dynamic} value - a boolean, integer, float or string
    ' @return {boolean} true if the stored value changed
    function set(key as string, value as boolean or integer or float or string) as boolean
      if m.values.DoesExist(key) and valueKind(m.values[key]) = valueKind(value)
        if m.values[key] = value
          return false
        end if
      end if
      m.values[key] = value
      return true
    end function

    ' Adds to a numeric flag, starting from 0 if it isn't set.
    '
    ' @param {string} key - the flag name
    ' @param {integer} amount - may be negative
    ' @return {boolean} true if the stored value changed
    function add(key as string, amount as integer) as boolean
      return m.set(key, m.getInt(key) + amount)
    end function

    ' A copy of every flag, e.g. to save or show in a debug view.
    '
    ' @return {roAssociativeArray} flag name -> value
    function toAA() as roAssociativeArray
      copy = {}
      copy.SetModeCaseSensitive()
      copy.Append(m.values)
      return copy
    end function

    ' Replaces every flag with saved ones (from toAA()). Values that aren't a boolean, number or
    ' string are dropped.
    '
    ' @param {roAssociativeArray} data - flag name -> value
    sub loadAA(data as roAssociativeArray)
      m.clear()
      if type(data) = "roAssociativeArray"
        for each key in data
          kind = valueKind(data[key])
          if kind = "integer" or kind = "float" or kind = "string" or kind = "boolean"
            m.values[key] = data[key]
          end if
        end for
      end if
    end sub

  end class

end namespace
