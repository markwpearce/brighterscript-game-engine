import "StoryTypes.bs"
import "StoryState.bs"
import "ValueKinds.bs"

namespace BGE.Story

  ' Sets flags and gives items for a debug launch (deep link) or a test, then settles the
  ' rules so derived flags exist on arrival.
  '
  ' `flags` can be a string ("gate.open,rats.kills=4,name=Bram"), an array of flag names (set
  ' to true) or an AA of name -> value. In a string, a value reads as an integer, float,
  ' true/false, or else a string. `itemCounts` can be a string ("smallKey:2,throneKey"), an
  ' array of item ids (one each), or an AA of id -> count. invalid skips either.
  '
  ' @param {StoryState} state
  ' @param {dynamic} [flags=invalid]
  ' @param {dynamic} [itemCounts=invalid]
  ' @return {StoryResult} what settling did
  function applyDebugState(state as StoryState, flags = invalid as dynamic, itemCounts = invalid as dynamic) as StoryResult
    parsedFlags = parseDebugFlags(flags)
    for each name in parsedFlags
      state.flags.set(name, parsedFlags[name])
    end for
    items = parseDebugItems(itemCounts)
    for each itemId in items
      for i = 1 to items[itemId]
        state.inventory.add(itemId)
      end for
    end for
    return state.settle()
  end function

  ' Flags for applyDebugState(), as name -> value.
  '
  ' @param {dynamic} flags - see applyDebugState()
  ' @return {roAssociativeArray}
  function parseDebugFlags(flags as dynamic) as roAssociativeArray
    result = {}
    result.SetModeCaseSensitive()
    if type(flags) = "roAssociativeArray"
      for each name in flags
        result[name] = flags[name]
      end for
      return result
    end if
    for each part in debugListParts(flags)
      pieces = part.Split("=")
      if pieces.count() > 1
        result[pieces[0].Trim()] = parseDebugValue(pieces[1].Trim())
      else
        result[part] = true
      end if
    end for
    return result
  end function

  ' Items for applyDebugState(), as id -> count.
  '
  ' @param {dynamic} itemCounts - see applyDebugState()
  ' @return {roAssociativeArray}
  function parseDebugItems(itemCounts as dynamic) as roAssociativeArray
    result = {}
    result.SetModeCaseSensitive()
    if type(itemCounts) = "roAssociativeArray"
      for each itemId in itemCounts
        count = itemCounts[itemId]
        if valueKind(count) = "integer"
          result[itemId] = count
        else if valueKind(count) = "float"
          result[itemId] = Int(count)
        else
          result[itemId] = 1
        end if
      end for
      return result
    end if
    for each part in debugListParts(itemCounts)
      pieces = part.Split(":")
      count = 1
      if pieces.count() > 1
        count = pieces[1].Trim().ToInt()
      end if
      itemId = pieces[0].Trim()
      result[itemId] = (result[itemId] ?? 0) + count
    end for
    return result
  end function

  ' A comma-separated string or an array of strings, as trimmed, non-empty strings.
  function debugListParts(value as dynamic) as string[]
    parts = [] as string[]
    raw = [] as dynamic[]
    if valueKind(value) = "string"
      raw = (value as string).Split(",")
    else if type(value) = "roArray"
      raw = value
    end if
    for each part in raw
      if valueKind(part) = "string" and (part as string).Trim() <> ""
        parts.push((part as string).Trim())
      end if
    end for
    return parts
  end function

  ' "4" -> 4, "1.5" -> 1.5, "true"/"false" -> booleans, anything else as written.
  function parseDebugValue(text as string) as dynamic
    lowered = LCase(text)
    if lowered = "true"
      return true
    else if lowered = "false"
      return false
    end if
    regex = CreateObject("roRegex", "^-?[0-9]+$", "")
    if regex.IsMatch(text)
      return text.ToInt()
    end if
    regex = CreateObject("roRegex", "^-?[0-9]*\.[0-9]+$", "")
    if regex.IsMatch(text)
      return text.ToFloat()
    end if
    return text
  end function

end namespace
