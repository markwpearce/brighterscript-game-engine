import "../engine/GameEntity.bs"
import "Interactable.bs"
import "../math/vector.bs"
import "../math/heading.bs"

namespace BGE

  ' The things a player can talk to, open or pick up, and which one is "in front" right now.
  ' Entities that have been destroyed are skipped (and dropped by prune()).
  '  - nearestInArc(): 3D, on the ground plane - the nearest within `reach` and `halfAngle` of
  '    a heading (heading 0 faces -z; see BGE.Math.isWithinArc()).
  '  - nearestInRect(): 2D - the nearest whose position is inside a rectangle.
  '
  ' @example
  ' m.talkers = new BGE.Interactables()
  ' m.talkers.add(bram, "bram", "Talk to Bram", "bramNode")
  ' target = m.talkers.nearestInArc(knight.position, knight.rotation.y, 3.5, BGE.Math.PI / 3)
  ' if target <> invalid
  '   prompt = m.talkers.promptFor(target, "OK") ' "OK: Talk to Bram"
  ' end if
  class Interactables

    private items as BGE.Interactable[] = []

    ' Adds something to interact with. An existing one with the same id is replaced.
    '
    ' @param {BGE.GameEntity} entity - its position is used
    ' @param {string} id
    ' @param {string} [label=""]
    ' @param {dynamic} [data=invalid]
    ' @return {BGE.Interactable}
    function add(entity as BGE.GameEntity, id as string, label = "" as string, data = invalid as dynamic) as BGE.Interactable
      m.remove(id)
      item = new BGE.Interactable(entity, id, label, data)
      m.items.push(item)
      return item
    end function

    ' @param {string} id
    sub remove(id as string)
      for i = m.items.count() - 1 to 0 step -1
        if m.items[i].id = id
          m.items.delete(i)
        end if
      end for
    end sub

    sub clear()
      m.items = []
    end sub

    ' @param {string} id
    ' @return {BGE.Interactable} or invalid
    function get(id as string) as BGE.Interactable
      for each item in m.items
        if item.id = id
          return item
        end if
      end for
      return invalid
    end function

    ' @return {integer}
    function count() as integer
      return m.items.count()
    end function

    ' Every interactable, in the order added.
    '
    ' @return {BGE.Interactable[]}
    function getAll() as BGE.Interactable[]
      return m.items
    end function

    ' Drops interactables whose entity has been destroyed.
    sub prune()
      for i = m.items.count() - 1 to 0 step -1
        if not m.isUsable(m.items[i], true)
          m.items.delete(i)
        end if
      end for
    end sub

    ' The nearest enabled interactable within `reach` of `origin` and `halfAngle` of
    ' `heading`, on the ground plane (x/z).
    '
    ' @param {BGE.Math.Vector} origin
    ' @param {float} heading - radians
    ' @param {float} reach
    ' @param {float} halfAngle - radians either side of heading
    ' @return {BGE.Interactable} or invalid
    function nearestInArc(origin as BGE.Math.Vector, heading as float, reach as float, halfAngle as float) as BGE.Interactable
      best = invalid
      bestDistance = 0.0
      for each item in m.items
        if m.isUsable(item, false)
          position = item.entity.position
          if BGE.Math.isWithinArc(origin, heading, position, reach, halfAngle, item.radius)
            dx = position.x - origin.x
            dz = position.z - origin.z
            distance = dx * dx + dz * dz
            if best = invalid or distance < bestDistance
              best = item
              bestDistance = distance
            end if
          end if
        end if
      end for
      return best
    end function

    ' The enabled interactable nearest (x/y) to `originX`, `originY` whose position is inside
    ' the rectangle from (x, y) to (x + width, y + height).
    '
    ' @param {float} x
    ' @param {float} y
    ' @param {float} width
    ' @param {float} height
    ' @param {float} originX
    ' @param {float} originY
    ' @return {BGE.Interactable} or invalid
    function nearestInRect(x as float, y as float, width as float, height as float, originX as float, originY as float) as BGE.Interactable
      best = invalid
      bestDistance = 0.0
      for each item in m.items
        if m.isUsable(item, false)
          position = item.entity.position
          if position.x >= x and position.x <= x + width and position.y >= y and position.y <= y + height
            dx = position.x - originX
            dy = position.y - originY
            distance = dx * dx + dy * dy
            if best = invalid or distance < bestDistance
              best = item
              bestDistance = distance
            end if
          end if
        end if
      end for
      return best
    end function

    ' A prompt for the target, e.g. "OK: Talk to Bram" (just the label if `buttonText` is "").
    '
    ' @param {BGE.Interactable} target
    ' @param {string} [buttonText="OK"]
    ' @return {string} "" for no target
    function promptFor(target as BGE.Interactable, buttonText = "OK" as string) as string
      if target = invalid
        return ""
      end if
      if buttonText = ""
        return target.label
      end if
      return buttonText + ": " + target.label
    end function

    private function isUsable(item as BGE.Interactable, ignoreEnabled as boolean) as boolean
      if item.entity = invalid or not item.entity.isValid()
        return false
      end if
      return ignoreEnabled or item.enabled
    end function

  end class

end namespace
