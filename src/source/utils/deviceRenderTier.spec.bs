namespace tests

  ' Under brs-cli/the simulator, roDeviceInfo.HasFeature("simulation_engine") reports
  ' true (see ScratchBitmap.spec.bs's note on this), so getDeviceRenderTier() always
  ' resolves to "simulator" in this headless test environment - there's no way to
  ' exercise the SD/HD/FHD branches here, only on a real device.
  @suite("BGE.getDeviceRenderTier")
  class DeviceRenderTierTests extends rooibos.BaseTestSuite

    pinnedTier as dynamic = invalid

    @describe("getDeviceRenderTier")

    ' the test runner pins the tier to simulator (bgeDeviceRenderTier), so these put it back
    protected override function afterEach()
      GetGlobalAA().bgeDeviceRenderTier = m.pinnedTier
    end function

    protected override function beforeEach()
      m.pinnedTier = GetGlobalAA().bgeDeviceRenderTier
    end function

    @it("resolves to simulator under brs-cli")
    function _()
      GetGlobalAA().Delete("bgeDeviceRenderTier")
      ' a real device has its own tier
      if CreateObject("roDeviceInfo").HasFeature("simulation_engine")
        m.assertEqual(BGE.getDeviceRenderTier(), BGE.DeviceRenderTier.simulator)
      else
        m.assertNotEqual(BGE.getDeviceRenderTier(), BGE.DeviceRenderTier.simulator)
      end if
    end function

    @it("acts as the tier set in bgeDeviceRenderTier")
    function _()
      GetGlobalAA().bgeDeviceRenderTier = BGE.DeviceRenderTier.hd
      m.assertEqual(BGE.DeviceRenderTier.hd, BGE.getDeviceRenderTier())
    end function

    @it("returns the same tier on repeated calls")
    function _()
      m.assertEqual(BGE.getDeviceRenderTier(), BGE.getDeviceRenderTier())
    end function

  end class

end namespace
