namespace tests

  ' Under brs-cli/the simulator, roDeviceInfo.HasFeature("simulation_engine") reports
  ' true (see ScratchBitmap.spec.bs's note on this), so getDeviceRenderTier() always
  ' resolves to "simulator" in this headless test environment - there's no way to
  ' exercise the SD/HD/FHD branches here, only on a real device.
  @suite("BGE.getDeviceRenderTier")
  class DeviceRenderTierTests extends rooibos.BaseTestSuite

    @describe("getDeviceRenderTier")

    @it("resolves to simulator under brs-cli")
    function _()
      m.assertEqual(BGE.getDeviceRenderTier(), BGE.DeviceRenderTier.simulator)
    end function

    @it("returns the same tier on repeated calls")
    function _()
      m.assertEqual(BGE.getDeviceRenderTier(), BGE.getDeviceRenderTier())
    end function

  end class

end namespace
