import "../math/math.bs"

namespace BGE

  ' Hands out a limited number of tokens, e.g. the "attack token" AI pattern: at most
  ' maxHolders enemies attack at once, and after one finishes nobody else starts for
  ' cooldownSeconds, so attacks come one after another rather than all at once.
  '
  ' Holders are identified by an id (a GameEntity's id, or any string or integer), since `=`
  ' can't compare objects. Call update(dt) once per frame.
  '
  ' @example
  ' m.attackTokens = new BGE.TokenPool(1, 1.2)
  ' ' In an enemy's onUpdate:
  ' if inRange and m.attackTokens.request(m.id)
  '   m.startAttack()
  ' end if
  ' ' When its attack is over, or it dies:
  ' m.attackTokens.release(m.id)
  class TokenPool

    ' How many ids can hold a token at once
    maxHolders as integer = 1
    ' After any token is released, nobody can take one for this long
    cooldownSeconds as float = 0.0

    private holders as roAssociativeArray = {}
    private cooldownLeft as float = 0.0
    private idleTime as float = 0.0

    ' @param {integer} [maxHolders=1]
    ' @param {float} [cooldownSeconds=0]
    sub new(maxHolders = 1 as integer, cooldownSeconds = 0 as float)
      m.maxHolders = maxHolders
      m.cooldownSeconds = cooldownSeconds
    end sub

    ' Counts down the cooldown and the idle time. Call once per frame.
    '
    ' @param {float} dt - seconds
    sub update(dt as float)
      if m.cooldownLeft > 0
        m.cooldownLeft = BGE.Math.Max(0, m.cooldownLeft - dt)
      end if
      if m.holders.Count() = 0
        m.idleTime += dt
      end if
    end sub

    ' True if `id` already holds a token, or could take one now.
    '
    ' @param {string|integer} id
    ' @return {boolean}
    function canRequest(id as string or integer) as boolean
      if m.isHolding(id)
        return true
      end if
      return m.holders.Count() < m.maxHolders and m.cooldownLeft <= 0
    end function

    ' Takes a token for `id` if it can (see canRequest()). Holding one already counts.
    '
    ' @param {string|integer} id
    ' @return {boolean} true if `id` now holds a token
    function request(id as string or integer) as boolean
      if not m.canRequest(id)
        return false
      end if
      m.holders[m.keyOf(id)] = true
      m.idleTime = 0.0
      return true
    end function

    ' Gives back `id`'s token and starts the cooldown. Safe to call when it holds none.
    '
    ' @param {string|integer} id
    ' @return {boolean} true if it held one
    function release(id as string or integer) as boolean
      if not m.holders.Delete(m.keyOf(id))
        return false
      end if
      m.cooldownLeft = m.cooldownSeconds
      return true
    end function

    ' @param {string|integer} id
    ' @return {boolean}
    function isHolding(id as string or integer) as boolean
      return m.holders.DoesExist(m.keyOf(id))
    end function

    ' @return {integer}
    function holderCount() as integer
      return m.holders.Count()
    end function

    ' Seconds left before anyone can take a token after the last release; 0 when none.
    '
    ' @return {float}
    function cooldownRemaining() as float
      return m.cooldownLeft
    end function

    ' Seconds since anyone last took a token, counted only while nobody holds one (0 while
    ' one is held). E.g. let an enemy out of view attack once the player has had a long break.
    '
    ' @return {float}
    function idleSeconds() as float
      return m.idleTime
    end function

    ' Drops every holder and resets the cooldown and idle time.
    sub clear()
      m.holders = {}
      m.cooldownLeft = 0.0
      m.idleTime = 0.0
    end sub

    private function keyOf(id as string or integer) as string
      return id.toStr()
    end function

  end class

end namespace
