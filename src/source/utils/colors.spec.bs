      m.assertEqual(BGE.ColorsRGB.AliceBlue, BGE.GetColorRGB("AliceBlue"), "GetColorRGB AliceBlue")
      m.assertEqual(BGE.Colors.AntiqueWhite, (BGE.ColorsRGB.AntiqueWhite << 8) or &hFF, "AntiqueWhite")
      m.assertEqual(BGE.Colors.AntiqueWhite, BGE.GetColor("AntiqueWhite"), "GetColor AntiqueWhite")
