namespace tests

  @suite("BGE colors")
  class ColorsTests extends rooibos.BaseTestSuite

    @describe("RGBAtoRGBA")

    @it("packs red/green/blue/alpha into a single RGBA integer")
    function _()
      m.assertEqual(&hFF0000FF, BGE.RGBAtoRGBA(255, 0, 0, 1))
    end function

    @it("clamps out-of-range components")
    function _()
      m.assertEqual(&hFFFFFFFF, BGE.RGBAtoRGBA(999, 999, 999, 1))
    end function

    @describe("Colors / GetColor")

    @it("BGE.Colors exposes named colors matching RGBAtoRGBA")
    function _()
      m.assertEqual(BGE.RGBAtoRGBA(255, 0, 0), BGE.Colors.Red)
      m.assertEqual(BGE.RGBAtoRGBA(255, 255, 255), BGE.Colors.White)
    end function

    @it("BGE.ColorsRGB is the same values without the alpha byte")
    function _()
      m.assertEqual(BGE.Colors.Red >> 8, BGE.ColorsRGB.Red)
    end function

    @it("GetColor looks up a color by name")
    function _()
      m.assertEqual(BGE.Colors.Lime, BGE.GetColor("Lime"))
    end function

    @it("GetColor is case-insensitive")
    function _()
      m.assertEqual(BGE.Colors.Lime, BGE.GetColor("lime"))
    end function

    @it("GetColor falls back to white for an unknown name")
    function _()
      m.assertEqual(BGE.Colors.White, BGE.GetColor("NotAColor"))
    end function

    @it("GetColorRGB looks up a BGE.ColorsRGB value by name")
    function _()
      m.assertEqual(BGE.ColorsRGB.Lime, BGE.GetColorRGB("Lime"))
    end function

    @it("Pink is CSS pink, not magenta")
    function _()
      m.assertEqual(&hFFC0CBFF, BGE.Colors.Pink)
      m.assertEqual(&hFF00FFFF, BGE.Colors.Magenta)
    end function

    ' <generated-colors> - edit scripts/generate-colors.js, not this block
    @it("every CSS named color matches across Colors, ColorsRGB, GetColor and GetColorRGB")
    function _()
      m.assertEqual(BGE.Colors.AliceBlue, (BGE.ColorsRGB.AliceBlue << 8) or &hFF, "AliceBlue")
