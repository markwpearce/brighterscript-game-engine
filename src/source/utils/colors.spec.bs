      m.assertEqual(BGE.Colors.Turquoise, BGE.GetColor("Turquoise"), "GetColor Turquoise")
      m.assertEqual(BGE.ColorsRGB.Turquoise, BGE.GetColorRGB("Turquoise"), "GetColorRGB Turquoise")
      m.assertEqual(BGE.Colors.Violet, (BGE.ColorsRGB.Violet << 8) or &hFF, "Violet")
      m.assertEqual(BGE.Colors.Violet, BGE.GetColor("Violet"), "GetColor Violet")
      m.assertEqual(BGE.ColorsRGB.Violet, BGE.GetColorRGB("Violet"), "GetColorRGB Violet")
      m.assertEqual(BGE.Colors.Wheat, (BGE.ColorsRGB.Wheat << 8) or &hFF, "Wheat")
      m.assertEqual(BGE.Colors.Wheat, BGE.GetColor("Wheat"), "GetColor Wheat")
      m.assertEqual(BGE.ColorsRGB.Wheat, BGE.GetColorRGB("Wheat"), "GetColorRGB Wheat")
      m.assertEqual(BGE.Colors.White, (BGE.ColorsRGB.White << 8) or &hFF, "White")
      m.assertEqual(BGE.Colors.White, BGE.GetColor("White"), "GetColor White")
      m.assertEqual(BGE.ColorsRGB.White, BGE.GetColorRGB("White"), "GetColorRGB White")
      m.assertEqual(BGE.Colors.WhiteSmoke, (BGE.ColorsRGB.WhiteSmoke << 8) or &hFF, "WhiteSmoke")
      m.assertEqual(BGE.Colors.WhiteSmoke, BGE.GetColor("WhiteSmoke"), "GetColor WhiteSmoke")
      m.assertEqual(BGE.ColorsRGB.WhiteSmoke, BGE.GetColorRGB("WhiteSmoke"), "GetColorRGB WhiteSmoke")
      m.assertEqual(BGE.Colors.Yellow, (BGE.ColorsRGB.Yellow << 8) or &hFF, "Yellow")
      m.assertEqual(BGE.Colors.Yellow, BGE.GetColor("Yellow"), "GetColor Yellow")
      m.assertEqual(BGE.ColorsRGB.Yellow, BGE.GetColorRGB("Yellow"), "GetColorRGB Yellow")
      m.assertEqual(BGE.Colors.YellowGreen, (BGE.ColorsRGB.YellowGreen << 8) or &hFF, "YellowGreen")
      m.assertEqual(BGE.Colors.YellowGreen, BGE.GetColor("YellowGreen"), "GetColor YellowGreen")
      m.assertEqual(BGE.ColorsRGB.YellowGreen, BGE.GetColorRGB("YellowGreen"), "GetColorRGB YellowGreen")
    end function
    ' </generated-colors>

    @describe("colorBrightness")

    @it("full brightness (1.0) leaves the color unchanged")
    function _()
      original = BGE.RGBAtoRGBA(200, 100, 50, 1)
      m.assertEqual(original, BGE.colorBrightness(original, 1))
    end function

    @it("zero brightness zeroes out the RGB channels but keeps alpha")
    function _()
      original = BGE.RGBAtoRGBA(200, 100, 50, 1)
      result = BGE.colorBrightness(original, 0)
      m.assertEqual(&h000000FF, result)
    end function

    @it("clamps brightness values outside [0, 1]")
    function _()
      original = BGE.RGBAtoRGBA(200, 100, 50, 1)
      m.assertEqual(BGE.colorBrightness(original, 1), BGE.colorBrightness(original, 5))
    end function

    @it("keeps a translucent color's alpha")
    function _()
      m.assertEqual(&h64321980, BGE.colorBrightness(&hC8643280, 0.5))
    end function

    @describe("colorOpacity")

    @it("scales alpha and leaves the RGB channels unchanged")
    function _()
      m.assertEqual(&hC8643240, BGE.colorOpacity(&hC8643280, 0.5))
    end function

    @it("full opacity leaves a translucent color unchanged")
    function _()
      m.assertEqual(&hC8643280, BGE.colorOpacity(&hC8643280, 1))
    end function

    @describe("HSVtoRGBA")

    @it("pure red hue at full saturation/value maps to red")
    function _()
      m.assertEqual(BGE.RGBAtoRGBA(255, 0, 0, 1), BGE.HSVtoRGBA(0, 100, 100, 255))
    end function

    @it("zero saturation produces a shade of gray regardless of hue")
    function _()
      result = BGE.HSVtoRGBA(180, 0, 100, 255)
      m.assertEqual(BGE.RGBAtoRGBA(255, 255, 255, 1), result)
    end function

    @describe("lerpColorRGB")

    @it("returns colorA at t=0")
    function _()
      m.assertEqual(&hFF0000, BGE.lerpColorRGB(&hFF0000, &h0000FF, 0))
    end function

    @it("returns colorB at t=1")
    function _()
      m.assertEqual(&h0000FF, BGE.lerpColorRGB(&hFF0000, &h0000FF, 1))
    end function

    @it("blends each channel independently at t=0.5")
    function _()
      ' red 0xFF->0x00, green 0x00->0x00, blue 0x00->0xFF
      m.assertEqual(&h800080, BGE.lerpColorRGB(&hFF0000, &h0000FF, 0.5))
    end function

  end class

end namespace
