namespace tests

  @suite("BGE.buttonAliasToName")
  class ButtonAliasToNameTests extends rooibos.BaseTestSuite

    @describe("known aliases")

    @it("resolves aliases to their canonical BGE button name")
    function _()
      m.assertEqual("ok", BGE.buttonAliasToName("select"))
      m.assertEqual("options", BGE.buttonAliasToName("info"))
      m.assertEqual("options", BGE.buttonAliasToName("*"))
      m.assertEqual("fastforward", BGE.buttonAliasToName("ff"))
      m.assertEqual("fastforward", BGE.buttonAliasToName("fwd"))
      m.assertEqual("fastforward", BGE.buttonAliasToName("forward"))
      m.assertEqual("rewind", BGE.buttonAliasToName("rw"))
      m.assertEqual("rewind", BGE.buttonAliasToName("rev"))
      m.assertEqual("replay", BGE.buttonAliasToName("instantreplay"))
    end function

    @it("is case-insensitive")
    function _()
      m.assertEqual("ok", BGE.buttonAliasToName("SELECT"))
      m.assertEqual("fastforward", BGE.buttonAliasToName("FF"))
    end function

    @describe("names with no alias")

    @it("lowercases and returns the name unchanged")
    function _()
      m.assertEqual("ok", BGE.buttonAliasToName("OK"))
      m.assertEqual("back", BGE.buttonAliasToName("back"))
      m.assertEqual("somethingunknown", BGE.buttonAliasToName("somethingUnknown"))
    end function

  end class

end namespace
