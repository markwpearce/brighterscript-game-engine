import "pkg:/source/utils/tilemap/TileMapColliderMerging.bs"

namespace tests
  @suite("BGE.TileMap.mergeTileColliderRuns")
  class TileMapColliderMergingTest extends rooibos.BaseTestSuite

    @describe("mergeTileColliderRuns")

    @it("returns an empty array for no cells")
    function _()
      runs = BGE.TileMap.mergeTileColliderRuns([])
      m.assertEqual(0, runs.count())
    end function

    @it("returns one single-column run for one cell")
    function _()
      runs = BGE.TileMap.mergeTileColliderRuns([{row: 0, col: 3, tag: "solid"}])
      m.assertEqual(1, runs.count())
      m.assertEqual(0, runs[0].row)
      m.assertEqual(3, runs[0].startCol)
      m.assertEqual(3, runs[0].endCol)
      m.assertEqual("solid", runs[0].tag)
    end function

    @it("merges contiguous same-tag cells in a row into one run")
    function _()
      cells = [
        {row: 0, col: 0, tag: "solid"},
        {row: 0, col: 1, tag: "solid"},
        {row: 0, col: 2, tag: "solid"}
      ]
      runs = BGE.TileMap.mergeTileColliderRuns(cells)
      m.assertEqual(1, runs.count())
      m.assertEqual(0, runs[0].startCol)
      m.assertEqual(2, runs[0].endCol)
    end function

    @it("breaks the run where a column gap exists")
    function _()
      cells = [
        {row: 0, col: 0, tag: "solid"},
        {row: 0, col: 1, tag: "solid"},
        {row: 0, col: 3, tag: "solid"},
        {row: 0, col: 4, tag: "solid"}
      ]
      runs = BGE.TileMap.mergeTileColliderRuns(cells)
      m.assertEqual(2, runs.count())
      m.assertEqual(0, runs[0].startCol)
      m.assertEqual(1, runs[0].endCol)
      m.assertEqual(3, runs[1].startCol)
      m.assertEqual(4, runs[1].endCol)
    end function

    @it("breaks the run where the tag changes even if columns are contiguous")
    function _()
      cells = [
        {row: 0, col: 0, tag: "solid"},
        {row: 0, col: 1, tag: "oneWay"},
        {row: 0, col: 2, tag: "oneWay"}
      ]
      runs = BGE.TileMap.mergeTileColliderRuns(cells)
      m.assertEqual(2, runs.count())
      m.assertEqual("solid", runs[0].tag)
      m.assertEqual(0, runs[0].startCol)
      m.assertEqual(0, runs[0].endCol)
      m.assertEqual("oneWay", runs[1].tag)
      m.assertEqual(1, runs[1].startCol)
      m.assertEqual(2, runs[1].endCol)
    end function

    @it("never merges cells across different rows")
    function _()
      cells = [
        {row: 0, col: 0, tag: "solid"},
        {row: 1, col: 0, tag: "solid"}
      ]
      runs = BGE.TileMap.mergeTileColliderRuns(cells)
      m.assertEqual(2, runs.count())
    end function

    @it("merges correctly even when cells arrive out of row/column order")
    function _()
      cells = [
        {row: 0, col: 2, tag: "solid"},
        {row: 1, col: 0, tag: "solid"},
        {row: 0, col: 0, tag: "solid"},
        {row: 0, col: 1, tag: "solid"}
      ]
      runs = BGE.TileMap.mergeTileColliderRuns(cells)
      m.assertEqual(2, runs.count())
      m.assertEqual(0, runs[0].row)
      m.assertEqual(0, runs[0].startCol)
      m.assertEqual(2, runs[0].endCol)
      m.assertEqual(1, runs[1].row)
      m.assertEqual(0, runs[1].startCol)
      m.assertEqual(0, runs[1].endCol)
    end function

  end class
end namespace
