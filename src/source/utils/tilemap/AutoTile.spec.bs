import "pkg:/source/utils/tilemap/AutoTile.bs"

namespace tests
  @suite("BGE.TileMap auto-tiling")
  class AutoTileTest extends rooibos.BaseTestSuite

    private block as string[]

    protected override function beforeEach()
      ' A 3x3 cobble block inside grass - every cell maps to a different one of the 9 pieces.
      m.block = [
        ".....",
        ".ccc.",
        ".ccc.",
        ".ccc.",
        "....."
      ]
    end function

    @describe("getNeighbourMask4")

    @it("sets N=1, E=2, S=4, W=8 for matching side neighbours")
    @params(1, 1, 6)
    @params(1, 2, 14)
    @params(2, 2, 15)
    @params(3, 3, 9)
    function _(r as integer, c as integer, expected as integer)
      m.assertEqual(expected, BGE.TileMap.getNeighbourMask4(m.block, r, c))
    end function

    @it("ignores diagonal neighbours")
    function _()
      rows = [
        "c.c",
        ".c.",
        "c.c"
      ]
      m.assertEqual(0, BGE.TileMap.getNeighbourMask4(rows, 1, 1))
    end function

    @it("treats out-of-map neighbours as matching by default")
    function _()
      m.assertEqual(15, BGE.TileMap.getNeighbourMask4(["c"], 0, 0))
    end function

    @it("treats out-of-map neighbours as differing when outOfBoundsMatches is false")
    function _()
      m.assertEqual(0, BGE.TileMap.getNeighbourMask4(["c"], 0, 0, {outOfBoundsMatches: false}))
    end function

    @it("treats a row too short to reach a column as out of the map")
    function _()
      rows = [
        "c",
        "cc"
      ]
      m.assertEqual(8, BGE.TileMap.getNeighbourMask4(rows, 1, 1, {outOfBoundsMatches: false}))
    end function

    @describe("getNeighbourMask8")

    @it("sets bits clockwise from N for matching neighbours")
    @params(1, 1, 28)
    @params(2, 2, 255)
    @params(3, 3, 193)
    function _(r as integer, c as integer, expected as integer)
      m.assertEqual(expected, BGE.TileMap.getNeighbourMask8(m.block, r, c))
    end function

    @it("includes diagonals")
    function _()
      rows = [
        "c.c",
        ".c.",
        "c.c"
      ]
      m.assertEqual(2 + 8 + 32 + 128, BGE.TileMap.getNeighbourMask8(rows, 1, 1))
    end function

    @describe("reduceBlobMask")

    @it("clears a corner bit unless both sides next to it are set")
    @params(2, 0)
    @params(3, 1)
    @params(7, 7)
    @params(254, 124)
    @params(255, 255)
    function _(mask8 as integer, expected as integer)
      m.assertEqual(expected, BGE.TileMap.reduceBlobMask(mask8))
    end function

    @it("reduces every mask to one of 47 values")
    function _()
      seen = {}
      for mask = 0 to 255
        seen[BGE.TileMap.reduceBlobMask(mask).toStr()] = true
      end for
      m.assertEqual(47, seen.count())
    end function

    @describe("getBlobTileIndex")

    @it("numbers the 47 tiles 0-46 in ascending reduced-mask order")
    @params(0, 0)
    @params(1, 1)
    @params(4, 2)
    @params(7, 4)
    @params(255, 46)
    function _(mask8 as integer, expected as integer)
      m.assertEqual(expected, BGE.TileMap.getBlobTileIndex(mask8))
    end function

    @it("gives masks that only differ in an unsupported corner the same tile")
    function _()
      m.assertEqual(BGE.TileMap.getBlobTileIndex(1), BGE.TileMap.getBlobTileIndex(1 + 2 + 128))
    end function

    @it("tells an inner corner apart from a fully surrounded cell")
    function _()
      rows = [
        "cc.",
        "ccc",
        "ccc"
      ]
      innerCorner = BGE.TileMap.getBlobTileIndex(BGE.TileMap.getNeighbourMask8(rows, 1, 1))
      m.assertEqual(45, innerCorner)
    end function

    @describe("getEdgePiece3x3")

    @it("picks the matching edge/corner piece for each cell of a 3x3 block")
    @params(1, 1, 0, 0)
    @params(1, 2, 1, 0)
    @params(1, 3, 2, 0)
    @params(2, 1, 0, 1)
    @params(2, 2, 1, 1)
    @params(2, 3, 2, 1)
    @params(3, 1, 0, 2)
    @params(3, 2, 1, 2)
    @params(3, 3, 2, 2)
    function _(r as integer, c as integer, expectedCol as integer, expectedRow as integer)
      piece = BGE.TileMap.getEdgePiece3x3(m.block, r, c)
      m.assertEqual(expectedCol, piece.col)
      m.assertEqual(expectedRow, piece.row)
    end function

    @it("uses the centre piece for a one-cell-wide run (both sides differ)")
    function _()
      rows = [
        "...",
        ".c.",
        ".c.",
        ".c.",
        "..."
      ]
      piece = BGE.TileMap.getEdgePiece3x3(rows, 2, 1)
      m.assertEqual(1, piece.col)
      m.assertEqual(1, piece.row)
    end function

    @it("uses the centre piece for an inner corner (only a diagonal differs)")
    function _()
      rows = [
        "cc.",
        "ccc",
        "ccc"
      ]
      piece = BGE.TileMap.getEdgePiece3x3(rows, 1, 1)
      m.assertEqual(1, piece.col)
      m.assertEqual(1, piece.row)
    end function

    @it("treats out-of-map neighbours as the same surface")
    function _()
      rows = [
        "cc",
        "cc"
      ]
      piece = BGE.TileMap.getEdgePiece3x3(rows, 0, 0)
      m.assertEqual(1, piece.col)
      m.assertEqual(1, piece.row)
    end function

    @it("draws a border at the map edge when outOfBoundsMatches is false")
    function _()
      rows = [
        "cc",
        "cc"
      ]
      piece = BGE.TileMap.getEdgePiece3x3(rows, 0, 0, {outOfBoundsMatches: false})
      m.assertEqual(0, piece.col)
      m.assertEqual(0, piece.row)
    end function

    @it("treats a different path surface as a differing neighbour")
    function _()
      piece = BGE.TileMap.getEdgePiece3x3(["cct"], 0, 1)
      m.assertEqual(2, piece.col)
    end function

  end class
end namespace
