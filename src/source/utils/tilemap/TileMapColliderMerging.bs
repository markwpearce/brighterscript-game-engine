namespace BGE.TileMap

  ' One occupied collision cell in a tile grid, addressed by integer row/column - merging is
  ' pure adjacency in grid space, so world position doesn't come into it at all (unlike
  ' bakeTileMapImages(), which bakes pixels and therefore does need world position/chunking).
  interface ColliderCell
    row as integer
    col as integer
    tag as string
  end interface

  ' One merged run of contiguous same-tag cells within a single row.
  interface MergedColliderRun
    row as integer
    startCol as integer
    endCol as integer ' inclusive
    tag as string
  end interface

  ' Merges a sparse grid of tagged collision cells into the minimal set of same-tag,
  ' contiguous-column runs per row - e.g. a solid platformer floor 20 tiles wide becomes one
  ' run instead of 20 separate per-tile colliders. Input order doesn't matter (cells are
  ' grouped/sorted internally); a gap in columns or a change in tag always starts a new run.
  ' Only merges within a single row - two vertically stacked identical runs are NOT combined
  ' into one taller rectangle (that's a further optimization, not implemented here - see
  ' bakeTileMapImages() for where the bigger per-frame cost actually lives).
  '
  ' @param {BGE.TileMap.ColliderCell[]} cells
  ' @return {BGE.TileMap.MergedColliderRun[]}
  function mergeTileColliderRuns(cells as BGE.TileMap.ColliderCell[]) as BGE.TileMap.MergedColliderRun[]
    cellsByRow = {}
    rows = []
    for each cell in cells
      rowKey = cell.row.toStr()
      if cellsByRow[rowKey] = invalid
        cellsByRow[rowKey] = []
        rows.push(cell.row)
      end if
      cellsByRow[rowKey].push(cell)
    end for
    ' Iterate rows in ascending order - a plain AA's key iteration order (insertion order)
    ' would otherwise depend on which row happened to appear first in the input.
    rows.sort()

    runs = []
    for each row in rows
      rowCells = cellsByRow[row.toStr()]
      rowCells.sortBy("col")

      currentRun = invalid
      for each cell in rowCells
        if currentRun <> invalid and cell.col = currentRun.endCol + 1 and cell.tag = currentRun.tag
          currentRun.endCol = cell.col
        else
          if currentRun <> invalid
            runs.push(currentRun)
          end if
          currentRun = {row: cell.row, startCol: cell.col, endCol: cell.col, tag: cell.tag}
        end if
      end for
      if currentRun <> invalid
        runs.push(currentRun)
      end if
    end for

    return runs
  end function

end namespace
