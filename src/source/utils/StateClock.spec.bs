import "pkg:/source/utils/StateClock.bs"

namespace tests

  @suite("BGE.StateClock")
  class StateClockTests extends rooibos.BaseTestSuite

    @describe("set / seconds")

    @it("starts in the given state, not just entered")
    function _()
      clock = new BGE.StateClock("idle")
      m.assertEqual(clock.state, "idle")
      clock.update(0.25)
      m.assertFalse(clock.justEntered())
      m.assertEqual(clock.seconds, 0.25)
    end function

    @it("resets seconds on a new state and remembers the previous one")
    function _()
      clock = new BGE.StateClock("idle")
      clock.update(1)
      m.assertTrue(clock.set("run"))
      m.assertEqual(clock.seconds, 0.0)
      m.assertEqual(clock.previousState, "idle")
      clock.update(0.5)
      m.assertEqual(clock.seconds, 0.5)
    end function

    @it("setting the same state does nothing unless restart")
    function _()
      clock = new BGE.StateClock("run")
      clock.update(1)
      m.assertFalse(clock.set("run"))
      m.assertEqual(clock.seconds, 1.0)
      m.assertTrue(clock.set("run", true))
      m.assertEqual(clock.seconds, 0.0)
    end function

    @describe("justEntered")

    @it("is true for the first update after entering only")
    function _()
      clock = new BGE.StateClock("idle")
      clock.set("attack")
      m.assertFalse(clock.justEntered())
      clock.update(0.1)
      m.assertTrue(clock.justEntered())
      clock.update(0.1)
      m.assertFalse(clock.justEntered())
    end function

    @it("turns false when another state is entered mid-update")
    function _()
      clock = new BGE.StateClock("idle")
      clock.set("attack")
      clock.update(0.1)
      clock.set("hurt")
      m.assertFalse(clock.justEntered())
      clock.update(0.1)
      m.assertTrue(clock.justEntered())
    end function

    @describe("setTimed")

    @it("times out after its duration")
    function _()
      clock = new BGE.StateClock()
      clock.setTimed("tell", 0.5)
      m.assertFalse(clock.isTimeUp())
      m.assertEqual(clock.remainingFraction(), 1.0)
      clock.update(0.25)
      m.assertEqual(clock.remaining(), 0.25)
      m.assertEqual(clock.remainingFraction(), 0.5)
      clock.update(0.5)
      m.assertTrue(clock.isTimeUp())
      m.assertEqual(clock.remainingFraction(), 0.0)
      m.assertEqual(clock.state, "tell")
    end function

    @it("re-enters the same state afresh")
    function _()
      clock = new BGE.StateClock()
      clock.setTimed("tell", 0.5)
      clock.update(0.5)
      clock.setTimed("tell", 0.25)
      m.assertFalse(clock.isTimeUp())
      m.assertEqual(clock.seconds, 0.0)
    end function

    @it("a set() state never times out")
    function _()
      clock = new BGE.StateClock()
      clock.setTimed("tell", 0.25)
      clock.set("walk")
      clock.update(1)
      m.assertFalse(clock.isTimeUp())
      m.assertEqual(clock.remaining(), 0.0)
      m.assertEqual(clock.remainingFraction(), 0.0)
    end function

    @describe("play")

    @it("switches the animation only when it changes, or on restart")
    function _()
      clock = new tests.RecordingStateClock()
      clock.play("idle")
      clock.play("idle")
      clock.play("run")
      clock.play("run", true)
      m.assertEqual(clock.played.join(","), "idle:false,run:false,run:true")
      m.assertEqual(clock.animation, "run")
    end function

    @it("does nothing without a sprite")
    function _()
      clock = new BGE.StateClock()
      clock.play("idle")
      m.assertEqual(clock.animation, "idle")
    end function

    @describe("onEnter")

    @it("is called on each entry with the previous state")
    function _()
      clock = new tests.RecordingStateClock()
      clock.set("a")
      clock.set("a")
      clock.setTimed("b", 1)
      m.assertEqual(clock.entries.join(","), ">a,a>b")
    end function

  end class

  class RecordingStateClock extends BGE.StateClock
    played as string[] = []
    entries as string[] = []

    sub new()
      super("")
    end sub

    protected override sub playAnimation(animation as string, restart as boolean)
      m.played.push(animation + ":" + restart.toStr())
    end sub

    protected override sub onEnter(previousState as string)
      m.entries.push(previousState + ">" + m.state)
    end sub
  end class

end namespace
