import "pkg:/source/utils/RegenPool.bs"

namespace tests

  @suite("BGE.RegenPool")
  class RegenPoolTests extends rooibos.BaseTestSuite

    @describe("spend")

    @it("starts full and spends what's asked")
    function _()
      pool = new BGE.RegenPool(100)
      m.assertEqual(pool.current, 100.0)
      m.assertTrue(pool.spend(30))
      m.assertEqual(pool.current, 70.0)
    end function

    @it("lets any amount left start an action, stopping at zero")
    function _()
      pool = new BGE.RegenPool(100)
      pool.current = 10.0
      m.assertTrue(pool.spend(30))
      m.assertEqual(pool.current, 0.0)
    end function

    @it("refuses when empty and starts the denied window")
    function _()
      pool = new BGE.RegenPool(100)
      pool.current = 0.0
      m.assertFalse(pool.isDenied())
      m.assertFalse(pool.spend(10))
      m.assertTrue(pool.isDenied())
      m.assertEqual(pool.deniedRemaining(), 0.4)
      pool.update(0.5)
      m.assertFalse(pool.isDenied())
    end function

    @it("with requireFullAmount, refuses unless the whole amount is there")
    function _()
      pool = new BGE.RegenPool(100)
      pool.requireFullAmount = true
      pool.current = 20.0
      m.assertFalse(pool.canSpend(30))
      m.assertFalse(pool.spend(30))
      m.assertEqual(pool.current, 20.0)
      m.assertTrue(pool.spend(20))
      m.assertEqual(pool.current, 0.0)
    end function

    @describe("drain")

    @it("overdraws, reporting whether the pool covered it")
    function _()
      pool = new BGE.RegenPool(100)
      pool.current = 40.0
      m.assertTrue(pool.drain(40))
      pool.current = 40.0
      m.assertFalse(pool.drain(60))
      m.assertEqual(pool.current, 0.0)
    end function

    @describe("update")

    @it("waits regenDelaySeconds after a spend, then regenerates up to max")
    function _()
      pool = new BGE.RegenPool(100)
      pool.regenPerSecond = 50
      pool.regenDelaySeconds = 0.5
      pool.spend(60)
      pool.update(0.25)
      m.assertEqual(pool.current, 40.0)
      pool.update(0.25)
      m.assertEqual(pool.current, 52.5)
      pool.update(2)
      m.assertEqual(pool.current, 100.0)
    end function

    @it("regenerates at slowedRegenFactor of the rate when slowed")
    function _()
      pool = new BGE.RegenPool(100)
      pool.regenDelaySeconds = 0
      pool.regenPerSecond = 40
      pool.slowedRegenFactor = 0.5
      pool.current = 0.0
      pool.update(1, true)
      m.assertEqual(pool.current, 20.0)
    end function

    @describe("refill / fraction")

    @it("refills to max and reports the fraction")
    function _()
      pool = new BGE.RegenPool(200)
      pool.spend(50)
      m.assertEqual(pool.fraction(), 0.75)
      pool.refill()
      m.assertEqual(pool.fraction(), 1.0)
    end function

  end class

end namespace
