import "../../engine/drawables/Model3d.bs"
import "../../engine/loading/LoadTask.bs"

namespace BGE.Parsers

  ' Base class for the step-by-step model parsers (`OBJParseTask`, `STLAsciiParseTask`,
  ' `STLBinaryParseTask`). `model` is set once `step()` returns true, and stays `invalid` if the
  ' content couldn't be parsed.
  class ModelParseTask extends BGE.LoadTask

    ' The parsed model, once done
    model as BGE.Model3d = invalid

  end class

end namespace
