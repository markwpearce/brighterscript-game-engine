namespace tests

  @suite("BGE.Parsers (OBJ)")
  class OBJParserTests extends rooibos.BaseTestSuite

    @describe("a minimal single-triangle .obj")

    @it("parses the object's name and its one face's vertices, computing a normal from the geometry")
    function _()
      obj = "o triangle" + Chr(10) +
        "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "f 1 2 3"

      model = BGE.Parsers.parseOBJContent(obj)

      m.assertEqual("triangle", model.name)
      m.assertEqual(1, model.faces.count())

      face = model.faces[0]
      m.assertEqual(3, face.vertices.count())
      m.assertTrue(BGE.Math.VectorOps.equals(face.vertices[1], BGE.Math.VectorOps.create(1, 0, 0)))
      m.assertTrue(BGE.Math.VectorOps.equals(face.normal, BGE.Math.VectorOps.create(0, 0, 1)))
    end function

    @it("defaults to a name when no o/g line is present")
    function _()
      obj = "v 0 0 0" + Chr(10) + "v 1 0 0" + Chr(10) + "v 0 1 0" + Chr(10) + "f 1 2 3"
      model = BGE.Parsers.parseOBJContent(obj)
      m.assertEqual("OBJModel", model.name)
    end function

    @describe("face vertex index formats")

    @it("resolves v/vt/vn tokens to the same vertices as bare v tokens")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "vt 0 0" + Chr(10) +
        "vt 1 0" + Chr(10) +
        "vt 0 1" + Chr(10) +
        "vn 0 0 1" + Chr(10) +
        "f 1/1/1 2/2/1 3/3/1"

      model = BGE.Parsers.parseOBJContent(obj)

      m.assertEqual(1, model.faces.count())
      face = model.faces[0]
      m.assertTrue(BGE.Math.VectorOps.equals(face.vertices[0], BGE.Math.VectorOps.create(0, 0, 0)))
      m.assertTrue(BGE.Math.VectorOps.equals(face.vertices[2], BGE.Math.VectorOps.create(0, 1, 0)))
    end function

    @it("resolves v//vn tokens (no texture coordinate)")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "vn 0 0 1" + Chr(10) +
        "f 1//1 2//1 3//1"

      model = BGE.Parsers.parseOBJContent(obj)
      m.assertEqual(1, model.faces.count())
    end function

    @it("resolves negative (relative) indices, per the .obj spec")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "f -3 -2 -1"

      model = BGE.Parsers.parseOBJContent(obj)
      m.assertEqual(1, model.faces.count())
      face = model.faces[0]
      m.assertTrue(BGE.Math.VectorOps.equals(face.vertices[1], BGE.Math.VectorOps.create(1, 0, 0)))
    end function

    @describe("n-gon triangulation")

    @it("fan-triangulates a quad face into 2 triangles")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 1 1 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "f 1 2 3 4"

      model = BGE.Parsers.parseOBJContent(obj)

      m.assertEqual(2, model.faces.count())
      m.assertTrue(BGE.Math.VectorOps.equals(model.faces[0].vertices[0], BGE.Math.VectorOps.create(0, 0, 0)))
      m.assertTrue(BGE.Math.VectorOps.equals(model.faces[1].vertices[0], BGE.Math.VectorOps.create(0, 0, 0)))
    end function

    @describe("texture coordinates (vt)")

    @it("resolves per-corner vt indices into normalized UV points on each face's Texture")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "vt 0 0" + Chr(10) +
        "vt 1 0" + Chr(10) +
        "vt 0.5 1" + Chr(10) +
        "f 1/1 2/2 3/3"

      model = BGE.Parsers.parseOBJContent(obj)

      m.assertEqual(1, model.faces.count())
      texture = model.faces[0].Texture
      m.assertNotInvalid(texture)
      m.assertTrue(BGE.Math.VectorOps.equals(texture.points[0], BGE.Math.VectorOps.create(0, 0, 0)))
      m.assertTrue(BGE.Math.VectorOps.equals(texture.points[1], BGE.Math.VectorOps.create(1, 0, 0)))
      m.assertTrue(BGE.Math.VectorOps.equals(texture.points[2], BGE.Math.VectorOps.create(0.5, 1, 0)))
    end function

    @it("resolves vt from v/vt/vn tokens the same as v/vt tokens")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "vt 0 0" + Chr(10) +
        "vt 1 0" + Chr(10) +
        "vt 0.5 1" + Chr(10) +
        "vn 0 0 1" + Chr(10) +
        "f 1/1/1 2/2/1 3/3/1"

      model = BGE.Parsers.parseOBJContent(obj)
      m.assertNotInvalid(model.faces[0].Texture)
    end function

    @it("gives no Texture at all when any corner is missing a vt index (v//vn / bare v)")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "vn 0 0 1" + Chr(10) +
        "f 1//1 2//1 3//1"

      model = BGE.Parsers.parseOBJContent(obj)
      m.assertInvalid(model.faces[0].Texture)
    end function

    @it("fans a textured quad's UVs the same way it fans vertices")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 1 1 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "vt 0 0" + Chr(10) +
        "vt 1 0" + Chr(10) +
        "vt 1 1" + Chr(10) +
        "vt 0 1" + Chr(10) +
        "f 1/1 2/2 3/3 4/4"

      model = BGE.Parsers.parseOBJContent(obj)

      m.assertEqual(2, model.faces.count())
      m.assertNotInvalid(model.faces[0].Texture)
      m.assertNotInvalid(model.faces[1].Texture)
      ' Both triangles' first UV corner is the fan's shared origin corner (vt index 1: 0,0)
      m.assertTrue(BGE.Math.VectorOps.equals(model.faces[0].Texture.points[0], BGE.Math.VectorOps.create(0, 0, 0)))
      m.assertTrue(BGE.Math.VectorOps.equals(model.faces[1].Texture.points[0], BGE.Math.VectorOps.create(0, 0, 0)))
    end function

    @describe("joinObjPath")

    @it("joinObjPath joins a baseDir without a trailing slash")
    function _()
      m.assertEqual("pkg:/models/car.mtl", BGE.Parsers.joinObjPath("pkg:/models", "car.mtl"))
    end function

    @it("joinObjPath joins a baseDir that already has a trailing slash")
    function _()
      m.assertEqual("pkg:/models/car.mtl", BGE.Parsers.joinObjPath("pkg:/models/", "car.mtl"))
    end function

    @describe("materials (usemtl / newmtl)")

    @it("gives each face the material named by the last usemtl before it")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "f 1 2 3" + Chr(10) +
        "usemtl stone" + Chr(10) +
        "f 1 2 3" + Chr(10) +
        "usemtl slate" + Chr(10) +
        "f 1 2 3"

      model = BGE.Parsers.parseOBJContent(obj)
      m.assertInvalid(model.faces[0].material)
      m.assertEqual("stone", model.faces[1].material)
      m.assertEqual("slate", model.faces[2].material)
    end function

    @it("parseMTLContent reads each material's name, map_Kd and Kd")
    function _()
      mtl = "newmtl stone" + Chr(10) +
        "Kd 1 0 0.5" + Chr(10) +
        "map_Kd textures/stone.png" + Chr(10) +
        "" + Chr(10) +
        "newmtl plain" + Chr(10) +
        "Kd 0 1 0"

      materials = BGE.Parsers.parseMTLContent(mtl)
      m.assertEqual(2, materials.count())
      m.assertEqual("stone", materials[0].name)
      m.assertEqual("textures/stone.png", materials[0].texturePath)
      m.assertEqual(&hFF0080FF, materials[0].color)
      m.assertEqual("plain", materials[1].name)
      m.assertEqual("", materials[1].texturePath)
      m.assertEqual(&h00FF00FF, materials[1].color)
    end function

    @it("parseMTLContent skips option flags before a map_Kd filename")
    function _()
      materials = BGE.Parsers.parseMTLContent("newmtl m" + Chr(10) + "map_Kd -s 1 1 1 -o 0 0 0 -clamp on diffuse.png")
      m.assertEqual("diffuse.png", materials[0].texturePath)
    end function

    @it("parseMTLContent reads names and filenames with spaces, and tab-separated lines")
    function _()
      mtl = "newmtl Old Stone" + Chr(10) +
        "map_Kd" + Chr(9) + "-bm 0.5 my stone.png" + Chr(10) +
        "newmtl" + Chr(9) + "slate" + Chr(10) +
        Chr(9) + "Kd" + Chr(9) + "0" + Chr(9) + "0 1"

      materials = BGE.Parsers.parseMTLContent(mtl)
      m.assertEqual("Old Stone", materials[0].name)
      m.assertEqual("my stone.png", materials[0].texturePath)
      m.assertEqual("slate", materials[1].name)
      m.assertEqual(&h0000FFFF, materials[1].color)
    end function

    @it("reads usemtl and mtllib names with spaces")
    function _()
      obj = "mtllib my house.mtl" + Chr(10) +
        "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "usemtl" + Chr(9) + "Old Stone" + Chr(10) +
        "f 1 2 3"

      task = new BGE.Parsers.OBJParseTask(obj, "")
      while not task.step(1000)
      end while
      m.assertEqual("my house.mtl", task.mtllibName)
      m.assertEqual("Old Stone", task.model.faces[0].material)
    end function

    @it("parseMTLContent leaves color unset when a material has no Kd")
    function _()
      materials = BGE.Parsers.parseMTLContent("newmtl m" + Chr(10) + "map_Kd a.png")
      m.assertInvalid(materials[0].color)
    end function

    @it("parseOBJFile resolves every material's texture against the .mtl's folder")
    function _()
      fs = CreateObject("roFileSystem")
      fs.CreateDirectory("tmp:/bge_objmats")
      fs.CreateDirectory("tmp:/bge_objmats/mats")
      WriteAsciiFile("tmp:/bge_objmats/mats/house.mtl", "newmtl wall" + Chr(10) + "map_Kd tex/wall.png" + Chr(10) + "newmtl roof" + Chr(10) + "map_Kd tex/roof.png")
      obj = "mtllib mats/house.mtl" + Chr(10) +
        "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "usemtl roof" + Chr(10) +
        "f 1 2 3"
      WriteAsciiFile("tmp:/bge_objmats/house.obj", obj)

      model = BGE.Parsers.parseOBJFile("tmp:/bge_objmats/house.obj")
      m.assertEqual("tmp:/bge_objmats/mats/tex/wall.png", model.materials["wall"].texturePath)
      m.assertEqual("tmp:/bge_objmats/mats/tex/roof.png", model.materials["roof"].texturePath)
      ' faces with no material use the first texture
      m.assertEqual("tmp:/bge_objmats/mats/tex/wall.png", model.texturePath)
    end function

    @describe("lines this parser ignores")

    @it("ignores mtllib/usemtl/comments/blank lines without affecting parsed faces")
    function _()
      obj = "# a comment" + Chr(10) +
        "mtllib capsule.mtl" + Chr(10) +
        "" + Chr(10) +
        "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "usemtl material0" + Chr(10) +
        "f 1 2 3"

      model = BGE.Parsers.parseOBJContent(obj)
      m.assertEqual(1, model.faces.count())
    end function

    @describe("multiple faces")

    @it("parses every face into its own triangle")
    function _()
      obj = "v 0 0 0" + Chr(10) +
        "v 1 0 0" + Chr(10) +
        "v 1 1 0" + Chr(10) +
        "v 0 1 0" + Chr(10) +
        "f 1 2 3" + Chr(10) +
        "f 1 3 4"

      model = BGE.Parsers.parseOBJContent(obj)
      m.assertEqual(2, model.faces.count())
    end function

  end class

end namespace
