import "../engine/GameEntity.bs"

namespace BGE

  ' Something the player can interact with - see BGE.Interactables.
  class Interactable
    entity as BGE.GameEntity
    id as string = ""
    ' Shown in the prompt, e.g. "Talk to Bram".
    label as string = ""
    ' A disabled interactable is never picked.
    enabled as boolean = true
    ' Its body radius in world units, so it counts as soon as its edge is in reach (arcs only).
    radius as float = 0
    ' Anything else the game wants to keep with it (a story node, a shop id...).
    data as dynamic = invalid

    sub new(entity as BGE.GameEntity, id as string, label as string, data as dynamic)
      m.entity = entity
      m.id = id
      m.label = label
      m.data = data
    end sub
  end class

end namespace
