namespace tests

  @suite("BGE.Tiled (parser)")
  class TiledParserTests extends rooibos.BaseTestSuite

    @describe("a real image-collection map with object layers")

    @it("reads the map header")
    function _()
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.stickerKnightTitleJson(), "pkg:/ui")
      m.assertEqual(38, map.width)
      m.assertEqual(26, map.height)
      m.assertEqual(32, map.tileWidth)
      m.assertEqual(32, map.tileHeight)
      m.assertEqual("#3b97d3", map.backgroundColor)
      m.assertEqual(2, map.layers.count())
    end function

    @it("reads object layers and their tile objects")
    function _()
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.stickerKnightTitleJson(), "pkg:/ui")
      layer = map.layers[1] as BGE.Tiled.TiledLayer
      m.assertEqual("objectgroup", layer.type)
      m.assertEqual("background-far", layer.name)
      m.assertEqual(6, layer.id)
      m.assertTrue(layer.visible)
      m.assertEqual(0.57, layer.opacity)
      m.assertEqual(2, layer.objects.count())
      obj = layer.objects[0] as BGE.Tiled.TiledObject
      m.assertEqual("tile", obj.shape)
      m.assertEqual(8, obj.id)
      m.assertEqual(6, obj.gid)
      m.assertEqual(-226.0, obj.x)
      m.assertEqual(768.0, obj.y)
      m.assertEqual(954.0, obj.width)
      m.assertEqual(600.0, obj.height)
      m.assertEqual("", obj.type)
      m.assertEqual(0, obj.properties.count())
    end function

    @it("reads an image collection with its images resolved against the map's folder")
    function _()
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.stickerKnightTitleJson(), "pkg:/ui")
      m.assertEqual(1, map.tilesets.count())
      tileset = map.tilesets[0] as BGE.Tiled.TiledTileset
      m.assertEqual(1, tileset.firstGid)
      m.assertEqual("ui", tileset.name)
      m.assertEqual(0, tileset.columns)
      m.assertEqual(7, tileset.tileCount)
      m.assertEqual("", tileset.image)
      m.assertEqual("tile", tileset.tileRenderSize)
      tile = tileset.tiles["5"] as BGE.Tiled.TiledTile
      m.assertEqual(5, tile.id)
      m.assertEqual("pkg:/ui/backgroundSet.png", tile.image)
      m.assertEqual(1232, tile.imageWidth)
      m.assertEqual(832, tile.imageHeight)
      m.assertInvalid(tileset.tiles["4"])
    end function

    @describe("a real spritesheet map with a tile layer")

    @it("reads the tile layer's GIDs row by row")
    function _()
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.bulkAnimationsMapJson(), "pkg:/maps")
      m.assertEqual(1, map.layers.count())
      layer = map.layers[0] as BGE.Tiled.TiledLayer
      m.assertEqual("tilelayer", layer.type)
      m.assertEqual("Tile Layer 1", layer.name)
      m.assertEqual(6, layer.width)
      m.assertEqual(2, layer.height)
      m.assertEqual([1, 2, 3, 0, 91, 92, 7, 8, 9, 0, 103, 104], layer.data)
      m.assertEqual("", map.backgroundColor)
    end function

    @it("reads every embedded spritesheet tileset")
    function _()
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.bulkAnimationsMapJson(), "pkg:/maps")
      m.assertEqual(3, map.tilesets.count())
      m.assertEqual(91, map.tilesets[1].firstGid)
      m.assertEqual(199, map.tilesets[2].firstGid)
      tileset = map.tilesets[0] as BGE.Tiled.TiledTileset
      m.assertEqual("pkg:/maps/test_tileset_rect1.png", tileset.image)
      m.assertEqual(192, tileset.imageWidth)
      m.assertEqual(480, tileset.imageHeight)
      m.assertEqual(6, tileset.columns)
      m.assertEqual(90, tileset.tileCount)
      m.assertEqual(32, tileset.tileWidth)
      m.assertEqual(0, tileset.margin)
      ' The animated tile still gets an entry; its animation is skipped
      m.assertEqual(0, tileset.tiles["0"].id)
    end function

    @describe("normalising")

    @it("turns property lists into name -> value lookups")
    function _()
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({
        properties: [{name: "music", type: "string", value: "cave"}, {name: "gravity", type: "float", value: 9.5}]
      }), "")
      m.assertEqual("cave", map.properties.music)
      m.assertEqual(9.5, map.properties.gravity)
    end function

    @it("reads Tiled 1.9+'s class as type")
    function _()
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({
        layers: [tests.TiledFixtures.objectLayer("spawns", [{id: 1, "class": "coin", x: 10, y: 20, point: true}])]
      }), "")
      obj = map.layers[0].objects[0] as BGE.Tiled.TiledObject
      m.assertEqual("coin", obj.type)
      m.assertEqual("point", obj.shape)
    end function

    @it("reads each object shape")
    function _()
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({
        layers: [tests.TiledFixtures.objectLayer("shapes", [
          {id: 1, x: 0, y: 0, width: 10, height: 10},
          {id: 2, x: 0, y: 0, ellipse: true, width: 10, height: 10},
          {id: 3, x: 5, y: 6, polygon: [{x: 0, y: 0}, {x: 4, y: 0}, {x: 0, y: 3}]},
          {id: 4, x: 0, y: 0, polyline: [{x: 0, y: 0}, {x: 8, y: 8}]},
          {id: 5, x: 0, y: 0, text: {text: "hi"}},
          {id: 6, x: 0, y: 32, gid: 3, width: 32, height: 32}
        ])]
      }), "")
      objects = map.layers[0].objects
      m.assertEqual("rectangle", objects[0].shape)
      m.assertEqual("ellipse", objects[1].shape)
      m.assertEqual("polygon", objects[2].shape)
      m.assertEqual(3, objects[2].points.count())
      m.assertEqual(4.0, objects[2].points[1].x)
      m.assertEqual(3.0, objects[2].points[2].y)
      m.assertEqual("polyline", objects[3].shape)
      m.assertEqual("text", objects[4].shape)
      m.assertEqual("tile", objects[5].shape)
      m.assertEqual(3, objects[5].gid)
      m.assertEqual(0, objects[0].gid)
      m.assertEqual(0, objects[0].points.count())
    end function

    @it("lists a group's layers in its place, with the group's offset and visibility")
    function _()
      inner = tests.TiledFixtures.objectLayer("inner", [])
      inner.offsetx = 1
      inner.offsety = 2
      group = {type: "group", id: 9, name: "group", visible: false, offsetx: 10, offsety: 20, layers: [inner]}
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({
        layers: [tests.TiledFixtures.objectLayer("before", []), group, tests.TiledFixtures.objectLayer("after", [])]
      }), "")
      m.assertEqual(3, map.layers.count())
      m.assertEqual("before", map.layers[0].name)
      m.assertEqual("inner", map.layers[1].name)
      m.assertEqual("after", map.layers[2].name)
      m.assertEqual(11.0, map.layers[1].offsetX)
      m.assertEqual(22.0, map.layers[1].offsetY)
      m.assertFalse(map.layers[1].visible)
      m.assertTrue(map.layers[2].visible)
    end function

    @it("decodes uncompressed base64 layer data")
    function _()
      ' GIDs 1, 2147483654 (6 flipped horizontally), 0, 3 as little-endian uint32s
      ba = CreateObject("roByteArray")
      for each b in [1, 0, 0, 0, 6, 0, 0, 128, 0, 0, 0, 0, 3, 0, 0, 0]
        ba.push(b)
      end for
      layer = {type: "tilelayer", id: 1, name: "ground", width: 2, height: 2, encoding: "base64", data: ba.ToBase64String()}
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({width: 2, height: 2, layers: [layer]}), "")
      data = map.layers[0].data
      m.assertEqual(4, data.count())
      m.assertEqual(1, data[0])
      m.assertEqual(2147483654&, data[1])
      m.assertEqual(0, data[2])
      m.assertEqual(3, data[3])
    end function

    @it("reads tile offset and render size from a tileset")
    function _()
      tileset = {firstgid: 1, name: "t", tilecount: 1, columns: 0, tilewidth: 16, tileheight: 16, tileoffset: {x: 2, y: -5}, tilerendersize: "grid", tiles: []}
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({tilesets: [tileset]}), "")
      m.assertEqual(2, map.tilesets[0].tileOffsetX)
      m.assertEqual(-5, map.tilesets[0].tileOffsetY)
      m.assertEqual("grid", map.tilesets[0].tileRenderSize)
    end function

    @it("sorts tilesets by firstGid")
    function _()
      a = {firstgid: 50, name: "b", tilecount: 1, columns: 1, tilewidth: 16, tileheight: 16, image: "b.png", imagewidth: 16, imageheight: 16}
      b = {firstgid: 1, name: "a", tilecount: 49, columns: 7, tilewidth: 16, tileheight: 16, image: "a.png", imagewidth: 112, imageheight: 112}
      map = BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({tilesets: [a, b]}), "")
      m.assertEqual("a", map.tilesets[0].name)
      m.assertEqual("b", map.tilesets[1].name)
    end function

    @describe("files")

    @it("loads an external .tsj tileset relative to the map, and its image relative to the tileset")
    function _()
      fs = CreateObject("roFileSystem")
      fs.CreateDirectory("tmp:/bge_tiled")
      fs.CreateDirectory("tmp:/bge_tiled/maps")
      fs.CreateDirectory("tmp:/bge_tiled/tilesets")
      WriteAsciiFile("tmp:/bge_tiled/tilesets/ground.tsj", FormatJson({type: "tileset", name: "ground", tilecount: 4, columns: 2, tilewidth: 16, tileheight: 16, image: "../art/ground.png", imagewidth: 32, imageheight: 32, tiles: [{id: 1, type: "solid", properties: [{name: "collision", type: "string", value: "solid"}]}]}))
      WriteAsciiFile("tmp:/bge_tiled/maps/level.tmj", tests.TiledFixtures.mapJson({tilesets: [{firstgid: 1, source: "../tilesets/ground.tsj"}]}))

      map = BGE.Tiled.parseMapFile("tmp:/bge_tiled/maps/level.tmj")

      tileset = map.tilesets[0] as BGE.Tiled.TiledTileset
      m.assertEqual(1, tileset.firstGid)
      m.assertEqual("ground", tileset.name)
      m.assertEqual("tmp:/bge_tiled/art/ground.png", tileset.image)
      m.assertEqual("solid", tileset.tiles["1"].type)
      m.assertEqual("solid", tileset.tiles["1"].properties.collision)
    end function

    @it("returns invalid for a missing file or tileset")
    function _()
      m.assertInvalid(BGE.Tiled.parseMapFile("tmp:/bge_tiled/nope.tmj"))
      m.assertInvalid(BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({tilesets: [{firstgid: 1, source: "missing.tsj"}]}), "tmp:/bge_tiled"))
    end function

    @describe("unsupported maps")

    @it("returns invalid for JSON that isn't a map")
    function _()
      m.assertInvalid(BGE.Tiled.parseMapJson("not json", ""))
      m.assertInvalid(BGE.Tiled.parseMapJson("[1, 2]", ""))
    end function

    @it("returns invalid for infinite and non-orthogonal maps")
    function _()
      m.assertInvalid(BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({infinite: true}), ""))
      m.assertInvalid(BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({orientation: "isometric"}), ""))
    end function

    @it("returns invalid for compressed layer data")
    function _()
      layer = {type: "tilelayer", id: 1, name: "ground", width: 1, height: 1, encoding: "base64", compression: "zlib", data: "eJxjZGBgAAAABAAB"}
      m.assertInvalid(BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({width: 1, height: 1, layers: [layer]}), ""))
    end function

    @it("returns invalid for an XML (.tsx) tileset")
    function _()
      m.assertInvalid(BGE.Tiled.parseMapJson(tests.TiledFixtures.mapJson({tilesets: [{firstgid: 1, source: "ground.tsx"}]}), ""))
    end function

  end class

end namespace

namespace tests.TiledFixtures

  ' A minimal valid map's JSON, with `overrides` replacing its top-level fields.
  function mapJson(overrides as roAssociativeArray) as string
    map = {type: "map", orientation: "orthogonal", renderorder: "right-down", infinite: false, width: 4, height: 3, tilewidth: 16, tileheight: 16, layers: [], tilesets: []}
    map.append(overrides)
    return FormatJson(map)
  end function

  function objectLayer(name as string, objects as roArray) as roAssociativeArray
    return {type: "objectgroup", id: 1, name: name, visible: true, opacity: 1, x: 0, y: 0, objects: objects}
  end function

  ' Tiled's examples/sticker-knight/ui/title.json (Tiled 1.8.2, public domain): first two layers, two objects each.
  function stickerKnightTitleJson() as string
    s = ""
    s += "{""backgroundcolor"":""#3b97d3"",""compressionlevel"":-1,""height"":26,""infinite"":false,""layers"":["
    s += "{""draworder"":""topdown"",""id"":1,""name"":""background-near"",""objects"":[{""gid"":7,""height"":262.66"
    s += "6666666667,""id"":11,""name"":""ground"",""rotation"":0,""type"":"""",""visible"":true,""width"":1736,""x"":"
    s += "-256,""y"":920.666666666667},{""gid"":6,""height"":832,""id"":34,""name"":"""",""rotation"":0,""type"":"""","
    s += """visible"":true,""width"":1216,""x"":122,""y"":810}],""opacity"":1,""type"":""objectgroup"",""visible"":t"
    s += "rue,""x"":0,""y"":0},{""draworder"":""topdown"",""id"":6,""name"":""background-far"",""objects"":[{""gid"":6"
    s += ",""height"":600,""id"":8,""name"":"""",""rotation"":0,""type"":"""",""visible"":true,""width"":954,""x"":-226,"
    s += """y"":768},{""gid"":2147483654,""height"":546,""id"":35,""name"":"""",""rotation"":0,""type"":"""",""visible"""
    s += ":true,""width"":826,""x"":710,""y"":782}],""opacity"":0.57,""parallaxx"":0.7,""parallaxy"":0.7,""type"":"
    s += """objectgroup"",""visible"":true,""x"":0,""y"":0}],""nextlayerid"":8,""nextobjectid"":39,""orientation"""
    s += ":""orthogonal"",""parallaxoriginx"":608,""parallaxoriginy"":416,""renderorder"":""right-down"",""tile"
    s += "dversion"":""1.8.2"",""tileheight"":32,""tilesets"":[{""columns"":0,""firstgid"":1,""margin"":0,""name"":"
    s += """ui"",""spacing"":0,""tilecount"":7,""tileheight"":832,""tiles"":[{""id"":0,""image"":""buttonHelp.png"","
    s += """imageheight"":64,""imagewidth"":192},{""id"":1,""image"":""buttonStart.png"",""imageheight"":64,""ima"
    s += "gewidth"":192},{""id"":2,""image"":""helpBackground.png"",""imageheight"":416,""imagewidth"":416},{""i"
    s += "d"":3,""image"":""title.png"",""imageheight"":224,""imagewidth"":448},{""id"":5,""image"":""backgroundSe"
    s += "t.png"",""imageheight"":832,""imagewidth"":1232},{""id"":6,""image"":""block.png"",""imageheight"":64,"""
    s += "imagewidth"":64},{""id"":7,""image"":""cloud.png"",""imageheight"":128,""imagewidth"":384}],""tilewidt"
    s += "h"":1232}],""tilewidth"":32,""type"":""map"",""version"":""1.8"",""width"":38}"
    return s
  end function

  ' mapeditor/tiled-bulk-animations src/tests/data/test_map.json (Tiled 1.4.2, MIT): cropped to 6x2 cells and three tilesets.
  function bulkAnimationsMapJson() as string
    s = ""
    s += "{""compressionlevel"":-1,""height"":2,""infinite"":false,""layers"":[{""data"":[1,2,3,0,91,92,7,8,9,"
    s += "0,103,104],""height"":2,""id"":1,""name"":""Tile Layer 1"",""opacity"":1,""type"":""tilelayer"",""visible"
    s += """:true,""width"":6,""x"":0,""y"":0}],""nextlayerid"":2,""nextobjectid"":1,""orientation"":""orthogonal"""
    s += ",""renderorder"":""right-down"",""tiledversion"":""1.4.2"",""tileheight"":32,""tilesets"":[{""columns"":"
    s += "6,""firstgid"":1,""image"":""test_tileset_rect1.png"",""imageheight"":480,""imagewidth"":192,""margin"
    s += """:0,""name"":""test_tileset_rect1"",""spacing"":0,""tilecount"":90,""tileheight"":32,""tiles"":[{""anim"
    s += "ation"":[{""duration"":500,""tileid"":0},{""duration"":500,""tileid"":3}],""id"":0}],""tilewidth"":32,"""
    s += "transparentcolor"":""#ff00ff""},{""columns"":12,""firstgid"":91,""image"":""test_tileset_rect2.png"","
    s += """imageheight"":288,""imagewidth"":384,""margin"":0,""name"":""test_tileset_rect2"",""spacing"":0,""til"
    s += "ecount"":108,""tileheight"":32,""tiles"":[{""animation"":[{""duration"":500,""tileid"":0},{""duration"""
    s += ":500,""tileid"":3}],""id"":0}],""tilewidth"":32,""transparentcolor"":""#ff00ff""},{""columns"":9,""firs"
    s += "tgid"":199,""image"":""test_tileset_square.png"",""imageheight"":288,""imagewidth"":288,""margin"":0,"
    s += """name"":""test_tileset_square"",""spacing"":0,""tilecount"":81,""tileheight"":32,""tiles"":[{""animati"
    s += "on"":[{""duration"":500,""tileid"":0},{""duration"":500,""tileid"":3}],""id"":0}],""tilewidth"":32,""tra"
    s += "nsparentcolor"":""#ff00ff""}],""tilewidth"":32,""type"":""map"",""version"":1.4,""width"":6}"
    return s
  end function

end namespace
