import "TiledTypes.bs"

namespace BGE.Tiled

  ' Looks up what a GID (a tile layer cell, or a tile object's `gid`) refers to: its
  ' tileset, its local id there, its tile entry if it has one, and its flip flags.
  '
  ' Tiled stores flips in a GID's top bits, so a flipped GID is above 2^31. Accepts it
  ' however it arrives: a LongInteger (as ParseJson gives it), a negative Integer, or a Double.
  ' A Float only works below 16777216 (2^24), so never for a flipped GID; bigger Floats count
  ' as empty.
  '
  ' @param {BGE.Tiled.TiledMap} map
  ' @param {dynamic} gid
  ' @return {BGE.Tiled.TiledGidInfo} invalid for an empty cell (0) or a GID no tileset has
  function resolveGid(map as BGE.Tiled.TiledMap, gid as dynamic) as BGE.Tiled.TiledGidInfo
    raw& = toUnsignedGid(gid)
    id = CInt(raw& and 268435455&) ' 0x0FFFFFFF: everything below the four flag bits
    if id = 0
      return invalid
    end if

    tilesets = map.tilesets
    for i = tilesets.count() - 1 to 0 step -1
      tileset = tilesets[i] as BGE.Tiled.TiledTileset
      if tileset.firstGid <= id
        localId = id - tileset.firstGid
        tile = tileset.tiles[localId.toStr()]
        if tileset.columns = 0
          ' An image collection's ids can have gaps where tiles were removed
          if tile = invalid
            return invalid
          end if
        else if localId >= tileset.tileCount
          return invalid
        end if
        return {
          gid: id,
          tileset: tileset,
          localId: localId,
          tile: tile,
          flipH: (raw& and 2147483648&) <> 0,
          flipV: (raw& and 1073741824&) <> 0,
          flipD: (raw& and 536870912&) <> 0
        }
      end if
    end for
    return invalid
  end function

  function toUnsignedGid(gid as dynamic) as longinteger
    if GetInterface(gid, "ifLongInt") <> invalid
      return gid
    end if
    if GetInterface(gid, "ifInt") <> invalid
      value& = gid
      if value& < 0
        value& += 4294967296&
      end if
      return value&
    end if
    if GetInterface(gid, "ifFloat") <> invalid
      ' Past 2^24 a Float has already lost the low bits, so it would name the wrong tile
      if gid >= 16777216
        return 0&
      end if
      value& = Int(gid)
      return value&
    end if
    if GetInterface(gid, "ifDouble") <> invalid
      ' Int() returns a 32-bit Integer, so split the value to stay in range
      high = Int(gid / 65536)
      return high * 65536& + Int(gid - high * 65536#)
    end if
    return 0&
  end function

end namespace
