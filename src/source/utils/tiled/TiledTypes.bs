namespace BGE.Tiled

  ' One tile's own data from a tileset: only tiles Tiled wrote an entry for (ones with a
  ' type, properties, or - in an image collection - their own image) have one.
  interface TiledTile extends roAssociativeArray
    ' Local id within its tileset (GID - the tileset's firstGid)
    id as integer
    ' Tiled's "class" (1.9+) or "type" (older); "" when unset
    type as string
    ' Custom properties, name -> value
    properties as roAssociativeArray
    ' Image-collection tiles only: full path to this tile's own image; "" otherwise
    image as string
    imageWidth as integer
    imageHeight as integer
  end interface

  ' A tileset, embedded in the map or loaded from an external .tsj. Spritesheet tilesets have
  ' an `image` cut into a grid; image collections have no `image` and one image per tile.
  interface TiledTileset extends roAssociativeArray
    firstGid as integer
    name as string
    tileCount as integer
    ' 0 for an image collection
    columns as integer
    tileWidth as integer
    tileHeight as integer
    margin as integer
    spacing as integer
    ' Full path to a spritesheet's image; "" for an image collection
    image as string
    imageWidth as integer
    imageHeight as integer
    ' Pixel offset to draw every tile at (Tiled's `tileoffset`; +y is down, as in Tiled)
    tileOffsetX as integer
    tileOffsetY as integer
    ' "tile" draws each tile at its own size; "grid" stretches it to the map's cell size
    tileRenderSize as string
    ' Local id (as a string) -> TiledTile, for tiles that have one
    tiles as roAssociativeArray
    properties as roAssociativeArray
  end interface

  ' One placed object from an object layer. x/y are Tiled pixel coordinates (+y down): the
  ' top-left of a rectangle/ellipse/text, the position of a point, the origin of a
  ' polygon/polyline's `points`, and the BOTTOM-left of a tile object.
  interface TiledObject extends roAssociativeArray
    id as integer
    name as string
    type as string
    ' "rectangle", "point", "ellipse", "polygon", "polyline", "tile" or "text"
    shape as string
    x as float
    y as float
    width as float
    height as float
    ' Degrees clockwise
    rotation as float
    visible as boolean
    ' polygon/polyline only: points relative to x/y, as {x, y} AAs
    points as roArray
    ' tile objects only: the raw GID, flip flags included (see resolveGid()); 0 otherwise
    gid as dynamic
    properties as roAssociativeArray
  end interface

  ' A layer. Group layers aren't kept: their children are listed in order with the group's
  ' offset added and its visibility combined in, so every layer is found by name.
  interface TiledLayer extends roAssociativeArray
    id as integer
    ' "tilelayer", "objectgroup" or "imagelayer"
    type as string
    name as string
    visible as boolean
    opacity as float
    ' Pixel offset (+y down, as in Tiled)
    offsetX as float
    offsetY as float
    properties as roAssociativeArray
    ' tilelayer only: width x height raw GIDs, row by row (0 = empty)
    width as integer
    height as integer
    data as roArray
    ' objectgroup only
    objects as roArray
    ' imagelayer only: full path to the image
    image as string
  end interface

  ' A parsed Tiled map - see BGE.Tiled.parseMapFile().
  interface TiledMap extends roAssociativeArray
    ' Size in cells
    width as integer
    height as integer
    ' Cell size in pixels
    tileWidth as integer
    tileHeight as integer
    ' "#rrggbb" / "#aarrggbb" as Tiled wrote it; "" when unset
    backgroundColor as string
    properties as roAssociativeArray
    ' Sorted by firstGid
    tilesets as roArray
    layers as roArray
  end interface

  ' What a GID refers to - see BGE.Tiled.resolveGid().
  interface TiledGidInfo extends roAssociativeArray
    ' The GID with its flip flags removed
    gid as integer
    tileset as BGE.Tiled.TiledTileset
    localId as integer
    ' invalid when the tileset has no entry for this tile
    tile as dynamic
    flipH as boolean
    flipV as boolean
    ' Diagonal flip (Tiled's 90-degree rotations combine this with flipH/flipV)
    flipD as boolean
  end interface

  ' One non-empty cell of a tile layer - see BGE.Tiled.getLayerCells().
  interface TiledCell extends roAssociativeArray
    row as integer
    col as integer
    info as BGE.Tiled.TiledGidInfo
  end interface

  ' Options for BGE.Tiled.layerToTileSpecs().
  interface TiledTileSpecOptions extends roAssociativeArray
    ' World units added to every tile's x
    optional offsetX as float
    ' World units added to every tile's y
    optional offsetY as float
  end interface

end namespace
