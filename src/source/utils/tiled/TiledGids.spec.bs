namespace tests

  @suite("BGE.Tiled (GIDs)")
  class TiledGidsTests extends rooibos.BaseTestSuite

    private spritesheets as BGE.Tiled.TiledMap
    private collection as BGE.Tiled.TiledMap

    protected override function setup()
      m.spritesheets = BGE.Tiled.parseMapJson(tests.TiledFixtures.bulkAnimationsMapJson(), "pkg:/maps")
      m.collection = BGE.Tiled.parseMapJson(tests.TiledFixtures.stickerKnightTitleJson(), "pkg:/ui")
    end function

    @describe("finding the tileset")

    @it("finds the tileset whose range holds the GID")
    function _()
      info = BGE.Tiled.resolveGid(m.spritesheets, 91)
      m.assertEqual(91, info.gid)
      m.assertEqual("test_tileset_rect2", info.tileset.name)
      m.assertEqual(0, info.localId)

      info = BGE.Tiled.resolveGid(m.spritesheets, 90)
      m.assertEqual("test_tileset_rect1", info.tileset.name)
      m.assertEqual(89, info.localId)
    end function

    @it("returns invalid for an empty cell or a GID past every tileset")
    function _()
      m.assertInvalid(BGE.Tiled.resolveGid(m.spritesheets, 0))
      m.assertInvalid(BGE.Tiled.resolveGid(m.spritesheets, 280))
    end function

    @it("includes the tile's own entry when the tileset has one")
    function _()
      m.assertEqual(0, BGE.Tiled.resolveGid(m.spritesheets, 1).tile.id)
      m.assertInvalid(BGE.Tiled.resolveGid(m.spritesheets, 2).tile)
    end function

    @it("only accepts image-collection tiles that exist")
    function _()
      info = BGE.Tiled.resolveGid(m.collection, 6)
      m.assertEqual("pkg:/ui/backgroundSet.png", info.tile.image)
      ' Local id 4 was deleted from the collection
      m.assertInvalid(BGE.Tiled.resolveGid(m.collection, 5))
    end function

    @describe("flip flags")

    @it("reads the horizontal flip on a real flipped tile object")
    function _()
      obj = m.collection.layers[1].objects[1] as BGE.Tiled.TiledObject
      info = BGE.Tiled.resolveGid(m.collection, obj.gid)
      m.assertEqual(6, info.gid)
      m.assertTrue(info.flipH)
      m.assertFalse(info.flipV)
      m.assertFalse(info.flipD)
    end function

    @it("reads vertical and diagonal flips")
    function _()
      info = BGE.Tiled.resolveGid(m.spritesheets, 1073741825)
      m.assertEqual(1, info.gid)
      m.assertTrue(info.flipV)
      m.assertFalse(info.flipH)

      info = BGE.Tiled.resolveGid(m.spritesheets, 536870913)
      m.assertEqual(1, info.gid)
      m.assertTrue(info.flipD)
    end function

    @it("ignores the hexagonal rotation flag")
    function _()
      m.assertEqual(1, BGE.Tiled.resolveGid(m.spritesheets, 268435457).gid)
    end function

    @it("accepts the GID as a negative Integer or a Double")
    function _()
      info = BGE.Tiled.resolveGid(m.collection, -2147483642)
      m.assertEqual(6, info.gid)
      m.assertTrue(info.flipH)

      info = BGE.Tiled.resolveGid(m.collection, 3221225478#)
      m.assertEqual(6, info.gid)
      m.assertTrue(info.flipH)
      m.assertTrue(info.flipV)
    end function

    @it("accepts a small Float GID but not one too big to be exact")
    function _()
      small = 1.5 * 4
      m.assertEqual("Float", Type(small))
      m.assertEqual(6, BGE.Tiled.resolveGid(m.collection, small).gid)
      ' 2^25, past where a Float stays exact
      big = 4096.0 * 8192.0
      m.assertEqual("Float", Type(big))
      m.assertEqual(0&, BGE.Tiled.toUnsignedGid(big))
    end function

  end class

end namespace
