import "../math/math.bs"
import "CountdownTimer.bs"

namespace BGE

  ' A resource that actions spend and that refills on its own after a pause: stamina, mana,
  ' ammo, boost or dash charges. Call update(dt) once per frame.
  '
  ' By default any amount left is enough to start an action, which can take the pool down to
  ' zero (souls-style stamina). Set requireFullAmount for mana or ammo, where an action needs
  ' all of its cost. A refused spend starts a short "denied" window (isDenied()) for a HUD to
  ' flash, and calls onDenied().
  '
  ' @example
  ' m.stamina = new BGE.RegenPool(100)
  ' m.stamina.regenPerSecond = 50
  ' ' In onUpdate(dt):
  ' if dodgePressed and m.stamina.spend(28)
  '   m.startDodge()
  ' end if
  ' m.stamina.update(dt, m.isBlocking) ' regenerates slower while blocking
  class RegenPool

    max as float = 100.0
    current as float = 100.0
    ' Per second, once regenDelaySeconds have passed since the last spend
    regenPerSecond as float = 50.0
    regenDelaySeconds as float = 0.6
    ' Fraction of the regen rate while update() is told the pool is slowed (e.g. holding a block)
    slowedRegenFactor as float = 0.35
    ' When true, spend() refuses unless the whole amount is there. When false, any amount left
    ' is enough and the pool stops at zero.
    requireFullAmount as boolean = false
    ' How long isDenied() stays true after a refused spend
    deniedSeconds as float = 0.4

    private deniedTimer as BGE.CountdownTimer = new BGE.CountdownTimer()
    private sinceSpendSeconds as float = 0.0

    ' Starts full.
    '
    ' @param {float} [max=100]
    sub new(max = 100 as float)
      m.max = max
      m.current = max
    end sub

    ' Whether spend(amount) would succeed.
    '
    ' @param {float} [amount=0]
    ' @return {boolean}
    function canSpend(amount = 0 as float) as boolean
      if m.requireFullAmount
        return m.current >= amount
      end if
      return m.current > 0
    end function

    ' Takes `amount` for an action, never below zero. When there isn't enough (see
    ' requireFullAmount), spends nothing, starts the denied window and returns false.
    '
    ' @param {float} amount
    ' @return {boolean} whether the action may go ahead
    function spend(amount as float) as boolean
      if not m.canSpend(amount)
        m.deniedTimer.start(m.deniedSeconds)
        m.onDenied(amount)
        return false
      end if
      m.take(amount)
      return true
    end function

    ' Takes `amount` whether or not there's enough (an overdraw, e.g. a blocked hit), stopping
    ' at zero. Never refused.
    '
    ' @param {float} amount
    ' @return {boolean} true if it all came out of the pool, false if the pool ran dry
    function drain(amount as float) as boolean
      covered = m.current >= amount
      m.take(amount)
      return covered
    end function

    ' Regenerates, once regenDelaySeconds have passed since the last spend or drain, and counts
    ' down the denied window. Call once per frame.
    '
    ' @param {float} dt - seconds
    ' @param {boolean} [slowed=false] - regenerate at slowedRegenFactor of the rate
    sub update(dt as float, slowed = false as boolean)
      m.deniedTimer.tick(dt)
      ' stops counting once past the delay, so it can't grow forever
      if m.sinceSpendSeconds < m.regenDelaySeconds
        m.sinceSpendSeconds += dt
      end if
      if m.sinceSpendSeconds < m.regenDelaySeconds
        return
      end if
      rate = m.regenPerSecond
      if slowed
        rate *= m.slowedRegenFactor
      end if
      m.current = BGE.Math.Min(m.max, m.current + rate * dt)
    end sub

    ' Fills the pool and restarts the regen delay.
    sub refill()
      m.current = m.max
      m.sinceSpendSeconds = 0.0
    end sub

    ' current / max, 0 to 1.
    '
    ' @return {float}
    function fraction() as float
      if m.max <= 0
        return 0
      end if
      return m.current / m.max
    end function

    ' True for deniedSeconds after a refused spend.
    '
    ' @return {boolean}
    function isDenied() as boolean
      return m.deniedTimer.isActive()
    end function

    ' Seconds left of the denied window; it jumps back up on each fresh refusal.
    '
    ' @return {float}
    function deniedRemaining() as float
      return m.deniedTimer.remaining()
    end function

    ' Called when spend() is refused. Override to react (a sound, say).
    '
    ' @param {float} amount - what was asked for
    protected sub onDenied(amount as float)
    end sub

    private sub take(amount as float)
      m.current = BGE.Math.Max(0, m.current - amount)
      m.sinceSpendSeconds = 0.0
    end sub

  end class

end namespace
