import "pkg:/source/utils/TokenPool.bs"

namespace tests
  @suite("BGE.TokenPool")
  class TokenPoolTests extends rooibos.BaseTestSuite

    @describe("request / release")

    @it("hands out at most maxHolders tokens")
    function _()
      pool = new BGE.TokenPool(2)
      m.assertTrue(pool.request("a"))
      m.assertTrue(pool.request("b"))
      m.assertFalse(pool.request("c"))
      m.assertEqual(pool.holderCount(), 2)
      m.assertTrue(pool.isHolding("a"))
      m.assertFalse(pool.isHolding("c"))
    end function

    @it("lets a holder request again")
    function _()
      pool = new BGE.TokenPool(1)
      m.assertTrue(pool.request("a"))
      m.assertTrue(pool.request("a"))
      m.assertTrue(pool.canRequest("a"))
      m.assertFalse(pool.canRequest("b"))
      m.assertEqual(pool.holderCount(), 1)
    end function

    @it("treats an integer id and its string as the same holder")
    function _()
      pool = new BGE.TokenPool(1)
      m.assertTrue(pool.request(7))
      m.assertTrue(pool.isHolding("7"))
      m.assertTrue(pool.release("7"))
      m.assertFalse(pool.isHolding(7))
    end function

    @it("reports whether release() freed a token")
    function _()
      pool = new BGE.TokenPool(1)
      pool.request("a")
      m.assertFalse(pool.release("b"))
      m.assertTrue(pool.release("a"))
      m.assertFalse(pool.release("a"))
      m.assertEqual(pool.holderCount(), 0)
    end function

    @describe("cooldown")

    @it("blocks new requests for cooldownSeconds after a release")
    function _()
      pool = new BGE.TokenPool(1, 1.0)
      pool.request("a")
      pool.release("a")
      m.assertFalse(pool.request("b"))
      pool.update(0.6)
      m.assertFalse(pool.request("b"))
      pool.update(0.6)
      m.assertTrue(pool.request("b"))
      m.assertEqual(pool.cooldownRemaining(), 0.0)
    end function

    @it("doesn't start a cooldown when releasing an id that held nothing")
    function _()
      pool = new BGE.TokenPool(1, 1.0)
      pool.release("a")
      m.assertTrue(pool.request("b"))
    end function

    @it("still lets a holder keep its token during another's cooldown")
    function _()
      pool = new BGE.TokenPool(2, 1.0)
      pool.request("a")
      pool.request("b")
      pool.release("a")
      m.assertTrue(pool.canRequest("b"))
      m.assertFalse(pool.canRequest("a"))
    end function

    @describe("idleSeconds")

    @it("counts only while nobody holds a token, and resets on a request")
    function _()
      pool = new BGE.TokenPool(1)
      pool.update(0.5)
      m.assertEqual(pool.idleSeconds(), 0.5)
      pool.request("a")
      m.assertEqual(pool.idleSeconds(), 0.0)
      pool.update(2.0)
      m.assertEqual(pool.idleSeconds(), 0.0)
      pool.release("a")
      pool.update(0.25)
      m.assertEqual(pool.idleSeconds(), 0.25)
    end function

    @describe("clear")

    @it("drops holders and resets the cooldown and idle time")
    function _()
      pool = new BGE.TokenPool(1, 5.0)
      pool.request("a")
      pool.release("a")
      pool.request("a")
      pool.update(1.0)
      pool.clear()
      m.assertEqual(pool.holderCount(), 0)
      m.assertEqual(pool.cooldownRemaining(), 0.0)
      m.assertEqual(pool.idleSeconds(), 0.0)
      m.assertTrue(pool.request("b"))
    end function

  end class

end namespace
