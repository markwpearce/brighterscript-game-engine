import "pkg:/source/utils/Impulse.bs"

namespace tests

  @suite("BGE.Impulse")
  class ImpulseTests extends rooibos.BaseTestSuite

    @describe("start (easing)")

    @it("is inactive and moves nothing before it starts")
    function _()
      impulse = new BGE.Impulse()
      m.assertFalse(impulse.isActive())
      push = impulse.step(0.5)
      m.assertEqual(push.x, 0.0)
      m.assertEqual(push.y, 0.0)
    end function

    @it("moves by the current velocity, then decays it")
    function _()
      impulse = new BGE.Impulse()
      impulse.start(BGE.Math.VectorOps.create(100, 0, -50), 2.0)

      push = impulse.step(0.25)
      m.assertEqual(push.x, 25.0)
      m.assertEqual(push.z, -12.5)
      m.assertEqual(impulse.velocity.x, 50.0)
      m.assertEqual(impulse.velocity.z, -25.0)
    end function

    @it("stops once the speed falls below stopSpeed")
    function _()
      impulse = new BGE.Impulse()
      impulse.start(BGE.Math.VectorOps.create(4, 0), 0.5, 2.0)

      impulse.step(1.0)
      m.assertTrue(impulse.isActive())
      impulse.step(1.0)
      m.assertFalse(impulse.isActive())
      m.assertEqual(impulse.velocity.x, 0.0)
    end function

    @it("stops at once when a step is long enough to decay it all")
    function _()
      impulse = new BGE.Impulse()
      impulse.start(BGE.Math.VectorOps.create(100, 0), 10.0)

      push = impulse.step(0.2)
      m.assertEqual(push.x, 20.0)
      m.assertFalse(impulse.isActive())
    end function

    @it("works per tick with dt = 1")
    function _()
      impulse = new BGE.Impulse()
      impulse.start(BGE.Math.VectorOps.create(8, 0), 0.5, 0.1)

      m.assertEqual(impulse.step(1).x, 8.0)
      m.assertEqual(impulse.step(1).x, 4.0)
    end function

    @describe("startTimed")

    @it("moves at a constant velocity for the given time, the last step moving a whole dt")
    function _()
      impulse = new BGE.Impulse()
      impulse.startTimed(BGE.Math.VectorOps.create(20, -10), 0.5)

      m.assertEqual(impulse.step(0.25).x, 10.0)
      m.assertTrue(impulse.isActive())
      push = impulse.step(0.375)
      m.assertEqual(push.x, 15.0)
      m.assertEqual(push.y, -7.5)
      m.assertFalse(impulse.isActive())
    end function

    @it("is active for its whole time even with no displacement")
    function _()
      impulse = new BGE.Impulse()
      impulse.startTimed(BGE.Math.VectorOps.create(0, 0), 0.5)

      m.assertTrue(impulse.isActive())
      impulse.step(0.5)
      m.assertFalse(impulse.isActive())
    end function

    @describe("stop")

    @it("ends a push and zeroes its velocity")
    function _()
      impulse = new BGE.Impulse()
      impulse.startTimed(BGE.Math.VectorOps.create(20, 0), 0.5)
      impulse.stop()

      m.assertFalse(impulse.isActive())
      m.assertEqual(impulse.step(0.25).x, 0.0)
    end function

  end class

end namespace
