import "pkg:/source/utils/Health.bs"

namespace tests

  @suite("BGE.Health")
  class HealthTests extends rooibos.BaseTestSuite

    @describe("damage")

    @it("takes damage and says whether it killed")
    function _()
      health = new BGE.Health(3)
      m.assertFalse(health.damage(1))
      m.assertEqual(health.current, 2.0)
      m.assertTrue(health.damage(5))
      m.assertEqual(health.current, 0.0)
      m.assertFalse(health.isAlive())
    end function

    @it("ignores damage once dead, so a kill is reported once")
    function _()
      health = new BGE.Health(1)
      m.assertTrue(health.damage(1))
      m.assertFalse(health.canTakeDamage())
      m.assertFalse(health.damage(1))
    end function

    @it("ignores hits during the invulnerability window after a hit")
    function _()
      health = new BGE.Health(6)
      health.invulnerableSeconds = 1.0
      health.damage(1)
      m.assertTrue(health.isInvulnerable())
      m.assertFalse(health.damage(1))
      m.assertEqual(health.current, 5.0)
      health.update(0.5)
      m.assertEqual(health.invulnerableRemaining(), 0.5)
      health.update(0.5)
      m.assertTrue(health.canTakeDamage())
      health.damage(1)
      m.assertEqual(health.current, 4.0)
    end function

    @it("has no invulnerability by default")
    function _()
      health = new BGE.Health(6)
      health.damage(1)
      m.assertFalse(health.isInvulnerable())
    end function

    @it("makeInvulnerable() ignores hits for a while")
    function _()
      health = new BGE.Health(6)
      health.makeInvulnerable(0.25)
      m.assertFalse(health.damage(1))
      health.update(0.25)
      m.assertTrue(health.canTakeDamage())
    end function

    @describe("heal / refill / reset")

    @it("heals up to max, but not from dead")
    function _()
      health = new BGE.Health(10)
      health.damage(4)
      health.heal(10)
      m.assertEqual(health.current, 10.0)
      health.damage(10)
      health.heal(5)
      m.assertEqual(health.current, 0.0)
    end function

    @it("refill and reset bring it back to full with no invulnerability")
    function _()
      health = new BGE.Health(10)
      health.invulnerableSeconds = 1
      health.damage(10)
      health.refill()
      m.assertEqual(health.current, 10.0)
      m.assertFalse(health.isInvulnerable())
      health.reset(4)
      m.assertEqual(health.max, 4.0)
      m.assertEqual(health.fraction(), 1.0)
    end function

    @describe("hooks")

    @it("calls onDamaged for each hit and onDeath once")
    function _()
      health = new tests.RecordingHealth(2)
      health.damage(1)
      health.damage(1)
      health.damage(1)
      m.assertEqual(health.damagedCount, 2)
      m.assertEqual(health.deathCount, 1)
    end function

  end class

  class RecordingHealth extends BGE.Health
    damagedCount as integer = 0
    deathCount as integer = 0

    sub new(max as float)
      super(max)
    end sub

    protected override sub onDamaged(amount as float)
      m.damagedCount++
    end sub

    protected override sub onDeath()
      m.deathCount++
    end sub
  end class

end namespace
