import "pkg:/source/utils/fileTypes.bs"

namespace tests

  @suite("BGE file type helpers")
  class FileTypeHelperTests extends rooibos.BaseTestSuite

    @describe("isKnownAssetExtension")

    @it("knows the loaders' types in any case")
    function _()
      for each extension in [".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif", ".ttf", ".otf", ".wav", ".mp3", ".obj", ".stl", ".mtl", ".PNG"]
        m.assertTrue(BGE.FileTypes.isKnownAssetExtension(extension), extension)
      end for
    end function

    @it("rejects other extensions")
    function _()
      m.assertFalse(BGE.FileTypes.isKnownAssetExtension(".php"))
      m.assertFalse(BGE.FileTypes.isKnownAssetExtension(".json"))
      m.assertFalse(BGE.FileTypes.isKnownAssetExtension(""))
    end function

    @describe("extensionForContentType")

    @it("maps known types, ignoring parameters and case")
    function _()
      m.assertEqual(".png", BGE.FileTypes.forContentType("image/png"))
      m.assertEqual(".jpg", BGE.FileTypes.forContentType("image/jpeg"))
      m.assertEqual(".jpg", BGE.FileTypes.forContentType("Image/JPG; charset=binary"))
      m.assertEqual(".webp", BGE.FileTypes.forContentType("image/webp"))
      m.assertEqual(".gif", BGE.FileTypes.forContentType("image/gif"))
      m.assertEqual(".bmp", BGE.FileTypes.forContentType("image/bmp"))
      m.assertEqual(".ttf", BGE.FileTypes.forContentType("font/ttf"))
      m.assertEqual(".ttf", BGE.FileTypes.forContentType("application/x-font-ttf"))
      m.assertEqual(".otf", BGE.FileTypes.forContentType("font/otf"))
      m.assertEqual(".otf", BGE.FileTypes.forContentType("application/x-font-otf"))
      m.assertEqual(".wav", BGE.FileTypes.forContentType("audio/wav"))
      m.assertEqual(".wav", BGE.FileTypes.forContentType("audio/x-wav"))
      m.assertEqual(".wav", BGE.FileTypes.forContentType("audio/wave"))
      m.assertEqual(".mp3", BGE.FileTypes.forContentType("audio/mpeg"))
      m.assertEqual(".obj", BGE.FileTypes.forContentType("model/obj"))
      m.assertEqual(".stl", BGE.FileTypes.forContentType("model/stl"))
      m.assertEqual(".stl", BGE.FileTypes.forContentType("application/sla"))
    end function

    @it("returns empty for other types")
    function _()
      m.assertEqual("", BGE.FileTypes.forContentType("application/octet-stream"))
      m.assertEqual("", BGE.FileTypes.forContentType("text/html; charset=utf-8"))
      m.assertEqual("", BGE.FileTypes.forContentType(""))
    end function

    @describe("sniffFileExtension")

    @it("recognises a real PNG")
    function _()
      bitmap = CreateObject("roBitmap", {width: 2, height: 2, AlphaEnable: true})
      bitmap.GetPng(0, 0, 2, 2).WriteFile("tmp:/bge_sniff.png")
      m.assertEqual(".png", BGE.FileTypes.sniffExtension("tmp:/bge_sniff.png"))
    end function

    @it("recognises image, font and sound signatures")
    function _()
      m.assertEqual(".jpg", tests.sniffBytes([&hFF, &hD8, &hFF, &hE0]))
      m.assertEqual(".gif", tests.sniffBytes(tests.asciiBytes("GIF89a")))
      m.assertEqual(".webp", tests.sniffBytes(tests.asciiBytes("RIFF1234WEBPVP8 ")))
      m.assertEqual(".bmp", tests.sniffBytes(tests.asciiBytes("BM1234")))
      m.assertEqual(".ttf", tests.sniffBytes([&h00, &h01, &h00, &h00, &h00, &h10]))
      m.assertEqual(".ttf", tests.sniffBytes(tests.asciiBytes("true1234")))
      m.assertEqual(".otf", tests.sniffBytes(tests.asciiBytes("OTTO1234")))
      m.assertEqual(".wav", tests.sniffBytes(tests.asciiBytes("RIFF1234WAVEfmt ")))
      m.assertEqual(".mp3", tests.sniffBytes(tests.asciiBytes("ID3abc")))
      m.assertEqual(".mp3", tests.sniffBytes([&hFF, &hFB, &h90, &h00]))
    end function

    @it("returns empty for text, an unknown RIFF, an empty file and a missing file")
    function _()
      m.assertEqual("", tests.sniffBytes(tests.asciiBytes("<html>sign in</html>")))
      m.assertEqual("", tests.sniffBytes(tests.asciiBytes("RIFF1234AVI LIST")))
      WriteAsciiFile("tmp:/bge_sniff_empty", "")
      m.assertEqual("", BGE.FileTypes.sniffExtension("tmp:/bge_sniff_empty"))
      m.assertEqual("", BGE.FileTypes.sniffExtension("tmp:/bge_sniff_missing"))
    end function

  end class

  ' Writes bytes to a temp file and sniffs it.
  function sniffBytes(values as roArray) as string
    bytes = CreateObject("roByteArray")
    for each value in values
      bytes.push(value)
    end for
    bytes.WriteFile("tmp:/bge_sniff_bytes")
    return BGE.FileTypes.sniffExtension("tmp:/bge_sniff_bytes")
  end function

  ' The character codes of an ASCII string.
  function asciiBytes(text as string) as roArray
    values = []
    for i = 0 to Len(text) - 1
      values.push(Asc(text.Mid(i, 1)))
    end for
    return values
  end function

end namespace
