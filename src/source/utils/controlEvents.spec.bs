namespace tests

  ' Values recorded from roUniversalControlEvent.GetInt()/GetChar() on a Roku Ultra
  ' 4850CA (OS 15.3.4), sent over ECP (issue #194).
  @suite("BGE.getControlEventKind")
  class GetControlEventKindTests extends rooibos.BaseTestSuite

    @describe("remote buttons")

    @it("treats remote button presses and releases as buttons")
    function _()
      m.assertEqual(BGE.ControlEventKind.button, BGE.getControlEventKind(6, 0))
      m.assertEqual(BGE.ControlEventKind.button, BGE.getControlEventKind(106, 0))
      m.assertEqual(BGE.ControlEventKind.button, BGE.getControlEventKind(8, 0))
      m.assertEqual(BGE.ControlEventKind.button, BGE.getControlEventKind(113, 0))
    end function

    @it("treats the keyboard's Backspace and Enter keys as buttons, not characters")
    function _()
      m.assertEqual(BGE.ControlEventKind.button, BGE.getControlEventKind(11, 0))
      m.assertEqual(BGE.ControlEventKind.button, BGE.getControlEventKind(111, 0))
      m.assertEqual(BGE.ControlEventKind.button, BGE.getControlEventKind(15, 0))
      m.assertEqual(BGE.ControlEventKind.button, BGE.getControlEventKind(115, 0))
    end function

    @describe("typed characters")

    @it("treats a typed character's press as a character press")
    function _()
      m.assertEqual(BGE.ControlEventKind.charPress, BGE.getControlEventKind(97, 97))
      m.assertEqual(BGE.ControlEventKind.charPress, BGE.getControlEventKind(65, 65))
      m.assertEqual(BGE.ControlEventKind.charPress, BGE.getControlEventKind(32, 32))
    end function

    @it("treats a typed character's release as a character release")
    function _()
      m.assertEqual(BGE.ControlEventKind.charRelease, BGE.getControlEventKind(197, 97))
      m.assertEqual(BGE.ControlEventKind.charRelease, BGE.getControlEventKind(165, 65))
      m.assertEqual(BGE.ControlEventKind.charRelease, BGE.getControlEventKind(132, 32))
    end function

    @it("doesn't mistake characters whose codes collide with button codes for buttons")
    function _()
      ' "d" (100) looks like a Back release, "j" (106) like an OK release.
      m.assertEqual(BGE.ControlEventKind.charPress, BGE.getControlEventKind(100, 100))
      m.assertEqual(BGE.ControlEventKind.charRelease, BGE.getControlEventKind(200, 100))
      m.assertEqual(BGE.ControlEventKind.charPress, BGE.getControlEventKind(106, 106))
      m.assertEqual(BGE.ControlEventKind.charRelease, BGE.getControlEventKind(206, 106))
    end function

  end class

end namespace
