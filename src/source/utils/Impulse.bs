import "pkg:/source/math/vector.bs"

namespace BGE

  ' A short push, such as a knockback, that an entity ticks once per update. step(dt)
  ' returns how far to move this frame, so the entity can add it to its position or route
  ' it through its own collision (e.g. `BGE.SolidWorld.moveAndSlide()`).
  '
  ' Two shapes: start() eases out (the velocity decays each step until it falls below a stop
  ' speed), and startTimed() moves at a constant velocity for a set time.
  '
  ' @example
  ' ' On a hit: 600 units/s away from the attacker, easing out
  ' m.knockback.start(BGE.Math.VectorOps.scale(away, 600), 10)
  ' ' In onUpdate(dt):
  ' push = m.knockback.step(dt)
  ' m.position.x += push.x
  ' m.position.z += push.z
  class Impulse

    ' Current velocity, in units per second (or per step unit; see step()).
    velocity = BGE.Math.VectorOps.create()

    private decayRate as float = 0.0
    private stopSpeed as float = 0.0
    ' Negative for an easing impulse, which has no time limit.
    private secondsRemaining as float = -1.0

    sub new()
    end sub

    ' Starts (or replaces) an easing push. Each step keeps `1 - decayRate * dt` of the
    ' velocity, and stops once the speed falls below stopSpeed.
    '
    ' @param {BGE.Math.Vector} velocity - initial velocity
    ' @param {float} decayRate - fraction of the velocity lost per second; 10 stops in well under a second
    ' @param {float} [stopSpeed=1.0] - speed below which the push ends
    sub start(velocity as BGE.Math.Vector, decayRate as float, stopSpeed = 1.0 as float)
      m.velocity = BGE.Math.VectorOps.copy(velocity)
      m.decayRate = decayRate
      m.stopSpeed = stopSpeed
      m.secondsRemaining = -1.0
    end sub

    ' Starts (or replaces) a push that covers `displacement` at a constant velocity over
    ' `seconds`. The last step moves a whole dt, like a CountdownTimer-gated move.
    '
    ' @param {BGE.Math.Vector} displacement - total distance to move
    ' @param {float} seconds
    sub startTimed(displacement as BGE.Math.Vector, seconds as float)
      if seconds <= 0
        m.stop()
        return
      end if
      m.velocity = BGE.Math.VectorOps.scale(displacement, 1.0 / seconds)
      m.decayRate = 0.0
      m.stopSpeed = 0.0
      m.secondsRemaining = seconds
    end sub

    ' Ends the push now.
    sub stop()
      m.velocity = BGE.Math.VectorOps.create()
      m.secondsRemaining = -1.0
    end sub

    ' Whether the push is still running. A timed push counts as running for its whole
    ' time, even with a zero displacement.
    '
    ' @return {boolean}
    function isActive() as boolean
      if m.secondsRemaining >= 0
        return true
      end if
      return not BGE.Math.VectorOps.isZero(m.velocity)
    end function

    ' Advances the push and returns the displacement for this step (zero once it's over).
    ' dt is normally seconds; a fixed-tick game can pass 1 per tick and give velocities and
    ' decayRate per tick instead.
    '
    ' @param {float} dt
    ' @return {BGE.Math.Vector}
    function step(dt as float) as BGE.Math.Vector
      if not m.isActive()
        return BGE.Math.VectorOps.create()
      end if
      displacement = BGE.Math.VectorOps.scale(m.velocity, dt)
      if m.secondsRemaining >= 0
        m.secondsRemaining -= dt
        if m.secondsRemaining <= 0
          m.stop()
        end if
        return displacement
      end if
      m.velocity = BGE.Math.VectorOps.scale(m.velocity, BGE.Math.Max(0, 1 - m.decayRate * dt))
      if BGE.Math.VectorOps.length(m.velocity) < m.stopSpeed
        m.stop()
      end if
      return displacement
    end function

  end class

end namespace
