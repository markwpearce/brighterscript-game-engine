import "pkg:/source/engine/loading/DownloadPaths.bs"
import "pkg:/source/utils/urls.bs"

namespace tests

  @suite("BGE url helpers")
  class UrlHelperTests extends rooibos.BaseTestSuite

    @describe("isUrl")

    @it("accepts http and https in any case")
    function _()
      m.assertTrue(BGE.Urls.isUrl("http://example.com/a.png"))
      m.assertTrue(BGE.Urls.isUrl("https://example.com/a.png"))
      m.assertTrue(BGE.Urls.isUrl("HTTPS://EXAMPLE.COM/A.PNG"))
    end function

    @it("rejects local paths and non-strings")
    function _()
      m.assertFalse(BGE.Urls.isUrl("pkg:/images/a.png"))
      m.assertFalse(BGE.Urls.isUrl("cachefs:/bge/a.png"))
      m.assertFalse(BGE.Urls.isUrl(""))
      m.assertFalse(BGE.Urls.isUrl(invalid))
      m.assertFalse(BGE.Urls.isUrl({width: 2, height: 2}))
    end function

    @describe("urlFileExtension")

    @it("returns the lowercase extension of the url path")
    function _()
      m.assertEqual(".png", BGE.Urls.fileExtension("https://example.com/img/Hero.PNG"))
      m.assertEqual(".obj", BGE.Urls.fileExtension("https://example.com/m/ship.obj"))
    end function

    @it("ignores the query string and fragment")
    function _()
      m.assertEqual(".png", BGE.Urls.fileExtension("https://example.com/hero.png?v=3"))
      m.assertEqual(".png", BGE.Urls.fileExtension("https://example.com/hero.png#top"))
    end function

    @it("returns empty when the path has no extension")
    function _()
      m.assertEqual("", BGE.Urls.fileExtension("https://example.com/download"))
      m.assertEqual("", BGE.Urls.fileExtension("https://example.com/"))
      m.assertEqual("", BGE.Urls.fileExtension("https://example.com/v1.2/file"))
    end function

    @describe("resolveRelativeUrl")

    @it("resolves a sibling file against the base url's folder")
    function _()
      m.assertEqual("https://example.com/models/ship.mtl", BGE.Urls.resolveRelative("https://example.com/models/ship.obj", "ship.mtl"))
      m.assertEqual("https://example.com/models/tex/ship.png", BGE.Urls.resolveRelative("https://example.com/models/ship.obj", "./tex/ship.png"))
    end function

    @it("drops the base url's query string")
    function _()
      m.assertEqual("https://example.com/models/ship.mtl", BGE.Urls.resolveRelative("https://example.com/models/ship.obj?v=2", "ship.mtl"))
    end function

    @it("resolves a root-relative path against the host")
    function _()
      m.assertEqual("https://example.com/shared/a.png", BGE.Urls.resolveRelative("https://example.com/models/ship.obj", "/shared/a.png"))
    end function

    @it("returns a full url unchanged")
    function _()
      m.assertEqual("http://cdn.example.com/a.png", BGE.Urls.resolveRelative("https://example.com/models/ship.obj", "http://cdn.example.com/a.png"))
    end function

    @it("gives a scheme-relative url the base url's scheme")
    function _()
      m.assertEqual("https://cdn.example.com/a.png", BGE.Urls.resolveRelative("https://example.com/models/ship.obj", "//cdn.example.com/a.png"))
      m.assertEqual("http://cdn.example.com/a.png", BGE.Urls.resolveRelative("http://example.com/ship.obj", "//cdn.example.com/a.png"))
    end function

    @it("collapses ./ and ../ segments")
    function _()
      m.assertEqual("https://example.com/textures/a.png", BGE.Urls.resolveRelative("https://example.com/models/ship.obj", "../textures/a.png"))
      m.assertEqual("https://example.com/a/c.png", BGE.Urls.resolveRelative("https://example.com/a/b/ship.obj", "./../c.png"))
      m.assertEqual("https://example.com/a/b/c/d.png", BGE.Urls.resolveRelative("https://example.com/a/b/ship.obj", "c/./x/../d.png"))
      m.assertEqual("https://example.com/shared/a.png", BGE.Urls.resolveRelative("https://example.com/models/ship.obj", "/x/../shared/./a.png"))
    end function

    @it("never goes above the root")
    function _()
      m.assertEqual("https://example.com/a.png", BGE.Urls.resolveRelative("https://example.com/models/ship.obj", "../../../a.png"))
      m.assertEqual("https://example.com/a.png", BGE.Urls.resolveRelative("https://example.com", "../a.png"))
    end function

    @it("keeps the relative path's query and fragment unchanged")
    function _()
      m.assertEqual("https://example.com/tex/a.png?v=../2#x/./y", BGE.Urls.resolveRelative("https://example.com/models/ship.obj?v=1", "../tex/a.png?v=../2#x/./y"))
    end function

    @describe("getDownloadPath")

    @it("puts cached downloads in cachefs and keeps the extension")
    function _()
      downloadPath = BGE.Downloads.getPath("https://example.com/hero.png?v=3", true)
      m.assertTrue(downloadPath.StartsWith("cachefs:/bge/"))
      m.assertTrue(downloadPath.EndsWith(".png"))
      ' folder + "/" + 32 hex chars + ".png"
      m.assertEqual(Len("cachefs:/bge/") + 32 + 4, Len(downloadPath))
    end function

    @it("puts uncached downloads in tmp")
    function _()
      m.assertTrue(BGE.Downloads.getPath("https://example.com/hero.png", false).StartsWith("tmp:/bge/"))
    end function

    @it("gives the same url the same path and different urls different paths")
    function _()
      m.assertEqual(BGE.Downloads.getPath("https://example.com/a.png", true), BGE.Downloads.getPath("https://example.com/a.png", true))
      m.assertNotEqual(BGE.Downloads.getPath("https://example.com/a.png?v=3", true), BGE.Downloads.getPath("https://example.com/a.png?v=4", true))
    end function

  end class

end namespace
