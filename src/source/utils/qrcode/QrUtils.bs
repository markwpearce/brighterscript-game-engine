namespace BGE.QrCode
  ' Small helpers the ported QR generator needs that plain BrighterScript
  ' arrays/math don't provide natively (see QrConstants.bs's file doc comment
  ' for provenance).

  ' Appends the low-order `length` bits of `value` (as individual 0/1 integers,
  ' MSB first) to `bb`. Requires 0 <= length <= 31 and 0 <= value < 2^length.
  sub qrAppendBits(value as integer, length as integer, bb as integer[])
    qrAssert(length >= 0 and length <= 31 and (value >> length) = 0, "Value out of range")
    for i = length - 1 to 0 step -1
      bb.Push((value >> i) and 1)
    end for
  end sub

  ' @return {boolean} - true iff the i'th bit of x (0 = least significant) is set.
  function qrGetBit(x as integer, i as integer) as boolean
    return ((x >> i) and 1) <> 0
  end function

  ' Throws if `condition` is false. Used throughout the ported algorithm to
  ' mirror the reference implementation's own internal sanity checks.
  sub qrAssert(condition as boolean, message = "Assertion error" as string)
    if not condition
      throw message
    end if
  end sub

  ' BrightScript has no bitwise XOR operator - see the original port's own comment.
  function qrXor(x as integer, y as integer) as integer
    return (x or y) - (x and y)
  end function

  function qrFloor(f as float) as integer
    return Int(f)
  end function

  function qrCeil(f as float) as integer
    return Int(f + 0.999)
  end function

  function qrMin(a as integer, b as integer) as integer
    if a < b
      return a
    end if
    return b
  end function

  function qrMax(a as integer, b as integer) as integer
    if a > b
      return a
    end if
    return b
  end function

  ' A copy of array[start:finish) (JS-Array.slice-style), matching the ported
  ' reference's own `slice` helper exactly: omitting `finish` (or passing 0)
  ' copies the whole array; a negative start/finish counts back from the end.
  function qrSliceArray(arr as object, start = 0 as integer, finish = 0 as integer) as object
    size = arr.Count() - 1
    if start < 0
      start += size
    end if
    if finish = 0 or finish >= size
      finish = size + 1
    else if finish < 0
      finish += size
    end if
    result = []
    for i = start to finish - 1
      result.Push(arr[i])
    end for
    return result
  end function

  ' In-place: deletes `deleteCount` elements starting at `start`, then inserts
  ' `insert`'s elements there - matching the ported reference's own `splice`.
  function qrSpliceArray(arr as object, start as integer, deleteCount = 999999 as integer, insert = [] as object) as object
    if start > arr.Count() - 1
      start = arr.Count() - 1
    end if
    if start < 0
      start = arr.Count() - start
    end if
    if start < 0
      start = 0
    end if
    if deleteCount < 0
      deleteCount = 0
    end if
    for i = 1 to deleteCount
      arr.Delete(start)
    end for
    tmp = []
    tmp.Append(insert)
    while arr.Count() - 1 > start
      tmp.Push(arr[start])
      arr.Delete(start)
    end while
    arr.Append(tmp)
    return arr
  end function

end namespace
