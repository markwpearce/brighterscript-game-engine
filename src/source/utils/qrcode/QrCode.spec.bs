namespace tests
  @suite("BGE.QrCode.QrCode")
  class QrCodeTests extends rooibos.BaseTestSuite

    @describe("qrEncodeText")

    @it("produces a version-1 (21x21) QR code for a short string")
    function _()
      qr = BGE.QrCode.qrEncodeText("HELLO", BGE.QrCode.EccLevel.low)
      m.assertEqual(21, qr.size)
    end function

    @it("grows to a larger version for a longer string")
    function _()
      longText = string(200, "A")
      qr = BGE.QrCode.qrEncodeText(longText, BGE.QrCode.EccLevel.low)
      m.assertTrue(qr.size > 21)
    end function

    @it("is deterministic - encoding the same text twice yields the same modules")
    function _()
      qr1 = BGE.QrCode.qrEncodeText("Deterministic!", BGE.QrCode.EccLevel.medium)
      qr2 = BGE.QrCode.qrEncodeText("Deterministic!", BGE.QrCode.EccLevel.medium)
      m.assertEqual(qr1.size, qr2.size)
      m.assertEqual(qr1.mask, qr2.mask)
      for y = 0 to qr1.size - 1
        for x = 0 to qr1.size - 1
          m.assertEqual(qr1.getModule(x, y), qr2.getModule(x, y))
        end for
      end for
    end function

    @it("getModule returns false for coordinates outside the grid")
    function _()
      qr = BGE.QrCode.qrEncodeText("X", BGE.QrCode.EccLevel.low)
      m.assertFalse(qr.getModule(-1, 0))
      m.assertFalse(qr.getModule(0, -1))
      m.assertFalse(qr.getModule(qr.size, 0))
      m.assertFalse(qr.getModule(0, qr.size))
    end function

    @it("the three finder patterns' centers are always dark")
    function _()
      qr = BGE.QrCode.qrEncodeText("Finder patterns", BGE.QrCode.EccLevel.quartile)
      m.assertTrue(qr.getModule(3, 3))
      m.assertTrue(qr.getModule(qr.size - 4, 3))
      m.assertTrue(qr.getModule(3, qr.size - 4))
    end function

    @it("respects an explicitly forced mask instead of auto-choosing one")
    function _()
      qr = BGE.QrCode.qrEncodeSegments(BGE.QrCode.qrMakeSegments("Forced mask"), BGE.QrCode.EccLevel.low, 1, 40, 3)
      m.assertEqual(3, qr.mask)
    end function

    @it("boosts the ECC level when the data fits at a higher level for free")
    function _()
      ' A tiny payload at version 1 has plenty of spare capacity, so boostEcl
      ' should raise LOW all the way to the highest level that still fits.
      qr = BGE.QrCode.qrEncodeSegments(BGE.QrCode.qrMakeSegments("Hi"), BGE.QrCode.EccLevel.low, 1, 1)
      m.assertTrue(qr.errorCorrectionLevel > BGE.QrCode.EccLevel.low)
    end function

    @describe("qrEncodeBinary")

    @it("encodes raw bytes in byte mode")
    function _()
      data = [72, 101, 108, 108, 111] ' "Hello"
      qr = BGE.QrCode.qrEncodeBinary(data, BGE.QrCode.EccLevel.low)
      m.assertEqual(21, qr.size)
    end function

  end class
end namespace
