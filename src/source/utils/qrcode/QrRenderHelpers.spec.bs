namespace tests
  @suite("BGE.QrCode.draw / qrDrawModules")
  class QrRenderHelpersTests extends rooibos.BaseTestSuite

    @describe("draw")

    @it("draws successfully onto a real renderer's canvas")
    function _()
      bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      renderer = new BGE.Renderer(bitmap)
      m.assertTrue(BGE.QrCode.draw(renderer, 10.0, 10.0, "Hello", 80.0))
    end function

    @it("increments the renderer's draw call count")
    function _()
      bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      renderer = new BGE.Renderer(bitmap)
      before = renderer.getDrawCallsLastFrame()
      BGE.QrCode.draw(renderer, 10.0, 10.0, "Hello", 80.0)
      m.assertTrue(renderer.getDrawCallsLastFrame() > before)
    end function

    @it("does not draw when entirely outside the canvas")
    function _()
      bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      renderer = new BGE.Renderer(bitmap)
      m.assertFalse(BGE.QrCode.draw(renderer, 10000.0, 10000.0, "Hello", 80.0))
    end function

    @it("fails soft (returns false) instead of crashing when the text doesn't fit any QR version")
    function _()
      bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      renderer = new BGE.Renderer(bitmap)
      tooLong = string(10000, "A") ' well past version 40's capacity at any ECC level
      m.assertFalse(BGE.QrCode.draw(renderer, 10.0, 10.0, tooLong, 80.0))
    end function

    @describe("qrDrawModules")

    @it("issues one background fill plus one DrawRect per dark module")
    function _()
      bitmap = CreateObject("roBitmap", {width: 50, height: 50, alphaEnable: true})
      qr = BGE.QrCode.qrEncodeText("Hi", BGE.QrCode.EccLevel.low)
      darkCount = 0
      for y = 0 to qr.size - 1
        for x = 0 to qr.size - 1
          if qr.getModule(x, y)
            darkCount++
          end if
        end for
      end for
      drawCalls = BGE.QrCode.qrDrawModules(bitmap, qr, 0.0, 0.0, 50.0, BGE.Colors.Black, BGE.Colors.White)
      m.assertEqual(darkCount + 1, drawCalls)
    end function

    @it("defaults to black-on-white when no colors are given")
    function _()
      bitmap = CreateObject("roBitmap", {width: 21, height: 21, alphaEnable: true})
      qr = BGE.QrCode.qrEncodeText("Hi", BGE.QrCode.EccLevel.low)
      m.assertTrue(BGE.QrCode.qrDrawModules(bitmap, qr, 0.0, 0.0, 21.0) > 0)
    end function

  end class
end namespace
