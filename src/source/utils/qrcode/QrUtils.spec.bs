namespace tests
  @suite("BGE.QrCode utils")
  class QrUtilsTests extends rooibos.BaseTestSuite

    @describe("qrAppendBits / qrGetBit")

    @it("appends the low-order bits of a value, MSB first")
    function _()
      bb = []
      BGE.QrCode.qrAppendBits(&hB, 4, bb) ' 1011
      m.assertEqual([1, 0, 1, 1], bb)
    end function

    @it("appends zero bits for a zero-length value without error")
    function _()
      bb = [7]
      BGE.QrCode.qrAppendBits(0, 0, bb)
      m.assertEqual([7], bb)
    end function

    @it("getBit reads back individual bits of a byte")
    function _()
      m.assertTrue(BGE.QrCode.qrGetBit(&hB, 0)) ' 1011, bit 0 = 1
      m.assertFalse(BGE.QrCode.qrGetBit(&hB, 2)) ' bit 2 = 0
      m.assertTrue(BGE.QrCode.qrGetBit(&hB, 3)) ' bit 3 = 1
    end function

    @describe("qrXor")

    @it("matches bitwise XOR for known values")
    function _()
      m.assertEqual(&h6, BGE.QrCode.qrXor(&h5, &h3)) ' 101 xor 011 = 110
      m.assertEqual(0, BGE.QrCode.qrXor(&hFF, &hFF))
    end function

    @describe("qrFloor / qrCeil")

    @it("floor truncates toward zero for positive values")
    function _()
      m.assertEqual(3, BGE.QrCode.qrFloor(3.7))
      m.assertEqual(0, BGE.QrCode.qrFloor(0.9))
    end function

    @it("ceil rounds up for a fractional value")
    function _()
      m.assertEqual(4, BGE.QrCode.qrCeil(3.1))
      m.assertEqual(3, BGE.QrCode.qrCeil(3.0))
    end function

    @describe("qrReedSolomonMultiply")

    @it("returns 0 when either operand is 0")
    function _()
      m.assertEqual(0, BGE.QrCode.qrReedSolomonMultiply(0, 42))
      m.assertEqual(0, BGE.QrCode.qrReedSolomonMultiply(42, 0))
    end function

    @it("is commutative")
    function _()
      a = BGE.QrCode.qrReedSolomonMultiply(7, 200)
      b = BGE.QrCode.qrReedSolomonMultiply(200, 7)
      m.assertEqual(a, b)
    end function

    @it("multiplying by the field's multiplicative identity element (1) is a no-op")
    function _()
      m.assertEqual(53, BGE.QrCode.qrReedSolomonMultiply(53, 1))
    end function

    @describe("qrSliceArray")

    @it("copies the whole array when start/finish are omitted")
    function _()
      result = BGE.QrCode.qrSliceArray([1, 2, 3])
      m.assertEqual([1, 2, 3], result)
    end function

    @it("copies a sub-range [start, finish)")
    function _()
      result = BGE.QrCode.qrSliceArray([1, 2, 3, 4, 5], 1, 3)
      m.assertEqual([2, 3], result)
    end function

    @it("returns an independent copy, not a reference to the original")
    function _()
      original = [1, 2, 3]
      copy = BGE.QrCode.qrSliceArray(original)
      copy.Push(4)
      m.assertEqual(3, original.Count())
    end function

    @it("resolves a negative start by counting back from the actual length, not length-1")
    function _()
      ' slice(-2) on a 5-element array means "last 2 elements" - [4, 5].
      result = BGE.QrCode.qrSliceArray([1, 2, 3, 4, 5], -2)
      m.assertEqual([4, 5], result)
    end function

    @describe("qrSpliceArray")

    @it("inserts one element at index 1 of a 1-element array (append)")
    function _()
      arr = [6]
      BGE.QrCode.qrSpliceArray(arr, 1, 0, [38])
      m.assertEqual([6, 38], arr)
    end function

    @it("inserts one element at index 1 of a 2-element array, keeping the tail element after it")
    function _()
      ' Reproduces getAlignmentPatternPositions()'s second insertion for QR version 7+
      ' (numAlign >= 3): starting from [6, 38], inserting 22 at index 1 must give
      ' [6, 22, 38], not silently drop 38 to the end as [6, 38, 22].
      arr = [6, 38]
      BGE.QrCode.qrSpliceArray(arr, 1, 0, [22])
      m.assertEqual([6, 22, 38], arr)
    end function

  end class
end namespace
