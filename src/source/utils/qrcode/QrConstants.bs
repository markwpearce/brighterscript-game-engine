namespace BGE.QrCode
  ' QR Code generator, ported from Project Nayuki's reference implementation
  ' (https://www.nayuki.io/page/qr-code-generator-library, MIT license) via
  ' https://github.com/paramount-engineering/QR-Code-generator-brightscript
  ' (Copyright (c) Kevin Hoos, MIT license) - see LICENSE-THIRD-PARTY.md.
  ' Ported to plain BrighterScript classes/functions (the original targets a
  ' SceneGraph roSGNode component tree, which this engine doesn't use).

  const MIN_VERSION = 1
  const MAX_VERSION = 40

  ' Penalty weights used by QrCode.getPenaltyScore() when auto-selecting a mask.
  const PENALTY_N1 = 3
  const PENALTY_N2 = 3
  const PENALTY_N3 = 40
  const PENALTY_N4 = 10

  enum EccLevel
    low = 0
    medium = 1
    quartile = 2
    high = 3
  end enum

  ' The format-bits value (uint2) for each error correction level, indexed by EccLevel ordinal.
  function eccFormatBits(level as integer) as integer
    return [1, 0, 3, 2][level]
  end function

  ' ECC codewords per block, indexed [EccLevel ordinal][version]. Index 0 (version 0) is
  ' unused padding. See ISO/IEC 18004 table 9.
  function eccCodewordsPerBlock() as integer[][]
    return [
      [-1, 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28, 30, 28, 28, 28, 28, 30, 30, 26, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30]
      [-1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28, 26, 26, 26, 26, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28]
      [-1, 13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28, 28, 26, 30, 28, 30, 30, 30, 30, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30]
      [-1, 17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28, 28, 26, 28, 30, 24, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30]
    ]
  end function

  ' Number of error correction blocks, indexed [EccLevel ordinal][version]. Index 0
  ' (version 0) is unused padding. See ISO/IEC 18004 table 9.
  function numErrorCorrectionBlocks() as integer[][]
    return [
      [-1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9, 9, 10, 12, 12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21, 22, 24, 25]
      [-1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16, 17, 17, 18, 20, 21, 23, 25, 26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45, 47, 49]
      [-1, 1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20, 23, 23, 25, 27, 29, 34, 34, 35, 38, 40, 43, 45, 48, 51, 53, 56, 59, 62, 65, 68]
      [-1, 1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25, 25, 25, 34, 30, 32, 35, 37, 40, 42, 45, 48, 51, 54, 57, 60, 63, 66, 70, 74, 77, 81]
    ]
  end function

  ' A QR Code data-segment mode (numeric/alphanumeric/byte/kanji/ECI) and its
  ' per-version-range character-count field width. See ISO/IEC 18004 table 3.
  class QrMode
    modeBits as integer
    numBitsCharCount as integer[]

    sub new(modeBits as integer, numBitsCharCount as integer[])
      m.modeBits = modeBits
      m.numBitsCharCount = numBitsCharCount
    end sub

    ' @return {integer} - the bit width of the character-count field for a segment in
    '   this mode at the given QR Code version. Result is in [0, 16].
    function numCharCountBits(version as integer) as integer
      return m.numBitsCharCount[BGE.QrCode.qrFloor((version + 7) / 17)]
    end function
  end class

  ' @param {string} modeName - "NUMERIC", "ALPHANUMERIC", "BYTE", "KANJI", or "ECI"
  ' @return {BGE.QrCode.QrMode}
  function newQrMode(modeName as string) as BGE.QrCode.QrMode
    if modeName = "NUMERIC"
      return new BGE.QrCode.QrMode(&h1, [10, 12, 14])
    else if modeName = "ALPHANUMERIC"
      return new BGE.QrCode.QrMode(&h2, [9, 11, 13])
    else if modeName = "BYTE"
      return new BGE.QrCode.QrMode(&h4, [8, 16, 16])
    else if modeName = "KANJI"
      return new BGE.QrCode.QrMode(&h8, [8, 10, 12])
    else if modeName = "ECI"
      return new BGE.QrCode.QrMode(&h7, [0, 0, 0])
    end if
    ' qrAssert() always throws here - this dummy value only satisfies the type
    ' checker, it's never actually returned.
    BGE.QrCode.qrAssert(false, "Unknown QR mode: " + modeName)
    return new BGE.QrCode.QrMode(0, [0, 0, 0])
  end function

end namespace
