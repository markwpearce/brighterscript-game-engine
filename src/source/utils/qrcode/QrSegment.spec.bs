namespace tests
  @suite("BGE.QrCode.QrSegment")
  class QrSegmentTests extends rooibos.BaseTestSuite

    @describe("qrIsNumeric / qrIsAlphanumeric")

    @it("recognizes a numeric-only string")
    function _()
      m.assertTrue(BGE.QrCode.qrIsNumeric("0123456789"))
      m.assertFalse(BGE.QrCode.qrIsNumeric("123A"))
      m.assertTrue(BGE.QrCode.qrIsNumeric("")) ' the empty string vacuously matches "zero or more digits"
    end function

    @it("recognizes an alphanumeric-mode-encodable string")
    function _()
      m.assertTrue(BGE.QrCode.qrIsAlphanumeric("HELLO WORLD 123"))
      m.assertFalse(BGE.QrCode.qrIsAlphanumeric("hello")) ' lowercase not allowed
      m.assertFalse(BGE.QrCode.qrIsAlphanumeric("HI!")) ' '!' not in the charset
    end function

    @describe("qrMakeSegments")

    @it("picks numeric mode for a digit-only string")
    function _()
      segs = BGE.QrCode.qrMakeSegments("42")
      m.assertEqual(1, segs.Count())
      m.assertEqual(&h1, segs[0].mode.modeBits)
      m.assertEqual(2, segs[0].numChars)
    end function

    @it("picks alphanumeric mode when non-numeric but still in the charset")
    function _()
      segs = BGE.QrCode.qrMakeSegments("HELLO")
      m.assertEqual(&h2, segs[0].mode.modeBits)
    end function

    @it("falls back to byte mode for text outside the alphanumeric charset")
    function _()
      segs = BGE.QrCode.qrMakeSegments("hello!")
      m.assertEqual(&h4, segs[0].mode.modeBits)
    end function

    @it("returns no segments for an empty string")
    function _()
      segs = BGE.QrCode.qrMakeSegments("")
      m.assertEqual(0, segs.Count())
    end function

    @describe("qrMakeNumeric")

    @it("packs 3 digits into 10 bits per group, matching the numeric-mode encoding")
    function _()
      ' "123" -> one group of 3 digits -> 3*3+1 = 10 bits
      seg = BGE.QrCode.qrMakeNumeric("123")
      m.assertEqual(10, seg.getData().Count())
    end function

    @it("packs a trailing group of 1 digit into 4 bits")
    function _()
      ' "1234" -> group of 3 (10 bits) + group of 1 (1*3+1 = 4 bits) = 14 bits
      seg = BGE.QrCode.qrMakeNumeric("1234")
      m.assertEqual(14, seg.getData().Count())
    end function

    @describe("qrMakeAlphanumeric")

    @it("packs 2 characters into 11 bits per group")
    function _()
      seg = BGE.QrCode.qrMakeAlphanumeric("AB")
      m.assertEqual(11, seg.getData().Count())
    end function

    @it("packs a trailing single character into 6 bits")
    function _()
      seg = BGE.QrCode.qrMakeAlphanumeric("ABC")
      m.assertEqual(17, seg.getData().Count()) ' 11 + 6
    end function

    @describe("qrMakeBytes")

    @it("packs each byte into 8 bits, preserving count and mode")
    function _()
      seg = BGE.QrCode.qrMakeBytes([72, 105])
      m.assertEqual(&h4, seg.mode.modeBits)
      m.assertEqual(2, seg.numChars)
      m.assertEqual(16, seg.getData().Count())
    end function

    @describe("getData")

    @it("returns an independent copy each call")
    function _()
      seg = BGE.QrCode.qrMakeBytes([1])
      a = seg.getData()
      a.Push(99)
      b = seg.getData()
      m.assertEqual(8, b.Count())
    end function

  end class
end namespace
