namespace BGE.QrCode

  ' Encodes `code` and draws it as a `width` x `width` square via `renderer`'s own
  ' draw surface - the single call a game needs (see docs/qr-codes.md). Exposed as
  ' a BGE.QrCode function rather than a Renderer.drawQRCode() method: a toolchain
  ' limitation in this project's exact brighterscript/bslint/rooibos-roku version
  ' combo means a pre-existing file (Renderer.bs) can't reference a symbol from a
  ' brand-new file, in either direction of indirection - see
  ' project_bslint_rooibos_new_file_bug in engine dev notes. Renderer.getDraw2d()/
  ' incrementDrawCalls() are the two tiny, itself-unaffected additions this needed.
  '
  ' @param {BGE.Renderer} renderer
  ' @param {float} x top-left x
  ' @param {float} y top-left y
  ' @param {string} code - text to encode (e.g. a URL - see Game.getControllerConnectionInfo())
  ' @param {float} width - rendered width/height in pixels (square)
  ' @param {integer} [darkRgba=BGE.Colors.Black]
  ' @param {integer} [lightRgba=BGE.Colors.White]
  ' @return {boolean} true if anything was drawn
  function draw(renderer as BGE.Renderer, x as float, y as float, code as string, width as float, darkRgba = BGE.Colors.Black as integer, lightRgba = BGE.Colors.White as integer) as boolean
    draw2d = renderer.getDraw2d()
    if draw2d = invalid or draw2d.GetWidth() = 0 or draw2d.getHeight() = 0 or width = 0
      return false
    end if
    if not renderer.isInsideCanvas(draw2d, x, y, width, width)
      return false
    end if
    qr = qrEncodeText(code, EccLevel.medium)
    renderer.incrementDrawCalls(qrDrawModules(draw2d, qr, x, y, width, darkRgba, lightRgba))
    return true
  end function

  ' Rasterizes an already-encoded QR Code onto `draw2d` as a `width` x `width`
  ' block of filled squares (one native DrawRect per module - a dense/high-
  ' version code costs more draw calls, same cost model as any other draw
  ' call). Used by draw() above, which owns the bounds-check/draw-call-count
  ' bookkeeping; this helper only rasterizes.
  '
  ' @param {ifDraw2d} draw2d
  ' @param {BGE.QrCode.QrCode} qr
  ' @param {float} x - top-left x
  ' @param {float} y - top-left y
  ' @param {float} width - rendered width/height in pixels (square)
  ' @param {integer} [darkRgba=BGE.Colors.Black]
  ' @param {integer} [lightRgba=BGE.Colors.White]
  ' @return {integer} - the number of DrawRect calls issued
  function qrDrawModules(draw2d as ifDraw2d, qr as BGE.QrCode.QrCode, x as float, y as float, width as float, darkRgba = BGE.Colors.Black as integer, lightRgba = BGE.Colors.White as integer) as integer
    moduleSize = width / qr.size
    draw2d.DrawRect(x, y, width, width, lightRgba)
    drawCalls = 1
    for row = 0 to qr.size - 1
      for col = 0 to qr.size - 1
        if qr.getModule(col, row)
          draw2d.DrawRect(x + col * moduleSize, y + row * moduleSize, moduleSize, moduleSize, darkRgba)
          drawCalls++
        end if
      end for
    end for
    return drawCalls
  end function

end namespace
