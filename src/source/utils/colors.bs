      WhiteSmoke: BGE.Colors.WhiteSmoke,
      Yellow: BGE.Colors.Yellow,
      YellowGreen: BGE.Colors.YellowGreen
    }
    if invalid <> lookup[name]
      return lookup[name]
    end if
    return BGE.Colors.White
  end function

  ' Looks up a BGE.ColorsRGB value by CSS color name (case-insensitive).
  ' Falls back to White for a name that isn't a known color.
  '
  ' @param {string} name
  ' @return {integer}
  function GetColorRGB(name as string) as integer
    lookup = {
      AliceBlue: BGE.ColorsRGB.AliceBlue,
      AntiqueWhite: BGE.ColorsRGB.AntiqueWhite,
      Aqua: BGE.ColorsRGB.Aqua,
      Aquamarine: BGE.ColorsRGB.Aquamarine,
      Azure: BGE.ColorsRGB.Azure,
