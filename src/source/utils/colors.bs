import "../math/math.bs"

namespace BGE

  function HSVtoRGBA(hPercent as float, sPercent as float, vPercent as float, a = -1 as integer) as integer
    ' Romans_I_XVI port (w/ a few tweaks) of: https://schinckel.net/2012/01/10/hsv-to-rgb-in-javascript/
    ' @see http://schinckel.net/2012/01/10/hsv-to-rgb-in-javascript/

    hPercent = hPercent mod 360

    rgb = [0, 0, 0]
    if sPercent = 0
      rgb = [vPercent / 100, vPercent / 100, vPercent / 100]
    else
      s = sPercent / 100 : v = vPercent / 100 : h = hPercent / 60 : i = int(h)

      data = [v * (1 - s), v * (1 - s * (h - i)), v * (1 - s * (1 - (h - i)))]

      if i = 0
        rgb = [v, data[2], data[0]]
      else if i = 1
        rgb = [data[1], v, data[0]]
      else if i = 2
        rgb = [data[0], v, data[2]]
      else if i = 3
        rgb = [data[0], data[1], v]
      else if i = 4
        rgb = [data[2], data[0], v]
      else
        rgb = [v, data[0], data[1]]
      end if
    end if

    for c = 0 to rgb.count() - 1
      rgb[c] = int(rgb[c] * 255)
    end for
    if a <> -1
      color% = (rgb[0] << 24) + (rgb[1] << 16) + (rgb[2] << 8) + a
    else
      color% = (rgb[0] << 16) + (rgb[1] << 8) + rgb[2]
    end if

    return color%
  end function

  function RGBAtoRGBA(red as integer, green as integer, blue as integer, alpha = 1 as float) as integer
    red% = (cint(BGE.Math.Clamp(red, 0, 255)) and &hFF) as integer
    green% = (cint(BGE.Math.Clamp(green, 0, 255)) and &hFF) as integer
    blue% = (cint(BGE.Math.Clamp(blue, 0, 255)) and &hFF) as integer
    if 0 > alpha
      alpha = 0
    else if 1 < alpha
      alpha = 1
    end if
    alphaInt% = (cint(BGE.Math.Clamp(cint(alpha * &hFF), 0, 255))and &hFF) as integer

    color% = (red% << 24) + (green% << 16) + (blue% << 8) + alphaInt%

    return color%
  end function

  ' Unpacks a packed RGB color (0xRRGGBB) into its R/G/B channels.
  '
  ' @param {integer} rgb
  ' @return {roAssociativeArray} {r, g, b}, each 0-255
  function unpackRGB(rgb as integer) as roAssociativeArray
    return {
      r: (rgb >> 16) and &hFF,
      g: (rgb >> 8) and &hFF,
      b: rgb and &hFF
    }
  end function

  ' Unpacks a packed RGBA color (0xRRGGBBAA) into its R/G/B/A channels.
  '
  ' @param {integer} rgba
  ' @return {roAssociativeArray} {r, g, b, a}, each 0-255
  function unpackRGBA(rgba as integer) as roAssociativeArray
    return {
      r: (rgba >> 24) and &hFF,
      g: (rgba >> 16) and &hFF,
      b: (rgba >> 8) and &hFF,
      a: rgba and &hFF
    }
  end function

