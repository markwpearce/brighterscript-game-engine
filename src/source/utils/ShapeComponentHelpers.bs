namespace BGE.ShapeComponentHelpers

  ' Hashes a shape type plus its current field values into a stable `tmp:/`
  ' filename - identical field values always produce the same filename, so
  ' repeated/discrete values are a cache hit and skip re-rendering entirely.
  ' A continuously-varying value (e.g. an Animation-driven tween) produces a
  ' new hash every frame and never benefits from the cache.
  '
  ' @param {string} shapeType distinguishes shape components from each other (e.g. "Circle")
  ' @param {string} cacheKey a string uniquely identifying this shape's current field values
  ' @return {string} a `tmp:/bge_shape_<hash>.png` file URI
  function getCacheUri(shapeType as string, cacheKey as string) as string
    bytes = CreateObject("roByteArray")
    bytes.FromAsciiString(shapeType + "|" + cacheKey)
    digest = CreateObject("roEVPDigest")
    digest.Setup("sha1")
    hash = digest.Process(bytes)
    return "tmp:/bge_shape_" + hash + ".png"
  end function

  ' Begins a cached shape render: computes the cache URI and, on a cache miss,
  ' creates a fresh roBitmap/BGE.Renderer pair for the caller to draw into.
  ' Call `finishShapeRender()` with the result after drawing (only needed when
  ' `hit` is false).
  '
  ' @param {string} shapeType distinguishes shape components from each other (e.g. "Circle")
  ' @param {string} cacheKey a string uniquely identifying this shape's current field values
  ' @param {integer} width bitmap width in pixels
  ' @param {integer} height bitmap height in pixels
  ' @return {object} `{uri, hit, renderer, bitmap}` - `renderer`/`bitmap` are invalid when
  '   `hit` is true (cache hit) or when the bitmap couldn't be created
  function beginShapeRender(shapeType as string, cacheKey as string, width as integer, height as integer) as object
    result = {uri: "", hit: false, renderer: invalid, bitmap: invalid}
    if width <= 0 or height <= 0
      return result
    end if
    result.uri = getCacheUri(shapeType, cacheKey)
    fileSystem = CreateObject("roFileSystem")
    if fileSystem.Exists(result.uri)
      result.hit = true
      return result
    end if
    bitmap = CreateObject("roBitmap", {width: width, height: height, AlphaEnable: true})
    if invalid = bitmap
      result.uri = ""
      return result
    end if
    result.bitmap = bitmap
    result.renderer = new BGE.Renderer(bitmap)
    return result
  end function

  ' Finishes a cache-miss render started by `beginShapeRender()`: realizes the
  ' queued draws (`Finish()` - there is no `roScreen` involved anywhere in a
  ' pure-SceneGraph process, so this is the only realization step available or
  ' needed here), encodes to PNG, and writes it to the cache URI.
  '
  ' @param {object} renderState the result of `beginShapeRender()`
  ' @return {boolean} true if the file was written successfully
  function finishShapeRender(renderState as object) as boolean
    if invalid = renderState.bitmap or "" = renderState.uri
      return false
    end if
    renderState.bitmap.Finish()
    png = renderState.bitmap.GetPng(0, 0, renderState.bitmap.GetWidth(), renderState.bitmap.GetHeight())
    if invalid = png
      return false
    end if
    return png.WriteFile(renderState.uri)
  end function

  ' Converts a SceneGraph `vertices` field value (a roArray of `{x, y}`-shaped
  ' associative arrays) into `BGE.Math.Vector[]`, as every `Renderer.draw*`
  ' polygon/triangle call expects.
  '
  ' @param {object} verticesField the raw field value (may be invalid or empty)
  ' @return {BGE.Math.Vector[]} converted points, empty if the field was empty/invalid
  function verticesFromField(verticesField as object) as BGE.Math.Vector[]
    points = []
    if invalid = verticesField
      return points
    end if
    for each point in verticesField
      points.push(BGE.Math.VectorOps.create(point.x, point.y))
    end for
    return points
  end function

end namespace
