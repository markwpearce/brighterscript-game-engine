namespace BGE

  ' The wait between a death and the respawn. Call start() when the player dies and update(dt)
  ' once per frame; update() returns true (and calls onRespawn()) on the frame the delay runs
  ' out. What a respawn does is up to the owner: reset the scene, send the player to a spawn
  ' point, refill health. Do it where update() returns true, or subclass and override
  ' onRespawn(). progress() can drive a fade or a countdown while waiting.
  '
  ' @example
  ' m.respawn = new BGE.RespawnTimer(2.0)
  ' ' When the player dies:
  ' m.respawn.start()
  ' ' In onUpdate(dt):
  ' if m.respawn.update(dt, not m.game.isTransitioning())
  '   m.game.resetScene()
  ' end if
  class RespawnTimer

    ' Seconds from start() to the respawn. Changing it mid-wait takes effect straight away.
    delaySeconds as float = 3.0

    private waiting as boolean = false
    private secondsWaited as float = 0.0

    ' @param {float} [delaySeconds=3]
    sub new(delaySeconds = 3.0 as float)
      m.delaySeconds = delaySeconds
    end sub

    ' Starts the wait. Does nothing if already waiting (so it's safe to call every frame while
    ' dead) unless restart is true, which starts the delay over.
    '
    ' @param {boolean} [restart=false]
    sub start(restart = false as boolean)
      if m.waiting and not restart
        return
      end if
      m.waiting = true
      m.secondsWaited = 0.0
    end sub

    ' Stops waiting without respawning.
    sub cancel()
      m.waiting = false
      m.secondsWaited = 0.0
    end sub

    ' Advances the wait. Once the delay has passed it respawns on the first update() where
    ' `ready` is true: the wait ends, onRespawn() is called, and this returns true.
    '
    ' @param {float} dt - seconds
    ' @param {boolean} [ready=true] - false holds a due respawn, e.g. while a scene transition runs
    ' @return {boolean} true on the update that respawned
    function update(dt as float, ready = true as boolean) as boolean
      if not m.waiting
        return false
      end if
      m.secondsWaited += dt
      if not ready or not m.isDue()
        return false
      end if
      ' ended first, so onRespawn() can start() a new wait
      m.waiting = false
      m.onRespawn()
      return true
    end function

    ' @return {boolean} whether it's waiting to respawn (including a due respawn held back by `ready`)
    function isWaiting() as boolean
      return m.waiting
    end function

    ' Whether the delay has passed and the respawn is only waiting for `ready`.
    '
    ' @return {boolean}
    function isDue() as boolean
      return m.waiting and m.secondsWaited >= m.delaySeconds
    end function

    ' Seconds since start() (0 when not waiting).
    '
    ' @return {float}
    function elapsed() as float
      if not m.waiting
        return 0.0
      end if
      return m.secondsWaited
    end function

    ' Seconds left of the delay (never negative; 0 when not waiting).
    '
    ' @return {float}
    function remaining() as float
      if not m.waiting or m.secondsWaited >= m.delaySeconds
        return 0.0
      end if
      return m.delaySeconds - m.secondsWaited
    end function

    ' 0 as the wait starts, rising to 1 as the delay runs out, e.g. for a fade (0 when not waiting).
    '
    ' @return {float}
    function progress() as float
      if not m.waiting
        return 0.0
      end if
      if m.delaySeconds <= 0 or m.secondsWaited >= m.delaySeconds
        return 1.0
      end if
      return m.secondsWaited / m.delaySeconds
    end function

    ' Called as it respawns, just before update() returns true. Override to do the respawn here
    ' instead of where update() is called.
    protected sub onRespawn()
    end sub

  end class

end namespace
