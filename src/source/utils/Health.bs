import "../math/math.bs"
import "CountdownTimer.bs"

namespace BGE

  ' Hit points: current and max, with an optional invulnerability window after each hit.
  ' damage() says whether the hit killed. Flashes, knockback and sounds stay with the entity,
  ' or go in the onDamaged()/onDeath() hooks of a subclass. Call update(dt) once per frame if
  ' you use invulnerableSeconds.
  '
  ' @example
  ' m.health = new BGE.Health(6)
  ' m.health.invulnerableSeconds = 1.0
  ' ' When something hits the player:
  ' if m.health.canTakeDamage()
  '   if m.health.damage(1)
  '     m.startDefeat()
  '   end if
  ' end if
  ' ' In onUpdate(dt):
  ' m.health.update(dt)
  class Health

    max as float = 100.0
    current as float = 100.0
    ' After each hit that lands, further hits are ignored for this long. 0 for none.
    invulnerableSeconds as float = 0.0

    private invulnerableTimer as BGE.CountdownTimer = new BGE.CountdownTimer()

    ' Starts at full health.
    '
    ' @param {float} [max=100]
    sub new(max = 100 as float)
      m.max = max
      m.current = max
    end sub

    ' @return {boolean} whether there's any health left
    function isAlive() as boolean
      return m.current > 0
    end function

    ' Whether damage() would land: alive and not invulnerable.
    '
    ' @return {boolean}
    function canTakeDamage() as boolean
      return m.isAlive() and not m.invulnerableTimer.isActive()
    end function

    ' Takes `amount`, never below zero, and starts the invulnerability window. Ignored while
    ' dead or invulnerable (see canTakeDamage()).
    '
    ' @param {float} amount
    ' @return {boolean} true if this hit killed
    function damage(amount as float) as boolean
      if not m.canTakeDamage()
        return false
      end if
      m.current = BGE.Math.Max(0, m.current - amount)
      if m.invulnerableSeconds > 0
        m.invulnerableTimer.start(m.invulnerableSeconds)
      end if
      m.onDamaged(amount)
      if m.current > 0
        return false
      end if
      m.onDeath()
      return true
    end function

    ' Adds `amount`, up to max. Doesn't bring back the dead; use refill() for that.
    '
    ' @param {float} amount
    sub heal(amount as float)
      if m.isAlive()
        m.current = BGE.Math.Min(m.max, m.current + amount)
      end if
    end sub

    ' Back to full health, with no invulnerability left.
    sub refill()
      m.current = m.max
      m.invulnerableTimer.stop()
    end sub

    ' Sets a new max and refills.
    '
    ' @param {float} max
    sub reset(max as float)
      m.max = max
      m.refill()
    end sub

    ' current / max, 0 to 1.
    '
    ' @return {float}
    function fraction() as float
      if m.max <= 0
        return 0
      end if
      return m.current / m.max
    end function

    ' Ignores hits for `seconds` (a dodge, or a respawn), replacing any window running.
    '
    ' @param {float} seconds
    sub makeInvulnerable(seconds as float)
      m.invulnerableTimer.start(seconds)
    end sub

    ' @return {boolean} whether hits are being ignored right now
    function isInvulnerable() as boolean
      return m.invulnerableTimer.isActive()
    end function

    ' Seconds of invulnerability left, e.g. to blink the sprite.
    '
    ' @return {float}
    function invulnerableRemaining() as float
      return m.invulnerableTimer.remaining()
    end function

    ' Counts down the invulnerability window. Call once per frame.
    '
    ' @param {float} dt - seconds
    sub update(dt as float)
      m.invulnerableTimer.tick(dt)
    end sub

    ' Called after a hit lands, before onDeath(). Override to react.
    '
    ' @param {float} amount - the damage asked for (current never goes below zero)
    protected sub onDamaged(amount as float)
    end sub

    ' Called once, when a hit takes the last of the health.
    protected sub onDeath()
    end sub

  end class

end namespace
