namespace BGE

  ' What a roUniversalControlEvent represents - see getControlEventKind().
  enum ControlEventKind
    button = "button"
    charPress = "charPress"
    charRelease = "charRelease"
  end enum

  ' Tells a remote button event apart from a character typed on a keyboard (e.g. the Roku
  ' mobile app's keyboard). A typed character arrives as its own press and release events,
  ' and its code can collide with a button code ("d" is 100, the same as a Back release),
  ' so check this before treating an event as a button.
  '
  ' @param {integer} controlCode - the event's GetInt()
  ' @param {integer} charCode - the event's GetChar()
  ' @return {BGE.ControlEventKind}
  function getControlEventKind(controlCode as integer, charCode as integer) as BGE.ControlEventKind
    ' GetChar() is 0 for every remote button (including the keyboard's Backspace/Enter keys),
    ' and a typed character's release reports GetInt() = char + 100.
    if charCode = 0
      return BGE.ControlEventKind.button
    else if charCode = controlCode
      return BGE.ControlEventKind.charPress
    end if
    return BGE.ControlEventKind.charRelease
  end function

end namespace
