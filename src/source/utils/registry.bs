import "../engine/debug/Log.bs"
namespace BGE

  ' Writes a value to the device registry as JSON and flushes it.
  '
  ' @param {string} registry_section
  ' @param {string} key
  ' @param {dynamic} value - anything FormatJson() can write
  ' @return {boolean} false if the value can't be written as JSON (e.g. it holds a function
  '   or an roBitmap) or the registry refused it (it's full); nothing is written then
  function registryWrite(registry_section as string, key as string, value as dynamic) as boolean
    json = FormatJson(value)
    ' FormatJson() gives "" for what it can't write (an empty string value is """")
    if json = ""
      BGE.Debug.logMessage("[BGE.registry] " + registry_section + "/" + key + " can't be written as JSON", BGE.Debug.LogLevel.warning)
      return false
    end if
    section = CreateObject("roRegistrySection", registry_section)
    if not section.Write(key, json) or not section.Flush()
      BGE.Debug.logMessage("[BGE.registry] couldn't write " + registry_section + "/" + key + " (" + Len(json).ToStr() + " characters) - is the registry full?", BGE.Debug.LogLevel.warning)
      return false
    end if
    return true
  end function

  ' Reads a value written with registryWrite(). Doesn't write the default.
  '
  ' @param {string} registry_section
  ' @param {string} key
  ' @param {dynamic} [default_value=invalid] - returned when the key is missing
  ' @return {dynamic}
  function registryRead(registry_section as string, key as string, default_value = invalid as dynamic) as dynamic
    section = CreateObject("roRegistrySection", registry_section)
    if section.Exists(key)
      return ParseJson(section.Read(key))
    end if
    return default_value
  end function

  ' Is there a value for this key?
  '
  ' @param {string} registry_section
  ' @param {string} key
  ' @return {boolean}
  function registryExists(registry_section as string, key as string) as boolean
    return CreateObject("roRegistrySection", registry_section).Exists(key)
  end function

  ' Deletes a key and flushes.
  '
  ' @param {string} registry_section
  ' @param {string} key
  sub registryDelete(registry_section as string, key as string)
    section = CreateObject("roRegistrySection", registry_section)
    section.Delete(key)
    section.Flush()
  end sub

end namespace
