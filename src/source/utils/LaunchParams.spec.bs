import "pkg:/source/utils/LaunchParams.bs"
import "pkg:/source/engine/Game.bs"

namespace tests
  @suite("BGE.LaunchParams")
  class LaunchParamsTests extends rooibos.BaseTestSuite

    @describe("unwrapping")

    @it("reads a plain AA")
    function _()
      params = new BGE.LaunchParams({level: "3"})
      m.assertEqual("3", params.getString("level"))
    end function

    @it("unwraps an AA in a one-element array")
    function _()
      params = new BGE.LaunchParams([{level: "3"}])
      m.assertEqual(3, params.getInt("level"))
    end function

    @it("unwraps values in one-element arrays")
    function _()
      params = new BGE.LaunchParams({level: ["3"], empty: []})
      m.assertEqual(3, params.getInt("level"))
      m.assertTrue(params.has("level"))
      m.assertFalse(params.has("empty"))
    end function

    @it("leaves arrays of more than one value alone")
    function _()
      params = new BGE.LaunchParams({list: ["a", "b"]})
      m.assertEqual(2, params.toAA().list.count())
      m.assertEqual("d", params.getString("list", "d"))
    end function

    @it("treats invalid or a non-AA as no params")
    function _()
      fromInvalid = new BGE.LaunchParams(invalid)
      fromString = new BGE.LaunchParams("x")
      noArgs = new BGE.LaunchParams()
      m.assertEqual(0, fromInvalid.keys().count())
      m.assertEqual(0, fromString.keys().count())
      m.assertEqual("d", noArgs.getString("missing", "d"))
    end function

    @describe("getInt / getFloat")

    @it("gives the default when missing or not a whole number")
    function _()
      params = new BGE.LaunchParams({a: "abc", b: "1.5", c: " 7 "})
      m.assertEqual(5, params.getInt("a", 5))
      m.assertEqual(5, params.getInt("b", 5))
      m.assertEqual(7, params.getInt("c", 5))
      m.assertEqual(5, params.getInt("missing", 5))
    end function

    @it("clamps to min and max")
    function _()
      params = new BGE.LaunchParams({low: "-4", high: "99"})
      m.assertEqual(1, params.getInt("low", 2, 1, 9))
      m.assertEqual(9, params.getInt("high", 2, 1, 9))
    end function

    @it("takes non-string numbers, e.g. from scene args")
    function _()
      params = new BGE.LaunchParams({level: 2, speed: 1.5})
      m.assertEqual(2, params.getInt("level"))
      m.assertEqual(1.5, params.getFloat("speed"))
      m.assertEqual("2", params.getString("level"))
    end function

    @it("gives the default for a float that isn't whole")
    function _()
      params = new BGE.LaunchParams({a: 2.6, b: 3.0})
      m.assertEqual(1, params.getInt("a", 1))
      m.assertEqual(3, params.getInt("b", 1))
    end function

    @it("clamps numbers too long for an integer instead of overflowing")
    function _()
      params = new BGE.LaunchParams({big: "99999999999", small: "-99999999999", edge: "2147483647", over: "2147483648"})
      m.assertEqual(9, params.getInt("big", 1, 1, 9))
      m.assertEqual(1, params.getInt("small", 5, 1, 9))
      m.assertEqual(&h7FFFFFFF, params.getInt("edge"))
      m.assertEqual(&h7FFFFFFF, params.getInt("over"))
    end function

    @it("fitsInInteger checks the 32-bit range")
    function _()
      m.assertTrue(BGE.fitsInInteger("2147483647"))
      m.assertTrue(BGE.fitsInInteger("-2147483648"))
      m.assertTrue(BGE.fitsInInteger("+0002147483647"))
      m.assertFalse(BGE.fitsInInteger("2147483648"))
      m.assertFalse(BGE.fitsInInteger("-2147483649"))
      m.assertFalse(BGE.fitsInInteger("12345678901"))
    end function

    @it("parses floats")
    function _()
      params = new BGE.LaunchParams({a: "-0.5", b: "1e2", c: "x"})
      m.assertEqual(-0.5, params.getFloat("a"))
      m.assertEqual(100.0, params.getFloat("b"))
      m.assertEqual(2.5, params.getFloat("c", 2.5))
    end function

    @describe("getBool")

    @it("reads the usual spellings and falls back to the default")
    function _()
      params = new BGE.LaunchParams({a: "1", b: "TRUE", c: "off", d: "0", e: "maybe", f: true})
      m.assertTrue(params.getBool("a"))
      m.assertTrue(params.getBool("b"))
      m.assertFalse(params.getBool("c", true))
      m.assertFalse(params.getBool("d", true))
      m.assertTrue(params.getBool("e", true))
      m.assertTrue(params.getBool("f"))
      m.assertFalse(params.getBool("missing"))
    end function

    @describe("lists")

    @it("getList trims and drops empty entries")
    function _()
      params = new BGE.LaunchParams({items: " key, ,map,"})
      m.assertEqual(["key", "map"], params.getList("items"))
      m.assertEqual(0, params.getList("missing").count())
    end function

    @it("getIntList reads numbers, or invalid on a bad entry")
    function _()
      params = new BGE.LaunchParams({at: "4, 7,-90", bad: "4,x"})
      m.assertEqual([4, 7, -90], params.getIntList("at"))
      m.assertInvalid(params.getIntList("bad"))
      m.assertEqual(0, params.getIntList("missing").count())
    end function

    @it("getFloatList reads numbers, or invalid on a bad entry")
    function _()
      params = new BGE.LaunchParams({at: "4,22.5", bad: "4,x"})
      m.assertEqual([4.0, 22.5], params.getFloatList("at"))
      m.assertInvalid(params.getFloatList("bad"))
    end function

    @it("getCounts reads id:n, id=n and bare ids")
    function _()
      params = new BGE.LaunchParams({items: "key:2,map,coin=5,bad:x"})
      counts = params.getCounts("items")
      m.assertEqual(2, counts.key)
      m.assertEqual(1, counts.map)
      m.assertEqual(5, counts.coin)
      m.assertFalse(counts.DoesExist("bad"))
    end function

    @describe("pick")

    @it("copies only the given names that are present")
    function _()
      params = new BGE.LaunchParams({a: ["1"], b: "2", c: "3"})
      picked = params.pick(["a", "c", "missing"], {place: "keep"})
      m.assertEqual("1", picked.a)
      m.assertEqual("3", picked.c)
      m.assertEqual("keep", picked.place)
      m.assertFalse(picked.DoesExist("b"))
      m.assertFalse(picked.DoesExist("missing"))
    end function

    @it("toAA copies everything, unwrapped")
    function _()
      params = new BGE.LaunchParams([{a: ["1"], b: "2"}])
      all = params.toAA()
      m.assertEqual("1", all.a)
      m.assertEqual("2", all.b)
      m.assertEqual(2, all.count())
    end function

    @describe("sceneName")

    @it("matches scene names in any case")
    function _()
      params = new BGE.LaunchParams({scene: "cryptscene"})
      m.assertEqual("CryptScene", params.sceneName(["TownScene", "CryptScene"], "TownScene"))
    end function

    @it("follows aliases")
    function _()
      params = new BGE.LaunchParams({scene: "crypt"})
      m.assertEqual("CryptScene", params.sceneName(["TownScene", "CryptScene"], "TownScene", {crypt: "CryptScene"}))
    end function

    @it("gives the default for a missing or unknown scene")
    function _()
      names = ["TownScene", "CryptScene"]
      missing = new BGE.LaunchParams({})
      unknown = new BGE.LaunchParams({scene: "moon"})
      badAlias = new BGE.LaunchParams({scene: "x"})
      m.assertEqual("TownScene", missing.sceneName(names, "TownScene"))
      m.assertEqual("TownScene", unknown.sceneName(names, "TownScene"))
      m.assertEqual("TownScene", badAlias.sceneName(names, "TownScene", {x: "Nope"}))
    end function

    @it("can read another key")
    function _()
      params = new BGE.LaunchParams({room: "CryptScene"})
      m.assertEqual("CryptScene", params.sceneName(["TownScene", "CryptScene"], "TownScene", {}, "room"))
    end function

    @describe("Game.applyLaunchQuality")

    @it("pins a valid level")
    function _()
      game = new BGE.Game(320, 240)
      m.assertTrue(game.applyLaunchQuality(new BGE.LaunchParams({quality: "1"})))
      m.assertEqual(BGE.RenderQualityLevel.low, game.renderQuality.getLevel())
      m.assertFalse(game.renderQuality.isAdaptive())
    end function

    @it("changes nothing without a valid level")
    function _()
      game = new BGE.Game(320, 240)
      game.enableAdaptiveQuality()
      m.assertFalse(game.applyLaunchQuality(new BGE.LaunchParams({})))
      m.assertFalse(game.applyLaunchQuality(new BGE.LaunchParams({quality: "9"})))
      m.assertFalse(game.applyLaunchQuality(new BGE.LaunchParams({quality: "high"})))
      m.assertTrue(game.renderQuality.isAdaptive())
    end function

  end class
end namespace
