namespace BGE.FileTypes

  ' Whether an extension (e.g. ".png") is a file type the engine's loaders read.
  '
  ' @param {string} extension - lowercase, with the dot
  ' @return {boolean}
  function isKnownAssetExtension(extension as string) as boolean
    known = {".png": true, ".jpg": true, ".jpeg": true, ".webp": true, ".bmp": true, ".gif": true, ".ttf": true, ".otf": true, ".wav": true, ".mp3": true, ".obj": true, ".stl": true, ".mtl": true}
    return known.DoesExist(LCase(extension))
  end function

  ' Whether an extension (e.g. ".png") is an image type a bitmap can be loaded from.
  '
  ' @param {string} extension - lowercase, with the dot
  ' @return {boolean}
  function isImageExtension(extension as string) as boolean
    images = {".png": true, ".jpg": true, ".jpeg": true, ".webp": true, ".bmp": true, ".gif": true}
    return images.DoesExist(LCase(extension))
  end function

  ' The file extension for a `Content-Type` header (e.g. "image/jpeg; charset=x" -> ".jpg").
  '
  ' @param {string} contentType
  ' @return {string} the extension, or "" for a type that isn't a known asset type
  function forContentType(contentType as string) as string
    mimeType = contentType
    separator = mimeType.Instr(";")
    if separator >= 0
      mimeType = mimeType.Left(separator)
    end if
    mimeType = LCase(mimeType.Trim())
    extensions = {
      "image/png": ".png",
      "image/jpeg": ".jpg",
      "image/jpg": ".jpg",
      "image/webp": ".webp",
      "image/gif": ".gif",
      "image/bmp": ".bmp",
      "font/ttf": ".ttf",
      "application/x-font-ttf": ".ttf",
      "font/otf": ".otf",
      "application/x-font-otf": ".otf",
      "audio/wav": ".wav",
      "audio/x-wav": ".wav",
      "audio/wave": ".wav",
      "audio/mpeg": ".mp3",
      "model/obj": ".obj",
      "model/stl": ".stl",
      "application/sla": ".stl"
    }
    extension = extensions[mimeType]
    if extension = invalid
      return ""
    end if
    return extension
  end function

  ' Works out a file's type from its first few bytes: images, fonts and sounds.
  '
  ' @param {string} path - a local file
  ' @return {string} the extension (e.g. ".png"), or "" if the type isn't recognised
  function sniffExtension(path as string) as string
    bytes = CreateObject("roByteArray")
    if not bytes.ReadFile(path, 0, 12)
      return ""
    end if
    count = bytes.count()
    if count >= 4 and bytes[0] = &h89 and bytes[1] = &h50 and bytes[2] = &h4E and bytes[3] = &h47
      return ".png"
    end if
    if count >= 3 and bytes[0] = &hFF and bytes[1] = &hD8 and bytes[2] = &hFF
      return ".jpg"
    end if
    if count >= 4 and bytes[0] = &h00 and bytes[1] = &h01 and bytes[2] = &h00 and bytes[3] = &h00
      return ".ttf"
    end if
    start4 = BGE.FileTypes.byteText(bytes, 0, 4)
    if start4 = "GIF8"
      return ".gif"
    end if
    if start4 = "RIFF" and count >= 12
      riffType = BGE.FileTypes.byteText(bytes, 8, 4)
      if riffType = "WEBP"
        return ".webp"
      else if riffType = "WAVE"
        return ".wav"
      end if
    end if
    if start4 = "true"
      return ".ttf"
    end if
    if start4 = "OTTO"
      return ".otf"
    end if
    if start4.Left(3) = "ID3"
      return ".mp3"
    end if
    if count >= 2 and bytes[0] = &hFF and (bytes[1] and &hF0) = &hF0
      return ".mp3"
    end if
    if start4.Left(2) = "BM"
      return ".bmp"
    end if
    return ""
  end function

  ' Bytes as text, for comparing file signatures. Stops early at the end of the array; bytes
  ' outside printable ASCII become "?".
  '
  ' @param {roByteArray} bytes
  ' @param {integer} start
  ' @param {integer} length
  ' @return {string}
  function byteText(bytes as roByteArray, start as integer, length as integer) as string
    text = ""
    for i = start to start + length - 1
      if i >= bytes.count()
        exit for
      end if
      value = bytes[i]
      if value >= 32 and value < 127
        text += Chr(value)
      else
        text += "?"
      end if
    end for
    return text
  end function

end namespace
