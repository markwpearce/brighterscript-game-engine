import "../engine/drawables/Sprite.bs"
import "../engine/drawables/DrawableOrientedSprite.bs"
import "CountdownTimer.bs"

namespace BGE

  ' A state name and how long it's been in it, for state-machine entities (enemy AI, a
  ' player's attack/dodge/hurt states, a boss's phases). Call update(dt) once per frame, at the
  ' top of onUpdate(), then branch on `state`.
  '
  ' set() enters an open-ended state; setTimed() one that lasts a set time (isTimeUp(),
  ' remainingFraction()). justEntered() is true for the first update after a state is entered,
  ' for one-off entry work. Optionally, give it a sprite and play() switches its animation
  ' only when the name changes. Subclass and override onEnter() for anything else.
  '
  ' @example
  ' m.clock = new BGE.StateClock("idle")
  ' m.clock.sprite = m.sprite
  ' ' In onUpdate(dt):
  ' m.clock.update(dt)
  ' if m.clock.state = "windup"
  '   if m.clock.seconds >= 0.4
  '     m.clock.setTimed("strike", 0.25)
  '     m.clock.play("strike")
  '   end if
  ' else if m.clock.state = "strike"
  '   if m.clock.justEntered()
  '     m.playSound("swing")
  '   end if
  '   if m.clock.isTimeUp()
  '     m.clock.set("idle")
  '     m.clock.play("idle")
  '   end if
  ' end if
  class StateClock

    ' The current state
    state as string = ""
    ' The state before this one
    previousState as string = ""
    ' Seconds since the state was entered, counted by update()
    seconds as float = 0.0
    ' Optional: play() switches this sprite's animation
    sprite as BGE.Sprite = invalid
    ' Optional: play() switches this sprite's oriented animation (playOrientedAnimation())
    orientedSprite as BGE.DrawableOrientedSprite = invalid
    ' The animation play() last switched to
    animation as string = ""

    private timed as boolean = false
    private duration as float = 0.0
    private timer as BGE.CountdownTimer = new BGE.CountdownTimer()
    ' Entered since the last update(), and entered as of the last update()
    private entryPending as boolean = false
    private entered as boolean = false

    ' @param {string} [state=""] - the starting state (not "entered": justEntered() stays false)
    sub new(state = "" as string)
      m.state = state
    end sub

    ' Enters `state` with no time limit. Setting the current state again does nothing (so it's
    ' safe to call every frame) unless restart is true, which enters it afresh.
    '
    ' @param {string} state
    ' @param {boolean} [restart=false]
    ' @return {boolean} whether the state was entered
    function set(state as string, restart = false as boolean) as boolean
      if state = m.state and not restart
        return false
      end if
      m.timed = false
      m.timer.stop()
      m.enter(state)
      return true
    end function

    ' Enters (or re-enters) `state` for `durationSeconds`; isTimeUp() turns true once they've
    ' passed. The clock doesn't leave the state by itself.
    '
    ' @param {string} state
    ' @param {float} durationSeconds
    sub setTimed(state as string, durationSeconds as float)
      m.timed = true
      m.duration = durationSeconds
      m.timer.start(durationSeconds)
      m.enter(state)
    end sub

    ' Advances the clock. Call once per frame.
    '
    ' @param {float} dt - seconds
    sub update(dt as float)
      m.seconds += dt
      m.timer.tick(dt)
      m.entered = m.entryPending
      m.entryPending = false
    end sub

    ' True during the first update after the state was entered (from the update() call until
    ' the next one), so entry work runs once.
    '
    ' @return {boolean}
    function justEntered() as boolean
      return m.entered
    end function

    ' Whether a timed state's duration has passed. Always false for a set() state.
    '
    ' @return {boolean}
    function isTimeUp() as boolean
      return m.timed and not m.timer.isActive()
    end function

    ' Seconds left of a timed state (0 for a set() state).
    '
    ' @return {float}
    function remaining() as float
      return m.timer.remaining()
    end function

    ' 1 as a timed state starts, falling to 0 as its time runs out (0 for a set() state).
    '
    ' @return {float}
    function remainingFraction() as float
      if not m.timed or m.duration <= 0
        return 0
      end if
      return m.timer.remaining() / m.duration
    end function

    ' Switches the sprite's animation if `animation` isn't the one play() last switched to,
    ' or restart is true. Needs sprite or orientedSprite set.
    '
    ' @param {string} animation
    ' @param {boolean} [restart=false] - play it from the start even if it's already playing
    sub play(animation as string, restart = false as boolean)
      if animation = m.animation and not restart
        return
      end if
      m.animation = animation
      m.playAnimation(animation, restart)
    end sub

    ' Called by play() to switch the animation. Override for something other than a sprite.
    '
    ' @param {string} animation
    ' @param {boolean} restart
    protected sub playAnimation(animation as string, restart as boolean)
      if invalid <> m.orientedSprite
        m.orientedSprite.playOrientedAnimation(animation, restart)
      else if invalid <> m.sprite
        m.sprite.playAnimation(animation, restart)
      end if
    end sub

    ' Called each time a state is entered, after state and seconds are set. Override to react.
    '
    ' @param {string} previousState
    protected sub onEnter(previousState as string)
    end sub

    private sub enter(state as string)
      m.previousState = m.state
      m.state = state
      m.seconds = 0.0
      m.entryPending = true
      m.entered = false
      m.onEnter(m.previousState)
    end sub

  end class

end namespace
