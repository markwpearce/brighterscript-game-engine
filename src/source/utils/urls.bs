import "strings.bs"

namespace BGE.Urls

  ' Whether a path is an http:// or https:// URL rather than a local file.
  '
  ' @param {dynamic} path
  ' @return {boolean}
  function isUrl(path as dynamic) as boolean
    if path = invalid or GetInterface(path, "ifString") = invalid
      return false
    end if
    lowerPath = LCase(path)
    return lowerPath.StartsWith("http://") or lowerPath.StartsWith("https://")
  end function

  ' A URL without its query string or fragment.
  '
  ' @param {string} url
  ' @return {string}
  function stripQuery(url as string) as string
    cut = Len(url)
    queryStart = url.Instr("?")
    if queryStart >= 0 and queryStart < cut
      cut = queryStart
    end if
    fragmentStart = url.Instr("#")
    if fragmentStart >= 0 and fragmentStart < cut
      cut = fragmentStart
    end if
    return url.Left(cut)
  end function

  ' The lowercase file extension of a URL's path (e.g. ".png"), or "" if it has none.
  '
  ' @param {string} url
  ' @return {string}
  function fileExtension(url as string) as string
    urlPath = BGE.Urls.stripQuery(url)
    fileName = urlPath.Mid(BGE.lastInStr(urlPath, "/") + 1)
    dotIndex = BGE.lastInStr(fileName, ".")
    if dotIndex < 0
      return ""
    end if
    extension = LCase(fileName.Mid(dotIndex))
    ' a dot in a folder-like name ("v1.2") isn't an extension
    if Len(extension) < 2 or Len(extension) > 6
      return ""
    end if
    return extension
  end function

  ' Resolves a path found inside a downloaded file (e.g. an .obj's `mtllib`) against that file's URL.
  ' "./" and "../" are resolved, and a "//host/path" URL takes the base URL's scheme.
  '
  ' @param {string} baseUrl - the URL of the file the path came from
  ' @param {string} relativePath - a relative path, a root-relative path ("/a/b.png") or a full URL
  ' @return {string} the full URL
  function resolveRelative(baseUrl as string, relativePath as string) as string
    if BGE.Urls.isUrl(relativePath)
      return relativePath
    end if
    base = BGE.Urls.stripQuery(baseUrl)
    schemeEnd = base.Instr("://")
    if relativePath.StartsWith("//")
      return base.Left(schemeEnd + 1) + relativePath
    end if
    hostStart = schemeEnd + 3
    pathStart = base.Instr(hostStart, "/")
    origin = base
    basePath = "/"
    if pathStart >= 0
      origin = base.Left(pathStart)
      basePath = base.Mid(pathStart)
    end if
    ' the relative part's own query/fragment is kept as is
    relativeUrlPath = BGE.Urls.stripQuery(relativePath)
    suffix = relativePath.Mid(Len(relativeUrlPath))
    fullPath = relativeUrlPath
    if not relativeUrlPath.StartsWith("/")
      fullPath = basePath.Left(BGE.lastInStr(basePath, "/") + 1) + relativeUrlPath
    end if
    return origin + BGE.Urls.normalizePath(fullPath) + suffix
  end function

  ' Collapses "." and ".." segments in a URL path that starts with "/", never going above the root.
  '
  ' @param {string} urlPath
  ' @return {string}
  function normalizePath(urlPath as string) as string
    segments = urlPath.Split("/")
    output = []
    lastIndex = segments.count() - 1
    for i = 1 to lastIndex
      segment = segments[i]
      if segment = "." or segment = ".."
        if segment = ".." and output.count() > 0
          output.Pop()
        end if
        if i = lastIndex
          ' "a/b/.." is the folder "a/"
          output.Push("")
        end if
      else
        output.Push(segment)
      end if
    end for
    return "/" + output.Join("/")
  end function

end namespace
