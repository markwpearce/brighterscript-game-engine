import "strings.bs"

namespace BGE

  ' Where downloads are cached between launches (the OS may clear it when space runs low)
  const DOWNLOAD_CACHE_FOLDER = "cachefs:/bge"
  ' Where downloads with `cache: false` go - cleared when the channel exits
  const DOWNLOAD_TEMP_FOLDER = "tmp:/bge"

  ' Whether a path is an http:// or https:// URL rather than a local file.
  '
  ' @param {dynamic} path
  ' @return {boolean}
  function isUrl(path as dynamic) as boolean
    if path = invalid or GetInterface(path, "ifString") = invalid
      return false
    end if
    lowerPath = LCase(path)
    return lowerPath.StartsWith("http://") or lowerPath.StartsWith("https://")
  end function

  ' A URL without its query string or fragment.
  '
  ' @param {string} url
  ' @return {string}
  function stripUrlQuery(url as string) as string
    cut = Len(url)
    queryStart = url.Instr("?")
    if queryStart >= 0 and queryStart < cut
      cut = queryStart
    end if
    fragmentStart = url.Instr("#")
    if fragmentStart >= 0 and fragmentStart < cut
      cut = fragmentStart
    end if
    return url.Left(cut)
  end function

  ' The lowercase file extension of a URL's path (e.g. ".png"), or "" if it has none.
  '
  ' @param {string} url
  ' @return {string}
  function urlFileExtension(url as string) as string
    urlPath = BGE.stripUrlQuery(url)
    fileName = urlPath.Mid(BGE.lastInStr(urlPath, "/") + 1)
    dotIndex = BGE.lastInStr(fileName, ".")
    if dotIndex < 0
      return ""
    end if
    extension = LCase(fileName.Mid(dotIndex))
    ' a dot in a folder-like name ("v1.2") isn't an extension
    if Len(extension) < 2 or Len(extension) > 6
      return ""
    end if
    return extension
  end function

  ' Resolves a path found inside a downloaded file (e.g. an .obj's `mtllib`) against that file's URL.
  ' "./" and "../" are resolved, and a "//host/path" URL takes the base URL's scheme.
  '
  ' @param {string} baseUrl - the URL of the file the path came from
  ' @param {string} relativePath - a relative path, a root-relative path ("/a/b.png") or a full URL
  ' @return {string} the full URL
  function resolveRelativeUrl(baseUrl as string, relativePath as string) as string
    if BGE.isUrl(relativePath)
      return relativePath
    end if
    base = BGE.stripUrlQuery(baseUrl)
    schemeEnd = base.Instr("://")
    if relativePath.StartsWith("//")
      return base.Left(schemeEnd + 1) + relativePath
    end if
    hostStart = schemeEnd + 3
    pathStart = base.Instr(hostStart, "/")
    origin = base
    basePath = "/"
    if pathStart >= 0
      origin = base.Left(pathStart)
      basePath = base.Mid(pathStart)
    end if
    ' the relative part's own query/fragment is kept as is
    relativeUrlPath = BGE.stripUrlQuery(relativePath)
    suffix = relativePath.Mid(Len(relativeUrlPath))
    fullPath = relativeUrlPath
    if not relativeUrlPath.StartsWith("/")
      fullPath = basePath.Left(BGE.lastInStr(basePath, "/") + 1) + relativeUrlPath
    end if
    return origin + BGE.normalizeUrlPath(fullPath) + suffix
  end function

  ' Collapses "." and ".." segments in a URL path that starts with "/", never going above the root.
  '
  ' @param {string} urlPath
  ' @return {string}
  function normalizeUrlPath(urlPath as string) as string
    segments = urlPath.Split("/")
    output = []
    lastIndex = segments.count() - 1
    for i = 1 to lastIndex
      segment = segments[i]
      if segment = "." or segment = ".."
        if segment = ".." and output.count() > 0
          output.Pop()
        end if
        if i = lastIndex
          ' "a/b/.." is the folder "a/"
          output.Push("")
        end if
      else
        output.Push(segment)
      end if
    end for
    return "/" + output.Join("/")
  end function

  ' The folder downloads are written to.
  '
  ' @param {boolean} useCache - true for the cachefs: cache, false for tmp:
  ' @return {string}
  function getDownloadFolder(useCache as boolean) as string
    if useCache
      return BGE.DOWNLOAD_CACHE_FOLDER
    end if
    return BGE.DOWNLOAD_TEMP_FOLDER
  end function

  ' The local file a URL downloads to when its own extension is used: the MD5 of the URL plus
  ' the URL's extension, so the same URL always maps to the same file and the loaders can still
  ' tell the file type.
  '
  ' @param {string} url
  ' @param {boolean} useCache - true for the cachefs: cache, false for tmp:
  ' @return {string}
  function getDownloadPath(url as string, useCache as boolean) as string
    return BGE.getDownloadBasePath(url, useCache) + BGE.urlFileExtension(url)
  end function

  ' The local file a URL downloads to, without an extension: the download folder plus the MD5
  ' of the URL. The downloaded file is this plus the extension of its type.
  '
  ' @param {string} url
  ' @param {boolean} useCache - true for the cachefs: cache, false for tmp:
  ' @return {string}
  function getDownloadBasePath(url as string, useCache as boolean) as string
    digest = CreateObject("roEVPDigest")
    digest.Setup("md5")
    bytes = CreateObject("roByteArray")
    bytes.FromAsciiString(url)
    return BGE.getDownloadFolder(useCache) + "/" + LCase(digest.Process(bytes))
  end function

end namespace
