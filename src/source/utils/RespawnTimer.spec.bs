import "pkg:/source/utils/RespawnTimer.bs"

namespace tests

  ' Counts onRespawn() calls
  class CountingRespawnTimer extends BGE.RespawnTimer
    respawns as integer = 0

    sub new(delaySeconds as float)
      super(delaySeconds)
    end sub

    protected override sub onRespawn()
      m.respawns += 1
    end sub
  end class

  @suite("BGE.RespawnTimer")
  class RespawnTimerTests extends rooibos.BaseTestSuite

    @describe("waiting")

    @it("isn't waiting until started")
    function _()
      timer = new BGE.RespawnTimer(1.0)
      m.assertFalse(timer.isWaiting())
      m.assertFalse(timer.update(5.0))
    end function

    @it("respawns once the delay has passed, and only once")
    function _()
      timer = new BGE.RespawnTimer(1.0)
      timer.start()
      m.assertTrue(timer.isWaiting())
      m.assertFalse(timer.update(0.5))
      m.assertFalse(timer.update(0.25))
      m.assertTrue(timer.update(0.25))
      m.assertFalse(timer.isWaiting())
      m.assertFalse(timer.update(1.0))
    end function

    @it("defaults to a 3 second delay")
    function _()
      timer = new BGE.RespawnTimer()
      m.assertEqual(timer.delaySeconds, 3.0)
    end function

    @it("start() while waiting doesn't restart the delay, so it's safe every frame")
    function _()
      timer = new BGE.RespawnTimer(1.0)
      timer.start()
      timer.update(0.75)
      timer.start()
      m.assertTrue(timer.update(0.25))
    end function

    @it("start(true) restarts the delay")
    function _()
      timer = new BGE.RespawnTimer(1.0)
      timer.start()
      timer.update(0.75)
      timer.start(true)
      m.assertFalse(timer.update(0.25))
      m.assertTrue(timer.update(0.75))
    end function

    @it("cancel() stops the wait without respawning")
    function _()
      timer = new BGE.RespawnTimer(1.0)
      timer.start()
      timer.update(0.5)
      timer.cancel()
      m.assertFalse(timer.isWaiting())
      m.assertFalse(timer.update(1.0))
      m.assertEqual(timer.elapsed(), 0.0)
    end function

    @it("a zero delay respawns on the next update")
    function _()
      timer = new BGE.RespawnTimer(0.0)
      timer.start()
      m.assertTrue(timer.update(0.0))
    end function

    @describe("ready")

    @it("holds a due respawn while not ready, then respawns once it is")
    function _()
      timer = new BGE.RespawnTimer(1.0)
      timer.start()
      m.assertFalse(timer.update(1.0, false))
      m.assertTrue(timer.isDue())
      m.assertTrue(timer.isWaiting())
      m.assertFalse(timer.update(0.5, false))
      m.assertTrue(timer.update(0.5, true))
      m.assertFalse(timer.isDue())
    end function

    @it("isn't due before the delay has passed, ready or not")
    function _()
      timer = new BGE.RespawnTimer(1.0)
      timer.start()
      m.assertFalse(timer.update(0.5, true))
      m.assertFalse(timer.isDue())
    end function

    @describe("time")

    @it("reports elapsed, remaining and progress for a fade or countdown")
    function _()
      timer = new BGE.RespawnTimer(2.0)
      m.assertEqual(timer.progress(), 0.0)
      timer.start()
      timer.update(0.5)
      m.assertEqual(timer.elapsed(), 0.5)
      m.assertEqual(timer.remaining(), 1.5)
      m.assertEqual(timer.progress(), 0.25)
      timer.update(3.0, false)
      m.assertEqual(timer.remaining(), 0.0)
      m.assertEqual(timer.progress(), 1.0)
    end function

    @it("progress() is 1 straight away with no delay")
    function _()
      timer = new BGE.RespawnTimer(0.0)
      timer.start()
      m.assertEqual(timer.progress(), 1.0)
    end function

    @it("follows a delaySeconds changed mid-wait")
    function _()
      timer = new BGE.RespawnTimer(1.0)
      timer.start()
      timer.update(0.75)
      timer.delaySeconds = 2.0
      m.assertFalse(timer.update(0.5))
      m.assertTrue(timer.update(0.75))
    end function

    @describe("onRespawn")

    @it("calls onRespawn() once, as it respawns")
    function _()
      timer = new tests.CountingRespawnTimer(0.5)
      timer.start()
      timer.update(0.25)
      m.assertEqual(timer.respawns, 0)
      m.assertTrue(timer.update(0.25))
      m.assertEqual(timer.respawns, 1)
      timer.update(1.0)
      m.assertEqual(timer.respawns, 1)
    end function

    @it("can start() a new wait after respawning")
    function _()
      timer = new tests.CountingRespawnTimer(0.5)
      timer.start()
      timer.update(0.5)
      timer.start()
      m.assertTrue(timer.isWaiting())
      m.assertTrue(timer.update(0.5))
      m.assertEqual(timer.respawns, 2)
    end function

  end class

end namespace
