import "pkg:/source/utils/Interactables.bs"
import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/GameEntity.bs"
import "pkg:/source/math/vector.bs"

namespace tests
  @suite("BGE.Interactables")
  class InteractablesTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    private function entityAt(x as float, y as float, z as float) as BGE.GameEntity
      entity = new BGE.GameEntity(m.game, {name: "thing"})
      m.game.addEntity(entity)
      entity.position = BGE.Math.VectorOps.create(x, y, z)
      return entity
    end function

    @describe("nearestInArc")

    @it("picks the nearest in front, within reach")
    function _()
      talkers = new BGE.Interactables()
      talkers.add(m.entityAt(0, 0, -3), "far", "Far")
      talkers.add(m.entityAt(0, 0, -1), "near", "Near")
      talkers.add(m.entityAt(0, 0, 1), "behind", "Behind")
      origin = BGE.Math.VectorOps.create(0, 0, 0)
      m.assertEqual("near", talkers.nearestInArc(origin, 0, 4, BGE.Math.PI / 3).id)
      m.assertInvalid(talkers.nearestInArc(origin, 0, 0.5, BGE.Math.PI / 3))
    end function

    @it("skips disabled and destroyed entities")
    function _()
      talkers = new BGE.Interactables()
      near = m.entityAt(0, 0, -1)
      talkers.add(near, "near", "Near")
      talkers.add(m.entityAt(0, 0, -2), "next", "Next")
      talkers.get("near").enabled = false
      origin = BGE.Math.VectorOps.create(0, 0, 0)
      m.assertEqual("next", talkers.nearestInArc(origin, 0, 4, BGE.Math.PI / 3).id)
      talkers.get("near").enabled = true
      m.game.destroyEntity(near)
      m.assertEqual("next", talkers.nearestInArc(origin, 0, 4, BGE.Math.PI / 3).id)
      talkers.prune()
      m.assertEqual(1, talkers.count())
    end function

    @describe("nearestInRect")

    @it("picks the nearest whose position is inside the rectangle")
    function _()
      chests = new BGE.Interactables()
      chests.add(m.entityAt(10, 10, 0), "a", "A")
      chests.add(m.entityAt(30, 10, 0), "b", "B")
      chests.add(m.entityAt(100, 100, 0), "c", "C")
      m.assertEqual("a", chests.nearestInRect(0, 0, 50, 50, 0, 0).id)
      m.assertEqual("b", chests.nearestInRect(0, 0, 50, 50, 40, 10).id)
      m.assertInvalid(chests.nearestInRect(200, 200, 10, 10, 0, 0))
    end function

    @describe("bookkeeping")

    @it("replaces by id, removes and clears")
    function _()
      things = new BGE.Interactables()
      things.add(m.entityAt(0, 0, 0), "a", "First")
      things.add(m.entityAt(0, 0, 0), "a", "Second")
      m.assertEqual(1, things.count())
      m.assertEqual("Second", things.get("a").label)
      things.remove("a")
      m.assertEqual(0, things.count())
      things.add(m.entityAt(0, 0, 0), "b", "B", {shop: "smith"})
      m.assertEqual("smith", things.getAll()[0].data.shop)
      things.clear()
      m.assertEqual(0, things.count())
    end function

    @it("promptFor() formats a prompt")
    function _()
      things = new BGE.Interactables()
      target = things.add(m.entityAt(0, 0, 0), "bram", "Talk to Bram")
      m.assertEqual("OK: Talk to Bram", things.promptFor(target))
      m.assertEqual("Talk to Bram", things.promptFor(target, ""))
      m.assertEqual("", things.promptFor(invalid))
    end function

  end class
end namespace
