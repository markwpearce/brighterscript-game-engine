namespace tests

  ' Held-button tracking for roUniversalControlEvent remotes. A gamepad can
  ' hold several buttons at once, so each held button is tracked on its own.
  @suite("BGE.Game remote held buttons")
  class GameRemoteHeldTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    private function heldButtons() as string[]
      buttons = [] as string[]
      for each input in (m.game as dynamic).remoteHeldGameInputs()
        buttons.Push(input.button)
      end for
      buttons.Sort()
      return buttons
    end function

    @describe("trackRemoteHeldButton")

    @it("keeps a held button repeating after another button on the same remote is pressed and released")
    function _()
      game = m.game as dynamic
      game.trackRemoteHeldButton("BT:1", 5) ' right down
      game.trackRemoteHeldButton("BT:1", 7) ' replay down
      m.assertEqual(["replay", "right"], m.heldButtons())

      game.trackRemoteHeldButton("BT:1", 107) ' replay up
      m.assertEqual(["right"], m.heldButtons())

      game.trackRemoteHeldButton("BT:1", 105) ' right up
      m.assertEqual([], m.heldButtons())
    end function

    @it("tracks the same button separately per remote")
    function _()
      game = m.game as dynamic
      game.trackRemoteHeldButton("BT:1", 6)
      game.trackRemoteHeldButton("BT:2", 6)
      game.trackRemoteHeldButton("BT:1", 106)

      inputs = game.remoteHeldGameInputs()
      m.assertEqual(1, inputs.count())
      m.assertEqual("OK", inputs[0].button)
      m.assertTrue(inputs[0].held)
    end function

  end class

end namespace
