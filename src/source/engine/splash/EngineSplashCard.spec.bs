import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/splash/EngineSplashArt.bs"
import "pkg:/source/engine/splash/EngineSplashCard.bs"

namespace tests

  @suite("BGE.EngineSplashCard")
  class EngineSplashCardTests extends rooibos.BaseTestSuite

    @describe("the timeline")

    @it("shows each cannon frame at its cue time")
    function _()
      m.assertEqual(0, BGE.EngineSplashArt.getFrameIndexAt(0))
      m.assertEqual(0, BGE.EngineSplashArt.getFrameIndexAt(509))
      m.assertEqual(1, BGE.EngineSplashArt.getFrameIndexAt(510))
      m.assertEqual(2, BGE.EngineSplashArt.getFrameIndexAt(600))
      m.assertEqual(2, BGE.EngineSplashArt.getFrameIndexAt(659))
      m.assertEqual(3, BGE.EngineSplashArt.getFrameIndexAt(660))
      m.assertEqual(4, BGE.EngineSplashArt.getFrameIndexAt(720))
      m.assertEqual(5, BGE.EngineSplashArt.getFrameIndexAt(790))
      m.assertEqual(6, BGE.EngineSplashArt.getFrameIndexAt(870))
      m.assertEqual(7, BGE.EngineSplashArt.getFrameIndexAt(960))
      m.assertEqual(7, BGE.EngineSplashArt.getFrameIndexAt(1059))
      m.assertEqual(0, BGE.EngineSplashArt.getFrameIndexAt(1060))
      m.assertEqual(0, BGE.EngineSplashArt.getFrameIndexAt(2999))
    end function

    @it("follows the card's elapsed time")
    function _()
      card = m.newCard(720)
      card.update(0.6)
      m.assertEqual(2, card.getFrameIndex())
    end function

    @it("has no ball before it's fired, then one moving up and right")
    function _()
      card = m.newCard(720)
      card.update(0.7)
      m.assertInvalid(card.getBallPosition())
      card.update(0.05)
      first = card.getBallPosition()
      m.assertNotInvalid(first)
      card.update(0.05)
      second = card.getBallPosition()
      m.assertTrue(second.x > first.x)
      m.assertTrue(second.y < first.y)
    end function

    @it("finishes after three seconds")
    function _()
      card = m.newCard(720)
      for i = 1 to 29
        card.update(0.1)
      end for
      m.assertFalse(card.isFinished())
      card.update(0.1)
      m.assertTrue(card.isFinished())
    end function

    @it("can be skipped, or made unskippable")
    function _()
      card = m.newCard(720)
      card.update(0.5)
      m.assertTrue(card.trySkip())
      m.assertTrue(card.isFinished())

      locked = m.newCard(720)
      locked.skippable = false
      locked.update(0.5)
      m.assertFalse(locked.trySkip())
    end function

    @describe("colours")

    @it("defaults to the purple scheme")
    function _()
      card = m.newCard(720)
      m.assertEqual(&h421866FF, card.backgroundColor)
      m.assertEqual(&hFFFFFFFF, card.cannonColor)
      m.assertEqual(&hFFFFFFFF, card.titleColor)
    end function

    @it("sets all three colours from each scheme")
    function _()
      card = m.newCard(720)
      card.useScheme(BGE.SplashScheme.Dark)
      m.assertEqual([&h121826FF, &hFFAA28FF, &hF0F0F5FF], [card.backgroundColor, card.cannonColor, card.titleColor])
      card.useScheme(BGE.SplashScheme.Cream)
      m.assertEqual([&hF5F0E4FF, &h421866FF, &h1E1E28FF], [card.backgroundColor, card.cannonColor, card.titleColor])
      card.useScheme(BGE.SplashScheme.Teal)
      m.assertEqual([&h0A786EFF, &hFFE678FF, &hFFFFFFFF], [card.backgroundColor, card.cannonColor, card.titleColor])
      card.useScheme(BGE.SplashScheme.Purple)
      m.assertEqual([&h421866FF, &hFFFFFFFF, &hFFFFFFFF], [card.backgroundColor, card.cannonColor, card.titleColor])
    end function

    @it("uses the title colour for the loading bar")
    function _()
      card = m.newCard(720)
      card.useScheme(BGE.SplashScheme.Dark)
      m.assertEqual(&h121826FF, card.getBackgroundColor())
      m.assertEqual(&hF0F0F5FF, card.getForegroundColor())
    end function

    @describe("art and sound")

    @it("uses the HD art below 1080 lines and FHD from 1080")
    function _()
      hd = m.newCard(720)
      m.assertFalse(hd.isFhd())
      m.assertEqual(720, BGE.EngineSplashArt.getLayout(false).refHeight)
      fhd = m.newCard(1080)
      m.assertTrue(fhd.isFhd())
      m.assertEqual(1080, BGE.EngineSplashArt.getLayout(true).refHeight)
    end function

    @it("doesn't load the sound when sound is off")
    function _()
      game = new BGE.Game(320, 240)
      card = new BGE.EngineSplashCard()
      card.sound = false
      card.onStart(game)
      m.assertInvalid(game.Sounds[BGE.EngineSplashArt.SOUND_NAME])
      card.onEnd(game)
    end function

    @it("loads its art on start and frees it on end")
    function _()
      game = new BGE.Game(320, 240)
      card = new BGE.EngineSplashCard()
      card.sound = false
      card.onStart(game)
      m.assertNotInvalid(game.getBitmap(BGE.EngineSplashArt.TITLE_BITMAP, false))
      m.assertNotInvalid(game.getBitmap(BGE.EngineSplashArt.CANNON_BITMAP, false))
      card.onEnd(game)
      m.assertInvalid(game.getBitmap(BGE.EngineSplashArt.TITLE_BITMAP, false))
      m.assertInvalid(game.getBitmap(BGE.EngineSplashArt.CANNON_BITMAP, false))
    end function

    @it("draws every part of its timeline without errors")
    function _()
      game = new BGE.Game(320, 240)
      card = new BGE.EngineSplashCard()
      card.sound = false
      card.onStart(game)
      for i = 0 to 30
        card.draw(game.uiCanvas.renderer, 1.0)
        card.update(0.1)
      end for
      card.onEnd(game)
      m.assertTrue(card.isFinished())
    end function

    private function newCard(canvasHeight as integer) as BGE.EngineSplashCard
      card = new BGE.EngineSplashCard()
      card.sound = false
      card.setCanvasHeight(canvasHeight)
      return card
    end function

  end class

end namespace
