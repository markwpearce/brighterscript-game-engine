import "../Game.bs"
import "../renderer/Renderer.bs"
import "../../utils/colors.bs"

namespace BGE

  ' One card in the startup splash (`game.splash`): a full-screen logo shown for a while before
  ' the first scene. Extend it for your own card, or use `BGE.ImageSplashCard` for a plain image,
  ' and add it with `game.splash.addCard()`.
  '
  ' Override `isFinished()` to say when the card is done (the base card only finishes when
  ' skipped), and `draw()` to draw it. Call `super.update(dt)` from an `update()` override so
  ' `elapsed` keeps counting.
  class SplashCard

    ' Whether a button press skips this card
    skippable as boolean = true
    ' Presses are ignored until the card has been up this long, so a press left over from
    ' launching the channel doesn't skip it
    minSeconds as float = 0.25
    ' How long the cross-fade into this card takes
    fadeSeconds as float = 0.25
    ' Seconds since the card started
    elapsed as float = 0.0
    ' Whether the card was skipped
    skipped as boolean = false

    ' Called when the card starts. Load its images and play its sound here.
    '
    ' @param {BGE.Game} game
    sub onStart(game as BGE.Game)
    end sub

    ' Called every frame while the card is showing.
    '
    ' @param {float} dt - seconds since the last frame
    sub update(dt as float)
      m.elapsed += dt
    end sub

    ' Skips the card if it can be skipped yet.
    '
    ' @return {boolean} true if the card was skipped
    function trySkip() as boolean
      if not m.skippable or m.elapsed < m.minSeconds
        return false
      end if
      m.skipped = true
      return true
    end function

    ' Whether the card is done, so the next one can start.
    '
    ' @return {boolean}
    function isFinished() as boolean
      return m.skipped
    end function

    ' The card's background colour (packed RGBA). Used behind the cross-fade into the next card.
    '
    ' @return {integer}
    function getBackgroundColor() as integer
      return BGE.Colors.Black
    end function

    ' A colour that shows up on the background (packed RGBA), for the loading bar drawn over the
    ' last card when the first scene is still loading.
    '
    ' @return {integer}
    function getForegroundColor() as integer
      return BGE.Colors.White
    end function

    ' Draws the card over the whole canvas.
    '
    ' @param {BGE.Renderer} renderer - the UI canvas renderer
    ' @param {float} opacity - 0 to 1, for cross-fades; multiply your colours' alpha by it
    sub draw(renderer as BGE.Renderer, opacity as float)
    end sub

    ' Called when the card is done. Free what `onStart()` loaded here.
    '
    ' @param {BGE.Game} game
    sub onEnd(game as BGE.Game)
    end sub

  end class

end namespace
