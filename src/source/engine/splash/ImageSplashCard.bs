import "SplashCard.bs"
import "../Game.bs"
import "../renderer/Renderer.bs"
import "../../utils/colors.bs"
import "../../math/math.bs"

namespace BGE

  ' Options for `BGE.ImageSplashCard`.
  interface ImageSplashCardOptions extends roAssociativeArray
    ' How long the card shows (default 2)
    optional seconds as float
    ' Packed RGBA (default black)
    optional backgroundColor as integer
    ' Packed RGBA, for the loading bar if the card is the last one (default white)
    optional foregroundColor as integer
    ' Image scale (default 1)
    optional scale as float
    ' A loaded sound's name, or a `pkg:/` WAV path, played when the card starts
    optional sound as string
    ' Whether a button press skips the card (default true)
    optional skippable as boolean
  end interface

  ' A splash card showing one image, centred on a background colour, fading in and out.
  '
  ' ```
  ' game.splash.addCard(new BGE.ImageSplashCard("pkg:/images/studio.png", {seconds: 2.5}))
  ' ```
  class ImageSplashCard extends SplashCard

    ' How long the card shows
    seconds as float = 2.0
    ' Packed RGBA
    backgroundColor as integer = BGE.Colors.Black
    ' Packed RGBA
    foregroundColor as integer = BGE.Colors.White
    ' Image scale
    scale as float = 1.0
    ' A loaded sound's name or a `pkg:/` WAV path ("" for none)
    sound as string = ""

    private image as string
    private bitmapName as string = ""
    private soundName as string = ""
    private loadedBitmap as boolean = false
    private loadedSound as boolean = false
    private bitmap as roBitmap = invalid

    ' @param {string} image - a loaded bitmap's name, or a `pkg:/` path loaded when the card starts and freed when it ends
    ' @param {BGE.ImageSplashCardOptions} [options={}]
    sub new(image as string, options = {} as BGE.ImageSplashCardOptions)
      super()
      m.image = image
      ' Looked up by name: on device Keys() can return literal keys lowercased (#735)
      if options.seconds <> invalid
        m.seconds = options.seconds
      end if
      if options.backgroundColor <> invalid
        m.backgroundColor = options.backgroundColor
      end if
      if options.foregroundColor <> invalid
        m.foregroundColor = options.foregroundColor
      end if
      if options.scale <> invalid
        m.scale = options.scale
      end if
      if options.sound <> invalid
        m.sound = options.sound
      end if
      if options.skippable <> invalid
        m.skippable = options.skippable
      end if
    end sub

    override sub onStart(game as BGE.Game)
      if m.isPath(m.image)
        m.bitmapName = "bge.splash.image." + m.image
        m.loadedBitmap = game.loadBitmap(m.bitmapName, m.image)
        ' loadBitmap() has already logged a failure
        m.bitmap = game.getBitmap(m.bitmapName, false)
      else
        m.bitmapName = m.image
        m.bitmap = game.getBitmap(m.bitmapName)
      end if
      if m.sound = ""
        return
      end if
      if m.isPath(m.sound)
        m.soundName = "bge.splash.sound." + m.sound
        game.loadSound(m.soundName, m.sound)
        m.loadedSound = true
      else
        m.soundName = m.sound
      end if
      game.playSound(m.soundName)
    end sub

    override function isFinished() as boolean
      return m.skipped or m.elapsed >= m.seconds
    end function

    override function getBackgroundColor() as integer
      return m.backgroundColor
    end function

    override function getForegroundColor() as integer
      return m.foregroundColor
    end function

    ' How faded in the image is, 0 to 1: it fades in over `fadeSeconds` and out over the last
    ' `fadeSeconds` (unless it's the last card, which the splash fades out).
    '
    ' @return {float}
    function getFadeAlpha() as float
      if m.fadeSeconds <= 0
        return 1.0
      end if
      if m.isLast
        return BGE.Math.Clamp(m.elapsed / m.fadeSeconds, 0.0, 1.0)
      end if
      alpha = BGE.Math.Min(m.elapsed, m.seconds - m.elapsed) / m.fadeSeconds
      return BGE.Math.Clamp(alpha, 0.0, 1.0)
    end function

    ' The name the image is loaded under.
    '
    ' @return {string}
    function getBitmapName() as string
      return m.bitmapName
    end function

    override sub draw(renderer as BGE.Renderer, opacity as float)
      size = renderer.getCanvasSize()
      renderer.drawRectangle(0, 0, size.x, size.y, BGE.colorOpacity(m.backgroundColor, opacity))
      if invalid = m.bitmap
        return
      end if
      width = m.bitmap.GetWidth() * m.scale
      height = m.bitmap.GetHeight() * m.scale
      x = Int((size.x - width) / 2)
      y = Int((size.y - height) / 2)
      renderer.drawScaledObject(x, y, m.scale, m.scale, m.bitmap, BGE.colorOpacity(&hFFFFFFFF, opacity * m.getFadeAlpha()))
    end sub

    override sub onEnd(game as BGE.Game)
      m.bitmap = invalid
      if m.loadedBitmap
        game.unloadBitmap(m.bitmapName)
        m.loadedBitmap = false
      end if
      if m.loadedSound
        game.unloadSound(m.soundName)
        m.loadedSound = false
      end if
    end sub

    private function isPath(value as string) as boolean
      return LCase(Left(value, 5)) = "pkg:/"
    end function

  end class

end namespace
