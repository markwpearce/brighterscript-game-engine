import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/GameInput.bs"
import "pkg:/source/engine/splash/SplashCard.bs"
import "pkg:/source/engine/splash/SplashSequence.bs"

namespace tests

  @suite("BGE.SplashSequence")
  class SplashSequenceTests extends rooibos.BaseTestSuite

    game as BGE.Game
    seq as BGE.SplashSequence

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.seq = new BGE.SplashSequence()
      m.seq.engineCard.sound = false
    end function

    @describe("order")

    @it("plays the engine card first, then added cards in order")
    function _()
      first = new SequenceTestCard("first", 0.5)
      second = new SequenceTestCard("second", 0.5)
      m.seq.addCard(first)
      m.seq.addCard(second)
      cards = m.seq.getCards()
      m.assertEqual(3, cards.count())
      m.assertEqual(&h421866FF, cards[0].getBackgroundColor())
      m.assertEqual("first", (cards[1] as SequenceTestCard).label)
      m.assertEqual("second", (cards[2] as SequenceTestCard).label)
    end function

    @it("starts the first card on start, and moves on when a card finishes")
    function _()
      m.seq.engineCard.skippable = true
      card = new SequenceTestCard("studio", 0.5)
      m.seq.addCard(card)
      m.seq.start(m.game)
      m.assertEqual(0, m.seq.getCurrentIndex())
      m.assertEqual(0, card.starts)
      m.step(3.0, false)
      m.assertEqual(1, m.seq.getCurrentIndex())
      m.assertEqual(1, card.starts)
      m.assertEqual(0, card.ends)
    end function

    @describe("skipping")

    @it("skips the current card on a press")
    function _()
      m.seq.start(m.game)
      m.step(0.5, false)
      m.seq.onInput(m.press())
      m.step(0.0, false)
      m.assertTrue(m.seq.engineCard.isFinished())
    end function

    @it("ignores releases")
    function _()
      m.seq.start(m.game)
      m.step(0.5, false)
      ' 106 is OK's release
      m.seq.onInput(new BGE.GameInput(106, 0))
      m.assertFalse(m.seq.engineCard.isFinished())
    end function

    @it("doesn't skip an unskippable card")
    function _()
      m.seq.engineCard.skippable = false
      m.seq.start(m.game)
      m.step(0.5, false)
      m.seq.onInput(m.press())
      m.assertFalse(m.seq.engineCard.isFinished())
    end function

    @describe("loading")

    @it("finishes after the cards and a fade to black when nothing is loading")
    function _()
      m.seq.start(m.game)
      m.stepFrames(30, 0.1, false)
      m.assertFalse(m.seq.isFinished())
      m.stepFrames(3, 0.1, false)
      m.assertTrue(m.seq.isFinished())
      m.assertTrue(m.seq.hasPlayed())
    end function

    @it("waits on the last card while loading, showing the bar only after a delay")
    function _()
      card = new SequenceTestCard("studio", 0.2)
      m.seq.addCard(card)
      m.seq.start(m.game)
      m.stepFrames(30, 0.1, true)
      m.stepFrames(3, 0.1, true)
      m.assertEqual(1, m.seq.getCurrentIndex())
      m.assertFalse(m.seq.isShowingLoadingBar())
      m.stepFrames(3, 0.1, true)
      m.assertTrue(m.seq.isShowingLoadingBar())
      m.stepFrames(20, 0.1, true)
      m.assertFalse(m.seq.isFinished())
      m.assertEqual(0, card.ends)

      m.stepFrames(3, 0.1, false)
      m.assertTrue(m.seq.isFinished())
      m.assertEqual(1, card.ends)
    end function

    @it("draws each state without errors")
    function _()
      card = new SequenceTestCard("studio", 0.2)
      m.seq.addCard(card)
      m.seq.start(m.game)
      for i = 0 to 40
        m.seq.draw(m.game.uiCanvas.renderer, 0.5)
        m.seq.update(0.1, i < 36)
      end for
      m.seq.draw(m.game.uiCanvas.renderer, 1.0)
      m.assertTrue(m.seq.isFinished())
    end function

    @it("marks only the last card as last")
    function _()
      card = new SequenceTestCard("studio", 0.2)
      m.seq.addCard(card)
      m.seq.start(m.game)
      m.assertFalse(m.seq.engineCard.isLast)
      m.stepFrames(31, 0.1, true)
      m.assertEqual(1, m.seq.getCurrentIndex())
      m.assertTrue(card.isLast)
    end function

    @it("draws the outro without errors when it takes no time")
    function _()
      m.seq.outroSeconds = 0
      m.seq.start(m.game)
      m.stepFrames(30, 0.1, false)
      m.seq.draw(m.game.uiCanvas.renderer, 1.0)
      m.step(0.1, false)
      m.assertTrue(m.seq.isFinished())
    end function

    @describe("finish")

    @it("ends the current card once, early")
    function _()
      card = new SequenceTestCard("studio", 5)
      m.seq.engineCard.skippable = true
      m.seq.addCard(card)
      m.seq.start(m.game)
      m.step(3.0, false)
      m.seq.finish(m.game)
      m.seq.finish(m.game)
      m.assertEqual(1, card.starts)
      m.assertEqual(1, card.ends)
      m.assertTrue(m.seq.isFinished())
    end function

    private sub step(dt as float, loading as boolean)
      m.seq.update(dt, loading)
    end sub

    private sub stepFrames(count as integer, dt as float, loading as boolean)
      for i = 1 to count
        m.seq.update(dt, loading)
      end for
    end sub

    private function press() as BGE.GameInput
      ' 6 is OK's press
      return new BGE.GameInput(6, 0)
    end function

  end class

  class SequenceTestCard extends BGE.SplashCard

    label as string
    seconds as float
    starts as integer = 0
    ends as integer = 0

    sub new(label as string, seconds as float)
      super()
      m.label = label
      m.seconds = seconds
    end sub

    override sub onStart(game as BGE.Game)
      m.starts++
    end sub

    override function isFinished() as boolean
      return m.skipped or m.elapsed >= m.seconds - 0.0001
    end function

    override sub onEnd(game as BGE.Game)
      m.ends++
    end sub

  end class

end namespace
