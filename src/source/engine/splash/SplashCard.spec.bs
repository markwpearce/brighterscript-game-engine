import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/splash/SplashCard.bs"
import "pkg:/source/engine/splash/ImageSplashCard.bs"

namespace tests

  @suite("BGE.SplashCard and BGE.ImageSplashCard")
  class SplashCardTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("SplashCard skipping")

    @it("advances elapsed in update")
    function _()
      card = new BGE.SplashCard()
      card.update(0.5)
      card.update(0.25)
      m.assertEqual(0.75, card.elapsed)
    end function

    @it("ignores a skip before minSeconds")
    function _()
      card = new BGE.SplashCard()
      card.update(0.1)
      m.assertFalse(card.trySkip())
      m.assertFalse(card.isFinished())
    end function

    @it("accepts a skip after minSeconds and finishes")
    function _()
      card = new BGE.SplashCard()
      card.update(0.5)
      m.assertTrue(card.trySkip())
      m.assertTrue(card.isFinished())
    end function

    @it("ignores every skip when not skippable")
    function _()
      card = new BGE.SplashCard()
      card.skippable = false
      card.update(5)
      m.assertFalse(card.trySkip())
      m.assertFalse(card.isFinished())
    end function

    @describe("ImageSplashCard")

    @it("finishes after its seconds")
    function _()
      card = new BGE.ImageSplashCard("logo", {seconds: 1.0})
      card.update(0.9)
      m.assertFalse(card.isFinished())
      card.update(0.1)
      m.assertTrue(card.isFinished())
    end function

    @it("defaults to 2 seconds on black, skippable")
    function _()
      card = new BGE.ImageSplashCard("logo")
      m.assertEqual(2.0, card.seconds)
      m.assertEqual(BGE.Colors.Black, card.getBackgroundColor())
      m.assertTrue(card.skippable)
    end function

    @it("takes its colours, scale and skippable from options")
    function _()
      card = new BGE.ImageSplashCard("logo", {backgroundColor: BGE.Colors.Blue, foregroundColor: BGE.Colors.Yellow, scale: 0.5, skippable: false})
      m.assertEqual(BGE.Colors.Blue, card.getBackgroundColor())
      m.assertEqual(BGE.Colors.Yellow, card.getForegroundColor())
      m.assertEqual(0.5, card.scale)
      m.assertFalse(card.skippable)
    end function

    @it("fades in, holds, then fades out")
    function _()
      card = new BGE.ImageSplashCard("logo", {seconds: 2.0})
      m.assertEqual(0.0, card.getFadeAlpha())
      card.update(1.0)
      m.assertEqual(1.0, card.getFadeAlpha())
      card.update(1.0)
      m.assertEqual(0.0, card.getFadeAlpha())
    end function

    @it("still finishes on time when its image path doesn't exist")
    function _()
      card = new BGE.ImageSplashCard("pkg:/images/does-not-exist.png", {seconds: 0.5})
      card.onStart(m.game)
      card.update(0.5)
      m.assertTrue(card.isFinished())
      card.onEnd(m.game)
    end function

    @it("unloads an image it loaded from a path, and leaves a named one alone")
    function _()
      m.game.loadBitmap("logo", {width: 4, height: 4, alphaEnable: true})
      named = new BGE.ImageSplashCard("logo")
      named.onStart(m.game)
      named.onEnd(m.game)
      m.assertNotInvalid(m.game.getBitmap("logo", false))

      byPath = new BGE.ImageSplashCard("pkg:/source/engine/debug/images/gamepad.png")
      byPath.onStart(m.game)
      loadedName = byPath.getBitmapName()
      m.assertNotInvalid(m.game.getBitmap(loadedName, false))
      byPath.onEnd(m.game)
      m.assertInvalid(m.game.getBitmap(loadedName, false))
    end function

  end class

end namespace
