namespace BGE

  ' Colour schemes for the engine's splash card (`game.splash.engineCard.useScheme()`).
  enum SplashScheme
    ' White on purple (the default)
    Purple = "purple"
    ' Orange cannon and light title on near-black
    Dark = "dark"
    ' Purple cannon and dark title on cream
    Cream = "cream"
    ' Yellow cannon and white title on teal
    Teal = "teal"
  end enum

  ' Sizes in the splash art, in the art's own pixels. Numbers come from
  ' tools/splash/make_splash.py's bge_cannon_*.json.
  interface EngineSplashLayout extends roAssociativeArray
    ' The canvas height the art is drawn 1:1 at
    refHeight as integer
    sheetPath as string
    titlePath as string
    ballPath as string
    frameWidth as integer
    frameHeight as integer
    ' The idle cannon's rect inside each frame
    bodyX as integer
    bodyY as integer
    bodyWidth as integer
    ' Where the cannonball leaves the barrel, inside the ball_out frame
    ballSpawnX as float
    ballSpawnY as float
    ballSize as integer
    titleWidth as integer
    titleHeight as integer
    ' Between the cannon body and the title
    gap as integer
  end interface

end namespace

namespace BGE.EngineSplashArt

  const TITLE_BITMAP = "bge.splash.title"
  const CANNON_BITMAP = "bge.splash.cannon"
  const BALL_BITMAP = "bge.splash.ball"
  const SOUND_NAME = "bge.splash.startup"
  const SOUND_PATH = "pkg:/source/engine/splash/sounds/bge_startup.wav"

  ' The sprite sheet is 4 frames across, 2 down
  const SHEET_COLUMNS = 4
  const FRAME_COUNT = 8
  ' The ball_out frame shows the ball in the barrel; from the next frame it's drawn on its own
  const BALL_SPAWN_MS = 720.0
  ' The startup sound's length
  const DURATION_MS = 3000.0
  ' Ball launch direction in image space (+y down), speed and gravity at FHD (from preview_av.py)
  const BALL_DIR_X = 0.8192
  const BALL_DIR_Y = -0.5736
  const BALL_SPEED_FHD = 3800.0
  const BALL_GRAVITY_FHD = 9600.0
  ' preview_av.py places the ball one 40Hz step along when it appears
  const BALL_LEAD_SECONDS = 0.025

  ' The art's layout at HD (720) or FHD (1080).
  '
  ' @param {boolean} fhd
  ' @return {BGE.EngineSplashLayout}
  function getLayout(fhd as boolean) as BGE.EngineSplashLayout
    if fhd
      return {
        refHeight: 1080,
        sheetPath: "pkg:/source/engine/splash/images/bge_cannon_fhd.webp",
        titlePath: "pkg:/source/engine/splash/images/bge_title_fhd.webp",
        ballPath: "pkg:/source/engine/splash/images/bge_cannonball_fhd.webp",
        frameWidth: 304,
        frameHeight: 235,
        bodyX: 2,
        bodyY: 71,
        bodyWidth: 188,
        ballSpawnX: 207.5,
        ballSpawnY: 60.8,
        ballSize: 36,
        titleWidth: 1055,
        titleHeight: 162,
        gap: 26
      }
    end if
    return {
      refHeight: 720,
      sheetPath: "pkg:/source/engine/splash/images/bge_cannon_hd.webp",
      titlePath: "pkg:/source/engine/splash/images/bge_title_hd.webp",
      ballPath: "pkg:/source/engine/splash/images/bge_cannonball_hd.webp",
      frameWidth: 207,
      frameHeight: 160,
      bodyX: 2,
      bodyY: 49,
      bodyWidth: 128,
      ballSpawnX: 141.2,
      ballSpawnY: 42.0,
      ballSize: 27,
      titleWidth: 707,
      titleHeight: 109,
      gap: 17
    }
  end function

  ' Which cannon frame shows at a time in the card. The sound's boom is at 600ms, on the fire
  ' frame; the frame lengths after it come from the sprite sheet's JSON.
  '
  ' @param {float} ms - milliseconds since the card started
  ' @return {integer} 0 idle, 1 windup, 2 fire, 3 ball_out, 4-6 smoke, 7 settle
  function getFrameIndexAt(ms as float) as integer
    if ms < 510
      return 0
    else if ms < 600
      return 1
    else if ms < 660
      return 2
    else if ms < 720
      return 3
    else if ms < 790
      return 4
    else if ms < 870
      return 5
    else if ms < 960
      return 6
    else if ms < 1060
      return 7
    end if
    return 0
  end function

end namespace
