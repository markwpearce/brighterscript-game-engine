namespace tests

  ' Constructs a real BGE.Game to exercise entity registration and room
  ' switching - the bookkeeping the game loop depends on every frame.
  @suite("BGE.Game")
  class GameTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("addEntity / getEntityByID / getEntityByName")

    @it("calls onCreate and registers the entity so it can be looked up by id and name")
    function _()
      entity = new BGE.GameEntity(m.game, {name: "Player"})
      m.game.addEntity(entity)

      m.assertEqual(entity.id, m.game.getEntityByID(entity.id).id)
      m.assertEqual(entity.id, m.game.getEntityByName("Player").id)
    end function

    @it("getEntityByID returns invalid for an id that was never registered")
    function _()
      m.assertInvalid(m.game.getEntityByID("does-not-exist"))
    end function

    @it("getEntityByName returns invalid for a name that was never registered")
    function _()
      m.assertInvalid(m.game.getEntityByName("does-not-exist"))
    end function

    @describe("getAllEntities")

    @it("returns every entity registered under a given name")
    function _()
      first = new BGE.GameEntity(m.game, {name: "Enemy"})
      second = new BGE.GameEntity(m.game, {name: "Enemy"})
      m.game.addEntity(first)
      m.game.addEntity(second)

      all = m.game.getAllEntities("Enemy")
      m.assertEqual(2, all.count())
    end function

    @it("returns an empty array for a name with no entities")
    function _()
      m.assertEqual(0, m.game.getAllEntities("does-not-exist").count())
    end function

    @describe("getEntitiesByTag")

    @it("returns only the entities tagged with the given tag, across different names")
    function _()
      enemy = new BGE.GameEntity(m.game, {name: "Enemy"})
      wall = new BGE.GameEntity(m.game, {name: "Wall"})
      untagged = new BGE.GameEntity(m.game, {name: "Enemy"})
      enemy.tagsList.add("hazard")
      wall.tagsList.add("hazard")
      m.game.addEntity(enemy)
      m.game.addEntity(wall)
      m.game.addEntity(untagged)

      tagged = m.game.getEntitiesByTag("hazard")

      m.assertEqual(2, tagged.count())
    end function

    @it("tag lookup is case-insensitive, matching BGE.TagList")
    function _()
      entity = new BGE.GameEntity(m.game, {name: "Enemy"})
      entity.tagsList.add("Hazard")
      m.game.addEntity(entity)

      m.assertEqual(1, m.game.getEntitiesByTag("hazard").count())
      m.assertEqual(1, m.game.getEntitiesByTag("HAZARD").count())
    end function

    @it("returns an empty array for a tag no entity has")
    function _()
      m.assertEqual(0, m.game.getEntitiesByTag("does-not-exist").count())
    end function

    @describe("defineRoom / changeRoom / getRoom")

    @it("changeRoom activates a defined room immediately, before Play() has started")
    function _()
      room = new BGE.Room(m.game, {name: "MainRoom"})
      m.game.defineRoom(room)

      changed = m.game.changeRoom("MainRoom")

      m.assertTrue(changed)
      m.assertEqual(room.id, m.game.getRoom().id)
    end function

    @it("changeRoom fails for a room that was never defined")
    function _()
      changed = m.game.changeRoom("NeverDefined")
      m.assertFalse(changed)
    end function

    @describe("Pause / Resume / isPaused")

    @it("is not paused by default")
    function _()
      m.assertFalse(m.game.isPaused())
    end function

    @it("Pause() marks the game as paused")
    function _()
      m.game.Pause()
      m.assertTrue(m.game.isPaused())
    end function

    @it("Resume() unpauses and returns a non-negative pause duration")
    function _()
      m.game.Pause()
      pausedMs = m.game.Resume()

      m.assertFalse(m.game.isPaused())
      m.assertTrue(pausedMs >= 0)
    end function

    @it("Resume() returns -1 when the game wasn't paused")
    function _()
      m.assertEqual(-1, m.game.Resume())
    end function

    @describe("tweenManager")

    ' processEntitiesPreDraw is private, so this can't drive the tick through the real
    ' per-frame entry point - it exercises the same tweenManager instance Game owns and
    ' ticks, via the one public entry point available (Game.tweenManager.update()
    ' itself). The wiring inside processEntitiesPreDraw is a one-line call verified by
    ' reading the source rather than a spec.
    @it("Game owns a tweenManager that ticks live tweens")
    function _()
      target = {x: 0.0}
      m.game.tweenManager.to(target, {x: 100.0}, 0, BGE.Tweens.Easing.LinearTween)
      m.game.tweenManager.update()
      m.assertEqual(100.0, target.x)
    end function

    @it("Resume() compensates every live tween's timer for the paused duration")
    function _()
      target = {x: 0.0}
      m.game.tweenManager.to(target, {x: 100.0}, 1000, BGE.Tweens.Easing.LinearTween)
      m.game.Pause()
      m.game.Resume()
      m.game.tweenManager.update()
      ' the tween should report negligible progress - nowhere near halfway - since the
      ' paused interval was compensated out rather than counted as elapsed tween time
      m.assertTrue(target.x < 50.0)
    end function

    @describe("getDeltaTime / getTotalTime")

    @it("are both zero before Play() has run any frames")
    function _()
      m.assertEqual(0.0, m.game.getDeltaTime())
      m.assertEqual(0.0, m.game.getTotalTime())
    end function

    @describe("log / getLogHistory")

    @it("defaults to info level and records the message")
    function _()
      m.game.log("hello")

      history = m.game.getLogHistory()
      m.assertEqual(1, history.count())
      m.assertEqual("hello", history[0].message)
      m.assertEqual(BGE.Debug.LogLevel.info, history[0].level)
    end function

    @it("records the level when one is given")
    function _()
      m.game.log("uh oh", BGE.Debug.LogLevel.error)

      history = m.game.getLogHistory()
      m.assertEqual(BGE.Debug.LogLevel.error, history[0].level)
    end function

    @it("trims the oldest entries once the history cap is exceeded")
    function _()
      for i = 0 to 104
        m.game.log("message " + i.toStr())
      end for

      history = m.game.getLogHistory()
      m.assertEqual(100, history.count())
      m.assertEqual("message 5", history[0].message)
      m.assertEqual("message 104", history[history.count() - 1].message)
    end function

    @it("getEntityByID logs a warning for an id that was never registered")
    function _()
      m.game.getEntityByID("does-not-exist")

      history = m.game.getLogHistory()
      m.assertEqual(1, history.count())
      m.assertEqual(BGE.Debug.LogLevel.warning, history[0].level)
    end function

    @it("getBitmap logs a warning for a name that was never loaded")
    function _()
      m.game.getBitmap("does-not-exist")

      history = m.game.getLogHistory()
      m.assertEqual(1, history.count())
      m.assertEqual(BGE.Debug.LogLevel.warning, history[0].level)
    end function

    @it("get3dModel logs a warning for a name that was never loaded")
    function _()
      m.game.get3dModel("does-not-exist")

      history = m.game.getLogHistory()
      m.assertEqual(1, history.count())
      m.assertEqual(BGE.Debug.LogLevel.warning, history[0].level)
    end function

    @describe("enableStandardDebugUi")

    @it("adds all 5 standard debug panels by default")
    function _()
      m.game.enableStandardDebugUi()
      m.assertEqual(5, m.game.getDebugUI().childCount())
    end function

    @it("skips a panel whose key is explicitly set to false")
    function _()
      m.game.enableStandardDebugUi({memory: false, garbageCollector: false, log: false})
      m.assertEqual(2, m.game.getDebugUI().childCount())
    end function

    ' processEntityOnControls is left non-private (like
    ' ControllerServer.parseHttpRequest) specifically so this gate can be
    ' exercised directly - Game's real per-frame loop has no other test seam.
    @describe("processEntityOnControls / onControls dispatch gating")

    @it("fires onControls exactly once per call when the game has at least one ControlMap binding")
    function _()
      entity = new tests.ControlsCountingEntity(m.game)
      m.game.controls.bindAction("jump", "ok", 0)

      m.game.processEntityOnControls(entity)
      m.assertEqual(1, entity.controlsCallCount)

      m.game.processEntityOnControls(entity)
      m.assertEqual(2, entity.controlsCallCount)
    end function

    @it("never fires onControls when nothing has been bound")
    function _()
      entity = new tests.ControlsCountingEntity(m.game)

      m.game.processEntityOnControls(entity)
      m.game.processEntityOnControls(entity)

      m.assertEqual(0, entity.controlsCallCount)
    end function

    @describe("setInputEntity")

    @it("takes effect the same frame it's called, not just the next one")
    function _()
      capturingEntity = new tests.InputCapturingEntity(m.game)
      capturingEntity.onCreate({})
      otherEntity = new tests.InputRecordingEntity(m.game)
      otherEntity.onCreate({})

      ' Simulate what Game.Play() does at the top of a frame, then dispatch
      ' input to both entities in registration order - mirrors
      ' processEntitiesPreDraw calling processEntityOnInput per entity.
      m.game.dispatchOnInputForTest(capturingEntity, new BGE.GameInput(6, 0)) ' OK, press
      m.game.dispatchOnInputForTest(otherEntity, new BGE.GameInput(6, 0))

      m.assertFalse(otherEntity.receivedInput)
    end function

    @it("unsetInputEntity() also takes effect the same frame")
    function _()
      capturingEntity = new tests.InputCapturingEntity(m.game)
      capturingEntity.onCreate({})
      otherEntity = new tests.InputRecordingEntity(m.game)
      otherEntity.onCreate({})

      ' First prove the gate is actually closed: capturingEntity's own
      ' onInput() calls setInputEntity(m) on itself, so dispatching to it
      ' closes the gate for otherEntity.
      m.game.dispatchOnInputForTest(capturingEntity, new BGE.GameInput(6, 0))
      m.game.dispatchOnInputForTest(otherEntity, new BGE.GameInput(6, 0))
      m.assertFalse(otherEntity.receivedInput)

      ' Now prove unsetInputEntity() reopens that same-frame gate immediately.
      m.game.unsetInputEntity()
      m.game.dispatchOnInputForTest(otherEntity, new BGE.GameInput(6, 0))
      m.assertTrue(otherEntity.receivedInput)
    end function

    @describe("UI input runs before entity input")

    @it("gameUi's onInput can capture input before entities are dispatched this frame")
    function _()
      capturingWidget = new BGE.UI.UiWidget(m.game)
      m.game.gameUi.addChild(capturingWidget)
      otherEntity = new tests.InputRecordingEntity(m.game)
      otherEntity.onCreate({})

      ' processUiInput must run before dispatching to otherEntity for this
      ' to work - mirrors the fixed Play() order.
      capturingWidget.game.setInputEntity(m.game.gameUi)
      m.game.dispatchOnInputForTest(otherEntity, new BGE.GameInput(6, 0))

      m.assertFalse(otherEntity.receivedInput)

      m.game.unsetInputEntity()
    end function

    @describe("defaultTheme")

    @it("constructs a default Theme using the game's default font")
    function _()
      m.assertNotInvalid(m.game.defaultTheme)
      m.assertNotInvalid(m.game.defaultTheme.font)
    end function

  end class

  ' Test double used only by the onControls dispatch-gating specs above -
  ' counts how many times onControls() is actually invoked.
  class ControlsCountingEntity extends BGE.GameEntity
    controlsCallCount = 0

    ' Explicit fully-qualified constructor - the parent's `gameEngine as Game`
    ' parameter type doesn't resolve unqualified outside namespace BGE and
    ' crashes bsc's transpile of the implicit constructor otherwise (see
    ' project_bsc_subclass_transpile_crash memory).
    sub new(gameEngine as BGE.Game, args = {} as roAssociativeArray)
      super(gameEngine, args)
    end sub

    override sub onControls(controls as BGE.Controller.ControlMap)
      m.controlsCallCount++
    end sub
  end class

  class InputCapturingEntity extends BGE.GameEntity
    sub new(game as BGE.Game)
      super(game)
    end sub

    override sub onInput(input as BGE.GameInput)
      m.game.setInputEntity(m)
    end sub
  end class

  class InputRecordingEntity extends BGE.GameEntity
    receivedInput as boolean = false

    sub new(game as BGE.Game)
      super(game)
    end sub

    override sub onInput(input as BGE.GameInput)
      m.receivedInput = true
    end sub
  end class

end namespace
