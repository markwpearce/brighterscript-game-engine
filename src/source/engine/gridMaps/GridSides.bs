import "../../math/math.bs"
import "../../math/vector.bs"

' The four sides of a grid cell, as "n" (-z, row - 1), "e" (+x, col + 1), "s" (+z, row + 1) and
' "w" (-x, col - 1), for maps where row 0 is the -z edge and column 0 the -x edge (BGE.CharGrid,
' BGE.GridWallsMap).
namespace BGE.GridSides

  ' Every side, in the order n, e, s, w.
  '
  ' @return {string[]}
  function all() as string[]
    return ["n", "e", "s", "w"]
  end function

  ' The [col, row] step to the neighbour across a side.
  '
  ' @param {string} side - "n", "e", "s" or "w"
  ' @return {integer[]}
  function offset(side as string) as integer[]
    if side = "n"
      return [0, -1]
    else if side = "e"
      return [1, 0]
    else if side = "s"
      return [0, 1]
    end if
    return [-1, 0]
  end function

  ' Unit vector on the ground out through a side.
  '
  ' @param {string} side - "n", "e", "s" or "w"
  ' @return {BGE.Math.Vector}
  function normal(side as string) as BGE.Math.Vector
    delta = BGE.GridSides.offset(side)
    return BGE.Math.VectorOps.create(delta[0], 0, delta[1])
  end function

  ' The side across the cell.
  '
  ' @param {string} side - "n", "e", "s" or "w"
  ' @return {string}
  function opposite(side as string) as string
    if side = "n"
      return "s"
    else if side = "e"
      return "w"
    else if side = "s"
      return "n"
    end if
    return "e"
  end function

  ' The heading that faces out through a side, in the engine's heading convention (0 faces -z,
  ' see BGE.Math.headingForward()): n 0, e PI/2, s PI, w -PI/2.
  '
  ' @param {string} side - "n", "e", "s" or "w"
  ' @return {float} radians
  function heading(side as string) as float
    if side = "n"
      return 0.0
    else if side = "e"
      return BGE.Math.HALF_PI
    else if side = "s"
      return BGE.Math.PI
    end if
    return -BGE.Math.HALF_PI
  end function

  ' The y rotation that turns a drawable or model built facing +z (see
  ' BGE.Math.rotationForward()) to face into a cell from its wall on `side`: a picture or torch
  ' bracket on that wall. It faces out through the opposite side.
  '
  ' @param {string} side - "n", "e", "s" or "w"
  ' @return {float} radians: n 0, e PI/2, s PI, w -PI/2
  function wallRotation(side as string) as float
    ' rotationForward(heading) is -headingForward(heading): facing back in through the side
    return BGE.GridSides.heading(side)
  end function

end namespace
