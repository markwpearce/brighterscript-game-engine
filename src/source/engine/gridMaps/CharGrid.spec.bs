import "CharGrid.bs"
import "GridSides.bs"
import "../colliders/SolidWorld.bs"

namespace tests

  @suite("BGE.CharGrid")
  class CharGridTests extends rooibos.BaseTestSuite

    ' Groups as "kind col,row colsxrows" strings, in order
    private function describeGroups(groups as BGE.CharGridGroup[]) as string[]
      found = [] as string[]
      for each group in groups
        found.push(m.describeGroup(group))
      end for
      return found
    end function

    private function describeGroup(group as BGE.CharGridGroup) as string
      return `${group.kind} ${group.col},${group.row} ${group.cols}x${group.rows}`
    end function

    private function describeCells(cells as BGE.CharGridCell[]) as string[]
      found = [] as string[]
      for each cell in cells
        found.push(`${cell.kind} ${cell.col},${cell.row}`)
      end for
      return found
    end function

    private function grid(rows as string[], args = {} as roAssociativeArray) as BGE.CharGrid
      if invalid = args.cellSize
        args.cellSize = 10.0
      end if
      return new BGE.CharGrid(rows, args as BGE.CharGridArgs)
    end function

    @describe("cells and kinds")

    @it("reads its size and characters, padding short rows")
    function _()
      grid = m.grid(["#.#", "#"])
      m.assertEqual(grid.colCount, 3)
      m.assertEqual(grid.rowCount, 2)
      m.assertEqual(grid.kindAt(1, 0), ".")
      m.assertEqual(grid.kindAt(1, 1), "")
      m.assertEqual(grid.kindAt(-1, 0), "")
      m.assertEqual(grid.kindAt(0, 2), "")
      m.assertTrue(grid.isInside(2, 1))
      m.assertFalse(grid.isInside(3, 1))
    end function

    @it("isSolid matches solidKinds and everything outside")
    function _()
      grid = m.grid(["#.x"])
      m.assertTrue(grid.isSolid(0, 0))
      m.assertFalse(grid.isSolid(1, 0))
      m.assertFalse(grid.isSolid(2, 0))
      m.assertTrue(grid.isSolid(3, 0))
      m.assertTrue(grid.isSolid(0, -1))
      grid = m.grid(["#.x"], {solidKinds: "x"})
      m.assertFalse(grid.isSolid(0, 0))
      m.assertTrue(grid.isSolid(2, 0))
      grid = m.grid(["#.x"], {solidKinds: ""})
      m.assertFalse(grid.isSolid(0, 0))
      m.assertTrue(grid.isSolid(-1, 0))
    end function

    @it("isKindOf is case-sensitive and false outside")
    function _()
      grid = m.grid(["pP-"])
      m.assertTrue(grid.isKindOf(0, 0, "p"))
      m.assertFalse(grid.isKindOf(1, 0, "p"))
      m.assertTrue(grid.isKindOf(2, 0, "=-"))
      m.assertFalse(grid.isKindOf(3, 0, "=-"))
    end function

    @it("cellsOf and cellsExcept list cells row by row")
    function _()
      grid = m.grid(["#a#", "b.a"])
      m.assertEqual(m.describeCells(grid.cellsOf("ab")), ["a 1,0", "b 0,1", "a 2,1"])
      m.assertEqual(m.describeCells(grid.cellsExcept("#")), ["a 1,0", "b 0,1", ". 1,1", "a 2,1"])
    end function

    @describe("world positions")

    @it("centres the grid on the origin by default")
    function _()
      grid = m.grid(["...", "..."])
      m.assertEqual(grid.origin.x, -15.0)
      m.assertEqual(grid.origin.z, -10.0)
      center = grid.cellCenter(0, 0)
      m.assertEqual(center.x, -10.0)
      m.assertEqual(center.z, -5.0)
      center = grid.groupCenter({kind: ".", col: 0, row: 0, cols: 3, rows: 2})
      m.assertEqual(center.x, 0.0)
      m.assertEqual(center.z, 0.0)
    end function

    @it("takes an origin")
    function _()
      grid = m.grid(["..", ".."], {origin: BGE.Math.VectorOps.create(100, 0, 200)})
      center = grid.cellCenter(1, 0)
      m.assertEqual(center.x, 115.0)
      m.assertEqual(center.z, 205.0)
    end function

    @it("cellAt finds the cell a position is in, outside too")
    function _()
      grid = m.grid([".#.", "..."])
      cell = grid.cellAt(0.0, -1.0)
      m.assertEqual(cell.col, 1)
      m.assertEqual(cell.row, 0)
      m.assertEqual(cell.kind, "#")
      cell = grid.cellAt(-16.0, 11.0)
      m.assertEqual(cell.col, -1)
      m.assertEqual(cell.row, 2)
      m.assertEqual(cell.kind, "")
    end function

    @describe("sides")

    @it("wallSides and openSides go n, e, s, w")
    function _()
      grid = m.grid(["#.#", "..#", "###"])
      m.assertEqual(grid.wallSides(1, 1), ["e", "s"])
      m.assertEqual(grid.openSides(1, 1), ["n", "w"])
      ' outside counts as a wall
      m.assertEqual(grid.wallSides(0, 1), ["n", "s", "w"])
    end function

    @it("GridSides offsets, normals, opposites and headings")
    function _()
      m.assertEqual(BGE.GridSides.all(), ["n", "e", "s", "w"])
      m.assertEqual(BGE.GridSides.offset("n"), [0, -1])
      m.assertEqual(BGE.GridSides.offset("e"), [1, 0])
      m.assertEqual(BGE.GridSides.offset("s"), [0, 1])
      m.assertEqual(BGE.GridSides.offset("w"), [-1, 0])
      normal = BGE.GridSides.normal("w")
      m.assertTrue(normal.x = -1 and normal.z = 0)
      m.assertEqual(BGE.GridSides.opposite("n"), "s")
      m.assertEqual(BGE.GridSides.opposite("e"), "w")
      m.assertEqual(BGE.GridSides.opposite("s"), "n")
      m.assertEqual(BGE.GridSides.opposite("w"), "e")
      for each side in BGE.GridSides.all()
        ' the heading faces along the normal
        forward = BGE.Math.headingForward(BGE.GridSides.heading(side))
        normal = BGE.GridSides.normal(side)
        m.assertTrue(Abs(forward.x - normal.x) < 0.0001 and Abs(forward.z - normal.z) < 0.0001, side)
      end for
    end function

    @describe("findRectGroups")

    @it("grows each rectangle across, then down")
    function _()
      grid = m.grid([
        ".==.b"
        ".==.b"
        "...=."
      ])
      m.assertEqual(m.describeGroups(grid.findRectGroups("=b")), ["= 1,0 2x2", "b 4,0 1x2", "= 3,2 1x1"])
    end function

    @it("splits an L into a block and what's left")
    function _()
      grid = m.grid([
        "=."
        "=="
      ])
      m.assertEqual(m.describeGroups(grid.findRectGroups("=")), ["= 0,0 1x2", "= 1,1 1x1"])
    end function

    @it("ignores kinds it isn't asked for")
    function _()
      m.assertEqual(m.grid(["xx"]).findRectGroups("=").count(), 0)
    end function

    @describe("findConnectedGroups")

    @it("gives each connected block of a kind its bounding rectangle")
    function _()
      grid = m.grid([
        "HH.t"
        ".H.t"
        "HHtt"
      ])
      m.assertEqual(m.describeGroups(grid.findConnectedGroups("Ht")), ["H 0,0 2x3", "t 2,0 2x3"])
    end function

    @it("keeps blocks of the same kind apart")
    function _()
      grid = m.grid(["H.H"])
      m.assertEqual(m.describeGroups(grid.findConnectedGroups("H")), ["H 0,0 1x1", "H 2,0 1x1"])
    end function

    @describe("boundsOf")

    @it("bounds every cell of the kinds, connected or not")
    function _()
      grid = m.grid([
        "...x."
        ".P..."
        "x...."
      ])
      m.assertEqual(m.describeGroup(grid.boundsOf("xP")), "x 0,0 4x3")
      m.assertEqual(m.describeGroup(grid.boundsOf("P")), "P 1,1 1x1")
      m.assertInvalid(grid.boundsOf("q"))
    end function

    @describe("findRuns")

    @it("finds runs along rows, then down columns, corners in both")
    function _()
      grid = m.grid([
        "fff."
        "f..f"
        "f..f"
      ])
      m.assertEqual(m.describeGroups(grid.findRuns("f")), ["f 0,0 3x1", "f 0,0 1x3", "f 3,1 1x2"])
    end function

    @it("keeps runs of different kinds apart and honours minLength")
    function _()
      grid = m.grid(["aabbb"])
      m.assertEqual(m.describeGroups(grid.findRuns("ab")), ["a 0,0 2x1", "b 2,0 3x1"])
      m.assertEqual(m.describeGroups(grid.findRuns("ab", 3)), ["b 2,0 3x1"])
      m.assertEqual(m.describeGroups(grid.findRuns("ab", 1)), ["a 0,0 2x1", "b 2,0 3x1", "a 0,0 1x1", "a 1,0 1x1", "b 2,0 1x1", "b 3,0 1x1", "b 4,0 1x1"])
    end function

    @describe("toSolidWorld")

    @it("adds a solid per solid cell, row by row, and a wall round the grid")
    function _()
      grid = m.grid(["#.", ".#"])
      solids = grid.toSolidWorld().getSolids()
      m.assertEqual(solids.count(), 6)
      m.assertEqual(m.describeSolid(solids[0]), "-10,-10 10x10")
      m.assertEqual(m.describeSolid(solids[1]), "0,0 10x10")
      ' the bounds, a cell thick
      m.assertEqual(m.describeSolid(solids[2]), "-20,-20 40x10")
    end function

    @it("takes other kinds to make solid")
    function _()
      grid = m.grid(["#x", ".."])
      solids = grid.toSolidWorld("x").getSolids()
      m.assertEqual(solids.count(), 5)
      m.assertEqual(m.describeSolid(solids[0]), "0,-10 10x10")
    end function

    private function describeSolid(solid as BGE.SolidWorldSolid) as string
      return `${solid.x},${solid.y} ${solid.w}x${solid.h}`
    end function

  end class

end namespace
