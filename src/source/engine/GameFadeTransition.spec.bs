namespace tests

  ' Drives changeSceneWithFade() one fake frame at a time via updateFadeTransitionForTest(),
  ' which also applies a scene change requested that frame, as the end of a Play() frame would.
  @suite("BGE.Game changeSceneWithFade")
  class GameFadeTransitionTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.game.defineScene(new BGE.GameScene(m.game, {name: "SceneA"}))
      m.game.defineScene(new BGE.GameScene(m.game, {name: "SceneB"}))
    end function

    @describe("with no current scene")

    @it("changes scene straight away and fades in from black")
    function _()
      m.assertTrue(m.game.changeSceneWithFade("SceneA", {}, 0.1))
      m.assertEqual("SceneA", m.game.currentScene.name)
      m.assertEqual(1.0, m.game.screenFade.opacity)
      m.assertTrue(m.game.isTransitioning())

      m.runFrames(10, 0.02)
      m.assertEqual(0.0, m.game.screenFade.opacity)
      m.assertFalse(m.game.isTransitioning())
    end function

    @describe("from a running scene")

    @it("fades out, changes scene, then fades back in")
    function _()
      m.game.changeScene("SceneA")
      m.game.changeSceneWithFade("SceneB", {}, 0.1)

      m.runFrames(2, 0.02)
      m.assertEqual("SceneA", m.game.currentScene.name)
      m.assertTrue(m.game.screenFade.opacity > 0)

      m.runFrames(4, 0.02)
      m.assertEqual("SceneB", m.game.currentScene.name)
      m.assertTrue(m.game.isTransitioning())

      m.runFrames(10, 0.02)
      m.assertEqual(0.0, m.game.screenFade.opacity)
      m.assertFalse(m.game.isTransitioning())
    end function

    @it("passes args to the new scene's onCreate")
    function _()
      m.game.changeScene("SceneA")
      m.game.changeSceneWithFade("SceneB", {spawn: "gate"}, 0.05)
      m.runFrames(5, 0.02)
      m.assertEqual("gate", m.game.currentSceneArgs.spawn)
    end function

    @it("ignores a second request while one is running")
    function _()
      m.game.changeScene("SceneA")
      m.assertTrue(m.game.changeSceneWithFade("SceneB", {}, 0.1))
      m.assertFalse(m.game.changeSceneWithFade("SceneA", {}, 0.1))
    end function

    @it("returns false for an undefined scene")
    function _()
      m.assertFalse(m.game.changeSceneWithFade("Nope"))
      m.assertFalse(m.game.isTransitioning())
    end function

    private sub runFrames(count as integer, dt as float)
      for i = 1 to count
        m.game.updateFadeTransitionForTest(dt)
      end for
    end sub

  end class

end namespace
