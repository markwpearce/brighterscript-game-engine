import "../../math/math.bs"
import "../../math/plane.bs"
import "../../math/vector.bs"
import "../GameInput.bs"
import "../controller/ControlMap.bs"
import "../renderer/cameras/Camera3d.bs"

namespace BGE

  ' A reusable free-fly camera control scheme: yaw/pitch relative to the camera's
  ' current (roll-adjusted) orientation, strafe/drive, roll, and a ground-plane clamp
  ' so driving forward can't cross the ground. Not a GameEntity - a Scene (or any owner)
  ' constructs one and forwards its own onInput/onUpdate calls to it. Extracted from
  ' examples/terrain's original FreeFlyCameraController (issue #148); that example now
  ' layers its own scene-switching/debug-toggle/hint-text glue on top of this.
  '
  ' Movement/look are read each frame from a BGE.Controller.ControlMap's move/look axes
  ' (see update()), not from onInput() - a connected dual-stick controller drives full
  ' strafe+drive / yaw+pitch, and with no real second stick, both axes fall back to the
  ' same remote/simulator source, so the single physical d-pad turns and drives exactly
  ' as it always has (see update()'s regime check).
  class FreeFlyCameraController

    camera as BGE.Camera3d
    groundPlane as BGE.Math.Plane
    private controls as BGE.Controller.ControlMap
    private moveAxisName as string
    private lookAxisName as string

    turnSpeed = 2.0 ' radians/sec
    driveSpeed = 80 ' units/sec
    rollSpeed = 60 ' degrees/sec
    pitchSpeed = 0.3 ' radians/sec
    ' Bounds the pitch *input* accumulator to reduce (not eliminate) how close repeated
    ' pitch input can drive the camera toward Camera3d.getLevelUpVector()'s degenerate
    ' near-vertical case; under sustained roll+pitch combinations the actual world-space
    ' angle isn't strictly bounded by this alone.
    maxDownwardTilt = 1.2 ' radians (~69 degrees)
    minHeightAboveGround = 1.0 ' world units

    ' Tracked only to enforce maxDownwardTilt - yaw is free rotation with no clamp, so it
    ' needs no equivalent accumulator.
    private pitchAccum = 0.0

    ' The controller's starting pitch (radians), set via setInitialPitch() - onPlayButton
    ' resets back to this rather than to a perfectly level view.
    private defaultPitch = 0.0
    private rollDirection = 0 ' -1 = rolling left, 1 = rolling right, 0 = not rolling
    private pitchDirection = 0 ' -1 = pitching up, 1 = pitching down, 0 = not pitching
    ' Protected, not private: a subclass adding its own per-frame button handling (e.g.
    ' examples/terrain's hold-to-toggle-debug) needs to see the same input this frame.
    protected lastInput as BGE.GameInput

    ' Binds to this specific camera instance for its lifetime - it does not re-resolve
    ' the active camera from Game/Renderer each frame like some example code does. If the
    ' consumer later calls Game.setCamera() with a different camera, this controller keeps
    ' driving the one it was built with; construct a new controller for the new camera.
    '
    ' @param {BGE.Camera3d} camera the camera to drive
    ' @param {BGE.Math.Plane} groundPlane the plane clampAboveGround() keeps the camera above
    ' @param {BGE.Controller.ControlMap} controls read each update() for the move/look axes
    ' @param {string} [moveAxis="move"] axis name bound (via controls.bindAxis()) to the left/drive stick
    ' @param {string} [lookAxis="look"] axis name bound (via controls.bindAxis()) to the right/look stick
    sub new(camera as BGE.Camera3d, groundPlane as BGE.Math.Plane, controls as BGE.Controller.ControlMap, moveAxis = "move" as string, lookAxis = "look" as string)
      m.camera = camera
      m.groundPlane = groundPlane
      m.controls = controls
      m.moveAxisName = moveAxis
      m.lookAxisName = lookAxis
    end sub

    ' Forward a Scene/GameEntity's own onInput() call here. Tracks roll/pitch
    ' direction from the "replay"/"l1" (roll left), "options"/"r1" (roll right) and
    ' "rewind"/"fastforward" (pitch) buttons, and resets roll/pitch to their initial
    ' values on "play". Movement/turning is not read here - see update().
    '
    ' @param {BGE.GameInput} input
    sub onInput(input as BGE.GameInput)
      m.lastInput = input
      if input.isButton("replay") and not input.release
        m.rollDirection = -1
      else if input.isButton("l1") and not input.release
        m.rollDirection = -1
      else if input.isButton("options") and not input.release
        m.rollDirection = 1
      else if input.isButton("r1") and not input.release
        m.rollDirection = 1
      else if (input.isButton("replay") or input.isButton("l1")) and input.release
        m.rollDirection = 0
      else if (input.isButton("options") or input.isButton("r1")) and input.release
        m.rollDirection = 0
      else if input.isButton("rewind") and not input.release
        m.pitchDirection = -1
      else if input.isButton("fastforward") and not input.release
        m.pitchDirection = 1
      else if input.isButton("rewind") and input.release
        m.pitchDirection = 0
      else if input.isButton("fastforward") and input.release
        m.pitchDirection = 0
      end if

      if input.press and input.isButton("play")
        m.camera.rollDegrees = 0
        m.setInitialPitch(m.defaultPitch)
      end if
    end sub

    ' Forward a Scene/GameEntity's own onUpdate() call here. Reads the move/look axes
    ' (see class doc comment for the dual-stick-vs-fallback regime), applies
    ' strafe/drive/yaw/pitch to the camera, plus any active roll and button-driven pitch.
    '
    ' @param {float} dt seconds since the last frame
    sub update(dt as float)
      moveRaw = m.controls.getRawAxis(m.moveAxisName)
      lookRaw = m.controls.getRawAxis(m.lookAxisName)

      if moveRaw.x <> 0 or moveRaw.y <> 0 or lookRaw.x <> 0 or lookRaw.y <> 0
        strafeInput = moveRaw.x
        driveInput = moveRaw.y
        yawInput = lookRaw.x
        ' Negated: stick-up (+y, "tilt up") must decrease pitchAccum, matching
        ' pitchDirection = -1's ("rewind") sign convention below.
        analogPitchInput = -lookRaw.y
      else
        ' Neither stick has real input (no dual-stick controller connected, or it's
        ' momentarily centered) - fall back to a single physical source (remote analog
        ' stick, then d-pad), reproducing the pre-dual-stick behavior exactly: x turns,
        ' y drives, no strafe/analog-pitch (one d-pad can't drive both axes at once).
        fallback = m.controls.getAxis(m.moveAxisName)
        strafeInput = 0.0
        driveInput = fallback.y
        yawInput = fallback.x
        analogPitchInput = 0.0
      end if

      if yawInput <> 0
        ' Negated: RotateVectorAroundPoint3d's Rodrigues-formula rotation around the up
        ' axis turns the opposite direction from this codebase's established heading
        ' convention (forward = (sin(heading), 0, -cos(heading))) for a positive angle,
        ' so a positive angle here must be the negative of the input to turn the
        ' intended way.
        m.camera.orientation = BGE.Math.RotateVectorAroundPoint3d(m.camera.orientation, BGE.Math.VectorOps.create(), m.camera.getUpVector(), -yawInput * dt * m.turnSpeed)
      end if

      if driveInput <> 0 or strafeInput <> 0
        forwardOffset = BGE.Math.VectorOps.scale(m.camera.orientation, driveInput * dt * m.driveSpeed)
        rightOffset = BGE.Math.VectorOps.scale(m.camera.getRightVector(), strafeInput * dt * m.driveSpeed)
        candidate = BGE.Math.VectorOps.add(m.camera.position, BGE.Math.VectorOps.add(forwardOffset, rightOffset))
        m.camera.position = m.clampAboveGround(candidate)
      end if

      if m.rollDirection <> 0
        m.camera.rollDegrees = m.camera.rollDegrees + m.rollDirection * m.rollSpeed * dt
      end if

      delta = (m.pitchDirection * m.pitchSpeed + analogPitchInput * m.pitchSpeed) * dt
      if delta <> 0
        clampedAccum = BGE.Math.Clamp(m.pitchAccum + delta, -m.maxDownwardTilt, m.maxDownwardTilt)
        actualDelta = clampedAccum - m.pitchAccum
        m.pitchAccum = clampedAccum
        if actualDelta <> 0
          ' Negated for the same reason as the yaw rotation above.
          m.camera.orientation = BGE.Math.RotateVectorAroundPoint3d(m.camera.orientation, BGE.Math.VectorOps.create(), m.camera.getRightVector(), -actualDelta)
        end if
      end if
    end sub

    ' Sets the controller's starting pitch (radians, same sign convention as the internal
    ' pitch accumulator) and resets the camera to face straight down -z before applying
    ' it - both an initial setup call and the "play" button's reset use this, so the
    ' internal accumulator and the actually-applied rotation never drift apart the way
    ' they would if a caller rotated camera.orientation directly without seeding the
    ' accumulator to match (the pitch clamp would then only bound input on top of an
    ' untracked offset, and "play" would reset to level instead of back to this default).
    '
    ' @param {float} radians
    sub setInitialPitch(radians as float)
      m.defaultPitch = radians
      m.pitchAccum = radians
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.camera.orientation = BGE.Math.RotateVectorAroundPoint3d(m.camera.orientation, BGE.Math.VectorOps.create(), m.camera.getRightVector(), -radians)
    end sub

    ' Pushes a candidate camera position back above the ground plane by at least
    ' minHeightAboveGround, along the plane's own normal - keeps the camera from flying
    ' through the ground regardless of the plane's orientation.
    '
    ' @param {BGE.Math.Vector} candidate
    ' @return {BGE.Math.Vector}
    function clampAboveGround(candidate as BGE.Math.Vector) as BGE.Math.Vector
      toCandidate = BGE.Math.VectorOps.subtract(candidate, m.groundPlane.point)
      distance = BGE.Math.VectorOps.dotProduct(toCandidate, m.groundPlane.normal)
      if distance >= m.minHeightAboveGround
        return candidate
      end if
      shortfall = m.minHeightAboveGround - distance
      return BGE.Math.VectorOps.add(candidate, BGE.Math.VectorOps.scale(m.groundPlane.normal, shortfall))
    end function

  end class

end namespace
