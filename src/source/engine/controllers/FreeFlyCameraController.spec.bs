namespace tests

  @suite("BGE.FreeFlyCameraController")
  class FreeFlyCameraControllerTests extends rooibos.BaseTestSuite

    camera as BGE.Camera3d
    groundPlane as BGE.Math.Plane
    registry as BGE.Controller.ControllerRegistry
    controls as BGE.Controller.ControlMap
    controller as BGE.FreeFlyCameraController

    protected override function beforeEach()
      m.camera = new BGE.Camera3d()
      m.groundPlane = {
        normal: BGE.Math.VectorOps.create(0, 1, 0),
        point: BGE.Math.VectorOps.create(0, 0, 0)
      }
      m.registry = new BGE.Controller.ControllerRegistry()
      m.controls = new BGE.Controller.ControlMap(m.registry)
      m.controls.bindAxis("move", "1", 0)
      m.controls.bindAxis("look", "2", 0)
      m.controller = new BGE.FreeFlyCameraController(m.camera, m.groundPlane, m.controls)
    end function

    @describe("clampAboveGround")

    @it("leaves a candidate already above minHeightAboveGround unchanged")
    function _()
      candidate = BGE.Math.VectorOps.create(5, 10, 5)
      result = m.controller.clampAboveGround(candidate)

      m.assertEqual(5.0, result.x)
      m.assertEqual(10.0, result.y)
      m.assertEqual(5.0, result.z)
    end function

    @it("pushes a candidate below the ground plane back up to minHeightAboveGround")
    function _()
      candidate = BGE.Math.VectorOps.create(5, 0.2, 5)
      result = m.controller.clampAboveGround(candidate)

      m.assertEqual(m.controller.minHeightAboveGround, result.y)
    end function

    @it("clamps along the plane's own normal, not always +y")
    function _()
      m.controller.groundPlane = {
        normal: BGE.Math.VectorOps.create(1, 0, 0),
        point: BGE.Math.VectorOps.create(0, 0, 0)
      }
      candidate = BGE.Math.VectorOps.create(0.2, 5, 5)
      result = m.controller.clampAboveGround(candidate)

      m.assertEqual(m.controller.minHeightAboveGround, result.x)
    end function

    @describe("setInitialPitch")

    @it("faces -z when given a pitch of 0")
    function _()
      m.controller.setInitialPitch(0.0)

      m.assertEqual(0.0, m.camera.orientation.x)
      m.assertEqual(0.0, m.camera.orientation.y)
      m.assertEqual(-1.0, m.camera.orientation.z)
    end function

    @it("tilts the camera's orientation up/down for a nonzero pitch")
    function _()
      m.controller.setInitialPitch(0.3)

      m.assertNotEqual(0.0, m.camera.orientation.y)
    end function

    @describe("update - remote/d-pad fallback (no real stick connected)")

    @it("turns via yaw when the remote d-pad reads nonzero x")
    function _()
      m.registry.setRemoteDpad(0, 1.0, 0.0) ' right
      m.controller.update(1.0)

      m.assertNotEqual(0.0, m.camera.orientation.x)
    end function

    @it("drives forward along orientation when the remote d-pad reads positive y")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.registry.setRemoteDpad(0, 0.0, 1.0) ' up
      m.controller.update(1.0)

      m.assertEqual(0.0, m.camera.position.x)
      m.assertEqual(50.0, m.camera.position.y)
      m.assertTrue(m.camera.position.z < 0.0)
    end function

    @it("does not strafe from the d-pad's x (one d-pad can't drive both axes)")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.registry.setRemoteDpad(0, 1.0, 0.0) ' right
      m.controller.update(1.0)

      m.assertEqual(0.0, m.camera.position.x)
      m.assertEqual(50.0, m.camera.position.y)
      m.assertEqual(0.0, m.camera.position.z)
    end function

    @it("clamps camera position above the ground plane while driving")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 0.5, 0)
      m.camera.orientation = BGE.Math.VectorOps.create(0, -1, 0)
      m.registry.setRemoteDpad(0, 0.0, 1.0) ' up
      m.controller.update(1.0)

      m.assertEqual(m.controller.minHeightAboveGround, m.camera.position.y)
    end function

    @describe("update - dual-stick (real move/look sticks connected)")

    @it("strafes along the camera's right vector from the move stick's x")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.registry.assignPlayerIndex() ' player 0
      m.registry.updateFromMessage(0, {}, {"1": {x: 1.0, y: 0.0}}, {})
      m.controller.update(1.0)

      m.assertTrue(m.camera.position.x > 0.0)
      m.assertEqual(0.0, m.camera.position.z)
    end function

    @it("turns via yaw from the look stick's x, independent of the move stick")
    function _()
      m.registry.assignPlayerIndex() ' player 0
      m.registry.updateFromMessage(0, {}, {"2": {x: 1.0, y: 0.0}}, {})
      m.controller.update(1.0)

      m.assertNotEqual(0.0, m.camera.orientation.x)
    end function

    @it("tilts pitch up when the look stick's y is pushed up")
    function _()
      m.registry.assignPlayerIndex() ' player 0
      m.registry.updateFromMessage(0, {}, {"2": {x: 0.0, y: 1.0}}, {})
      m.controller.update(1.0)

      ' Pitching up from a level start rotates orientation.y positive (same
      ' direction as setInitialPitch's own "tilts up/down" test above).
      m.assertTrue(m.camera.orientation.y > 0.0)
    end function

    @describe("update - roll")

    @it("increases rollDegrees while the roll-right button is held")
    function _()
      pressInput = new BGE.GameInput(10, 0) ' options, pressed -> roll right
      m.controller.onInput(pressInput)
      m.controller.update(1.0)

      m.assertTrue(m.camera.rollDegrees > 0.0)
    end function

    @it("decreases rollDegrees while the roll-left button is held")
    function _()
      pressInput = new BGE.GameInput(7, 0) ' replay, pressed -> roll left
      m.controller.onInput(pressInput)
      m.controller.update(1.0)

      m.assertTrue(m.camera.rollDegrees < 0.0)
    end function

    @it("stops rolling once the roll button is released")
    function _()
      pressInput = new BGE.GameInput(10, 0) ' options, pressed
      m.controller.onInput(pressInput)
      m.controller.update(1.0)
      rolledDegrees = m.camera.rollDegrees

      releaseInput = new BGE.GameInput(110, 0) ' options, released
      m.controller.onInput(releaseInput)
      m.controller.update(1.0)

      m.assertEqual(rolledDegrees, m.camera.rollDegrees)
    end function

    @describe("update - pitch")

    @it("stops accumulating pitch once maxDownwardTilt is reached")
    function _()
      m.controller.pitchSpeed = 10.0 ' large step so one update overshoots the clamp
      pressInput = new BGE.GameInput(9, 0) ' fastforward, pressed -> pitch down
      m.controller.onInput(pressInput)
      m.controller.update(1.0)
      orientationAtClamp = m.camera.orientation

      m.controller.update(1.0)

      m.assertEqual(orientationAtClamp.x, m.camera.orientation.x)
      m.assertEqual(orientationAtClamp.y, m.camera.orientation.y)
      m.assertEqual(orientationAtClamp.z, m.camera.orientation.z)
    end function

    @describe("onInput - play button")

    @it("resets roll and pitch back to the initial pitch set via setInitialPitch")
    function _()
      m.controller.setInitialPitch(0.2)

      rollInput = new BGE.GameInput(10, 0) ' options, pressed
      m.controller.onInput(rollInput)
      m.controller.update(1.0)
      m.assertTrue(m.camera.rollDegrees <> 0.0)

      playInput = new BGE.GameInput(13, 0) ' play, pressed
      m.controller.onInput(playInput)

      m.assertEqual(0, m.camera.rollDegrees)
      expectedOrientation = BGE.Math.VectorOps.create(0, 0, -1)
      expectedOrientation = BGE.Math.RotateVectorAroundPoint3d(expectedOrientation, BGE.Math.VectorOps.create(), BGE.Math.VectorOps.create(1, 0, 0), -0.2)
      m.assertEqual(expectedOrientation.y, m.camera.orientation.y)
      m.assertEqual(expectedOrientation.z, m.camera.orientation.z)
    end function

  end class

end namespace
