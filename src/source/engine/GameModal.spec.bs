import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/GameScene.bs"
import "pkg:/source/engine/GameInput.bs"

namespace tests
  @suite("BGE.Game modals and input suppression")
  class GameModalTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("pushModal / popModal")

    @it("pauses while any modal is open and resumes when the last closes")
    function _()
      m.game.pushModal()
      m.game.pushModal()
      m.assertTrue(m.game.isPaused())
      m.assertEqual(2, m.game.getModalDepth())

      m.game.popModal()
      m.assertTrue(m.game.isPaused())
      m.assertTrue(m.game.isModalOpen())

      m.game.popModal()
      m.assertFalse(m.game.isPaused())
      m.assertFalse(m.game.isModalOpen())
    end function

    @it("doesn't resume a game that was paused before the first modal")
    function _()
      m.game.Pause()
      m.game.pushModal()
      m.game.popModal()
      m.assertTrue(m.game.isPaused())
    end function

    @it("an extra popModal() is ignored")
    function _()
      m.game.popModal()
      m.assertEqual(0, m.game.getModalDepth())
      m.assertFalse(m.game.isInputSuppressed())
    end function

    @it("closing the last modal suppresses input until release")
    function _()
      m.game.pushModal()
      m.game.popModal()
      m.assertTrue(m.game.isInputSuppressed())
    end function

    @describe("suppressInputUntilRelease")

    @it("drops everything for the rest of the frame")
    function _()
      m.game.suppressInputUntilRelease()
      m.assertTrue(m.game.isSuppressedInputForTest(new BGE.GameInput(6, 0, 0)))
    end function

    @it("after that frame, drops held and released buttons until pressed again")
    function _()
      m.game.suppressInputUntilRelease()
      m.game.endInputSuppressionIfReleasedForTest()
      m.assertTrue(m.game.isSuppressedInputForTest(new BGE.GameInput(1006, 100, 0)))
      m.assertTrue(m.game.isSuppressedInputForTest(new BGE.GameInput(106, 0, 0)))
      m.assertFalse(m.game.isSuppressedInputForTest(new BGE.GameInput(6, 0, 0)))
      m.assertFalse(m.game.isSuppressedInputForTest(new BGE.GameInput(1006, 10, 0)))
    end function

    @it("ends at the end of a later frame once nothing is held")
    function _()
      m.game.suppressInputUntilRelease()
      m.game.endInputSuppressionIfReleasedForTest()
      m.assertTrue(m.game.isInputSuppressed())
      m.game.endInputSuppressionIfReleasedForTest()
      m.assertFalse(m.game.isInputSuppressed())
    end function

    @it("blocks held bound actions")
    function _()
      m.game.controls.bindAction("attack", "ok")
      m.game.controls.onInput(new BGE.GameInput(6, 0, 0))
      m.game.suppressInputUntilRelease()
      m.assertTrue(m.game.controls.isActionBlocked("attack"))
    end function

    @describe("scene change")

    @it("resumes a paused game and forgets modals")
    function _()
      m.game.defineScene(new BGE.GameScene(m.game, {name: "SceneA"}))
      m.game.defineScene(new BGE.GameScene(m.game, {name: "SceneB"}))
      m.game.changeScene("SceneA")
      m.game.pushModal()
      m.game.End()
      m.game.changeScene("SceneB")
      m.assertFalse(m.game.isPaused())
      m.assertFalse(m.game.isModalOpen())
    end function

    @it("keeps the pause when keepPauseOnSceneChange is set")
    function _()
      m.game.defineScene(new BGE.GameScene(m.game, {name: "SceneA"}))
      m.game.defineScene(new BGE.GameScene(m.game, {name: "SceneB"}))
      m.game.changeScene("SceneA")
      m.game.keepPauseOnSceneChange = true
      m.game.Pause()
      m.game.End()
      m.game.changeScene("SceneB")
      m.assertTrue(m.game.isPaused())
    end function

  end class
end namespace
