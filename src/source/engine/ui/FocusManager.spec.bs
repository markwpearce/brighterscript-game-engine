import "../Game.bs"
import "FocusManager.bs"
import "UiContainer.bs"
import "UiWidget.bs"
import "../controller/ControlMap.bs"
import "../controller/ControllerRegistry.bs"

namespace tests

  @suite("BGE.UI.FocusManager")
  class FocusManagerTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("updateAnalogCursor")

    @it("updateAnalogCursor does nothing when analogAxisName is unset")
    function _()
      fm = new BGE.UI.FocusManager(m.game)
      fm.navigationMode = BGE.UI.FocusNavigationMode.pointer
      startX = fm.cursorPosition.x
      controls = new BGE.Controller.ControlMap(new BGE.Controller.ControllerRegistry())
      fm.updateAnalogCursor(controls, 1.0)
      m.assertEqual(startX, fm.cursorPosition.x)
    end function

    @it("updateAnalogCursor moves cursorPosition proportionally to axis magnitude and dt")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("cursor", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 1.0, y: 0.0}}, {})

      fm = new BGE.UI.FocusManager(m.game)
      fm.navigationMode = BGE.UI.FocusNavigationMode.pointer
      fm.analogAxisName = "cursor"
      fm.cursorAnalogSpeed = 100.0
      startX = fm.cursorPosition.x

      fm.updateAnalogCursor(controls, 0.5) ' half a second

      m.assertEqual(startX + 50.0, fm.cursorPosition.x) ' 100px/s * 0.5s
    end function

    @it("updateAnalogCursor ignores axis input below the deadzone")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("cursor", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.05, y: 0.0}}, {}) ' below 0.15 deadzone

      fm = new BGE.UI.FocusManager(m.game)
      fm.navigationMode = BGE.UI.FocusNavigationMode.pointer
      fm.analogAxisName = "cursor"
      startX = fm.cursorPosition.x

      fm.updateAnalogCursor(controls, 1.0)

      m.assertEqual(startX, fm.cursorPosition.x)
    end function

    @it("updateAnalogCursor does nothing in list mode")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("cursor", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 1.0, y: 0.0}}, {})

      fm = new BGE.UI.FocusManager(m.game)
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      fm.analogAxisName = "cursor"
      startX = fm.cursorPosition.x

      fm.updateAnalogCursor(controls, 1.0)

      m.assertEqual(startX, fm.cursorPosition.x)
    end function

    @it("updateAnalogCursor moves the cursor DOWN in screen space for a negative axis.y")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("cursor", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.0, y: -1.0}}, {}) ' stick pushed "down" (world-space -y)

      fm = new BGE.UI.FocusManager(m.game)
      fm.navigationMode = BGE.UI.FocusNavigationMode.pointer
      fm.analogAxisName = "cursor"
      fm.cursorAnalogSpeed = 100.0
      startY = fm.cursorPosition.y

      fm.updateAnalogCursor(controls, 0.5)

      m.assertEqual(startY + 50.0, fm.cursorPosition.y) ' screen-space +y is down
    end function

    @it("updateAnalogCursor hit-tests after moving, hovering and focusing the widget it lands on")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("cursor", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 1.0, y: 0.0}}, {})

      container = new BGE.UI.UiContainer(m.game)
      ' The cursor seeds onto the first registered widget's centre (20, 20),
      ' then analog movement carries it right into the second one.
      seedTarget = m.makeWidget(container, 0, 0)
      target = m.makeWidget(container, 100, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.pointer
      fm.analogAxisName = "cursor"
      fm.cursorAnalogSpeed = 100.0

      fm.updateAnalogCursor(controls, 1.0) ' +100px right -> (120, 20)

      m.assertEqual(120.0, fm.cursorPosition.x)
      m.assertTrue(target.hovered)
      m.assertTrue(target.focused)
      m.assertFalse(seedTarget.focused)
    end function

    @describe("updateAnalogList")

    @it("updateAnalogList does nothing when analogAxisName is unset")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)
      m.makeWidget(container, 100, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      controls = new BGE.Controller.ControlMap(new BGE.Controller.ControllerRegistry())

      fm.updateAnalogList(controls, 1.0)

      m.assertFalse(widgetA.focused)
    end function

    @it("updateAnalogList does nothing in pointer mode")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("stick", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.0, y: -1.0}}, {})

      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)
      m.makeWidget(container, 100, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.pointer
      fm.analogAxisName = "stick"

      fm.updateAnalogList(controls, 1.0)

      m.assertFalse(widgetA.focused)
    end function

    @it("updateAnalogList ignores axis input below the deadzone")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("stick", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.0, y: -0.05}}, {}) ' below 0.15 deadzone

      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)
      m.makeWidget(container, 100, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      fm.analogAxisName = "stick"

      fm.updateAnalogList(controls, 1.0)

      ' Nothing has been seeded at all yet - a below-deadzone axis shouldn't
      ' even seed initial focus, let alone move it.
      m.assertFalse(widgetA.focused)
    end function

    @it("updateAnalogList moves focus to the next widget the instant the axis crosses the deadzone")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("stick", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.0, y: -1.0}}, {}) ' "down" -> next

      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)
      widgetB = m.makeWidget(container, 100, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      fm.analogAxisName = "stick"

      fm.updateAnalogList(controls, 1.0) ' one call: seeds widgetA, then steps to widgetB

      m.assertFalse(widgetA.focused)
      m.assertTrue(widgetB.focused)
    end function

    @it("updateAnalogList does not move focus again before the 0.5s repeat delay elapses")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("stick", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.0, y: -1.0}}, {})

      container = new BGE.UI.UiContainer(m.game)
      m.makeWidget(container, 0, 0)
      widgetB = m.makeWidget(container, 100, 0)
      widgetC = m.makeWidget(container, 200, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      fm.analogAxisName = "stick"

      fm.updateAnalogList(controls, 0.1) ' edge: widgetA -> widgetB
      fm.updateAnalogList(controls, 0.3) ' still held, only 0.3s since the step - not yet 0.5s

      m.assertTrue(widgetB.focused)
      m.assertFalse(widgetC.focused)
    end function

    @it("updateAnalogList moves focus again once the 0.5s repeat delay elapses while still held")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("stick", "1", playerIndex)
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.0, y: -1.0}}, {})

      container = new BGE.UI.UiContainer(m.game)
      m.makeWidget(container, 0, 0)
      widgetB = m.makeWidget(container, 100, 0)
      widgetC = m.makeWidget(container, 200, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      fm.analogAxisName = "stick"

      fm.updateAnalogList(controls, 0.1) ' edge: widgetA -> widgetB
      fm.updateAnalogList(controls, 0.5) ' 0.5s since the step - repeat fires

      m.assertFalse(widgetB.focused)
      m.assertTrue(widgetC.focused)
    end function

    @it("updateAnalogList lets a release-then-repress move focus immediately again, not throttled")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      playerIndex = registry.assignPlayerIndex()
      controls.bindAxis("stick", "1", playerIndex)

      container = new BGE.UI.UiContainer(m.game)
      m.makeWidget(container, 0, 0)
      widgetB = m.makeWidget(container, 100, 0)
      widgetC = m.makeWidget(container, 200, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      fm.analogAxisName = "stick"

      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.0, y: -1.0}}, {})
      fm.updateAnalogList(controls, 0.05) ' edge: widgetA -> widgetB

      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.0, y: 0.0}}, {}) ' released to neutral
      fm.updateAnalogList(controls, 0.05)

      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.0, y: -1.0}}, {}) ' pressed again, well under 0.5s later
      fm.updateAnalogList(controls, 0.05)

      m.assertFalse(widgetB.focused)
      m.assertTrue(widgetC.focused)
    end function

    @describe("update - list mode with a bound analog axis")

    @it("does not also step focus via the discrete d-pad press when analogAxisName is bound (issue #216 - double-drive)")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      controls = new BGE.Controller.ControlMap(registry)
      controls.bindAxis("move") ' player 0, stick "1"
      m.game.controls = controls
      registry.setRemoteDpad(0, 0.0, -1.0) ' "down", what updateAnalogList() reads via getAxis()'s fallback

      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)
      widgetB = m.makeWidget(container, 100, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      fm.analogAxisName = "move"

      ' A fresh "down" press - would normally seed widgetA then immediately
      ' step to widgetB in the same call (see the #198 seeding tests above),
      ' but updateAnalogList() already owns stepping while an axis is bound,
      ' so this discrete event must not also step focus.
      fm.update(new BGE.GameInput(3, 0)) ' pressed "down"

      m.assertTrue(widgetA.focused)
      m.assertFalse(widgetB.focused)
    end function

    @it("falls back to the discrete d-pad stepper when analogAxisName is set but never bound via bindAxis")
    function _()
      controls = new BGE.Controller.ControlMap(new BGE.Controller.ControllerRegistry())
      m.game.controls = controls
      controls.bindAction("unrelated", "ok") ' hasBindings() true, but "move" itself was never bound

      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)
      widgetB = m.makeWidget(container, 100, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      fm.analogAxisName = "move" ' set, but never passed to bindAxis()

      fm.update(new BGE.GameInput(3, 0)) ' pressed "down" - seeds widgetA, then steps to widgetB

      m.assertFalse(widgetA.focused)
      m.assertTrue(widgetB.focused)
    end function

    ' A 40x40 focusable widget at a fixed position within container.
    private function makeWidget(container as BGE.UI.UiContainer, x as integer, y as integer) as BGE.UI.UiWidget
      widget = new BGE.UI.UiWidget(m.game)
      widget.focusable = true
      widget.customPosition = true
      widget.customX = x
      widget.customY = y
      widget.width = 40
      widget.height = 40
      widget.repositionBasedOnParent(container)
      container.addChild(widget)
      return widget
    end function

    @describe("focusWidget")

    @it("focuses the given widget directly, blurring whatever was focused before")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)
      widgetB = m.makeWidget(container, 100, 0)

      fm = m.game.focusManager
      fm.ensureFocusSeeded() ' seeds widgetA (focusOrder[0])

      fm.focusWidget(widgetB)

      m.assertFalse(widgetA.focused)
      m.assertTrue(widgetB.focused)
    end function

    @it("is a no-op when the widget isn't currently registered")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)
      unregisteredWidget = new BGE.UI.UiWidget(m.game)

      fm = m.game.focusManager
      fm.ensureFocusSeeded() ' seeds widgetA

      fm.focusWidget(unregisteredWidget)

      m.assertTrue(widgetA.focused)
    end function

    @describe("update - list mode seeding")

    @it("does not also navigate away from the seeded widget on the same held-input event that seeds it (#198)")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)
      widgetB = m.makeWidget(container, 100, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list

      ' A directional button already held from a prior frame, arriving on the
      ' very first update() call after these widgets became focusable.
      fm.update(new BGE.GameInput(1003, 500)) ' held "down"

      m.assertTrue(widgetA.focused)
      m.assertFalse(widgetB.focused)
    end function

    @it("re-seeds focus in a new list-mode container after a pointer-mode container clears while nothing was focused (#190)")
    function _()
      fm = m.game.focusManager

      ' Seed list-mode focus onto a single widget at index 0 (currentlyFocusedIndex = 0).
      listContainerA = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(listContainerA, 0, 0)
      fm.update(new BGE.GameInput(0, 0)) ' neutral press (back), no direction; just triggers seeding
      m.assertTrue(widgetA.focused)

      ' Switch to pointer mode without removing widgetA - currentlyFocusedIndex
      ' (list-mode-only state) is untouched by pointer-mode hit-testing, so it
      ' stays at 0 even once pointer mode blurs currentlyFocused below.
      fm.navigationMode = BGE.UI.FocusNavigationMode.pointer
      fm.cursorPosition = BGE.Math.VectorOps.create(500, 500, 0) ' far from widgetA (0,0..40,40)
      fm.update(new BGE.GameInput(0, 0)) ' hit-tests the cursor: misses, blurring widgetA
      m.assertFalse(widgetA.focused)

      ' Clear the container while nothing is focused - unregister() only
      ' resets hasSeededFocus/currentlyFocusedIndex when the REMOVED widget
      ' itself was currentlyFocused, which it wasn't here (already invalid).
      listContainerA.clearChildren()

      ' Switch to a fresh list-mode container with two widgets.
      fm.navigationMode = BGE.UI.FocusNavigationMode.list
      listContainerB = new BGE.UI.UiContainer(m.game)
      widgetB0 = m.makeWidget(listContainerB, 0, 0)
      widgetB1 = m.makeWidget(listContainerB, 100, 0)

      ' First input is "up": stale currentlyFocusedIndex (0) + delta(-1)
      ' clamps back to 0, which equals the stale index, so navigateList's
      ' "did the index change" check sees no change and never calls
      ' focusTo() at all.
      fm.update(new BGE.GameInput(2, 0)) ' press up

      m.assertTrue(widgetB0.focused)
      m.assertFalse(widgetB1.focused)
    end function

    @it("does not call handleInput() on a widget the same held-input event that seeds it, in list mode (#198)")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      widget = new tests.HandleInputProbeWidget(m.game)
      widget.focusable = true
      widget.customPosition = true
      widget.customX = 0
      widget.customY = 0
      widget.width = 40
      widget.height = 40
      widget.repositionBasedOnParent(container)
      container.addChild(widget)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.list

      ' A directional button already held from a prior frame, arriving on the
      ' very first update() call after this widget became focusable.
      fm.update(new BGE.GameInput(1003, 500)) ' held "down"

      m.assertTrue(widget.focused)
      m.assertFalse(widget.handleInputCalled)
    end function

    @describe("update - pointer mode seeding")

    @it("does not navigate the cursor away from the just-seeded widget on the same held-input event that seeds it (#198, pointer mode)")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      widgetA = m.makeWidget(container, 0, 0)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.pointer

      ' A directional button already held from a prior frame, arriving on the
      ' very first update() call after this widget became focusable - the
      ' cursor seeds onto widgetA's centre (20, 20); this same held event
      ' must not also step the cursor via navigatePointer() (asserting on
      ' cursorPosition directly, since a cursor move this same call isn't
      ' hit-tested until the *next* update() call - focused state alone
      ' wouldn't catch the regression here).
      fm.update(new BGE.GameInput(1005, 500)) ' held "right"

      m.assertTrue(widgetA.focused)
      m.assertEqual(20.0, fm.cursorPosition.x)
    end function

    @it("does not call handleInput() on a widget the same held-input event that seeds it, in pointer mode (#198)")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      widget = new tests.HandleInputProbeWidget(m.game)
      widget.focusable = true
      widget.customPosition = true
      widget.customX = 0
      widget.customY = 0
      widget.width = 40
      widget.height = 40
      widget.repositionBasedOnParent(container)
      container.addChild(widget)

      fm = m.game.focusManager
      fm.navigationMode = BGE.UI.FocusNavigationMode.pointer

      fm.update(new BGE.GameInput(1005, 500)) ' held "right", arriving on first seed

      m.assertTrue(widget.focused)
      m.assertFalse(widget.handleInputCalled)
    end function

    @describe("draw")

    @it("draw() calls drawOverlay() on the currently focused widget")
    function _()
      container = m.game.gameUi
      probe = new tests.OverlayProbeWidget(m.game)
      probe.focusable = true
      container.addChild(probe)

      m.game.focusManager.update(new BGE.GameInput(2, 0)) ' seeds focus in list mode
      m.game.focusManager.draw(m.game.uiCanvas, m.game.defaultTheme)

      m.assertTrue(probe.overlayDrawn)
    end function

    @it("draw() does not call drawOverlay() when nothing is focused")
    function _()
      probe = new tests.OverlayProbeWidget(m.game)
      ' Not added to any container, so it is never registered with the FocusManager.

      m.game.focusManager.draw(m.game.uiCanvas, m.game.defaultTheme)

      m.assertFalse(probe.overlayDrawn)
    end function

  end class

  ' Records whether drawOverlay() was invoked, since UiWidget's own
  ' drawOverlay() is a no-op by design.
  class OverlayProbeWidget extends BGE.UI.UiWidget
    overlayDrawn as boolean = false

    sub new(game as BGE.Game)
      super(game)
    end sub

    override sub drawOverlay(canvas as BGE.Canvas, theme as BGE.UI.Theme)
      m.overlayDrawn = true
    end sub
  end class

  ' Records whether handleInput() was invoked - stands in for a widget like
  ' Slider whose handleInput() would otherwise visibly change state on a
  ' held directional event.
  class HandleInputProbeWidget extends BGE.UI.UiWidget
    handleInputCalled as boolean = false

    sub new(game as BGE.Game)
      super(game)
    end sub

    override function handleInput(input as BGE.GameInput) as boolean
      m.handleInputCalled = true
      return true
    end function
  end class

end namespace
