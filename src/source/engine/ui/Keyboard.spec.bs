import "pkg:/source/engine/ui/Keyboard.bs"
import "pkg:/source/engine/ui/TextInput.bs"
import "pkg:/source/engine/ui/UiContainer.bs"

namespace tests

  @suite("BGE.UI.Keyboard")
  class KeyboardTests extends rooibos.BaseTestSuite

    game as BGE.Game
    input as BGE.UI.TextInput
    keyboard as BGE.UI.Keyboard

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.input = new BGE.UI.TextInput(m.game)
      m.input.width = 100
      m.input.height = 20
      m.game.gameUi.addChild(m.input)
      m.keyboard = new BGE.UI.Keyboard(m.game)
      m.keyboard.width = 210
      m.keyboard.height = 150
      m.keyboard.show(m.game.gameUi, m.input)
    end function

    @describe("typing")

    @it("is focused once shown")
    function _()
      m.assertTrue(m.keyboard.focused)
      m.assertTrue(m.keyboard.isShown())
    end function

    @it("reopens on the first page with the first key highlighted")
    function _()
      m.keyboard.layout.setPage(2)
      m.keyboard.layout.setCursor(2, 3)
      m.keyboard.hide()
      m.keyboard.show(m.game.gameUi, m.input)
      m.assertEqual(0, m.keyboard.layout.pageIndex)
      m.assertEqual(0, m.keyboard.layout.row)
      m.assertEqual(0, m.keyboard.layout.column)
    end function

    @it("OK types the highlighted key into the target")
    function _()
      m.game.focusManager.update(new BGE.GameInput(6, 0))
      m.assertEqual("a", m.input.text)
    end function

    @it("d-pad moves the highlight, is consumed and keeps focus")
    function _()
      input = new BGE.GameInput(5, 0) ' right
      m.game.focusManager.update(input)
      m.assertEqual("b", m.keyboard.layout.currentKey().label)
      m.assertTrue(input.consumed)
      m.assertTrue(m.keyboard.focused)

      m.game.focusManager.update(new BGE.GameInput(3, 0)) ' down
      m.assertEqual("i", m.keyboard.layout.currentKey().label)
      m.assertTrue(m.keyboard.focused)
    end function

    @it("Space, Del and page keys")
    function _()
      m.keyboard.layout.setCursor(4, 2) ' Space
      m.keyboard.pressKey(m.keyboard.layout.currentKey())
      m.assertEqual(" ", m.input.text)
      m.keyboard.layout.setCursor(4, 3) ' Del
      m.keyboard.pressKey(m.keyboard.layout.currentKey())
      m.assertEqual("", m.input.text)
      m.keyboard.layout.setCursor(4, 0) ' Shift
      m.keyboard.pressKey(m.keyboard.layout.currentKey())
      m.assertEqual(1, m.keyboard.layout.pageIndex)
    end function

    @it("remote shortcuts: replay deletes, fast-forward types a space")
    function _()
      m.input.text = "ab"
      m.input.cursorIndex = 2
      m.game.focusManager.update(new BGE.GameInput(7, 0))
      m.assertEqual("a", m.input.text)
      m.game.focusManager.update(new BGE.GameInput(9, 0))
      m.assertEqual("a ", m.input.text)
    end function

    @it("forwards mobile-app characters to the target")
    function _()
      m.keyboard.onECPKeyboard(Asc("z"))
      m.assertEqual("z", m.input.text)
      m.keyboard.onECPKeyboard(8)
      m.assertEqual("", m.input.text)
    end function

    @it("marks the target as editing while shown")
    function _()
      m.assertTrue(m.input.editing)
      m.keyboard.hide()
      m.assertFalse(m.input.editing)
    end function

    @describe("done and cancel")

    @it("Done hides, refocuses the target and fires onSubmit")
    function _()
      m.input.onSubmit = sub(input as BGE.UI.TextInput)
        input.lastChangedValue = "submitted"
      end sub
      m.keyboard.done()
      m.assertFalse(m.keyboard.isShown())
      m.assertTrue(m.input.focused)
      m.assertEqual("submitted", m.input.lastChangedValue)
    end function

    @it("Done fires onDone")
    function _()
      m.keyboard.onDone = sub(keyboard as BGE.UI.Keyboard)
        keyboard.target.lastChangedValue = "done"
      end sub
      m.keyboard.done()
      m.assertEqual("done", m.input.lastChangedValue)
    end function

    @it("Play is Done")
    function _()
      m.game.focusManager.update(new BGE.GameInput(13, 0))
      m.assertFalse(m.keyboard.isShown())
    end function

    @it("Back cancels, restores the text and fires onCancel")
    function _()
      m.keyboard.hide()
      m.input.text = "old"
      m.input.cursorIndex = 3
      m.keyboard.onCancel = sub(keyboard as BGE.UI.Keyboard)
        keyboard.target.lastChangedValue = "cancelled"
      end sub
      m.keyboard.show(m.game.gameUi, m.input)
      m.input.insertChar(Asc("x"))
      m.game.focusManager.update(new BGE.GameInput(0, 0))
      m.assertEqual("old", m.input.text)
      m.assertEqual(3, m.input.cursorIndex)
      m.assertFalse(m.keyboard.isShown())
      m.assertEqual("cancelled", m.input.lastChangedValue)
    end function

    @it("hide unregisters from focus")
    function _()
      before = m.game.focusManager.registeredCount()
      m.keyboard.hide()
      m.assertEqual(before - 1, m.game.focusManager.registeredCount())
    end function

    @it("clearing its container stops editing so the input can reopen it")
    function _()
      m.input.keyboard = m.keyboard
      m.game.gameUi.clearChildren()
      m.assertFalse(m.keyboard.isShown())
      m.assertFalse(m.input.editing)
      m.game.gameUi.addChild(m.input)
      m.input.onClick()
      m.assertTrue(m.keyboard.isShown())
    end function

    @describe("pointer mode")

    @it("a cursor that moves onto a key highlights it")
    function _()
      m.game.focusManager.navigationMode = BGE.UI.FocusNavigationMode.pointer
      m.keyboard.repositionBasedOnParent(m.game.gameUi)
      ' 210 wide / 7 units = 30px per unit; 150 high / 5 rows = 30px per row
      m.game.focusManager.cursorPosition = BGE.Math.VectorOps.create(m.keyboard.position.x + 75, m.keyboard.position.y + 45)
      m.keyboard.onUpdate(0.016)
      m.assertEqual(1, m.keyboard.layout.row)
      m.assertEqual(2, m.keyboard.layout.column)
    end function

    @describe("draw")

    @it("draws every page without throwing")
    function _()
      for page = 0 to 2
        m.keyboard.layout.setPage(page)
        m.keyboard.draw(m.game.gameUi)
      end for
      m.assertTrue(true)
    end function

    @it("bakes the key grid once, again only when the page or layout changes")
    function _()
      m.keyboard.draw(m.game.gameUi)
      m.keyboard.draw(m.game.gameUi)
      m.assertEqual(1, m.keyboard.gridBuildCount)
      m.game.focusManager.update(new BGE.GameInput(5, 0)) ' moving the highlight doesn't rebake
      m.keyboard.draw(m.game.gameUi)
      m.assertEqual(1, m.keyboard.gridBuildCount)
      m.keyboard.layout.setPage(1)
      m.keyboard.draw(m.game.gameUi)
      m.assertEqual(2, m.keyboard.gridBuildCount)
      m.keyboard.layout = BGE.UI.createQwertyKeyboardLayout()
      m.keyboard.draw(m.game.gameUi)
      m.assertEqual(3, m.keyboard.gridBuildCount)
      m.keyboard.keyGap = 8.0
      m.keyboard.draw(m.game.gameUi)
      m.assertEqual(4, m.keyboard.gridBuildCount)
    end function

  end class

end namespace
