import "pkg:/source/engine/ui/NinePatchImage.bs"

namespace tests

  @suite("BGE.UI.Button")
  class ButtonTests extends rooibos.BaseTestSuite

    game as BGE.Game
    button as BGE.UI.Button

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.button = new BGE.UI.Button(m.game)
    end function

    @describe("defaults")

    @it("is focusable by default")
    function _()
      m.assertTrue(m.button.focusable)
    end function

    @describe("onClick")

    @it("calls onActivate when set")
    function _()
      ' BrightScript function literals don't close over enclosing locals, so
      ' the call is counted on a test-only Button subclass instead of a field
      ' on the production class.
      button = new ActivateCountingButton(m.game)
      button.onActivate = sub(b as dynamic)
        b.activateCount++
      end sub

      button.onClick()

      m.assertEqual(1, button.activateCount)
    end function

    @it("does nothing if onActivate isn't set")
    function _()
      m.button.onClick() ' should not throw
      m.assertTrue(true)
    end function

    @describe("draw")

    @it("draw() does not throw with the default flat-color theme")
    function _()
      m.button.width = 80
      m.button.height = 30
      m.button.draw() ' should not throw
      m.assertTrue(true)
    end function

    @it("draw() does not throw when theme.backgroundImage is set")
    function _()
      bmp = CreateObject("roBitmap", {width: 24, height: 24, AlphaEnable: true})
      bmp.Clear(&hFFFFFFFF)
      m.game.defaultTheme.backgroundImage = new BGE.UI.NinePatchImage(bmp, 6, 6, 6, 6)

      m.button.width = 80
      m.button.height = 30
      m.button.draw() ' should not throw
      m.assertTrue(true)
    end function

    @describe("theme font application")

    @it("applies a container theme's custom font to its drawableText on the first draw()")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      customTheme = new BGE.UI.Theme()
      customTheme.font = m.game.getFont("debugUi") ' distinct roFont from the default font (different size)
      container.theme = customTheme

      m.button.setLabel("Hi")
      m.button.width = 80
      m.button.height = 30
      m.button.draw(container)

      ' Comparing two roFont instances with `=` (even cast `as object`) is a
      ' runtime Type Mismatch crash in BrightScript, confirmed while writing
      ' this test - so identity is asserted via a scalar proxy (line height,
      ' which differs between the two distinctly-sized fonts) instead.
      m.assertEqual(customTheme.font.GetOneLineHeight(), m.button.drawableText.font.GetOneLineHeight())
    end function

    @it("leaves the default font untouched when no container theme font is set")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      defaultFontHeight = m.button.drawableText.font.GetOneLineHeight()

      m.button.setLabel("Hi")
      m.button.width = 80
      m.button.height = 30
      m.button.draw(container)

      m.assertEqual(defaultFontHeight, m.button.drawableText.font.GetOneLineHeight())
    end function

  end class

  class ActivateCountingButton extends BGE.UI.Button
    activateCount as integer = 0

    sub new(game as BGE.Game)
      super(game)
    end sub
  end class

end namespace
