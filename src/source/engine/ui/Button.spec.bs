namespace tests

  @suite("BGE.UI.Button")
  class ButtonTests extends rooibos.BaseTestSuite

    game as BGE.Game
    button as BGE.UI.Button

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.button = new BGE.UI.Button(m.game)
    end function

    @describe("defaults")

    @it("is focusable by default")
    function _()
      m.assertTrue(m.button.focusable)
    end function

    @describe("onClick")

    @it("calls onActivate when set")
    function _()
      ' BrightScript function literals don't close over enclosing locals, so
      ' the call is counted on a test-only Button subclass instead of a field
      ' on the production class.
      button = new ActivateCountingButton(m.game)
      button.onActivate = sub(b as dynamic)
        b.activateCount++
      end sub

      button.onClick()

      m.assertEqual(1, button.activateCount)
    end function

    @it("does nothing if onActivate isn't set")
    function _()
      m.button.onClick() ' should not throw
      m.assertTrue(true)
    end function

  end class

  class ActivateCountingButton extends BGE.UI.Button
    activateCount as integer = 0

    sub new(game as BGE.Game)
      super(game)
    end sub
  end class

end namespace
