import "pkg:/source/engine/ui/NinePatchImage.bs"
import "pkg:/source/engine/ui/UiContainer.bs"

namespace tests

  @suite("BGE.UI.Button")
  class ButtonTests extends rooibos.BaseTestSuite

    game as BGE.Game
    button as BGE.UI.Button

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.button = new BGE.UI.Button(m.game)
    end function

    @describe("defaults")

    @it("is focusable by default")
    function _()
      m.assertTrue(m.button.focusable)
    end function

    @describe("onClick")

    @it("calls onActivate when set")
    function _()
      ' BrightScript function literals don't close over enclosing locals, so
      ' the call is counted on a test-only Button subclass instead of a field
      ' on the production class.
      button = new ActivateCountingButton(m.game)
      button.onActivate = sub(b as dynamic)
        b.activateCount++
      end sub

      button.onClick()

      m.assertEqual(1, button.activateCount)
    end function

    @it("does nothing if onActivate isn't set")
    function _()
      m.button.onClick() ' should not throw
      m.assertTrue(true)
    end function

    @it("tells its listener its actionId on click")
    function _()
      listener = new RecordingUiListener()
      m.button.actionId = "resume"
      m.button.value = 3
      m.button.listener = listener

      m.button.onClick()

      m.assertEqual("resume", listener.lastActionId)
      m.assertEqual(3, listener.lastValue)
    end function

    @it("calls onActivate before the listener")
    function _()
      button = new ActivateCountingButton(m.game)
      button.onActivate = sub(b as dynamic)
        b.activateCount++
      end sub
      listener = new RecordingUiListener()
      button.listener = listener

      button.onClick()

      m.assertEqual(1, button.activateCount)
      m.assertEqual(1, listener.calls)
    end function

    @describe("disabled")

    @it("ignores clicks while disabled")
    function _()
      listener = new RecordingUiListener()
      m.button.listener = listener
      m.button.setDisabled(true)

      m.button.onClick()

      m.assertEqual(0, listener.calls)
      m.assertFalse(m.button.focusable)
    end function

    @it("unregisters from focus when disabled in a container, and registers again when enabled")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      container.addChild(m.button)
      m.assertEqual(1, m.game.focusManager.registeredCount())

      m.button.setDisabled(true)
      m.assertEqual(0, m.game.focusManager.registeredCount())

      m.button.setDisabled(false)
      m.assertEqual(1, m.game.focusManager.registeredCount())
    end function

    @it("a button disabled before it's added isn't registered for focus")
    function _()
      m.button.setDisabled(true)
      container = new BGE.UI.UiContainer(m.game)
      container.addChild(m.button)
      m.assertEqual(0, m.game.focusManager.registeredCount())
    end function

    @it("draw() does not throw while disabled")
    function _()
      m.button.setLabel("Off")
      m.button.width = 80
      m.button.height = 30
      m.button.setDisabled(true)
      m.button.draw()
      m.assertTrue(true)
    end function

    @describe("draw")

    @it("draw() does not throw with the default flat-color theme")
    function _()
      m.button.width = 80
      m.button.height = 30
      m.button.draw() ' should not throw
      m.assertTrue(true)
    end function

    @it("draw() does not throw when theme.backgroundImage is set")
    function _()
      bmp = CreateObject("roBitmap", {width: 24, height: 24, AlphaEnable: true})
      bmp.Clear(&hFFFFFFFF)
      m.game.defaultTheme.backgroundImage = new BGE.UI.NinePatchImage(bmp, 6, 6, 6, 6)

      m.button.width = 80
      m.button.height = 30
      m.button.draw() ' should not throw
      m.assertTrue(true)
    end function

    @describe("theme font application")

    @it("applies a container theme's custom font to its drawableText on the first draw()")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      customTheme = new BGE.UI.Theme()
      customTheme.font = m.game.getFont("debugUi") ' distinct roFont from the default font (different size)
      container.theme = customTheme

      m.button.setLabel("Hi")
      m.button.width = 80
      m.button.height = 30
      m.button.draw(container)

      ' Comparing two roFont instances with `=` (even cast `as object`) is a
      ' runtime Type Mismatch crash in BrightScript, confirmed while writing
      ' this test - so identity is asserted via a scalar proxy (line height,
      ' which differs between the two distinctly-sized fonts) instead.
      m.assertEqual(customTheme.font.GetOneLineHeight(), m.button.drawableText.font.GetOneLineHeight())
    end function

    @it("leaves the default font untouched when no container theme font is set")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      defaultFontHeight = m.button.drawableText.font.GetOneLineHeight()

      m.button.setLabel("Hi")
      m.button.width = 80
      m.button.height = 30
      m.button.draw(container)

      m.assertEqual(defaultFontHeight, m.button.drawableText.font.GetOneLineHeight())
    end function

  end class

  class RecordingUiListener
    calls as integer = 0
    lastActionId as string = ""
    lastValue as dynamic = invalid

    sub onUiAction(actionId as string, button as BGE.UI.Button)
      m.calls++
      m.lastActionId = actionId
      m.lastValue = button.value
    end sub
  end class

  class ActivateCountingButton extends BGE.UI.Button
    activateCount as integer = 0

    sub new(game as BGE.Game)
      super(game)
    end sub
  end class

end namespace
