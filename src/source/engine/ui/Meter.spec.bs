import "pkg:/source/engine/ui/Meter.bs"
import "pkg:/source/engine/Game.bs"

namespace tests
  @suite("BGE.UI.Meter")
  class MeterTests extends rooibos.BaseTestSuite

    game as BGE.Game
    meter as BGE.UI.Meter

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.meter = new BGE.UI.Meter(m.game)
      m.meter.width = 100
      m.meter.height = 10
    end function

    @describe("value")

    @it("stores the value as a clamped fraction")
    function _()
      m.meter.setValue(30, 60)
      m.assertEqual(0.5, m.meter.getFraction())
      m.meter.setValue(90, 60)
      m.assertEqual(1.0, m.meter.getFraction())
      m.meter.setValue(5, 0)
      m.assertEqual(0.0, m.meter.getFraction())
    end function

    @describe("lag chunk")

    @it("without lag, the lag fraction follows the value")
    function _()
      m.meter.setValue(0.4)
      m.assertEqual(0.4, m.meter.getLagFraction())
    end function

    @it("holds the lost part, then drains it to the value")
    function _()
      m.meter.lagEnabled = true
      m.meter.setValue(0.5)
      m.meter.update(0.5)
      m.assertEqual(1.0, m.meter.getLagFraction())
      m.meter.update(0.2) ' past the 0.6s hold: drains 0.1
      m.assertTrue(m.meter.getLagFraction() < 1.0)
      for i = 1 to 20
        m.meter.update(0.2)
      end for
      m.assertEqual(0.5, m.meter.getLagFraction())
    end function

    @it("a new hit restarts the hold")
    function _()
      m.meter.lagEnabled = true
      m.meter.setValue(0.8)
      m.meter.update(0.5)
      m.meter.setValue(0.6)
      m.meter.update(0.5)
      m.assertEqual(1.0, m.meter.getLagFraction())
    end function

    @it("resetValue() skips the lag chunk, and healing pulls it up")
    function _()
      m.meter.lagEnabled = true
      m.meter.resetValue(0.3)
      m.assertEqual(0.3, m.meter.getLagFraction())
      m.meter.setValue(0.9)
      m.assertEqual(0.9, m.meter.getLagFraction())
    end function

    @describe("blink")

    @it("refuse() blinks for refuseSeconds")
    function _()
      m.assertFalse(m.meter.isBlinkOn())
      m.meter.refuse()
      m.assertTrue(m.meter.isBlinkOn())
      m.meter.update(1.0)
      m.assertFalse(m.meter.isBlinkOn())
    end function

    @it("blinks while empty when blinkWhenEmpty is set")
    function _()
      m.meter.blinkWhenEmpty = true
      m.meter.setValue(0)
      m.assertTrue(m.meter.isBlinkOn())
      m.meter.update(0.1) ' half a blink at 5/s
      m.assertFalse(m.meter.isBlinkOn())
    end function

    @describe("draw")

    @it("draws with a label, layers, lag and blink without throwing")
    function _()
      m.meter.label = "Boss"
      m.meter.labelAlign = "center"
      m.meter.lagEnabled = true
      m.meter.setLayer("shield", 0.9, &h3060FFFF)
      m.meter.setValue(0.4)
      m.meter.refuse()
      m.meter.draw()
      m.meter.removeLayer("shield")
      m.meter.drawAt(m.game.uiCanvas.renderer, 10, 10, 50, 5)
      m.assertTrue(true)
    end function

  end class
end namespace
