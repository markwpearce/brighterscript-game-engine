import "pkg:/source/engine/ui/BackgroundImageLoader.bs"

namespace tests
  @suite("BGE.UI.BackgroundImageLoader")
  class BackgroundImageLoaderTest extends rooibos.BaseTestSuite

    @describe("isNinePatchPath")

    @it("is true for a path ending in .9.png")
    function _()
      m.assertTrue(BGE.UI.isNinePatchPath("pkg:/images/button.9.png"))
    end function

    @it("is case-insensitive")
    function _()
      m.assertTrue(BGE.UI.isNinePatchPath("pkg:/images/button.9.PNG"))
    end function

    @it("is false for a plain .png path")
    function _()
      m.assertFalse(BGE.UI.isNinePatchPath("pkg:/images/button.png"))
    end function

    @it("is false for a path shorter than the suffix")
    function _()
      m.assertFalse(BGE.UI.isNinePatchPath(".9.pn"))
    end function

    @describe("loadBackgroundImage")

    @it("returns invalid (not a crash) for a .9.png path that fails to load")
    function _()
      m.assertInvalid(BGE.UI.loadBackgroundImage("pkg:/does/not/exist.9.png"))
    end function

    @it("returns invalid (not a crash) for a plain-image path that fails to load")
    function _()
      m.assertInvalid(BGE.UI.loadBackgroundImage("pkg:/does/not/exist.png"))
    end function

  end class
end namespace
