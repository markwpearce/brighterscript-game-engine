import "pkg:/source/engine/ui/MenuList.bs"
import "pkg:/source/engine/ui/UiContainer.bs"
import "pkg:/source/engine/GameScene.bs"
import "pkg:/source/engine/Game.bs"

namespace tests
  @suite("BGE.UI.MenuList")
  class MenuListTests extends rooibos.BaseTestSuite

    game as BGE.Game
    parent as BGE.UI.UiContainer

    protected override function beforeEach()
      m.game = new BGE.Game(640, 480)
      m.parent = new BGE.UI.UiContainer(m.game)
      m.parent.width = 640
      m.parent.height = 480
    end function

    private function newMenu() as BGE.UI.MenuList
      menu = new BGE.UI.MenuList(m.game)
      menu.addItem("continue", "Continue")
      menu.addItem("new", "New Game")
      menu.addItem("credits", "Credits")
      return menu
    end function

    @describe("open / close")

    @it("open() builds one button per item and adds the panel to the parent")
    function _()
      menu = m.newMenu()
      menu.open(m.parent)
      m.assertEqual(1, m.parent.childCount())
      m.assertEqual(3, menu.buttons.count())
      m.assertEqual("new", menu.buttons[1].actionId)
      m.assertEqual("New Game", menu.buttons[1].getLabel())
      m.assertTrue(menu.isOpen())
    end function

    @it("close() removes the panel and unregisters its buttons")
    function _()
      menu = m.newMenu()
      menu.open(m.parent)
      menu.close()
      m.assertEqual(0, m.parent.childCount())
      m.assertEqual(0, m.game.focusManager.registeredCount())
      m.assertEqual(0, menu.buttons.count())
      m.assertFalse(menu.isOpen())
    end function

    @it("reopening doesn't stack a second set of buttons")
    function _()
      menu = m.newMenu()
      menu.open(m.parent)
      menu.open(m.parent)
      m.assertEqual(1, m.parent.childCount())
      m.assertEqual(3, m.game.focusManager.registeredCount())
    end function

    @it("open() with no parent is owned by the current scene and goes when it changes")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      sceneB = new BGE.GameScene(m.game, {name: "SceneB"})
      m.game.defineScene(sceneA)
      m.game.defineScene(sceneB)
      m.game.changeScene("SceneA")
      before = m.game.gameUi.childCount()
      menu = m.newMenu()
      menu.open()
      m.assertEqual(before + 1, m.game.gameUi.childCount())

      m.game.End()
      m.game.changeScene("SceneB")

      m.assertEqual(before, m.game.gameUi.childCount())
      m.assertFalse(menu.isOpen())
      m.assertEqual(0, m.game.focusManager.registeredCount())
    end function

    @it("close() on a scene-owned menu removes it from the scene")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      m.game.defineScene(sceneA)
      m.game.changeScene("SceneA")
      menu = m.newMenu()
      menu.open()
      menu.close()
      m.assertEqual(0, sceneA.uiCount())
    end function

    @describe("focus")

    @it("open() focuses the first enabled item")
    function _()
      menu = new BGE.UI.MenuList(m.game)
      menu.addItem("continue", "Continue", false)
      menu.addItem("new", "New Game")
      menu.open(m.parent)
      m.assertFalse(menu.buttons[0].focused)
      m.assertTrue(menu.buttons[1].focused)
    end function

    @it("disabled items aren't registered for focus")
    function _()
      menu = new BGE.UI.MenuList(m.game)
      menu.addItem("continue", "Continue", false)
      menu.addItem("new", "New Game")
      menu.open(m.parent)
      m.assertEqual(1, m.game.focusManager.registeredCount())
      m.assertTrue(menu.buttons[0].disabled)
    end function

    @it("focusItem() focuses an item by id")
    function _()
      menu = m.newMenu()
      menu.open(m.parent)
      m.assertTrue(menu.focusItem("credits"))
      m.assertTrue(menu.buttons[2].focused)
      m.assertFalse(menu.focusItem("missing"))
    end function

    @it("setItemEnabled() updates an open menu's button")
    function _()
      menu = m.newMenu()
      menu.open(m.parent)
      menu.setItemEnabled("new", false)
      m.assertTrue(menu.getButton("new").disabled)
      m.assertFalse(menu.items[1].enabled)
    end function

    @describe("listener")

    @it("a picked item reports its id and value to the listener")
    function _()
      listener = new RecordingMenuListener()
      menu = new BGE.UI.MenuList(m.game)
      menu.listener = listener
      menu.addItem("pick", "Pick me", true, 7)
      menu.open(m.parent)

      menu.buttons[0].onClick()

      m.assertEqual("pick", listener.lastActionId)
      m.assertEqual(7, listener.lastValue)
    end function

    @describe("layout")

    @it("fits its height to the title, message and items")
    function _()
      menu = m.newMenu()
      menu.open(m.parent)
      withoutText = menu.height
      menu.close()
      menu.title = "Title"
      menu.message = "A message"
      menu.open(m.parent)
      m.assertTrue(menu.height > withoutText)
      m.assertTrue(menu.buttons[0].customY > menu.panelPadding)
    end function

    @it("grows a fixed height that's too small for its content")
    function _()
      menu = m.newMenu()
      menu.setSize(300, 40)
      menu.open(m.parent)
      last = menu.buttons[2]
      m.assertTrue(menu.height >= last.customY + last.height + menu.panelPadding)
    end function

    @it("keeps a fixed height that's taller than its content")
    function _()
      menu = m.newMenu()
      menu.setSize(300, 470)
      menu.open(m.parent)
      m.assertEqual(470.0, menu.height)
    end function

    @it("keeps a width set before the first open")
    function _()
      menu = m.newMenu()
      menu.width = 400
      menu.open(m.parent)
      menu.open(m.parent)
      m.assertEqual(400.0, menu.width)
    end function

    @it("uses a width set after the first open on the next open")
    function _()
      menu = m.newMenu()
      menu.open(m.parent)
      menu.width = 420
      menu.open(m.parent)
      m.assertEqual(420.0, menu.width)
    end function

    @it("a fitted width is recomputed on each open")
    function _()
      menu = new BGE.UI.MenuList(m.game)
      menu.minWidth = 0
      menu.addItem("a", "A")
      menu.open(m.parent)
      narrow = menu.width
      menu.addItem("b", "A much much longer label than the first")
      menu.open(m.parent)
      m.assertTrue(menu.width > narrow)
    end function

    @it("centered menus are centered on the parent")
    function _()
      menu = m.newMenu()
      menu.width = 300
      menu.centered = true
      menu.open(m.parent)
      m.assertEqual(170.0, menu.customX)
      m.assertEqual((480.0 - menu.height) / 2.0, menu.customY)
    end function

    @it("draw() doesn't throw, with or without a theme panel image")
    function _()
      menu = m.newMenu()
      menu.title = "Title"
      menu.message = "Message"
      menu.open(m.parent)
      m.parent.draw()
      bmp = CreateObject("roBitmap", {width: 24, height: 24, AlphaEnable: true})
      m.game.defaultTheme.panelBackgroundImage = new BGE.UI.NinePatchImage(bmp, 6, 6, 6, 6)
      m.parent.draw()
      m.assertTrue(true)
    end function

    @it("setMessage() on an open menu updates the label")
    function _()
      menu = m.newMenu()
      menu.message = "Hello"
      menu.open(m.parent)
      menu.setMessage("Not enough coins")
      m.assertEqual("Not enough coins", menu.message)
    end function

  end class

  class RecordingMenuListener
    lastActionId as string = ""
    lastValue as dynamic = invalid

    sub onUiAction(actionId as string, button as BGE.UI.Button)
      m.lastActionId = actionId
      m.lastValue = button.value
    end sub
  end class
end namespace
