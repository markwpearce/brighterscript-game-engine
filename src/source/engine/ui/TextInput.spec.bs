namespace tests

  @suite("BGE.UI.TextInput")
  class TextInputTests extends rooibos.BaseTestSuite

    game as BGE.Game
    input as BGE.UI.TextInput

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.input = new BGE.UI.TextInput(m.game)
    end function

    @describe("defaults")

    @it("constructs focusable with empty text")
    function _()
      m.assertTrue(m.input.focusable)
      m.assertEqual("", m.input.text)
      m.assertEqual(0, m.input.cursorIndex)
    end function

    @it("getValue returns the current text")
    function _()
      m.input.text = "hello"
      m.assertEqual("hello", m.input.getValue())
    end function

  end class

end namespace
