import "pkg:/source/engine/ui/MessagePanel.bs"
import "pkg:/source/engine/ui/UiContainer.bs"
import "pkg:/source/engine/Game.bs"

namespace tests
  @suite("BGE.UI.MessagePanel")
  class MessagePanelTest extends rooibos.BaseTestSuite

    game as BGE.Game
    parent as BGE.UI.UiContainer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      registry = CreateObject("roFontRegistry")
      m.game.fonts["heading"] = registry.GetDefaultFont(28, false, false)
      m.game.fonts["body"] = registry.GetDefaultFont(20, false, false)
      m.parent = new BGE.UI.UiContainer(m.game)
    end function

    @describe("showing and hiding")

    @it("show() adds itself, with the requested title, message, and button labels, to the parent")
    function _()
      buttons = [new BGE.UI.MessagePanelButton("Resume", sub(button as BGE.UI.Button)
      end sub)]
      panel = new BGE.UI.MessagePanel(m.game, 200.0, 100.0, buttons, "Paused")
      panel.show(m.parent, 320.0, 240.0)
      m.assertEqual(m.parent.childCount(), 1)
    end function

    @it("hide() removes itself (and its buttons) from the parent entirely")
    function _()
      buttons = [new BGE.UI.MessagePanelButton("Resume", invalid)]
      panel = new BGE.UI.MessagePanel(m.game, 200.0, 100.0, buttons, "Paused")
      panel.show(m.parent, 320.0, 240.0)
      panel.hide(m.parent)
      m.assertEqual(m.parent.childCount(), 0)
    end function

    @describe("button activation")

    @it("a button's onActivate fires when the button is clicked")
    function _()
      ' BrightScript function literals don't close over enclosing locals (confirmed here:
      ' a local `flag` var referenced from this callback fails to compile at all,
      ' cannot-find-name - same lesson Button.spec.bs's "calls onActivate when set" test
      ' already documents), and `m` inside the callback is bound to the callback itself,
      ' not this suite - so record the call on the actual Button widget the callback
      ' receives instead (Button.onClick() invokes onActivate(m), i.e. the button itself),
      ' via dynamic array-style field access to dodge BGE.UI.Button's static field list.
      onActivate = sub(button as BGE.UI.Button)
        button["activated"] = true
      end sub
      buttons = [new BGE.UI.MessagePanelButton("Resume", onActivate)]
      panel = new BGE.UI.MessagePanel(m.game, 200.0, 100.0, buttons, "Paused")
      panel.show(m.parent, 320.0, 240.0)
      panel.buttonWidgets[0].onClick()
      m.assertTrue(panel.buttonWidgets[0]["activated"] = true)
    end function

    @describe("positioning")

    @it("centers itself within the given bounds")
    function _()
      buttons = [new BGE.UI.MessagePanelButton("Resume", invalid)]
      panel = new BGE.UI.MessagePanel(m.game, 200.0, 100.0, buttons)
      panel.show(m.parent, 320.0, 240.0)
      m.assertEqual(panel.customX, (320.0 - 200.0) / 2.0)
      m.assertEqual(panel.customY, (240.0 - 100.0) / 2.0)
    end function

    @describe("font fallback")

    @it("falls back to the 'default' font for the title when no 'heading' font is registered")
    sub _()
      gameWithoutHeadingFont = new BGE.Game(320, 240)
      parentWithoutHeadingFont = new BGE.UI.UiContainer(gameWithoutHeadingFont)
      buttons = [new BGE.UI.MessagePanelButton("Resume", invalid)]
      panel = new BGE.UI.MessagePanel(gameWithoutHeadingFont, 200.0, 100.0, buttons, "Paused")
      panel.show(parentWithoutHeadingFont, 320.0, 240.0)
      ' Private titleLabel isn't accessible from this spec class, so assert indirectly:
      ' buildChildren()'s title branch measures the title via headingFont.GetOneLineWidth()
      ' before ever adding the title container as a child - if the "heading"->"default"
      ' fallback didn't work, that measurement call would have crashed and this panel
      ' would have only 1 child (the button) instead of 2 (title container + button).
      m.assertEqual(panel.childCount(), 2)
    end sub
  end class
end namespace
