namespace BGE.UI

  ' How BGE.UI.FocusManager moves focus on directional input.
  enum FocusNavigationMode
    ' Default: discrete list navigation, like a typical menu - Up/Down/Left/
    ' Right step currentlyFocused to the next/previous registered widget, no
    ' spatial cursor or hit-testing involved.
    list = "list"
    ' Opt-in: a virtual pixel cursor (cursorPosition) moves by cursorStep and
    ' is hit-tested against widget bounds each frame - see FocusManager.
    pointer = "pointer"
  end enum

  class UiContainer extends BGE.UI.UiWidget

    backgroundRGBA as integer = BGE.RGBAtoRGBA(128, 128, 128, 0.8) ' RGBA value for the background of the window/container
    showBackground as boolean = true ' Should the background be drawn?

    protected children as UiWidget[] = []

    ' This container's own theme override. When invalid, effectiveTheme()
    ' falls back to m.game.defaultTheme.
    theme as BGE.UI.Theme

    ' Does this container register its focusable children with the shared
    ' BGE.UI.FocusManager (Game.focusManager)? gameUi wants this (issue
    ' #133); debugUi opts out (set to false by Game.bs) since debug UI
    ' should be non-blocking and never capture input away from gameplay
    ' entities - its widgets, if any, would just never be focusable, and it
    ' still gets onInput()'s plain broadcast like any other GameEntity.
    ' Focus is global (issue #178): every focusEnabled container anywhere in
    ' the tree shares the same one focused widget, via Game.focusManager
    ' (driven once per frame by Game.processFocusManagerInput() - not
    ' per-container) - not tracked per-container.
    focusEnabled as boolean = true

    sub new(game as BGE.Game)
      super(game)
    end sub


    ' Method for handling any actions needed when this is removed from view
    ' Clears all children
    override sub onRemove()
      m.clearChildren()
    end sub


    sub addChild(element as UiWidget)
      if element <> invalid
        m.children.push(element)
        element.parentContainer = m
        if element.focusable and m.focusEnabled
          m.game.focusManager.register(element)
        end if
      end if
    end sub

    ' Gets the number of children currently added to this container
    '
    ' @return {integer}
    function childCount() as integer
      return m.children.count()
    end function

    sub removeChild(element as UiWidget)
      indexToRemove = -1
      if invalid = element
        return
      end if

      for i = 0 to m.children.count() - 1
        if m.children[i].id = element.id
          indexToRemove = i
          exit for
        end if
      end for
      if indexToRemove >= 0 and invalid <> m.children[indexToRemove]
        m.children[indexToRemove].onDestroy()
        m.children.delete(indexToRemove)
      end if

      if element.focusable and m.focusEnabled
        m.game.focusManager.unregister(element)
      end if
    end sub

    sub clearChildren()
      for each element in m.children
        element.onDestroy()
        if element.focusable and m.focusEnabled
          m.game.focusManager.unregister(element)
        end if
      end for
      m.children.clear()
    end sub


    ' Method for handling any updates based on time since previous frame
    ' Calls same method in all children.
    ' Also resets the shared FocusManager's input-consumption latch - safe to
    ' call redundantly from every container's onUpdate() (idempotent).
    '
    ' @param {float} deltaTime - milliseconds since last frame
    override sub onUpdate(deltaTime as float)
      m.game.focusManager.resetFrame()
      for each child in m.children
        if child <> invalid
          child.onUpdate(deltaTime)
        end if
      end for
    end sub

    ' Set the canvas this UIWidget Draws to
    ' Sets the canvas on all children
    '
    ' @param {BGE.Canvas} [canvas=invalid] The canvas this should draw to - if invalid, then will draw to the game canvas
    override sub setCanvas(canvas = invalid as BGE.Canvas)
      super.setCanvas(canvas)
      if invalid <> m.children
        for each child in m.children
          if child <> invalid
            child.setCanvas(m.canvas)
          end if
        end for
      end if
    end sub

    ' Method called each frame to draw any images of this entity
    '
    override sub draw(parent = invalid as UiWidget)
      if m.showBackground
        m.canvas.renderer.drawRectangle(m.position.x, m.position.y, m.width, m.height, m.backgroundRGBA)
      end if
      m.children.sortBy("zIndex")
      for each child in m.children
        if invalid <> child and child.enabled
          child.repositionBasedOnParent(m)
          child.draw(m)
        end if
      end for
      ' The focus cursor is global (one indicator, not one per container) -
      ' drawn once by Game.drawUI() via FocusManager.draw(), not here.
    end sub


    ' Function to get the value of the UIContainer, which will be an object of all the values of the children
    '
    ' @return {roAssociativeArray} - the value of this element
    override sub getValue() as roAssociativeArray
      value = {}
      for each child in m.children
        value.addReplace(child.name, child.getValue())
      end for
      return value
    end sub

    ' The theme this container's widgets should pull colors/fonts from:
    ' this container's own m.theme if set, else the game's defaultTheme.
    '
    ' @return {BGE.UI.Theme}
    function effectiveTheme() as BGE.UI.Theme
      if m.theme <> invalid
        return m.theme
      end if
      return m.game.defaultTheme
    end function

    override function isContainer() as boolean
      return true
    end function

    ' Method to process input per frame. Broadcasts to every child
    ' unconditionally (same as every other GameEntity notification method on
    ' this class, e.g. onAudioEvent()/onGameEvent()) - a plain, non-focusable
    ' widget added to a container still gets notified of every input this
    ' way, and a nested UiContainer child gets it too, running its own
    ' broadcast in turn.
    ' Focus itself is driven separately, once per frame, by
    ' Game.processFocusManagerInput() calling BGE.UI.FocusManager.update()
    ' directly - not from here. Doing it here instead (once per
    ' focusEnabled container reached by this same broadcast) would call
    ' update() more than once for one event whenever containers nest,
    ' double-firing the one globally-focused widget's dispatch.
    '
    ' @param {BGE.GameInput} input - GameInput object for the last frame
    override sub onInput(input as BGE.GameInput)
      for each child in m.children
        if child <> invalid
          child.onInput(input)
        end if
      end for
    end sub


    ' Method to process an ECP keyboard event
    ' @see  https://developer.roku.com/en-ca/docs/developer-program/debugging/external-control-api.md
    ' Calls same method in all children
    '
    ' @param {integer} char
    override sub onECPKeyboard(char as integer)
      for each child in m.children
        child.onECPKeyboard(char)
      end for
    end sub


    ' Method to process an External Control Protocol event
    ' @see  https://developer.roku.com/en-ca/docs/references/brightscript/events/roinputevent.md
    ' Calls same method in all children
    '
    ' @param data
    override sub onECPInput(data as roInputEvent)
      for each child in m.children
        child.onECPInput(data)
      end for
    end sub


    ' Method to handle audio events
    ' @see  https://developer.roku.com/en-ca/docs/references/brightscript/events/roaudioplayerevent.md
    ' Calls same method in all children
    '
    ' @param msg - roAudioPlayerEvent
    override sub onAudioEvent(msg as roAudioPlayerEvent)
      for each child in m.children
        child.onAudioEvent(msg)
      end for
    end sub


    ' Called when the game pauses
    ' Calls same method in all children
    '
    override sub onPause()
      for each child in m.children
        child.onPause()
      end for
    end sub


    ' Called when the game unpauses
    ' Calls same method in all children
    '
    ' @param {integer} pauseTimeMs - The number of milliseconds the game was paused
    override sub onResume(pauseTimeMs as integer)
      for each child in m.children
        child.onResume(pauseTimeMs)
      end for
    end sub


    ' Called on url event
    ' @see  https://developer.roku.com/en-ca/docs/references/brightscript/events/rourlevent.md
    ' Calls same method in all children
    '
    ' @param msg - roUrlEvent
    override sub onUrlEvent(msg as roUrlEvent)
      for each child in m.children
        child.onUrlEvent(msg)
      end for
    end sub


    ' General purpose event handler for in-game events.
    ' Calls same method in all children
    '
    ' @param {string} eventName - Event name that describes the event type
    ' @param data - Any extra data to go along with the event
    override sub onGameEvent(eventName as string, data as roAssociativeArray)
      for each child in m.children
        child.onGameEvent(eventName, data)
      end for
    end sub



    ' Method called when the current room changes.
    ' This method is only called when the entity is marked as `persistant`,
    ' otherwise entities are destroyed on room changes.
    ' Calls same method in all children
    '
    ' @param {Room} newRoom - The next room
    override sub onChangeRoom(newRoom as BGE.Room)
      for each child in m.children
        child.onChangeRoom(newRoom)
      end for
    end sub


    ' Method called when this entity is destroyed
    '
    override sub onDestroy()
      m.clearChildren()
    end sub

  end class

  ' Owns the single, global focused-widget/cursor state shared by every
  ' UiContainer that opts in (UiContainer.focusEnabled) - one Game instance
  ' owns one FocusManager (Game.focusManager). Widget positions are already
  ' absolute UI-canvas coordinates (each level of UiContainer.draw() adds its
  ' own parent's position - see UiWidget.getWorldPosition()), so one shared
  ' cursor/hit-test naturally spans nested containers with no translation.
  ' Kept in this file rather than its own (despite the size) - a pre-existing
  ' file referencing a brand-new one hits a bslint/rooibos-roku toolchain bug
  ' (cannot-find-name), see CLAUDE.md/project memory on this.
  class FocusManager

    protected game as BGE.Game

    ' How directional input moves focus - see BGE.UI.FocusNavigationMode.
    ' Defaults to list (discrete next/previous, like a typical menu); a game
    ' opts into pointer (spatial cursor) explicitly.
    navigationMode as BGE.UI.FocusNavigationMode = BGE.UI.FocusNavigationMode.list

    ' list mode only: does moving past the last (or first) registered widget
    ' wrap around to the other end? Off by default - most menus stop at the
    ' ends rather than cycling.
    wrapFocus as boolean = false

    ' Every focusable widget registered across every focusEnabled container
    ' (gameUi and any of its focusEnabled descendants) - flat, in register()
    ' order. In list mode this order IS the navigation order; in pointer mode
    ' it's used only to seed initial focus and as the hit-test target.
    protected focusOrder as UiWidget[] = []

    ' list mode only: index of currentlyFocused within focusOrder, or -1
    ' before anything is focused.
    protected currentlyFocusedIndex as integer = -1

    ' pointer mode only: virtual cursor position, in UI-canvas coordinate
    ' space. Moved by directional input; hit-tested against focusOrder each
    ' frame to drive hover/focus (cursor-primary - hovering a widget focuses
    ' it).
    cursorPosition as BGE.Math.Vector = BGE.Math.VectorZero()
    ' pointer mode only: pixels the cursor moves per press/held-frame.
    cursorStep as float = 16.0

    protected currentlyFocused as BGE.UI.UiWidget

    protected hasSeededFocus as boolean = false

    ' Latched true as soon as anything consumes during a frame, and reset
    ' once per frame (see resetFrame()). Game.bs dispatches more than one
    ' event per frame (a press, plus a synthesized held event while the
    ' button stays down) - without this latch a later, unconsumed event
    ' would undo an earlier one's input capture.
    protected consumedThisFrame as boolean = false

    ' Throttles repeat-while-held navigation to one step per
    ' WIDGET_REPEAT_DELAY_MS, the same way Slider/Select throttle their own
    ' adjustment - shared between list and pointer mode since only one mode
    ' is ever active at a time.
    protected repeatThrottle as BGE.UI.RepeatThrottle = new BGE.UI.RepeatThrottle()

    sub new(game as BGE.Game)
      m.game = game
    end sub

    ' Registers a focusable widget - called by UiContainer.addChild().
    '
    ' @param {UiWidget} widget
    ' @return {void}
    sub register(widget as UiWidget)
      m.focusOrder.push(widget)
    end sub

    ' How many focusable widgets are currently registered.
    '
    ' @return {integer}
    function registeredCount() as integer
      return m.focusOrder.count()
    end function

    ' The widget registered at the given index, in register() order.
    '
    ' @param {integer} index
    ' @return {UiWidget}
    function getRegistered(index as integer) as UiWidget
      return m.focusOrder[index]
    end function

    ' Unregisters a focusable widget - called by UiContainer.removeChild().
    '
    ' @param {UiWidget} widget
    ' @return {void}
    sub unregister(widget as UiWidget)
      wasFocused = m.currentlyFocused <> invalid and m.currentlyFocused.id = widget.id
      for i = m.focusOrder.count() - 1 to 0 step -1
        if m.focusOrder[i].id = widget.id
          m.focusOrder.delete(i)
          ' list mode: currentlyFocusedIndex is a plain index into focusOrder,
          ' so removing anything before it shifts every later index down by
          ' one - without this, navigation desyncs from the visible list
          ' (e.g. Down silently doing nothing, or landing on the wrong widget).
          if not wasFocused and i < m.currentlyFocusedIndex
            m.currentlyFocusedIndex--
          end if
        end if
      end for
      if wasFocused
        ' Removed while focused - don't leave currentlyFocused/currentlyFocusedIndex
        ' pointing at a widget no longer in the registry. Re-seed on the next
        ' update() instead of guessing a replacement.
        m.currentlyFocused = invalid
        m.currentlyFocusedIndex = -1
        m.hasSeededFocus = false
      end if
    end sub

    ' Top-of-frame reset of the input-consumption latch. Safe to call more
    ' than once per frame (every focusEnabled UiContainer's onUpdate() calls
    ' this) since resetting to false twice is a no-op.
    '
    ' @return {void}
    sub resetFrame()
      m.consumedThisFrame = false
    end sub

    ' Drives the focus side of input handling for the whole shared registry.
    ' First seeds/updates currentlyFocused for whatever this frame's state
    ' is (list mode: seeds index 0 once; pointer mode: hit-tests the cursor
    ' each call - see seedList()/seedAndHitTestPointer()) - this happens
    ' before dispatch, so hover/focus state is current for this frame. Then
    ' gives the focused widget first refusal on the event - OK press
    ' dispatches onMouseDown()/onClick() and consumes; OK release dispatches
    ' onMouseUp() only (does NOT consume - a release is never a discrete
    ' "act on this" event, so it's free to also reach GameEntity.onInput());
    ' anything else forwards to the widget's own handleInput() (see
    ' UiWidget.handleInput()). Only if the widget did NOT report the event as
    ' handled does focus itself move (navigateList()/navigatePointer()) -
    ' otherwise the same Left/Right that adjusted a focused Slider would also
    ' walk focus away from it. If anything along the way calls
    ' input.consume(), Game.setInputEntity() captures all input for the rest
    ' of this frame - see GameInput.consume(). "Rest of this frame" is
    ' latched in m.consumedThisFrame (see resetFrame()).
    '
    ' Called exactly once per input event by Game.processFocusManagerInput() -
    ' not from UiContainer.onInput(), so nesting focusEnabled containers can't
    ' cause this to double-fire for one event (e.g. two onClick() calls for
    ' one OK press).
    '
    ' @param {BGE.GameInput} input - GameInput object for the last frame
    ' @return {void}
    sub update(input as BGE.GameInput)
      isPointer = m.navigationMode = BGE.UI.FocusNavigationMode.pointer
      if isPointer
        m.seedAndHitTestPointer()
      else
        m.seedList()
      end if

      handled = false
      if m.currentlyFocused <> invalid
        if input.press and input.isButton("ok")
          m.currentlyFocused.onMouseDown()
          if m.currentlyFocused <> invalid and m.currentlyFocused.isValid()
            m.currentlyFocused.onClick()
          end if
          input.consume()
          handled = true
        else if input.release and input.isButton("ok")
          m.currentlyFocused.onMouseUp()
          handled = true
        else
          handled = m.currentlyFocused.handleInput(input)
        end if
      end if

      if input.consumed
        m.consumedThisFrame = true
      end if

      if not handled and not m.consumedThisFrame and (input.x <> 0 or input.y <> 0)
        if isPointer
          m.navigatePointer(input)
        else
          m.navigateList(input)
        end if
      end if

      if m.consumedThisFrame
        m.game.setInputEntity(m.game.gameUi)
      else
        m.game.unsetInputEntity()
      end if
    end sub

    ' list mode: establishes currentlyFocused on the very first call
    ' (focusOrder[0]) and leaves it alone otherwise - actual movement is
    ' navigateList().
    '
    ' @return {void}
    private sub seedList()
      if not m.hasSeededFocus and m.focusOrder.count() > 0
        m.focusTo(0)
        m.hasSeededFocus = true
      end if
    end sub

    ' list mode: steps currentlyFocused to the next/previous registered
    ' widget on Left/Right/Up/Down - "down"/"right" advance, "up"/"left" go
    ' back - throttled the same way Slider/Select throttle their own repeat
    ' (WIDGET_REPEAT_DELAY_MS), so a single tap moves exactly one item.
    ' Movement stops at either end unless wrapFocus is true.
    '
    ' @param {BGE.GameInput} input
    ' @return {void}
    private sub navigateList(input as BGE.GameInput)
      if m.focusOrder.count() = 0
        return
      end if

      if not m.repeatThrottle.shouldAct(input)
        return
      end if

      delta = 0
      if input.y <> 0
        delta = -input.y ' up (y=1) -> previous; down (y=-1) -> next
      else if input.x <> 0
        delta = input.x ' right (x=1) -> next; left (x=-1) -> previous
      end if

      newIndex = m.currentlyFocusedIndex + delta
      count = m.focusOrder.count()
      if m.wrapFocus
        newIndex = ((newIndex mod count) + count) mod count
      else
        newIndex = BGE.Math.Clamp(newIndex, 0, count - 1)
      end if

      if newIndex <> m.currentlyFocusedIndex
        m.focusTo(newIndex)
      end if
    end sub

    ' Focuses focusOrder[index] directly (list mode), blurring whatever was
    ' focused before.
    '
    ' @param {integer} index
    ' @return {void}
    private sub focusTo(index as integer)
      if m.currentlyFocused <> invalid
        m.currentlyFocused.focused = false
        m.currentlyFocused.onBlur()
      end if
      m.currentlyFocused = m.focusOrder[index]
      m.currentlyFocusedIndex = index
      m.currentlyFocused.focused = true
      m.currentlyFocused.onFocus()
    end sub

    ' pointer mode: seeds m.cursorPosition on the very first call, then
    ' hit-tests it against focusOrder, updating hovered/focused state and
    ' firing onMouseOver/onMouseOut/onFocus/onBlur for whatever changed -
    ' actual cursor movement is navigatePointer().
    '
    ' @return {void}
    private sub seedAndHitTestPointer()
      if not m.hasSeededFocus and m.focusOrder.count() > 0
        seed = m.focusOrder[0]
        ' draw() is what normally positions a widget, cascading down from the
        ' root container (repositionBasedOnParent()) - reposition the whole
        ' ancestor chain explicitly here too, in case the first-ever update()
        ' call happens before the first draw() (e.g. input on the very first
        ' frame), so seeding doesn't read a stale/default position. A single-
        ' level reposition against just seed.parentContainer isn't enough if
        ' that parent is itself nested and hasn't been positioned yet.
        m.repositionAncestorChain(seed)
        m.cursorPosition = BGE.Math.VectorOps.create(seed.position.x + seed.width / 2, seed.position.y + seed.height / 2, 0)
        m.hasSeededFocus = true
      end if

      m.updateHoverAndFocus()
    end sub

    ' Repositions widget and every UiContainer ancestor above it, root-first,
    ' via repositionBasedOnParent() - the same computation draw() normally
    ' cascades top-down, but callable before any draw() has ever run. See
    ' seedAndHitTestPointer().
    '
    ' @param {UiWidget} widget
    ' @return {void}
    private sub repositionAncestorChain(widget as UiWidget)
      chain = [widget]
      current = widget.parentContainer
      while current <> invalid
        chain.Unshift(current)
        current = current.parentContainer
      end while

      parent = invalid
      for each node in chain
        node.repositionBasedOnParent(parent)
        parent = node
      end for
    end sub

    ' pointer mode: moves m.cursorPosition by cursorStep in the input
    ' direction, throttled the same way Slider/Select throttle their own
    ' repeat (WIDGET_REPEAT_DELAY_MS) so a single tap moves it only once.
    '
    ' @param {BGE.GameInput} input
    ' @return {void}
    private sub navigatePointer(input as BGE.GameInput)
      if not m.repeatThrottle.shouldAct(input)
        return
      end if

      m.cursorPosition.x += input.x * m.cursorStep
      m.cursorPosition.y -= input.y * m.cursorStep ' input.y is world-space (+up); cursor space is screen-space (+down)
    end sub

    ' Hit-tests m.cursorPosition against focusOrder, updating hovered/focused
    ' state and firing onMouseOver/onMouseOut/onFocus/onBlur for whatever
    ' changed. At most one widget is hovered/focused at a time, globally.
    ' pointer mode only.
    '
    private sub updateHoverAndFocus()
      hit = invalid as BGE.UI.UiWidget
      for each widget in m.focusOrder
        if widget.containsPoint(m.cursorPosition)
          hit = widget
          exit for
        end if
      end for

      if m.currentlyFocused <> invalid and (hit = invalid or hit.id <> m.currentlyFocused.id)
        m.currentlyFocused.hovered = false
        m.currentlyFocused.focused = false
        m.currentlyFocused.onMouseOut()
        m.currentlyFocused.onBlur()
        m.currentlyFocused = invalid
      end if

      if hit <> invalid and m.currentlyFocused = invalid
        hit.hovered = true
        hit.focused = true
        hit.onMouseOver()
        hit.onFocus()
        m.currentlyFocused = hit
      end if
    end sub

    ' Draws the single global cursor indicator. pointer mode only - list
    ' mode has no spatial cursor (widgets self-render their own focus ring
    ' off m.focused, e.g. Button/Slider/Select/Checkbox.draw()). Called once
    ' per frame by Game.drawUI(), not per-container.
    '
    ' @param {BGE.Canvas} canvas
    ' @param {BGE.UI.Theme} theme
    ' @return {void}
    sub draw(canvas as BGE.Canvas, theme as BGE.UI.Theme)
      if m.navigationMode <> BGE.UI.FocusNavigationMode.pointer or m.focusOrder.count() = 0
        return
      end if
      canvas.renderer.drawRectangle(m.cursorPosition.x - theme.cursorSize / 2, m.cursorPosition.y - theme.cursorSize / 2, theme.cursorSize, theme.cursorSize, theme.cursorColor)
    end sub

  end class
end namespace
