import "UiWidget.bs"
import "../Game.bs"
import "../renderer/Renderer.bs"
import "../../math/math.bs"
import "../../utils/colors.bs"

namespace BGE.UI

  ' A line of text centered on a dark band across the screen that fades in, holds and fades
  ' out - for "Boss defeated", level names and the like. show() it; it hides itself.
  '
  ' Add it to gameUi (it draws across the whole UI canvas, `centerY` of the way down), or call
  ' update() and drawOn() yourself.
  '
  ' @example
  ' banner = new BGE.UI.Banner(game)
  ' game.gameUi.addChild(banner)
  ' banner.show("The Crypt", 3)
  class Banner extends BGE.UI.UiWidget

    textColor as integer = &hE8C060FF
    ' The band's color at full opacity.
    bandColor as integer = &h000000A0
    ' Font key ("heading", falling back to "default").
    fontName as string = "heading"
    fadeInSeconds as float = 0.5
    fadeOutSeconds as float = 1.0
    ' The band's middle, as a fraction of the canvas height.
    centerY as float = 0.5
    ' The band's height in text lines.
    bandLines as float = 2.0

    private text as string = ""
    private totalSeconds as float = 0
    private secondsLeft as float = 0

    sub new(game as BGE.Game)
      super(game)
    end sub

    ' Shows `text` for `seconds` in all, fades included. Replaces any banner showing.
    '
    ' @param {string} text
    ' @param {float} [seconds=3]
    sub show(text as string, seconds = 3.0 as float)
      m.text = text
      m.totalSeconds = seconds
      m.secondsLeft = seconds
    end sub

    ' Hides the banner at once.
    sub hide()
      m.secondsLeft = 0
    end sub

    ' Is a banner showing?
    '
    ' @return {boolean}
    function isShowing() as boolean
      return m.secondsLeft > 0
    end function

    ' The text shown last.
    '
    ' @return {string}
    function getText() as string
      return m.text
    end function

    ' How opaque the banner is now, 0 to 1.
    '
    ' @return {float}
    function getOpacity() as float
      if m.secondsLeft <= 0
        return 0.0
      end if
      shown = m.totalSeconds - m.secondsLeft
      fadeIn = 1.0
      if m.fadeInSeconds > 0
        fadeIn = shown / m.fadeInSeconds
      end if
      fadeOut = 1.0
      if m.fadeOutSeconds > 0
        fadeOut = m.secondsLeft / m.fadeOutSeconds
      end if
      return BGE.Math.Clamp(BGE.Math.Min(fadeIn, fadeOut), 0, 1)
    end function

    ' Counts the banner down. Called for you when it's in gameUi.
    '
    ' @param {float} dt - seconds
    sub update(dt as float)
      if m.secondsLeft > 0
        m.secondsLeft = BGE.Math.Max(0, m.secondsLeft - dt)
      end if
    end sub

    override sub onUpdate(deltaTime as float)
      m.update(deltaTime)
    end sub

    override sub draw(parent = invalid as UiWidget)
      m.drawOn(m.canvas.renderer)
    end sub

    ' Draws the banner across `renderer`'s canvas.
    '
    ' @param {BGE.Renderer} renderer
    sub drawOn(renderer as BGE.Renderer)
      opacity = m.getOpacity()
      if opacity <= 0
        return
      end if
      font = m.game.getFontOr(m.fontName)
      center = renderer.getCanvasCenter()
      middle = center.y * 2 * m.centerY
      lineHeight = font.GetOneLineHeight()
      bandHeight = lineHeight * m.bandLines
      renderer.drawRectangle(0, middle - bandHeight / 2, center.x * 2, bandHeight, BGE.colorOpacity(m.bandColor, opacity))
      renderer.drawText(m.text, center.x, middle - lineHeight / 2, BGE.colorOpacity(m.textColor, opacity), font, "center")
    end sub

  end class

end namespace
