namespace BGE.UI

  ' One item in a BGE.UI.MenuList.
  class MenuItem
    ' Passed to the listener as the button's `actionId`.
    id as string = ""
    label as string = ""
    ' A disabled item is shown dimmed and can't be focused or picked.
    enabled as boolean = true
    ' Copied to the button's `value`.
    value as dynamic = invalid
    ' Copied to the button's `onActivate`.
    onActivate as function or dynamic = invalid

    sub new(id as string, label as string, enabled = true as boolean, value = invalid as dynamic)
      m.id = id
      m.label = label
      m.enabled = enabled
      m.value = value
    end sub
  end class

end namespace
