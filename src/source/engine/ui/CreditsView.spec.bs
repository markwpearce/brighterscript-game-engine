import "pkg:/source/engine/ui/CreditsView.bs"
import "pkg:/source/engine/Game.bs"

namespace tests
  @suite("BGE.UI.CreditsView")
  class CreditsViewTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(640, 480)
    end function

    private function newView() as BGE.UI.CreditsView
      return new BGE.UI.CreditsView(m.game, [
        {text: "My Game", style: "title"},
        {text: ""},
        {text: "Code", style: "heading"},
        {text: "Somebody"}
      ])
    end function

    @describe("layout")

    @it("fills the title-safe area by default")
    function _()
      view = m.newView()
      m.assertEqual(m.game.uiCanvas.getWidth() * 0.1, view.customX)
      m.assertEqual(m.game.uiCanvas.getWidth() * 0.8, view.width)
    end function

    @it("wraps entries into rows coloured by style, with a half-line for a blank")
    function _()
      view = m.newView()
      rows = view.getRows()
      m.assertEqual(4, rows.count())
      m.assertEqual(view.styleColors["title"], rows[0].color)
      m.assertEqual(view.styleColors["body"], rows[3].color)
      m.assertEqual(rows[3].height / 2, rows[1].height)
    end function

    @it("wraps a long line to the view's width")
    function _()
      view = new BGE.UI.CreditsView(m.game, [{text: "word word word word word word word word word word word word"}])
      view.width = 100
      m.assertTrue(view.getRows().count() > 1)
    end function

    @describe("scrolling")

    @it("scrolls at scrollSpeed, faster with setFast(), and finishes")
    function _()
      view = m.newView()
      view.onUpdate(1.0)
      m.assertEqual(40.0, view.getScroll())
      view.setFast(true)
      view.onUpdate(1.0)
      m.assertEqual(200.0, view.getScroll())
      m.assertFalse(view.isFinished())
      for i = 1 to 10
        view.onUpdate(1.0)
      end for
      m.assertTrue(view.isFinished())
    end function

    @it("skip() finishes it")
    function _()
      view = m.newView()
      view.skip()
      m.assertTrue(view.isFinished())
    end function

    @it("a static view doesn't scroll and finishes when skipped")
    function _()
      view = m.newView()
      view.mode = "static"
      view.onUpdate(1.0)
      m.assertEqual(0.0, view.getScroll())
      m.assertFalse(view.isFinished())
      view.skip()
      m.assertTrue(view.isFinished())
    end function

    @it("draws in both modes without throwing")
    function _()
      view = m.newView()
      view.backgroundRGBA = &h000000C0
      view.onUpdate(5.0)
      view.draw()
      view.mode = "static"
      view.textAlign = "left"
      view.setEntries(view.getRows())
      view.draw()
      m.assertTrue(true)
    end function

  end class
end namespace
