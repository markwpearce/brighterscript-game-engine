import "../Game.bs"
import "../../utils/strings.bs"
import "Button.bs"
import "UiWidget.bs"

namespace BGE.UI

  ' A button drawn as a line of text, with no background: a marker in front of it while
  ' focused, and a color for focused, normal and disabled. Good for text-style menus and
  ' dialogue choices (BGE.Story.DialogueView's "list" layout). It's still a Button, so focus,
  ' clicks, `listener` and setDisabled() work as usual - subclass and override draw() for
  ' your own look.
  class TextButton extends BGE.UI.Button

    ' Drawn before the label while focused; the label is always indented by its width.
    marker as string = "> "
    textColor as integer = &hD8D0C0FF
    focusedColor as integer = &hF0C860FF
    disabledColor as integer = &h707070FF
    ' invalid = the "body" font, else "default".
    font as roFont = invalid

    sub new(game as BGE.Game)
      super(game)
    end sub

    override sub draw(parent = invalid as UiWidget)
      font = m.font
      if font = invalid
        font = m.game.getFontOr("body")
      end if
      color = m.textColor
      if m.disabled
        color = m.disabledColor
      else if m.focused or m.hovered
        color = m.focusedColor
      end if
      renderer = m.canvas.renderer
      y = m.position.y + (m.height - font.GetOneLineHeight()) / 2
      if m.focused and not m.disabled
        renderer.drawText(m.marker, m.position.x, y, color, font, "left")
      end if
      x = m.position.x + font.GetOneLineWidth(m.marker, BGE.TEXT_MAX_LINE_SIZE)
      renderer.drawText(m.getLabel(), x, y, color, font, "left")
    end sub

  end class

end namespace
