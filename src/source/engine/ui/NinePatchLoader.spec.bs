import "pkg:/source/engine/ui/NinePatchLoader.bs"
import "pkg:/source/testing/PixelReadback.spec.bs"

namespace tests
  @suite("BGE.UI.NinePatchLoader")
  class NinePatchLoaderTest extends rooibos.BaseTestSuite

    bmp as roBitmap

    protected override function beforeEach()
      m.bmp = CreateObject("roBitmap", {width: 20, height: 20, AlphaEnable: true})
      m.bmp.Clear(&h00000000) ' fully transparent
      ' Interior artwork (doesn't matter for this test - just needs a non-transparent fill so it's visually distinguishable from the border)
      m.bmp.DrawRect(1, 1, 18, 18, &hFFFFFFFF)
      ' Top border stretch-region marker: x=5..14, y=0
      m.bmp.DrawRect(5, 0, 10, 1, &h000000FF)
      ' Left border stretch-region marker: x=0, y=5..14
      m.bmp.DrawRect(0, 5, 1, 10, &h000000FF)
      m.bmp.Finish()
      ' engine code reads its pixels, which a device only can from a loaded bitmap
      m.bmp = tests.loadedCopy(m.bmp)
    end function

    @describe("getNinePatchFallbackPath")

    @it("maps a .9.png path to a tmp: path without the .9.png suffix")
    function _()
      m.assertEqual("tmp:/bge-9patch-pkg_images_panel.png", BGE.UI.getNinePatchFallbackPath("pkg:/images/panel.9.png"))
    end function

    @it("keeps different source paths apart")
    function _()
      m.assertNotEqual(BGE.UI.getNinePatchFallbackPath("pkg:/a/panel.9.png"), BGE.UI.getNinePatchFallbackPath("pkg:/b/panel.9.png"))
    end function

    @it("matches the suffix case-insensitively")
    function _()
      m.assertEqual("tmp:/bge-9patch-pkg_PANEL.png", BGE.UI.getNinePatchFallbackPath("pkg:/PANEL.9.PNG"))
    end function

    @it("returns an empty string for a path that isn't a .9.png")
    function _()
      m.assertEqual("", BGE.UI.getNinePatchFallbackPath("pkg:/images/panel.png"))
      m.assertEqual("", BGE.UI.getNinePatchFallbackPath("pkg:/images/panel.9.jpg"))
    end function

    @describe("parseNinePatchBitmap")

    @it("parses the top/left border markers into left/top/right/bottom insets")
    function _()
      np = BGE.UI.parseNinePatchBitmap(m.bmp)
      m.assertEqual(4, np.getLeft())
      m.assertEqual(4, np.getTop())
      m.assertEqual(4, np.getRight())
      m.assertEqual(4, np.getBottom())
    end function

    @it("defaults to 0 insets on an axis with no marker pixels")
    function _()
      bmp = CreateObject("roBitmap", {width: 10, height: 10, AlphaEnable: true})
      bmp.Clear(&h00000000)
      bmp.DrawRect(1, 1, 8, 8, &hFFFFFFFF)
      bmp.Finish() ' no border markers at all

      np = BGE.UI.parseNinePatchBitmap(tests.loadedCopy(bmp))
      m.assertEqual(0, np.getLeft())
      m.assertEqual(0, np.getTop())
      m.assertEqual(0, np.getRight())
      m.assertEqual(0, np.getBottom())
    end function

  end class
end namespace
