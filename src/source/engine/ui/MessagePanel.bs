import "MenuList.bs"
import "Button.bs"
import "UiContainer.bs"
import "../Game.bs"

namespace BGE.UI

  ' One button spec for MessagePanel: a label plus the same onActivate callback shape
  ' BGE.UI.Button itself uses (function(button as BGE.UI.Button) as void). Give it an
  ' `actionId` to report the click to the panel's `listener` instead.
  class MessagePanelButton
    label as string
    onActivate as function or dynamic
    actionId as string = ""

    sub new(label as string, onActivate = invalid as function or dynamic, actionId = "" as string)
      m.label = label
      m.onActivate = onActivate
      m.actionId = actionId
    end sub
  end class

  ' A centered modal panel (heading, message, a column of buttons) for pause menus,
  ' win/game-over screens and similar: a BGE.UI.MenuList that centers itself on show().
  '
  ' show() builds the panel's children fresh and focuses the first button; hide() removes
  ' the panel, so its buttons aren't focusable while it's hidden. Pass 0 for the width or
  ' height to fit the content. Colors come from the theme (`panelBackgroundColor`,
  ' `panelTitleColor`, `panelTextColor`), unless `backgroundRGBA` is set.
  class MessagePanel extends BGE.UI.MenuList

    ' The button specs given to the constructor, top to bottom.
    buttonSpecs as BGE.UI.MessagePanelButton[] = []
    ' The BGE.UI.Button widgets built from `buttonSpecs`, in the same order - only valid
    ' while shown.
    buttonWidgets as BGE.UI.Button[] = []

    ' @param game
    ' @param {float} panelWidth - 0 fits the content
    ' @param {float} panelHeight - 0 fits the content
    ' @param {BGE.UI.MessagePanelButton[]} buttons - shown top to bottom
    ' @param [title=""] - optional heading, drawn in the "heading" font
    ' @param [message=""] - optional body text below the heading
    sub new(game as BGE.Game, panelWidth as float, panelHeight as float, buttons as BGE.UI.MessagePanelButton[], title = "" as string, message = "" as string)
      super(game)
      m.centered = true
      m.title = title
      m.message = message
      m.buttonSpecs = buttons
      m.setSize(panelWidth, panelHeight)
      if panelWidth > 0
        m.itemWidth = panelWidth * 0.76
      end if
    end sub

    ' Centers this panel within a `withinWidth` x `withinHeight` area (typically the UI
    ' canvas size), builds it, adds it to `parent` and focuses the first button. Showing an
    ' open panel rebuilds it.
    '
    ' @param {BGE.UI.UiContainer} parent
    ' @param {float} [withinWidth=0] - 0 centers on the parent (the UI canvas for gameUi)
    ' @param {float} [withinHeight=0]
    sub show(parent as BGE.UI.UiContainer, withinWidth = 0 as float, withinHeight = 0 as float)
      m.clearItems()
      for each spec in m.buttonSpecs
        item = m.addItem(spec.actionId, spec.label)
        item.onActivate = spec.onActivate
      end for
      m.centered = withinWidth <= 0 or withinHeight <= 0
      m.open(parent)
      if not m.centered
        m.customX = (withinWidth - m.width) / 2.0
        m.customY = (withinHeight - m.height) / 2.0
      end if
      m.buttonWidgets = m.buttons
    end sub

    ' Removes this panel (and its buttons) from its parent. show() again to reopen.
    '
    ' @param {BGE.UI.UiContainer} [parent=invalid] - unused; kept for older callers
    sub hide(parent = invalid as BGE.UI.UiContainer)
      m.close()
      m.buttonWidgets = []
    end sub

  end class

end namespace
