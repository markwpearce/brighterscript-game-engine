import "pkg:/source/engine/ui/Banner.bs"
import "pkg:/source/engine/Game.bs"

namespace tests
  @suite("BGE.UI.Banner")
  class BannerTests extends rooibos.BaseTestSuite

    game as BGE.Game
    banner as BGE.UI.Banner

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.banner = new BGE.UI.Banner(m.game)
    end function

    @describe("show")

    @it("isn't showing until show() is called")
    function _()
      m.assertFalse(m.banner.isShowing())
      m.assertEqual(0.0, m.banner.getOpacity())
    end function

    @it("fades in, holds and fades out over the given time")
    function _()
      m.banner.show("Level 1", 3)
      m.assertTrue(m.banner.isShowing())
      m.assertEqual(0.0, m.banner.getOpacity())
      m.banner.update(0.25)
      m.assertEqual(0.5, m.banner.getOpacity())
      m.banner.update(1.0)
      m.assertEqual(1.0, m.banner.getOpacity())
      m.banner.update(1.25) ' 0.5s left of a 1s fade out
      m.assertEqual(0.5, m.banner.getOpacity())
      m.banner.update(1.0)
      m.assertFalse(m.banner.isShowing())
    end function

    @it("hide() hides it at once")
    function _()
      m.banner.show("Level 1")
      m.banner.hide()
      m.assertFalse(m.banner.isShowing())
    end function

    @it("draws without throwing")
    function _()
      m.banner.show("Boss defeated", 2)
      m.banner.update(0.6)
      m.banner.draw()
      m.assertEqual("Boss defeated", m.banner.getText())
    end function

  end class
end namespace
