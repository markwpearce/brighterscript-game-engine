import "NinePatchLoader.bs"
import "ImageBackground.bs"

namespace BGE.UI

  ' Filename suffix marking a 9-patch source asset, matching Android's own
  ' `.9.png` naming convention (see NinePatchLoader's own doc comment for the
  ' pixel-format side of that convention). Checked case-insensitively.
  const NINE_PATCH_FILENAME_SUFFIX = ".9.png"

  ' Loads an image at `path` for use as Theme.backgroundImage, picking
  ' between a stretchable BGE.UI.NinePatchImage and a plain
  ' BGE.UI.ImageBackground automatically: a path ending in ".9.png"
  ' (case-insensitive), Android's own naming convention for this asset
  ' format, loads as a 9-patch (see loadNinePatchImage()); any other path
  ' loads as a plain image, stretched to fill entirely with no unstretched
  ' corners. Returns invalid if the image at `path` could not be loaded.
  '
  ' @param {string} path - a pkg:/ path to a background image, ".9.png"-suffixed for a 9-patch
  ' @return {BGE.UI.NinePatchImage or BGE.UI.ImageBackground}
  function loadBackgroundImage(path as string) as dynamic
    if BGE.UI.isNinePatchPath(path)
      return loadNinePatchImage(path)
    end if

    bitmap = loadBitmapOrLog(path, "background image")
    if invalid = bitmap
      return invalid
    end if
    return new BGE.UI.ImageBackground(bitmap)
  end function

  ' @param {string} path
  ' @return {boolean} - true if `path` ends in ".9.png", case-insensitive
  function isNinePatchPath(path as string) as boolean
    suffixLength = Len(BGE.UI.NINE_PATCH_FILENAME_SUFFIX)
    if path.Len() < suffixLength
      return false
    end if
    return LCase(path.Right(suffixLength)) = BGE.UI.NINE_PATCH_FILENAME_SUFFIX
  end function

end namespace
