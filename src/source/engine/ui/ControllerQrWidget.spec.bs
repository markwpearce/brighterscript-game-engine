import "pkg:/source/engine/ui/ControllerQrWidget.bs"
import "pkg:/source/engine/Game.bs"

namespace tests
  @suite("BGE.UI.ControllerQrWidget")
  class ControllerQrWidgetTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(640, 480)
    end function

    @describe("layout")

    @it("rounds the code down to whole pixels per module")
    function _()
      qr = new BGE.UI.ControllerQrWidget(m.game, "http://192.168.1.2:8080", 250)
      size = qr.getQrSize()
      m.assertTrue(size <= 250)
      m.assertTrue(size > 200)
      m.assertEqual(0, Int(size) mod 25) ' version 2: 25 modules
    end function

    @it("fits its width to the code and its height to the code and text")
    function _()
      qr = new BGE.UI.ControllerQrWidget(m.game, "http://192.168.1.2:8080", 200)
      m.assertEqual(qr.getQrSize() + qr.contentPadding * 2, qr.width)
      m.assertTrue(qr.height > qr.getQrSize() + qr.contentPadding * 2)
    end function

    @it("draws nothing but text with no URL (controller input off)")
    function _()
      qr = new BGE.UI.ControllerQrWidget(m.game)
      m.assertEqual("", qr.getUrl())
      m.assertEqual(0.0, qr.getQrSize())
      qr.draw()
      m.assertTrue(true)
    end function

    @it("setUrl() and setWidth() re-lay it out and it draws")
    function _()
      qr = new BGE.UI.ControllerQrWidget(m.game)
      qr.setUrl("http://10.0.0.5:8080")
      qr.setWidth(400)
      m.assertEqual(400.0, qr.width)
      qr.backgroundRGBA = &h000000CC
      qr.draw()
      m.assertEqual("http://10.0.0.5:8080", qr.getUrl())
    end function

  end class
end namespace
