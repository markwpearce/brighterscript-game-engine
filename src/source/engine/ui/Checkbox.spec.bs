import "pkg:/source/engine/ui/NinePatchImage.bs"

namespace tests

  @suite("BGE.UI.Checkbox")
  class CheckboxTests extends rooibos.BaseTestSuite

    game as BGE.Game
    checkbox as BGE.UI.Checkbox

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.checkbox = new BGE.UI.Checkbox(m.game)
    end function

    @describe("defaults")

    @it("is focusable and unchecked by default")
    function _()
      m.assertTrue(m.checkbox.focusable)
      m.assertFalse(m.checkbox.checked)
      m.assertFalse(m.checkbox.getValue())
    end function

    @it("has non-zero default width/height, so it is hit-testable without being sized")
    function _()
      m.assertTrue(m.checkbox.width > 0)
      m.assertTrue(m.checkbox.height > 0)
      m.assertTrue(m.checkbox.containsPoint(m.checkbox.position))
    end function

    @describe("onClick")

    @it("toggles checked from false to true")
    function _()
      m.checkbox.onClick()
      m.assertTrue(m.checkbox.getValue())
    end function

    @it("toggles checked from true to false")
    function _()
      m.checkbox.checked = true
      m.checkbox.onClick()
      m.assertFalse(m.checkbox.getValue())
    end function

    @it("calls onChanged with the new value")
    function _()
      m.checkbox.lastChangedValue = invalid
      m.checkbox.onChanged = sub(checkbox as BGE.UI.Checkbox)
        checkbox.lastChangedValue = checkbox.getValue()
      end sub

      m.checkbox.onClick()

      m.assertTrue(m.checkbox.lastChangedValue)
    end function

    @describe("draw")

    @it("draw() does not throw with the default flat-color theme")
    function _()
      m.checkbox.draw() ' should not throw
      m.assertTrue(true)
    end function

    @it("draw() does not throw when theme.backgroundImage is set")
    function _()
      bmp = CreateObject("roBitmap", {width: 24, height: 24, AlphaEnable: true})
      bmp.Clear(&hFFFFFFFF)
      m.game.defaultTheme.backgroundImage = new BGE.UI.NinePatchImage(bmp, 6, 6, 6, 6)

      m.checkbox.draw() ' should not throw
      m.assertTrue(true)
    end function

    @describe("theme font application")

    @it("applies a container theme's custom font to its drawableText on the first draw()")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      customTheme = new BGE.UI.Theme()
      customTheme.font = m.game.getFont("debugUi") ' distinct roFont from the default font (different size)
      container.theme = customTheme

      m.checkbox.setLabel("Hi")
      m.checkbox.draw(container)

      ' Comparing two roFont instances with `=` (even cast `as object`) is a
      ' runtime Type Mismatch crash in BrightScript - identity is asserted
      ' via a scalar proxy (line height, which differs between the two
      ' distinctly-sized fonts) instead.
      m.assertEqual(customTheme.font.GetOneLineHeight(), m.checkbox.drawableText.font.GetOneLineHeight())
    end function

    @it("leaves the default font untouched when no container theme font is set")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      defaultFontHeight = m.checkbox.drawableText.font.GetOneLineHeight()

      m.checkbox.setLabel("Hi")
      m.checkbox.draw(container)

      m.assertEqual(defaultFontHeight, m.checkbox.drawableText.font.GetOneLineHeight())
    end function

  end class

end namespace
