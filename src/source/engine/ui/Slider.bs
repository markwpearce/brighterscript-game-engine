namespace BGE.UI

  ' A horizontal value picker: a label, a filled bar, and a numeric readout.
  ' Adjust with increase()/decrease() (step-sized) or set an exact value with setValue().
  class Slider extends UiWidget

    minValue as float = 0.0
    maxValue as float = 100.0
    step as float = 1.0

    protected value as float = 0.0

    barColor = BGE.Colors.White
    backgroundColor = BGE.Colors.Gray

    drawableText as BGE.DrawableText

    sub new(game as BGE.Game)
      super(game)
      m.drawableText = new BGE.DrawableText(m)
    end sub


    ' Sets a label to show alongside the value (e.g. "Volume")
    '
    ' @param {string} text
    ' @return {void}
    sub setLabel(text as string)
      m.drawableText.text = text
    end sub


    ' Gets the slider's current value
    '
    ' @return {float}
    override function getValue() as float
      return m.value
    end function


    ' Sets the slider's value, clamped to [minValue, maxValue]
    '
    ' @param {float} newValue
    ' @return {void}
    sub setValue(newValue as float)
      m.value = BGE.Math.Clamp(newValue, m.minValue, m.maxValue)
    end sub


    ' Increases the value by step (or a given amount), clamped to maxValue
    '
    ' @param {float} [amount=invalid] - defaults to m.step
    ' @return {void}
    sub increase(amount = invalid as dynamic)
      if invalid = amount
        amount = m.step
      end if
      m.setValue(m.value + amount)
    end sub


    ' Decreases the value by step (or a given amount), clamped to minValue
    '
    ' @param {float} [amount=invalid] - defaults to m.step
    ' @return {void}
    sub decrease(amount = invalid as dynamic)
      if invalid = amount
        amount = m.step
      end if
      m.setValue(m.value - amount)
    end sub


    override sub draw(parent = invalid as UiWidget)
      if m.width <= 0 or m.height <= 0
        return
      end if

      percent = (m.value - m.minValue) / (m.maxValue - m.minValue)
      fillWidth = m.width * percent

      m.canvas.renderer.drawRectangle(m.position.x, m.position.y, m.width, m.height, m.backgroundColor)
      if fillWidth > 0
        m.canvas.renderer.drawRectangle(m.position.x, m.position.y, fillWidth, m.height, m.barColor)
      end if

      if invalid <> m.drawableText and m.drawableText.text <> ""
        textImage = m.drawableText.getTextImage()
        if textImage <> invalid
          m.canvas.renderer.drawTransformedObject(m.position.x, m.position.y - m.drawableText.getDrawnSize().height, 1.0, 1.0, 0, textImage)
        end if
      end if
    end sub

  end class

end namespace
