namespace tests

  @suite("BGE.UI.Label")
  class LabelTests extends rooibos.BaseTestSuite

    game as BGE.Game
    label as BGE.UI.Label

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.label = new BGE.UI.Label(m.game)
    end function

    @describe("draw")

    @it("draw() does not throw with the default theme")
    function _()
      m.label.setText("Hi")
      m.label.draw() ' should not throw
      m.assertTrue(true)
    end function

    @describe("theme font application")

    @it("applies a container theme's custom font to its drawableText on the first draw()")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      customTheme = new BGE.UI.Theme()
      customTheme.font = m.game.getFont("debugUi") ' distinct roFont from the default font (different size)
      container.theme = customTheme

      m.label.setText("Hi")
      m.label.draw(container)

      ' Comparing two roFont instances with `=` (even cast `as object`) is a
      ' runtime Type Mismatch crash in BrightScript, confirmed while writing
      ' this test - so identity is asserted via a scalar proxy (line height,
      ' which differs between the two distinctly-sized fonts) instead.
      m.assertEqual(customTheme.font.GetOneLineHeight(), m.label.drawableText.font.GetOneLineHeight())
    end function

    @it("leaves the default font untouched when no container theme font is set")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      defaultFontHeight = m.label.drawableText.font.GetOneLineHeight()

      m.label.setText("Hi")
      m.label.draw(container)

      m.assertEqual(defaultFontHeight, m.label.drawableText.font.GetOneLineHeight())
    end function

    @describe("wrapWidth")

    @it("wraps the text onto several lines when wrapWidth is set")
    function _()
      font = m.label.drawableText.font
      m.label.wrapWidth = font.GetOneLineWidth("hello world", 10000) + 1
      m.label.setText("hello world hello world")
      m.label.draw()
      m.assertEqual("hello world" + Chr(10) + "hello world", m.label.drawableText.text)
      m.assertEqual(font.GetOneLineHeight() * 2.0, m.label.height)
    end function

    @it("leaves text alone when wrapWidth is 0")
    function _()
      m.label.setText("hello world hello world")
      m.label.draw()
      m.assertEqual("hello world hello world", m.label.drawableText.text)
    end function

    @it("re-wraps the original text when wrapWidth changes")
    function _()
      font = m.label.drawableText.font
      m.label.wrapWidth = font.GetOneLineWidth("hello", 10000) + 1
      m.label.setText("hello world")
      m.label.draw()
      m.label.wrapWidth = 0
      m.label.draw()
      m.assertEqual("hello world", m.label.drawableText.text)
    end function

  end class

end namespace
