import "pkg:/source/engine/ui/NinePatchImage.bs"

namespace tests

  @suite("BGE.UI.Select")
  class SelectTests extends rooibos.BaseTestSuite

    game as BGE.Game
    select as BGE.UI.Select

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.select = new BGE.UI.Select(m.game)
      m.select.options = ["Easy", "Medium", "Hard"]
    end function

    @describe("defaults")

    @it("is focusable and starts at index 0")
    function _()
      m.assertTrue(m.select.focusable)
      m.assertEqual(0, m.select.selectedIndex)
      m.assertEqual("Easy", m.select.getValue())
    end function

    @describe("next/previous")

    @it("next advances to the next option")
    function _()
      m.select.next()
      m.assertEqual("Medium", m.select.getValue())
    end function

    @it("next wraps around from the last option to the first")
    function _()
      m.select.selectedIndex = 2
      m.select.next()
      m.assertEqual("Easy", m.select.getValue())
    end function

    @it("previous wraps around from the first option to the last")
    function _()
      m.select.previous()
      m.assertEqual("Hard", m.select.getValue())
    end function

    @describe("handleInput")

    @it("right press advances and consumes the input")
    function _()
      input = new BGE.GameInput(5, 0) ' right, press
      m.select.handleInput(input)
      m.assertEqual("Medium", m.select.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("left press goes back and consumes the input")
    function _()
      m.select.selectedIndex = 1
      input = new BGE.GameInput(4, 0) ' left, press
      m.select.handleInput(input)
      m.assertEqual("Easy", m.select.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("right held advances and consumes the input")
    function _()
      input = new BGE.GameInput(1005, 100) ' right, held (1000 + press code)
      m.select.handleInput(input)
      m.assertEqual("Medium", m.select.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("left held goes back and consumes the input")
    function _()
      m.select.selectedIndex = 1
      input = new BGE.GameInput(1004, 100) ' left, held (1000 + press code)
      m.select.handleInput(input)
      m.assertEqual("Easy", m.select.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("a press plus the same frame's held event cycles exactly once, consuming both")
    function _()
      ' Game.bs dispatches a press AND a synthesized held event (heldTimeMs ~0)
      ' in the same frame as every button press. Both must be consumed, but only
      ' one cycle may happen - with a 2-option list a double-step would look
      ' like nothing happened at all (the bug seen in examples/audio).
      press = new BGE.GameInput(5, 0) ' right, press
      held = new BGE.GameInput(1005, 0) ' same frame's synthesized held right

      m.select.handleInput(press)
      m.select.handleInput(held)

      m.assertEqual("Medium", m.select.getValue())
      m.assertTrue(press.consumed)
      m.assertTrue(held.consumed)
    end function

    @it("a held event past the repeat delay cycles again, so a sustained hold repeats")
    function _()
      m.select.handleInput(new BGE.GameInput(5, 0)) ' right press
      m.select.handleInput(new BGE.GameInput(1005, 0)) ' same-frame held - throttled
      lateHeld = new BGE.GameInput(1005, 500) ' held well past the repeat delay

      m.select.handleInput(lateHeld)

      m.assertEqual("Hard", m.select.getValue())
      m.assertTrue(lateHeld.consumed)
    end function

    @it("a two-option select advances on a single tap (press + same-frame held)")
    function _()
      m.select.options = ["Music", "Sound Effect"]
      m.select.selectedIndex = 0

      m.select.handleInput(new BGE.GameInput(5, 0)) ' right press
      m.select.handleInput(new BGE.GameInput(1005, 0)) ' same frame's held right

      m.assertEqual("Sound Effect", m.select.getValue())
    end function

    @it("does not consume a release event")
    function _()
      input = new BGE.GameInput(105, 0) ' right, release
      m.select.handleInput(input)
      m.assertEqual("Easy", m.select.getValue())
      m.assertFalse(input.consumed)
    end function

    @it("does not consume input it doesn't handle")
    function _()
      input = new BGE.GameInput(2, 0) ' up, press
      m.select.handleInput(input)
      m.assertFalse(input.consumed)
    end function

    @describe("onClick")

    @it("onClick does nothing in inline style (default)")
    function _()
      select = new BGE.UI.Select(m.game)
      select.onClick()
      m.assertEqual(false, select.expanded)
    end function

    @it("onClick expands in popup style and seeds highlightedIndex from selectedIndex")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.selectedIndex = 2
      select.onClick()
      m.assertEqual(true, select.expanded)
      m.assertEqual(2, select.highlightedIndex)
    end function

    @it("a second onClick commits highlightedIndex to selectedIndex, fires onChanged, and collapses")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.selectedIndex = 0
      select.lastChangedValue = invalid
      select.onChanged = sub(s as BGE.UI.Select)
        s.lastChangedValue = s.selectedIndex
      end sub

      select.onClick() ' expands, seeds highlightedIndex = 0
      select.highlightedIndex = 2
      select.onClick() ' commits

      m.assertEqual(2, select.selectedIndex)
      m.assertEqual(false, select.expanded)
      m.assertEqual(2, select.lastChangedValue)
    end function

    @describe("handlePopupInput (via handleInput)")

    @it("popup style: down moves highlightedIndex while expanded, without changing selectedIndex")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.expanded = true
      select.highlightedIndex = 0

      select.handleInput(new BGE.GameInput(3, 0)) ' down, press

      m.assertEqual(1, select.highlightedIndex)
      m.assertEqual(0, select.selectedIndex)
    end function

    @it("popup style: up moves highlightedIndex while expanded, without changing selectedIndex")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.expanded = true
      select.highlightedIndex = 2

      select.handleInput(new BGE.GameInput(2, 0)) ' up, press

      m.assertEqual(1, select.highlightedIndex)
      m.assertEqual(0, select.selectedIndex)
    end function

    @it("popup style: highlightedIndex clamps at the ends instead of wrapping")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.expanded = true
      select.highlightedIndex = 2

      select.handleInput(new BGE.GameInput(3, 0)) ' down, press

      m.assertEqual(2, select.highlightedIndex)
    end function

    @it("popup style: back cancels without changing selectedIndex, and collapses")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.selectedIndex = 0
      select.expanded = true
      select.highlightedIndex = 2

      handled = select.handleInput(new BGE.GameInput(0, 0)) ' back, press

      m.assertEqual(true, handled)
      m.assertEqual(0, select.selectedIndex)
      m.assertEqual(false, select.expanded)
    end function

    @it("popup style: left/right do nothing while collapsed (inline cycling disabled)")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.selectedIndex = 0

      handled = select.handleInput(new BGE.GameInput(5, 0)) ' right, press

      m.assertEqual(false, handled)
      m.assertEqual(0, select.selectedIndex)
    end function

    @it("popup style: left/right are consumed but inert while expanded, so focus can't walk off the open list")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.selectedIndex = 0
      select.expanded = true
      select.highlightedIndex = 1

      handled = select.handleInput(new BGE.GameInput(5, 0)) ' right, press

      m.assertEqual(true, handled)
      m.assertEqual(true, select.expanded)
      m.assertEqual(1, select.highlightedIndex)
      m.assertEqual(0, select.selectedIndex)

      handled = select.handleInput(new BGE.GameInput(4, 0)) ' left, press

      m.assertEqual(true, handled)
      m.assertEqual(true, select.expanded)
      m.assertEqual(1, select.highlightedIndex)
      m.assertEqual(0, select.selectedIndex)
    end function

    @describe("onBlur")

    @it("losing focus collapses an expanded popup")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.expanded = true
      select.highlightedIndex = 2

      select.onBlur()

      m.assertFalse(select.expanded)
    end function

    @describe("popup edge cases")

    @it("onClick does not expand a popup with no options")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = []

      select.onClick()

      m.assertFalse(select.expanded)
    end function

    @it("committing clamps a highlightedIndex left out of range by a replaced options array")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c", "d", "e"]
      select.expanded = true
      select.highlightedIndex = 4
      select.options = ["a", "b"]

      select.onClick()

      m.assertEqual(1, select.selectedIndex)
      m.assertEqual("b", select.getValue())
    end function

    @it("popup style: handleInput returns false when not expanded, so FocusManager falls back to focus navigation")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]

      handled = select.handleInput(new BGE.GameInput(3, 0)) ' down, press, not expanded

      m.assertEqual(false, handled)
    end function

    @describe("draw")

    @it("draw() does not throw with the default flat-color theme")
    function _()
      m.select.width = 80
      m.select.height = 30
      m.select.draw() ' should not throw
      m.assertTrue(true)
    end function

    @it("draw() does not throw when theme.backgroundImage is set")
    function _()
      bmp = CreateObject("roBitmap", {width: 24, height: 24, AlphaEnable: true})
      bmp.Clear(&hFFFFFFFF)
      m.game.defaultTheme.backgroundImage = new BGE.UI.NinePatchImage(bmp, 6, 6, 6, 6)

      m.select.width = 80
      m.select.height = 30
      m.select.draw() ' should not throw
      m.assertTrue(true)
    end function

    @describe("drawOverlay")

    @it("drawOverlay does not throw when collapsed or not popup style, and draws no rows")
    function _()
      select = new BGE.UI.Select(m.game)
      select.width = 80
      select.height = 30
      select.position = BGE.Math.VectorOps.create(0, 0)
      select.drawOverlay(m.game.uiCanvas, m.game.defaultTheme) ' style=inline
      m.assertEqual(0, select.lastDrawnRowCount)

      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.drawOverlay(m.game.uiCanvas, m.game.defaultTheme) ' not expanded
      m.assertEqual(0, select.lastDrawnRowCount)
    end function

    @it("drawOverlay draws one row per option when expanded")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.width = 80
      select.height = 30
      select.position = BGE.Math.VectorOps.create(0, 0)
      select.expanded = true

      select.drawOverlay(m.game.uiCanvas, m.game.defaultTheme)

      m.assertEqual(3, select.lastDrawnRowCount)
    end function

    @it("drawOverlay reuses one cached DrawableText per option across calls, instead of thrashing a single shared one")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.width = 80
      select.height = 30
      select.position = BGE.Math.VectorOps.create(0, 0)
      select.expanded = true

      select.drawOverlay(m.game.uiCanvas, m.game.defaultTheme)
      select.drawOverlay(m.game.uiCanvas, m.game.defaultTheme)

      ' Still exactly 3 - one per distinct option string, not growing with
      ' every call and not collapsed down to the single m.drawableText slot.
      m.assertEqual(3, select.getOptionTextDrawableCount())
    end function

    @it("drawOverlay prunes cached entries for strings no longer in options, instead of accumulating forever")
    function _()
      select = new BGE.UI.Select(m.game)
      select.style = BGE.UI.SelectStyle.popup
      select.options = ["a", "b", "c"]
      select.width = 80
      select.height = 30
      select.position = BGE.Math.VectorOps.create(0, 0)
      select.expanded = true

      select.drawOverlay(m.game.uiCanvas, m.game.defaultTheme)
      m.assertEqual(3, select.getOptionTextDrawableCount())

      ' Reassigned to an entirely different, smaller set of options - the
      ' cache should shrink to match, not keep the stale "a"/"b"/"c" entries.
      select.options = ["x", "y"]
      select.drawOverlay(m.game.uiCanvas, m.game.defaultTheme)

      m.assertEqual(2, select.getOptionTextDrawableCount())
    end function

  end class

end namespace
