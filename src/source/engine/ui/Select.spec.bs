namespace tests

  @suite("BGE.UI.Select")
  class SelectTests extends rooibos.BaseTestSuite

    game as BGE.Game
    select as BGE.UI.Select

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.select = new BGE.UI.Select(m.game)
      m.select.options = ["Easy", "Medium", "Hard"]
    end function

    @describe("defaults")

    @it("is focusable and starts at index 0")
    function _()
      m.assertTrue(m.select.focusable)
      m.assertEqual(0, m.select.selectedIndex)
      m.assertEqual("Easy", m.select.getValue())
    end function

    @describe("next/previous")

    @it("next advances to the next option")
    function _()
      m.select.next()
      m.assertEqual("Medium", m.select.getValue())
    end function

    @it("next wraps around from the last option to the first")
    function _()
      m.select.selectedIndex = 2
      m.select.next()
      m.assertEqual("Easy", m.select.getValue())
    end function

    @it("previous wraps around from the first option to the last")
    function _()
      m.select.previous()
      m.assertEqual("Hard", m.select.getValue())
    end function

    @describe("handleInput")

    @it("right press advances and consumes the input")
    function _()
      input = new BGE.GameInput(5, 0) ' right, press
      m.select.handleInput(input)
      m.assertEqual("Medium", m.select.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("left press goes back and consumes the input")
    function _()
      m.select.selectedIndex = 1
      input = new BGE.GameInput(4, 0) ' left, press
      m.select.handleInput(input)
      m.assertEqual("Easy", m.select.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("right held advances and consumes the input")
    function _()
      input = new BGE.GameInput(1005, 100) ' right, held (1000 + press code)
      m.select.handleInput(input)
      m.assertEqual("Medium", m.select.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("left held goes back and consumes the input")
    function _()
      m.select.selectedIndex = 1
      input = new BGE.GameInput(1004, 100) ' left, held (1000 + press code)
      m.select.handleInput(input)
      m.assertEqual("Easy", m.select.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("a press plus the same frame's held event cycles exactly once, consuming both")
    function _()
      ' Game.bs dispatches a press AND a synthesized held event (heldTimeMs ~0)
      ' in the same frame as every button press. Both must be consumed, but only
      ' one cycle may happen - with a 2-option list a double-step would look
      ' like nothing happened at all (the bug seen in examples/audio).
      press = new BGE.GameInput(5, 0) ' right, press
      held = new BGE.GameInput(1005, 0) ' same frame's synthesized held right

      m.select.handleInput(press)
      m.select.handleInput(held)

      m.assertEqual("Medium", m.select.getValue())
      m.assertTrue(press.consumed)
      m.assertTrue(held.consumed)
    end function

    @it("a held event past the repeat delay cycles again, so a sustained hold repeats")
    function _()
      m.select.handleInput(new BGE.GameInput(5, 0)) ' right press
      m.select.handleInput(new BGE.GameInput(1005, 0)) ' same-frame held - throttled
      lateHeld = new BGE.GameInput(1005, 500) ' held well past the repeat delay

      m.select.handleInput(lateHeld)

      m.assertEqual("Hard", m.select.getValue())
      m.assertTrue(lateHeld.consumed)
    end function

    @it("a two-option select advances on a single tap (press + same-frame held)")
    function _()
      m.select.options = ["Music", "Sound Effect"]
      m.select.selectedIndex = 0

      m.select.handleInput(new BGE.GameInput(5, 0)) ' right press
      m.select.handleInput(new BGE.GameInput(1005, 0)) ' same frame's held right

      m.assertEqual("Sound Effect", m.select.getValue())
    end function

    @it("does not consume a release event")
    function _()
      input = new BGE.GameInput(105, 0) ' right, release
      m.select.handleInput(input)
      m.assertEqual("Easy", m.select.getValue())
      m.assertFalse(input.consumed)
    end function

    @it("does not consume input it doesn't handle")
    function _()
      input = new BGE.GameInput(2, 0) ' up, press
      m.select.handleInput(input)
      m.assertFalse(input.consumed)
    end function

  end class

end namespace
