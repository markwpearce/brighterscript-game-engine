import "../renderer/Renderer.bs"

namespace BGE.UI

  ' A 9-patch ("scale-9") stretchable background image: a source bitmap is
  ' sliced once (at construction) into 9 roRegions - 4 corners (drawn at
  ' fixed size), 4 edges (stretched along one axis), and a center (stretched
  ' both axes) - so a single small source texture can back a background of
  ' any width/height without visibly stretching its corners. Assign to
  ' Theme.backgroundImage to opt a widget's background fill into this
  ' instead of a flat color - see Theme.backgroundImage's own doc comment.
  '
  ' Takes a roBitmap, not a roRegion: CreateObject("roRegion", ...) only
  ' accepts a roBitmap as its source, not another roRegion (confirmed via
  ' Roku's own component type data and an actual runtime Type Mismatch when
  ' a roRegion was tried) - so slicing has to start from the real bitmap.
  class NinePatchImage

    protected topLeft as roRegion
    protected topEdge as roRegion
    protected topRight as roRegion
    protected leftEdge as roRegion
    protected center as roRegion
    protected rightEdge as roRegion
    protected bottomLeft as roRegion
    protected bottomEdge as roRegion
    protected bottomRight as roRegion

    protected left as integer
    protected top as integer
    protected right as integer
    protected bottom as integer

    ' @param {roBitmap} sourceBitmap - the full source image
    ' @param {integer} left - px from the left edge that stay unstretched
    ' @param {integer} top - px from the top edge that stay unstretched
    ' @param {integer} right - px from the right edge that stay unstretched
    ' @param {integer} bottom - px from the bottom edge that stay unstretched
    sub new(sourceBitmap as roBitmap, left as integer, top as integer, right as integer, bottom as integer)
      m.left = left
      m.top = top
      m.right = right
      m.bottom = bottom

      srcW = sourceBitmap.GetWidth()
      srcH = sourceBitmap.GetHeight()
      midW = srcW - left - right
      midH = srcH - top - bottom

      m.topLeft = m.makeSlice(sourceBitmap, 0, 0, left, top)
      m.topEdge = m.makeSlice(sourceBitmap, left, 0, midW, top)
      m.topRight = m.makeSlice(sourceBitmap, srcW - right, 0, right, top)
      m.leftEdge = m.makeSlice(sourceBitmap, 0, top, left, midH)
      m.center = m.makeSlice(sourceBitmap, left, top, midW, midH)
      m.rightEdge = m.makeSlice(sourceBitmap, srcW - right, top, right, midH)
      m.bottomLeft = m.makeSlice(sourceBitmap, 0, srcH - bottom, left, bottom)
      m.bottomEdge = m.makeSlice(sourceBitmap, left, srcH - bottom, midW, bottom)
      m.bottomRight = m.makeSlice(sourceBitmap, srcW - right, srcH - bottom, right, bottom)
    end sub

    ' A zero-width/height inset (e.g. a source image with no marker on one axis)
    ' would make CreateObject("roRegion", ...) return Invalid, which drawObject()
    ' does not guard against - so such a slice is left invalid here and skipped
    ' by draw(). Alpha blending is off by default on a new region, and these are
    ' composited over whatever is already on the canvas, so enable it explicitly.
    private function makeSlice(sourceBitmap as roBitmap, x as integer, y as integer, w as integer, h as integer) as roRegion
      if w <= 0 or h <= 0
        return invalid
      end if
      region = CreateObject("roRegion", sourceBitmap, x, y, w, h)
      if region <> invalid
        region.SetAlphaEnable(true)
      end if
      return region
    end function

    ' Draws this 9-patch at (x, y) stretched to fill width x height. width/height
    ' must each be >= left+right / top+bottom respectively, or the edge/corner
    ' slices will overlap - same caveat as any 9-patch implementation.
    '
    ' @param {BGE.Renderer} renderer - the renderer to draw to
    ' @param {float} x - destination x
    ' @param {float} y - destination y
    ' @param {float} width - destination width
    ' @param {float} height - destination height
    sub draw(renderer as BGE.Renderer, x as float, y as float, width as float, height as float)
      midW = width - m.left - m.right
      midH = height - m.top - m.bottom

      ' A slice is invalid when its inset resolved to 0 - see makeSlice().
      if m.topLeft <> invalid
        renderer.drawObject(x, y, m.topLeft)
      end if
      if m.topEdge <> invalid
        renderer.drawScaledObject(x + m.left, y, midW / m.topEdge.GetWidth(), 1.0, m.topEdge)
      end if
      if m.topRight <> invalid
        renderer.drawObject(x + width - m.right, y, m.topRight)
      end if

      if m.leftEdge <> invalid
        renderer.drawScaledObject(x, y + m.top, 1.0, midH / m.leftEdge.GetHeight(), m.leftEdge)
      end if
      if m.center <> invalid
        renderer.drawScaledObject(x + m.left, y + m.top, midW / m.center.GetWidth(), midH / m.center.GetHeight(), m.center)
      end if
      if m.rightEdge <> invalid
        renderer.drawScaledObject(x + width - m.right, y + m.top, 1.0, midH / m.rightEdge.GetHeight(), m.rightEdge)
      end if

      if m.bottomLeft <> invalid
        renderer.drawObject(x, y + height - m.bottom, m.bottomLeft)
      end if
      if m.bottomEdge <> invalid
        renderer.drawScaledObject(x + m.left, y + height - m.bottom, midW / m.bottomEdge.GetWidth(), 1.0, m.bottomEdge)
      end if
      if m.bottomRight <> invalid
        renderer.drawObject(x + width - m.right, y + height - m.bottom, m.bottomRight)
      end if
    end sub

    ' Test-only accessors - not part of the public API surface, no JSDoc.
    function getTopLeft() as roRegion
      return m.topLeft
    end function

    function getCenter() as roRegion
      return m.center
    end function

    function getLeft() as integer
      return m.left
    end function

    function getTop() as integer
      return m.top
    end function

    function getRight() as integer
      return m.right
    end function

    function getBottom() as integer
      return m.bottom
    end function

  end class

end namespace
