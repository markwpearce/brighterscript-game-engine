namespace tests

  ' Constructs a real BGE.Game (UiWidget extends GameEntity) to exercise the
  ' value-clamping logic a Slider goes through as it's adjusted.
  @suite("BGE.UI.Slider")
  class SliderTests extends rooibos.BaseTestSuite

    game as BGE.Game
    slider as BGE.UI.Slider

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.slider = new BGE.UI.Slider(m.game)
    end function

    @describe("defaults")

    @it("starts at minValue 0, maxValue 100, step 1, value 0")
    function _()
      m.assertEqual(0.0, m.slider.minValue)
      m.assertEqual(100.0, m.slider.maxValue)
      m.assertEqual(1.0, m.slider.step)
      m.assertEqual(0.0, m.slider.getValue())
    end function

    @describe("setValue")

    @it("sets the value when within range")
    function _()
      m.slider.setValue(42)

      m.assertEqual(42.0, m.slider.getValue())
    end function

    @it("clamps a value above maxValue down to maxValue")
    function _()
      m.slider.setValue(500)

      m.assertEqual(100.0, m.slider.getValue())
    end function

    @it("clamps a value below minValue up to minValue")
    function _()
      m.slider.minValue = 10
      m.slider.setValue(-5)

      m.assertEqual(10.0, m.slider.getValue())
    end function

    @describe("increase")

    @it("increases the value by step")
    function _()
      m.slider.step = 5
      m.slider.setValue(10)
      m.slider.increase()

      m.assertEqual(15.0, m.slider.getValue())
    end function

    @it("clamps at maxValue")
    function _()
      m.slider.step = 5
      m.slider.setValue(98)
      m.slider.increase()

      m.assertEqual(100.0, m.slider.getValue())
    end function

    @describe("decrease")

    @it("decreases the value by step")
    function _()
      m.slider.step = 5
      m.slider.setValue(10)
      m.slider.decrease()

      m.assertEqual(5.0, m.slider.getValue())
    end function

    @it("clamps at minValue")
    function _()
      m.slider.step = 5
      m.slider.setValue(2)
      m.slider.decrease()

      m.assertEqual(0.0, m.slider.getValue())
    end function

  end class

end namespace
