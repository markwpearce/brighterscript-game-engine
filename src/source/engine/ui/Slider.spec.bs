import "pkg:/source/engine/ui/NinePatchImage.bs"

namespace tests

  ' Constructs a real BGE.Game (UiWidget extends GameEntity) to exercise the
  ' value-clamping logic a Slider goes through as it's adjusted.
  @suite("BGE.UI.Slider")
  class SliderTests extends rooibos.BaseTestSuite

    game as BGE.Game
    slider as BGE.UI.Slider

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.slider = new BGE.UI.Slider(m.game)
    end function

    @describe("defaults")

    @it("starts at minValue 0, maxValue 100, step 1, value 0")
    function _()
      m.assertEqual(0.0, m.slider.minValue)
      m.assertEqual(100.0, m.slider.maxValue)
      m.assertEqual(1.0, m.slider.step)
      m.assertEqual(0.0, m.slider.getValue())
    end function

    @describe("setValue")

    @it("sets the value when within range")
    function _()
      m.slider.setValue(42)

      m.assertEqual(42.0, m.slider.getValue())
    end function

    @it("clamps a value above maxValue down to maxValue")
    function _()
      m.slider.setValue(500)

      m.assertEqual(100.0, m.slider.getValue())
    end function

    @it("clamps a value below minValue up to minValue")
    function _()
      m.slider.minValue = 10
      m.slider.setValue(-5)

      m.assertEqual(10.0, m.slider.getValue())
    end function

    @describe("increase")

    @it("increases the value by step")
    function _()
      m.slider.step = 5
      m.slider.setValue(10)
      m.slider.increase()

      m.assertEqual(15.0, m.slider.getValue())
    end function

    @it("clamps at maxValue")
    function _()
      m.slider.step = 5
      m.slider.setValue(98)
      m.slider.increase()

      m.assertEqual(100.0, m.slider.getValue())
    end function

    @describe("decrease")

    @it("decreases the value by step")
    function _()
      m.slider.step = 5
      m.slider.setValue(10)
      m.slider.decrease()

      m.assertEqual(5.0, m.slider.getValue())
    end function

    @it("clamps at minValue")
    function _()
      m.slider.step = 5
      m.slider.setValue(2)
      m.slider.decrease()

      m.assertEqual(0.0, m.slider.getValue())
    end function

    @describe("focus")

    @it("is focusable by default")
    function _()
      m.assertTrue(m.slider.focusable)
    end function

    @describe("handleInput")

    @it("left press decreases the value and consumes the input")
    function _()
      m.slider.step = 5
      m.slider.setValue(10)
      input = new BGE.GameInput(4, 0) ' left, press

      m.slider.handleInput(input)

      m.assertEqual(5.0, m.slider.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("right press increases the value and consumes the input")
    function _()
      m.slider.step = 5
      m.slider.setValue(10)
      input = new BGE.GameInput(5, 0) ' right, press

      m.slider.handleInput(input)

      m.assertEqual(15.0, m.slider.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("left held decreases the value and consumes the input")
    function _()
      m.slider.step = 5
      m.slider.setValue(10)
      input = new BGE.GameInput(1004, 100) ' left, held (1000 + press code)

      m.slider.handleInput(input)

      m.assertEqual(5.0, m.slider.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("right held increases the value and consumes the input")
    function _()
      m.slider.step = 5
      m.slider.setValue(10)
      input = new BGE.GameInput(1005, 100) ' right, held (1000 + press code)

      m.slider.handleInput(input)

      m.assertEqual(15.0, m.slider.getValue())
      m.assertTrue(input.consumed)
    end function

    @it("a press plus the same frame's held event steps exactly once, consuming both")
    function _()
      ' Game.bs dispatches a press AND a synthesized held event (heldTimeMs ~0)
      ' in the same frame as every button press. Both must be consumed, but only
      ' one step may happen - otherwise a single tap double-steps.
      m.slider.step = 5
      m.slider.setValue(10)
      press = new BGE.GameInput(5, 0) ' right, press
      held = new BGE.GameInput(1005, 0) ' same frame's synthesized held right

      m.slider.handleInput(press)
      m.slider.handleInput(held)

      m.assertEqual(15.0, m.slider.getValue())
      m.assertTrue(press.consumed)
      m.assertTrue(held.consumed)
    end function

    @it("a held event past the repeat delay steps again, so a sustained hold repeats")
    function _()
      m.slider.step = 5
      m.slider.setValue(10)

      m.slider.handleInput(new BGE.GameInput(5, 0)) ' right press
      m.slider.handleInput(new BGE.GameInput(1005, 0)) ' same-frame held - throttled
      lateHeld = new BGE.GameInput(1005, 500) ' held well past the repeat delay

      m.slider.handleInput(lateHeld)

      m.assertEqual(20.0, m.slider.getValue())
      m.assertTrue(lateHeld.consumed)
    end function

    @it("does not consume a release event")
    function _()
      m.slider.setValue(10)
      input = new BGE.GameInput(104, 0) ' left, release

      m.slider.handleInput(input)

      m.assertEqual(10.0, m.slider.getValue())
      m.assertFalse(input.consumed)
    end function

    @it("does not consume input it doesn't handle")
    function _()
      input = new BGE.GameInput(2, 0) ' up, press

      m.slider.handleInput(input)

      m.assertFalse(input.consumed)
    end function

    @describe("theme inheritance via draw(parent)")

    @it("UiContainer.draw() passes itself as the parent to each child's draw(), so Theme.effectiveTheme() is reachable")
    function _()
      container = new BGE.UI.UiContainer(m.game)
      recorder = new ParentRecordingWidget(m.game)
      container.addChild(recorder)

      container.draw()

      m.assertNotInvalid(recorder.lastDrawParent)
      m.assertEqual(container.id, recorder.lastDrawParent.id)
    end function

    @describe("draw")

    @it("draw() does not throw with the default flat-color theme")
    function _()
      m.slider.width = 80
      m.slider.height = 30
      m.slider.draw() ' should not throw
      m.assertTrue(true)
    end function

    @it("draw() does not throw when theme.backgroundImage is set")
    function _()
      bmp = CreateObject("roBitmap", {width: 24, height: 24, AlphaEnable: true})
      bmp.Clear(&hFFFFFFFF)
      m.game.defaultTheme.backgroundImage = new BGE.UI.NinePatchImage(bmp, 6, 6, 6, 6)

      m.slider.width = 80
      m.slider.height = 30
      m.slider.draw() ' should not throw
      m.assertTrue(true)
    end function

  end class

  class ParentRecordingWidget extends BGE.UI.UiWidget
    lastDrawParent as BGE.UI.UiWidget

    sub new(game as BGE.Game)
      super(game)
    end sub

    override sub draw(parent = invalid as BGE.UI.UiWidget)
      m.lastDrawParent = parent
    end sub
  end class

end namespace
