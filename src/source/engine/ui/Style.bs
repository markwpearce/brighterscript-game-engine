import "../GameInput.bs"

namespace BGE.UI

  const DEFAULT_PADDING = 32

  ' Minimum time (ms) a direction must be held before a Slider/Select repeats
  ' its adjustment. Game.bs dispatches a press AND a synthesized held event
  ' (heldTimeMs ~0) in the same frame as every button press, so without this
  ' threshold a single tap would step twice - see RepeatThrottle below.
  const WIDGET_REPEAT_DELAY_MS = 300

  ' Throttles repeat-while-held directional input to one action per
  ' WIDGET_REPEAT_DELAY_MS, while letting a single tap's press+synthesized-
  ' held pair act exactly once. Shared by Slider/Select.handleInput() and
  ' BGE.UI.FocusManager's list/pointer navigation - anywhere directional
  ' input should act at most once per tap, then repeat while held.
  class RepeatThrottle

    ' heldTimeMs of the last held event acted on, or -1 when no hold is in
    ' progress.
    protected lastActionMs as float = -1

    ' Should this input event act now? Only call for input already known to
    ' be relevant (e.g. filtered to the right button/direction) - a press
    ' always acts; a held event acts only once WIDGET_REPEAT_DELAY_MS has
    ' passed since the last action, so the same frame's synthesized held
    ' event (heldTimeMs ~0) right after a press doesn't double-act.
    '
    ' @param {BGE.GameInput} input
    ' @return {boolean}
    function shouldAct(input as BGE.GameInput) as boolean
      result = input.press
      if input.held and (m.lastActionMs < 0 or input.heldTimeMs - m.lastActionMs >= WIDGET_REPEAT_DELAY_MS)
        result = true
      end if
      if result
        if input.press
          m.lastActionMs = 0
        else
          m.lastActionMs = input.heldTimeMs
        end if
      end if
      return result
    end function
  end class

  class OffsetSize
    top as float = 0
    right as float = 0
    bottom as float = 0
    left as float = 0


    sub new(tOffset = 0 as float, rOffset = invalid as dynamic, bOffset = invalid as dynamic, lOffset = invalid as dynamic)
      m.set(tOffset, rOffset, bOffset, lOffset)
    end sub

    sub set(tOffset = 0 as float, rOffset = invalid as dynamic, bOffset = invalid as dynamic, lOffset = invalid as dynamic)
      m.top = tOffset
      m.right = rOffset ?? tOffset
      m.bottom = bOffset ?? tOffset
      m.left = lOffset ?? tOffset
    end sub

  end class

end namespace
