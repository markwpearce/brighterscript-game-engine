namespace BGE.UI

  const DEFAULT_PADDING = 32

  class OffsetSize
    top as float = 0
    right as float = 0
    bottom as float = 0
    left as float = 0


    sub new(tOffset = 0 as float, rOffset = invalid as dynamic, bOffset = invalid as dynamic, lOffset = invalid as dynamic)
      m.set(tOffset, rOffset, bOffset, lOffset)
    end sub

    sub set(tOffset = 0 as float, rOffset = invalid as dynamic, bOffset = invalid as dynamic, lOffset = invalid as dynamic)
      m.top = tOffset
      m.right = rOffset ?? tOffset
      m.bottom = bOffset ?? tOffset
      m.left = lOffset ?? tOffset
    end sub

  end class

  ' Default colors/fonts/spacing for BGE.UI widgets. Game.defaultTheme is the
  ' engine-wide default (matching today's previously-hardcoded widget colors,
  ' so existing consumers see no visual change); a UiContainer.theme overrides
  ' it for that container's subtree.
  '
  ' Resolution happens on every draw() call, not once at add-time: a widget
  ' resolves the theme from its immediate parent's effectiveTheme() (which
  ' itself falls back to Game.defaultTheme when that parent has no theme set),
  ' and any per-widget color field left `invalid` picks up the theme's value.
  ' There is no multi-level walk up the tree - only the immediate parent is
  ' consulted, so a grandparent container's own override does not reach a
  ' grandchild through an intervening container that has no theme of its own.
  '
  ' `font`/`fontSize` are accepted and stored but not yet applied by any
  ' widget - each widget's BGE.DrawableText uses its own default font. See
  ' issue #133's follow-up; wiring them needs font-cache invalidation that
  ' can't be done by comparing roFont instances (`=` on native components is
  ' a runtime crash in BrightScript).
  '
  ' This class lives in Style.bs rather than its own Theme.bs because of a
  ' bslint + rooibos-roku toolchain bug (issue #178): a pre-existing file
  ' (e.g. Game.bs, which references Game.defaultTheme) can't resolve a symbol
  ' declared in a brand-new file, so Theme is co-located with the already-
  ' existing OffsetSize class here.
  class Theme

    backgroundColor as integer = BGE.Colors.Gray
    foregroundColor as integer = BGE.Colors.White
    borderColor as integer = BGE.Colors.White
    focusedBorderColor as integer = BGE.Colors.White
    hoveredBackgroundColor as integer = BGE.Colors.Silver
    disabledColor as integer = BGE.Colors.Gray

    font as roFont
    fontSize as integer = 28

    defaultPadding as OffsetSize
    defaultMargin as OffsetSize

    cursorColor as integer = BGE.Colors.White
    cursorSize as float = 8.0

    sub new()
      m.defaultPadding = new OffsetSize()
      m.defaultMargin = new OffsetSize()
    end sub

  end class

end namespace
