import "Button.bs"

namespace BGE.UI

  ' Anything a Button or MenuList reports clicks to: a scene, an entity, or a plain object.
  ' Set `Button.listener` (or `MenuList.listener`) to it, and give each button an `actionId`.
  interface UiActionListener
    ' Called when a button with this listener is clicked.
    '
    ' @param {string} actionId - the clicked button's `actionId`
    ' @param {BGE.UI.Button} button - the clicked button (its `value` holds any extra data)
    sub onUiAction(actionId as string, button as BGE.UI.Button)
  end interface

end namespace
