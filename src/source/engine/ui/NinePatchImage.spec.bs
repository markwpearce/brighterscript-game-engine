import "pkg:/source/engine/ui/NinePatchImage.bs"

namespace tests
  @suite("BGE.UI.NinePatchImage")
  class NinePatchImageTest extends rooibos.BaseTestSuite

    bmp as roBitmap

    game as BGE.Game

    protected override function beforeEach()
      m.bmp = CreateObject("roBitmap", {width: 30, height: 30, AlphaEnable: true})
      m.bmp.Clear(&hFFFFFFFF)
      m.game = new BGE.Game(200, 200)
    end function

    @describe("slicing")

    @it("computes corner slice dimensions from the insets")
    function _()
      np = new BGE.UI.NinePatchImage(m.bmp, 8, 8, 8, 8)
      m.assertEqual(8, np.getTopLeft().GetWidth())
      m.assertEqual(8, np.getTopLeft().GetHeight())
    end function

    @it("computes center slice dimensions as source minus all insets")
    function _()
      np = new BGE.UI.NinePatchImage(m.bmp, 8, 8, 8, 8)
      m.assertEqual(14, np.getCenter().GetWidth()) ' 30 - 8 - 8
      m.assertEqual(14, np.getCenter().GetHeight())
    end function

    @describe("draw")

    @it("issues exactly 9 draw calls for one background fill")
    function _()
      np = new BGE.UI.NinePatchImage(m.bmp, 8, 8, 8, 8)
      renderer = m.game.canvas.renderer
      before = renderer.getDrawCallsLastFrame()
      np.draw(renderer, 10, 10, 100, 60)
      after = renderer.getDrawCallsLastFrame()
      m.assertEqual(9, after - before)
    end function

    @it("draws without throwing when every inset is 0 (no marker in the source image)")
    function _()
      np = new BGE.UI.NinePatchImage(m.bmp, 0, 0, 0, 0)
      renderer = m.game.canvas.renderer
      before = renderer.getDrawCallsLastFrame()
      np.draw(renderer, 10, 10, 100, 60)
      ' Only the center slice has a non-zero size; the 8 zero-sized corner/edge
      ' slices are invalid and must be skipped rather than crashing drawObject().
      m.assertEqual(1, renderer.getDrawCallsLastFrame() - before)
    end function

  end class
end namespace
