namespace tests

  @suite("BGE.ScreenFade")
  class ScreenFadeTests extends rooibos.BaseTestSuite

    fade as BGE.ScreenFade

    protected override function beforeEach()
      m.fade = new BGE.ScreenFade()
    end function

    @describe("fadeTo / tick")

    @it("moves opacity linearly toward the target")
    function _()
      m.fade.fadeTo(1, 0.1)
      m.assertTrue(m.fade.isFading())
      m.assertFalse(m.fade.tick(0.025))
      m.assertTrue(Abs(m.fade.opacity - 0.25) < 0.0001)
    end function

    @it("lands exactly on the target and reports finishing once")
    function _()
      m.fade.fadeTo(1, 0.05)
      m.fade.tick(0.03)
      m.assertTrue(m.fade.tick(0.03))
      m.assertEqual(1.0, m.fade.opacity)
      m.assertFalse(m.fade.isFading())
      m.assertFalse(m.fade.tick(0.03))
    end function

    @it("counts a long frame as at most MAX_FADE_STEP_SECONDS")
    function _()
      m.fade.fadeTo(1, 0.3)
      m.assertFalse(m.fade.tick(5.0))
      m.assertTrue(m.fade.opacity < 0.2)
    end function

    @it("jumps straight to the target for a zero-length fade")
    function _()
      m.fade.opacity = 1
      m.fade.fadeTo(0, 0)
      m.assertEqual(0.0, m.fade.opacity)
      m.assertFalse(m.fade.isFading())
    end function

  end class

end namespace
