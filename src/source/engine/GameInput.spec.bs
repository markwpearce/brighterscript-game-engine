namespace tests

  ' GameInput's directional x/y are in world space (+y is up), matching the
  ' engine's world coordinate convention - the renderer (see Camera2d)
  ' flips y only when projecting to raster/canvas space. This was previously
  ' misdocumented on the class as "up -> -1, down -> 1"; these tests lock in
  ' the actual (correct, renderer-consistent) behavior.
  @suite("BGE.GameInput")
  class GameInputTests extends rooibos.BaseTestSuite

    @describe("button / press / release / held")

    @it("a pressed code (<100) sets press=true, release=false, held=false")
    function _()
      input = new BGE.GameInput(2, 0) ' up, pressed
      m.assertEqual("up", input.button)
      m.assertTrue(input.press)
      m.assertFalse(input.release)
      m.assertFalse(input.held)
    end function

    @it("a released code (100-999) sets release=true")
    function _()
      input = new BGE.GameInput(102, 250)
      m.assertEqual("up", input.button)
      m.assertTrue(input.release)
      m.assertFalse(input.press)
      m.assertFalse(input.held)
      m.assertEqual(250, input.heldTimeMs)
    end function

    @it("a held code (>=1000) sets held=true")
    function _()
      input = new BGE.GameInput(1002, 500)
      m.assertEqual("up", input.button)
      m.assertTrue(input.held)
      m.assertFalse(input.press)
      m.assertFalse(input.release)
    end function

    @describe("directional x/y")

    @it("right/left set x, up/down set y - in world space, up is positive")
    function _()
      m.assertEqual(1, (new BGE.GameInput(5, 0)).x) ' right
      m.assertEqual(-1, (new BGE.GameInput(4, 0)).x) ' left
      m.assertEqual(1, (new BGE.GameInput(2, 0)).y) ' up
      m.assertEqual(-1, (new BGE.GameInput(3, 0)).y) ' down
    end function

    @it("non-directional buttons leave x/y at 0")
    function _()
      input = new BGE.GameInput(6, 0) ' OK
      m.assertEqual(0, input.x)
      m.assertEqual(0, input.y)
    end function

    @it("released directional codes don't set x/y (only press/held do)")
    function _()
      input = new BGE.GameInput(102, 0) ' up, released
      m.assertEqual(0, input.y)
    end function

    @describe("isButton")

    @it("is case-insensitive")
    function _()
      input = new BGE.GameInput(6, 0) ' OK
      m.assertTrue(input.isButton("ok"))
      m.assertTrue(input.isButton("OK"))
    end function

    @it("is false for a different button")
    function _()
      input = new BGE.GameInput(6, 0) ' OK
      m.assertFalse(input.isButton("back"))
    end function

    @it("accepts common aliases for a button")
    function _()
      m.assertTrue((new BGE.GameInput(6, 0)).isButton("select")) ' OK
      m.assertTrue((new BGE.GameInput(10, 0)).isButton("info")) ' options
      m.assertTrue((new BGE.GameInput(9, 0)).isButton("ff")) ' fastforward
      m.assertTrue((new BGE.GameInput(8, 0)).isButton("rev")) ' rewind
      m.assertTrue((new BGE.GameInput(7, 0)).isButton("instantreplay")) ' replay
    end function

    @describe("isDirectionalArrow")

    @it("is true when x or y is non-zero")
    function _()
      m.assertTrue((new BGE.GameInput(2, 0)).isDirectionalArrow())
    end function

    @it("is false for a non-directional button")
    function _()
      m.assertFalse((new BGE.GameInput(6, 0)).isDirectionalArrow())
    end function

    @describe("controller-originated input")

    @it("defaults playerIndex to -1 for remote input")
    function _()
      input = new BGE.GameInput(2, 0)
      m.assertEqual(-1, input.playerIndex)
    end function

    @it("uses explicitButtonName instead of buttonNameFromCode when given")
    function _()
      input = new BGE.GameInput(BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE, 0, 0, "controller0")
      m.assertEqual("controller0", input.button)
      m.assertEqual(0, input.playerIndex)
      m.assertTrue(input.press)
    end function

    @it("still derives press/held/release from buttonCode with an explicit name")
    function _()
      pressed = new BGE.GameInput(BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE + 3, 0, 1, "controller3")
      released = new BGE.GameInput(BGE.CONTROLLER_BUTTON_CODE_RELEASE_BASE + 3, 0, 1, "controller3")
      held = new BGE.GameInput(BGE.CONTROLLER_BUTTON_CODE_HELD_BASE + 3, 40, 1, "controller3")
      m.assertTrue(pressed.press)
      m.assertFalse(pressed.release)
      m.assertFalse(pressed.held)
      m.assertTrue(released.release)
      m.assertFalse(released.press)
      m.assertFalse(released.held)
      m.assertTrue(held.held)
      m.assertFalse(held.press)
      m.assertFalse(held.release)
      m.assertEqual(40, held.heldTimeMs)
    end function

    @it("isButton matches an explicit controller button name")
    function _()
      input = new BGE.GameInput(BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE + 1, 0, 0, "controller1")
      m.assertTrue(input.isButton("controller1"))
      m.assertFalse(input.isButton("controller0"))
    end function

    @describe("controller buttonCode bands never collide with the remote's or each other's")

    @it("a controller button's press/release/held codes never overlap the remote's 0-99/100-999/1000+ ranges, across a realistic button-index range")
    function _()
      ' W3C standard Gamepad mapping tops out at button index 16 (17 buttons) - check a
      ' generous superset of that range (0-31) against the remote's own used codes
      ' (0-13ish per the button-code table) plus the boundary of its whole numeric
      ' scheme (0-999 press/release, 1000+ held) - the bands are 100000 apart by
      ' construction, so this samples the closest-to-colliding values rather than
      ' exhaustively checking every one of the ~32000 remote/controller code pairs.
      remoteCodesToCheck = [0, 13, 99, 100, 113, 999, 1000, 1013, 9999]
      for buttonIndex = 0 to 31
        pressCode = BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE + buttonIndex
        releaseCode = BGE.CONTROLLER_BUTTON_CODE_RELEASE_BASE + buttonIndex
        heldCode = BGE.CONTROLLER_BUTTON_CODE_HELD_BASE + buttonIndex
        for each remoteCode in remoteCodesToCheck
          m.assertNotEqual(remoteCode, pressCode)
          m.assertNotEqual(remoteCode, releaseCode)
          m.assertNotEqual(remoteCode, heldCode)
        end for
      end for
    end function

    @it("distinct controller button indexes never produce colliding codes with each other")
    function _()
      for buttonIndexA = 0 to 16
        for buttonIndexB = 0 to 16
          if buttonIndexA <> buttonIndexB
            m.assertNotEqual(BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE + buttonIndexA, BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE + buttonIndexB)
            m.assertNotEqual(BGE.CONTROLLER_BUTTON_CODE_RELEASE_BASE + buttonIndexA, BGE.CONTROLLER_BUTTON_CODE_RELEASE_BASE + buttonIndexB)
            m.assertNotEqual(BGE.CONTROLLER_BUTTON_CODE_HELD_BASE + buttonIndexA, BGE.CONTROLLER_BUTTON_CODE_HELD_BASE + buttonIndexB)
          end if
        end for
      end for
    end function

    @it("a controller button's own press/release/held codes never collide with each other, for any index in range")
    function _()
      for buttonIndex = 0 to 16
        pressCode = BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE + buttonIndex
        releaseCode = BGE.CONTROLLER_BUTTON_CODE_RELEASE_BASE + buttonIndex
        heldCode = BGE.CONTROLLER_BUTTON_CODE_HELD_BASE + buttonIndex
        m.assertNotEqual(pressCode, releaseCode)
        m.assertNotEqual(pressCode, heldCode)
        m.assertNotEqual(releaseCode, heldCode)
      end for
    end function

  end class

end namespace
