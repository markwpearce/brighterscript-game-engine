import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/GameEntity.bs"
import "pkg:/source/engine/GameScene.bs"
import "pkg:/source/engine/renderer/lighting/Light.bs"

namespace tests

  @suite("BGE.GameEntity and GameScene owned lights")
  class GameEntityLightsTests extends rooibos.BaseTestSuite

    game as BGE.Game
    lit as tests.LitTestScene

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.lit = new tests.LitTestScene(m.game)
      m.game.defineScene(m.lit)
      m.game.defineScene(new BGE.GameScene(m.game, {name: "Dark"}))
    end function

    @describe("an entity's lights")

    @it("adds the light to the game")
    function _()
      m.game.changeScene("Dark")
      entity = new BGE.GameEntity(m.game, {name: "Lamp"})
      m.game.addEntity(entity)
      light = new BGE.AmbientLight(&hFFFFFF, 0.5)
      entity.addLight(light)
      entity.addLight(light)
      m.assertEqual(1, m.lightCount())
      m.assertEqual(1, entity.getLights().count())
    end function

    @it("removes it when the entity is destroyed")
    function _()
      m.game.changeScene("Dark")
      entity = new BGE.GameEntity(m.game, {name: "Lamp"})
      m.game.addEntity(entity)
      entity.addLight(new BGE.AmbientLight(&hFFFFFF, 0.5))
      m.game.destroyEntity(entity)
      m.assertEqual(0, m.lightCount())
    end function

    @it("removes it when the entity is invalidated")
    function _()
      m.game.changeScene("Dark")
      entity = new BGE.GameEntity(m.game, {name: "Lamp"})
      m.game.addEntity(entity)
      entity.addLight(new BGE.AmbientLight(&hFFFFFF, 0.5))
      entity.invalidate()
      m.assertEqual(0, m.lightCount())
    end function

    @it("removes it when a scene change removes the entity")
    function _()
      m.game.changeScene("Dark")
      entity = new BGE.GameEntity(m.game, {name: "Lamp"})
      m.game.addEntity(entity)
      entity.addLight(new BGE.AmbientLight(&hFFFFFF, 0.5))
      m.changeTo("Lit")
      m.assertEqual(1, m.lightCount())
      m.assertEqual(m.lit.light.id, m.game.canvas.renderer.lights[0].id)
    end function

    @it("keeps a persistent entity's light across a scene change")
    function _()
      m.game.changeScene("Dark")
      entity = new BGE.GameEntity(m.game, {name: "Lamp"})
      entity.persistent = true
      m.game.addEntity(entity)
      entity.addLight(new BGE.AmbientLight(&hFFFFFF, 0.5))
      m.changeTo("Dark")
      m.assertEqual(1, m.lightCount())
    end function

    @it("removeLight() removes it from the game and the entity")
    function _()
      m.game.changeScene("Dark")
      entity = new BGE.GameEntity(m.game, {name: "Lamp"})
      m.game.addEntity(entity)
      light = new BGE.AmbientLight(&hFFFFFF, 0.5)
      entity.addLight(light)
      m.assertTrue(entity.removeLight(light))
      m.assertEqual(0, m.lightCount())
      m.assertEqual(0, entity.getLights().count())
    end function

    @describe("a scene's lights")

    @it("removes them when the game leaves the scene, after onDestroy()")
    function _()
      m.changeTo("Lit")
      m.assertEqual(1, m.lightCount())
      m.changeTo("Dark")
      m.assertEqual(0, m.lightCount())
      m.assertEqual(1, m.lit.lightsInDestroy)
    end function

    @it("doesn't pile up over changes to the same scene")
    function _()
      m.changeTo("Lit")
      m.changeTo("Lit")
      m.changeTo("Lit")
      m.assertEqual(1, m.lightCount())
    end function

    @it("keeps a light added with game.addLight() across scene changes")
    function _()
      m.game.addLight(new BGE.AmbientLight(&hFFFFFF, 0.5))
      m.changeTo("Lit")
      m.changeTo("Dark")
      m.assertEqual(1, m.lightCount())
    end function

    private sub changeTo(sceneName as string)
      m.game.changeScene(sceneName)
      m.game.runEndOfFrameForTest()
    end sub

    private function lightCount() as integer
      return m.game.canvas.renderer.lights.count()
    end function

  end class

  ' Adds one light of its own in onCreate()
  class LitTestScene extends BGE.GameScene
    light as BGE.Light = invalid
    lightsInDestroy as integer = -1

    sub new(game as BGE.Game)
      super(game, {name: "Lit"})
    end sub

    override sub onCreate(args as roAssociativeArray)
      light = new BGE.AmbientLight(&h808080, 0.4)
      m.light = light
      m.addLight(light)
    end sub

    override sub onDestroy()
      m.lightsInDestroy = m.game.canvas.renderer.lights.count()
    end sub
  end class

end namespace
