namespace tests

  @suite("BGE.separateCircles")
  class CircleSeparationTests extends rooibos.BaseTestSuite

    private function body(x as float, z as float, radius as float, mass as float) as BGE.CircleBody
      return {position: BGE.Math.VectorOps.create(x, 0, z), radius: radius, mass: mass}
    end function

    private function flatDistance(a as BGE.Math.Vector, b as BGE.Math.Vector) as float
      return Sqr((b.x - a.x) ^ 2 + (b.z - a.z) ^ 2)
    end function

    private function assertNear(actual as float, expected as float, message = "" as string)
      m.assertTrue(Abs(actual - expected) < 0.001, `${message} expected ${expected}, got ${actual}`)
    end function

    @describe("separateCircles")

    @it("pushes equal masses apart by half the overlap each")
    function _()
      a = m.body(0, 0, 10, 1)
      b = m.body(15, 0, 10, 1)
      m.assertEqual(BGE.separateCircles([a, b]), 1)
      m.assertNear(a.position.x, -2.5)
      m.assertNear(b.position.x, 17.5)
    end function

    @it("moves the lighter body further")
    function _()
      a = m.body(0, 0, 10, 3)
      b = m.body(0, 16, 10, 1)
      BGE.separateCircles([a, b])
      m.assertNear(a.position.z, -1)
      m.assertNear(b.position.z, 19)
    end function

    @it("never moves an immovable body")
    function _()
      wall = m.body(0, 0, 10, 0)
      walker = m.body(10, 0, 10, 1)
      BGE.separateCircles([wall, walker])
      m.assertNear(wall.position.x, 0)
      m.assertNear(walker.position.x, 20)
    end function

    @it("leaves bodies that only touch alone")
    function _()
      a = m.body(0, 0, 10, 1)
      b = m.body(20, 0, 10, 1)
      m.assertEqual(BGE.separateCircles([a, b]), 0)
      m.assertNear(b.position.x, 20)
    end function

    @it("separates bodies on exactly the same spot")
    function _()
      a = m.body(5, 5, 10, 1)
      b = m.body(5, 5, 10, 1)
      BGE.separateCircles([a, b])
      m.assertNear(m.flatDistance(a.position, b.position), 20)
    end function

    @it("works on x/y for 2D games, leaving z alone")
    function _()
      a = {position: BGE.Math.VectorOps.create(0, 0, 0), radius: 10, mass: 1} as BGE.CircleBody
      b = {position: BGE.Math.VectorOps.create(0, 10, 0), radius: 10, mass: 1} as BGE.CircleBody
      BGE.separateCircles([a, b], BGE.SeparationPlane.xy)
      m.assertNear(a.position.y, -5)
      m.assertNear(b.position.y, 15)
      m.assertNear(b.position.z, 0)
    end function

    @it("moves the entity whose position vector was passed")
    function _()
      game = new BGE.Game(320, 240)
      entity = new BGE.GameEntity(game, {name: "Walker"})
      BGE.separateCircles([{position: entity.position, radius: 10, mass: 1}, m.body(0, 0, 10, 0)])
      m.assertNear(m.flatDistance(entity.position, BGE.Math.VectorOps.create(0, 0, 0)), 20)
    end function

  end class

end namespace
