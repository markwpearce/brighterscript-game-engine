import "../../math/vector.bs"
import "CircleSeparation.bs"

namespace BGE

  ' Options for `BGE.SolidWorld.moveAndSlide()`.
  interface SlideOptions extends roAssociativeArray
    ' How far (px) a box moving along one axis may clip a corner and still be eased around it.
    ' 0 turns corner easing off. Default 8.
    optional cornerNudge as float
    ' Longest single sub-step (px), so a fast move can't skip over a thin solid. Default 4.
    optional maxStep as float
  end interface

  ' Result of `BGE.SolidWorld.moveAndSlide()`.
  interface SlideResult
    ' New bottom-left x of the moving box
    x as float
    ' New bottom-left y of the moving box
    y as float
    ' True if a solid stopped movement along x
    blockedX as boolean
    ' True if a solid stopped movement along y
    blockedY as boolean
  end interface

  ' Options for `BGE.SolidWorld.track()`.
  interface SolidTrackOptions extends roAssociativeArray
    ' Which two position axes are the SolidWorld's x and y: `xz` (default, the ground in a 3D
    ' game) or `xy` (a 2D game). The other axis is left alone.
    optional plane as BGE.SeparationPlane
    ' Passed to `moveAndSlide()` each time the body is resolved
    optional slide as BGE.SlideOptions
  end interface

  ' What `BGE.SolidWorld.track()` needs from a body. Any `BGE.GameEntity` fits.
  interface SolidTrackable
    ' Invalid once the body is gone (e.g. an invalidated entity), so it's dropped
    id as dynamic
    position as BGE.Math.Vector
  end interface

  ' A body `BGE.SolidWorld.track()` keeps out of solids, and where it was after the last resolve.
  interface SolidWorldTrackedBody extends roAssociativeArray
    entity as BGE.SolidTrackable
    ' The entity's id when it was tracked: it no longer matches once the entity is invalidated
    entityId as string
    ' Half the side of the square feet box, centred on the entity's position
    radius as float
    ' True to use position.y as the SolidWorld's y, false for position.z
    useY as boolean
    slide as BGE.SlideOptions
    ' Where the box centre was after the last resolve
    lastX as float
    lastY as float
  end interface

  ' One solid rectangle in a `BGE.SolidWorld`.
  interface SolidWorldSolid
    ' Bottom-left x
    x as float
    ' Bottom-left y
    y as float
    w as float
    h as float
    ' Unique within its SolidWorld
    id as string
  end interface

  ' A set of static, axis-aligned solid rectangles for top-down movement (walls, water, prop
  ' bases), and `moveAndSlide()` to move a box through them: it stops flush against solids,
  ' slides along walls, and eases around corners it only just clips.
  '
  ' Every rectangle is `{x, y, w, h}` - `(x, y)` is the bottom-left corner, world +y up. This is
  ' plain rectangle maths, separate from colliders: colliders report overlaps, while a
  ' `SolidWorld` keeps a mover out of them. For platformer tiles (including one-way platforms)
  ' see `BGE.resolveAabbTileCollision()` instead.
  '
  ' @example
  ' world = new BGE.SolidWorld()
  ' world.addBounds(0, 0, mapWidth, mapHeight)
  ' world.addSolid(64, 64, 32, 32)
  ' ' Each frame, move the player's feet box:
  ' result = world.moveAndSlide({x: feetX, y: feetY, w: 20, h: 12}, dx, dy)
  ' feetX = result.x
  ' feetY = result.y
  '
  ' Or track a body and resolve every tracked body once everything has moved it (its own
  ' movement, knockback, being pushed apart): each one's move since the last resolve is replayed
  ' through the solids.
  '
  ' @example
  ' world.track(knight, 12) ' a 24x24 feet box centred on the knight, on the x/z ground plane
  ' ' In GameScene.onPostUpdate(), after BGE.separateCircles():
  ' world.resolveTracked()
  ' ' Or have the game call it right after onPostUpdate():
  ' m.trackedSolidWorld = world
  class SolidWorld

    private bucketSize as float = 128
    private buckets as roAssociativeArray = {}
    private solids as BGE.SolidWorldSolid[] = []
    private nextId as integer = 0
    protected tracked as BGE.SolidWorldTrackedBody[] = []

    ' @param {integer} [bucketSize=128] - solids are grouped in square cells this size (px), so
    '   a move only tests nearby solids. Roughly the size of a typical solid works well. 0 or less
    '   uses the default.
    sub new(bucketSize = 128 as integer)
      if bucketSize > 0
        m.bucketSize = bucketSize
      end if
    end sub

    ' Adds a solid rectangle.
    '
    ' @param {float} x - bottom-left x
    ' @param {float} y - bottom-left y
    ' @param {float} w
    ' @param {float} h
    ' @return {string} the solid's id, for `removeSolid()`
    function addSolid(x as float, y as float, w as float, h as float) as string
      solid = {x: x, y: y, w: w, h: h, id: m.nextId.toStr()} as BGE.SolidWorldSolid
      m.nextId++
      m.solids.push(solid)
      for bx = m.bucketIndex(x) to m.bucketIndex(x + w)
        for by = m.bucketIndex(y) to m.bucketIndex(y + h)
          key = bx.toStr() + "," + by.toStr()
          if m.buckets[key] = invalid
            m.buckets[key] = []
          end if
          m.buckets[key].push(solid)
        end for
      end for
      return solid.id
    end function

    ' Removes a solid, e.g. a door that has opened. Movers can pass through it from then on.
    '
    ' @param {string} id - from `addSolid()`
    ' @return {boolean} true if a solid was removed, false if no solid has that id
    function removeSolid(id as string) as boolean
      index = -1
      for i = 0 to m.solids.count() - 1
        if m.solids[i].id = id
          index = i
          exit for
        end if
      end for
      if index < 0
        return false
      end if
      solid = m.solids[index]
      m.solids.Delete(index)
      for bx = m.bucketIndex(solid.x) to m.bucketIndex(solid.x + solid.w)
        for by = m.bucketIndex(solid.y) to m.bucketIndex(solid.y + solid.h)
          bucket = m.buckets[bx.toStr() + "," + by.toStr()]
          if bucket <> invalid
            for j = bucket.count() - 1 to 0 step -1
              if bucket[j].id = id
                bucket.Delete(j)
              end if
            end for
          end if
        end for
      end for
      return true
    end function

    ' Adds four solids around the outside of a rectangle, so movers can't leave it (e.g. the
    ' edges of a map).
    '
    ' @param {float} x - bottom-left x of the area to keep movers inside
    ' @param {float} y - bottom-left y
    ' @param {float} w
    ' @param {float} h
    ' @param {float} [thickness=64] - how thick each wall is
    sub addBounds(x as float, y as float, w as float, h as float, thickness = 64 as float)
      m.addSolid(x - thickness, y - thickness, w + thickness * 2, thickness)
      m.addSolid(x - thickness, y + h, w + thickness * 2, thickness)
      m.addSolid(x - thickness, y, thickness, h)
      m.addSolid(x + w, y, thickness, h)
    end sub

    ' @return {integer} how many solids there are now
    function getSolidCount() as integer
      return m.solids.count()
    end function

    ' Every solid added so far, e.g. for drawing them while debugging. Each is a copy, so
    ' changing one doesn't move the real solid.
    '
    ' @return {BGE.SolidWorldSolid[]}
    function getSolids() as BGE.SolidWorldSolid[]
      copies = []
      for each solid in m.solids
        copies.push({x: solid.x, y: solid.y, w: solid.w, h: solid.h, id: solid.id})
      end for
      return copies
    end function

    ' The solids overlapping a box (touching edges don't count), as copies.
    '
    ' @param {float} x - bottom-left x
    ' @param {float} y - bottom-left y
    ' @param {float} w
    ' @param {float} h
    ' @return {BGE.SolidWorldSolid[]}
    function getSolidsInArea(x as float, y as float, w as float, h as float) as BGE.SolidWorldSolid[]
      copies = []
      for each solid in m.overlaps(x, y, w, h)
        copies.push({x: solid.x, y: solid.y, w: solid.w, h: solid.h, id: solid.id})
      end for
      return copies
    end function

    ' Whether a box overlaps no solid. A box only touching a solid's edge is free.
    '
    ' @param {float} x - bottom-left x
    ' @param {float} y - bottom-left y
    ' @param {float} w
    ' @param {float} h
    ' @return {boolean}
    function isAreaFree(x as float, y as float, w as float, h as float) as boolean
      return m.overlaps(x, y, w, h).count() = 0
    end function

    ' Moves a box by (dx, dy), stopping flush against solids and sliding along them. When moving
    ' along one axis only, a box that clips a corner by up to `options.cornerNudge` is eased
    ' around it. The box must start clear of every solid.
    '
    ' @param {object} mover - `{x, y, w, h}`: the moving box, bottom-left corner
    ' @param {float} dx
    ' @param {float} dy
    ' @param {BGE.SlideOptions} [options={}] - `cornerNudge` (default 8, 0 = off), `maxStep` (default 4)
    ' @return {BGE.SlideResult} the box's new bottom-left corner, and which axes were blocked
    function moveAndSlide(mover as object, dx as float, dy as float, options = {} as BGE.SlideOptions) as BGE.SlideResult
      if options = invalid
        options = {}
      end if
      cornerNudge = 8.0
      if options.DoesExist("cornerNudge")
        cornerNudge = options.cornerNudge
      end if
      maxStep = 4.0
      if options.DoesExist("maxStep") and options.maxStep > 0
        maxStep = options.maxStep
      end if

      largest = Abs(dx)
      if Abs(dy) > largest
        largest = Abs(dy)
      end if
      steps = Int(largest / maxStep) + 1
      stepX = dx / steps
      stepY = dy / steps
      result = {x: mover.x, y: mover.y, blockedX: false, blockedY: false}
      for i = 1 to steps
        if stepX <> 0
          m.stepAxis(result, mover.w, mover.h, stepX, true, dy = 0, cornerNudge)
        end if
        if stepY <> 0
          m.stepAxis(result, mover.w, mover.h, stepY, false, dx = 0, cornerNudge)
        end if
      end for
      return result
    end function

    ' Starts keeping `entity` out of solids from where it is now: `resolveTracked()` replays each
    ' move it makes after this. Its feet box is a square, `radius * 2` wide, centred on its
    ' position. Tracking an entity again updates its settings and forgets its move so far: do
    ' that after teleporting it (e.g. a respawn), or the jump is replayed as a move. The entity
    ' must start clear of every solid.
    '
    ' @param {BGE.SolidTrackable} entity
    ' @param {float} radius - half the feet box's side
    ' @param {BGE.SolidTrackOptions} [options={}] - `plane` (default xz) and `slide` options
    sub track(entity as BGE.SolidTrackable, radius as float, options = {} as BGE.SolidTrackOptions)
      if invalid = entity or invalid = entity.id
        return
      end if
      if invalid = options
        options = {}
      end if
      useY = options.DoesExist("plane") and options.plane = BGE.SeparationPlane.xy
      slide = {} as BGE.SlideOptions
      if options.DoesExist("slide") and invalid <> options.slide
        slide = options.slide
      end if
      entry = m.findTracked(entity)
      if invalid = entry
        entry = {entity: entity, entityId: entity.id} as BGE.SolidWorldTrackedBody
        m.tracked.push(entry)
      end if
      entry.radius = radius
      entry.useY = useY
      entry.slide = slide
      entry.lastX = entity.position.x
      if useY
        entry.lastY = entity.position.y
      else
        entry.lastY = entity.position.z
      end if
    end sub

    ' Stops keeping `entity` out of solids.
    '
    ' @param {BGE.SolidTrackable} entity
    ' @return {boolean} true if it was tracked
    function untrack(entity as BGE.SolidTrackable) as boolean
      index = m.findTrackedIndex(entity)
      if index < 0
        return false
      end if
      m.tracked.Delete(index)
      return true
    end function

    ' Stops tracking every body.
    sub untrackAll()
      m.tracked = []
    end sub

    ' @param {BGE.SolidTrackable} entity
    ' @return {boolean} whether `entity` is tracked (an invalidated entity never is)
    function isTracked(entity as BGE.SolidTrackable) as boolean
      return invalid <> m.findTracked(entity)
    end function

    ' @return {integer} how many bodies are tracked, counting invalidated ones not yet dropped by
    '   `resolveTracked()`
    function getTrackedCount() as integer
      return m.tracked.count()
    end function

    ' Slides every tracked body back out of the solids: its move since the last resolve (or since
    ' `track()`) is replayed through `moveAndSlide()`, so it stops flush against solids and slides
    ' along them. Call once a frame after everything has moved the bodies, e.g. at the end of
    ' `GameScene.onPostUpdate()`, or set the scene's `trackedSolidWorld` to have the game call it.
    ' Invalidated entities are dropped.
    sub resolveTracked()
      for i = m.tracked.count() - 1 to 0 step -1
        entry = m.tracked[i]
        if invalid <> entry.entity.id and entry.entity.id = entry.entityId
          m.resolveTrackedBody(entry)
        else
          m.tracked.Delete(i)
        end if
      end for
    end sub

    ' Resolves one tracked body. Override to change how a body is kept out of solids, e.g. to
    ' skip one that flies.
    '
    ' @param {BGE.SolidWorldTrackedBody} entry
    protected sub resolveTrackedBody(entry as BGE.SolidWorldTrackedBody)
      position = entry.entity.position
      if entry.useY
        nowY = position.y
      else
        nowY = position.z
      end if
      side = entry.radius * 2
      feet = {x: entry.lastX - entry.radius, y: entry.lastY - entry.radius, w: side, h: side}
      result = m.moveAndSlide(feet, position.x - entry.lastX, nowY - entry.lastY, entry.slide)
      position.x = result.x + entry.radius
      if entry.useY
        position.y = result.y + entry.radius
      else
        position.z = result.y + entry.radius
      end if
      entry.lastX = position.x
      entry.lastY = result.y + entry.radius
    end sub

    private function findTracked(entity as BGE.SolidTrackable) as BGE.SolidWorldTrackedBody
      index = m.findTrackedIndex(entity)
      if index < 0
        return invalid
      end if
      return m.tracked[index]
    end function

    private function findTrackedIndex(entity as BGE.SolidTrackable) as integer
      if invalid = entity or invalid = entity.id
        return -1
      end if
      for i = 0 to m.tracked.count() - 1
        if m.tracked[i].entityId = entity.id
          return i
        end if
      end for
      return -1
    end function

    private sub stepAxis(result as object, w as float, h as float, delta as float, alongX as boolean, singleAxis as boolean, cornerNudge as float)
      nx = result.x
      ny = result.y
      if alongX
        nx += delta
      else
        ny += delta
      end if
      hits = m.overlaps(nx, ny, w, h)
      if hits.count() = 0
        result.x = nx
        result.y = ny
        return
      end if

      ' Snap flush to the nearest blocking edge. The box started clear, so this never moves it backwards.
      if alongX
        result.blockedX = true
        for each hit in hits
          if delta > 0 and hit.x - w < nx
            nx = hit.x - w
          else if delta < 0 and hit.x + hit.w > nx
            nx = hit.x + hit.w
          end if
        end for
        result.x = nx
      else
        result.blockedY = true
        for each hit in hits
          if delta > 0 and hit.y - h < ny
            ny = hit.y - h
          else if delta < 0 and hit.y + hit.h > ny
            ny = hit.y + hit.h
          end if
        end for
        result.y = ny
      end if

      if singleAxis and cornerNudge > 0
        m.tryNudge(result, w, h, hits, Abs(delta), alongX, cornerNudge)
      end if
    end sub

    ' Moves the box perpendicular to travel when it only clips the blockers' combined extent by a
    ' few pixels. Uses the union of all hits so a wall made of stacked tile rects counts as one.
    private sub tryNudge(result as object, w as float, h as float, hits as BGE.SolidWorldSolid[], stepLength as float, alongX as boolean, cornerNudge as float)
      ' Perpendicular axis: y when travelling along x, x when travelling along y.
      if alongX
        boxStart = result.y
        boxSize = h
      else
        boxStart = result.x
        boxSize = w
      end if
      blockStart = invalid
      blockEnd = invalid
      for each hit in hits
        if alongX
          hitStart = hit.y
          hitEnd = hit.y + hit.h
        else
          hitStart = hit.x
          hitEnd = hit.x + hit.w
        end if
        if blockStart = invalid or hitStart < blockStart
          blockStart = hitStart
        end if
        if blockEnd = invalid or hitEnd > blockEnd
          blockEnd = hitEnd
        end if
      end for

      shift = 0.0
      overlapAtStart = (boxStart + boxSize) - blockStart
      overlapAtEnd = blockEnd - boxStart
      if overlapAtStart > 0 and overlapAtStart <= cornerNudge
        shift = -m.minFloat(stepLength, overlapAtStart)
      else if overlapAtEnd > 0 and overlapAtEnd <= cornerNudge
        shift = m.minFloat(stepLength, overlapAtEnd)
      end if
      if shift = 0
        return
      end if

      nx = result.x
      ny = result.y
      if alongX
        ny += shift
      else
        nx += shift
      end if
      if m.overlaps(nx, ny, w, h).count() = 0
        result.x = nx
        result.y = ny
      end if
    end sub

    ' Solids strictly overlapping the given box. Touching edges don't count, so a box flush
    ' against a wall is clear.
    private function overlaps(x as float, y as float, w as float, h as float) as BGE.SolidWorldSolid[]
      found = []
      seen = {}
      for bx = m.bucketIndex(x) to m.bucketIndex(x + w)
        for by = m.bucketIndex(y) to m.bucketIndex(y + h)
          bucket = m.buckets[bx.toStr() + "," + by.toStr()]
          if bucket <> invalid
            for each solid in bucket
              if seen[solid.id] = invalid and x < solid.x + solid.w and x + w > solid.x and y < solid.y + solid.h and y + h > solid.y
                seen[solid.id] = true
                found.push(solid)
              end if
            end for
          end if
        end for
      end for
      return found
    end function

    ' Int() floors, so negative coordinates (map-bounds solids) land in the right bucket.
    private function bucketIndex(value as float) as integer
      return Int(value / m.bucketSize)
    end function

    private function minFloat(a as float, b as float) as float
      if a < b
        return a
      end if
      return b
    end function

  end class
end namespace
