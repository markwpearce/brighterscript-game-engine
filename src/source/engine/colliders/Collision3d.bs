import "../../math/vector.bs"
import "../../math/math.bs"
import "Collision3dResults.bs"

namespace BGE

  ' Reserved member/collidable flag bit for SphereCollider3d/BoxCollider3d's internal
  ' YZ-plane colliders, which share a roCompositor with ordinary 2D colliders - without
  ' this, a YZ-plane collider (positioned at entity.y/z, not a real screen position) could
  ' spuriously match a 2D collider whose (x, y) happens to coincide numerically. Avoid this
  ' bit when choosing custom memberFlags/collidableFlags. See
  ' specs/2026-09-18-3d-collision-detection-design.md.
  const COLLIDER_3D_YZ_PLANE_FLAG = &h40000000


  ' True 3D sphere-sphere overlap test - the narrow-phase check after the two-plane
  ' broad-phase gate, since two spheres can pass both plane checks while never actually
  ' touching in 3D (a diagonal near-miss - see the design doc's spike findings).
  '
  ' @param {BGE.Math.Vector} centerA
  ' @param {float} radiusA
  ' @param {BGE.Math.Vector} centerB
  ' @param {float} radiusB
  ' @return {BGE.Sphere3dCollisionResult}
  function sphereOverlap(centerA as BGE.Math.Vector, radiusA as float, centerB as BGE.Math.Vector, radiusB as float) as BGE.Sphere3dCollisionResult
    diff = BGE.Math.VectorOps.subtract(centerA, centerB)
    dist = BGE.Math.VectorOps.length(diff)
    radiusSum = radiusA + radiusB

    if dist >= radiusSum
      return new BGE.Sphere3dCollisionResult(false, BGE.Math.VectorOps.create(0, 1, 0), 0.0)
    end if

    if dist > 0.0
      normal = BGE.Math.VectorOps.scale(diff, 1.0 / dist)
    else
      ' Centers exactly coincide - no meaningful direction, pick an arbitrary axis.
      normal = BGE.Math.VectorOps.create(0, 1, 0)
    end if

    return new BGE.Sphere3dCollisionResult(true, normal, radiusSum - dist)
  end function


  ' True 3D AABB-vs-AABB overlap test. Unlike sphereOverlap(), the two-plane broad-phase
  ' gate has no false-positive case for boxes (AABB overlap decomposes exactly per axis) -
  ' this only computes the penetration/normal result.
  '
  ' @param {BGE.Math.Vector} minA
  ' @param {BGE.Math.Vector} maxA
  ' @param {BGE.Math.Vector} minB
  ' @param {BGE.Math.Vector} maxB
  ' @return {BGE.Box3dCollisionResult}
  function aabbOverlap(minA as BGE.Math.Vector, maxA as BGE.Math.Vector, minB as BGE.Math.Vector, maxB as BGE.Math.Vector) as BGE.Box3dCollisionResult
    overlapX = BGE.Math.Min(maxA.x, maxB.x) - BGE.Math.Max(minA.x, minB.x)
    overlapY = BGE.Math.Min(maxA.y, maxB.y) - BGE.Math.Max(minA.y, minB.y)
    overlapZ = BGE.Math.Min(maxA.z, maxB.z) - BGE.Math.Max(minA.z, minB.z)

    if overlapX <= 0.0 or overlapY <= 0.0 or overlapZ <= 0.0
      return new BGE.Box3dCollisionResult(false, BGE.Math.VectorOps.create(0, 1, 0), 0.0)
    end if

    centerA = BGE.Math.VectorOps.scale(BGE.Math.VectorOps.add(minA, maxA), 0.5)
    centerB = BGE.Math.VectorOps.scale(BGE.Math.VectorOps.add(minB, maxB), 0.5)

    if overlapX <= overlapY and overlapX <= overlapZ
      sign = 1.0
      if centerA.x < centerB.x
        sign = -1.0
      end if
      return new BGE.Box3dCollisionResult(true, BGE.Math.VectorOps.create(sign, 0, 0), overlapX)
    else if overlapY <= overlapZ
      sign = 1.0
      if centerA.y < centerB.y
        sign = -1.0
      end if
      return new BGE.Box3dCollisionResult(true, BGE.Math.VectorOps.create(0, sign, 0), overlapY)
    else
      sign = 1.0
      if centerA.z < centerB.z
        sign = -1.0
      end if
      return new BGE.Box3dCollisionResult(true, BGE.Math.VectorOps.create(0, 0, sign), overlapZ)
    end if
  end function


  ' True 3D sphere-vs-AABB overlap test - the only cross-shape pair this engine's 3D
  ' collision system supports.
  '
  ' @param {BGE.Math.Vector} sphereCenter
  ' @param {float} radius
  ' @param {BGE.Math.Vector} boxMin
  ' @param {BGE.Math.Vector} boxMax
  ' @return {BGE.Sphere3dCollisionResult} normal points away from the box, toward the sphere
  function sphereBoxOverlap(sphereCenter as BGE.Math.Vector, radius as float, boxMin as BGE.Math.Vector, boxMax as BGE.Math.Vector) as BGE.Sphere3dCollisionResult
    closest = BGE.Math.VectorOps.create(
    BGE.Math.Max(boxMin.x, BGE.Math.Min(sphereCenter.x, boxMax.x)),
    BGE.Math.Max(boxMin.y, BGE.Math.Min(sphereCenter.y, boxMax.y)),
    BGE.Math.Max(boxMin.z, BGE.Math.Min(sphereCenter.z, boxMax.z)))
    diff = BGE.Math.VectorOps.subtract(sphereCenter, closest)
    dist = BGE.Math.VectorOps.length(diff)

    if dist > 0.0
      if dist >= radius
        return new BGE.Sphere3dCollisionResult(false, BGE.Math.VectorOps.create(0, 1, 0), 0.0)
      end if
      return new BGE.Sphere3dCollisionResult(true, BGE.Math.VectorOps.scale(diff, 1.0 / dist), radius - dist)
    end if

    ' Sphere center is inside the box (common for a thin wall slab) - push out through
    ' whichever face is closest.
    faces = [
    {d: sphereCenter.x - boxMin.x, normal: BGE.Math.VectorOps.create(-1, 0, 0)},
    {d: boxMax.x - sphereCenter.x, normal: BGE.Math.VectorOps.create(1, 0, 0)},
    {d: sphereCenter.y - boxMin.y, normal: BGE.Math.VectorOps.create(0, -1, 0)},
    {d: boxMax.y - sphereCenter.y, normal: BGE.Math.VectorOps.create(0, 1, 0)},
    {d: sphereCenter.z - boxMin.z, normal: BGE.Math.VectorOps.create(0, 0, -1)},
    {d: boxMax.z - sphereCenter.z, normal: BGE.Math.VectorOps.create(0, 0, 1)}
    ]
    closestFace = faces[0]
    for each face in faces
      if face.d < closestFace.d
        closestFace = face
      end if
    end for
    return new BGE.Sphere3dCollisionResult(true, closestFace.normal, radius + closestFace.d)
  end function


  ' Box-vs-box overlap where each box may be turned about the y axis through its centre
  ' (BoxCollider3d.yaw): a separating-axis test on the boxes' four x/z face axes plus y.
  '
  ' @param {BGE.Math.Vector} centerA
  ' @param {BGE.Math.Vector} halfA half width, height, depth
  ' @param {float} yawA radians
  ' @param {BGE.Math.Vector} centerB
  ' @param {BGE.Math.Vector} halfB
  ' @param {float} yawB
  ' @return {BGE.Box3dCollisionResult} normal points away from B, toward A, along the axis of least penetration
  function orientedBoxOverlap(centerA as BGE.Math.Vector, halfA as BGE.Math.Vector, yawA as float, centerB as BGE.Math.Vector, halfB as BGE.Math.Vector, yawB as float) as BGE.Box3dCollisionResult
    none = new BGE.Box3dCollisionResult(false, BGE.Math.VectorOps.create(0, 1, 0), 0.0)
    dy = centerA.y - centerB.y
    bestDepth = halfA.y + halfB.y - Abs(dy)
    if bestDepth <= 0
      return none
    end if
    ySign = 1.0
    if dy < 0
      ySign = -1.0
    end if
    bestX = 0.0
    bestY = ySign
    bestZ = 0.0
    cosA = Cos(yawA)
    sinA = Sin(yawA)
    cosB = Cos(yawB)
    sinB = Sin(yawB)
    dx = centerA.x - centerB.x
    dz = (centerA.z ?? 0.0) - (centerB.z ?? 0.0)
    ' each box's local x axis is (cos, sin) in x/z, its local z axis (-sin, cos)
    axes = [cosA, sinA, -sinA, cosA, cosB, sinB, -sinB, cosB]
    for i = 0 to 6 step 2
      lx = axes[i]
      lz = axes[i + 1]
      radiusA = halfA.x * Abs(lx * cosA + lz * sinA) + halfA.z * Abs(lz * cosA - lx * sinA)
      radiusB = halfB.x * Abs(lx * cosB + lz * sinB) + halfB.z * Abs(lz * cosB - lx * sinB)
      distance = lx * dx + lz * dz
      depth = radiusA + radiusB - Abs(distance)
      if depth <= 0
        return none
      end if
      if depth < bestDepth
        bestDepth = depth
        sign = 1.0
        if distance < 0
          sign = -1.0
        end if
        bestX = lx * sign
        bestY = 0.0
        bestZ = lz * sign
      end if
    end for
    return new BGE.Box3dCollisionResult(true, BGE.Math.VectorOps.create(bestX, bestY, bestZ), bestDepth)
  end function


  ' Sphere-vs-box overlap where the box is turned about the y axis through its centre
  ' (BoxCollider3d.yaw): sphereBoxOverlap() in the box's own frame.
  '
  ' @param {BGE.Math.Vector} sphereCenter
  ' @param {float} radius
  ' @param {BGE.Math.Vector} boxCenter
  ' @param {BGE.Math.Vector} half half width, height, depth
  ' @param {float} yaw radians
  ' @return {BGE.Sphere3dCollisionResult} normal points away from the box, toward the sphere
  function sphereOrientedBoxOverlap(sphereCenter as BGE.Math.Vector, radius as float, boxCenter as BGE.Math.Vector, half as BGE.Math.Vector, yaw as float) as BGE.Sphere3dCollisionResult
    c = Cos(yaw)
    s = Sin(yaw)
    rx = sphereCenter.x - boxCenter.x
    ry = sphereCenter.y - boxCenter.y
    rz = (sphereCenter.z ?? 0.0) - (boxCenter.z ?? 0.0)
    localCenter = BGE.Math.VectorOps.create(rx * c + rz * s, ry, rz * c - rx * s)
    result = sphereBoxOverlap(localCenter, radius, BGE.Math.VectorOps.negative(half), half)
    n = result.normal
    result.normal = BGE.Math.VectorOps.create(n.x * c - n.z * s, n.y, n.x * s + n.z * c)
    return result
  end function

end namespace
