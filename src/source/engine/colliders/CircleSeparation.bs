import "../../math/vector.bs"

namespace BGE

  ' Which pair of axes BGE.separateCircles() pushes bodies apart on.
  enum SeparationPlane
    ' The ground in a 3D game (x and z); height is ignored
    xz = "xz"
    ' A 2D game, e.g. top-down (x and y)
    xy = "xy"
  end enum

  ' One body for BGE.separateCircles(). `position` is moved in place, so pass the entity's own
  ' position vector, e.g. {position: entity.position, radius: 12, mass: 1}.
  interface CircleBody extends roAssociativeArray
    position as BGE.Math.Vector
    radius as float
    ' 0 or less is immovable: only the other body moves
    mass as float
  end interface

  ' Pushes overlapping circular bodies apart, so characters can't walk through each other. Each
  ' overlap is split by mass: the lighter body moves further. Call it once per frame after
  ' everything has moved, e.g. from GameScene.onPostUpdate(), so the result doesn't depend on
  ' entity update order. Pairwise, so it suits tens of bodies, not crowds of hundreds.
  '
  ' @param {BGE.CircleBody[]} bodies
  ' @param {BGE.SeparationPlane} [plane="xz"]
  ' @return {integer} how many overlapping pairs were pushed apart
  function separateCircles(bodies as BGE.CircleBody[], plane = BGE.SeparationPlane.xz as BGE.SeparationPlane) as integer
    useY = plane = BGE.SeparationPlane.xy
    pushed = 0
    for i = 0 to bodies.Count() - 2
      a = bodies[i]
      for j = i + 1 to bodies.Count() - 1
        b = bodies[j]
        if a.mass <= 0 and b.mass <= 0
          continue for
        end if
        minDistance = a.radius + b.radius
        du = b.position.x - a.position.x
        if useY
          dv = b.position.y - a.position.y
        else
          dv = b.position.z - a.position.z
        end if
        if Abs(du) >= minDistance or Abs(dv) >= minDistance
          continue for
        end if
        distance = Sqr(du * du + dv * dv)
        if distance >= minDistance
          continue for
        end if
        overlap = minDistance - distance
        if distance < 0.001
          ' on top of each other: pick any direction
          nu = 1.0
          nv = 0.0
        else
          nu = du / distance
          nv = dv / distance
        end if
        if a.mass <= 0
          aShare = 0.0
        else if b.mass <= 0
          aShare = 1.0
        else
          aShare = b.mass / (a.mass + b.mass)
        end if
        bShare = 1 - aShare
        a.position.x -= nu * overlap * aShare
        b.position.x += nu * overlap * bShare
        if useY
          a.position.y -= nv * overlap * aShare
          b.position.y += nv * overlap * bShare
        else
          a.position.z -= nv * overlap * aShare
          b.position.z += nv * overlap * bShare
        end if
        pushed++
      end for
    end for
    return pushed
  end function

end namespace
