namespace tests

  ' Constructs a real BGE.Game/GameEntity so the collider gets a real
  ' roCompositor sprite behind it (setupCompositor), the same pattern
  ' proven in GameEntity.spec.bs.
  @suite("BGE.CircleCollider")
  class CircleColliderTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
    end function

    @describe("new")

    @it("sets colliderType to 'circle' and stores the given radius")
    function _()
      collider = m.entity.addCircleCollider("body", 15)
      m.assertEqual("circle", collider.colliderType)
      m.assertEqual(15.0, collider.radius)
    end function

    @it("defaults to enabled with a zero offset")
    function _()
      collider = m.entity.addCircleCollider("body", 15)
      m.assertTrue(collider.enabled)
      m.assertTrue(BGE.Math.VectorOps.isZero(collider.offset))
    end function

    @it("accepts an explicit offset")
    function _()
      collider = m.entity.addCircleCollider("body", 15, 5, 10)
      m.assertEqual(5.0, collider.offset.x)
      m.assertEqual(10.0, collider.offset.y)
    end function

    @describe("refreshColliderRegion / debugDraw")

    @it("refreshColliderRegion does not error against the real compositor region")
    function _()
      collider = m.entity.addCircleCollider("body", 15)
      collider.refreshColliderRegion()
    end function

    @it("debugDraw does not error against a real Renderer")
    function _()
      collider = m.entity.addCircleCollider("body", 15)
      collider.debugDraw(m.game.canvas.renderer, m.entity.position)
    end function

    @describe("raycastCheck")

    @it("reports a hit, with entity/collider left invalid, for a ray that crosses the circle")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(0, 0)
      collider = m.entity.addCircleCollider("body", 5)
      hit = collider.raycastCheck(m.entity.position, BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0), 1000.0)
      m.assertNotInvalid(hit)
      m.assertInvalid(hit.entity)
      m.assertInvalid(hit.collider)
      m.assertTrue(Abs(hit.distance - 15.0) < 0.0001)
    end function

    @it("accounts for the entity's position and the collider's own offset")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(100, 0)
      collider = m.entity.addCircleCollider("body", 5, 10, 0)
      hit = collider.raycastCheck(m.entity.position, BGE.Math.VectorOps.create(0, 0), BGE.Math.VectorOps.create(1, 0), 1000.0)
      m.assertNotInvalid(hit)
      m.assertTrue(Abs(hit.distance - 105.0) < 0.0001)
    end function

    @it("returns invalid for a ray that misses the circle")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(0, 100)
      collider = m.entity.addCircleCollider("body", 5)
      hit = collider.raycastCheck(m.entity.position, BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0), 1000.0)
      m.assertInvalid(hit)
    end function

  end class

end namespace
