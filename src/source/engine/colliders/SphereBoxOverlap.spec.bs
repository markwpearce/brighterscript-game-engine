namespace tests

  @suite("BGE.sphereBoxOverlap")
  class SphereBoxOverlapTests extends rooibos.BaseTestSuite

    @describe("sphereBoxOverlap")

    @it("reports no overlap when the sphere is far from the box")
    function _()
      result = BGE.sphereBoxOverlap(BGE.Math.VectorOps.create(100, 0, 0), 5.0, BGE.Math.VectorOps.create(-10, -10, -10), BGE.Math.VectorOps.create(10, 10, 10))
      m.assertFalse(result.overlapping)
    end function

    @it("reports overlap when the sphere touches a box face, with normal pointing away from the box")
    function _()
      result = BGE.sphereBoxOverlap(BGE.Math.VectorOps.create(13, 0, 0), 5.0, BGE.Math.VectorOps.create(-10, -10, -10), BGE.Math.VectorOps.create(10, 10, 10))
      m.assertTrue(result.overlapping)
      m.assertTrue(Abs(result.normal.x - 1.0) < 0.0001)
      m.assertTrue(Abs(result.normal.y) < 0.0001)
      m.assertTrue(Abs(result.normal.z) < 0.0001)
      m.assertTrue(Abs(result.penetrationDepth - 2.0) < 0.0001) ' radius (5) - distance to face (3)
    end function

    @it("pushes out through the nearest face when the sphere center is inside the box (a thin wall slab)")
    function _()
      ' Box is a thin wall slab spanning z -1..1; sphere center sits inside it, closer to
      ' the +z face (1.0 away) than the -z face (1.5 away) or any x/y face (10 away).
      result = BGE.sphereBoxOverlap(BGE.Math.VectorOps.create(0, 0, 0.5), 5.0, BGE.Math.VectorOps.create(-10, -10, -1), BGE.Math.VectorOps.create(10, 10, 1))
      m.assertTrue(result.overlapping)
      m.assertEqual(0.0, result.normal.x)
      m.assertEqual(0.0, result.normal.y)
      m.assertEqual(1.0, result.normal.z)
      m.assertEqual(5.5, result.penetrationDepth) ' radius (5) + distance to nearest (+z) face (0.5)
    end function

  end class

end namespace
