import "pkg:/source/engine/loading/DownloadPaths.bs"
import "pkg:/source/engine/loading/DownloadTask.bs"

namespace tests

  @suite("BGE.DownloadTask")
  class DownloadTaskTests extends rooibos.BaseTestSuite

    fs as roFileSystem

    protected override function beforeEach()
      m.fs = CreateObject("roFileSystem")
      for each folder in [BGE.Downloads.CACHE_FOLDER, BGE.Downloads.TEMP_FOLDER]
        for each fileName in m.fs.GetDirectoryListing(folder)
          m.fs.Delete(folder + "/" + fileName)
        end for
      end for
    end function

    @describe("cache")

    @it("uses a cached file without a request")
    function _()
      url = "https://example.com/cached.png"
      m.fs.CreateDirectory(BGE.Downloads.CACHE_FOLDER)
      WriteAsciiFile(BGE.Downloads.getPath(url, true), "cached")
      task = new tests.ScriptedDownloadTask(url, {}, [])
      m.assertTrue(task.step(12))
      m.assertTrue(task.fromCache)
      m.assertEqual(BGE.Downloads.getPath(url, true), task.localPath)
      m.assertEqual(0, task.transfersCreated)
      m.assertInvalid(task.error)
    end function

    @it("downloads into the cache")
    function _()
      url = "https://example.com/fresh.png"
      task = new tests.ScriptedDownloadTask(url, {}, [{code: 200, body: "fresh"}])
      m.assertTrue(tests.runDownload(task))
      m.assertInvalid(task.error)
      m.assertFalse(task.fromCache)
      m.assertEqual(BGE.Downloads.getPath(url, true), task.localPath)
      m.assertEqual("fresh", ReadAsciiFile(task.localPath))
      m.assertEqual(1, m.fs.GetDirectoryListing(BGE.Downloads.CACHE_FOLDER).count())
    end function

    @it("downloads again over a cached file with refresh")
    function _()
      url = "https://example.com/refresh.png"
      m.fs.CreateDirectory(BGE.Downloads.CACHE_FOLDER)
      WriteAsciiFile(BGE.Downloads.getPath(url, true), "old")
      task = new tests.ScriptedDownloadTask(url, {refresh: true}, [{code: 200, body: "new"}])
      tests.runDownload(task)
      m.assertEqual(1, task.transfersCreated)
      m.assertEqual("new", ReadAsciiFile(task.localPath))
    end function

    @it("downloads to tmp with cache false")
    function _()
      task = new tests.ScriptedDownloadTask("https://example.com/temp.png", {cache: false}, [{code: 200, body: "t"}])
      tests.runDownload(task)
      m.assertTrue(task.localPath.StartsWith("tmp:/bge/"))
    end function

    @describe("file types")

    @it("saves an extensionless URL with the Content-Type's extension and finds it in the cache")
    function _()
      url = "https://example.com/photo"
      task = new tests.ScriptedDownloadTask(url, {}, [{code: 200, body: "jpeg", headers: {"content-type": "image/jpeg"}}])
      tests.runDownload(task)
      m.assertInvalid(task.error)
      m.assertEqual(BGE.Downloads.getBasePath(url, true) + ".jpg", task.localPath)
      again = new tests.ScriptedDownloadTask(url, {}, [])
      m.assertTrue(again.step(12))
      m.assertTrue(again.fromCache)
      m.assertEqual(task.localPath, again.localPath)
      m.assertEqual(0, again.transfersCreated)
    end function

    @it("sniffs an octet-stream download's type from its bytes")
    function _()
      url = "https://example.com/download"
      bitmap = CreateObject("roBitmap", {width: 2, height: 2, AlphaEnable: true})
      task = new tests.ScriptedDownloadTask(url, {}, [{code: 200, bodyBytes: bitmap.GetPng(0, 0, 2, 2), headers: {"content-type": "application/octet-stream"}}])
      tests.runDownload(task)
      m.assertEqual(BGE.Downloads.getBasePath(url, true) + ".png", task.localPath)
    end function

    @it("uses options.extension over everything else")
    function _()
      url = "https://example.com/wrong.png"
      task = new tests.ScriptedDownloadTask(url, {extension: ".jpg"}, [{code: 200, body: "x", headers: {"content-type": "image/png"}}])
      tests.runDownload(task)
      m.assertEqual(BGE.Downloads.getBasePath(url, true) + ".jpg", task.localPath)
    end function

    @it("saves a script URL with the Content-Type's extension")
    function _()
      url = "https://example.com/image.php?id=5"
      task = new tests.ScriptedDownloadTask(url, {}, [{code: 200, body: "x", headers: {"content-type": "image/png"}}])
      tests.runDownload(task)
      m.assertEqual(BGE.Downloads.getBasePath(url, true) + ".png", task.localPath)
    end function

    @it("falls back to the URL's own extension, then none")
    function _()
      jsonUrl = "https://example.com/data.json"
      json = new tests.ScriptedDownloadTask(jsonUrl, {}, [{code: 200, body: "{}", headers: {"content-type": "application/json"}}])
      tests.runDownload(json)
      m.assertEqual(BGE.Downloads.getBasePath(jsonUrl, true) + ".json", json.localPath)
      plainUrl = "https://example.com/plain"
      plain = new tests.ScriptedDownloadTask(plainUrl, {}, [{code: 200, body: "text"}])
      tests.runDownload(plain)
      m.assertEqual(BGE.Downloads.getBasePath(plainUrl, true), plain.localPath)
      plainAgain = new tests.ScriptedDownloadTask(plainUrl, {}, [])
      m.assertTrue(plainAgain.step(12))
      m.assertTrue(plainAgain.fromCache)
    end function

    @it("replaces a cached copy of another type on refresh")
    function _()
      url = "https://example.com/changes"
      first = new tests.ScriptedDownloadTask(url, {}, [{code: 200, body: "a", headers: {"content-type": "image/gif"}}])
      tests.runDownload(first)
      second = new tests.ScriptedDownloadTask(url, {refresh: true}, [{code: 200, body: "b", headers: {"content-type": "image/png"}}])
      tests.runDownload(second)
      m.assertEqual(BGE.Downloads.getBasePath(url, true) + ".png", second.localPath)
      m.assertFalse(m.fs.Exists(first.localPath))
      m.assertEqual(1, m.fs.GetDirectoryListing(BGE.Downloads.CACHE_FOLDER).count())
    end function

    @it("uses the last content-type line after a redirect")
    function _()
      url = "https://example.com/redirected"
      headerLines = [{"Content-Type": "text/html"}, {"Location": "https://cdn.example.com/a"}, {"Content-Type": "image/png"}]
      task = new tests.ScriptedDownloadTask(url, {}, [{code: 200, body: "x", headers: {"content-type": "text/html"}, headersArray: headerLines}])
      tests.runDownload(task)
      m.assertEqual(BGE.Downloads.getBasePath(url, true) + ".png", task.localPath)
    end function

    @it("falls back to the merged headers without GetResponseHeadersArray()")
    function _()
      url = "https://example.com/legacy"
      task = new tests.ScriptedDownloadTask(url, {}, [{code: 200, body: "x", headers: {"content-type": "image/gif"}, legacyEvent: true}])
      tests.runDownload(task)
      m.assertEqual(BGE.Downloads.getBasePath(url, true) + ".gif", task.localPath)
    end function

    @it("deletes a copy saved with another extension option")
    function _()
      url = "https://example.com/retyped"
      first = new tests.ScriptedDownloadTask(url, {extension: ".jpg"}, [{code: 200, body: "a"}])
      tests.runDownload(first)
      second = new tests.ScriptedDownloadTask(url, {extension: ".png"}, [{code: 200, body: "b"}])
      tests.runDownload(second)
      m.assertEqual(1, second.transfersCreated)
      m.assertFalse(m.fs.Exists(first.localPath))
      m.assertEqual(1, m.fs.GetDirectoryListing(BGE.Downloads.CACHE_FOLDER).count())
    end function

    @it("doesn't take another download's partial file for a cached copy")
    function _()
      url = "https://example.com/partial"
      m.fs.CreateDirectory(BGE.Downloads.CACHE_FOLDER)
      WriteAsciiFile(BGE.Downloads.getBasePath(url, true) + ".123.part", "half")
      task = new tests.ScriptedDownloadTask(url, {}, [{code: 200, body: "x", headers: {"content-type": "image/png"}}])
      tests.runDownload(task)
      m.assertFalse(task.fromCache)
      m.assertEqual(1, task.transfersCreated)
    end function

    @describe("requests")

    @it("sets up certificates for https only")
    function _()
      secure = new tests.ScriptedDownloadTask("https://example.com/s.png", {}, [{code: 200, body: "s"}])
      tests.runDownload(secure)
      m.assertEqual("common:/certs/ca-bundle.crt", secure.lastTransfer.certificatesFile)
      m.assertEqual("https://example.com/s.png", secure.lastTransfer.url)
      plain = new tests.ScriptedDownloadTask("http://example.com/p.png", {}, [{code: 200, body: "p"}])
      tests.runDownload(plain)
      m.assertEqual("", plain.lastTransfer.certificatesFile)
    end function

    @it("fails a URL-less path without a request")
    function _()
      task = new tests.ScriptedDownloadTask("pkg:/images/a.png", {}, [])
      m.assertTrue(task.step(12))
      m.assertNotInvalid(task.error)
      m.assertEqual(0, task.transfersCreated)
    end function

    @it("gives two downloads of the same URL their own temporary files")
    function _()
      first = new tests.ScriptedDownloadTask("https://example.com/same.png", {}, [{hang: true}])
      second = new tests.ScriptedDownloadTask("https://example.com/same.png", {}, [{hang: true}])
      first.step(12)
      second.step(12)
      m.assertNotEqual(first.lastTransfer.toFilePath, second.lastTransfer.toFilePath)
    end function

    @describe("failures")

    @it("fails a 404 without retrying and leaves nothing behind")
    function _()
      url = "https://example.com/missing.png"
      task = new tests.ScriptedDownloadTask(url, {}, [{code: 404, body: "not found"}, {code: 200, body: "never"}])
      tests.runDownload(task)
      m.assertNotInvalid(task.error)
      m.assertTrue(task.error.Instr("404") >= 0)
      m.assertEqual(1, task.transfersCreated)
      m.assertEqual("", task.localPath)
      m.assertEqual(0, m.fs.GetDirectoryListing(BGE.Downloads.CACHE_FOLDER).count())
    end function

    @it("retries a server error")
    function _()
      task = new tests.ScriptedDownloadTask("https://example.com/flaky.png", {}, [{code: 503, body: "busy"}, {code: 200, body: "ok"}])
      tests.runDownload(task)
      m.assertInvalid(task.error)
      m.assertEqual(2, task.transfersCreated)
      m.assertEqual("ok", ReadAsciiFile(task.localPath))
    end function

    @it("gives up on a network error once its retries are used")
    function _()
      task = new tests.ScriptedDownloadTask("https://example.com/down.png", {retries: 1}, [{code: -6, body: ""}, {code: -6, body: ""}, {code: 200, body: "late"}])
      tests.runDownload(task)
      m.assertNotInvalid(task.error)
      m.assertEqual(2, task.transfersCreated)
    end function

    @it("times out a stalled download and cancels it")
    function _()
      task = new tests.ScriptedDownloadTask("https://example.com/slow.png", {timeoutSeconds: 1, retries: 0}, [{hang: true, partialBody: "half"}])
      m.assertFalse(task.step(12))
      stalled = task.lastTransfer
      task.timer.addTime(1000)
      m.assertTrue(task.step(12))
      m.assertTrue(stalled.cancelled)
      m.assertTrue(task.error.Instr("timed out") >= 0)
      m.assertEqual(0, m.fs.GetDirectoryListing(BGE.Downloads.CACHE_FOLDER).count())
    end function

    @describe("progress")

    @it("reports 0 while downloading, even with a partial file and content-length")
    function _()
      task = new tests.ScriptedDownloadTask("https://example.com/big.png", {}, [{hang: true, partialBody: "12345", headers: {"content-length": "10"}}])
      task.step(12)
      ' a non-completion event is ignored
      m.assertFalse(task.step(12))
      m.assertEqual(0.0, task.getProgress())
    end function

    @it("reports 1 when done")
    function _()
      task = new tests.ScriptedDownloadTask("https://example.com/done.png", {}, [{code: 200, body: "x", headers: {"content-length": "1"}}])
      tests.runDownload(task)
      m.assertEqual(1.0, task.getProgress())
    end function

    @describe("slots")

    @it("waits for a free slot")
    function _()
      slots = new BGE.DownloadSlots()
      slots.max = 1
      first = new tests.ScriptedDownloadTask("https://example.com/one.png", {}, [{code: 200, body: "1"}])
      first.slots = slots
      second = new tests.ScriptedDownloadTask("https://example.com/two.png", {}, [{code: 200, body: "2"}])
      second.slots = slots
      first.step(12)
      m.assertFalse(second.step(12))
      m.assertTrue(second.waitingForNextFrame)
      m.assertEqual(0, second.transfersCreated)
      tests.runDownload(first)
      m.assertEqual(0, slots.active)
      tests.runDownload(second)
      m.assertInvalid(second.error)
    end function

  end class

  ' Steps a download until it finishes (or 20 steps pass). Returns whether it finished.
  function runDownload(task as BGE.DownloadTask) as boolean
    for i = 1 to 20
      if task.step(12)
        return true
      end if
    end for
    return false
  end function

  ' A DownloadTask whose transfers play back `responses` in order, one per attempt. Each response
  ' is {code, body} (or {code, bodyBytes} for an roByteArray) to finish, or {hang: true} to never finish; `partialBody` writes a partial file
  ' and `headers` go on the event. A hanging response sends a non-completion (type 2) event, which
  ' a real Roku never sends but the task must ignore.
  class ScriptedDownloadTask extends BGE.DownloadTask
    responses as roArray
    transfersCreated as integer = 0
    lastTransfer as dynamic = invalid

    sub new(url as string, options as BGE.DownloadOptions, responses as roArray)
      super(url, options)
      m.responses = responses
    end sub

    override function createTransfer() as dynamic
      m.transfersCreated++
      response = invalid
      if m.responses.count() > 0
        response = m.responses.Shift()
      end if
      transfer = new tests.FakeTransfer(response)
      m.lastTransfer = transfer
      return transfer
    end function

    override function createPort() as dynamic
      port = new tests.FakePort()
      return port
    end function
  end class

  class FakePort
    queue as roArray

    sub new()
      m.queue = []
    end sub

    function GetMessage() as dynamic
      if m.queue.count() = 0
        return invalid
      end if
      return m.queue.Shift()
    end function
  end class

  ' A completion event. GetResponseHeadersArray() returns `headersArray` (one AA per header
  ' line), or [] when the response didn't give one.
  class FakeUrlEvent
    eventType as integer
    code as integer
    headers as roAssociativeArray
    headersArray as roArray

    sub new(eventType as integer, code as integer, headers as roAssociativeArray)
      m.eventType = eventType
      m.code = code
      m.headers = headers
      m.headersArray = []
    end sub

    function GetResponseHeadersArray() as roArray
      return m.headersArray
    end function

    function GetInt() as integer
      return m.eventType
    end function

    function GetResponseCode() as integer
      return m.code
    end function

    function GetFailureReason() as string
      return "fake failure"
    end function

    function GetResponseHeaders() as roAssociativeArray
      return m.headers
    end function
  end class

  ' A completion event without GetResponseHeadersArray().
  class FakeLegacyUrlEvent
    code as integer
    headers as roAssociativeArray

    sub new(code as integer, headers as roAssociativeArray)
      m.code = code
      m.headers = headers
    end sub

    function GetInt() as integer
      return 1
    end function

    function GetResponseCode() as integer
      return m.code
    end function

    function GetFailureReason() as string
      return ""
    end function

    function GetResponseHeaders() as roAssociativeArray
      return m.headers
    end function
  end class

  class FakeTransfer
    response as dynamic
    port as dynamic = invalid
    url as string = ""
    certificatesFile as string = ""
    toFilePath as string = ""
    cancelled as boolean = false

    sub new(response as dynamic)
      m.response = response
    end sub

    sub SetMessagePort(port as dynamic)
      m.port = port
    end sub

    sub SetUrl(url as string)
      m.url = url
    end sub

    sub SetCertificatesFile(path as string)
      m.certificatesFile = path
    end sub

    sub InitClientCertificates()
    end sub

    function AsyncGetToFile(filePath as string) as boolean
      m.toFilePath = filePath
      if m.response = invalid
        return false
      end if
      headers = {}
      if m.response.headers <> invalid
        headers = m.response.headers
      end if
      if m.response.hang <> invalid and m.response.hang
        if m.response.partialBody <> invalid
          WriteAsciiFile(filePath, m.response.partialBody)
        end if
        startedEvent = new tests.FakeUrlEvent(2, 0, headers)
        m.port.queue.push(startedEvent)
        return true
      end if
      if m.response.bodyBytes <> invalid
        m.response.bodyBytes.WriteFile(filePath)
      else
        WriteAsciiFile(filePath, m.response.body)
      end if
      if m.response.legacyEvent <> invalid and m.response.legacyEvent
        legacyEvent = new tests.FakeLegacyUrlEvent(m.response.code, headers)
        m.port.queue.push(legacyEvent)
        return true
      end if
      completeEvent = new tests.FakeUrlEvent(1, m.response.code, headers)
      if m.response.headersArray <> invalid
        completeEvent.headersArray = m.response.headersArray
      end if
      m.port.queue.push(completeEvent)
      return true
    end function

    function AsyncCancel() as boolean
      m.cancelled = true
      return true
    end function
  end class

end namespace
