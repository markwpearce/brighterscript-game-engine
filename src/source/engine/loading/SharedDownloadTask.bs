import "AssetLoader.bs"
import "DownloadTask.bs"

namespace BGE

  ' A download of a URL that another task in the same AssetLoader is already downloading. It waits
  ' for that download and uses its file, rather than requesting the URL again. If that download
  ' is aborted, this one downloads the URL itself. Made by `AssetLoader.getDownloadTask()`.
  class SharedDownloadTask extends DownloadTask

    ' The download this one is waiting for
    leader as BGE.DownloadTask

    private loader as BGE.AssetLoader
    private options as BGE.DownloadOptions
    private ownDownload as BGE.DownloadTask = invalid

    sub new(leader as BGE.DownloadTask, loader as BGE.AssetLoader, options as BGE.DownloadOptions)
      super(leader.url, options)
      m.leader = leader
      m.loader = loader
      m.options = options
    end sub

    override function step(budgetMs as integer) as boolean
      if m.ownDownload = invalid and m.leader.wasAborted()
        m.ownDownload = m.loader.newDownloadTask(m.url, m.options)
      end if
      source = m.leader
      if m.ownDownload <> invalid
        source = m.ownDownload
      end if
      if not source.step(budgetMs)
        m.waitingForNextFrame = true
        return false
      end if
      m.localPath = source.localPath
      m.fromCache = source.fromCache
      m.elapsedMs = source.elapsedMs
      m.error = source.error
      return true
    end function

    ' Aborts only this task's own download - the shared one belongs to another task.
    override sub abort()
      if m.ownDownload <> invalid
        m.ownDownload.abort()
      end if
    end sub

  end class

end namespace
