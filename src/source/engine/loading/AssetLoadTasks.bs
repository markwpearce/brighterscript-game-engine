import "../Game.bs"
import "../debug/LogLevel.bs"
import "../drawables/Model3d.bs"
import "../../utils/fileTypes.bs"
import "../../utils/parsers/ModelParseTask.bs"
import "../../utils/parsers/OBJParser.bs"
import "../../utils/parsers/OBJParseTask.bs"
import "../../utils/parsers/STLParseTask.bs"
import "../../utils/urls.bs"
import "AssetLoader.bs"
import "DownloadTask.bs"
import "LoadTask.bs"
import "TextureLoader.bs"

namespace BGE

  ' Base for the built-in loads. Given a URL, the AssetLoader attaches a `download`; this task
  ' runs it first, then loads the downloaded file. Subclasses override `loadFile()` (and
  ' `getFileProgress()` if loading takes more than one step) rather than `step()`.
  class FileLoadTask extends LoadTask

    ' The file to load - the download's local file once downloaded
    path as string
    ' The path or URL this task was given, for messages
    source as string
    ' Downloads `path` first when it's a URL (invalid for a local file)
    download as BGE.DownloadTask = invalid
    ' Share of this task's progress that the download counts for
    downloadShare as float = 0.8

    private downloaded as boolean = false

    sub new(path as string)
      super()
      m.path = path
      m.source = path
    end sub

    override function step(budgetMs as integer) as boolean
      if m.download <> invalid and not m.downloaded
        if not m.download.step(budgetMs)
          m.waitingForNextFrame = true
          return false
        end if
        m.downloaded = true
        if m.download.error <> invalid
          m.error = m.download.error
          return true
        end if
        m.path = m.download.localPath
      end if
      if not m.loadFile(budgetMs)
        return false
      end if
      if m.error <> invalid and m.download <> invalid and m.download.localPath <> "" and m.isDownloadedFileBad()
        ' e.g. a captive-portal page served with a 200 - don't keep failing on the cached copy
        CreateObject("roFileSystem").Delete(m.download.localPath)
        m.error = m.error + "; the downloaded copy was discarded"
      end if
      return true
    end function

    ' Whether a downloaded file that failed to load is broken, so it's deleted rather than kept
    ' in the cache. A load can fail with a good file, e.g. when texture memory runs out, so
    ' override this to check the file itself. The default says it's broken.
    '
    ' @return {boolean}
    function isDownloadedFileBad() as boolean
      return true
    end function

    ' Releases the download's slot if step() threw.
    override sub abort()
      if m.download <> invalid
        m.download.abort()
      end if
    end sub

    override function getProgress() as float
      if m.done
        return 1.0
      end if
      if m.download = invalid
        return m.getFileProgress()
      end if
      if not m.downloaded
        return m.download.getProgress() * m.downloadShare
      end if
      return m.downloadShare + (1 - m.downloadShare) * m.getFileProgress()
    end function

    ' Loads the local file at `path`. Called repeatedly until it returns true.
    '
    ' @param {integer} budgetMs
    ' @return {boolean} true when finished (set `error` on failure)
    function loadFile(budgetMs as integer) as boolean
      return true
    end function

    ' How far `loadFile()` has got, 0 to 1.
    '
    ' @return {float}
    function getFileProgress() as float
      return 0.0
    end function

  end class

  ' Options for `BGE.AssetLoader.loadBitmap()`.
  interface BitmapLoadOptions extends DownloadOptions
    ' resize to this width while loading (give height too)
    optional width as integer
    ' resize to this height while loading (give width too)
    optional height as integer
    ' false resizes with nearest neighbour, for crisp pixel art (default true, smooth)
    optional smooth as boolean
    ' true if you'll draw into this bitmap. It's decoded the slower way, in one frame, since
    ' before Roku OS 16 the texture manager's bitmaps can't be drawn into (default false)
    optional drawable as boolean
  end interface

  ' Loads one bitmap. Decodes with the game's TextureLoader, so a large image doesn't stall a
  ' frame, falling back to Game.loadBitmapFile() for a drawable bitmap or a file it can't decode.
  class BitmapLoadTask extends FileLoadTask

    private game as BGE.Game
    private bitmapName as string
    private width as integer = 0
    private height as integer = 0
    private smooth as boolean = true
    private drawable as boolean = false
    private textureRequest as roTextureRequest = invalid

    sub new(game as BGE.Game, bitmapName as string, path as string, options = invalid as BGE.BitmapLoadOptions)
      super(path)
      m.name = "bitmap " + path
      m.game = game
      m.bitmapName = bitmapName
      if options = invalid
        return
      end if
      width = m.toPixelSize(options.width)
      height = m.toPixelSize(options.height)
      if width > 0 and height > 0
        m.width = width
        m.height = height
      else if options.width <> invalid or options.height <> invalid
        game.log("BGE.AssetLoader.loadBitmap() - " + path + ": resizing needs a width and height above 0, loading it at its own size", BGE.Debug.LogLevel.warning)
      end if
      if options.smooth = false
        m.smooth = false
      end if
      if options.drawable = true
        m.drawable = true
      end if
    end sub

    override function loadFile(budgetMs as integer) as boolean
      textureLoader = m.game.getTextureLoader()
      if m.textureRequest = invalid
        if m.drawable or not textureLoader.isAvailable() or not m.isDecodableFile()
          ' also gives the usual error for a missing or unsupported file
          return m.loadOnMainThread()
        end if
        if m.download <> invalid and not m.download.fromCache
          ' a fresh download may have replaced a file the texture manager still holds
          textureLoader.unload(m.path)
        end if
        m.textureRequest = textureLoader.request(m.path, m.width, m.height, m.smooth)
      end if
      result = textureLoader.getResult(m.textureRequest)
      if result = invalid
        m.waitingForNextFrame = true
        return false
      end if
      m.textureRequest = invalid
      if not result.ok
        if result.timedOut = true
          m.game.log("BGE.AssetLoader - the texture manager didn't answer for " + m.source + ", loading it on the main thread", BGE.Debug.LogLevel.warning)
        end if
        return m.loadOnMainThread()
      end if
      bitmap = result.bitmap
      if m.width > 0 and (bitmap.GetWidth() <> m.width or bitmap.GetHeight() <> m.height)
        ' a Roku decoding the same file for another request at the same time ignores the size
        bitmap = m.resize(bitmap)
        if bitmap = invalid
          m.game.releaseTexturePath(m.path)
          return true
        end if
      end if
      ' recorded even for our own resized copy, so unloadBitmap() frees the manager's full-size one
      m.game.addTextureBitmap(m.bitmapName, bitmap, m.path)
      return true
    end function

    override sub abort()
      super.abort()
      if m.textureRequest <> invalid
        m.game.getTextureLoader().cancel(m.textureRequest)
        m.textureRequest = invalid
        ' the decode may already have finished into the manager's cache
        m.game.releaseTexturePath(m.path)
      end if
    end sub

    ' Bad only if it isn't an image.
    override function isDownloadedFileBad() as boolean
      return not BGE.FileTypes.isImageExtension(BGE.FileTypes.sniffExtension(m.path))
    end function

    private function isDecodableFile() as boolean
      return BGE.FileTypes.isImageExtension(BGE.Urls.fileExtension(m.path)) and CreateObject("roFileSystem").Exists(m.path)
    end function

    private function loadOnMainThread() as boolean
      reason = m.game.loadBitmapFile(m.bitmapName, m.path)
      if reason <> ""
        m.error = "could not load bitmap " + m.source + ": " + reason
        if m.download <> invalid and not m.isDownloadedFileBad()
          m.error = m.error + " (the file is a valid image - out of texture memory?)"
        end if
        return true
      end if
      if m.width > 0
        bitmap = m.game.getBitmap(m.bitmapName)
        if bitmap.GetWidth() <> m.width or bitmap.GetHeight() <> m.height
          resized = m.resize(bitmap)
          if resized = invalid
            m.game.unloadBitmap(m.bitmapName)
          else
            m.game.Bitmaps[m.bitmapName] = resized
          end if
        end if
      end if
      return true
    end function

    ' A resized copy, or invalid with `error` set.
    private function resize(bitmap as roBitmap) as roBitmap
      resized = BGE.resizeBitmap(bitmap, m.width, m.height, m.smooth)
      if resized = invalid
        m.error = "could not resize bitmap " + m.source + " to " + m.width.toStr() + "x" + m.height.toStr() + " (out of texture memory?)"
      end if
      return resized
    end function

    ' A width or height option as whole pixels, or 0 if it isn't a number.
    private function toPixelSize(value as dynamic) as integer
      numberTypes = {"Integer": true, "roInt": true, "roInteger": true, "LongInteger": true, "roLongInteger": true, "Float": true, "roFloat": true, "Double": true, "roDouble": true}
      if not numberTypes.DoesExist(type(value))
        return 0
      end if
      return Int(value)
    end function

  end class

  ' Loads one sound with Game.loadSound().
  class SoundLoadTask extends FileLoadTask

    private game as BGE.Game
    private soundName as string

    sub new(game as BGE.Game, soundName as string, path as string)
      super(path)
      m.name = "sound " + path
      m.game = game
      m.soundName = soundName
    end sub

    override function loadFile(budgetMs as integer) as boolean
      if not CreateObject("roFileSystem").Exists(m.path)
        m.error = "sound file not found: " + m.source
        return true
      end if
      m.game.loadSound(m.soundName, m.path)
      return true
    end function

    ' Bad only if it isn't a .wav or .mp3.
    override function isDownloadedFileBad() as boolean
      sniffed = BGE.FileTypes.sniffExtension(m.path)
      return sniffed <> ".wav" and sniffed <> ".mp3"
    end function

  end class

  ' Registers one font file with Game.registerFontFile().
  class FontLoadTask extends FileLoadTask

    private game as BGE.Game

    sub new(game as BGE.Game, path as string)
      super(path)
      m.name = "font " + path
      m.game = game
    end sub

    override function loadFile(budgetMs as integer) as boolean
      reason = m.game.registerFontFile(m.path)
      if reason <> ""
        m.error = "could not register font " + m.source + ": " + reason
      end if
      return true
    end function

    ' Bad only if it isn't a .ttf or .otf.
    override function isDownloadedFileBad() as boolean
      sniffed = BGE.FileTypes.sniffExtension(m.path)
      return sniffed <> ".ttf" and sniffed <> ".otf"
    end function

  end class

  ' Loads a .obj or .stl model a slice at a time: downloads it if it's a URL, reads the file,
  ' parses it over as many steps as it needs, downloads any remote textures (a remote .obj's
  ' .mtl and every texture it names, or a URL texturePath), then adds it to the game (loading
  ' an .obj's textures).
  class ModelLoadTask extends FileLoadTask

    ' Makes this model's texture downloads. Set by AssetLoader.
    loader as BGE.AssetLoader = invalid
    ' Options for this model's texture downloads. Set by AssetLoader.
    downloadOptions as BGE.DownloadOptions

    private game as BGE.Game
    private modelName as string
    private options as BGE.Model3dLoadOptions
    private parseTask as BGE.Parsers.ModelParseTask = invalid
    private model as BGE.Model3d = invalid
    private isObj as boolean = false
    private parsed as boolean = false
    private modelUrl as string = ""
    ' Texture downloads still running, by URL
    private textureDownloads as roAssociativeArray
    ' Finished texture downloads' local paths by URL ("" for one that failed)
    private downloadedTextures as roAssociativeArray
    private mtlDownload as BGE.DownloadTask = invalid
    private localTexturePath as string = ""
    private unknownExtension as boolean = false

    sub new(game as BGE.Game, modelName as string, path as string, options as BGE.Model3dLoadOptions)
      super(path)
      m.name = "model " + path
      m.game = game
      m.modelName = modelName
      m.options = options
      m.downloadOptions = {}
      m.textureDownloads = {}
      m.downloadedTextures = {}
      m.downloadShare = 0.5
      if BGE.Urls.isUrl(path)
        m.modelUrl = path
      end if
    end sub

    override function loadFile(budgetMs as integer) as boolean
      if not m.parsed
        if m.parseTask = invalid
          return m.startParse()
        end if
        if not m.parseTask.step(budgetMs)
          return false
        end if
        if m.parseTask.error <> invalid
          m.error = m.parseTask.error + " (" + m.source + ")"
          return true
        end if
        m.model = m.parseTask.model
        mtllibName = ""
        if m.isObj
          objTask = m.parseTask as BGE.Parsers.OBJParseTask
          mtllibName = objTask.mtllibName
        end if
        ' the source text isn't needed once parsed
        m.parseTask = invalid
        m.parsed = true
        m.startTextureDownloads(mtllibName)
      end if
      if not m.stepTextureDownloads(budgetMs)
        m.waitingForNextFrame = true
        return false
      end if
      return m.addModel()
    end function

    override function getFileProgress() as float
      if m.parsed
        return 0.95
      end if
      if m.parseTask = invalid
        return 0.0
      end if
      return m.parseTask.getProgress() * 0.9
    end function

    ' Reads the file and creates the parse task. Returns true only if that failed.
    private function startParse() as boolean
      if not CreateObject("roFileSystem").Exists(m.path)
        m.error = "model file not found: " + m.source
        return true
      end if
      ' a download is saved with the extension of its detected type
      extensionLower = LCase(CreateObject("roPath", m.path).Split().extension)
      if extensionLower = ".obj"
        m.isObj = true
        content = ReadAsciiFile(m.path)
        ' a remote .obj's .mtl is resolved against its URL after parsing, not the cache folder
        baseDir = ""
        if m.modelUrl = ""
          baseDir = CreateObject("roPath", m.path).Split().parent
        end if
        objTask = new BGE.Parsers.OBJParseTask(content, baseDir)
        m.parseTask = objTask
      else if extensionLower = ".stl"
        content = ReadAsciiFile(m.path)
        if LCase(content.Left(5)) = "solid"
          asciiTask = new BGE.Parsers.STLAsciiParseTask(content)
          m.parseTask = asciiTask
        else
          bytes = CreateObject("roByteArray")
          if not bytes.ReadFile(m.path)
            m.error = "could not read model " + m.source
            return true
          end if
          binaryTask = new BGE.Parsers.STLBinaryParseTask(bytes)
          m.parseTask = binaryTask
        end if
      else
        m.error = "model " + m.source + " must be .stl or .obj"
        if m.download <> invalid
          m.error = m.error + " (set the download option extension: "".obj"" or "".stl"")"
          ' the file may be fine - it just needs the extension option
          m.unknownExtension = true
        end if
        return true
      end if
      return false
    end function

    ' Bad unless it failed only because its type wasn't known.
    override function isDownloadedFileBad() as boolean
      return not m.unknownExtension
    end function

    ' Starts whichever downloads the textures need, if any.
    private sub startTextureDownloads(mtllibName as string)
      texturePath = ""
      if m.options <> invalid and m.options.texturePath <> invalid
        texturePath = m.options.texturePath
      end if
      if BGE.Urls.isUrl(texturePath)
        m.startTextureDownload(texturePath)
      else if texturePath = "" and m.isObj and m.modelUrl <> "" and mtllibName <> ""
        m.mtlDownload = m.newDownload(BGE.Urls.resolveRelative(m.modelUrl, mtllibName))
      end if
    end sub

    private sub startTextureDownload(url as string)
      if m.textureDownloads[url] = invalid and m.downloadedTextures[url] = invalid
        m.textureDownloads[url] = m.newDownload(url)
      end if
    end sub

    ' Steps the .mtl then texture downloads. Returns true when there's nothing left to download.
    private function stepTextureDownloads(budgetMs as integer) as boolean
      if m.mtlDownload <> invalid
        if not m.mtlDownload.step(budgetMs)
          return false
        end if
        mtl = m.mtlDownload
        m.mtlDownload = invalid
        if mtl.error <> invalid
          m.warnUntextured(mtl.error)
          return true
        end if
        mtlContent = ReadAsciiFile(mtl.localPath)
        if not m.isMtl(mtlContent)
          CreateObject("roFileSystem").Delete(mtl.localPath)
          m.warnUntextured(mtl.url + " isn't a .mtl file; the downloaded copy was discarded")
          return true
        end if
        materials = BGE.Parsers.parseMTLContent(mtlContent)
        for each material in materials
          if material.texturePath <> ""
            ' map_Kd is relative to the .mtl, which may be in a different folder to the model
            material.texturePath = BGE.Urls.resolveRelative(mtl.url, material.texturePath)
            m.startTextureDownload(material.texturePath)
          end if
        end for
        BGE.Parsers.setOBJMaterials(m.model, materials)
        if m.textureDownloads.count() = 0
          m.warnUntextured(mtl.url + " has no map_Kd texture")
          return true
        end if
      end if
      for each url in m.textureDownloads.Keys()
        texture = m.textureDownloads[url]
        if texture.step(budgetMs)
          m.textureDownloads.Delete(url)
          m.downloadedTextures[url] = m.getDownloadedTexturePath(texture)
        end if
      end for
      if m.textureDownloads.count() > 0
        return false
      end if
      m.useDownloadedTextures()
      return true
    end function

    ' A finished texture download's local path, or "" (with a warning) if it failed.
    private function getDownloadedTexturePath(texture as BGE.DownloadTask) as string
      if texture.error <> invalid
        m.warnUntextured(texture.error)
        return ""
      end if
      if not BGE.FileTypes.isImageExtension(BGE.FileTypes.sniffExtension(texture.localPath))
        CreateObject("roFileSystem").Delete(texture.localPath)
        m.warnUntextured(texture.url + " isn't an image; the downloaded copy was discarded")
        return ""
      end if
      return texture.localPath
    end function

    ' Points the model's materials (or the URL texturePath) at the downloaded files.
    private sub useDownloadedTextures()
      if m.options <> invalid and BGE.Urls.isUrl(m.options.texturePath)
        localPath = m.downloadedTextures[m.options.texturePath]
        if localPath <> invalid
          m.localTexturePath = localPath
        end if
        return
      end if
      if m.model = invalid or m.downloadedTextures.count() = 0
        return
      end if
      for each name in m.model.materials.Keys()
        material = m.model.materials[name]
        localPath = m.downloadedTextures[material.texturePath]
        if localPath <> invalid
          material.texturePath = localPath
        end if
      end for
      ' faces with no material use the first texture, now a local path too
      if m.model.texturePath <> invalid and m.downloadedTextures[m.model.texturePath] <> invalid
        m.model.texturePath = m.downloadedTextures[m.model.texturePath]
      end if
    end sub

    ' Also releases the .mtl and texture downloads' slots.
    override sub abort()
      super.abort()
      if m.mtlDownload <> invalid
        m.mtlDownload.abort()
      end if
      for each url in m.textureDownloads.Keys()
        m.textureDownloads[url].abort()
      end for
      m.textureDownloads = {}
    end sub

    private function addModel() as boolean
      addOptions = m.options
      if m.localTexturePath <> ""
        addOptions = {texturePath: m.localTexturePath}
      else if m.options <> invalid and BGE.Urls.isUrl(m.options.texturePath)
        ' the URL texture failed - don't let addLoadedModel try it as a path
        addOptions = {}
      end if
      if not m.game.addLoadedModel(m.modelName, m.model, addOptions, m.isObj)
        m.error = "could not parse model " + m.source
      end if
      m.model = invalid
      return true
    end function

    private function newDownload(url as string) as BGE.DownloadTask
      if m.loader <> invalid
        return m.loader.getDownloadTask(url, m.downloadOptions)
      end if
      task = new BGE.DownloadTask(url, m.downloadOptions)
      return task
    end function

    ' A .mtl file has at least one `newmtl` line.
    private function isMtl(content as string) as boolean
      for each rawLine in content.Split(chr(10))
        if rawLine.Trim().StartsWith("newmtl")
          return true
        end if
      end for
      return false
    end function

    private sub warnUntextured(reason as string)
      m.game.log("BGE.AssetLoader - " + reason + ", model " + m.modelName + " will render untextured", BGE.Debug.LogLevel.warning)
    end sub

  end class

end namespace
