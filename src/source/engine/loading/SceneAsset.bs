namespace BGE

  ' The kinds of asset a scene can own (see `GameScene.loadSceneBitmap()` and friends)
  enum SceneAssetKind
    bitmap = "bitmap"
    model = "model"
    spriteAtlas = "spriteAtlas"
    tiledMap = "tiledMap"
  end enum

  ' An asset a scene owns, freed when the game leaves the scene
  interface SceneAsset extends roAssociativeArray
    kind as BGE.SceneAssetKind
    name as string
  end interface

end namespace
