import "../../utils/urls.bs"

namespace BGE.Downloads

  ' Where downloads are cached between launches (the OS may clear it when space runs low)
  const CACHE_FOLDER = "cachefs:/bge"
  ' Where downloads with `cache: false` go - cleared when the channel exits
  const TEMP_FOLDER = "tmp:/bge"

  ' The folder downloads are written to.
  '
  ' @param {boolean} useCache - true for the cachefs: cache, false for tmp:
  ' @return {string}
  function getFolder(useCache as boolean) as string
    if useCache
      return BGE.Downloads.CACHE_FOLDER
    end if
    return BGE.Downloads.TEMP_FOLDER
  end function

  ' The local file a URL downloads to when its own extension is used: the MD5 of the URL plus
  ' the URL's extension, so the same URL always maps to the same file and the loaders can still
  ' tell the file type.
  '
  ' @param {string} url
  ' @param {boolean} useCache - true for the cachefs: cache, false for tmp:
  ' @return {string}
  function getPath(url as string, useCache as boolean) as string
    return BGE.Downloads.getBasePath(url, useCache) + BGE.Urls.fileExtension(url)
  end function

  ' The local file a URL downloads to, without an extension: the download folder plus the MD5
  ' of the URL. The downloaded file is this plus the extension of its type.
  '
  ' @param {string} url
  ' @param {boolean} useCache - true for the cachefs: cache, false for tmp:
  ' @return {string}
  function getBasePath(url as string, useCache as boolean) as string
    digest = CreateObject("roEVPDigest")
    digest.Setup("md5")
    bytes = CreateObject("roByteArray")
    bytes.FromAsciiString(url)
    return BGE.Downloads.getFolder(useCache) + "/" + LCase(digest.Process(bytes))
  end function

end namespace
