import "../drawables/SpriteFrames.bs"
import "../../utils/strings.bs"
import "../../utils/urls.bs"

namespace BGE

  ' A packed sprite atlas loaded with `AssetLoader.loadSpriteAtlas()` or `Game.loadSpriteAtlas()`:
  ' its sheets (loaded as bitmaps) and every frame's rect. `Game.getSpriteAtlasFrames()` turns it
  ' into a shared `BGE.SpriteFrames`.
  '
  ' The `.json` it's read from is `{sheets: ["hero.png", "hero_1.png"], frames: [SpriteFrameRect...]}`,
  ' as `tools/render-character.py --packed` writes. Sheet files are relative to the `.json`.
  interface SpriteAtlas
    ' The name it was loaded under
    name as string
    ' The `.json` path or URL it was loaded from
    source as string
    ' The name each sheet's bitmap is loaded under (`<name>#0`, `<name>#1`, ...)
    sheets as string[]
    ' Each sheet's path or URL
    sheetPaths as string[]
    ' Every frame, in frame order
    frames as BGE.SpriteFrameRect[]
  end interface

end namespace

namespace BGE.SpriteAtlases

  ' The bitmap name of an atlas's sheet.
  '
  ' @param {string} atlasName
  ' @param {integer} index
  ' @return {string}
  function sheetBitmapName(atlasName as string, index as integer) as string
    return atlasName + "#" + index.toStr()
  end function

  ' Why parsed atlas JSON isn't a sprite atlas, or "" if it is.
  '
  ' @param {dynamic} parsed - what ParseJson() returned
  ' @return {string}
  function findProblem(parsed as dynamic) as string
    if type(parsed) <> "roAssociativeArray"
      return "isn't valid JSON"
    end if
    sheets = parsed.sheets
    if type(sheets) <> "roArray" or sheets.count() = 0
      return "has no ""sheets"" list"
    end if
    for each sheet in sheets
      if not BGE.SpriteAtlases.isString(sheet) or sheet = ""
        return "has a sheet that isn't a file name"
      end if
    end for
    frames = parsed.frames
    if type(frames) <> "roArray"
      return "has no ""frames"" list"
    end if
    for i = 0 to frames.count() - 1
      frame = frames[i]
      if type(frame) <> "roAssociativeArray"
        return "frame " + i.toStr() + " isn't an object"
      end if
      for each field in ["x", "y", "width", "height"]
        if not BGE.SpriteAtlases.isNumber(frame[field])
          return "frame " + i.toStr() + " has no " + field
        end if
      end for
      if frame.sheet <> invalid
        if not BGE.SpriteAtlases.isNumber(frame.sheet) or frame.sheet < 0 or frame.sheet >= sheets.count()
          return "frame " + i.toStr() + " is on a sheet that isn't listed"
        end if
      end if
    end for
    return ""
  end function

  ' Builds an atlas from JSON that findProblem() accepted.
  '
  ' @param {string} atlasName - the name to load it under
  ' @param {string} source - the `.json` path or URL, which sheet files are relative to
  ' @param {roAssociativeArray} parsed
  ' @return {BGE.SpriteAtlas}
  function create(atlasName as string, source as string, parsed as roAssociativeArray) as BGE.SpriteAtlas
    sheets = [] as string[]
    sheetPaths = [] as string[]
    for each sheetFile in parsed.sheets
      sheets.push(BGE.SpriteAtlases.sheetBitmapName(atlasName, sheets.count()))
      sheetPaths.push(BGE.SpriteAtlases.resolveSheetPath(source, sheetFile))
    end for
    return {
      name: atlasName,
      source: source,
      sheets: sheets,
      sheetPaths: sheetPaths,
      frames: parsed.frames
    }
  end function

  ' A sheet file named in an atlas, as a path or URL: relative to the `.json`, unless it's a
  ' URL or a path with its own volume (e.g. `pkg:/`).
  '
  ' @param {string} source - the `.json` path or URL
  ' @param {string} sheetFile
  ' @return {string}
  function resolveSheetPath(source as string, sheetFile as string) as string
    if BGE.Urls.isUrl(sheetFile) or sheetFile.Instr(":/") >= 0
      return sheetFile
    end if
    if BGE.Urls.isUrl(source)
      return BGE.Urls.resolveRelative(source, sheetFile)
    end if
    return source.Left(BGE.lastInStr(source, "/") + 1) + sheetFile
  end function

  ' Whether a parsed JSON value is a number.
  '
  ' @param {dynamic} value
  ' @return {boolean}
  function isNumber(value as dynamic) as boolean
    numberTypes = {"Integer": true, "roInt": true, "roInteger": true, "LongInteger": true, "roLongInteger": true, "Float": true, "roFloat": true, "Double": true, "roDouble": true}
    return numberTypes.DoesExist(type(value))
  end function

  ' Whether a parsed JSON value is a string.
  '
  ' @param {dynamic} value
  ' @return {boolean}
  function isString(value as dynamic) as boolean
    valueType = type(value)
    return valueType = "String" or valueType = "roString"
  end function

end namespace
