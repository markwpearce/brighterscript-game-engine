import "../drawables/SpriteFrames.bs"
import "../interfaces.bs"
import "../../utils/deviceRenderTier.bs"
import "../../utils/strings.bs"
import "../../utils/urls.bs"

namespace BGE

  ' A packed sprite atlas loaded with `AssetLoader.loadSpriteAtlas()` or `Game.loadSpriteAtlas()`:
  ' its sheets (loaded as bitmaps) and every frame's rect. `Game.getSpriteAtlasFrames()` turns it
  ' into a shared `BGE.SpriteFrames`.
  '
  ' The `.json` it's read from is `{sheets: ["hero.png", "hero_1.png"], frames: [SpriteFrameRect...]}`,
  ' as `tools/render-character.py --packed` writes. Sheet files are relative to the `.json`. An
  ' optional `sheetSizes: [[width, height], ...]` lets it load at a reduced size (see
  ' `BGE.SpriteAtlasLoadOptions.scale`).
  interface SpriteAtlas
    ' The name it was loaded under
    name as string
    ' The `.json` path or URL it was loaded from
    source as string
    ' The name each sheet's bitmap is loaded under (`<name>#0`, `<name>#1`, ...)
    sheets as string[]
    ' Each sheet's path or URL
    sheetPaths as string[]
    ' Every frame, in frame order, in the loaded sheets' pixels
    frames as BGE.SpriteFrameRect[]
    ' The size to load each sheet at, or invalid for its own size
    sheetLoadSizes as dynamic
    ' Pixels of the full-size sheets per loaded pixel: 2 for an atlas loaded at half size, 1 at full size
    texelScale as float
  end interface

  ' Options for `AssetLoader.loadSpriteAtlas()`.
  interface SpriteAtlasLoadOptions extends DownloadOptions
    ' Load the sheets at this fraction of their size (0-1), e.g. 0.75 for 56% of the texture
    ' memory; sprites still draw the same size, from fewer texels. Defaults to
    ' `BGE.getDefaultSpriteAtlasScale()`: 0.75 on an HD or SD Roku, 1 elsewhere. Needs the atlas's
    ' `sheetSizes`; without them it loads at full size.
    optional scale as float
  end interface

  ' The scale sprite atlases load at when `SpriteAtlasLoadOptions.scale` isn't given: 75% on an HD
  ' or SD Roku (64 MB of texture memory or less), full size elsewhere. Half size looked too soft
  ' in thirdPerson.
  '
  ' @return {float}
  function getDefaultSpriteAtlasScale() as float
    tier = BGE.getDeviceRenderTier()
    if tier = BGE.DeviceRenderTier.hd or tier = BGE.DeviceRenderTier.sd
      return 0.75
    end if
    return 1.0
  end function

end namespace

namespace BGE.SpriteAtlases

  ' The bitmap name of an atlas's sheet.
  '
  ' @param {string} atlasName
  ' @param {integer} index
  ' @return {string}
  function sheetBitmapName(atlasName as string, index as integer) as string
    return atlasName + "#" + index.toStr()
  end function

  ' Why parsed atlas JSON isn't a sprite atlas, or "" if it is.
  '
  ' @param {dynamic} parsed - what ParseJson() returned
  ' @return {string}
  function findProblem(parsed as dynamic) as string
    if type(parsed) <> "roAssociativeArray"
      return "isn't valid JSON"
    end if
    sheets = parsed.sheets
    if type(sheets) <> "roArray" or sheets.count() = 0
      return "has no ""sheets"" list"
    end if
    for each sheet in sheets
      if not BGE.SpriteAtlases.isString(sheet) or sheet = ""
        return "has a sheet that isn't a file name"
      end if
    end for
    frames = parsed.frames
    if type(frames) <> "roArray"
      return "has no ""frames"" list"
    end if
    for i = 0 to frames.count() - 1
      frame = frames[i]
      if type(frame) <> "roAssociativeArray"
        return "frame " + i.toStr() + " isn't an object"
      end if
      for each field in ["x", "y", "width", "height"]
        if not BGE.SpriteAtlases.isNumber(frame[field])
          return "frame " + i.toStr() + " has no " + field
        end if
      end for
      if frame.sheet <> invalid
        if not BGE.SpriteAtlases.isNumber(frame.sheet) or frame.sheet < 0 or frame.sheet >= sheets.count()
          return "frame " + i.toStr() + " is on a sheet that isn't listed"
        end if
      end if
    end for
    sizes = parsed.sheetSizes
    if sizes <> invalid
      if type(sizes) <> "roArray" or sizes.count() <> sheets.count()
        return "has ""sheetSizes"" that don't match its sheets"
      end if
      for each size in sizes
        if type(size) <> "roArray" or size.count() <> 2 or not BGE.SpriteAtlases.isNumber(size[0]) or not BGE.SpriteAtlases.isNumber(size[1]) or size[0] <= 0 or size[1] <= 0
          return "has a sheet size that isn't [width, height]"
        end if
      end for
    end if
    return ""
  end function

  ' Builds an atlas from JSON that findProblem() accepted.
  '
  ' @param {string} atlasName - the name to load it under
  ' @param {string} source - the `.json` path or URL, which sheet files are relative to
  ' @param {roAssociativeArray} parsed
  ' @param {float} [scale=1] - load the sheets at this fraction of their size, if the json has
  '   their sizes; frames are scaled to match
  ' @return {BGE.SpriteAtlas}
  function create(atlasName as string, source as string, parsed as roAssociativeArray, scale = 1.0 as float) as BGE.SpriteAtlas
    sheets = [] as string[]
    sheetPaths = [] as string[]
    for each sheetFile in parsed.sheets
      sheets.push(BGE.SpriteAtlases.sheetBitmapName(atlasName, sheets.count()))
      sheetPaths.push(BGE.SpriteAtlases.resolveSheetPath(source, sheetFile))
    end for
    atlas = {
      name: atlasName,
      source: source,
      sheets: sheets,
      sheetPaths: sheetPaths,
      frames: parsed.frames,
      sheetLoadSizes: invalid,
      texelScale: 1.0
    } as BGE.SpriteAtlas
    if scale > 0 and scale < 1 and parsed.sheetSizes <> invalid
      BGE.SpriteAtlases.applyScale(atlas, parsed.sheetSizes, scale)
    end if
    return atlas
  end function

  ' Shrinks an atlas's sheets and frames to `scale` of their size. Frame rects grow to whole
  ' pixels outward, so a frame keeps all of its pixels (and may pick up a sliver of a neighbour's
  ' edge, blended in by the resize).
  '
  ' @param {BGE.SpriteAtlas} atlas
  ' @param {roArray} sheetSizes - [width, height] of each full-size sheet
  ' @param {float} scale - 0-1
  sub applyScale(atlas as BGE.SpriteAtlas, sheetSizes as roArray, scale as float)
    loadSizes = [] as BGE.SizeWH[]
    for each size in sheetSizes
      loadSizes.push({width: BGE.SpriteAtlases.atLeastOne(size[0] * scale + 0.5), height: BGE.SpriteAtlases.atLeastOne(size[1] * scale + 0.5)})
    end for
    frames = [] as BGE.SpriteFrameRect[]
    for each frame in atlas.frames
      sheet = frame.sheet ?? 0
      ' each sheet's own factor, as its size rounded
      sx = loadSizes[sheet].width / sheetSizes[sheet][0]
      sy = loadSizes[sheet].height / sheetSizes[sheet][1]
      left = Int(frame.x * sx)
      top = Int(frame.y * sy)
      right = -Int(-(frame.x + frame.width) * sx)
      bottom = -Int(-(frame.y + frame.height) * sy)
      sourceWidth = frame.sourceWidth ?? frame.width
      sourceHeight = frame.sourceHeight ?? frame.height
      frames.push({
        sheet: sheet,
        x: left,
        y: top,
        width: right - left,
        height: bottom - top,
        ' where the grown rect now sits in the scaled cell
        offsetX: (frame.offsetX ?? 0) * sx - (frame.x * sx - left),
        offsetY: (frame.offsetY ?? 0) * sy - (frame.y * sy - top),
        sourceWidth: sourceWidth * sx,
        sourceHeight: sourceHeight * sy
      })
    end for
    atlas.frames = frames
    atlas.sheetLoadSizes = loadSizes
    atlas.texelScale = sheetSizes[0][0] / loadSizes[0].width
  end sub

  ' A pixel count of at least 1
  function atLeastOne(value as float) as integer
    count = Int(value)
    if count < 1
      return 1
    end if
    return count
  end function

  ' A sheet file named in an atlas, as a path or URL: relative to the `.json`, unless it's a
  ' URL or a path with its own volume (e.g. `pkg:/`).
  '
  ' @param {string} source - the `.json` path or URL
  ' @param {string} sheetFile
  ' @return {string}
  function resolveSheetPath(source as string, sheetFile as string) as string
    if BGE.Urls.isUrl(sheetFile) or sheetFile.Instr(":/") >= 0
      return sheetFile
    end if
    if BGE.Urls.isUrl(source)
      return BGE.Urls.resolveRelative(source, sheetFile)
    end if
    return source.Left(BGE.lastInStr(source, "/") + 1) + sheetFile
  end function

  ' Whether a parsed JSON value is a number.
  '
  ' @param {dynamic} value
  ' @return {boolean}
  function isNumber(value as dynamic) as boolean
    numberTypes = {"Integer": true, "roInt": true, "roInteger": true, "LongInteger": true, "roLongInteger": true, "Float": true, "roFloat": true, "Double": true, "roDouble": true}
    return numberTypes.DoesExist(type(value))
  end function

  ' Whether a parsed JSON value is a string.
  '
  ' @param {dynamic} value
  ' @return {boolean}
  function isString(value as dynamic) as boolean
    valueType = type(value)
    return valueType = "String" or valueType = "roString"
  end function

end namespace
