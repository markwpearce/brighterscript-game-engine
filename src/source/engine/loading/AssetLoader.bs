import "DownloadPaths.bs"
import "../Game.bs"
import "../debug/LogLevel.bs"
import "../GameTimer.bs"
import "../../math/math.bs"
import "../../utils/urls.bs"
import "DownloadTask.bs"
import "LoadTask.bs"
import "StepTask.bs"
import "AssetLoadTasks.bs"

namespace BGE

  ' Runs LoadTasks a little at a time, within a per-frame time budget, so long loads don't freeze
  ' the game. A scene gets one in `GameScene.onLoad()`; `game.assets` is one you can use at any
  ' time for background loading.
  '
  ' Once every queued task has finished, `onComplete(loader)` is called. Adding a task after
  ' that starts a new batch: progress and errors start again from scratch.
  '
  ' A built-in load given a http(s):// URL downloads it first, caching it in cachefs: (see download()).
  class AssetLoader

    ' Called once when the queue drains, with this loader
    onComplete as sub(loader as AssetLoader) as void = invalid
    ' Measures each update()'s budget
    timer as BGE.GameTimer
    ' Seconds a task can wait on a task in another loader, with nothing else to do, before a warning is logged
    stallWarningSeconds as float = 10.0
    ' Most downloads this loader runs at once (each loader, including game.assets, has its own
    ' limit). Less than 1 counts as 1.
    maxConcurrentDownloads as integer = 4

    private game as BGE.Game
    private tasks as BGE.LoadTask[]
    private errors as string[]
    private completeFired as boolean = true
    private downloadSlots as BGE.DownloadSlots
    ' where the next update() starts in `tasks`, so a slow task can't starve the ones after it
    private startIndex as integer = 0
    ' set on every task this loader queues
    private id as string
    ' how long nothing has been able to run, while waiting on another loader's task
    private stallTimer as roTimespan = invalid
    private stallWarned as boolean = false

    sub new(game as BGE.Game)
      m.game = game
      m.timer = new BGE.GameTimer()
      m.tasks = []
      m.errors = []
      m.downloadSlots = new BGE.DownloadSlots()
      m.id = CreateObject("roDeviceInfo").GetRandomUUID()
    end sub

    ' Queues a task.
    '
    ' @param {BGE.LoadTask} task
    ' @return {BGE.LoadTask} the same task
    function addTask(task as BGE.LoadTask) as BGE.LoadTask
      if m.completeFired
        m.tasks = []
        m.errors = []
        m.completeFired = false
      end if
      task.queuedIn = m.id
      m.tasks.push(task)
      return task
    end function

    ' Queues a function to be called once per step until it's done. It's passed `context` and
    ' returns true when done, or a number from 0 to 1 for its progress (done at 1). Anything else
    ' means "not done yet".
    '
    ' @param {function} stepFunction - called as stepFunction(context)
    ' @param {dynamic} [context=invalid] - passed to every call
    ' @param {float} [weight=1.0] - its share of overall progress
    ' @param {boolean} [oncePerFrame=false] - call it at most once a frame (e.g. to show a level building), instead of as often as the frame's budget allows
    ' @return {BGE.LoadTask} the queued task
    function addStep(stepFunction as function(context as dynamic) as dynamic, context = invalid as dynamic, weight = 1.0 as float, oncePerFrame = false as boolean) as BGE.LoadTask
      task = new BGE.StepTask(stepFunction, context, oncePerFrame)
      task.weight = weight
      return m.addTask(task)
    end function

    ' Queues loading a bitmap. A http(s):// URL is downloaded first (see `download()` for
    ' caching). On a Roku the image is decoded off the main thread, so even a large one doesn't
    ' stall a frame, and it can be resized as it loads.
    '
    ' @param {string} bitmapName - the name to get it by later (`game.getBitmap()`)
    ' @param {string} pathOrUrl - local file path or URL
    ' @param {BGE.BitmapLoadOptions} [options={}] - resizing and drawable, plus for a URL: caching, timeout and retries
    ' @return {BGE.LoadTask} the queued task
    function loadBitmap(bitmapName as string, pathOrUrl as string, options = {} as BGE.BitmapLoadOptions) as BGE.LoadTask
      task = new BGE.BitmapLoadTask(m.game, bitmapName, pathOrUrl, options)
      m.attachDownload(task, pathOrUrl, options)
      return m.addTask(task)
    end function

    ' Queues loading a sound, as `game.loadSound()` would. A http(s):// URL is downloaded first
    ' (see `download()` for caching).
    '
    ' @param {string} soundName - the name to play it by later (`game.playSound()`)
    ' @param {string} pathOrUrl - local file path or URL
    ' @param {BGE.DownloadOptions} [options={}] - for a URL: caching, timeout and retries
    ' @return {BGE.LoadTask} the queued task
    function loadSound(soundName as string, pathOrUrl as string, options = {} as BGE.DownloadOptions) as BGE.LoadTask
      task = new BGE.SoundLoadTask(m.game, soundName, pathOrUrl)
      m.attachDownload(task, pathOrUrl, options)
      return m.addTask(task)
    end function

    ' Queues loading a .obj or .stl model, parsed a slice at a time so a big model doesn't
    ' freeze the screen. A http(s):// URL is downloaded first; an .obj from a URL also downloads
    ' its .mtl and texture, found relative to the model's URL. Set the returned task's `weight`
    ' higher than other tasks' for a big model, so the progress bar reflects how long it takes.
    '
    ' @param {string} modelName - the name to get it by later (`game.get3dModel()`)
    ' @param {string} pathOrUrl - local file path or URL
    ' @param {BGE.Model3dLoadOptions} [options={}] - same options as `game.load3dModel()`; `texturePath` may be a URL
    ' @param {BGE.DownloadOptions} [downloadOptions={}] - caching, timeout and retries for every download this model needs
    ' @return {BGE.LoadTask} the queued task
    function load3dModel(modelName as string, pathOrUrl as string, options = {} as BGE.Model3dLoadOptions, downloadOptions = {} as BGE.DownloadOptions) as BGE.LoadTask
      task = new BGE.ModelLoadTask(m.game, modelName, pathOrUrl, options)
      task.loader = m
      task.downloadOptions = downloadOptions
      m.attachDownload(task, pathOrUrl, downloadOptions)
      return m.addTask(task)
    end function

    ' Queues registering a font, as `game.registerFont()` would. A http(s):// URL is downloaded first
    ' (see `download()` for caching).
    '
    ' @param {string} pathOrUrl - local file path or URL
    ' @param {BGE.DownloadOptions} [options={}] - for a URL: caching, timeout and retries
    ' @return {BGE.LoadTask} the queued task
    function registerFont(pathOrUrl as string, options = {} as BGE.DownloadOptions) as BGE.LoadTask
      task = new BGE.FontLoadTask(m.game, pathOrUrl)
      m.attachDownload(task, pathOrUrl, options)
      return m.addTask(task)
    end function

    ' Queues a download of a URL to a local file. It's saved in the cachefs: cache, so a later
    ' download of the same URL (even after a relaunch) uses that file without a request. The
    ' OS may clear the cache when space runs low. Once done, the task's `localPath` is the file.
    '
    ' @param {string} url - a http:// or https:// URL
    ' @param {BGE.DownloadOptions} [options={}] - `cache: false` for tmp: instead, `refresh: true` to download again, `timeoutSeconds`, `retries`
    ' @return {BGE.DownloadTask} the queued task
    function download(url as string, options = {} as BGE.DownloadOptions) as BGE.DownloadTask
      task = m.newDownloadTask(url, options)
      m.addTask(task)
      return task
    end function

    ' Creates (but doesn't queue) the DownloadTask for a URL. Used by every download this loader
    ' makes - override it to change how downloads are made.
    '
    ' @param {string} url
    ' @param {BGE.DownloadOptions} options
    ' @return {BGE.DownloadTask}
    function newDownloadTask(url as string, options as BGE.DownloadOptions) as BGE.DownloadTask
      task = new BGE.DownloadTask(url, options)
      task.slots = m.downloadSlots
      return task
    end function

    ' The slots this loader's downloads share, for a `newDownloadTask()` override.
    '
    ' @return {BGE.DownloadSlots}
    function getDownloadSlots() as BGE.DownloadSlots
      return m.downloadSlots
    end function

    ' Deletes every file in the download cache, so later downloads make a fresh request. Don't
    ' call it while downloads are running.
    sub clearCache()
      filesystem = CreateObject("roFileSystem")
      fileNames = filesystem.GetDirectoryListing(BGE.Downloads.CACHE_FOLDER)
      if fileNames = invalid
        return
      end if
      for each fileName in fileNames
        filesystem.Delete(BGE.Downloads.CACHE_FOLDER + "/" + fileName)
      end for
    end sub

    ' Whether any tasks are queued in the current batch.
    '
    ' @return {boolean}
    function hasTasks() as boolean
      return m.tasks.count() > 0
    end function

    ' Whether every queued task has finished (true when nothing is queued).
    '
    ' @return {boolean}
    function isDone() as boolean
      for each task in m.tasks
        if not task.done
          return false
        end if
      end for
      return true
    end function

    ' Overall progress of the current batch, weighted by each task's `weight`.
    '
    ' @return {float} 0 to 1 (1 when nothing is queued)
    function getProgress() as float
      totalWeight = 0.0
      weighted = 0.0
      for each task in m.tasks
        totalWeight += task.weight
        if task.done
          weighted += task.weight
        else
          weighted += task.weight * task.progressHighWater
        end if
      end for
      if totalWeight <= 0
        return 1.0
      end if
      return weighted / totalWeight
    end function

    ' Error messages from tasks in the current batch that failed.
    '
    ' @return {string[]}
    function getErrors() as string[]
      return m.errors
    end function

    ' Runs task steps until every task is done or `budgetMs` has been used. Called by Game.
    '
    ' @param {integer} budgetMs
    sub update(budgetMs as integer)
      m.downloadSlots.max = m.maxConcurrentDownloads
      if m.downloadSlots.max < 1
        m.downloadSlots.max = 1
      end if
      if m.tasks.count() = 0
        return
      end if
      m.timer.mark()
      for each task in m.tasks
        task.waitingForNextFrame = false
      end for

      taskCount = m.tasks.count()
      m.startIndex = m.startIndex mod taskCount
      firstIndex = m.startIndex
      m.startIndex++
      doneBefore = m.countDone()
      outOfTime = false
      ranAny = true
      ranThisUpdate = false
      while ranAny and not outOfTime
        ranAny = false
        for offset = 0 to taskCount - 1
          task = m.tasks[(firstIndex + offset) mod taskCount]
          if not task.done and not task.waitingForNextFrame and m.dependenciesReady(task)
            remaining = budgetMs - m.timer.totalMilliseconds()
            if remaining <= 0 and ranAny
              outOfTime = true
              exit for
            end if
            m.runStep(task, remaining)
            ranAny = true
            ranThisUpdate = true
          end if
        end for
        if m.timer.totalMilliseconds() >= budgetMs
          outOfTime = true
        end if
      end while

      if ranThisUpdate or m.countDone() <> doneBefore or m.isDone()
        m.stallTimer = invalid
        m.stallWarned = false
      else
        m.handleStall()
      end if

      if not m.completeFired and m.isDone()
        m.completeFired = true
        if m.onComplete <> invalid
          onCompleteFn = m.onComplete
          onCompleteFn(m)
        end if
      end if
    end sub

    ' Nothing could run this update. If every waiting task waits only on tasks in this loader,
    ' they're waiting on each other and never will: fail them. Otherwise they may be waiting on
    ' another loader (or a task that was never queued), so warn if that goes on too long.
    private sub handleStall()
      outsideDependency = invalid
      for each task in m.tasks
        if not task.done
          for each dependency in task.dependsOn
            if not dependency.done and dependency.queuedIn <> m.id
              outsideDependency = dependency
            end if
          end for
        end if
      end for
      if outsideDependency = invalid
        for each task in m.tasks
          if not task.done
            m.finishTask(task, task.name + " can never start: its dependencies wait on each other")
          end if
        end for
        return
      end if
      if m.stallTimer = invalid
        m.stallTimer = CreateObject("roTimespan")
      else if not m.stallWarned and m.stallTimer.TotalMilliseconds() >= m.stallWarningSeconds * 1000
        m.stallWarned = true
        where = "another loader"
        if outsideDependency.queuedIn = ""
          where = "no loader - it was never queued"
        end if
        m.game.log("BGE.AssetLoader - still waiting on " + outsideDependency.name + ", which is in " + where, BGE.Debug.LogLevel.warning)
      end if
    end sub

    private function countDone() as integer
      doneCount = 0
      for each task in m.tasks
        if task.done
          doneCount++
        end if
      end for
      return doneCount
    end function

    ' True when every dependency is done. A failed dependency fails this task.
    private function dependenciesReady(task as BGE.LoadTask) as boolean
      for each dependency in task.dependsOn
        if not dependency.done
          return false
        end if
        if dependency.error <> invalid
          m.finishTask(task, "dependency " + dependency.name + " failed")
          return false
        end if
      end for
      return true
    end function

    private sub attachDownload(task as BGE.FileLoadTask, pathOrUrl as string, options as BGE.DownloadOptions)
      if BGE.Urls.isUrl(pathOrUrl)
        task.download = m.newDownloadTask(pathOrUrl, options)
      end if
    end sub

    private sub runStep(task as BGE.LoadTask, budgetMs as integer)
      finished = false
      try
        finished = task.step(budgetMs)
      catch e
        task.error = task.name + " threw: " + e.message
        task.abort()
        finished = true
      end try
      if finished
        m.finishTask(task, task.error)
      else
        progress = BGE.Math.Clamp(task.getProgress(), 0, 1)
        if progress > task.progressHighWater
          task.progressHighWater = progress
        end if
      end if
    end sub

    private sub finishTask(task as BGE.LoadTask, errorMessage as dynamic)
      task.done = true
      task.progressHighWater = 1.0
      if errorMessage <> invalid
        task.error = errorMessage
        m.errors.push(errorMessage)
        m.game.log("BGE.AssetLoader - " + errorMessage, BGE.Debug.LogLevel.error)
      end if
    end sub

  end class

end namespace
