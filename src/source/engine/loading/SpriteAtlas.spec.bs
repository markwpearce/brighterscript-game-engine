import "pkg:/source/engine/loading/SpriteAtlas.bs"

namespace tests

  @suite("BGE.SpriteAtlases")
  class SpriteAtlasTests extends rooibos.BaseTestSuite

    @describe("findProblem")

    @it("accepts an atlas")
    function _()
      parsed = ParseJson("{""sheets"": [""a.png""], ""frames"": [{""sheet"": 0, ""x"": 0, ""y"": 0, ""width"": 2, ""height"": 2}]}")
      m.assertEqual("", BGE.SpriteAtlases.findProblem(parsed))
    end function

    @it("rejects something that isn't JSON")
    function _()
      m.assertEqual("isn't valid JSON", BGE.SpriteAtlases.findProblem(invalid))
    end function

    @it("rejects an atlas with no sheets")
    function _()
      m.assertEqual("has no ""sheets"" list", BGE.SpriteAtlases.findProblem({sheets: [], frames: []}))
    end function

    @it("rejects a sheet that isn't a file name")
    function _()
      m.assertEqual("has a sheet that isn't a file name", BGE.SpriteAtlases.findProblem({sheets: [3], frames: []}))
    end function

    @it("rejects a frame missing a field")
    function _()
      parsed = {sheets: ["a.png"], frames: [{x: 0, y: 0, width: 2}]}
      m.assertEqual("frame 0 has no height", BGE.SpriteAtlases.findProblem(parsed))
    end function

    @it("rejects a frame on a sheet that isn't listed")
    function _()
      parsed = {sheets: ["a.png"], frames: [{sheet: 1, x: 0, y: 0, width: 2, height: 2}]}
      m.assertEqual("frame 0 is on a sheet that isn't listed", BGE.SpriteAtlases.findProblem(parsed))
    end function

    @describe("resolveSheetPath")

    @it("resolves a sheet relative to a local json")
    function _()
      m.assertEqual("pkg:/sprites/hero_1.png", BGE.SpriteAtlases.resolveSheetPath("pkg:/sprites/hero.json", "hero_1.png"))
    end function

    @it("resolves a sheet relative to a json URL")
    function _()
      m.assertEqual("https://example.com/art/hero.png", BGE.SpriteAtlases.resolveSheetPath("https://example.com/art/hero.json?v=2", "hero.png"))
    end function

    @it("keeps a sheet that's a URL or has its own volume")
    function _()
      m.assertEqual("https://cdn.example.com/hero.png", BGE.SpriteAtlases.resolveSheetPath("pkg:/sprites/hero.json", "https://cdn.example.com/hero.png"))
      m.assertEqual("tmp:/hero.png", BGE.SpriteAtlases.resolveSheetPath("pkg:/sprites/hero.json", "tmp:/hero.png"))
    end function

    @it("names sheets after the atlas")
    function _()
      atlas = BGE.SpriteAtlases.create("orc", "pkg:/sprites/orc.json", {sheets: ["orc.png", "orc_1.png"], frames: []})
      m.assertEqual(["orc#0", "orc#1"], atlas.sheets)
      m.assertEqual(["pkg:/sprites/orc.png", "pkg:/sprites/orc_1.png"], atlas.sheetPaths)
    end function

    @describe("scale (#683)")

    @it("rejects sheetSizes that don't match the sheets")
    function _()
      m.assertEqual("has ""sheetSizes"" that don't match its sheets", BGE.SpriteAtlases.findProblem({sheets: ["a.png"], frames: [], sheetSizes: [[2, 2], [2, 2]]}))
      m.assertEqual("has a sheet size that isn't [width, height]", BGE.SpriteAtlases.findProblem({sheets: ["a.png"], frames: [], sheetSizes: [[2]]}))
      m.assertEqual("", BGE.SpriteAtlases.findProblem({sheets: ["a.png"], frames: [], sheetSizes: [[2, 2]]}))
    end function

    @it("loads at full size without sheetSizes, whatever the scale")
    function _()
      atlas = BGE.SpriteAtlases.create("orc", "pkg:/sprites/orc.json", {sheets: ["orc.png"], frames: [{x: 2, y: 2, width: 4, height: 4}]}, 0.5)
      m.assertInvalid(atlas.sheetLoadSizes)
      m.assertEqual(1.0, atlas.texelScale)
      m.assertEqual(2, atlas.frames[0].x)
    end function

    @it("halves the sheets and frames, growing odd rects to whole pixels")
    function _()
      parsed = {
        sheets: ["orc.png"],
        sheetSizes: [[100, 50]],
        frames: [
          {x: 10, y: 20, width: 8, height: 6, offsetX: 4, offsetY: 2, sourceWidth: 16, sourceHeight: 10},
          {x: 11, y: 3, width: 5, height: 5}
        ]
      }
      atlas = BGE.SpriteAtlases.create("orc", "pkg:/sprites/orc.json", parsed, 0.5)
      m.assertEqual(50, atlas.sheetLoadSizes[0].width)
      m.assertEqual(25, atlas.sheetLoadSizes[0].height)
      m.assertEqual(2.0, atlas.texelScale)
      first = atlas.frames[0]
      m.assertEqual([5, 10, 4, 3], [first.x, first.y, first.width, first.height])
      m.assertEqual([2.0, 1.0, 8.0, 5.0], [first.offsetX, first.offsetY, first.sourceWidth, first.sourceHeight])
      ' 11..16 -> 5.5..8: grown to 5..8, and its offset moved back the half pixel it grew by
      second = atlas.frames[1]
      m.assertEqual([5, 1, 3, 3], [second.x, second.y, second.width, second.height])
      m.assertEqual(-0.5, second.offsetX)
      m.assertEqual(-0.5, second.offsetY)
      m.assertEqual(0, second.sheet)
    end function

  end class

end namespace
