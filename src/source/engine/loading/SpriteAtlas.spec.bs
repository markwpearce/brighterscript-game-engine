import "pkg:/source/engine/loading/SpriteAtlas.bs"

namespace tests

  @suite("BGE.SpriteAtlases")
  class SpriteAtlasTests extends rooibos.BaseTestSuite

    @describe("findProblem")

    @it("accepts an atlas")
    function _()
      parsed = ParseJson("{""sheets"": [""a.png""], ""frames"": [{""sheet"": 0, ""x"": 0, ""y"": 0, ""width"": 2, ""height"": 2}]}")
      m.assertEqual("", BGE.SpriteAtlases.findProblem(parsed))
    end function

    @it("rejects something that isn't JSON")
    function _()
      m.assertEqual("isn't valid JSON", BGE.SpriteAtlases.findProblem(invalid))
    end function

    @it("rejects an atlas with no sheets")
    function _()
      m.assertEqual("has no ""sheets"" list", BGE.SpriteAtlases.findProblem({sheets: [], frames: []}))
    end function

    @it("rejects a sheet that isn't a file name")
    function _()
      m.assertEqual("has a sheet that isn't a file name", BGE.SpriteAtlases.findProblem({sheets: [3], frames: []}))
    end function

    @it("rejects a frame missing a field")
    function _()
      parsed = {sheets: ["a.png"], frames: [{x: 0, y: 0, width: 2}]}
      m.assertEqual("frame 0 has no height", BGE.SpriteAtlases.findProblem(parsed))
    end function

    @it("rejects a frame on a sheet that isn't listed")
    function _()
      parsed = {sheets: ["a.png"], frames: [{sheet: 1, x: 0, y: 0, width: 2, height: 2}]}
      m.assertEqual("frame 0 is on a sheet that isn't listed", BGE.SpriteAtlases.findProblem(parsed))
    end function

    @describe("resolveSheetPath")

    @it("resolves a sheet relative to a local json")
    function _()
      m.assertEqual("pkg:/sprites/hero_1.png", BGE.SpriteAtlases.resolveSheetPath("pkg:/sprites/hero.json", "hero_1.png"))
    end function

    @it("resolves a sheet relative to a json URL")
    function _()
      m.assertEqual("https://example.com/art/hero.png", BGE.SpriteAtlases.resolveSheetPath("https://example.com/art/hero.json?v=2", "hero.png"))
    end function

    @it("keeps a sheet that's a URL or has its own volume")
    function _()
      m.assertEqual("https://cdn.example.com/hero.png", BGE.SpriteAtlases.resolveSheetPath("pkg:/sprites/hero.json", "https://cdn.example.com/hero.png"))
      m.assertEqual("tmp:/hero.png", BGE.SpriteAtlases.resolveSheetPath("pkg:/sprites/hero.json", "tmp:/hero.png"))
    end function

    @it("names sheets after the atlas")
    function _()
      atlas = BGE.SpriteAtlases.create("orc", "pkg:/sprites/orc.json", {sheets: ["orc.png", "orc_1.png"], frames: []})
      m.assertEqual(["orc#0", "orc#1"], atlas.sheets)
      m.assertEqual(["pkg:/sprites/orc.png", "pkg:/sprites/orc_1.png"], atlas.sheetPaths)
    end function

  end class

end namespace
