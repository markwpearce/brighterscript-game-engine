namespace tests

  ' Constructs a real BGE.Game with real entities/colliders, the same pattern proven in
  ' GameEntity.spec.bs and the collider spec files, to exercise Game.raycast()/raycastAll()
  ' end-to-end against real Collider.raycastCheck() overrides.
  @suite("BGE.Game raycast")
  class GameRaycastTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("raycast / raycastAll")

    @it("returns invalid/empty when nothing is in the scene")
    function _()
      hit = m.game.raycast(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0))
      m.assertInvalid(hit)
      hits = m.game.raycastAll(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0))
      m.assertEqual(0, hits.count())
    end function

    @it("raycast() returns the nearest of several overlapping colliders, with entity/collider filled in")
    function _()
      near = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Near"}))
      near.position = BGE.Math.VectorOps.create(10, 0)
      near.addCircleCollider("body", 5)

      far = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Far"}))
      far.position = BGE.Math.VectorOps.create(50, 0)
      far.addCircleCollider("body", 5)

      hit = m.game.raycast(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0))
      m.assertNotInvalid(hit)
      m.assertEqual("Near", (hit.entity as BGE.GameEntity).name)
      m.assertTrue(Abs(hit.distance - 25.0) < 0.0001)
    end function

    @it("raycastAll() returns every hit sorted by ascending distance")
    function _()
      near = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Near"}))
      near.position = BGE.Math.VectorOps.create(10, 0)
      near.addCircleCollider("body", 5)

      far = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Far"}))
      far.position = BGE.Math.VectorOps.create(50, 0)
      far.addCircleCollider("body", 5)

      hits = m.game.raycastAll(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0))
      m.assertEqual(2, hits.count())
      m.assertEqual("Near", (hits[0].entity as BGE.GameEntity).name)
      m.assertEqual("Far", (hits[1].entity as BGE.GameEntity).name)
      m.assertTrue(hits[0].distance < hits[1].distance)
    end function

    @it("raycastAll() sorts correctly even when a farther entity is registered before a nearer one (exercises the insertion sort's reordering path)")
    function _()
      ' raycastAll() walks m.sortedEntities in reverse registration order (mirroring
      ' Game.processEntitiesPreDraw()/processEntitiesCollisions()'s own "current scene
      ' first, then sortedEntities in reverse" pattern) - so registering Middle, then
      ' Near, then Far means the raw (pre-sort) hit order is Far, Near, Middle: not
      ' already ascending, forcing the insertion sort's `while` loop to actually move
      ' elements rather than a no-op pass over already-sorted input.
      middle = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Middle"}))
      middle.position = BGE.Math.VectorOps.create(30, 0)
      middle.addCircleCollider("body", 5)

      near = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Near"}))
      near.position = BGE.Math.VectorOps.create(10, 0)
      near.addCircleCollider("body", 5)

      far = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Far"}))
      far.position = BGE.Math.VectorOps.create(50, 0)
      far.addCircleCollider("body", 5)

      hits = m.game.raycastAll(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0))
      m.assertEqual(3, hits.count())
      m.assertEqual("Near", (hits[0].entity as BGE.GameEntity).name)
      m.assertEqual("Middle", (hits[1].entity as BGE.GameEntity).name)
      m.assertEqual("Far", (hits[2].entity as BGE.GameEntity).name)
      m.assertTrue(hits[0].distance < hits[1].distance)
      m.assertTrue(hits[1].distance < hits[2].distance)
    end function

    @it("skips a disabled collider")
    function _()
      entity = m.game.addEntity(new BGE.GameEntity(m.game, {name: "A"}))
      entity.position = BGE.Math.VectorOps.create(10, 0)
      collider = entity.addCircleCollider("body", 5)
      collider.enabled = false

      hit = m.game.raycast(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0))
      m.assertInvalid(hit)
    end function

    @it("skips a disabled entity's collider even when the collider itself is enabled")
    function _()
      entity = m.game.addEntity(new BGE.GameEntity(m.game, {name: "A"}))
      entity.position = BGE.Math.VectorOps.create(10, 0)
      entity.addCircleCollider("body", 5)
      entity.enabled = false

      hit = m.game.raycast(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0))
      m.assertInvalid(hit)
    end function

    @it("tests the current scene's own colliders, not just sortedEntities")
    function _()
      scene = new BGE.GameScene(m.game, {name: "MainScene"})
      scene.position = BGE.Math.VectorOps.create(10, 0)
      scene.addCircleCollider("body", 5)
      m.game.defineScene(scene)
      m.game.changeScene("MainScene")

      hit = m.game.raycast(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0))
      m.assertNotInvalid(hit)
      m.assertEqual("MainScene", (hit.entity as BGE.GameEntity).name)
      m.assertTrue(Abs(hit.distance - 25.0) < 0.0001)
    end function

    @it("returns an empty result for a zero-length direction instead of proceeding with a degenerate ray")
    function _()
      entity = m.game.addEntity(new BGE.GameEntity(m.game, {name: "A"}))
      entity.position = BGE.Math.VectorOps.create(10, 0)
      entity.addCircleCollider("body", 5)

      hit = m.game.raycast(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(0, 0))
      m.assertInvalid(hit)
      hits = m.game.raycastAll(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(0, 0))
      m.assertEqual(0, hits.count())
    end function

    @it("collidableFlags excludes a collider whose memberFlags don't overlap the mask")
    function _()
      entity = m.game.addEntity(new BGE.GameEntity(m.game, {name: "A"}))
      entity.position = BGE.Math.VectorOps.create(10, 0)
      collider = entity.addCircleCollider("body", 5)
      collider.memberFlags = 2

      excluded = m.game.raycast(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0), 1000.0, 1)
      m.assertInvalid(excluded)

      included = m.game.raycast(BGE.Math.VectorOps.create(-20, 0), BGE.Math.VectorOps.create(1, 0), 1000.0, 2)
      m.assertNotInvalid(included)
    end function

  end class

end namespace
