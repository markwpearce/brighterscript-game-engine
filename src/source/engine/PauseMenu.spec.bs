import "pkg:/source/engine/PauseMenu.bs"
import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/GameScene.bs"
import "pkg:/source/engine/GameInput.bs"

namespace tests
  @suite("BGE.PauseMenu")
  class PauseMenuTests extends rooibos.BaseTestSuite

    game as BGE.Game
    sceneA as BGE.GameScene

    protected override function beforeEach()
      m.game = new BGE.Game(640, 480)
      m.sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      m.game.defineScene(m.sceneA)
      m.game.defineScene(new BGE.GameScene(m.game, {name: "TitleScene"}))
      m.game.changeScene("SceneA")
    end function

    @describe("open / close")

    @it("open() pauses and shows a scene-owned panel with the default buttons")
    function _()
      pause = new BGE.PauseMenu(m.game)
      pause.open()
      m.assertTrue(pause.isOpen())
      m.assertTrue(m.game.isPaused())
      m.assertTrue(m.game.isModalOpen())
      m.assertEqual(1, m.sceneA.uiCount())
      m.assertEqual(2, pause.menu.buttons.count())
      m.assertEqual("resume", pause.menu.buttons[0].actionId)
      m.assertEqual("Quit", pause.menu.buttons[1].getLabel())
    end function

    @it("close() removes the panel and resumes")
    function _()
      pause = new BGE.PauseMenu(m.game)
      pause.open()
      pause.close()
      m.assertFalse(pause.isOpen())
      m.assertFalse(m.game.isPaused())
      m.assertEqual(0, m.sceneA.uiCount())
    end function

    @it("the text style pauses without a panel")
    function _()
      pause = new BGE.PauseMenu(m.game, {style: "text"})
      pause.open()
      m.assertTrue(m.game.isPaused())
      m.assertInvalid(pause.menu)
      m.assertEqual(0, m.sceneA.uiCount())
    end function

    @it("blockWhen can keep it from opening")
    function _()
      pause = new BGE.PauseMenu(m.game)
      pause.blockWhen = function(game as BGE.Game) as boolean
        return true
      end function
      pause.open()
      m.assertFalse(pause.isOpen())
      m.assertFalse(m.game.isPaused())
    end function

    @describe("toggle input")

    @it("toggles on the remote's Play when no pause action is bound")
    function _()
      pause = new BGE.PauseMenu(m.game)
      pause.onInput(new BGE.GameInput(13, 0, 0)) ' play
      m.assertTrue(pause.isOpen())
    end function

    @it("uses the pause action when it's bound")
    function _()
      m.game.controls.bindAction("pause", "play")
      pause = new BGE.PauseMenu(m.game)
      pause.onInput(new BGE.GameInput(13, 0, 0))
      m.assertFalse(pause.isOpen())
      m.game.controls.onInput(new BGE.GameInput(13, 0, 0))
      pause.onControls(m.game.controls)
      m.assertTrue(pause.isOpen())
    end function

    @it("Back closes an open menu")
    function _()
      pause = new BGE.PauseMenu(m.game)
      pause.open()
      pause.onInput(new BGE.GameInput(0, 0, 0)) ' back
      m.assertFalse(pause.isOpen())
    end function

    @describe("buttons")

    @it("builds the buttons named in the options, with default labels")
    function _()
      pause = new BGE.PauseMenu(m.game, {buttons: ["resume", "restart", "title"], titleScene: "TitleScene", title: "Hold on"})
      pause.open()
      m.assertEqual(3, pause.menu.buttons.count())
      m.assertEqual("Quit to Title", pause.menu.buttons[2].getLabel())
      m.assertEqual("Hold on", pause.menu.title)
    end function

    @it("Resume closes the menu")
    function _()
      pause = new BGE.PauseMenu(m.game)
      pause.open()
      pause.menu.buttons[0].onClick()
      m.assertFalse(pause.isOpen())
      m.assertFalse(m.game.isPaused())
    end function

    @it("Quit to Title changes scene")
    function _()
      pause = new BGE.PauseMenu(m.game, {buttons: ["title"], titleScene: "TitleScene"})
      pause.open()
      m.game.End()
      pause.menu.buttons[0].onClick()
      m.assertEqual("TitleScene", m.game.getScene().name)
      m.assertFalse(m.game.isPaused())
    end function

    @it("passes custom buttons to the listener")
    function _()
      listener = new RecordingPauseListener()
      pause = new BGE.PauseMenu(m.game, {buttons: []})
      pause.addButton("settings", "Settings")
      pause.listener = listener
      pause.open()
      pause.menu.buttons[0].onClick()
      m.assertEqual("settings", listener.lastActionId)
      m.assertTrue(pause.isOpen())
    end function

    @describe("scene change")

    @it("forgets it was open when the scene changes")
    function _()
      pause = new BGE.PauseMenu(m.game)
      pause.persistent = true
      m.game.addEntity(pause)
      pause.open()
      m.game.End()
      m.game.changeScene("TitleScene")
      m.assertFalse(pause.isOpen())
      m.assertFalse(m.game.isPaused())
      m.assertEqual(0, m.sceneA.uiCount())
    end function

  end class

  class RecordingPauseListener
    lastActionId as string = ""

    sub onUiAction(actionId as string, button as BGE.UI.Button)
      m.lastActionId = actionId
    end sub
  end class
end namespace
