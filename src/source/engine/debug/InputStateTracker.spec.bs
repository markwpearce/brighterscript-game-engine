namespace tests
  @suite("BGE.Debug.InputStateTracker")
  class InputStateTrackerTests extends rooibos.BaseTestSuite

    @describe("onInput")

    @it("tracks several buttons held at once on one player")
    function _()
      tracker = new BGE.Debug.InputStateTracker()
      tracker.onInput(new BGE.GameInput(5, 0, 0)) ' right pressed
      tracker.onInput(new BGE.GameInput(17, 0, 0)) ' a pressed
      state = tracker.getPlayers()[0]
      m.assertTrue(state.isHeld("right"))
      m.assertTrue(state.isHeld("a"))
    end function

    @it("releasing one button keeps the others held")
    function _()
      tracker = new BGE.Debug.InputStateTracker()
      tracker.onInput(new BGE.GameInput(5, 0, 0)) ' right pressed
      tracker.onInput(new BGE.GameInput(17, 0, 0)) ' a pressed
      tracker.onInput(new BGE.GameInput(117, 0, 0)) ' a released
      state = tracker.getPlayers()[0]
      m.assertTrue(state.isHeld("right"))
      m.assertFalse(state.isHeld("a"))
    end function

    @it("keeps each player's buttons separate, sorted by player index")
    function _()
      tracker = new BGE.Debug.InputStateTracker()
      tracker.onInput(new BGE.GameInput(BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE, 0, 1, "b"))
      tracker.onInput(new BGE.GameInput(6, 0, 0)) ' OK pressed
      players = tracker.getPlayers()
      m.assertEqual(players.Count(), 2)
      m.assertEqual(players[0].playerIndex, 0)
      m.assertTrue(players[0].isHeld("ok"))
      m.assertFalse(players[0].isHeld("b"))
      m.assertTrue(players[1].isHeld("b"))
    end function

    @it("maps browser gamepad standard button indexes to names")
    function _()
      tracker = new BGE.Debug.InputStateTracker()
      tracker.onInput(new BGE.GameInput(BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE, 0, 0, "12"))
      tracker.onInput(new BGE.GameInput(BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE, 0, 0, "7"))
      state = tracker.getPlayers()[0]
      m.assertTrue(state.isHeld("up"))
      m.assertTrue(state.isHeld("r2"))
    end function

    @it("adds a button seen only as held, backdated by its held time")
    function _()
      tracker = new BGE.Debug.InputStateTracker()
      tracker.update(2.0)
      tracker.onInput(new BGE.GameInput(1003, 500, 0)) ' down held for 0.5s
      state = tracker.getPlayers()[0]
      m.assertTrue(state.isHeld("down"))
      m.assertEqual(tracker.getHeldSeconds(state, "down"), 0.5)
    end function

    @it("ignores unknown buttons")
    function _()
      tracker = new BGE.Debug.InputStateTracker()
      tracker.onInput(new BGE.GameInput(1, 0, 0)) ' "unknown"
      m.assertEqual(tracker.getPlayers().Count(), 0)
    end function

    @describe("gamepad detection")

    @it("a remote's buttons leave a player as a remote")
    function _()
      tracker = new BGE.Debug.InputStateTracker()
      tracker.onInput(new BGE.GameInput(6, 0, 0)) ' OK
      m.assertFalse(tracker.getPlayers()[0].isGamepad)
    end function

    @it("a gamepad-only button marks a player as a gamepad")
    function _()
      tracker = new BGE.Debug.InputStateTracker()
      tracker.onInput(new BGE.GameInput(26, 0, 0)) ' l1
      tracker.onInput(new BGE.GameInput(126, 0, 0)) ' l1 released
      m.assertTrue(tracker.getPlayers()[0].isGamepad)
    end function

    @describe("getHeldSeconds")

    @it("counts up with update() while held, 0 once released")
    function _()
      tracker = new BGE.Debug.InputStateTracker()
      tracker.onInput(new BGE.GameInput(2, 0, 0)) ' up pressed
      tracker.update(0.25)
      tracker.update(0.25)
      state = tracker.getPlayers()[0]
      m.assertEqual(tracker.getHeldSeconds(state, "up"), 0.5)
      tracker.onInput(new BGE.GameInput(102, 0, 0)) ' up released
      m.assertEqual(tracker.getHeldSeconds(state, "up"), 0.0)
    end function

  end class
end namespace
