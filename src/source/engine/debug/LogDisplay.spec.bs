import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/debug/LogDisplay.bs"

namespace tests

  @suite("BGE.Debug.LogDisplay")
  class LogDisplayTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("onUpdate")

    @it("shows the latest messages")
    function _()
      display = new BGE.Debug.LogDisplay(m.game)
      m.game.log("one")
      m.game.log("two", BGE.Debug.LogLevel.warning)
      display.onUpdate(0)
      lines = display.getLineTextsForTest()
      m.assertEqual(lines[0], "one")
      m.assertEqual(lines[1], "two")
      m.assertEqual(lines[2], "")
    end function

    @it("keeps showing new messages once the log history is full")
    function _()
      display = new BGE.Debug.LogDisplay(m.game)
      for i = 1 to 150
        m.game.log("message " + i.toStr())
      end for
      display.onUpdate(0)
      m.game.log("latest")
      display.onUpdate(0)
      lines = display.getLineTextsForTest()
      m.assertEqual(lines[lines.count() - 1], "latest")
      m.assertEqual(lines[lines.count() - 2], "message 150")
    end function

  end class

end namespace
