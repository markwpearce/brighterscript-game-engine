import "../../math/vector.bs"

namespace BGE.Debug

  ' What one player's remote/gamepad/controller is doing right now, as tracked by
  ' BGE.Debug.InputStateTracker for the input debug window.
  class InputPlayerState

    playerIndex as integer
    ' True once this player sends a gamepad-only button or moves a stick
    isGamepad as boolean = false
    ' Lowercased button name -> tracker clock (seconds) when it was pressed, only while held
    pressedAt = {}
    leftStick as BGE.Math.Vector
    rightStick as BGE.Math.Vector

    sub new(playerIndex as integer)
      m.playerIndex = playerIndex
      m.leftStick = BGE.Math.VectorOps.create()
      m.rightStick = BGE.Math.VectorOps.create()
    end sub

    ' @param {string} buttonName - lowercased button name
    ' @return {boolean}
    function isHeld(buttonName as string) as boolean
      return m.pressedAt.DoesExist(buttonName)
    end function

    ' @param {string[]} buttonNames - lowercased button names
    ' @return {boolean} - true if any of them is held
    function isAnyHeld(buttonNames as string[]) as boolean
      for each buttonName in buttonNames
        if m.pressedAt.DoesExist(buttonName)
          return true
        end if
      end for
      return false
    end function

  end class

end namespace
