import "LogLevel.bs"

namespace BGE.Debug

  ' Where BGE.Debug.logMessage() sends messages - a BGE.Game registers itself as one when it's created.
  interface Logger
    sub log(message as string, level as BGE.Debug.LogLevel)
  end interface

  ' Logs a message from code with no Game to hand: through the current Game's log() (so it's
  ' kept in its history and shown by BGE.Debug.LogDisplay), or printed when this thread has
  ' no Game, e.g. inside a Task.
  '
  ' @param {string} message
  ' @param {BGE.Debug.LogLevel} [level=BGE.Debug.LogLevel.info]
  ' @return {void}
  sub logMessage(message as string, level = BGE.Debug.LogLevel.info as BGE.Debug.LogLevel)
    logger = GetGlobalAA().bgeLogger
    if invalid <> logger
      (logger as BGE.Debug.Logger).log(message, level)
    else
      print "[" + level + "] " + message
    end if
  end sub

  ' Sets where logMessage() sends messages on this thread (invalid to just print them).
  '
  ' @param {BGE.Debug.Logger} logger
  ' @return {void}
  sub setLogger(logger as dynamic)
    GetGlobalAA().bgeLogger = logger
  end sub

end namespace
