import "../controller/ControlMap.bs"
import "../GameInput.bs"
import "InputPlayerState.bs"

namespace BGE.Debug

  ' Tracks every button each player is holding, from GameInput press/release events.
  ' Game's own held events keep only one button per remote, so they can't show
  ' simultaneous gamepad buttons - press/release can.
  class InputStateTracker

    ' playerIndex.ToStr() -> InputPlayerState
    private players = {}
    private clockSeconds as float = 0

    ' Browser gamepads also send standard-mapping button indexes as names.
    private standardGamepadButtons = {
      "0": "a",
      "1": "b",
      "2": "x",
      "3": "y",
      "4": "l1",
      "5": "r1",
      "6": "l2",
      "7": "r2",
      "8": "options",
      "9": "back",
      "12": "up",
      "13": "down",
      "14": "left",
      "15": "right"
    }
    private gamepadOnlyButtons = {a: true, b: true, x: true, y: true, l1: true, r1: true, l2: true, r2: true}

    ' @param {BGE.GameInput} input
    ' @return {void}
    sub onInput(input as BGE.GameInput)
      if input.button = invalid or input.button = "" or input.button = "unknown"
        return
      end if
      name = m.normalizeButtonName(input.button)
      state = m.getOrCreatePlayer(input.playerIndex)
      if m.gamepadOnlyButtons.DoesExist(name)
        state.isGamepad = true
      end if
      if input.release
        state.pressedAt.Delete(name)
      else if input.press
        state.pressedAt[name] = m.clockSeconds
      else if not state.pressedAt.DoesExist(name)
        ' A held event without a press we saw, e.g. pressed before the window existed
        state.pressedAt[name] = m.clockSeconds - input.heldTimeMs / 1000
      end if
    end sub

    ' Advances the clock and reads every known player's sticks.
    '
    ' @param {float} dt - seconds since last frame
    ' @param {BGE.Controller.ControlMap} [controls=invalid] - stick source; sticks stay neutral without one
    ' @return {void}
    sub update(dt as float, controls = invalid as BGE.Controller.ControlMap)
      m.clockSeconds += dt
      if controls = invalid
        return
      end if
      for each key in m.players
        state = m.players[key] as BGE.Debug.InputPlayerState
        state.leftStick = controls.getPlayerStick(state.playerIndex, "1")
        state.rightStick = controls.getPlayerStick(state.playerIndex, "2")
        if not BGE.Math.VectorOps.isZero(state.leftStick) or not BGE.Math.VectorOps.isZero(state.rightStick)
          state.isGamepad = true
        end if
      end for
    end sub

    ' @return {BGE.Debug.InputPlayerState[]} - every player seen so far, by ascending playerIndex
    function getPlayers() as BGE.Debug.InputPlayerState[]
      result = [] as BGE.Debug.InputPlayerState[]
      for each key in m.players
        result.Push(m.players[key])
      end for
      result.SortBy("playerIndex")
      return result
    end function

    ' @param {BGE.Debug.InputPlayerState} state
    ' @param {string} buttonName - lowercased button name
    ' @return {float} - seconds this button has been held, 0 if it isn't
    function getHeldSeconds(state as BGE.Debug.InputPlayerState, buttonName as string) as float
      pressedAt = state.pressedAt[buttonName]
      if pressedAt = invalid
        return 0
      end if
      return m.clockSeconds - pressedAt
    end function

    private function normalizeButtonName(buttonName as string) as string
      name = LCase(buttonName)
      return m.standardGamepadButtons[name] ?? name
    end function

    private function getOrCreatePlayer(playerIndex as integer) as BGE.Debug.InputPlayerState
      key = playerIndex.ToStr()
      state = m.players[key]
      if state = invalid
        state = new BGE.Debug.InputPlayerState(playerIndex)
        m.players[key] = state
      end if
      return state
    end function

  end class

end namespace
