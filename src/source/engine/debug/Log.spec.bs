import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/debug/Log.bs"

namespace tests

  @suite("BGE.Debug.logMessage")
  class LogMessageTests extends rooibos.BaseTestSuite

    protected override function afterEach()
      BGE.Debug.setLogger(invalid)
    end function

    @describe("logMessage")

    @it("logs through the most recently created game")
    function _()
      firstGame = new BGE.Game(320, 240)
      game = new BGE.Game(320, 240)
      BGE.Debug.logMessage("hello", BGE.Debug.LogLevel.warning)
      history = game.getLogHistory()
      last = history[history.count() - 1]
      m.assertEqual(last.message, "hello")
      m.assertEqual(last.level, "warning")
      m.assertEqual(firstGame.getLogHistory().count(), 0)
    end function

    @it("defaults to info")
    function _()
      game = new BGE.Game(320, 240)
      BGE.Debug.logMessage("fyi")
      history = game.getLogHistory()
      m.assertEqual(history[history.count() - 1].level, "info")
    end function

    @it("prints without error when there's no game")
    function _()
      BGE.Debug.setLogger(invalid)
      BGE.Debug.logMessage("nobody's listening", BGE.Debug.LogLevel.error)
      m.assertTrue(true)
    end function

  end class

end namespace
