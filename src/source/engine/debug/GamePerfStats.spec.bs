import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/debug/PerfStats.bs"

namespace tests

  @suite("Game.debugPrintPerfStats")
  class GamePerfStatsTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    ' Options that keep each interval's stats in `reports` instead of printing them
    private function capturingOptions() as BGE.Debug.PerfStatsOptions
      return {
        printToConsole: false,
        reports: [],
        onStats: sub(stats as BGE.Debug.PerfStatsSummary, game as BGE.Game)
          m.reports.push(stats)
        end sub
      }
    end function

    @describe("debugPrintPerfStats")

    @it("leaves the renderer's stage timers alone with no options")
    function _()
      m.game.debugPrintPerfStats(true, 3)
      m.game.recordPerfStatsFrameForTest(16.0)
      m.assertFalse(m.game.canvas.renderer.profileStages)
      m.assertTrue(m.game.getDebugValue("print_perf_stats"))
      m.assertEqual(m.game.getDebugValue("perf_stats_interval_seconds"), 3.0)
    end function

    @it("passes each interval's frames, counts and phases to onStats, then starts over")
    function _()
      options = m.capturingOptions()
      options.runId = "run1"
      m.game.debugPrintPerfStats(true, 3, options)
      m.game.recordPerfStatsFrameForTest(20.0)
      m.game.recordPerfStatsFrameForTest(40.0)
      m.game.reportPerfStatsForTest({swap: 5})
      m.game.recordPerfStatsFrameForTest(10.0)
      m.game.reportPerfStatsForTest()
      m.assertEqual(options.reports.count(), 2)
      first = options.reports[0] as BGE.Debug.PerfStatsSummary
      m.assertEqual(first.frames, 2)
      m.assertEqual(first.frameMs, 30.0)
      m.assertEqual(first.runId, "run1")
      m.assertEqual(first.entityCount, 0)
      m.assertEqual(first.phaseMs.swap, 5)
      second = options.reports[1] as BGE.Debug.PerfStatsSummary
      m.assertEqual(second.frames, 1)
      m.assertEqual(second.maxMs, 10.0)
    end function

    @it("passes on percentiles and spikeFactor")
    function _()
      options = m.capturingOptions()
      options.percentiles = [0.99]
      options.spikeFactor = 3.0
      m.game.debugPrintPerfStats(true, 3, options)
      m.game.recordPerfStatsFrameForTest(10.0)
      m.game.recordPerfStatsFrameForTest(25.0)
      m.game.reportPerfStatsForTest()
      summary = options.reports[0] as BGE.Debug.PerfStatsSummary
      m.assertEqual(summary.percentileMs.count(), 1)
      m.assertEqual(summary.percentileMs[0], 25.0)
      m.assertEqual(summary.spikes, 0)
    end function

    @it("turns the renderer's stage timers on for stages, and off again after")
    function _()
      options = m.capturingOptions()
      options.stages = true
      m.game.debugPrintPerfStats(true, 3, options)
      m.assertTrue(m.game.canvas.renderer.profileStages)
      m.game.debugPrintPerfStats(false)
      m.assertFalse(m.game.canvas.renderer.profileStages)
    end function

    @it("leaves stage timers the game turned on itself")
    function _()
      m.game.canvas.renderer.profileStages = true
      options = m.capturingOptions()
      options.stages = true
      m.game.debugPrintPerfStats(true, 3, options)
      m.game.debugPrintPerfStats(false)
      m.assertTrue(m.game.canvas.renderer.profileStages)
    end function

    @it("collects nothing once turned off")
    function _()
      options = m.capturingOptions()
      m.game.debugPrintPerfStats(true, 3, options)
      m.game.debugPrintPerfStats(false)
      m.game.recordPerfStatsFrameForTest(10.0)
      m.game.reportPerfStatsForTest()
      m.assertEqual(options.reports.count(), 0)
    end function

  end class

end namespace
