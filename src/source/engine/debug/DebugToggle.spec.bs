import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/GameEntity.bs"
import "pkg:/source/engine/GameInput.bs"
import "pkg:/source/engine/debug/DebugToggle.bs"

namespace tests

  ' Records "debugLevelChanged" events
  class DebugLevelListener extends BGE.GameEntity
    levels as integer[] = []
    previousLevels as integer[] = []

    sub new(game as BGE.Game)
      super(game)
      m.name = "DebugLevelListener"
    end sub

    override sub onGameEvent(eventName as string, data as roAssociativeArray)
      if eventName = "debugLevelChanged"
        m.levels.push(data.level)
        m.previousLevels.push(data.previousLevel)
      end if
    end sub
  end class

  ' Counts the levels applied, to check applyLevel() can be overridden
  class CountingDebugToggle extends BGE.Debug.DebugToggle
    applied as integer = 0

    sub new(game as BGE.Game, options as BGE.Debug.DebugToggleOptions)
      super(game, options)
    end sub

    protected override sub applyLevel(settings as BGE.Debug.DebugLevel)
      m.applied++
    end sub
  end class

  @suite("BGE.Debug.DebugToggle")
  class DebugToggleTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    ' A press of the remote's options (*) button
    private function optionsPress() as BGE.GameInput
      return new BGE.GameInput(10, 0, 0)
    end function

    @describe("enableDebugToggle")

    @it("binds nothing until a game calls it")
    function _()
      m.assertInvalid(m.game.debugToggle)
      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertFalse(m.game.isDebugUiEnabled())
    end function

    @it("defaults to options cycling off, panels, entity details, colliders")
    function _()
      toggle = m.game.enableDebugToggle()
      m.assertEqual(toggle.button, "options")
      m.assertEqual(toggle.getLevelCount(), 4)

      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertTrue(m.game.isDebugUiEnabled())
      m.assertFalse(m.game.isDebugDrawingEntityDetails())

      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertTrue(m.game.isDebugDrawingEntityDetails())
      m.assertFalse(m.game.isDebugDrawingColliders())

      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertTrue(m.game.isDebugDrawingColliders())

      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 0)
      m.assertFalse(m.game.isDebugUiEnabled())
      m.assertFalse(m.game.isDebugDrawingEntityDetails())
      m.assertFalse(m.game.isDebugDrawingColliders())
    end function

    @describe("input")

    @it("ignores releases and other buttons")
    function _()
      toggle = m.game.enableDebugToggle()
      m.game.processDebugToggleForTest([new BGE.GameInput(110, 0, 0), new BGE.GameInput(6, 0, 0)] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 0)
    end function

    @it("uses the button it's given, with aliases")
    function _()
      toggle = m.game.enableDebugToggle({button: "replay"})
      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 0)
      m.game.processDebugToggleForTest([new BGE.GameInput(7, 0, 0)] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 1)
    end function

    @it("does nothing while disabled")
    function _()
      toggle = m.game.enableDebugToggle({enabled: false})
      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 0)
      toggle.enabled = true
      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 1)
    end function

    @it("skips a frame a widget captured input in")
    function _()
      toggle = m.game.enableDebugToggle()
      entity = new BGE.GameEntity(m.game, {name: "Widget"})
      m.game.addEntity(entity)
      m.game.setInputEntity(entity)
      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 0)
    end function

    @it("skips a press dropped by suppressInputUntilRelease")
    function _()
      toggle = m.game.enableDebugToggle()
      m.game.suppressInputUntilRelease()
      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 0)
    end function

    @it("steps once per frame for several presses")
    function _()
      toggle = m.game.enableDebugToggle()
      m.game.processDebugToggleForTest([m.optionsPress(), m.optionsPress()] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 1)
    end function

    @it("uses a bound action instead of the button")
    function _()
      m.game.controls.bindAction("debug", "replay")
      toggle = m.game.enableDebugToggle({action: "debug"})
      m.assertFalse(toggle.handleInput(m.optionsPress()))
      m.game.controls.beginFrame()
      m.game.controls.onInput(new BGE.GameInput(7, 0, 0))
      m.game.processDebugToggleForTest([] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 1)
    end function

    @it("falls back to the button when the action isn't bound")
    function _()
      toggle = m.game.enableDebugToggle({action: "debug"})
      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertEqual(toggle.getLevel(), 1)
    end function

    @describe("levels")

    @it("only touches flags some level sets")
    function _()
      m.game.debugDrawSafeZones(true)
      m.game.debugDrawColliders(true)
      toggle = m.game.enableDebugToggle({levels: [{}, {showUi: true}]})
      toggle.nextLevel()
      m.assertTrue(m.game.isDebugUiEnabled())
      m.assertTrue(m.game.isDebugDrawingSafeZones())
      m.assertTrue(m.game.isDebugDrawingColliders())
      toggle.nextLevel()
      m.assertFalse(m.game.isDebugUiEnabled())
      m.assertTrue(m.game.isDebugDrawingColliders())
    end function

    @it("turns a managed flag a level leaves out off")
    function _()
      toggle = m.game.enableDebugToggle({levels: [{showUi: true, safeZones: true}, {showUi: true}]})
      toggle.setLevel(0)
      m.assertTrue(m.game.isDebugDrawingSafeZones())
      toggle.nextLevel()
      m.assertTrue(m.game.isDebugUiEnabled())
      m.assertFalse(m.game.isDebugDrawingSafeZones())
    end function

    @it("startLevel sets where the first press moves on from, without applying it")
    function _()
      m.game.debugShowUi(true)
      toggle = m.game.enableDebugToggle({levels: [{}, {showUi: true, colliders: true}], startLevel: 1})
      m.assertEqual(toggle.getLevel(), 1)
      m.assertFalse(m.game.isDebugDrawingColliders())
      toggle.nextLevel()
      m.assertEqual(toggle.getLevel(), 0)
      m.assertFalse(m.game.isDebugUiEnabled())
    end function

    @it("panels replaces the debug UI's children")
    function _()
      toggle = m.game.enableDebugToggle({levels: [{}, {showUi: true, panels: {input: false, memory: false, garbageCollector: false, log: false}}, {showUi: true, panels: {}}]})
      m.game.debugUi.addChild(new BGE.UI.UiContainer(m.game))
      toggle.nextLevel()
      m.assertEqual(m.game.debugUi.childCount(), 1)
      toggle.nextLevel()
      m.assertEqual(m.game.debugUi.childCount(), 5)
      toggle.nextLevel()
      m.assertEqual(m.game.debugUi.childCount(), 5)
    end function

    @it("calls a level's apply callback with the game")
    function _()
      callback = sub(game as BGE.Game)
        game.debugDrawSafeZones(true)
      end sub
      toggle = m.game.enableDebugToggle({levels: [{}, {apply: callback}]})
      toggle.nextLevel()
      m.assertTrue(m.game.isDebugDrawingSafeZones())
    end function

    @it("posts debugLevelChanged with the new and previous level")
    function _()
      listener = new tests.DebugLevelListener(m.game)
      m.game.addEntity(listener)
      toggle = m.game.enableDebugToggle()
      toggle.nextLevel()
      toggle.setLevel(3)
      m.assertEqual(listener.levels, [1, 3])
      m.assertEqual(listener.previousLevels, [0, 1])
    end function

    @it("a subclass assigned to game.debugToggle can override applyLevel")
    function _()
      toggle = new tests.CountingDebugToggle(m.game, {})
      m.game.debugToggle = toggle
      m.game.processDebugToggleForTest([m.optionsPress()] as BGE.GameInput[])
      m.assertEqual(toggle.applied, 1)
      m.assertFalse(m.game.isDebugUiEnabled())
    end function
  end class

end namespace
