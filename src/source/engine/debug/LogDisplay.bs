namespace BGE.Debug

  ' A debug window that shows the most recent messages logged via Game.log(), color coded by level
  ' (white for info, yellow for warning, red for error). Auto-scrolls to always show the latest entries.
  class LogDisplay extends DebugWindow

    private maxLines = 6
    private topInset = 6
    private leftInset = 10
    private lines as BGE.UI.Label[] = []
    private lastRenderedCount = 0

    sub new(game as BGE.Game)
      super(game)
      font = m.game.getFont("debugUi")
      lineHeight = font.GetOneLineHeight()

      m.horizAlign = "center"
      m.vertAlign = "bottom"
      m.width = 750
      m.height = lineHeight * m.maxLines + m.topInset * 2

      for i = 0 to m.maxLines - 1
        lineLabel = new BGE.UI.Label(game)
        lineLabel.drawableText.font = font
        lineLabel.customPosition = true
        lineLabel.customX = m.leftInset
        lineLabel.customY = m.topInset + i * lineHeight
        m.addChild(lineLabel)
        m.lines.Push(lineLabel)
      end for
    end sub

    override sub onUpdate(dt as float)
      history = m.game.getLogHistory()
      if history.Count() = m.lastRenderedCount
        return
      end if
      m.lastRenderedCount = history.Count()

      startIndex = BGE.Math.max(0, history.Count() - m.maxLines)
      for i = 0 to m.maxLines - 1
        historyIndex = startIndex + i
        lineLabel = m.lines[i]
        if historyIndex < history.Count()
          entry = history[historyIndex]
          lineLabel.setText(entry.message)
          lineLabel.drawableText.textColor = m.colorForLevel(entry.level)
        else
          lineLabel.setText("")
        end if
      end for
    end sub

    private function colorForLevel(level as BGE.Debug.LogLevel) as integer
      if level = BGE.Debug.LogLevel.error
        return BGE.Colors.Red
      else if level = BGE.Debug.LogLevel.warning
        return BGE.Colors.Yellow
      end if
      return BGE.Colors.White
    end function

  end class

end namespace
