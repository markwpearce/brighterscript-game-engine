import "ImpostorFit.bs"

namespace tests

  @suite("BGE.ImpostorFit")
  class ImpostorFitTests extends rooibos.BaseTestSuite

    ' A box's corners, so every fit has points spread on both axes.
    private fromX = [100.0, 300.0, 300.0, 100.0, 150.0, 250.0]
    private fromY = [100.0, 100.0, 250.0, 250.0, 175.0, 120.0]

    @describe("fitScaleTranslate")

    @it("is exact for a scale and offset")
    function _()
      toX = [] as float[]
      toY = [] as float[]
      for i = 0 to m.fromX.count() - 1
        toX.push(m.fromX[i] * 1.5 + 20)
        toY.push(m.fromY[i] * 0.8 - 10)
      end for
      fit = BGE.ImpostorFit.fitScaleTranslate(m.fromX, m.fromY, toX, toY)
      m.assertTrue(fit.residual < 0.01)
      m.assertTrue(Abs(fit.params.scaleX - 1.5) < 0.001)
      m.assertTrue(Abs(fit.params.offsetY + 10) < 0.01)
    end function

    @it("reports how far a rotation is from fitting")
    function _()
      rotated = m.rotate(m.fromX, m.fromY, 0.1)
      fit = BGE.ImpostorFit.fitScaleTranslate(m.fromX, m.fromY, rotated.x, rotated.y)
      m.assertTrue(fit.residual > 3)
    end function

    @it("refuses a mirrored axis")
    function _()
      toX = [] as float[]
      for each x in m.fromX
        toX.push(-x)
      end for
      fit = BGE.ImpostorFit.fitScaleTranslate(m.fromX, m.fromY, toX, m.fromY)
      m.assertInvalid(fit.params)
    end function

    @describe("fitRotateScale")

    @it("is exact for a rotation with a uniform scale")
    function _()
      rotated = m.rotate(m.fromX, m.fromY, 0.2)
      toX = [] as float[]
      toY = [] as float[]
      for i = 0 to rotated.x.count() - 1
        toX.push(rotated.x[i] * 1.2 + 5)
        toY.push(rotated.y[i] * 1.2 + 7)
      end for
      fit = BGE.ImpostorFit.fitRotateScale(m.fromX, m.fromY, toX, toY)
      m.assertTrue(fit.residual < 0.05)
      m.assertTrue(Abs(fit.params.rotation - 0.2) < 0.001)
    end function

    @describe("fitAffine")

    @it("is exact for a shear")
    function _()
      toX = [] as float[]
      toY = [] as float[]
      for i = 0 to m.fromX.count() - 1
        toX.push(m.fromX[i] + 0.3 * m.fromY[i] + 4)
        toY.push(m.fromY[i] * 1.1 - 2)
      end for
      fit = BGE.ImpostorFit.fitAffine(m.fromX, m.fromY, toX, toY)
      m.assertTrue(fit.residual < 0.01)
      m.assertTrue(Abs(fit.params.b - 0.3) < 0.001)
      m.assertTrue(Abs(fit.params.c - 4) < 0.01)
    end function

    @it("reports the error a perspective change leaves")
    function _()
      ' the right side grows taller, the left stays put - not affine
      toX = [] as float[]
      toY = [] as float[]
      for i = 0 to m.fromX.count() - 1
        t = (m.fromX[i] - 100) / 200
        toX.push(m.fromX[i])
        toY.push(175 + (m.fromY[i] - 175) * (1 + 0.4 * t))
      end for
      fit = BGE.ImpostorFit.fitAffine(m.fromX, m.fromY, toX, toY)
      m.assertTrue(fit.residual > 1)
      m.assertTrue(fit.residual < 20)
    end function

    private function rotate(xs as float[], ys as float[], angle as float) as roAssociativeArray
      outX = [] as float[]
      outY = [] as float[]
      for i = 0 to xs.count() - 1
        outX.push(xs[i] * Cos(angle) - ys[i] * Sin(angle))
        outY.push(xs[i] * Sin(angle) + ys[i] * Cos(angle))
      end for
      return {x: outX, y: outY}
    end function

    @describe("fitPinnedCorners")

    @it("is exact for a different affine map in each of its four triangles")
    function _()
      ' top left, top right, bottom right, bottom left and centre of a 200x150 bitmap
      fit = m.fitPinTo([10.0, 230.0, 250.0, 0.0, 130.0], [20.0, 0.0, 180.0, 160.0, 70.0])
      m.assertTrue(fit.residual < 0.01)
      m.assertTrue(Abs(fit.params.cornersX[1] - 230) < 0.01)
      m.assertTrue(Abs(fit.params.cornersY[3] - 160) < 0.01)
      m.assertTrue(Abs(fit.params.cornersX[4] - 130) < 0.01)
    end function

    @it("follows a perspective foreshortened quad closer than one diagonal can")
    function _()
      ' a 200x150 bitmap seen as a trapezoid narrowing to the right
      fromX = [] as float[]
      fromY = [] as float[]
      toX = [] as float[]
      toY = [] as float[]
      for gy = 0 to 6
        for gx = 0 to 8
          u = gx / 8
          v = gy / 6
          ' projective: the right edge is 1.25x as far away as the left
          d = 1 + 0.25 * u
          fromX.push(u * 200)
          fromY.push(v * 150)
          toX.push(250 * u / d)
          toY.push(75 + (v * 150 - 75) / d)
        end for
      end for
      fit = BGE.ImpostorFit.fitPinnedCorners(fromX, fromY, toX, toY, 200, 150)
      m.assertNotInvalid(fit.params)
      ' a two triangle pin of the same quad is off by 9.4px, four triangles by 6.9px
      m.assertTrue(fit.residual < 8, `residual ${fit.residual}`)
    end function

    @it("reports a warp no pinned triangle can follow")
    function _()
      ' the centre stays put but a point just below it jumps up
      fromX = [0.0, 200.0, 200.0, 0.0, 100.0, 100.0]
      fromY = [0.0, 0.0, 150.0, 150.0, 75.0, 100.0]
      toX = [0.0, 200.0, 200.0, 0.0, 100.0, 100.0]
      toY = [0.0, 0.0, 150.0, 150.0, 75.0, 40.0]
      fit = BGE.ImpostorFit.fitPinnedCorners(fromX, fromY, toX, toY, 200, 150)
      m.assertNotInvalid(fit.params)
      m.assertTrue(fit.residual > 20, `residual ${fit.residual}`)
    end function

    @it("fits two triangles along the diagonal when asked")
    function _()
      params = {cornersX: [10.0, 230.0, 250.0, 0.0], cornersY: [20.0, 0.0, 180.0, 160.0], width: 200.0, height: 150.0}
      fromX = [0.0, 200.0, 200.0, 0.0, 150.0, 40.0, 100.0] as float[]
      fromY = [0.0, 0.0, 150.0, 150.0, 30.0, 120.0, 75.0] as float[]
      toX = [] as float[]
      toY = [] as float[]
      for i = 0 to fromX.count() - 1
        p = BGE.ImpostorFit.mapPinnedCorners(params, fromX[i], fromY[i])
        toX.push(p.x)
        toY.push(p.y)
      end for
      fit = BGE.ImpostorFit.fitPinnedCorners(fromX, fromY, toX, toY, 200, 150, false)
      m.assertTrue(fit.residual < 0.01)
      m.assertEqual(fit.params.cornersX.count(), 4)
      m.assertFalse(BGE.ImpostorFit.isFourTrianglePin(fit.params))
    end function

    @describe("mapPinnedRect")

    @it("bounds a rectangle the pinned centre bulges out of")
    function _()
      ' the centre pushed 30px right: a small box around it bends past its own corners, which
      ' reach x = 134, to 137 where its right edge crosses the diagonals
      params = {cornersX: [0.0, 200.0, 200.0, 0.0, 130.0], cornersY: [0.0, 0.0, 150.0, 150.0, 75.0], width: 200.0, height: 150.0}
      maxX = -1000.0
      for each p in BGE.ImpostorFit.mapPinnedRect(params, 90, 60, 110, 90)
        maxX = BGE.Math.Max(maxX, p.x)
      end for
      m.assertTrue(Abs(maxX - 137) < 0.01, `max x ${maxX}`)
    end function

    @it("maps just the corners of a rectangle inside one triangle")
    function _()
      params = {cornersX: [0.0, 200.0, 200.0, 0.0, 100.0], cornersY: [0.0, 0.0, 150.0, 150.0, 75.0], width: 200.0, height: 150.0}
      m.assertEqual(BGE.ImpostorFit.mapPinnedRect(params, 90, 5, 110, 20).count(), 4)
    end function

    @describe("pinMaxStretch")

    @it("is 1 for an unmoved pin")
    function _()
      params = {cornersX: [0.0, 200.0, 200.0, 0.0, 100.0], cornersY: [0.0, 0.0, 150.0, 150.0, 75.0], width: 200.0, height: 150.0}
      m.assertTrue(Abs(BGE.ImpostorFit.pinMaxStretch(params) - 1) < 0.001)
    end function

    @it("measures a triangle the centre stretches")
    function _()
      ' the centre pushed 80px right: the spoke from the top left grows from 125 to ~189
      params = {cornersX: [0.0, 200.0, 200.0, 0.0, 180.0], cornersY: [0.0, 0.0, 150.0, 150.0, 75.0], width: 200.0, height: 150.0}
      m.assertTrue(BGE.ImpostorFit.pinMaxStretch(params) > 1.5)
    end function

    @it("refuses a mirrored pin")
    function _()
      fit = m.fitPinTo([200.0, 0.0, 0.0, 200.0, 100.0], [0.0, 0.0, 150.0, 150.0, 75.0])
      m.assertInvalid(fit.params)
    end function

    @describe("convexHullIndexes")

    @it("leaves out interior points")
    function _()
      hull = BGE.ImpostorFit.convexHullIndexes([0.0, 10.0, 5.0, 10.0, 0.0], [0.0, 0.0, 5.0, 10.0, 10.0])
      m.assertEqual(hull.count(), 4)
      m.assertArrayNotContains(hull, 2)
    end function

    @it("keeps every corner of a large set whose right edge x only differs by rounding")
    function _()
      xs = [0.0, 100.03, 100.01, 0.0] as float[]
      ys = [0.0, 0.0, 100.0, 100.0] as float[]
      for i = 1 to 20
        xs.push(10 + i * 4)
        ys.push(20 + (i mod 5) * 12)
      end for
      hull = BGE.ImpostorFit.convexHullIndexes(xs, ys)
      m.assertEqual(hull.count(), 4)
      for i = 0 to 3
        m.assertArrayContains(hull, i)
      end for
    end function

    ' Points spread over all four triangles of a 200x150 bitmap, mapped through the pin
    ' with these corners and centre, then fitted back.
    private function fitPinTo(cornersX as float[], cornersY as float[]) as BGE.ImpostorFit.FitResult
      params = {cornersX: cornersX, cornersY: cornersY, width: 200.0, height: 150.0}
      fromX = [0.0, 200.0, 200.0, 0.0, 150.0, 40.0, 100.0, 180.0, 20.0, 190.0, 10.0] as float[]
      fromY = [0.0, 0.0, 150.0, 150.0, 30.0, 120.0, 75.0, 140.0, 10.0, 75.0, 75.0] as float[]
      toX = [] as float[]
      toY = [] as float[]
      for i = 0 to fromX.count() - 1
        p = BGE.ImpostorFit.mapPinnedCorners(params, fromX[i], fromY[i])
        toX.push(p.x)
        toY.push(p.y)
      end for
      return BGE.ImpostorFit.fitPinnedCorners(fromX, fromY, toX, toY, 200, 150)
    end function

  end class

end namespace
