namespace tests

  ' ScratchBitmapPool hands out reusable off-screen bitmap regions so the
  ' renderer doesn't have to allocate a new roBitmap for every scratch draw.
  ' Note: under the simulator/brs-cli, ScratchBitmapPool normally force-disables
  ' pooling itself (it checks roDeviceInfo's "simulation_engine" feature)
  ' regardless of what's passed to the constructor, which would make pool-reuse
  ' internals (including the per-frame reuse below) unobservable here - so
  ' these tests pass forcePoolingRegardlessOfDevice (the 3rd constructor arg,
  ' test-only) to exercise the real pooling path under brs-cli.
  @suite("BGE.ScratchBitmapPool")
  class ScratchBitmapPoolTests extends rooibos.BaseTestSuite

    pool as BGE.ScratchBitmapPool

    protected override function beforeEach()
      m.pool = new BGE.ScratchBitmapPool(true, 2, true)
    end function

    @describe("getRegion")

    @it("returns a region sized (at least) to what was asked for")
    function _()
      scratchRegion = m.pool.getRegion(50, 30)
      m.assertNotInvalid(scratchRegion)
      m.assertTrue(scratchRegion.region.getWidth() >= 50)
      m.assertTrue(scratchRegion.region.getHeight() >= 30)
    end function

    @it("scales a region asked for bigger than the scratch size to fit it")
    function _()
      ' brs-cli pooling uses the default 1080 scratch size
      scratchRegion = m.pool.getRegion(2160, 100)
      m.assertEqual(1080, scratchRegion.region.getWidth())
      m.assertTrue(Abs(scratchRegion.scale.x - 0.5) < 0.001)
      m.assertTrue(Abs(scratchRegion.scale.y - 0.5) < 0.001)
    end function

    @it("scales an oversized one-off from a used-up pool the same way (#734)")
    function _()
      for i = 1 to m.pool.getMaxPoolCount()
        m.pool.returnRegions([m.pool.getRegion(10, 10)])
      end for
      oneOff = m.pool.getRegion(2160, 100)
      m.assertEqual("temp", oneOff.scratchBmp.id)
      m.assertEqual(1080, oneOff.region.getWidth())
      m.assertTrue(Abs(oneOff.scale.x - 0.5) < 0.001)
    end function

    @it("leaves a region that fits unscaled")
    function _()
      m.assertEqual(1.0, m.pool.getRegion(50, 30).scale.x)
    end function

    @it("getBitmapObject returns the backing bitmap")
    function _()
      scratchRegion = m.pool.getRegion(20, 20)
      m.assertNotInvalid(scratchRegion.getBitmapObject())
    end function

    @describe("returnRegion / returnStagedRegions")

    @it("does not error when returning a region that was checked out")
    function _()
      scratchRegion = m.pool.getRegion(20, 20)
      m.pool.returnRegion(scratchRegion)
    end function

    @it("does not error on a nil region")
    function _()
      m.pool.returnRegion(invalid)
    end function

    @it("stageRegionsForReturn + returnStagedRegions does not error")
    function _()
      scratchRegion = m.pool.getRegion(20, 20)
      m.pool.stageRegionsForReturn([scratchRegion])
      m.pool.returnStagedRegions()
    end function

    @describe("reuse within a frame (#345)")

    @it("doesn't hand out a bitmap returned earlier in the same frame")
    function _()
      first = m.pool.getRegion(10, 10)
      m.pool.returnRegions([first])
      second = m.pool.getRegion(10, 10)
      m.assertNotEqual(first.scratchBmp.id, second.scratchBmp.id)
    end function

    @it("reuses a returned bitmap after onFrameEnd()")
    function _()
      first = m.pool.getRegion(10, 10)
      second = m.pool.getRegion(10, 10)
      m.pool.stageRegionsForReturn([first, second])
      m.assertEqual(2, m.pool.getUsedThisFrameCount())
      m.pool.onFrameEnd()
      m.assertEqual(0, m.pool.getUsedThisFrameCount())
      ids = {}
      ids[first.scratchBmp.id] = true
      ids[second.scratchBmp.id] = true
      m.assertTrue(ids.DoesExist(m.pool.getRegion(10, 10).scratchBmp.id))
    end function

    @it("hands out a one-off region once every pooled bitmap is used this frame")
    function _()
      for i = 1 to m.pool.getMaxPoolCount()
        m.pool.returnRegions([m.pool.getRegion(10, 10)])
      end for
      extra = m.pool.getRegion(10, 10)
      m.assertNotInvalid(extra)
      m.assertEqual("temp", extra.scratchBmp.id)
      m.pool.returnRegions([extra])
      m.assertEqual(m.pool.getMaxPoolCount(), m.pool.getUsedThisFrameCount())
    end function

    @describe("one-off bitmaps (#688)")

    @it("keeps a one-off bitmap until onFrameEnd() when pooling is off")
    function _()
      unpooled = new BGE.ScratchBitmapPool(false)
      scratchRegion = unpooled.getRegion(10, 10)
      m.assertEqual("temp", scratchRegion.scratchBmp.id)
      unpooled.returnRegion(scratchRegion)
      ' a device can still have draws from it queued
      m.assertEqual(1, unpooled.getHeldOneOffCount())
      unpooled.onFrameEnd()
      m.assertEqual(0, unpooled.getHeldOneOffCount())
    end function

    @it("keeps the one-off handed out once the pool is used up until onFrameEnd()")
    function _()
      for i = 1 to m.pool.getMaxPoolCount()
        m.pool.returnRegions([m.pool.getRegion(10, 10)])
      end for
      m.assertEqual(0, m.pool.getHeldOneOffCount())
      oneOff = m.pool.getRegion(10, 10)
      m.assertEqual("temp", oneOff.scratchBmp.id)
      m.assertEqual(1, m.pool.getHeldOneOffCount())
      m.pool.onFrameEnd()
      m.assertEqual(0, m.pool.getHeldOneOffCount())
      ' one-offs are freed, never added to the pool: the pool runs out at the same point
      for i = 1 to m.pool.getMaxPoolCount()
        m.pool.getRegion(10, 10)
      end for
      m.assertEqual(0, m.pool.getHeldOneOffCount())
      m.pool.getRegion(10, 10)
      m.assertEqual(1, m.pool.getHeldOneOffCount())
    end function

    @it("clearPool() lets go of held one-offs")
    function _()
      unpooled = new BGE.ScratchBitmapPool(false)
      unpooled.getRegion(10, 10)
      unpooled.clearPool()
      m.assertEqual(0, unpooled.getHeldOneOffCount())
    end function

    @describe("clearPool")

    @it("does not error, and the pool can still be used afterward")
    function _()
      m.pool.clearPool()
      scratchRegion = m.pool.getRegion(10, 10)
      m.assertNotInvalid(scratchRegion)
    end function

    @describe("toStr")

    @it("returns a human-readable summary")
    function _()
      m.assertTrue(m.pool.toStr().len() > 0)
    end function

    @describe("getNewMemoryScratchRegion (module-level, non-pooled fallback)")

    @it("returns invalid for non-positive dimensions")
    function _()
      m.assertInvalid(BGE.getNewMemoryScratchRegion(0, 10))
      m.assertInvalid(BGE.getNewMemoryScratchRegion(10, 0))
    end function

    @it("returns a valid region for positive dimensions")
    function _()
      region = BGE.getNewMemoryScratchRegion(15, 25)
      m.assertNotInvalid(region)
      m.assertNotInvalid(region.getBitmapObject())
    end function

  end class

end namespace
