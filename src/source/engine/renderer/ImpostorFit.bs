import "../../math/math.bs"

namespace BGE.ImpostorFit

  ' How well one 2D mapping takes a set of captured canvas points to where they are now -
  ' see specs/2026-10-22-model-impostors-design.md. `residual` is the farthest any point
  ' lands from where it really is, in pixels; invalid params mean the fit isn't usable.
  interface FitResult
    residual as float
    ' scale + translate: x' = scaleX * x + offsetX, y' = scaleY * y + offsetY
    ' rotate + scale: x' = rotate(scale(x - centre)) + centre', rotation in radians
    ' affine: x' = a * x + b * y + c, y' = d * x + e * y + f
    params as roAssociativeArray
  end interface

  ' Fits x' = sx * x + tx and y' = sy * y + ty by least squares - what a single
  ' DrawScaledObject can draw. A mirrored or collapsed axis isn't usable.
  '
  ' @param {float[]} fromX captured x of each point
  ' @param {float[]} fromY captured y of each point
  ' @param {float[]} toX current x of each point
  ' @param {float[]} toY current y of each point
  ' @return {BGE.ImpostorFit.FitResult}
  function fitScaleTranslate(fromX as float[], fromY as float[], toX as float[], toY as float[]) as FitResult
    xAxis = fitAxis(fromX, toX)
    yAxis = fitAxis(fromY, toY)
    if invalid = xAxis or invalid = yAxis
      return unusable()
    end if
    residual = 0.0
    for i = 0 to fromX.count() - 1
      dx = xAxis.scale * fromX[i] + xAxis.offset - toX[i]
      dy = yAxis.scale * fromY[i] + yAxis.offset - toY[i]
      residual = BGE.Math.Max(residual, Sqr(dx * dx + dy * dy))
    end for
    return {residual: residual, params: {scaleX: xAxis.scale, scaleY: yAxis.scale, offsetX: xAxis.offset, offsetY: yAxis.offset}}
  end function

  ' Fits a rotation about the points' centre, then a scale along each rotated axis - what a
  ' single DrawTransformedObject can draw. The rotation comes from the best similarity fit,
  ' then each axis's scale by least squares, so it isn't the joint optimum but is close for
  ' the small rotations an impostor sees.
  '
  ' @param {float[]} fromX
  ' @param {float[]} fromY
  ' @param {float[]} toX
  ' @param {float[]} toY
  ' @return {BGE.ImpostorFit.FitResult}
  function fitRotateScale(fromX as float[], fromY as float[], toX as float[], toY as float[]) as FitResult
    n = fromX.count()
    if n < 2
      return unusable()
    end if
    fromCx = mean(fromX)
    fromCy = mean(fromY)
    toCx = mean(toX)
    toCy = mean(toY)
    cross = 0.0
    dot = 0.0
    for i = 0 to n - 1
      px = fromX[i] - fromCx
      py = fromY[i] - fromCy
      qx = toX[i] - toCx
      qy = toY[i] - toCy
      cross += px * qy - py * qx
      dot += px * qx + py * qy
    end for
    angle = BGE.Math.Atan2(cross, dot)
    c = Cos(angle)
    s = Sin(angle)
    ' undo the rotation on the current points, then fit a scale per captured axis
    sumPxQx = 0.0
    sumPxPx = 0.0
    sumPyQy = 0.0
    sumPyPy = 0.0
    for i = 0 to n - 1
      px = fromX[i] - fromCx
      py = fromY[i] - fromCy
      qx = toX[i] - toCx
      qy = toY[i] - toCy
      ux = c * qx + s * qy
      uy = -s * qx + c * qy
      sumPxQx += px * ux
      sumPxPx += px * px
      sumPyQy += py * uy
      sumPyPy += py * py
    end for
    if sumPxPx = 0 or sumPyPy = 0
      return unusable()
    end if
    scaleX = sumPxQx / sumPxPx
    scaleY = sumPyQy / sumPyPy
    if scaleX <= 0 or scaleY <= 0
      return unusable()
    end if
    residual = 0.0
    for i = 0 to n - 1
      sx = (fromX[i] - fromCx) * scaleX
      sy = (fromY[i] - fromCy) * scaleY
      dx = c * sx - s * sy + toCx - toX[i]
      dy = s * sx + c * sy + toCy - toY[i]
      residual = BGE.Math.Max(residual, Sqr(dx * dx + dy * dy))
    end for
    return {residual: residual, params: {rotation: angle, scaleX: scaleX, scaleY: scaleY, fromCentreX: fromCx, fromCentreY: fromCy, toCentreX: toCx, toCentreY: toCy}}
  end function

  ' Fits a general affine map by least squares - what a corner pin of the captured bitmap
  ' would draw, since a pin warps a parallelogram exactly.
  '
  ' @param {float[]} fromX
  ' @param {float[]} fromY
  ' @param {float[]} toX
  ' @param {float[]} toY
  ' @return {BGE.ImpostorFit.FitResult}
  function fitAffine(fromX as float[], fromY as float[], toX as float[], toY as float[]) as FitResult
    n = fromX.count()
    if n < 3
      return unusable()
    end if
    ' centred, so the normal equations stay well conditioned at canvas-sized coordinates
    fromCx = mean(fromX)
    fromCy = mean(fromY)
    toCx = mean(toX)
    toCy = mean(toY)
    sxx = 0.0
    sxy = 0.0
    syy = 0.0
    sxu = 0.0
    syu = 0.0
    sxv = 0.0
    syv = 0.0
    for i = 0 to n - 1
      px = fromX[i] - fromCx
      py = fromY[i] - fromCy
      u = toX[i] - toCx
      v = toY[i] - toCy
      sxx += px * px
      sxy += px * py
      syy += py * py
      sxu += px * u
      syu += py * u
      sxv += px * v
      syv += py * v
    end for
    det = sxx * syy - sxy * sxy
    if Abs(det) < 0.000001
      return unusable()
    end if
    a = (sxu * syy - syu * sxy) / det
    b = (syu * sxx - sxu * sxy) / det
    d = (sxv * syy - syv * sxy) / det
    e = (syv * sxx - sxv * sxy) / det
    ' a mirrored or collapsed map can't be drawn as a corner pin of the captured bitmap
    if a * e - b * d <= 0
      return unusable()
    end if
    residual = 0.0
    for i = 0 to n - 1
      px = fromX[i] - fromCx
      py = fromY[i] - fromCy
      dx = a * px + b * py + toCx - toX[i]
      dy = d * px + e * py + toCy - toY[i]
      residual = BGE.Math.Max(residual, Sqr(dx * dx + dy * dy))
    end for
    c = toCx - a * fromCx - b * fromCy
    f = toCy - d * fromCx - e * fromCy
    return {residual: residual, params: {a: a, b: b, c: c, d: d, e: e, f: f}}
  end function

  ' fitScaleTranslate()'s params as fitRotateScale() would give them, with no rotation, so
  ' mapRotateScale() and the same blit can use either.
  '
  ' @param {roAssociativeArray} params a fitScaleTranslate() result's params
  ' @return {roAssociativeArray}
  function scaleTranslateAsRotateScale(params as roAssociativeArray) as roAssociativeArray
    return {rotation: 0.0, scaleX: params.scaleX, scaleY: params.scaleY, fromCentreX: 0.0, fromCentreY: 0.0, toCentreX: params.offsetX, toCentreY: params.offsetY}
  end function

  ' Where fitRotateScale()'s params take the point (x, y).
  '
  ' @param {roAssociativeArray} params a fitRotateScale() result's params
  ' @param {float} x
  ' @param {float} y
  ' @return {BGE.Math.Vector}
  function mapRotateScale(params as roAssociativeArray, x as float, y as float) as BGE.Math.Vector
    c = Cos(params.rotation)
    s = Sin(params.rotation)
    sx = (x - params.fromCentreX) * params.scaleX
    sy = (y - params.fromCentreY) * params.scaleY
    return BGE.Math.VectorOps.create(c * sx - s * sy + params.toCentreX, s * sx + c * sy + params.toCentreY)
  end function

  ' Builds a column warp - the captured bitmap redrawn as vertical strips (#556) - from
  ' vertical edges of the model: capture x maps to current x, and each column is scaled and
  ' shifted vertically, all linear in capture x between the edges. Exact for vertical walls
  ' when the camera only turns and moves. Params: knotX (capture x, increasing), x (current
  ' x), offset and scale (current y = offset + scale * capture y) at each knot. The residual
  ' is 0; measure one with columnsResidual(). A projective warp interpolates between knots
  ' with perspective (see makeColumnsProjective()), exact for flat walls between edges.
  '
  ' @param {float[]} fromX each edge's top then bottom captured x, edge after edge
  ' @param {float[]} fromY
  ' @param {float[]} toX the same points' current x
  ' @param {float[]} toY
  ' @param {boolean} projective
  ' @return {BGE.ImpostorFit.FitResult}
  function fitColumnsToEdges(fromX as float[], fromY as float[], toX as float[], toY as float[], projective = false as boolean) as FitResult
    knots = [] as roAssociativeArray[]
    for i = 0 to fromX.count() - 2 step 2
      height = fromY[i + 1] - fromY[i]
      if height = 0
        return unusable()
      end if
      scale = (toY[i + 1] - toY[i]) / height
      knots.push({
        knotX: (fromX[i] + fromX[i + 1]) * 0.5,
        x: (toX[i] + toX[i + 1]) * 0.5,
        offset: toY[i] - scale * fromY[i],
        scale: scale
      })
    end for
    ' insertion sort by capture x - only a handful of edges
    sorted = [] as roAssociativeArray[]
    for each knot in knots
      at = sorted.count()
      while at > 0 and sorted[at - 1].knotX > knot.knotX
        at--
      end while
      sorted.push(knot)
      for j = sorted.count() - 1 to at + 1 step -1
        sorted[j] = sorted[j - 1]
      end for
      sorted[at] = knot
    end for
    params = {knotX: [] as float[], x: [] as float[], offset: [] as float[], scale: [] as float[], projective: false}
    for each knot in sorted
      params.knotX.push(knot.knotX)
      params.x.push(knot.x)
      params.offset.push(knot.offset)
      params.scale.push(knot.scale)
    end for
    if not columnsUsable(params)
      return unusable()
    end if
    if projective
      makeColumnsProjective(params)
    end if
    return {residual: 0.0, params: params}
  end function

  ' Makes a column warp interpolate with perspective between knots. With the camera only
  ' turning and moving, a column's vertical scale is its depth then over its depth now, so
  ' along a flat wall 1 / scale and offset / scale are linear in capture x, and current x
  ' moves by weights of 1 / scale - no depths needed. Adds q (1 / scale) and g (offset / scale).
  '
  ' @param {roAssociativeArray} params a column warp's params, every scale above 0
  sub makeColumnsProjective(params as roAssociativeArray)
    q = [] as float[]
    g = [] as float[]
    for j = 0 to params.knotX.count() - 1
      q.push(1 / params.scale[j])
      g.push(params.offset[j] / params.scale[j])
    end for
    params.q = q
    params.g = g
    params.projective = true
  end sub

  ' Knots for fitColumns() at quantiles of the points' distinct x (to the half pixel), so each
  ' segment has points to fit, and no more than the points support: two per knot.
  '
  ' @param {float[]} xs the points' x
  ' @param {integer} count knots wanted
  ' @return {float[]} increasing; fewer than 2 if the points can't support a warp
  function placeKnots(xs as float[], count as integer) as float[]
    sorted = [] as float[]
    for each x in xs
      sorted.push(Int(x * 2 + 0.5) / 2)
    end for
    sorted.Sort()
    distinct = [] as float[]
    for each x in sorted
      if distinct.count() = 0 or x > distinct[distinct.count() - 1]
        distinct.push(x)
      end if
    end for
    count = BGE.Math.Min(count, BGE.Math.Min(xs.count() \ 2, distinct.count()))
    knotX = [] as float[]
    if count < 2
      return knotX
    end if
    last = distinct.count() - 1
    for k = 0 to count - 1
      x = distinct[Int(k * last / (count - 1) + 0.5)]
      if knotX.count() = 0 or x > knotX[knotX.count() - 1]
        knotX.push(x)
      end if
    end for
    return knotX
  end function

  ' Fits a column warp (see fitColumnsToEdges()) with the given knots by least squares. A
  ' projective warp fits the vertical map backwards (capture y from current y is linear in
  ' its unknowns), then x with perspective weights.
  '
  ' @param {float[]} knotX capture x of each knot, increasing
  ' @param {float[]} fromX
  ' @param {float[]} fromY
  ' @param {float[]} toX
  ' @param {float[]} toY
  ' @param {boolean} projective
  ' @return {BGE.ImpostorFit.FitResult}
  function fitColumns(knotX as float[], fromX as float[], fromY as float[], toX as float[], toY as float[], projective = false as boolean) as FitResult
    k = knotX.count()
    n = fromX.count()
    if k < 2 or n < 2 * k
      return unusable()
    end if
    ' linear: current y = offset + scale * capture y at the hat weights; projective: capture y =
    ' q * current y - g. Either way 2k unknowns, with the known y centred for conditioning.
    knownY = fromY
    solvedY = toY
    if projective
      knownY = toY
      solvedY = fromY
    end if
    yMean = mean(knownY)
    yNormal = zeros(4 * k * k)
    yRhs = zeros(2 * k)
    ' unrolled: four terms for y (offset and scale at each end)
    last = k - 2
    k2 = 2 * k
    for i = 0 to n - 1
      x = fromX[i]
      s = 0
      while s < last and x >= knotX[s + 1]
        s++
      end while
      t = (x - knotX[s]) / (knotX[s + 1] - knotX[s])
      w0 = 1 - t
      y = knownY[i] - yMean
      v = solvedY[i]
      q2 = w0 * y
      q3 = t * y
      i0 = s
      i1 = s + 1
      i2 = k + s
      i3 = k + s + 1
      yRhs[i0] += w0 * v
      yRhs[i1] += t * v
      yRhs[i2] += q2 * v
      yRhs[i3] += q3 * v
      r0 = i0 * k2
      r1 = i1 * k2
      r2 = i2 * k2
      r3 = i3 * k2
      yNormal[r0 + i0] += w0 * w0
      yNormal[r0 + i1] += w0 * t
      yNormal[r0 + i2] += w0 * q2
      yNormal[r0 + i3] += w0 * q3
      yNormal[r1 + i0] += t * w0
      yNormal[r1 + i1] += t * t
      yNormal[r1 + i2] += t * q2
      yNormal[r1 + i3] += t * q3
      yNormal[r2 + i0] += q2 * w0
      yNormal[r2 + i1] += q2 * t
      yNormal[r2 + i2] += q2 * q2
      yNormal[r2 + i3] += q2 * q3
      yNormal[r3 + i0] += q3 * w0
      yNormal[r3 + i1] += q3 * t
      yNormal[r3 + i2] += q3 * q2
      yNormal[r3 + i3] += q3 * q3
    end for
    ys = solveLinear(yNormal, yRhs, 2 * k)
    if ys.count() = 0
      return unusable()
    end if
    params = {knotX: knotX, x: [] as float[], offset: [] as float[], scale: [] as float[], projective: false}
    q = [] as float[]
    g = [] as float[]
    for j = 0 to k - 1
      slope = ys[k + j]
      intercept = ys[j] - slope * yMean
      if projective
        if slope <= 0
          return unusable()
        end if
        q.push(slope)
        g.push(-intercept)
        params.scale.push(1 / slope)
        params.offset.push(-intercept / slope)
      else
        params.scale.push(slope)
        params.offset.push(intercept)
      end if
    end for
    ' x from k weights: the hat weights, or with perspective the hat weights times q, normalised
    xNormal = zeros(k * k)
    xRhs = zeros(k)
    for i = 0 to n - 1
      x = fromX[i]
      s = 0
      while s < last and x >= knotX[s + 1]
        s++
      end while
      t = (x - knotX[s]) / (knotX[s + 1] - knotX[s])
      w0 = 1 - t
      w1 = t
      if projective
        w0 = w0 * q[s]
        w1 = w1 * q[s + 1]
        d = w0 + w1
        w0 = w0 / d
        w1 = w1 / d
      end if
      u = toX[i]
      xRhs[s] += w0 * u
      xRhs[s + 1] += w1 * u
      xNormal[s * k + s] += w0 * w0
      xNormal[s * k + s + 1] += w0 * w1
      xNormal[(s + 1) * k + s] += w0 * w1
      xNormal[(s + 1) * k + s + 1] += w1 * w1
    end for
    xs = solveLinear(xNormal, xRhs, k)
    if xs.count() = 0
      return unusable()
    end if
    params.x = xs
    if projective
      params.q = q
      params.g = g
      params.projective = true
    end if
    if not columnsUsable(params)
      return unusable()
    end if
    return {residual: columnsResidual(params, fromX, fromY, toX, toY), params: params}
  end function

  ' Where a column warp's params take the point (x, y). Past the first or last knot, the
  ' nearest segment carries on.
  '
  ' @param {roAssociativeArray} params a column warp's params
  ' @param {float} x
  ' @param {float} y
  ' @return {BGE.Math.Vector}
  function mapColumns(params as roAssociativeArray, x as float, y as float) as BGE.Math.Vector
    knotX = params.knotX
    segment = columnSegment(knotX, x)
    t = (x - knotX[segment]) / (knotX[segment + 1] - knotX[segment])
    if params.projective = true
      w0 = (1 - t) * params.q[segment]
      w1 = t * params.q[segment + 1]
      d = projectiveDenominator(w0 + w1, params.q[segment], params.q[segment + 1])
      mappedX = (w0 * params.x[segment] + w1 * params.x[segment + 1]) / d
      g = params.g[segment] + t * (params.g[segment + 1] - params.g[segment])
      return BGE.Math.VectorOps.create(mappedX, (g + y) / d)
    end if
    mappedX = params.x[segment] + t * (params.x[segment + 1] - params.x[segment])
    offset = params.offset[segment] + t * (params.offset[segment + 1] - params.offset[segment])
    scale = params.scale[segment] + t * (params.scale[segment + 1] - params.scale[segment])
    return BGE.Math.VectorOps.create(mappedX, offset + scale * y)
  end function

  ' The farthest a column warp puts any point from where it is now, in pixels.
  '
  ' @param {roAssociativeArray} params
  ' @param {float[]} fromX
  ' @param {float[]} fromY
  ' @param {float[]} toX
  ' @param {float[]} toY
  ' @return {float}
  function columnsResidual(params as roAssociativeArray, fromX as float[], fromY as float[], toX as float[], toY as float[]) as float
    ' mapColumns(), inlined - this runs over every visible vertex each frame
    knotX = params.knotX
    knotMapX = params.x
    offsets = params.offset
    scales = params.scale
    last = knotX.count() - 2
    worst = 0.0
    if params.projective = true
      qs = params.q
      gs = params.g
      for i = 0 to fromX.count() - 1
        x = fromX[i]
        s = 0
        while s < last and x >= knotX[s + 1]
          s++
        end while
        t = (x - knotX[s]) / (knotX[s + 1] - knotX[s])
        w0 = (1 - t) * qs[s]
        w1 = t * qs[s + 1]
        d = w0 + w1
        if d <= 0
          return 1000000.0
        end if
        dx = (w0 * knotMapX[s] + w1 * knotMapX[s + 1]) / d - toX[i]
        dy = (gs[s] + t * (gs[s + 1] - gs[s]) + fromY[i]) / d - toY[i]
        squared = dx * dx + dy * dy
        if squared > worst
          worst = squared
        end if
      end for
      return Sqr(worst)
    end if
    for i = 0 to fromX.count() - 1
      x = fromX[i]
      s = 0
      while s < last and x >= knotX[s + 1]
        s++
      end while
      t = (x - knotX[s]) / (knotX[s + 1] - knotX[s])
      dx = knotMapX[s] + t * (knotMapX[s + 1] - knotMapX[s]) - toX[i]
      dy = offsets[s] + t * (offsets[s + 1] - offsets[s]) + (scales[s] + t * (scales[s + 1] - scales[s])) * fromY[i] - toY[i]
      squared = dx * dx + dy * dy
      if squared > worst
        worst = squared
      end if
    end for
    return Sqr(worst)
  end function

  ' A camera's view as a flat array, for projectToBasis() and mapBetweenBases(): its right,
  ' up and back axes, the eye, the focal length in pixels and the canvas centre. Projects as
  ' Camera3d does, without the rounding to whole pixels.
  '
  ' @param {BGE.Math.Vector} rightAxis
  ' @param {BGE.Math.Vector} upAxis
  ' @param {BGE.Math.Vector} backAxis the camera looks down -backAxis
  ' @param {BGE.Math.Vector} eye
  ' @param {float} focal
  ' @param {float} centreX
  ' @param {float} centreY
  ' @return {float[]}
  function cameraBasis(rightAxis as BGE.Math.Vector, upAxis as BGE.Math.Vector, backAxis as BGE.Math.Vector, eye as BGE.Math.Vector, focal as float, centreX as float, centreY as float) as float[]
    return [rightAxis.x, rightAxis.y, rightAxis.z ?? 0.0, upAxis.x, upAxis.y, upAxis.z ?? 0.0, backAxis.x, backAxis.y, backAxis.z ?? 0.0, eye.x, eye.y, eye.z ?? 0.0, focal, centreX, centreY]
  end function

  ' cameraBasis() for a camera's world-to-camera matrix (a rigid transform, as Camera3d's).
  '
  ' @param {float[][]} worldToCamera
  ' @param {BGE.Math.Vector} eye
  ' @param {float} focal
  ' @param {float} frameWidth
  ' @param {float} frameHeight
  ' @param {float} [shiftY=0] how far down the image is moved (Camera3d.getPitchShiftY())
  ' @return {float[]}
  function basisFromView(worldToCamera as float[][], eye as BGE.Math.Vector, focal as float, frameWidth as float, frameHeight as float, shiftY = 0.0 as float) as float[]
    w = worldToCamera
    rightAxis = BGE.Math.VectorOps.create(w[0][0], w[1][0], w[2][0])
    upAxis = BGE.Math.VectorOps.create(w[0][1], w[1][1], w[2][1])
    backAxis = BGE.Math.VectorOps.create(w[0][2], w[1][2], w[2][2])
    return cameraBasis(rightAxis, upAxis, backAxis, eye, focal, frameWidth * 0.5, frameHeight * 0.5 + shiftY)
  end function

  ' The same camera turned level: the same eye and heading, with no pitch or roll (world up
  ' is +y). World verticals project as vertical lines in it, which the column warp needs.
  '
  ' @param {float[]} basis from cameraBasis()
  ' @return {float[]} empty when the camera looks almost straight up or down
  function levelBasis(basis as float[]) as float[]
    ' heading: the view direction (-back) flattened
    fx = -basis[6]
    fz = -basis[8]
    length = Sqr(fx * fx + fz * fz)
    if length < 0.05
      return [] as float[]
    end if
    fx = fx / length
    fz = fz / length
    ' right is horizontal, on the same side as the camera's own
    rx = -fz
    rz = fx
    if rx * basis[0] + rz * basis[2] < 0
      rx = -rx
      rz = -rz
    end if
    return [rx, 0.0, rz, 0.0, 1.0, 0.0, -fx, 0.0, -fz, basis[9], basis[10], basis[11], basis[12], basis[13], basis[14]]
  end function

  ' Projects world points through a cameraBasis().
  '
  ' @param {float[]} basis
  ' @param {BGE.Math.Vector[]} points
  ' @param {float[]} outX cleared, then each point's canvas x
  ' @param {float[]} outY
  ' @return {boolean} false as soon as a point isn't in front of the camera
  function projectToBasis(basis as float[], points as BGE.Math.Vector[], outX as float[], outY as float[]) as boolean
    outX.Clear()
    outY.Clear()
    rx = basis[0]
    ry = basis[1]
    rz = basis[2]
    ux = basis[3]
    uy = basis[4]
    uz = basis[5]
    bx = basis[6]
    by = basis[7]
    bz = basis[8]
    focal = basis[12]
    for each point in points
      dx = point.x - basis[9]
      dy = point.y - basis[10]
      dz = (point.z ?? 0.0) - basis[11]
      depth = -(dx * bx + dy * by + dz * bz)
      if depth <= 0.001
        return false
      end if
      outX.push(basis[13] + focal * (dx * rx + dy * ry + dz * rz) / depth)
      outY.push(basis[14] - focal * (dx * ux + dy * uy + dz * uz) / depth)
    end for
    return true
  end function

  ' Where the canvas point (x, y) of one camera lands in another at the same eye (the view
  ' turned): its ray, projected again. Writes x, y to out[0], out[1].
  '
  ' @param {float[]} fromBasis
  ' @param {float[]} toBasis
  ' @param {float} x
  ' @param {float} y
  ' @param {float[]} out
  ' @return {boolean} false if the ray isn't in front of the other camera
  function mapBetweenBases(fromBasis as float[], toBasis as float[], x as float, y as float, out as float[]) as boolean
    a = (x - fromBasis[13]) / fromBasis[12]
    b = (fromBasis[14] - y) / fromBasis[12]
    dx = fromBasis[0] * a + fromBasis[3] * b - fromBasis[6]
    dy = fromBasis[1] * a + fromBasis[4] * b - fromBasis[7]
    dz = fromBasis[2] * a + fromBasis[5] * b - fromBasis[8]
    depth = -(dx * toBasis[6] + dy * toBasis[7] + dz * toBasis[8])
    if depth <= 0.000001
      return false
    end if
    out[0] = toBasis[13] + toBasis[12] * (dx * toBasis[0] + dy * toBasis[1] + dz * toBasis[2]) / depth
    out[1] = toBasis[14] - toBasis[12] * (dx * toBasis[3] + dy * toBasis[4] + dz * toBasis[5]) / depth
    return true
  end function

  ' The canvas-to-canvas map between two views from the same eye (a turn), as a homography:
  ' [a, b, c, d, e, f, g, h, i], where (x, y) goes to ((ax + by + c) / w, (dx + ey + f) / w)
  ' with w = gx + hy + i, in front of the second view while w > 0. Lets the hot loops map
  ' points without calls (see mapPointsByHomography()).
  '
  ' @param {float[]} fromBasis
  ' @param {float[]} toBasis
  ' @return {float[]}
  function homographyBetween(fromBasis as float[], toBasis as float[]) as float[]
    ' the ray of (x, y) is rA * u + uA * v - bA, with u = (x - cx) / f and v = (cy - y) / f
    inverseFocal = 1 / fromBasis[12]
    ux = inverseFocal
    u0 = -fromBasis[13] * inverseFocal
    vy = -inverseFocal
    v0 = fromBasis[14] * inverseFocal
    h = [] as float[]
    ' X, Y and depth along the second view's right, up and forward axes, each affine in x, y
    coefficients = [] as float[]
    for axis = 0 to 2
      o = axis * 3
      sign = 1.0
      if axis = 2
        sign = -1.0
      end if
      ru = sign * (fromBasis[0] * toBasis[o] + fromBasis[1] * toBasis[o + 1] + fromBasis[2] * toBasis[o + 2])
      uu = sign * (fromBasis[3] * toBasis[o] + fromBasis[4] * toBasis[o + 1] + fromBasis[5] * toBasis[o + 2])
      bu = -sign * (fromBasis[6] * toBasis[o] + fromBasis[7] * toBasis[o + 1] + fromBasis[8] * toBasis[o + 2])
      coefficients.append([ru * ux, uu * vy, ru * u0 + uu * v0 + bu])
    end for
    focal = toBasis[12]
    cx = toBasis[13]
    cy = toBasis[14]
    for k = 0 to 2
      ' x' = cx + focal * X / depth, y' = cy - focal * Y / depth
      h.push(cx * coefficients[6 + k] + focal * coefficients[k])
    end for
    for k = 0 to 2
      h.push(cy * coefficients[6 + k] - focal * coefficients[3 + k])
    end for
    for k = 0 to 2
      h.push(coefficients[6 + k])
    end for
    return h
  end function

  ' homographyBetween() for a capture's camera to its level view, and for the current level
  ' view to the current camera: what the strip maps below take.
  '
  ' @param {float[][]} bases capture camera, capture level, current level, current camera
  ' @return {float[][]}
  function warpHomographies(bases as float[][]) as float[][]
    return [homographyBetween(bases[0], bases[1]), homographyBetween(bases[2], bases[3])] as float[][]
  end function

  ' Maps points through a homographyBetween().
  '
  ' @param {float[]} h
  ' @param {float[]} xs
  ' @param {float[]} ys
  ' @param {float[]} outX cleared, then filled
  ' @param {float[]} outY
  ' @return {boolean} false as soon as a point isn't in front of the second view
  function mapPointsByHomography(h as float[], xs as float[], ys as float[], outX as float[], outY as float[]) as boolean
    outX.Clear()
    outY.Clear()
    for i = 0 to xs.count() - 1
      x = xs[i]
      y = ys[i]
      w = h[6] * x + h[7] * y + h[8]
      if w <= 0.000001
        return false
      end if
      outX.push((h[0] * x + h[1] * y + h[2]) / w)
      outY.push((h[3] * x + h[4] * y + h[5]) / w)
    end for
    return true
  end function

  ' Where a capture's canvas points are drawn now: into the level view at capture, through the
  ' column warp, then out of the level view now into the camera now. Inlined: it runs for every
  ' cut, bound and sample point of every strip frame.
  '
  ' @param {roAssociativeArray} params a column warp fitted between the two level views
  ' @param {float[][]} homographies from warpHomographies()
  ' @param {float[]} xs capture canvas x
  ' @param {float[]} ys
  ' @param {float[]} outX cleared, then filled
  ' @param {float[]} outY
  ' @return {boolean} false as soon as a point won't map
  function mapPointsCaptureToNow(params as roAssociativeArray, homographies as float[][], xs as float[], ys as float[], outX as float[], outY as float[]) as boolean
    outX.Clear()
    outY.Clear()
    a = homographies[0]
    b = homographies[1]
    knotX = params.knotX
    knotMapX = params.x
    last = knotX.count() - 2
    projective = params.projective = true
    qs = params.q
    gs = params.g
    offsets = params.offset
    scales = params.scale
    for i = 0 to xs.count() - 1
      x = xs[i]
      y = ys[i]
      w = a[6] * x + a[7] * y + a[8]
      if w <= 0.000001
        return false
      end if
      lx = (a[0] * x + a[1] * y + a[2]) / w
      ly = (a[3] * x + a[4] * y + a[5]) / w
      s = 0
      while s < last and lx >= knotX[s + 1]
        s++
      end while
      t = (lx - knotX[s]) / (knotX[s + 1] - knotX[s])
      if projective
        w0 = (1 - t) * qs[s]
        w1 = t * qs[s + 1]
        d = projectiveDenominator(w0 + w1, qs[s], qs[s + 1])
        wx = (w0 * knotMapX[s] + w1 * knotMapX[s + 1]) / d
        wy = (gs[s] + t * (gs[s + 1] - gs[s]) + ly) / d
      else
        wx = knotMapX[s] + t * (knotMapX[s + 1] - knotMapX[s])
        wy = offsets[s] + t * (offsets[s + 1] - offsets[s]) + (scales[s] + t * (scales[s + 1] - scales[s])) * ly
      end if
      w = b[6] * wx + b[7] * wy + b[8]
      if w <= 0.000001
        return false
      end if
      outX.push((b[0] * wx + b[1] * wy + b[2]) / w)
      outY.push((b[3] * wx + b[4] * wy + b[5]) / w)
    end for
    return true
  end function

  ' mapPointsCaptureToNow() for one point, writing x, y to out[0], out[1].
  function mapCaptureToNow(params as roAssociativeArray, homographies as float[][], x as float, y as float, out as float[]) as boolean
    outX = [] as float[]
    outY = [] as float[]
    if not mapPointsCaptureToNow(params, homographies, [x] as float[], [y] as float[], outX, outY)
      return false
    end if
    out[0] = outX[0]
    out[1] = outY[0]
    return true
  end function

  ' How to draw each strip between `cuts` (capture bitmap columns) now: [x, y, x scale, y
  ' scale, rotation] per strip, flat, for DrawTransformedObject about the strip's top left
  ' (rotation in radians, counterclockwise on screen). Each cut's top and bottom are mapped
  ' (mapPointsCaptureToNow()); a strip turns to follow the line through its middle, so
  ' verticals keep converging as they should under a pitched camera, and its top edge's
  ' middle lands where it maps. A strip that would flip or collapse gets 0 scales.
  '
  ' @param {roAssociativeArray} params
  ' @param {float[][]} homographies from warpHomographies()
  ' @param {float} originX the bitmap's left edge, in capture canvas x
  ' @param {integer[]} cuts
  ' @param {float} top the bitmap's top, in capture canvas y
  ' @param {float} height
  ' @return {float[]} empty if a corner won't map
  function stripTransforms(params as roAssociativeArray, homographies as float[][], originX as float, cuts as integer[], top as float, height as float) as float[]
    ' tops then bottoms
    xs = [] as float[]
    ys = [] as float[]
    count = cuts.count()
    bottom = top + height
    for each cut in cuts
      xs.push(originX + cut)
      ys.push(top)
    end for
    for each cut in cuts
      xs.push(originX + cut)
      ys.push(bottom)
    end for
    mx = [] as float[]
    my = [] as float[]
    if not mapPointsCaptureToNow(params, homographies, xs, ys, mx, my)
      return [] as float[]
    end if
    transforms = [] as float[]
    for i = 0 to count - 2
      j = count + i
      ' the line through the strip's middle sets its turn and height
      vx = (mx[j] + mx[j + 1] - mx[i] - mx[i + 1]) * 0.5
      vy = (my[j] + my[j + 1] - my[i] - my[i + 1]) * 0.5
      tall = Sqr(vx * vx + vy * vy)
      ' a strip pointing up is refused below, so Atn() covers every angle that's drawn
      theta = 0.0
      if vy > 0
        theta = Atn(vx / vy)
      end if
      ' width along the strip's turned x axis, (cos, -sin), averaged over its top and bottom
      c = Cos(theta)
      s = Sin(theta)
      across = ((mx[i + 1] - mx[i] + mx[j + 1] - mx[j]) * c - (my[i + 1] - my[i] + my[j + 1] - my[j]) * s) * 0.5
      scaleX = across / (cuts[i + 1] - cuts[i])
      scaleY = tall / height
      if vy <= 0 or scaleX <= 0 or scaleY <= 0
        scaleX = 0
        scaleY = 0
      end if
      ' placed by its top edge's middle, so its corners are off by at most half its change
      ' across (as columnSegmentStrips() sizes it), not all of it
      half = across * 0.5
      transforms.append([(mx[i] + mx[i + 1]) * 0.5 - half * c, (my[i] + my[i + 1]) * 0.5 + half * s, scaleX, scaleY, theta])
    end for
    return transforms
  end function

  ' Whether the strips keep a capture's clip rect over the whole frame, so the parts the
  ' capture left out stay off it: the rect's top and bottom at its sides and every cut, and
  ' its sides at the top, middle and bottom, mapped (mapPointsCaptureToNow()).
  '
  ' @param {roAssociativeArray} params
  ' @param {float[][]} homographies
  ' @param {float} x0 the clip rect, in capture canvas coordinates
  ' @param {float} y0
  ' @param {float} x1
  ' @param {float} y1
  ' @param {float[]} cutXs the cuts, in capture canvas x
  ' @param {float} frameWidth
  ' @param {float} frameHeight
  ' @return {boolean}
  function stripsCoverFrame(params as roAssociativeArray, homographies as float[][], x0 as float, y0 as float, x1 as float, y1 as float, cutXs as float[], frameWidth as float, frameHeight as float) as boolean
    ' the sides first: left at 3 heights, then right at 3
    xs = [x0, x0, x0, x1, x1, x1] as float[]
    ys = [y0, (y0 + y1) * 0.5, y1, y0, (y0 + y1) * 0.5, y1] as float[]
    columns = [x0, x1] as float[]
    for each x in cutXs
      if x > x0 and x < x1
        columns.push(x)
      end if
    end for
    for each x in columns
      xs.push(x)
      ys.push(y0)
      xs.push(x)
      ys.push(y1)
    end for
    mx = [] as float[]
    my = [] as float[]
    if not mapPointsCaptureToNow(params, homographies, xs, ys, mx, my)
      return false
    end if
    for i = 0 to 2
      if mx[i] > 0 or mx[i + 3] < frameWidth
        return false
      end if
    end for
    for i = 6 to mx.count() - 2 step 2
      if my[i] > 0 or my[i + 1] < frameHeight
        return false
      end if
    end for
    return true
  end function

  ' Where to cut a column warp's capture x (in its level view) into strips, from leftX to
  ' rightX: each knot segment split as columnSegmentStrips() says, and the parts past the outer
  ' knots a strip each. A projective warp's cuts are spaced evenly in current x, where a flat
  ' wall's top and bottom are straight lines, so every strip changes about as much.
  '
  ' @param {roAssociativeArray} params
  ' @param {float} leftX
  ' @param {float} rightX
  ' @param {float} top the bitmap's top, in level capture y
  ' @param {float} bottom
  ' @param {float} maxStep
  ' @return {float[]} increasing, leftX first and rightX last
  function levelStripCuts(params as roAssociativeArray, leftX as float, rightX as float, top as float, bottom as float, maxStep as float) as float[]
    knotX = params.knotX
    cuts = [leftX] as float[]
    projective = params.projective = true
    for j = 0 to knotX.count() - 2
      strips = columnSegmentStrips(params, j, top, bottom, maxStep)
      x0 = params.x[j]
      x1 = params.x[j + 1]
      for k = 0 to strips
        t = k / strips
        if projective and k > 0 and k < strips
          ' invert the perspective map at current x evenly between the knots'
          current = x0 + (x1 - x0) * t
          q0 = params.q[j]
          q1 = params.q[j + 1]
          denominator = q0 * (current - x0) - q1 * (current - x1)
          if denominator <> 0
            t = q0 * (current - x0) / denominator
          end if
        end if
        cut = knotX[j] + (knotX[j + 1] - knotX[j]) * t
        if cut > cuts[cuts.count() - 1] + 0.5 and cut < rightX - 0.5
          cuts.push(cut)
        end if
      end for
    end for
    cuts.push(rightX)
    return cuts
  end function

  ' Moves the inner knot nearest x onto it - the crease between two walls, where the warp
  ' changes from one wall to the next - if the knots stay in order more than a pixel apart.
  '
  ' @param {float[]} knotX increasing, changed in place
  ' @param {float} x
  sub snapKnotTo(knotX as float[], x as float)
    if knotX.count() < 3
      return
    end if
    best = 1
    for j = 2 to knotX.count() - 2
      if Abs(knotX[j] - x) < Abs(knotX[best] - x)
        best = j
      end if
    end for
    if x > knotX[best - 1] + 1 and x < knotX[best + 1] - 1
      knotX[best] = x
    end if
  end sub

  ' Which of the points to keep, at most maxPoints of them: the leftmost, rightmost, top and
  ' bottom ones, so knots and errors still reach the model's outline, then an even spread.
  '
  ' @param {float[]} xs
  ' @param {float[]} ys
  ' @param {integer} maxPoints below 4 keeps every point
  ' @return {integer[]} indices
  function subsetWithExtremes(xs as float[], ys as float[], maxPoints as integer) as integer[]
    n = xs.count()
    kept = [] as integer[]
    if n <= maxPoints or maxPoints < 4
      for i = 0 to n - 1
        kept.push(i)
      end for
      return kept
    end if
    extremes = [0, 0, 0, 0] as integer[]
    for i = 1 to n - 1
      if xs[i] < xs[extremes[0]]
        extremes[0] = i
      end if
      if xs[i] > xs[extremes[1]]
        extremes[1] = i
      end if
      if ys[i] < ys[extremes[2]]
        extremes[2] = i
      end if
      if ys[i] > ys[extremes[3]]
        extremes[3] = i
      end if
    end for
    taken = [] as boolean[]
    for i = 0 to n - 1
      taken.push(false)
    end for
    for each i in extremes
      if not taken[i]
        taken[i] = true
        kept.push(i)
      end if
    end for
    stride = n / maxPoints
    k = 0
    while kept.count() < maxPoints and k < maxPoints
      i = Int(k * stride)
      if not taken[i]
        taken[i] = true
        kept.push(i)
      end if
      k++
    end while
    return kept
  end function

  ' A projective warp's denominator, kept positive past the outer knots, where it can reach
  ' 0 before the bitmap's edge.
  function projectiveDenominator(d as float, q0 as float, q1 as float) as float
    floor = 0.25 * BGE.Math.Min(q0, q1)
    if d < floor
      return floor
    end if
    return d
  end function

  ' How many vertical strips knot segment j needs so that no column lands more than maxStep
  ' pixels from the warp, given the captured bitmap's top and bottom y. Each strip is one
  ' scaled blit with a single vertical scale and offset, taken at its middle.
  function columnSegmentStrips(params as roAssociativeArray, j as integer, top as float, bottom as float, maxStep as float) as integer
    deltaOffset = params.offset[j + 1] - params.offset[j]
    deltaScale = params.scale[j + 1] - params.scale[j]
    change = BGE.Math.Max(Abs(deltaOffset + deltaScale * top), Abs(deltaOffset + deltaScale * bottom))
    ' a strip's middle value is at most half its change from either edge
    if change <= 2 * maxStep or maxStep <= 0
      return 1
    end if
    return Int(change / (2 * maxStep) + 0.999)
  end function

  ' Strips every stripWidth pixels across a bitmap `width` wide: the cuts from 0 to width.
  '
  ' @param {integer} width
  ' @param {integer} stripWidth above 0
  ' @return {integer[]}
  function fixedStripCuts(width as integer, stripWidth as integer) as integer[]
    cuts = [0] as integer[]
    x = stripWidth
    while x < width
      cuts.push(x)
      x += stripWidth
    end while
    cuts.push(width)
    return cuts
  end function

  ' A warp with knots out of order (an edge has passed another - a face has turned edge-on)
  ' or a flipped or collapsed column can't be drawn as strips.
  function columnsUsable(params as roAssociativeArray) as boolean
    for j = 0 to params.knotX.count() - 1
      if params.scale[j] <= 0
        return false
      end if
      if j > 0
        if params.knotX[j] - params.knotX[j - 1] < 0.5 or params.x[j] <= params.x[j - 1]
          return false
        end if
      end if
    end for
    return params.knotX.count() >= 2
  end function

  ' The knot segment whose line x lies on: the first or last past either end.
  function columnSegment(knotX as float[], x as float) as integer
    last = knotX.count() - 2
    for j = 0 to last - 1
      if x < knotX[j + 1]
        return j
      end if
    end for
    return last
  end function

  ' Solves an n x n system (row-major matrix) by Gaussian elimination with partial pivoting,
  ' or returns [] if it's singular. Overwrites matrix and rhs.
  function solveLinear(matrix as float[], rhs as float[], n as integer) as float[]
    for col = 0 to n - 1
      pivot = col
      for row = col + 1 to n - 1
        if Abs(matrix[row * n + col]) > Abs(matrix[pivot * n + col])
          pivot = row
        end if
      end for
      if Abs(matrix[pivot * n + col]) < 0.000001
        return []
      end if
      if pivot <> col
        for c = 0 to n - 1
          swap = matrix[col * n + c]
          matrix[col * n + c] = matrix[pivot * n + c]
          matrix[pivot * n + c] = swap
        end for
        swap = rhs[col]
        rhs[col] = rhs[pivot]
        rhs[pivot] = swap
      end if
      for row = col + 1 to n - 1
        factor = matrix[row * n + col] / matrix[col * n + col]
        for c = col to n - 1
          matrix[row * n + c] -= factor * matrix[col * n + c]
        end for
        rhs[row] -= factor * rhs[col]
      end for
    end for
    solution = zeros(n)
    for row = n - 1 to 0 step -1
      total = rhs[row]
      for c = row + 1 to n - 1
        total -= matrix[row * n + c] * solution[c]
      end for
      solution[row] = total / matrix[row * n + row]
    end for
    return solution
  end function

  function zeros(n as integer) as float[]
    values = [] as float[]
    for i = 1 to n
      values.push(0.0)
    end for
    return values
  end function

  function fitAxis(fromValues as float[], toValues as float[]) as roAssociativeArray
    n = fromValues.count()
    if n < 2
      return invalid
    end if
    fromMean = mean(fromValues)
    toMean = mean(toValues)
    covariance = 0.0
    variance = 0.0
    for i = 0 to n - 1
      p = fromValues[i] - fromMean
      covariance += p * (toValues[i] - toMean)
      variance += p * p
    end for
    if variance = 0
      return invalid
    end if
    scale = covariance / variance
    if scale <= 0
      return invalid
    end if
    return {scale: scale, offset: toMean - scale * fromMean}
  end function

  function mean(values as float[]) as float
    total = 0.0
    for each value in values
      total += value
    end for
    return total / values.count()
  end function

  function unusable() as FitResult
    return {residual: 1000000.0, params: invalid}
  end function

end namespace
