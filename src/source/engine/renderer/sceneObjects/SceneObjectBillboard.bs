import "../../../math/CornerPoints.bs"

namespace BGE

  interface TransformTempBitmapDetails
    origin as BGE.Math.Vector
    rotation as float
    scaleX as float
    scaleY as float
  end interface

  interface TempBitmapDrawResult
    worked as boolean
    didFastDraw as boolean
  end interface

  class SceneObjectBillboard extends SceneObject

    protected worldPoints as BGE.Math.CornerPoints = new BGE.Math.CornerPoints()
    protected canvasPoints as BGE.Math.CornerPoints = new BGE.Math.CornerPoints()

    protected canvasPosition as BGE.Math.Vector

    private isMirror = false

    private surfaceToCameraDotProduct as float
    private surfaceNormal as BGE.Math.Vector
    private normalOnCanvasStart as BGE.Math.Vector
    private normalOnCanvasEnd as BGE.Math.Vector

    private tempBitmap as ifDraw2d = invalid

    private limitPointMap as BGE.RendererHelpers.LimitPointMappings = invalid

    protected useTempBitmapMap as boolean[] = BGE.getDrawModeBooleanLookupArray()

    private hasAccurateTempBitmap = false

    sub new(name as string, drawableObj as Drawable, objType as SceneObjectType)
      super(name, drawableObj, objType)
      m.useTempBitmapMap[SceneObjectDrawMode.oriented] = true
      m.useTempBitmapMap[SceneObjectDrawMode.orientedDrawBackFace] = true
    end sub

    protected override function performDraw(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      retVal = false
      canvasBounds = invalid
      if m.usesTempBitmap(drawMode)
        ' only the temp bitmap paths below need the bounds, and they're the only paths
        ' reachable when this draw mode uses a temp bitmap at all - so in the direct draw
        ' modes (every sprite in a 2D game) this whole computation is skipped every frame
        canvasBounds = m.getCanvasBounds()
      end if
      if m.doNotDrawBecauseBackface(drawMode)
        ' this is backface, and should not be drawn
        m.tempBitmap = invalid
        return false
      end if

      if m.isRedrawToCanvasRequired(rendererObj, drawMode)
        ' either this moved recently, changed or not supposed to use temp bitmap in this drawMode
        objectMoved = m.objMovedInRelationToCamera(rendererObj.camera)
        if objectMoved
          transformDetails = m.attemptTransformTempBitmap(rendererObj, drawMode)
          if invalid <> transformDetails
            ' the object moved, but the temporary bitmap can be reused
            m.hasAccurateTempBitmap = false
            region = CreateObject("roRegion", m.tempBitmap, 0, 0, m.tempBitmap.GetWidth(), m.tempBitmap.GetHeight())
            retVal = rendererObj.drawTransformedObject(transformDetails.origin.x, transformDetails.origin.y, transformDetails.scaleX, transformDetails.scaleY, transformDetails.rotation, region)
          end if
        end if
        if not retVal
          ' we have not drawn anything yet
          if not m.usesTempBitmap(drawMode)
            retval = m.drawToCanvas(rendererObj, drawMode)
          else
            ' try to create a temp bitmap and draw it to the
            m.tempBitmap = m.createTempBitmap(canvasBounds, rendererObj, drawMode, objectMoved)
            if invalid <> m.tempBitmap
              retVal = rendererObj.drawObject(canvasBounds[0].x, canvasBounds[0].y, m.tempBitmap)
            end if
          end if
        end if
      else
        ' nothing changed since last frame
        if invalid = m.tempBitmap
          ' draw a static image that can be used later
          m.tempBitmap = m.createTempBitmap(canvasBounds, rendererObj, drawMode)
        end if
        retVal = rendererObj.drawObject(canvasBounds[0].x, canvasBounds[0].y, m.tempBitmap)
      end if

      if retVal and m.drawable.hasOutline() and not isWireFrameDrawMode(drawMode)
        ' Stroked live on top of whatever was just drawn - including on the frames where a
        ' cached temp bitmap was blitted - so the outline always tracks the current canvas
        ' points. The wireFrame draw modes are skipped because their only draw call already
        ' *is* the outline (see drawToCanvas).
        m.drawOutlineToCanvas(rendererObj, drawMode)
      end if

      if isOrientedDrawMode(drawMode) and invalid <> m.normalOnCanvasStart and invalid <> m.normalOnCanvasEnd
        ' normalOnCanvasStart, normalOnCanvasEnd will only be set if in debug mode
        rendererObj.drawLine(m.normalOnCanvasStart.x, m.normalOnCanvasStart.y, m.normalOnCanvasEnd.x, m.normalOnCanvasEnd.y, BGE.Colors.Pink)
      end if

      if not retVal
        ' nothing was drawn to the screen
        m.tempBitmap = invalid
      end if

      return retVal
    end function

    ' Determine if we need to redraw directly to the canvas, instead of use previous temp bitmap
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected function isRedrawToCanvasRequired(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      return not m.usesTempBitmap(drawMode) or m.objMovedInRelationToCamera(rendererObj.camera) or m.didRegionToDrawChange() or m.tempBitmap = invalid or m.hasAccurateTempBitmap = false
    end function


    ' Whether this object caches its drawing into a temp bitmap in the given draw mode, so
    ' that later frames can blit (or just re-transform) that bitmap instead of rasterizing
    ' the object from scratch again. Worth it for anything whose draw involves triangle
    ' rasterization; not worth it for a draw that's already a single cheap call.
    '
    ' Override to make the decision depend on more than the draw mode.
    '
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected function usesTempBitmap(drawMode as SceneObjectDrawMode) as boolean
      return m.useTempBitmapMap[drawMode]
    end function


    ' Create a Temporary bitmap with a the image of the scene object in relation to the current camera viewport
    '
    ' @param {BGE.Math.Vector[]} canvasBounds where in the final render will the bitmap be drawn [TL, BR]
    ' @return {roBitmap} the bitmap with the current perspective of the object or invalid if it failed
    protected function createTempBitmap(canvasBounds as BGE.Math.Vector[], rendererObj as Renderer, drawMode as SceneObjectDrawMode, allowFastDraw = false as boolean) as roBitmap
      if invalid = canvasBounds or canvasBounds.count() < 2
        return invalid
      end if
      canvasSize = BGE.Math.VectorOps.subtract(canvasBounds[1], canvasBounds[0])
      if canvasSize.x < 2 or canvasSize.y < 2
        '   return invalid
      end if
      tempBitmap = createObject("roBitmap", {width: canvasSize.x + 1, height: canvasSize.y + 1, alphaEnable: true})
      if invalid = tempBitmap
        return invalid
      end if
      tempBitmapResult = m.drawToTempBitmap(rendererObj, tempBitmap, canvasBounds[0], drawMode, allowFastDraw)
      tempBitmapDrawn = tempBitmapResult.worked
      if not tempBitmapDrawn
        m.limitPointMap = invalid
        return invalid
      end if
      m.limitPointMap = m.getCanvasLimitPointMap()
      m.hasAccurateTempBitmap = not tempBitmapResult.didFastDraw
      rendererObj.forceDraw(tempBitmap)
      return tempBitmap
    end function


    ' Draw this SceneObject directly to the final canvas
    ' Override this function in subclasses to provide specific behavior
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected function drawToCanvas(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      regionToDraw = m.getRegionWithIdToDraw()
      regionObj = regionToDraw.region
      retVal = false
      if invalid = regionToDraw or invalid = regionObj
        return false
      end if
      ' getDrawColorRGBA() already applies the isShaded brightness adjustment
      color = m.getDrawColorRGBA(rendererObj)
      if (drawMode = BGE.SceneObjectDrawMode.directToCamera) and m.canvasPosition <> invalid
        drawPos = m.canvasPosition
        totalScaleX = 1.0 * m.drawable.scale.x * m.drawable.owner.scale.x
        totalScaleY = 1.0 * m.drawable.scale.y * m.drawable.owner.scale.y
        retVal = rendererObj.drawRegion(regionToDraw.region, drawPos.x, drawPos.y, totalScaleX, totalScaleY, -m.getNetRotationZ(), color)
      else if drawMode = BGE.SceneObjectDrawMode.directScaled
        ' A Drawable's setAnchor(x, y) - e.g. (0.5, 1) for "feet on the ground" - controls
        ' where this quad is pinned as it scales with distance; see Drawable.getPretranslation()
        ' and updateCanvasPointsForCameraFacingQuad. drawRegion places the region by its
        ' *top left* corner, so that's what it has to be given - passing the quad's center
        ' drew every directScaled sprite half its own size down and to the right of where it
        ' belonged.
        drawPos = m.canvasPoints.topLeft
        totalScaleX = 1.0 * m.canvasPoints.getAvgWidth() / regionObj.getWidth()
        totalScaleY = 1.0 * m.canvasPoints.getAvgHeight() / regionObj.getHeight()
        theta = m.canvasPoints.getAvgRotation()

        ' The quad already has the region's pretranslation baked into it (see
        ' updateCanvasPointsForCameraFacingQuad), and Roku's draw calls would apply it again -
        ' so zero it for the blit, the same way drawToTempBitmap does.
        preTransX = regionObj.getPretranslationX()
        preTransY = regionObj.getPretranslationY()
        regionObj.setPretranslation(0, 0)
        retVal = rendererObj.drawRegion(regionToDraw.region, drawPos.x, drawPos.y, totalScaleX, totalScaleY, -theta, color)
        regionObj.setPretranslation(preTransX, preTransY)
      else if isSolidDrawMode(drawMode)
        retVal = rendererObj.drawPolygon(m.canvasPoints.toArray(), 0, 0, color)
      else if isWireFrameDrawMode(drawMode)
        retVal = rendererObj.drawPolygonOutline(m.canvasPoints.toClockwiseOutlineArray(), m.getOutlineDrawColorRGBA(rendererObj), m.drawable.outlineWidth)
      end if
      return retVal
    end function


    ' Strokes this object's outline onto the final canvas, on top of whatever has already
    ' been drawn for it. Only called when `Drawable.hasOutline()` is true and the draw mode
    ' isn't already outline-only.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean} true if the outline was drawn
    protected function drawOutlineToCanvas(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      outlinePoints = m.getOutlineCanvasPoints()
      if invalid = outlinePoints or outlinePoints.count() < 2
        return false
      end if
      return rendererObj.drawPolygonOutline(outlinePoints, m.getOutlineDrawColorRGBA(rendererObj), m.drawable.outlineWidth)
    end function


    ' The canvas points this object's outline is stroked along, in perimeter order - note
    ' that this is *not* the order `getAllCanvasPoints()` returns, which is bounds order
    ' (topLeft, topRight, bottomLeft, bottomRight) and traces a bowtie if stroked directly.
    ' Return `invalid` to opt out of outline drawing entirely, which is what a SceneObject
    ' whose shape isn't a single quad (e.g. `SceneObjectModel`) should do.
    '
    ' @return {BGE.Math.Vector[]} points to stroke along, or `invalid` for no outline
    protected function getOutlineCanvasPoints() as BGE.Math.Vector[]
      return m.canvasPoints.toClockwiseOutlineArray()
    end function


    ' Get the AA bounds of all points to be drawn on the final canvas
    ' @return {BGE.Math.Vector[]} the bounds of the canvas points
    protected function getCanvasBounds() as BGE.Math.Vector[]
      return BGE.Math.getBounds(m.getAllCanvasPoints())
    end function


    ' Get all canvas points
    '
    ' @return {BGE.Math.Vector[]}
    protected function getAllCanvasPoints() as BGE.Math.Vector[]
      return m.canvasPoints.toArray()
    end function


    ' Get the limit point mappings for the canvas points
    '
    ' @return {BGE.RendererHelpers.LimitPointMappings}
    private function getCanvasLimitPointMap() as BGE.RendererHelpers.LimitPointMappings
      return new BGE.RendererHelpers.LimitPointMappings(m.getAllCanvasPoints())
    end function

    private function getCurrentLimitPointsFromMap() as BGE.RendererHelpers.LimitPoints2d
      if rodash.isInvalid(m.limitPointMap)
        return invalid
      end if
      currentCanvasPoints = m.getAllCanvasPoints()

      if currentCanvasPoints.Count() <> m.limitPointMap.totalPointCount
        return invalid
      end if
      currentLimits = {
        top: currentCanvasPoints[m.limitPointMap.topIndex],
        left: currentCanvasPoints[m.limitPointMap.leftIndex],
        bottom: currentCanvasPoints[m.limitPointMap.bottomIndex],
        right: currentCanvasPoints[m.limitPointMap.rightIndex]
      }
      return currentLimits
    end function

    protected function getRegionWithIdToDraw() as BGE.RendererHelpers.RegionWithId
      return invalid
    end function

    protected function drawToTempBitmap(rendererObj as BGE.Renderer, tempBitmap as ifDraw2d, canvasPointsTopLeftBound as BGE.Math.Vector, drawMode as SceneObjectDrawMode, allowFastDraw = false as boolean) as TempBitmapDrawResult
      if invalid = tempBitmap
        return {worked: false, didFastDraw: false}
      end if

      regionToDraw = m.getRegionWithIdToDraw()
      if invalid = regionToDraw or invalid = regionToDraw.region
        return {worked: false, didFastDraw: false}
      end if
      regionObj = regionToDraw.region
      preTransX = regionObj.getPretranslationX()
      preTransY = regionObj.getPretranslationY()
      offsetCanvasPoints = m.canvasPoints.subtract(canvasPointsTopLeftBound)
      regionObj.setPretranslation(0, 0)
      tempBmpDidDraw = rendererObj.drawPinnedCornersTo(tempBitmap, offsetCanvasPoints, regionToDraw, m.getPinnedCornersOptions(), m.getDrawColorRGBA(rendererObj))
      regionObj.setPretranslation(preTransX, preTransY)
      return {worked: tempBmpDidDraw, didFastDraw: false}
    end function

    protected function getPinnedCornersOptions() as DrawPinnedCornersOptions
      return {}
    end function

    protected function didRegionToDrawChange() as boolean
      return false
    end function

    protected function getDrawColorRGBA(rendererObj as BGE.Renderer, ignoreColor = false as boolean) as integer
      return m.applyShading(rendererObj, m.drawable.getFillColorRGBA(ignoreColor))
    end function


    ' The outline stroke color, given the same shading treatment as the fill color.
    ' `Drawable.getOutlineColorRGBA` falls back to the fill color when no `outlineRGBA`
    ' has been set, which is what keeps the wireFrame draw modes looking the way they
    ' did before outlines were supported.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {boolean} [ignoreColor=false] ignore the drawable's own color and use white
    ' @return {integer} packed RGBA color to stroke with
    protected function getOutlineDrawColorRGBA(rendererObj as BGE.Renderer, ignoreColor = false as boolean) as integer
      return m.applyShading(rendererObj, m.drawable.getOutlineColorRGBA(ignoreColor))
    end function


    private function applyShading(rendererObj as BGE.Renderer, color as integer) as integer
      if not m.drawable.isShaded or invalid = m.surfaceNormal or invalid = m.worldPoints
        ' surfaceNormal is only computed for the oriented draw modes, so there is nothing
        ' to shade against in the direct ones
        return color
      end if
      return BGE.colorBrightness(color, getDotProductFromSurfaceToCamera(rendererObj, m.worldPoints.getCenter(), m.surfaceNormal))
    end function


    ' This object's total rotation about the z axis - its drawable's own rotation plus the
    ' rotation of the entity it's attached to. This is the only rotation component the
    ' direct (billboard) draw modes apply, since by definition they don't orient in 3D.
    '
    ' @return {float} rotation about z, in radians
    protected function getNetRotationZ() as float
      return m.drawable.rotation.z + m.drawable.owner.rotation.z
    end function

    protected override function updateWorldPosition(drawMode as SceneObjectDrawMode) as boolean
      if isScreenAlignedDrawMode(drawMode)
        ' Every billboard mode - including directScaled - is anchored at the drawable's own
        ' position and deliberately ignores its 3D orientation. directScaled builds its quad
        ' from the camera's own axes later, in updateCanvasPosition, since that's where the
        ' camera is available.
        m.worldPosition = m.drawable.getWorldPosition()

      else
        ' All oriented draw modes
        ' origin = BGE.Math.VectorOps.create()
        ' Unscaled size/pretranslation - m.transformationMatrix (built from offset, rotation,
        ' *and* scale) applies the drawable's scale when these corners are transformed below.
        ' Using getDrawnSize()/a pre-scaled pretranslation here as well applied scale twice.
        size = m.drawable.getSize()
        width = size.width
        height = size.height
        pretrans = m.drawable.getPretranslation()
        topLeft = BGE.Math.VectorOps.create(pretrans.x, -pretrans.y, 0)
        topRight = BGE.Math.VectorOps.add(topLeft, BGE.Math.VectorOps.create(width, 0, 0))
        bottomLeft = BGE.Math.VectorOps.add(topLeft, BGE.Math.VectorOps.create(0, -height, 0))
        bottomRight = BGE.Math.VectorOps.add(topLeft, BGE.Math.VectorOps.create(width, -height, 0))

        m.worldPoints.topLeft = BGE.Math.Matrix44.multVecMatrix(topLeft, m.transformationMatrix)
        m.worldPoints.topRight = BGE.Math.Matrix44.multVecMatrix(topRight, m.transformationMatrix)
        m.worldPoints.bottomLeft = BGE.Math.Matrix44.multVecMatrix(bottomLeft, m.transformationMatrix)
        m.worldPoints.bottomRight = BGE.Math.Matrix44.multVecMatrix(bottomRight, m.transformationMatrix)
        m.worldPosition = m.worldPoints.topLeft

        m.surfaceNormal = m.worldPoints.getNormal()
      end if
      return true
    end function


    override function getPositionForCameraDistance(drawMode as SceneObjectDrawMode) as BGE.Math.Vector
      if isScreenAlignedDrawMode(drawMode)
        return m.worldPosition
      end if
      return m.worldPoints.getCenter()
    end function

    protected override function getPositionsForFrustumCheck(drawMode as SceneObjectDrawMode) as BGE.Math.Vector[]
      if isScreenAlignedDrawMode(drawMode)
        return [m.worldPosition]
      end if
      return m.worldPoints.toArray()
    end function

    protected override function findCanvasPosition(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      result = m.updateCanvasPosition(rendererObj, drawMode)
      ' A screen-aligned billboard has no face to turn away from the camera, so it never gets
      ' a mirror flag and is never backface culled.
      if result and not isScreenAlignedDrawMode(drawMode)
        m.computeNormalDebugInfo(rendererObj)
        m.isMirror = false
        if invalid <> m.surfaceNormal
          worldCenter = m.worldPoints.getCenter()
          if not isNormalFacingCamera(rendererObj, worldCenter, m.surfaceNormal)
            m.isMirror = true
          end if
        end if
      end if
      return result
    end function


    protected function updateCanvasPosition(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      if isDirectDrawMode(drawMode)
        worldPos = m.worldPosition
        if m.needsManualPretranslationForDirectMode()
          pretrans = m.drawable.getPretranslation()
          worldPos = BGE.Math.VectorOps.add(worldPos, BGE.Math.VectorOps.create(
          pretrans.x * m.drawable.scale.x, -pretrans.y * m.drawable.scale.y, 0))
        end if
        m.canvasPosition = rendererObj.worldPointToCanvasPoint(worldPos)
        if invalid = m.canvasPosition
          return false
        end if
        if m.needsCanvasCornerPoints()
          m.updateCanvasPointsForDirectMode()
        end if
      else if drawMode = BGE.SceneObjectDrawMode.directScaled
        m.canvasPosition = rendererObj.worldPointToCanvasPoint(m.worldPosition)
        if invalid = m.canvasPosition
          return false
        end if
        return m.updateCanvasPointsForCameraFacingQuad(rendererObj)
      else if isOrientedDrawMode(drawMode)
        index = 0
        for each corner in m.worldPoints.toArray()
          canvasPoint = rendererObj.worldPointToCanvasPoint(corner)
          if invalid = canvasPoint
            return false
          end if
          m.canvasPoints.setPointByIndex(index, canvasPoint)
          index++
        end for
      end if
      return true
    end function


    ' Whether the four canvas corner points are needed in the direct (billboard) draw
    ' modes, which otherwise get by with the single `canvasPosition`. Computing them isn't
    ' free, so it's opt-in: outlines are stroked along those corners, so anything with an
    ' outline needs them. Override to require them for other reasons too.
    '
    ' @return {boolean}
    protected function needsCanvasCornerPoints() as boolean
      return m.drawable.hasOutline()
    end function


    ' Whether this object's plain 2D draw path (directToCamera/matchCamera) needs its
    ' anchor applied by hand here, rather than getting it for free some other way. True for
    ' anything with no native roRegion to lean on (DrawableRectangle, DrawableText) - false
    ' (the default) for anything backed by a region (SceneObjectImage), since Roku's own
    ' DrawObject/DrawScaledObject already apply the region's pretranslation natively.
    '
    ' @return {boolean}
    protected function needsManualPretranslationForDirectMode() as boolean
      return false
    end function


    ' The top-left canvas point this billboard's screen-aligned (direct/directScaled) draw
    ' modes last positioned at, or `invalid` before the first successful draw.
    '
    ' @return {BGE.Math.Vector}
    function getCanvasPosition() as BGE.Math.Vector
      return m.canvasPosition
    end function


    ' The world-space corner points this billboard's oriented draw modes last computed.
    '
    ' @return {BGE.Math.CornerPoints}
    function getWorldPoints() as BGE.Math.CornerPoints
      return m.worldPoints
    end function


    ' The canvas corner points this billboard last computed - populated for a rotated or
    ' outlined direct-mode object (see needsCanvasCornerPoints()), or any oriented one.
    '
    ' @return {BGE.Math.CornerPoints}
    function getCanvasPoints() as BGE.Math.CornerPoints
      return m.canvasPoints
    end function


    ' Lays the four canvas corner points out around `canvasPosition` for the direct
    ' (billboard) draw modes, which draw a screen-aligned quad rather than projecting each
    ' world corner through the camera the way the oriented draw modes do (see
    ' `updateCanvasPosition`). `canvasPosition` is the quad's top left corner and the point
    ' any rotation pivots around, matching how `drawToCanvas` blits the region.
    protected sub updateCanvasPointsForDirectMode()
      canvasSize = m.getDirectModeCanvasSize()
      ' negated to match the sign convention drawToCanvas passes to Renderer.drawRegion,
      ' since canvas space is y-down while world rotations are y-up
      theta = -m.getNetRotationZ()
      cosTheta = cos(theta)
      sinTheta = sin(theta)
      cornerOffsets = [
        [0, 0],
        [canvasSize.width, 0],
        [0, canvasSize.height],
        [canvasSize.width, canvasSize.height]
      ]
      index = 0
      for each offset in cornerOffsets
        dX = offset[0]
        dY = offset[1]
        m.canvasPoints.setPointByIndex(index, BGE.Math.VectorOps.create(
        m.canvasPosition.x + dX * cosTheta - dY * sinTheta,
        m.canvasPosition.y + dX * sinTheta + dY * cosTheta))
        index++
      end for
    end sub


    ' Builds this object's quad in the plane the camera is looking at, then projects it - which
    ' is what makes `directScaled` a Doom-style sprite: it faces the camera by construction, it
    ' shrinks purely with distance because its corners are offset by *world* units before being
    ' projected, and it is completely independent of the object's own rotation. (Deriving the
    ' on-screen size from the object's own projected quad instead would fold its orientation
    ' into its size, so a sprite turned edge-on would squash - never what a billboard wants.)
    '
    ' The quad is anchored at its **top left** corner, exactly as `directToCamera` anchors the
    ' region it blits - so an object switched between the two billboard modes stays put, and
    ' only its size changes.
    '
    ' @param {Renderer} rendererObj
    ' @return {boolean} true if every corner projected onto the canvas
    protected function updateCanvasPointsForCameraFacingQuad(rendererObj as Renderer) as boolean
      cameraObj = rendererObj.camera
      right = cameraObj.getRightVector()
      up = cameraObj.getUpVector()
      worldSize = m.getDirectModeCanvasSize()

      acrossWorld = BGE.Math.VectorOps.scale(right, worldSize.width)
      downWorld = BGE.Math.VectorOps.scale(up, -worldSize.height)

      ' Anchoring, expressed the way the oriented modes express it (see updateWorldPosition):
      ' the pretranslation shifts the top left corner, right by x and *down* by y. For an Image
      ' that value comes from its region, which is how a sprite atlas's pivot reaches us (see
      ' BGE.getRegionsFromAtlas). Baked into the quad here rather than left to the blit, so the
      ' quad describes where the object actually lands - the outline hook and
      ' SceneObjectRectangle both measure off it. drawToCanvas zeroes it on the region for the
      ' blit itself so it isn't applied a second time.
      pretrans = m.drawable.getPretranslation()
      totalScaleX = m.drawable.scale.x * m.drawable.owner.scale.x
      totalScaleY = m.drawable.scale.y * m.drawable.owner.scale.y
      anchorOffset = BGE.Math.VectorOps.subtract(
      BGE.Math.VectorOps.scale(right, pretrans.x * totalScaleX),
      BGE.Math.VectorOps.scale(up, pretrans.y * totalScaleY))

      topLeft = BGE.Math.VectorOps.add(m.worldPosition, anchorOffset)
      cornerWorldPoints = [
        topLeft,
        BGE.Math.VectorOps.add(topLeft, acrossWorld),
        BGE.Math.VectorOps.add(topLeft, downWorld),
        BGE.Math.VectorOps.add(BGE.Math.VectorOps.add(topLeft, acrossWorld), downWorld)
      ]

      index = 0
      for each cornerWorldPoint in cornerWorldPoints
        canvasPoint = rendererObj.worldPointToCanvasPoint(cornerWorldPoint)
        if invalid = canvasPoint
          return false
        end if
        m.canvasPoints.setPointByIndex(index, canvasPoint)
        index++
      end for
      return true
    end function


    ' The on-canvas size of this object in the direct (billboard) draw modes - its drawn
    ' size scaled by the owning entity, matching the scale `drawToCanvas` applies to the
    ' region it blits.
    '
    ' @return {SizeWH}
    protected function getDirectModeCanvasSize() as SizeWH
      drawnSize = m.drawable.getDrawnSize()
      return {
        width: drawnSize.width * m.drawable.owner.scale.x,
        height: drawnSize.height * m.drawable.owner.scale.y
      }
    end function


    protected sub computeNormalDebugInfo(rendererObj as Renderer)
      if isTrue(m.drawable.owner.game.getDebugValue("draw_scene_object_normals")) and invalid <> m.surfaceNormal and invalid <> m.worldPoints
        ' normalCenter = m.getNormalDebugPoint()
        worldCenter = m.worldPoints.getCenter()
        m.normalOnCanvasStart = rendererObj.worldPointToCanvasPoint(worldCenter)
        worldNormalEnd = BGE.Math.VectorOps.subtract(worldCenter, BGE.Math.VectorOps.scale(m.surfaceNormal, 100))
        m.normalOnCanvasEnd = rendererObj.worldPointToCanvasPoint(worldNormalEnd)
      else
        m.normalOnCanvasStart = invalid
        m.normalOnCanvasEnd = invalid
      end if
    end sub

    protected function getNormalDebugPoint() as BGE.Math.Vector
      return m.worldPoints.getCenter()
    end function


    ' Determine if we can just scale and/or rotate the temp bitmap to match the required position
    ' @param {Renderer} renderObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {TransformTempBitmapDetails} the details of the transformation or invalid if it cannot be done
    protected function attemptTransformTempBitmap(renderObj as Renderer, drawMode as SceneObjectDrawMode) as TransformTempBitmapDetails
      if rodash.isInvalid(m.tempBitmap) or rodash.isInvalid(m.limitPointMap) or not m.usesTempBitmap(drawMode)
        return invalid
      end if

      if m.limitPointMap.height = invalid or m.limitPointMap.height < 2 or m.limitPointMap.width = invalid or m.limitPointMap.width < 2
        return invalid
      end if

      currentLimits = m.getCurrentLimitPointsFromMap()

      if rodash.isInvalid(currentLimits)
        return invalid
      end if

      rotationDelta = m.limitPointMap.getAngleBaseLineDifference(currentLimits)

      ' rotate the current points to be axis aligned, so we can get the mappedOrigin - this allows us to read x & y sclaes
      currentBackRotationMatrix = BGE.Math.getTransformationMatrix(BGE.Math.VectorOps.create(),
      BGE.Math.VectorOps.create(0, 0, rotationDelta),
      BGE.Math.VectorOps.create(1, 1)
      )
      backRotatedCurrent = {
        left: BGE.Math.Matrix44.multVecMatrix(currentLimits.left, currentBackRotationMatrix),
        top: BGE.Math.Matrix44.multVecMatrix(currentLimits.top, currentBackRotationMatrix),
        right: BGE.Math.Matrix44.multVecMatrix(currentLimits.right, currentBackRotationMatrix),
        bottom: BGE.Math.Matrix44.multVecMatrix(currentLimits.bottom, currentBackRotationMatrix)
      } as BGE.RendererHelpers.LimitPoints2d

      d = backRotatedCurrent.left.y - backRotatedCurrent.top.y ' distance From MappedOrigin To CurrentLeft
      reRotation = BGE.Math.HALF_PI - rotationDelta
      ' get the mapped origin by applying the distance From MappedOrigin To CurrentLeft
      mappedOrigin = BGE.Math.VectorOps.create(currentLimits.left.x + d * cos(-reRotation), currentLimits.left.y + d * sin(-reRotation))

      newVertScale = abs(backRotatedCurrent.top.y - backRotatedCurrent.bottom.y) / m.limitPointMap.height
      newHorizScale = (backRotatedCurrent.right.x - backRotatedCurrent.left.x) / m.limitPointMap.width

      originDelta = BGE.Math.VectorOps.subtract(mappedOrigin, m.limitPointMap.origin)
      ' compare canvas points vs. scaled points from mappedOrigin

      tempTranslationTransformMatrix = BGE.Math.getTransformationMatrix(
      originDelta,
      BGE.Math.VectorOps.create(0, 0, rotationDelta),
      BGE.Math.VectorOps.create(newHorizScale, newVertScale)
      )
      transformedLeft = BGE.Math.Matrix44.multVecMatrix(m.limitPointMap.left, tempTranslationTransformMatrix)
      transformedTop = BGE.Math.Matrix44.multVecMatrix(m.limitPointMap.top, tempTranslationTransformMatrix)

      transformedRight = BGE.Math.Matrix44.multVecMatrix(m.limitPointMap.right, tempTranslationTransformMatrix)
      transformedBottom = BGE.Math.Matrix44.multVecMatrix(m.limitPointMap.bottom, tempTranslationTransformMatrix)

      topDelta = BGE.Math.VectorOps.manhattanLength(BGE.Math.VectorOps.subtract(transformedTop, currentLimits.top))
      leftDelta = BGE.Math.VectorOps.manhattanLength(BGE.Math.VectorOps.subtract(transformedLeft, currentLimits.left))
      rightDelta = BGE.Math.VectorOps.manhattanLength(BGE.Math.VectorOps.subtract(transformedRight, currentLimits.right))
      bottomDelta = BGE.Math.VectorOps.manhattanLength(BGE.Math.VectorOps.subtract(transformedBottom, currentLimits.bottom))

      ' totalDifference = topDelta + leftDelta + rightDelta + bottomDelta
      maxDifference = BGE.Math.arrayMax([topDelta, leftDelta, rightDelta, bottomDelta])
      if maxDifference < m.getTempBitmapThreshold(drawMode)
        ' if the difference is small enough, we can use the temp bitmap
        return {
          origin: mappedOrigin,
          rotation: rotationDelta,
          scaleX: newHorizScale,
          scaleY: newVertScale
        }
      end if

      return invalid
    end function



    ' Is this a back and then we should not draw it?
    '
    ' @param {SceneObjectDrawMode} drawMode - some drawModes explicitly should draw the backface
    ' @return {boolean} true if we should not draw
    protected function doNotDrawBecauseBackFace(drawMode as SceneObjectDrawMode) as boolean
      if m.isMirror
        if drawMode = SceneObjectDrawMode.orientedDrawBackFace or drawMode = SceneObjectDrawMode.wireFrameDrawBackFace
          return false
        end if
        return true
      end if
      return false
    end function


    protected function getTempBitmapThreshold(drawMode as SceneObjectDrawMode) as integer
      return 16
    end function

  end class

end namespace
