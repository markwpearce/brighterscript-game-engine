import "../../../math/CornerPoints.bs"
import "../../../math/math.bs"
import "../../../math/Matrix44.bs"
import "../../../math/vector.bs"
import "../../../roku_modules/rodash/rodash.d.bs"
import "../../../utils/colors.bs"
import "../../../utils/utils.bs"
import "../../drawables/Drawable.bs"
import "../../interfaces.bs"
import "../occlusion/ConvexInset.bs"
import "../occlusion/OcclusionTypes.bs"
import "../cameras/Camera3d.bs"
import "../Renderer.bs"
import "../RendererHelpers.bs"
import "SceneObject.bs"

namespace BGE

  interface TransformTempBitmapDetails
    origin as BGE.Math.Vector
    rotation as float
    scaleX as float
    scaleY as float
    ' set to corner pin the temp bitmap instead (drawPinnedCorners split into four
    ' triangles meeting at pinCenter), with this id for the renderer's triangle cache
    optional pinCorners as BGE.Math.CornerPoints
    optional pinCenter as BGE.Math.Vector
    optional pinRegionId as string
  end interface

  interface TempBitmapDrawResult
    worked as boolean
    didFastDraw as boolean
  end interface

  ' Where drawRegionAsRotatedQuad() blits a region: its top left corner, size and rotation.
  interface RotatedQuadBlit
    x as float
    y as float
    width as float
    height as float
    ' radians, negated as CornerPoints.getAvgRotation() returns it
    rotation as float
  end interface

  class SceneObjectBillboard extends SceneObject

    ' Reused by appendOccluderPolygons() for its projected corners.
    private occluderProjectionScratch as float[] = []

    protected worldPoints as BGE.Math.CornerPoints = new BGE.Math.CornerPoints()
    protected canvasPoints as BGE.Math.CornerPoints = new BGE.Math.CornerPoints()

    protected canvasPosition as BGE.Math.Vector

    private isMirror = false
    ' computeBillboardWorldCorners()'s last result and what it was computed from
    private billboardCornersCache as roAssociativeArray = invalid
    ' Scratch for projecting the directScaled quad's corners: x, y, depth per corner.
    private cameraFacingProjected as float[] = []

    private surfaceToCameraDotProduct as float
    private surfaceNormal as BGE.Math.Vector
    private normalOnCanvasStart as BGE.Math.Vector
    private normalOnCanvasEnd as BGE.Math.Vector

    private tempBitmap as ifDraw2d = invalid

    ' A view into m.tempBitmap sized to exactly this frame's own footprint - see
    ' createTempBitmap()'s grow-only reuse comment for why this can't just be
    ' m.tempBitmap itself.
    private tempBitmapRegion as roRegion = invalid

    private limitPointMap as BGE.RendererHelpers.LimitPointMappings = invalid

    protected useTempBitmapMap as boolean[] = BGE.getDrawModeBooleanLookupArray()

    private hasAccurateTempBitmap = false

    sub new(name as string, drawableObj as Drawable, objType as SceneObjectType)
      super(name, drawableObj, objType)
      m.useTempBitmapMap[SceneObjectDrawMode.oriented] = true
      m.useTempBitmapMap[SceneObjectDrawMode.orientedDrawBackFace] = true
    end sub

    ' Fast-draw tolerances from the renderer drawing this object, captured at draw time
    ' because canUseTransformedFastDraw() has no renderer parameter.
    private fastDrawParallelogramTolerance as float = 0.03
    private fastDrawPerpendicularityTolerance as float = 0.05

    private sub captureFastDrawTolerances(rendererObj as BGE.Renderer)
      m.fastDrawParallelogramTolerance = rendererObj.qualitySettings.fastDrawParallelogramTolerance
      m.fastDrawPerpendicularityTolerance = rendererObj.qualitySettings.fastDrawPerpendicularityTolerance
    end sub

    protected override function performDraw(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      m.captureFastDrawTolerances(rendererObj)
      ' The cached temp bitmap never includes the distance fade; it's applied to the blit.
      blitColor = BGE.RendererHelpers.applyAlphaFade(-1, m.distanceFadeAlpha)
      retVal = false
      canvasBounds = invalid
      if m.usesTempBitmap(drawMode)
        ' only the temp bitmap paths below need the bounds, and they're the only paths
        ' reachable when this draw mode uses a temp bitmap at all - so in the direct draw
        ' modes (every sprite in a 2D game) this whole computation is skipped every frame
        canvasBounds = m.getCanvasBounds()
      end if
      if m.doNotDrawBecauseBackface(drawMode)
        ' this is backface, and should not be drawn
        m.tempBitmap = invalid
        m.tempBitmapRegion = invalid
        return false
      end if

      if m.isRedrawToCanvasRequired(rendererObj, drawMode)
        ' either this moved recently, changed or not supposed to use temp bitmap in this drawMode
        objectMoved = m.objMovedInRelationToCamera(rendererObj.camera)
        if objectMoved
          transformDetails = m.attemptTransformTempBitmap(rendererObj, drawMode)
          ' an override may not know the temp bitmap has since been dropped
          if invalid <> transformDetails and invalid <> m.tempBitmapRegion
            ' the object moved, but the temporary bitmap can be reused
            m.hasAccurateTempBitmap = false
            if invalid <> transformDetails.pinCorners
              retVal = rendererObj.drawPinnedCorners(transformDetails.pinCorners, {region: m.tempBitmapRegion, id: transformDetails.pinRegionId}, {splitIntoFour: true, center: transformDetails.pinCenter}, blitColor)
            else
              retVal = rendererObj.drawTransformedObject(transformDetails.origin.x, transformDetails.origin.y, transformDetails.scaleX, transformDetails.scaleY, transformDetails.rotation, m.tempBitmapRegion, blitColor)
            end if
          end if
        end if
        if not retVal
          ' we have not drawn anything yet
          if not m.usesTempBitmap(drawMode)
            ' Some subclasses (SceneObjectCircle, issue #105) flip usesTempBitmap()'s
            ' return value frame-to-frame for the same draw mode, unlike every other
            ' caller where it's constant per mode - so a cached m.tempBitmap from an
            ' earlier frame could otherwise sit around stale and get wrongly reused via
            ' attemptTransformTempBitmap() once this flips back to true.
            m.tempBitmap = invalid
            m.tempBitmapRegion = invalid
            retval = m.drawToCanvas(rendererObj, drawMode)
          else
            ' try to create a temp bitmap and draw it to the canvas
            m.tempBitmap = m.createTempBitmap(canvasBounds, rendererObj, drawMode, objectMoved and not m.drawsOccluderExactly())
            if invalid <> m.tempBitmap
              retVal = rendererObj.drawObject(canvasBounds[0].x, canvasBounds[0].y, m.tempBitmapRegion, blitColor)
            end if
          end if
        end if
      else
        ' nothing changed since last frame
        if invalid = m.tempBitmap
          ' draw a static image that can be used later
          m.tempBitmap = m.createTempBitmap(canvasBounds, rendererObj, drawMode)
        end if
        retVal = rendererObj.drawObject(canvasBounds[0].x, canvasBounds[0].y, m.tempBitmapRegion, blitColor)
      end if

      if retVal and m.drawable.hasOutline() and not isWireFrameDrawMode(drawMode)
        ' Stroked live on top of whatever was just drawn - including on the frames where a
        ' cached temp bitmap was blitted - so the outline always tracks the current canvas
        ' points. The wireFrame draw modes are skipped because their only draw call already
        ' *is* the outline (see drawToCanvas).
        m.drawOutlineToCanvas(rendererObj, drawMode)
      end if

      if isOrientedDrawMode(drawMode) and invalid <> m.normalOnCanvasStart and invalid <> m.normalOnCanvasEnd
        ' normalOnCanvasStart, normalOnCanvasEnd will only be set if in debug mode
        rendererObj.drawLine(m.normalOnCanvasStart.x, m.normalOnCanvasStart.y, m.normalOnCanvasEnd.x, m.normalOnCanvasEnd.y, BGE.Colors.Pink)
      end if

      if not retVal
        ' nothing was drawn to the screen
        m.tempBitmap = invalid
        m.tempBitmapRegion = invalid
      end if

      return retVal
    end function

    ' The cached temp bitmap was drawn for wherever this was last drawn, which may have
    ' changed while it was hidden.
    '
    ' @param {Camera} cameraObj the renderer's camera
    override sub markSkippedOccluded(cameraObj as Camera)
      super.markSkippedOccluded(cameraObj)
      m.hasAccurateTempBitmap = false
    end sub

    ' Determine if we need to redraw directly to the canvas, instead of use previous temp bitmap
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected function isRedrawToCanvasRequired(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      m.captureFastDrawTolerances(rendererObj)
      return not m.usesTempBitmap(drawMode) or m.objMovedInRelationToCamera(rendererObj.camera) or m.didRegionToDrawChange() or m.tempBitmap = invalid or m.hasAccurateTempBitmap = false or m.qualityChangedThisDraw
    end function


    ' Whether the most recent oriented/solid draw took the cheap rotate+scale fast path
    ' (drawRegionAsRotatedQuad, below) instead of the exact drawPinnedCorners warp - see
    ' canUseTransformedFastDraw() below. Exposed read-only for tests/telemetry via
    ' usedTransformedFastDraw(). Shared by every single-quad billboard subclass that opts
    ' into the fast-draw check (SceneObjectCircle/#105, SceneObjectImage+SceneObjectText/#163).
    protected usedTransformedFastDrawLastFrame = false

    ' For tests/telemetry only - see usedTransformedFastDrawLastFrame above.
    '
    ' @return {boolean}
    function usedTransformedFastDraw() as boolean
      return m.usedTransformedFastDrawLastFrame
    end function

    ' Opt-in hook (default: never eligible) for the single-quad fast-draw check used by
    ' usesTempBitmap()/drawFastPath() below - override to return true for the draw modes
    ' where this object's fill is always a flat quad, so it's worth checking whether this
    ' frame's projected quad is a plain rotated rectangle (see canUseTransformedFastDraw()).
    '
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected function isEligibleForFastDrawCheck(drawMode as SceneObjectDrawMode) as boolean
      return false
    end function

    ' Whether m.canvasPoints (this frame's projected quad) is close enough to a pure
    ' rotation + non-uniform scale of a rectangle that drawRegionAsRotatedQuad() - one
    ' native DrawTransformedObject call - is a safe stand-in for the exact
    ' drawPinnedCorners triangle warp. True for a flat quad rotated only about the axis
    ' facing the camera (including not rotated at all); false once perspective
    ' foreshortening skews the quad into a general trapezoid - see issue #105.
    '
    ' @return {boolean}
    protected function canUseTransformedFastDraw() as boolean
      return m.canvasPoints.isApproximatelyRotatedRectangle(m.fastDrawParallelogramTolerance, m.fastDrawPerpendicularityTolerance)
    end function

    ' How to blit a mirrored, unrotated quad: flipped on whichever axis leaves a rotation of
    ' 0. Real Roku hardware only mirrors a DrawTransformedObject call at a rotation of
    ' exactly 0 - at any other angle a negative scaleX turns the region half way round
    ' instead, and a negative scaleY is ignored (issue #237). A mirrored quad measures a
    ' rotation half a turn off, since its "right" edge is really its left - or its top,
    ' for a vertical flip.
    '
    ' @param {BGE.Math.CornerPoints} quad a quad isMirroredOnCanvas() is true for
    ' @return {object} {flipX, flipY} - or invalid if the quad is also rotated
    private function getMirroredBlitTransform(quad as BGE.Math.CornerPoints) as object
      ' getAvgRotation() is negated, so it runs 0 to -2pi
      rotation = BGE.Math.constrainAngle(quad.getAvgRotation())
      ' 0.01 radians is under 1px of skew across a 100px sprite
      tolerance = 0.01
      if Abs(rotation - BGE.Math.PI) < tolerance
        return {flipX: true, flipY: false}
      else if rotation < tolerance or Abs(rotation - 2 * BGE.Math.PI) < tolerance
        return {flipX: false, flipY: true}
      end if
      return invalid
    end function

    ' Draws this object's fill via the cheap rotate+scale fast path - only valid to call
    ' once isEligibleForFastDrawCheck(drawMode) and canUseTransformedFastDraw() have both
    ' been confirmed (usesTempBitmap() below already does this and caches the result into
    ' usedTransformedFastDrawLastFrame for the same frame).
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected function drawFastPath(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      regionToDraw = m.getRegionWithIdToDraw(rendererObj)
      if invalid = regionToDraw or invalid = regionToDraw.region
        return false
      end if
      color = m.getCanvasDrawColorRGBA(rendererObj)
      return m.drawRegionAsRotatedQuad(rendererObj, regionToDraw.region, m.canvasPoints, color)
    end function

    ' Whether this object caches its drawing into a temp bitmap in the given draw mode, so
    ' that later frames can blit (or just re-transform) that bitmap instead of rasterizing
    ' the object from scratch again. Worth it for anything whose draw involves triangle
    ' rasterization; not worth it for a draw that's already a single cheap call.
    '
    ' A subclass opted into the fast-draw check (isEligibleForFastDrawCheck() above)
    ' skips the temp bitmap entirely whenever this frame's quad qualifies (issue #105/#163) -
    ' unlike every other caller, this can flip frame-to-frame for the same draw mode (see
    ' performDraw()'s own note on that). Override useTempBitmapMap/isEligibleForFastDrawCheck
    ' to change the decision rather than this method itself.
    '
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected function usesTempBitmap(drawMode as SceneObjectDrawMode) as boolean
      if m.isEligibleForFastDrawCheck(drawMode)
        m.usedTransformedFastDrawLastFrame = m.canUseTransformedFastDraw()
        return not m.usedTransformedFastDrawLastFrame
      end if
      m.usedTransformedFastDrawLastFrame = false
      return m.useTempBitmapMap[drawMode]
    end function

    ' For tests/telemetry only - the backing temp bitmap's actual allocated size, which
    ' can be larger than this frame's own footprint (see createTempBitmap()'s grow-only
    ' reuse comment).
    '
    ' @return {BGE.Math.Vector} {x: width, y: height}, or invalid if there's no temp bitmap
    function getTempBitmapCapacity() as BGE.Math.Vector
      bitmap = m.tempBitmap as roBitmap
      if invalid = bitmap
        return invalid
      end if
      return BGE.Math.VectorOps.create(bitmap.GetWidth(), bitmap.GetHeight())
    end function


    ' Create a Temporary bitmap with a the image of the scene object in relation to the current camera viewport
    '
    ' @param {BGE.Math.Vector[]} canvasBounds where in the final render will the bitmap be drawn [TL, BR]
    ' @return {roBitmap} the bitmap with the current perspective of the object or invalid if it failed
    protected function createTempBitmap(canvasBounds as BGE.Math.Vector[], rendererObj as Renderer, drawMode as SceneObjectDrawMode, allowFastDraw = false as boolean) as roBitmap
      if invalid = canvasBounds or canvasBounds.count() < 2
        return invalid
      end if
      canvasSize = BGE.Math.VectorOps.subtract(canvasBounds[1], canvasBounds[0])
      if canvasSize.x < 2 or canvasSize.y < 2
        '   return invalid
      end if
      neededWidth = canvasSize.x + 1
      neededHeight = canvasSize.y + 1

      ' Grow-only reuse (issue #128/#163's follow-up): a fresh CreateObject() every single
      ' frame an object moves is real, measured allocation cost, so this keeps whatever
      ' backing bitmap the object already has across frames and only reallocates once this
      ' frame's silhouette has actually outgrown it - see RendererHelpers.growOrClearBitmap.
      tempBitmap = BGE.RendererHelpers.growOrClearBitmap(m.tempBitmap as roBitmap, neededWidth, neededHeight)
      if invalid = tempBitmap
        return invalid
      end if

      tempBitmapResult = m.drawToTempBitmap(rendererObj, tempBitmap, canvasBounds[0], drawMode, allowFastDraw)
      tempBitmapDrawn = tempBitmapResult.worked
      if not tempBitmapDrawn
        m.limitPointMap = invalid
        m.tempBitmapRegion = invalid
        return invalid
      end if
      ' The backing bitmap may now be larger than this frame's own content (grow-only
      ' reuse, above) - every consumer of "the temp bitmap" must only ever see this
      ' frame's actual footprint, or leftover blank capacity gets blitted/rotated right
      ' alongside the real content.
      m.tempBitmapRegion = CreateObject("roRegion", tempBitmap, 0, 0, neededWidth, neededHeight)
      m.limitPointMap = m.getCanvasLimitPointMap()
      m.hasAccurateTempBitmap = not tempBitmapResult.didFastDraw
      rendererObj.forceDraw(tempBitmap)
      return tempBitmap
    end function


    ' Draw this SceneObject directly to the final canvas
    ' Override this function in subclasses to provide specific behavior
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected function drawToCanvas(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      regionToDraw = m.getRegionWithIdToDraw(rendererObj)
      regionObj = regionToDraw.region
      retVal = false
      if invalid = regionToDraw or invalid = regionObj
        return false
      end if
      ' getDrawColorRGBA() already applies the isShaded brightness adjustment
      color = m.getCanvasDrawColorRGBA(rendererObj)
      if (drawMode = BGE.SceneObjectDrawMode.directToCamera) and m.canvasPosition <> invalid
        drawPos = m.canvasPosition
        drawnSize = m.drawable.getDrawnSize()
        ' The ratio of the drawable's own declared size to the region's native pixel
        ' size - 1.0 for every existing billboard drawable (Image, whose width/height
        ' come directly from its region; DrawableRectangle/Text, which have no region at
        ' all and never reach this branch), but not 1.0 for a drawable like
        ' DrawableCircle that intentionally shares one fixed-size texture at an
        ' arbitrary display size. Matches the same ratio directScaled already computes
        ' below (canvasPoints.getAvgWidth() / regionObj.getWidth()), just derived from
        ' the drawable's own size instead of a projected quad.
        ownerScale = m.drawable.getOwnerScale()
        totalScaleX = 1.0 * (drawnSize.width / regionObj.getWidth()) * ownerScale.x
        totalScaleY = 1.0 * (drawnSize.height / regionObj.getHeight()) * ownerScale.y
        retVal = rendererObj.drawRegion(regionToDraw.region, drawPos.x, drawPos.y, totalScaleX, totalScaleY, -m.getNetRotationZ(), color)
      else if drawMode = BGE.SceneObjectDrawMode.directScaled
        ' A Drawable's setAnchor(x, y) - e.g. (0.5, 1) for "feet on the ground" - controls
        ' where this quad is pinned as it scales with distance; see Drawable.getPretranslation()
        ' and updateCanvasPointsForCameraFacingQuad.
        retVal = m.drawRegionAsRotatedQuad(rendererObj, regionObj, m.canvasPoints, color)
      else if isSolidDrawMode(drawMode)
        retVal = rendererObj.drawPolygon(m.canvasPoints.toArray(), 0, 0, color)
      else if isWireFrameDrawMode(drawMode)
        retVal = rendererObj.drawPolygonOutline(m.canvasPoints.toClockwiseOutlineArray(), m.getCanvasOutlineDrawColorRGBA(rendererObj), m.drawable.outlineWidth)
      end if
      return retVal
    end function


    ' Blits `regionObj` as a single rotate + non-uniform-scale transform matching the given
    ' quad, anchored at its top left corner - a cheap approximation (one native
    ' DrawTransformedObject call, no per-pixel warp) that is only *correct* when the quad is
    ' actually a rotated rectangle (see BGE.Math.CornerPoints.isApproximatelyRotatedRectangle).
    ' `directScaled` can always use this (its quad is built from a rotation in the first
    ' place - see updateCanvasPointsForCameraFacingQuad); a caller drawing a genuinely
    ' projected/oriented quad (e.g. SceneObjectCircle's fast path, issue #105) must check that
    ' condition itself first and fall back to the exact drawPinnedCorners warp otherwise.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {roRegion} regionObj the region to blit
    ' @param {BGE.Math.CornerPoints} quad the target quad to match
    ' @param {integer} color packed RGBA tint/fill color
    ' @return {boolean} true if the draw call succeeded
    protected function drawRegionAsRotatedQuad(rendererObj as BGE.Renderer, regionObj as roRegion, quad as BGE.Math.CornerPoints, color as integer) as boolean
      blit = m.getRotatedQuadBlit(quad)
      drawPos = quad.topLeft
      totalScaleX = 1.0 * blit.width / regionObj.getWidth()
      totalScaleY = 1.0 * blit.height / regionObj.getHeight()
      theta = blit.rotation
      ' Roku mirrors a region drawn at a negative scale around its draw position, so a
      ' mirrored quad still draws from topLeft, just flipped (issue #237).
      if quad.isMirroredOnCanvas()
        mirror = m.getMirroredBlitTransform(quad)
        if invalid = mirror
          ' Also rotated, which hardware can't mirror in one call
          return m.drawMirroredRegionRotated(rendererObj, regionObj, quad, totalScaleX, totalScaleY, theta, color)
        else if mirror.flipX
          theta = 0
          totalScaleX = -totalScaleX
        else
          theta = 0
          totalScaleY = -totalScaleY
        end if
      end if

      ' The quad may already have the region's pretranslation baked into it (true for
      ' directScaled - see updateCanvasPointsForCameraFacingQuad), and Roku's draw calls would
      ' apply it again - so zero it for the blit, the same way drawToTempBitmap does.
      preTransX = regionObj.getPretranslationX()
      preTransY = regionObj.getPretranslationY()
      regionObj.setPretranslation(0, 0)
      retVal = rendererObj.drawRegion(regionObj, drawPos.x, drawPos.y, totalScaleX, totalScaleY, -theta, color)
      regionObj.setPretranslation(preTransX, preTransY)
      return retVal
    end function


    ' Where drawRegionAsRotatedQuad() blits a region to match `quad`. drawRegion places a
    ' region by its *top left* corner, so that's what it has to be given - passing the
    ' quad's center draws the sprite half its own size down and to the right of where it
    ' belonged.
    '
    ' @param {BGE.Math.CornerPoints} quad
    ' @return {RotatedQuadBlit}
    protected function getRotatedQuadBlit(quad as BGE.Math.CornerPoints) as RotatedQuadBlit
      return {x: quad.topLeft.x, y: quad.topLeft.y, width: quad.getAvgWidth(), height: quad.getAvgHeight(), rotation: quad.getAvgRotation()}
    end function

    ' The canvas rectangle drawRegionAsRotatedQuad() paints for `quad`, in order around it.
    '
    ' @param {BGE.Math.CornerPoints} quad
    ' @return {BGE.Math.Vector[]} its 4 corners
    protected function getRotatedQuadPaintedCorners(quad as BGE.Math.CornerPoints) as BGE.Math.Vector[]
      blit = m.getRotatedQuadBlit(quad)
      ' the blit's top edge runs at its rotation, y down
      ux = cos(blit.rotation)
      uy = -sin(blit.rotation)
      ' the side edge runs toward the quad's bottom, which a mirrored quad has flipped
      vx = -uy
      vy = ux
      anchorX = blit.x
      anchorY = blit.y
      if quad.isMirroredOnCanvas()
        vx = uy
        vy = -ux
        if invalid = m.getMirroredBlitTransform(quad)
          ' drawMirroredRegionRotated() blits from the top right corner back along the top edge
          anchorX = quad.topRight.x
          anchorY = quad.topRight.y
          ux = -ux
          uy = -uy
        end if
      end if
      acrossX = ux * blit.width
      acrossY = uy * blit.width
      downX = vx * blit.height
      downY = vy * blit.height
      return [
        BGE.Math.VectorOps.create(anchorX, anchorY),
        BGE.Math.VectorOps.create(anchorX + acrossX, anchorY + acrossY),
        BGE.Math.VectorOps.create(anchorX + acrossX + downX, anchorY + acrossY + downY),
        BGE.Math.VectorOps.create(anchorX + downX, anchorY + downY)
      ]
    end function

    ' Blits a mirrored quad that is also rotated in two steps, since real hardware can't do
    ' both in one call (see getMirroredBlitTransform()): mirror the region into a scratch
    ' bitmap at a rotation of 0, then blit that at a positive scale. Mirroring it moves the
    ' region's left edge to the right, so it's drawn from the quad's topRight instead.
    private function drawMirroredRegionRotated(rendererObj as BGE.Renderer, regionObj as roRegion, quad as BGE.Math.CornerPoints, scaleX as float, scaleY as float, theta as float, color as integer) as boolean
      width = regionObj.getWidth()
      height = regionObj.getHeight()
      scratch = rendererObj.bmpPool.getRegion(width, height)
      if invalid = scratch
        return false
      end if
      preTransX = regionObj.getPretranslationX()
      preTransY = regionObj.getPretranslationY()
      regionObj.setPretranslation(0, 0)
      scratch.region.DrawScaledObject(width, 0, -1, 1, regionObj)
      regionObj.setPretranslation(preTransX, preTransY)
      mirrored = CreateObject("roRegion", scratch.getBitmapObject(), scratch.region.GetX(), scratch.region.GetY(), width, height)
      retVal = rendererObj.drawRegion(mirrored, quad.topRight.x, quad.topRight.y, scaleX, scaleY, -(theta + BGE.Math.PI), color)
      rendererObj.bmpPool.returnRegion(scratch)
      return retVal
    end function


    ' Strokes this object's outline onto the final canvas, on top of whatever has already
    ' been drawn for it. Only called when `Drawable.hasOutline()` is true and the draw mode
    ' isn't already outline-only.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean} true if the outline was drawn
    protected function drawOutlineToCanvas(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      outlinePoints = m.getOutlineCanvasPoints()
      if invalid = outlinePoints or outlinePoints.count() < 2
        return false
      end if
      return rendererObj.drawPolygonOutline(outlinePoints, m.getCanvasOutlineDrawColorRGBA(rendererObj), m.drawable.outlineWidth)
    end function


    ' The canvas points this object's outline is stroked along, in perimeter order - note
    ' that this is *not* the order `getAllCanvasPoints()` returns, which is bounds order
    ' (topLeft, topRight, bottomLeft, bottomRight) and traces a bowtie if stroked directly.
    ' Return `invalid` to opt out of outline drawing entirely, which is what a SceneObject
    ' whose shape isn't a single quad (e.g. `SceneObjectModel`) should do.
    '
    ' @return {BGE.Math.Vector[]} points to stroke along, or `invalid` for no outline
    protected function getOutlineCanvasPoints() as BGE.Math.Vector[]
      return m.canvasPoints.toClockwiseOutlineArray()
    end function


    ' Get the AA bounds of all points to be drawn on the final canvas
    ' @return {BGE.Math.Vector[]} the bounds of the canvas points
    protected function getCanvasBounds() as BGE.Math.Vector[]
      return BGE.Math.getBounds(m.getAllCanvasPoints())
    end function


    ' Get all canvas points
    '
    ' @return {BGE.Math.Vector[]}
    protected function getAllCanvasPoints() as BGE.Math.Vector[]
      return m.canvasPoints.toArray()
    end function


    ' Get the limit point mappings for the canvas points
    '
    ' @return {BGE.RendererHelpers.LimitPointMappings}
    private function getCanvasLimitPointMap() as BGE.RendererHelpers.LimitPointMappings
      return new BGE.RendererHelpers.LimitPointMappings(m.getAllCanvasPoints())
    end function

    private function getCurrentLimitPointsFromMap() as BGE.RendererHelpers.LimitPoints2d
      if rodash.isInvalid(m.limitPointMap)
        return invalid
      end if
      currentCanvasPoints = m.getAllCanvasPoints()

      if currentCanvasPoints.Count() <> m.limitPointMap.totalPointCount
        return invalid
      end if
      currentLimits = {
        top: currentCanvasPoints[m.limitPointMap.topIndex],
        left: currentCanvasPoints[m.limitPointMap.leftIndex],
        bottom: currentCanvasPoints[m.limitPointMap.bottomIndex],
        right: currentCanvasPoints[m.limitPointMap.rightIndex]
      }
      return currentLimits
    end function

    protected function getRegionWithIdToDraw(rendererObj as BGE.Renderer) as BGE.RendererHelpers.RegionWithId
      return invalid
    end function

    protected function drawToTempBitmap(rendererObj as BGE.Renderer, tempBitmap as ifDraw2d, canvasPointsTopLeftBound as BGE.Math.Vector, drawMode as SceneObjectDrawMode, allowFastDraw = false as boolean) as TempBitmapDrawResult
      if invalid = tempBitmap
        return {worked: false, didFastDraw: false}
      end if

      regionToDraw = m.getRegionWithIdToDraw(rendererObj)
      if invalid = regionToDraw or invalid = regionToDraw.region
        return {worked: false, didFastDraw: false}
      end if
      regionObj = regionToDraw.region
      preTransX = regionObj.getPretranslationX()
      preTransY = regionObj.getPretranslationY()
      offsetCanvasPoints = m.canvasPoints.subtract(canvasPointsTopLeftBound)
      regionObj.setPretranslation(0, 0)
      tempBmpDidDraw = rendererObj.drawPinnedCornersTo(tempBitmap, offsetCanvasPoints, regionToDraw, m.getPinnedCornersOptions(), m.getDrawColorRGBA(rendererObj))
      regionObj.setPretranslation(preTransX, preTransY)
      return {worked: tempBmpDidDraw, didFastDraw: false}
    end function

    protected function getPinnedCornersOptions() as DrawPinnedCornersOptions
      return {}
    end function

    protected function didRegionToDrawChange() as boolean
      return false
    end function

    protected function getDrawColorRGBA(rendererObj as BGE.Renderer, ignoreColor = false as boolean) as integer
      return m.applyShading(rendererObj, m.drawable.getFillColorRGBA(ignoreColor))
    end function

    ' For tests/telemetry only - the fill color actually used for the most recent draw,
    ' including the isShaded brightness adjustment (see applyShading()/ambientBrightness).
    '
    ' @param {BGE.Renderer} rendererObj
    ' @return {integer} packed RGBA color
    function getShadedColorRGBA(rendererObj as BGE.Renderer) as integer
      return m.getDrawColorRGBA(rendererObj)
    end function


    ' The outline stroke color, given the same shading treatment as the fill color.
    ' `Drawable.getOutlineColorRGBA` falls back to the fill color when no `outlineRGBA`
    ' has been set, which is what keeps the wireFrame draw modes looking the way they
    ' did before outlines were supported.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {boolean} [ignoreColor=false] ignore the drawable's own color and use white
    ' @return {integer} packed RGBA color to stroke with
    protected function getOutlineDrawColorRGBA(rendererObj as BGE.Renderer, ignoreColor = false as boolean) as integer
      return m.applyShading(rendererObj, m.drawable.getOutlineColorRGBA(ignoreColor))
    end function

    ' The fill color for a draw straight to the canvas: getDrawColorRGBA() with this
    ' object's draw-distance fade applied. Never use this for a temp-bitmap raster -
    ' the fade belongs on the blit, or the cached bitmap would have to be redrawn
    ' every frame the fade changes.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @return {integer} packed RGBA color
    protected function getCanvasDrawColorRGBA(rendererObj as BGE.Renderer) as integer
      return BGE.RendererHelpers.applyAlphaFade(m.getDrawColorRGBA(rendererObj), m.distanceFadeAlpha)
    end function

    ' The outline color for a draw straight to the canvas, faded like getCanvasDrawColorRGBA().
    '
    ' @param {BGE.Renderer} rendererObj
    ' @return {integer} packed RGBA color
    protected function getCanvasOutlineDrawColorRGBA(rendererObj as BGE.Renderer) as integer
      return BGE.RendererHelpers.applyAlphaFade(m.getOutlineDrawColorRGBA(rendererObj), m.distanceFadeAlpha)
    end function


    private function applyShading(rendererObj as BGE.Renderer, color as integer) as integer
      if not m.drawable.isShaded or invalid = m.surfaceNormal or invalid = m.worldPoints
        ' surfaceNormal is only computed for the oriented draw modes, so there is nothing
        ' to shade against in the direct ones
        return color
      end if
      return BGE.colorBrightness(color, BGE.Math.Max(getDotProductFromSurfaceToCamera(rendererObj, m.worldPoints.getCenter(), m.surfaceNormal), m.drawable.ambientBrightness))
    end function


    ' This object's total rotation about the z axis - its drawable's own rotation plus the
    ' rotation of the entity it's attached to. This is the only rotation component the
    ' direct (billboard) draw modes apply, since by definition they don't orient in 3D.
    '
    ' @return {float} rotation about z, in radians
    protected function getNetRotationZ() as float
      return m.drawable.rotation.z + m.drawable.getOwnerRotation().z
    end function

    protected override function updateWorldPosition(drawMode as SceneObjectDrawMode) as boolean
      if isScreenAlignedDrawMode(drawMode)
        ' Every billboard mode - including directScaled - is anchored at the drawable's own
        ' position and deliberately ignores its 3D orientation. directScaled builds its quad
        ' from the camera's own axes later, in updateCanvasPosition, since that's where the
        ' camera is available.
        m.worldPosition = m.drawable.getWorldPosition()

      else
        ' All oriented draw modes
        ' origin = BGE.Math.VectorOps.create()
        ' Unscaled size/pretranslation - m.transformationMatrix (built from offset, rotation,
        ' *and* scale) applies the drawable's scale when these corners are transformed below.
        ' Using getDrawnSize()/a pre-scaled pretranslation here as well applied scale twice.
        size = m.drawable.getSize()
        width = size.width
        height = size.height
        pretrans = m.drawable.getPretranslation()
        topLeft = BGE.Math.VectorOps.create(pretrans.x, -pretrans.y, 0)
        topRight = BGE.Math.VectorOps.add(topLeft, BGE.Math.VectorOps.create(width, 0, 0))
        bottomLeft = BGE.Math.VectorOps.add(topLeft, BGE.Math.VectorOps.create(0, -height, 0))
        bottomRight = BGE.Math.VectorOps.add(topLeft, BGE.Math.VectorOps.create(width, -height, 0))

        m.worldPoints.topLeft = BGE.Math.Matrix44.multVecMatrix(topLeft, m.transformationMatrix)
        m.worldPoints.topRight = BGE.Math.Matrix44.multVecMatrix(topRight, m.transformationMatrix)
        m.worldPoints.bottomLeft = BGE.Math.Matrix44.multVecMatrix(bottomLeft, m.transformationMatrix)
        m.worldPoints.bottomRight = BGE.Math.Matrix44.multVecMatrix(bottomRight, m.transformationMatrix)
        m.worldPosition = m.worldPoints.topLeft

        m.surfaceNormal = m.worldPoints.getNormal()
      end if
      return true
    end function


    override function getPositionForCameraDistance(drawMode as SceneObjectDrawMode) as BGE.Math.Vector
      if isScreenAlignedDrawMode(drawMode)
        return m.worldPosition
      end if
      return m.worldPoints.getCenter()
    end function

    protected override function getPositionsForFrustumCheck(drawMode as SceneObjectDrawMode) as BGE.Math.Vector[]
      if isScreenAlignedDrawMode(drawMode)
        return [m.worldPosition]
      end if
      return m.worldPoints.toArray()
    end function

    ' Its bounding points cover what it draws (see getPositionsForOcclusionTest()).
    '
    ' @return {boolean}
    override function canBeOccluded() as boolean
      return true
    end function

    ' A screen-aligned billboard doesn't draw in its own plane: directScaled is tested by the
    ' camera-facing quad it draws, and the fixed-pixel-size modes are never tested.
    protected override function getPositionsForOcclusionTest(cameraObj as Camera, drawMode as SceneObjectDrawMode) as BGE.Math.Vector[]
      if not isScreenAlignedDrawMode(drawMode)
        objType = m.type
        if objType = SceneObjectType.Bitmap or objType = SceneObjectType.Rectangle or objType = SceneObjectType.Circle
          ' the quad update() placed this frame, which is what it draws - getBoundingPoints() recomputes it
          return m.worldPoints.toArray()
        end if
        return m.getBoundingPointsThisFrame(cameraObj)
      end if
      size = m.getDirectModeCanvasSize()
      ' a polygon or model has no width/height of its own
      if drawMode <> BGE.SceneObjectDrawMode.directScaled or size.width = 0 or size.height = 0
        return invalid
      end if
      return m.getCameraFacingQuadWorldCorners(cameraObj)
    end function

    ' Computes this object's 4 world-space corners unconditionally, regardless of draw
    ' mode - the same pretranslation/size/transform math updateWorldPosition()'s
    ' oriented-mode branch already does, duplicated here rather than factored out
    ' since updateWorldPosition is a hot path best left alone.
    '
    ' Not itself a getBoundingPoints() override: the base SceneObject.getBoundingPoints()
    ' wrapper around getPositionsForFrustumCheck() deliberately collapses to a single
    ' point (m.worldPosition) in the screen-aligned draw modes - a correct, cheap
    ' optimization for frustum culling, where a billboard's anchor position is enough to
    ' tell whether it's even worth a closer look. But overlap detection (see
    ' BGE.DepthSort.groupIntoClusters) needs this object's actual extent, not just its
    ' anchor - a single point can never be found to overlap another shape, so every
    ' screen-aligned billboard (the common case for any 2D game, since Camera2d resolves
    ' matchCamera to directToCamera) would otherwise never cluster with anything no
    ' matter how much it visually overlaps.
    '
    ' A blanket override here would have been wrong, though: SceneObjectPolygon and
    ' SceneObjectModel also extend SceneObjectBillboard, but their drawables never set
    ' width/height (they stay at the base Drawable default of 0), and those two classes
    ' already have their own correct, multi-point getPositionsForFrustumCheck()
    ' overrides (m.polygonWorldPoints / m.modelWorldBounds) that the base class's
    ' getBoundingPoints() already delegates to correctly. So only the leaf classes whose
    ' drawable genuinely has a width/height - SceneObjectImage, SceneObjectRectangle,
    ' SceneObjectCircle, SceneObjectText - override getBoundingPoints() to call this.
    '
    ' @return {BGE.Math.Vector[]} the object's 4 world-space corners
    protected function computeBillboardWorldCorners() as BGE.Math.Vector[]
      size = m.drawable.getSize()
      width = size.width
      height = size.height
      pretrans = m.drawable.getPretranslation()
      ' they only depend on the transform and size, not the camera, so a still object's
      ' corners are reused while the camera moves
      cache = m.billboardCornersCache
      if invalid <> cache and cache.transformVersion = m.transformVersion and cache.width = width and cache.height = height and cache.pretransX = pretrans.x and cache.pretransY = pretrans.y
        return cache.corners
      end if
      topLeft = BGE.Math.VectorOps.create(pretrans.x, -pretrans.y, 0)
      topRight = BGE.Math.VectorOps.add(topLeft, BGE.Math.VectorOps.create(width, 0, 0))
      bottomLeft = BGE.Math.VectorOps.add(topLeft, BGE.Math.VectorOps.create(0, -height, 0))
      bottomRight = BGE.Math.VectorOps.add(topLeft, BGE.Math.VectorOps.create(width, -height, 0))

      corners = [
        BGE.Math.Matrix44.multVecMatrix(topLeft, m.transformationMatrix),
        BGE.Math.Matrix44.multVecMatrix(topRight, m.transformationMatrix),
        BGE.Math.Matrix44.multVecMatrix(bottomLeft, m.transformationMatrix),
        BGE.Math.Matrix44.multVecMatrix(bottomRight, m.transformationMatrix)
      ]
      m.billboardCornersCache = {transformVersion: m.transformVersion, width: width, height: height, pretransX: pretrans.x, pretransY: pretrans.y, corners: corners}
      return corners
    end function

    protected override function findCanvasPosition(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      result = m.updateCanvasPosition(rendererObj, drawMode)
      ' A screen-aligned billboard has no face to turn away from the camera, so it never gets
      ' a mirror flag and is never backface culled.
      if result and not isScreenAlignedDrawMode(drawMode)
        m.computeNormalDebugInfo(rendererObj)
        m.isMirror = false
        if invalid <> m.surfaceNormal
          worldCenter = m.worldPoints.getCenter()
          if not isNormalFacingCamera(rendererObj, worldCenter, m.surfaceNormal)
            m.isMirror = true
          end if
        end if
      end if
      return result
    end function


    protected function updateCanvasPosition(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      if isDirectDrawMode(drawMode)
        worldPos = m.worldPosition
        if m.needsManualPretranslationForDirectMode()
          pretrans = m.drawable.getPretranslation()
          worldPos = BGE.Math.VectorOps.add(worldPos, BGE.Math.VectorOps.create(
          pretrans.x * m.drawable.scale.x, -pretrans.y * m.drawable.scale.y, 0))
        end if
        m.canvasPosition = rendererObj.worldPointToCanvasPoint(worldPos)
        if invalid = m.canvasPosition
          return false
        end if
        if m.needsCanvasCornerPoints()
          m.updateCanvasPointsForDirectMode()
        end if
      else if drawMode = BGE.SceneObjectDrawMode.directScaled
        m.canvasPosition = rendererObj.worldPointToCanvasPoint(m.worldPosition)
        if invalid = m.canvasPosition
          return false
        end if
        return m.updateCanvasPointsForCameraFacingQuad(rendererObj)
      else if isOrientedDrawMode(drawMode)
        index = 0
        for each corner in m.worldPoints.toArray()
          canvasPoint = rendererObj.worldPointToCanvasPoint(corner)
          if invalid = canvasPoint
            return false
          end if
          m.canvasPoints.setPointByIndex(index, canvasPoint)
          index++
        end for
      end if
      return true
    end function


    ' Whether the four canvas corner points are needed in the direct (billboard) draw
    ' modes, which otherwise get by with the single `canvasPosition`. Computing them isn't
    ' free, so it's opt-in: outlines are stroked along those corners, so anything with an
    ' outline needs them. Override to require them for other reasons too.
    '
    ' @return {boolean}
    protected function needsCanvasCornerPoints() as boolean
      return m.drawable.hasOutline()
    end function


    ' Whether this object's plain 2D draw path (directToCamera/matchCamera) needs its
    ' anchor applied by hand here, rather than getting it for free some other way. True for
    ' anything with no native roRegion to lean on (DrawableRectangle, DrawableText) - false
    ' (the default) for anything backed by a region (SceneObjectImage), since Roku's own
    ' DrawObject/DrawScaledObject already apply the region's pretranslation natively.
    '
    ' @return {boolean}
    protected function needsManualPretranslationForDirectMode() as boolean
      return false
    end function


    ' The top-left canvas point this billboard's screen-aligned (direct/directScaled) draw
    ' modes last positioned at, or `invalid` before the first successful draw.
    '
    ' @return {BGE.Math.Vector}
    function getCanvasPosition() as BGE.Math.Vector
      return m.canvasPosition
    end function


    ' The world-space corner points this billboard's oriented draw modes last computed.
    '
    ' @return {BGE.Math.CornerPoints}
    override function getWorldPoints() as BGE.Math.CornerPoints
      return m.worldPoints
    end function


    ' The canvas corner points this billboard last computed - populated for a rotated or
    ' outlined direct-mode object (see needsCanvasCornerPoints()), or any oriented one.
    '
    ' @return {BGE.Math.CornerPoints}
    function getCanvasPoints() as BGE.Math.CornerPoints
      return m.canvasPoints
    end function


    ' Lays the four canvas corner points out around `canvasPosition` for the direct
    ' (billboard) draw modes, which draw a screen-aligned quad rather than projecting each
    ' world corner through the camera the way the oriented draw modes do (see
    ' `updateCanvasPosition`). `canvasPosition` is the quad's top left corner and the point
    ' any rotation pivots around, matching how `drawToCanvas` blits the region.
    protected sub updateCanvasPointsForDirectMode()
      canvasSize = m.getDirectModeCanvasSize()
      ' negated to match the sign convention drawToCanvas passes to Renderer.drawRegion,
      ' since canvas space is y-down while world rotations are y-up
      theta = -m.getNetRotationZ()
      cosTheta = cos(theta)
      sinTheta = sin(theta)
      cornerOffsets = [
        [0, 0],
        [canvasSize.width, 0],
        [0, canvasSize.height],
        [canvasSize.width, canvasSize.height]
      ]
      index = 0
      for each offset in cornerOffsets
        dX = offset[0]
        dY = offset[1]
        m.canvasPoints.setPointByIndex(index, BGE.Math.VectorOps.create(
        m.canvasPosition.x + dX * cosTheta - dY * sinTheta,
        m.canvasPosition.y + dX * sinTheta + dY * cosTheta))
        index++
      end for
    end sub


    ' Builds this object's quad in the plane the camera is looking at, then projects it - which
    ' is what makes `directScaled` a Doom-style sprite: it faces the camera by construction, it
    ' shrinks purely with distance because its corners are offset by *world* units before being
    ' projected, and it is completely independent of the object's own rotation. (Deriving the
    ' on-screen size from the object's own projected quad instead would fold its orientation
    ' into its size, so a sprite turned edge-on would squash - never what a billboard wants.)
    '
    ' The quad is anchored at its **top left** corner, exactly as `directToCamera` anchors the
    ' region it blits - so an object switched between the two billboard modes stays put, and
    ' only its size changes.
    '
    ' @param {Renderer} rendererObj
    ' @return {boolean} true if every corner projected onto the canvas
    protected function updateCanvasPointsForCameraFacingQuad(rendererObj as Renderer) as boolean
      corners = m.getCameraFacingQuadWorldCorners(rendererObj.camera)
      if rendererObj.camera.name = "Camera3d"
        ' the same canvas points as worldPointToCanvasPoint(), in one cheaper pass
        projected = m.cameraFacingProjected
        if not (rendererObj.camera as Camera3d).projectPointsWithDepth(corners, projected)
          return false
        end if
        canvasPoints = m.canvasPoints
        m.setCanvasCorner(canvasPoints.topLeft, projected, 0)
        m.setCanvasCorner(canvasPoints.topRight, projected, 3)
        m.setCanvasCorner(canvasPoints.bottomLeft, projected, 6)
        m.setCanvasCorner(canvasPoints.bottomRight, projected, 9)
        return true
      end if
      index = 0
      for each cornerWorldPoint in corners
        canvasPoint = rendererObj.worldPointToCanvasPoint(cornerWorldPoint)
        if invalid = canvasPoint
          return false
        end if
        m.canvasPoints.setPointByIndex(index, canvasPoint)
        index++
      end for
      return true
    end function

    private sub setCanvasCorner(corner as BGE.Math.Vector, projected as float[], offset as integer)
      corner.x = projected[offset]
      corner.y = projected[offset + 1]
      corner.z = 0
    end sub

    ' The world corners of the camera-facing quad directScaled draws - see
    ' updateCanvasPointsForCameraFacingQuad().
    '
    ' @param {Camera} cameraObj
    ' @return {BGE.Math.Vector[]} top left, top right, bottom left, bottom right
    protected function getCameraFacingQuadWorldCorners(cameraObj as Camera) as BGE.Math.Vector[]
      ' getRightVector()/getUpVector() are roll-aware (rotated by the camera's own
      ' rollDegrees) - building the quad from them and then projecting through that
      ' same rolled camera necessarily cancels the roll back out, which is exactly what
      ' makes directScaled screen-aligned/roll-immune by default (see banksWithCameraRoll's
      ' doc comment on Drawable). Substituting the *level* (unrolled) vectors here instead
      ' means the quad's own geometry no longer "pre-cancels" the roll, so the camera's
      ' actual (rolled) projection of each independently-computed corner introduces the
      ' correct on-screen rotation - the same effect a real object planted in the world
      ' (the ground plane, built from plain world coordinates) already gets for free.
      if m.drawable.banksWithCameraRoll and cameraObj.name = "Camera3d"
        camera3d = cameraObj as Camera3d
        right = camera3d.getLevelRightVector()
        up = camera3d.getLevelUpVector()
      else
        right = cameraObj.getRightVector()
        up = cameraObj.getUpVector()
      end if

      worldSize = m.getDirectModeCanvasSize()

      acrossWorld = BGE.Math.VectorOps.scale(right, worldSize.width)
      downWorld = BGE.Math.VectorOps.scale(up, -worldSize.height)

      ' Anchoring, expressed the way the oriented modes express it (see updateWorldPosition):
      ' the pretranslation shifts the top left corner, right by x and *down* by y. For an Image
      ' that value comes from its region, which is how a sprite atlas's pivot reaches us (see
      ' BGE.getRegionsFromAtlas). Baked into the quad here rather than left to the blit, so the
      ' quad describes where the object actually lands - the outline hook and
      ' SceneObjectRectangle both measure off it. drawToCanvas zeroes it on the region for the
      ' blit itself so it isn't applied a second time.
      pretrans = m.drawable.getPretranslation()
      ownerScale = m.drawable.getOwnerScale()
      totalScaleX = m.drawable.scale.x * ownerScale.x
      totalScaleY = m.drawable.scale.y * ownerScale.y
      anchorOffset = BGE.Math.VectorOps.subtract(
      BGE.Math.VectorOps.scale(right, pretrans.x * totalScaleX),
      BGE.Math.VectorOps.scale(up, pretrans.y * totalScaleY))

      topLeft = BGE.Math.VectorOps.add(m.worldPosition, anchorOffset)
      return [
        topLeft,
        BGE.Math.VectorOps.add(topLeft, acrossWorld),
        BGE.Math.VectorOps.add(topLeft, downWorld),
        BGE.Math.VectorOps.add(BGE.Math.VectorOps.add(topLeft, acrossWorld), downWorld)
      ]
    end function


    ' The on-canvas size of this object in the direct (billboard) draw modes - its drawn
    ' size scaled by the owning entity, matching the scale `drawToCanvas` applies to the
    ' region it blits.
    '
    ' @return {SizeWH}
    protected function getDirectModeCanvasSize() as SizeWH
      drawnSize = m.drawable.getDrawnSize()
      ownerScale = m.drawable.getOwnerScale()
      return {
        width: drawnSize.width * ownerScale.x,
        height: drawnSize.height * ownerScale.y
      }
    end function


    protected sub computeNormalDebugInfo(rendererObj as Renderer)
      game = m.drawable.getGame()
      if invalid <> game and isTrue(game.getDebugValue("draw_scene_object_normals")) and invalid <> m.surfaceNormal and invalid <> m.worldPoints
        ' normalCenter = m.getNormalDebugPoint()
        worldCenter = m.worldPoints.getCenter()
        m.normalOnCanvasStart = rendererObj.worldPointToCanvasPoint(worldCenter)
        worldNormalEnd = BGE.Math.VectorOps.subtract(worldCenter, BGE.Math.VectorOps.scale(m.surfaceNormal, 100))
        m.normalOnCanvasEnd = rendererObj.worldPointToCanvasPoint(worldNormalEnd)
      else
        m.normalOnCanvasStart = invalid
        m.normalOnCanvasEnd = invalid
      end if
    end sub

    protected function getNormalDebugPoint() as BGE.Math.Vector
      return m.worldPoints.getCenter()
    end function


    ' Determine if we can just scale and/or rotate the temp bitmap to match the required position
    ' @param {Renderer} renderObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {TransformTempBitmapDetails} the details of the transformation or invalid if it cannot be done
    protected function attemptTransformTempBitmap(renderObj as Renderer, drawMode as SceneObjectDrawMode) as TransformTempBitmapDetails
      if m.drawsOccluderExactly()
        return invalid
      end if
      if rodash.isInvalid(m.tempBitmap) or rodash.isInvalid(m.tempBitmapRegion) or rodash.isInvalid(m.limitPointMap) or not m.usesTempBitmap(drawMode)
        return invalid
      end if

      if m.limitPointMap.height = invalid or m.limitPointMap.height < 2 or m.limitPointMap.width = invalid or m.limitPointMap.width < 2
        return invalid
      end if

      currentLimits = m.getCurrentLimitPointsFromMap()

      if rodash.isInvalid(currentLimits)
        return invalid
      end if

      rotationDelta = m.limitPointMap.getAngleBaseLineDifference(currentLimits)

      ' rotate the current points to be axis aligned, so we can get the mappedOrigin - this allows us to read x & y sclaes
      currentBackRotationMatrix = BGE.Math.getTransformationMatrix(BGE.Math.VectorOps.create(),
      BGE.Math.VectorOps.create(0, 0, rotationDelta),
      BGE.Math.VectorOps.create(1, 1)
      )
      backRotatedCurrent = {
        left: BGE.Math.Matrix44.multVecMatrix(currentLimits.left, currentBackRotationMatrix),
        top: BGE.Math.Matrix44.multVecMatrix(currentLimits.top, currentBackRotationMatrix),
        right: BGE.Math.Matrix44.multVecMatrix(currentLimits.right, currentBackRotationMatrix),
        bottom: BGE.Math.Matrix44.multVecMatrix(currentLimits.bottom, currentBackRotationMatrix)
      } as BGE.RendererHelpers.LimitPoints2d

      d = backRotatedCurrent.left.y - backRotatedCurrent.top.y ' distance From MappedOrigin To CurrentLeft
      reRotation = BGE.Math.HALF_PI - rotationDelta
      ' get the mapped origin by applying the distance From MappedOrigin To CurrentLeft
      mappedOrigin = BGE.Math.VectorOps.create(currentLimits.left.x + d * cos(-reRotation), currentLimits.left.y + d * sin(-reRotation))

      newVertScale = abs(backRotatedCurrent.top.y - backRotatedCurrent.bottom.y) / m.limitPointMap.height
      newHorizScale = (backRotatedCurrent.right.x - backRotatedCurrent.left.x) / m.limitPointMap.width

      originDelta = BGE.Math.VectorOps.subtract(mappedOrigin, m.limitPointMap.origin)
      ' compare canvas points vs. scaled points from mappedOrigin

      tempTranslationTransformMatrix = BGE.Math.getTransformationMatrix(
      originDelta,
      BGE.Math.VectorOps.create(0, 0, rotationDelta),
      BGE.Math.VectorOps.create(newHorizScale, newVertScale)
      )
      transformedLeft = BGE.Math.Matrix44.multVecMatrix(m.limitPointMap.left, tempTranslationTransformMatrix)
      transformedTop = BGE.Math.Matrix44.multVecMatrix(m.limitPointMap.top, tempTranslationTransformMatrix)

      transformedRight = BGE.Math.Matrix44.multVecMatrix(m.limitPointMap.right, tempTranslationTransformMatrix)
      transformedBottom = BGE.Math.Matrix44.multVecMatrix(m.limitPointMap.bottom, tempTranslationTransformMatrix)

      topDelta = BGE.Math.VectorOps.manhattanLength(BGE.Math.VectorOps.subtract(transformedTop, currentLimits.top))
      leftDelta = BGE.Math.VectorOps.manhattanLength(BGE.Math.VectorOps.subtract(transformedLeft, currentLimits.left))
      rightDelta = BGE.Math.VectorOps.manhattanLength(BGE.Math.VectorOps.subtract(transformedRight, currentLimits.right))
      bottomDelta = BGE.Math.VectorOps.manhattanLength(BGE.Math.VectorOps.subtract(transformedBottom, currentLimits.bottom))

      ' totalDifference = topDelta + leftDelta + rightDelta + bottomDelta
      maxDifference = BGE.Math.arrayMax([topDelta, leftDelta, rightDelta, bottomDelta])
      if maxDifference < m.getTempBitmapThreshold(drawMode)
        ' if the difference is small enough, we can use the temp bitmap
        return {
          origin: mappedOrigin,
          rotation: rotationDelta,
          scaleX: newHorizScale,
          scaleY: newVertScale
        }
      end if

      return invalid
    end function



    ' Is this a back and then we should not draw it?
    '
    ' @param {SceneObjectDrawMode} drawMode - some drawModes explicitly should draw the backface
    ' @return {boolean} true if we should not draw
    protected function doNotDrawBecauseBackFace(drawMode as SceneObjectDrawMode) as boolean
      return m.isCulledAsBackFace(m.isMirror, drawMode)
    end function

    ' Whether a quad is skipped as a back face in `drawMode`, given whether it faces away.
    '
    ' @param {boolean} facesAway
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    private function isCulledAsBackFace(facesAway as boolean, drawMode as SceneObjectDrawMode) as boolean
      if facesAway
        if drawMode = SceneObjectDrawMode.orientedDrawBackFace or drawMode = SceneObjectDrawMode.wireFrameDrawBackFace
          return false
        end if
        return true
      end if
      return false
    end function

    ' Adds this quad's canvas polygon when it qualifies as an occluder this frame and all
    ' four corners project - see SceneObject.appendOccluderPolygons().
    '
    ' @param {Renderer} rendererObj
    ' @param {BGE.OccluderPolygon[]} out
    override function appendOccluderPolygons(rendererObj as Renderer, out as BGE.OccluderPolygon[]) as void
      if not m.canOccludeThisFrame(rendererObj)
        return
      end if
      drawMode = m.getOccluderDrawMode(rendererObj)
      ' the same facing test findCanvasPosition() feeds the draw path's backface cull
      facesAway = invalid <> m.surfaceNormal and not isNormalFacingCamera(rendererObj, m.worldPoints.getCenter(), m.surfaceNormal)
      if m.isCulledAsBackFace(facesAway, drawMode)
        return
      end if
      ' projected the way updateCanvasPosition() will project it for this frame's draw
      projected = m.occluderProjectionScratch
      if not (rendererObj.camera as Camera3d).projectPointsWithDepth(m.worldPoints.toArray(), projected)
        return
      end if
      canvasQuad = new BGE.Math.CornerPoints()
      depth = 0.0
      for index = 0 to 3
        canvasQuad.setPointByIndex(index, BGE.Math.VectorOps.create(projected[index * 3], projected[index * 3 + 1]))
        depth = BGE.Math.Max(depth, projected[index * 3 + 2])
      end for
      polygon = m.getOccluderClaim(rendererObj, drawMode, canvasQuad, depth)
      if invalid <> polygon
        out.push(polygon)
      end if
    end function

    ' The part of this frame's canvas quad the draw is guaranteed to paint: the quad, shrunk
    ' by the worst error of any approximate draw path that may run this frame.
    '
    ' @param {Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @param {BGE.Math.CornerPoints} canvasQuad this frame's projected corners
    ' @param {float} depth the farthest corner's distance from the camera
    ' @return {BGE.OccluderPolygon} invalid if nothing is guaranteed
    protected function getOccluderClaim(rendererObj as Renderer, drawMode as SceneObjectDrawMode, canvasQuad as BGE.Math.CornerPoints, depth as float) as BGE.OccluderPolygon
      return m.newOccluderPolygon(canvasQuad.toClockwiseOutlineArray(), depth, m.getOccluderInset(rendererObj, drawMode))
    end function

    ' How far this frame's draw may fall short of the exact quad: the temp-bitmap reuse
    ' threshold when that reuse may run, plus any coarse fill.
    '
    ' @param {Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {float}
    protected override function getOccluderInset(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as float
      ' reuse and coarse fills only happen while the object moves relative to the camera
      if not m.shrinksOccluderClaim() or not m.objMovedInRelationToCamera(rendererObj.camera)
        return 0.0
      end if
      inset = m.getCoarseFillInset(rendererObj, drawMode)
      if m.mayReuseTransformedTempBitmap(drawMode)
        ' the reused bitmap may itself hold a coarse fill
        inset += m.getTempBitmapThreshold(drawMode)
      end if
      return inset
    end function

    ' How far a coarse fill drawn while moving may fall short of the exact shape. 0 for
    ' a type that never draws one.
    '
    ' @param {Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {float}
    protected function getCoarseFillInset(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as float
      return 0.0
    end function

    ' Whether attemptTransformTempBitmap() could reuse the cached temp bitmap this frame,
    ' judged from what's cached before the draw.
    '
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected function mayReuseTransformedTempBitmap(drawMode as SceneObjectDrawMode) as boolean
      return m.useTempBitmapMap[drawMode] and invalid <> m.tempBitmap and invalid <> m.tempBitmapRegion and invalid <> m.limitPointMap
    end function

    ' Projects a convex world-space outline to an occluder polygon.
    '
    ' @param {Renderer} rendererObj
    ' @param {BGE.Math.Vector[]} worldOutline the polygon's vertices, in order around it
    ' @param {float} [inset=0] how far to shrink it, in canvas pixels
    ' @return {BGE.OccluderPolygon} invalid if any vertex doesn't project, or the inset collapses it
    protected function projectOccluderPolygon(rendererObj as Renderer, worldOutline as BGE.Math.Vector[], inset = 0 as float) as BGE.OccluderPolygon
      projected = [] as float[]
      if not (rendererObj.camera as Camera3d).projectPointsWithDepth(worldOutline, projected)
        return invalid
      end if
      xs = [] as float[]
      ys = [] as float[]
      depth = 0.0
      for i = 0 to projected.count() - 1 step 3
        xs.push(projected[i] * 1.0)
        ys.push(projected[i + 1] * 1.0)
        depth = BGE.Math.Max(depth, projected[i + 2])
      end for
      return m.newOccluderPolygonFromXY(xs, ys, depth, inset)
    end function

    ' An occluder polygon from a convex canvas outline, shrunk by `inset`.
    '
    ' @param {BGE.Math.Vector[]} canvasOutline vertices in order around it
    ' @param {float} depth the farthest vertex's distance from the camera
    ' @param {float} inset how far to shrink it, in canvas pixels
    ' @return {BGE.OccluderPolygon} invalid if the inset collapses it
    protected function newOccluderPolygon(canvasOutline as BGE.Math.Vector[], depth as float, inset as float) as BGE.OccluderPolygon
      xs = [] as float[]
      ys = [] as float[]
      for each point in canvasOutline
        xs.push(point.x * 1.0)
        ys.push(point.y * 1.0)
      end for
      return m.newOccluderPolygonFromXY(xs, ys, depth, inset)
    end function

    ' newOccluderPolygon() from separate x and y lists, which it may keep.
    protected function newOccluderPolygonFromXY(xs as float[], ys as float[], depth as float, inset as float) as BGE.OccluderPolygon
      if inset > 0
        shrunk = BGE.Occlusion.insetConvexPolygon(xs, ys, inset)
        if invalid = shrunk
          return invalid
        end if
        xs = shrunk.xs
        ys = shrunk.ys
      end if
      return {xs: xs, ys: ys, depth: depth, area: BGE.Occlusion.getPolygonArea(xs, ys)}
    end function

    ' A backface cull and an in-frustum-but-entirely-off-canvas rejection are both
    ' deterministic for a billboard: neither depends on anything beyond this object's own
    ' orientation/position relative to the camera and canvas, both of which are exactly
    ' what triggers a recheck in the first place (see objMovedInRelationToCamera() /
    ' geometryChanged()). Recomputing doNotDrawBecauseBackFace() here is cheap (it's
    ' already just read from m.isMirror, computed once per findCanvasPosition() call) and
    ' isBoundingBoxOutsideCanvas() is a plain bounding-box test against points already
    ' computed for this draw - neither repeats the actual (expensive) frustum check. See
    ' issue #73.
    '
    ' @param {Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected override function isDeterministicDrawFailure(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      return m.doNotDrawBecauseBackFace(drawMode) or rendererObj.isBoundingBoxOutsideCanvas(m.getAllCanvasPoints())
    end function


    protected function getTempBitmapThreshold(drawMode as SceneObjectDrawMode) as integer
      return 16
    end function

  end class

end namespace
