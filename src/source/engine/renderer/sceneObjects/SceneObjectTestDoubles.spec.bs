namespace tests

  ' Test-only SceneObject subclasses. This file deliberately contains no @suite - Rooibos
  ' allows only one @suite per file, and these are shared across suites.
  '
  ' A transient draw failure (a scratch bitmap that couldn't be allocated, a corner that
  ' failed to project) can't be induced through the public API, so this fakes one: it is
  ' the only way to cover the recovery path in SceneObject.draw().
  class FailingSceneObjectImage extends BGE.SceneObjectImage

    ' While true, every draw attempt fails as though the real draw call had failed.
    public shouldFail = true

    ' How many times draw() has got as far as calling performDraw(). This is what the
    ' recovery test asserts on: it counts attempts rather than the renderer's draw calls
    ' because performDraw is faked here and never puts pixels anywhere. Real drawing
    ' recovering after a real cull is covered by the camera field-of-view test.
    public drawAttempts = 0

    ' An explicit constructor with fully-qualified parameter types is required, not
    ' stylistic: bsc 1.0.0-alpha.52 synthesizes an implicit constructor using the parent's
    ' parameter types verbatim and *unqualified*, so `drawableObj as Image` lands in
    ' `namespace tests` where bare `Image` doesn't resolve, and transpile dies with
    ' "Cannot read properties of undefined (reading 'toTypeString')".
    sub new(name as string, drawableObj as BGE.Image)
      super(name, drawableObj)
    end sub

    ' Deliberately does not delegate to super.performDraw(): bsc 1.0.0-alpha.52 rejects
    ' that with member-access-violation even though this class is a subclass of the
    ' SceneObjectBillboard that declares it.
    protected override function performDraw(rendererObj as BGE.Renderer, drawMode as BGE.SceneObjectDrawMode) as boolean
      m.drawAttempts++
      return not m.shouldFail
    end function

  end class

end namespace
