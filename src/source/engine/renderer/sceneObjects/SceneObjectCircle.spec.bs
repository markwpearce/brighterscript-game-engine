namespace tests

  ' SceneObjectCircle's fill is inherited, untested-here SceneObjectBillboard machinery
  ' (identical to SceneObjectImage). getRegionWithIdToDraw()/getOutlineCanvasPoints() are
  ' both protected extension-point hooks (not public API, matching every other
  ' SceneObject*), so - following SceneObjectRectangle.spec.bs's own convention - these
  ' tests only exercise them indirectly, through the public draw()/getCanvasPoints()
  ' surface: draw call counts confirm the fill/outline actually draw something, and
  ' getCanvasPoints (populated once an outline forces needsCanvasCornerPoints() to compute
  ' real corners) confirms the circle's bounding quad matches its diameter.
  @suite("BGE.SceneObjectCircle")
  class SceneObjectCircleTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 200, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap)
      ' The default Camera2d centers on its canvas, so world (100, 100) is canvas (100, 100)
      ' and a 20-radius circle anchored there lands well inside the 200x200 bitmap.
      m.entity.position = BGE.Math.VectorOps.create(100, 100, 0)
      ' Warm the renderer's lazily-built circle resource (see Renderer.getCircleResource())
      ' up front - building it involves its own internal draw calls, which would otherwise
      ' pollute the draw-call-count assertions below on whichever test draws a circle first.
      m.renderer.getCircleResource()
    end function

    @describe("drawable field")

    @it("is set by direct construction, not just via addToScene (issue #69)")
    function _()
      circle = new BGE.DrawableCircle(m.entity, 20)
      sceneObj = new BGE.SceneObjectCircle("test", circle)
      m.assertNotInvalid(sceneObj.drawable)
    end function

    ' Registers the circle with the renderer and runs one frame of update+draw for it,
    ' returning how many draw calls that took.
    private function drawOnce(circle as BGE.DrawableCircle) as integer
      sceneObj = circle.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.resetDrawCallCounter()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)
      return m.renderer.getDrawCallsLastFrame()
    end function

    @describe("fill")

    @it("draws the circle's texture")
    function _()
      m.assertTrue(m.drawOnce(new BGE.DrawableCircle(m.entity, 20)) > 0)
    end function

    @describe("outline")

    @it("draws more than a circle with no outline, since the outline is stroked on top")
    function _()
      noOutlineDrawCalls = m.drawOnce(new BGE.DrawableCircle(m.entity, 20))
      withOutlineDrawCalls = m.drawOnce(new BGE.DrawableCircle(m.entity, 20, {outlineRGBA: BGE.ColorsRGB.Red}))
      m.assertTrue(withOutlineDrawCalls > noOutlineDrawCalls)
    end function

    @describe("solid draw mode")

    @it("draws the circular texture instead of the base class's plain quad fill")
    function _()
      ' Regression guard: solid draw modes don't use a temp bitmap (see
      ' useTempBitmapMap), so the base class's own drawToCanvas branch for
      ' isSolidDrawMode() draws the raw 4-corner quad directly - a square, not a
      ' circle. SceneObjectCircle routes solid mode through drawPinnedCorners with its
      ' own circular region instead.
      circle = new BGE.DrawableCircle(m.entity, 20, {drawMode: BGE.SceneObjectDrawMode.solid})
      m.assertTrue(m.drawOnce(circle) > 0)
    end function

    @describe("wireFrame draw mode")

    @it("draws its own circular outline even with no outlineRGBA set, using the fill color fallback")
    function _()
      ' Regression guard: the base class's own wireFrame branch strokes the plain
      ' 4-corner quad directly (a square), bypassing getOutlineCanvasPoints() entirely -
      ' SceneObjectCircle overrides drawToCanvas to route wireFrame through
      ' drawOutlineToCanvas()/getOutlineCanvasPoints() instead, the same way
      ' SceneObjectRectangle does, so this must still draw something even with no
      ' outline color explicitly set (Drawable.getOutlineColorRGBA falls back to the
      ' fill color).
      circle = new BGE.DrawableCircle(m.entity, 20, {drawMode: BGE.SceneObjectDrawMode.wireFrame})
      m.assertTrue(m.drawOnce(circle) > 0)
    end function

    @describe("getCanvasPoints")

    @it("spans exactly the circle's diameter, since an outline forces real corner points")
    function _()
      circle = new BGE.DrawableCircle(m.entity, 20, {outlineRGBA: BGE.ColorsRGB.Red})
      sceneObj = circle.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)

      canvasPoints = (sceneObj as BGE.SceneObjectCircle).getCanvasPoints()
      width = canvasPoints.topRight.x - canvasPoints.topLeft.x
      m.assertEqual(40.0, width)
    end function

  end class

end namespace
