namespace BGE

  class SceneObjectLine extends SceneObject

    drawable as DrawableLine

    private worldStart as BGE.Math.Vector = BGE.Math.VectorOps.create()
    private worldEnd as BGE.Math.Vector = BGE.Math.VectorOps.create()
    private canvasStart as BGE.Math.Vector = BGE.Math.VectorOps.create()
    private canvasEnd as BGE.Math.Vector = BGE.Math.VectorOps.create()

    sub new(name as string, drawableObj as DrawableLine)
      super(name, drawableObj, BGE.SceneObjectType.Line)
      ' Redeclaring `drawable` above auto-inits it to invalid after super() - this wins since it runs last (issue #69).
      m.drawable = drawableObj
    end sub


    protected override function updateWorldPosition(drawMode as SceneObjectDrawMode) as boolean
      if m.drawable.movedLastFrame(true) or invalid = m.worldStart or invalid = m.worldEnd
        m.worldStart = BGE.Math.Matrix44.multVecMatrix(m.drawable.startPosition, m.transformationMatrix)
        m.worldEnd = BGE.Math.Matrix44.multVecMatrix(m.drawable.endPosition, m.transformationMatrix)
      end if

      return true
    end function


    protected override function getPositionsForFrustumCheck(drawMode as SceneObjectDrawMode) as BGE.Math.Vector[]
      return [m.worldStart, m.worldEnd]
    end function

    ' getPositionsForFrustumCheck() above always returns exactly 2 points, so this
    ' object's hull can never reach BGE.DepthSort.MIN_VALID_HULL_POINTS - see the base
    ' class's doc comment for why that means this is a pure cost avoidance, not a
    ' tolerated visual error.
    override function participatesInOverlapDetection() as boolean
      return false
    end function

    override function getPositionForCameraDistance(drawMode as SceneObjectDrawMode) as BGE.Math.Vector
      return BGE.Math.midPointBetweenPoints(m.worldStart, m.worldEnd)
    end function

    protected override function findCanvasPosition(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      m.canvasStart = rendererObj.worldPointToCanvasPoint(m.worldStart)
      m.canvasEnd = rendererObj.worldPointToCanvasPoint(m.worldEnd)
      return true
    end function

    protected override function performDraw(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      if m.canvasStart = invalid or m.canvasEnd = invalid
        return false
      else
        return rendererObj.drawLine(m.canvasStart.x, m.canvasStart.y, m.canvasEnd.x, m.canvasEnd.y, m.drawable.getFillColorRGBA())
      end if
    end function

  end class

end namespace
