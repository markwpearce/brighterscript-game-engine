namespace tests

  ' Coverage for an Image going through the draw modes. The rectangle specs cover
  ' SceneObjectRectangle's own paths; this covers the inherited SceneObjectBillboard
  ' ones an image actually uses - in particular `oriented`, which is what a Camera3d
  ' resolves `matchCamera` to, and so the mode nearly every 3D sprite renders in.
  @suite("BGE.SceneObjectImage")
  class SceneObjectImageTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 200, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap, m.game, new BGE.Camera3d())
      ' in front of the camera, which starts at (0, 0, 1000) looking down -z
      m.entity.position = BGE.Math.VectorOps.create(0, 0, 0)
    end function

    private function newImage(args = {} as roAssociativeArray) as BGE.Image
      sourceBitmap = CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: true})
      region = CreateObject("roRegion", sourceBitmap, 0, 0, 64, 64)
      return new BGE.Image(m.entity, region, args)
    end function

    ' Registers the image and renders one frame, reporting the draw calls it took.
    ' Mirrors what the Game loop does per frame - setupCameraForFrame() then drawScene() -
    ' rather than calling a SceneObject's update/draw directly. drawScene() does *not*
    ' initialize the camera itself, and a Camera3d whose frustum normals have never been
    ' computed fails inside isInView, which has nothing to do with what's under test.
    private function drawOnce(imageDrawable as BGE.Image) as integer
      imageDrawable.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.resetDrawCallCounter()
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()
      return m.renderer.getDrawCallsLastFrame()
    end function

    @describe("draw modes")

    @it("draws in the oriented draw mode, which is what a Camera3d resolves matchCamera to")
    function _()
      m.assertTrue(m.drawOnce(m.newImage()) > 0)
    end function

    @it("draws in the oriented draw mode when shaded")
    function _()
      m.assertTrue(m.drawOnce(m.newImage({isShaded: true})) > 0)
    end function

    @it("draws in the oriented draw mode when rotated in its own plane")
    function _()
      ' rotated about z only, so it still faces the camera
      imageDrawable = m.newImage({rotation: BGE.Math.VectorOps.create(0, 0, BGE.Math.PI / 6)})
      m.assertTrue(m.drawOnce(imageDrawable) > 0)
    end function

    @describe("back faces")

    @it("culls a face turned away from the camera in the oriented draw mode")
    function _()
      ' turned a half turn about y, so its back is to the camera
      imageDrawable = m.newImage({rotation: BGE.Math.VectorOps.create(0, BGE.Math.PI, 0)})
      m.assertEqual(0, m.drawOnce(imageDrawable))
    end function

    @it("draws that same face in the orientedDrawBackFace draw mode")
    function _()
      imageDrawable = m.newImage({
        rotation: BGE.Math.VectorOps.create(0, BGE.Math.PI, 0),
        drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace
      })
      m.assertTrue(m.drawOnce(imageDrawable) > 0)
    end function

    @describe("a cube of six faces, as examples/3d's ImageCube builds one")

    @it("draws at least the faces that point at the camera")
    function _()
      ' the same arrangement ImageCube/ImagesRoom use: six faces around a 400-unit cube,
      ' with the entity itself turned a half turn about y and a sixth of a turn about z
      s = 400
      halfPi = BGE.Math.HALF_PI
      m.entity.rotation = BGE.Math.VectorOps.create(0, BGE.Math.PI, BGE.Math.PI / 6)
      faces = [
        {offset: BGE.Math.VectorOps.create(s, 0, -s), rotation: BGE.Math.VectorOps.create(0, 2 * -halfPi, 0)},
        {offset: BGE.Math.VectorOps.create(0, 0, 0), rotation: BGE.Math.VectorOps.create(0, 0, 0)},
        {offset: BGE.Math.VectorOps.create(s, 0, 0), rotation: BGE.Math.VectorOps.create(0, -halfPi, 0)},
        {offset: BGE.Math.VectorOps.create(0, 0, -s), rotation: BGE.Math.VectorOps.create(0, 3 * -halfPi, 0)},
        {offset: BGE.Math.VectorOps.create(0, 0, -s), rotation: BGE.Math.VectorOps.create(halfPi, 0, 0)},
        {offset: BGE.Math.VectorOps.create(0, -s, 0), rotation: BGE.Math.VectorOps.create(-halfPi, 0, 0)}
      ]
      for each face in faces
        m.newImage({offset: face.offset, rotation: face.rotation, isShaded: true}).addToScene(m.renderer)
      end for

      m.entity.updateTransformationMatrix()
      m.renderer.resetDrawCallCounter()
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()
      m.assertTrue(m.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("draws in the directToCamera draw mode")
    function _()
      imageDrawable = m.newImage({drawMode: BGE.SceneObjectDrawMode.directToCamera})
      m.assertTrue(m.drawOnce(imageDrawable) > 0)
    end function

    @it("draws in the directScaled draw mode")
    function _()
      imageDrawable = m.newImage({drawMode: BGE.SceneObjectDrawMode.directScaled})
      m.assertTrue(m.drawOnce(imageDrawable) > 0)
    end function

    @it("draws in the directScaled draw mode when offset well away from its entity")
    function _()
      ' as examples/3d's ImageCube offsets each face by 400 units - the camera-facing quad is
      ' built around that offset position, not around the entity
      imageDrawable = m.newImage({
        drawMode: BGE.SceneObjectDrawMode.directScaled,
        offset: BGE.Math.VectorOps.create(400, 0, -400)
      })
      m.assertTrue(m.drawOnce(imageDrawable) > 0)
    end function

    @describe("directScaled's camera-facing quad and camera-only movement")

    ' See issue #72: SceneObject.update()'s forceRecompute doesn't consider
    ' cameraObj.movedLastFrame(), and directScaled's quad is built facing the camera - so a
    ' stationary object might keep a quad oriented for where the camera used to be, if
    ' nothing else picks up the slack. This pins down whether that's actually true.
    @it("recomputes when only the camera rotates, not the object")
    function _()
      imageDrawable = m.newImage({drawMode: BGE.SceneObjectDrawMode.directScaled})
      m.entity.position = BGE.Math.VectorOps.create(300, 0, 0)
      sceneObj = imageDrawable.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()
      firstPos = (sceneObj as BGE.SceneObjectImage).getCanvasPosition()

      ' Rotate the camera only - the object itself never moves.
      m.renderer.camera.rotate(BGE.Math.VectorOps.create(0, 0.3, 0))
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()
      secondPos = (sceneObj as BGE.SceneObjectImage).getCanvasPosition()

      m.assertNotEqual(firstPos.x, secondPos.x)
    end function

    @describe("anchoring via the region's pretranslation")

    ' A region's pretranslation is how anchoring is expressed for an Image today - a sprite
    ' atlas's pivot arrives this way (see BGE.getRegionsFromAtlas). It has to be honoured by
    ' the geometry the renderer computes, not only by Roku's own draw calls, or the two
    ' disagree about where the sprite is.
    private function newPretranslatedImage(args = {} as roAssociativeArray) as BGE.Image
      sourceBitmap = CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: true})
      region = CreateObject("roRegion", sourceBitmap, 0, 0, 64, 64)
      ' a centring pivot, as an atlas would give for a sprite pivoted at its middle
      region.SetPretranslation(-32, -32)
      return new BGE.Image(m.entity, region, args)
    end function

    @it("draws a pretranslated region in the oriented draw mode")
    function _()
      m.assertTrue(m.drawOnce(m.newPretranslatedImage()) > 0)
    end function

    @it("draws a pretranslated region in the directScaled draw mode")
    function _()
      imageDrawable = m.newPretranslatedImage({drawMode: BGE.SceneObjectDrawMode.directScaled})
      m.assertTrue(m.drawOnce(imageDrawable) > 0)
    end function

    @it("leaves the region's pretranslation as it found it")
    function _()
      ' directScaled zeroes it for the blit, since the quad already accounts for it - but it
      ' must put it back, or the next thing to use that region draws in the wrong place
      imageDrawable = m.newPretranslatedImage({drawMode: BGE.SceneObjectDrawMode.directScaled})
      m.drawOnce(imageDrawable)
      m.assertEqual(-32, imageDrawable.region.GetPretranslationX())
      m.assertEqual(-32, imageDrawable.region.GetPretranslationY())
    end function

    @describe("changing draw mode on a stationary object")

    ' Geometry is only recomputed when the object or camera moves, so a mode change has to
    ' count as a change in its own right - the draw modes don't all want the same geometry
    ' (directScaled wants a camera-facing quad, oriented wants the object's own projected
    ' one). Nothing moves in these tests, and each renders a few frames first so the object
    ' has definitely settled into a clean state before the mode changes.
    private function drawFrames(count as integer) as integer
      for i = 1 to count
        ' Mirrors the Game loop calling this every frame regardless of whether anything
        ' actually moved: only a repeated call lets GameEntity's own MotionChecker notice
        ' the position is unchanged and reset its moved flag. Without this, the entity
        ' never "settles" - it stays permanently moved from the single initial call in each
        ' test - and objMovedInRelationToCamera() never goes false, so a SceneObject's
        ' cull/draw cache is never actually reachable no matter how many frames are drawn.
        m.entity.updateTransformationMatrix()
        m.renderer.resetDrawCallCounter()
        m.renderer.setupCameraForFrame()
        m.renderer.drawScene()
      end for
      return m.renderer.getDrawCallsLastFrame()
    end function

    @it("keeps drawing when switched from oriented to directScaled")
    function _()
      imageDrawable = m.newImage()
      sceneObj = imageDrawable.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.assertTrue(m.drawFrames(3) > 0)

      imageDrawable.drawMode = BGE.SceneObjectDrawMode.directScaled
      m.assertTrue(m.drawFrames(2) > 0)
      ' directScaled is screen-aligned, so switching into it must populate canvasPosition -
      ' oriented never touches it at all (only canvasPoints), so a stale switch would leave
      ' this invalid. A drawCalls > 0 assertion alone can't tell the two apart: a mode
      ' switch that failed to recompute would still draw from the old, stale geometry.
      m.assertNotInvalid((sceneObj as BGE.SceneObjectImage).getCanvasPosition())
    end function

    @it("keeps drawing when switched from directScaled to oriented")
    function _()
      imageDrawable = m.newImage({drawMode: BGE.SceneObjectDrawMode.directScaled})
      sceneObj = imageDrawable.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.assertTrue(m.drawFrames(3) > 0)

      imageDrawable.drawMode = BGE.SceneObjectDrawMode.oriented
      m.assertTrue(m.drawFrames(2) > 0)
      ' oriented projects the drawable's own quad into worldPoints - directScaled never
      ' touches it - so switching into oriented must populate a real (non-zero-width) quad
      ' matching the drawable's unscaled size (64px, from newImage()'s region). A stale
      ' switch would leave worldPoints at whatever directScaled left them (its default,
      ' zero-width CornerPoints, since it never sets worldPoints at all).
      worldPoints = (sceneObj as BGE.SceneObjectImage).getWorldPoints()
      m.assertEqual(64.0, worldPoints.topRight.x - worldPoints.topLeft.x)
    end function

    @describe("recovering from a failed draw")

    ' A draw that fails must not latch the object off. The frustum-cull shortcut in
    ' isPotentiallyOnScreen() declines to re-examine a culled object until something moves,
    ' and nothing here moves - so if a failure is treated as a cull, performDraw is never
    ' reached again and the object can never recover. See issue #48.
    '
    ' These assert on attempts rather than the renderer's draw-call count because the
    ' double's performDraw is faked and draws nothing. Real drawing recovering after a real
    ' cull is covered by the camera field-of-view test added in a later task.
    @it("keeps attempting the draw every frame while it is failing")
    function _()
      imageDrawable = m.newImage()
      failing = new tests.FailingSceneObjectImage("failing", imageDrawable)
      ' SceneObjectImage's own `drawable as Image` field redeclaration re-initializes
      ' `drawable` to invalid partway through the super constructor chain - normally
      ' patched up by Drawable.addSceneObjectToRenderer() right after construction, which
      ' this test bypasses since it registers the test double directly.
      failing.drawable = imageDrawable
      m.renderer.addSceneObject(failing)
      m.entity.updateTransformationMatrix()

      m.drawFrames(3)
      m.assertEqual(3, failing.drawAttempts)
    end function

    @it("attempts the draw again on the very next frame after the failure clears")
    function _()
      imageDrawable = m.newImage()
      failing = new tests.FailingSceneObjectImage("failing", imageDrawable)
      failing.drawable = imageDrawable
      m.renderer.addSceneObject(failing)
      m.entity.updateTransformationMatrix()
      m.drawFrames(3)

      attemptsWhileFailing = failing.drawAttempts
      failing.shouldFail = false
      m.drawFrames(1)
      m.assertEqual(attemptsWhileFailing + 1, failing.drawAttempts)
    end function

    ' The other half of the contract: a genuine cull must still latch, or the optimisation
    ' this shortcut exists for is gone and every off-screen object pays full rasterization
    ' cost every frame. Placed far enough off to the side to sit outside the camera frustum.
    @it("stops attempting the draw once the frustum has genuinely culled it")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(100000, 0, 0)
      imageDrawable = m.newImage()
      failing = new tests.FailingSceneObjectImage("offscreen", imageDrawable)
      failing.drawable = imageDrawable
      m.renderer.addSceneObject(failing)
      m.entity.updateTransformationMatrix()

      ' frame 1 is the first frame since enabled, so it attempts once; frame 2's frustum
      ' check culls it; frame 3 short-circuits on the latch without reaching performDraw
      m.drawFrames(3)
      m.assertEqual(1, failing.drawAttempts)

      ' and the cull must be CACHED, not recomputed: across 3 drawn frames the frustum check
      ' itself only runs once (verified against a real run, not assumed - frame 1 never
      ' reaches the frustum loop at all, via the first-frame-since-enabled bypass; frame 2
      ' runs it and latches; frame 3 short-circuits on the latch before reaching it again).
      ' A latch-free implementation - confirmed by temporarily disabling both
      ' isPotentiallyOnScreen() short-circuits - runs the frustum check on frames 2 AND 3
      ' and leaves drawAttempts at 1 regardless, which is why the attempt count alone is not
      ' enough to pin this; the frustum-check count is.
      m.assertEqual(1, failing.frustumChecks)
    end function

    @describe("recovering from a camera projection change")

    ' A culled object is deliberately not reconsidered until it or the camera moves - but a
    ' change to the camera's frame size or field of view is not movement, so without an
    ' explicit signal the object stays culled through a projection change that should have
    ' brought it back into view. Nothing moves here. See issue #48.
    '
    ' This asserts that the object is RECONSIDERED (performDraw is reached again), not that it
    ' then draws: whether a given point survives the frustum test at a given field of view is
    ' governed by an approximation that is wrong away from the default 90 degrees - see issue
    ' #70. Driving that here would tie this test to a bug, and break when the bug is fixed.
    @it("reconsiders a culled object when the camera projection changes")
    function _()
      ' far enough off-axis to be culled at the default field of view, and still culled once
      ' issue #70 is fixed (78 degrees off-axis at this distance, against a 45 degree half-FOV)
      m.entity.position = BGE.Math.VectorOps.create(5000, 0, 0)
      imageDrawable = m.newImage()
      failing = new tests.FailingSceneObjectImage("offscreen", imageDrawable)
      failing.drawable = imageDrawable
      m.renderer.addSceneObject(failing)
      m.entity.updateTransformationMatrix()

      ' frame 1 attempts, frame 2's frustum check culls it, frame 3 short-circuits on the latch
      m.drawFrames(3)
      attemptsWhileCulled = failing.drawAttempts
      m.assertEqual(1, attemptsWhileCulled)

      m.renderer.camera.bumpProjectionVersion()
      m.drawFrames(1)
      m.assertEqual(attemptsWhileCulled + 1, failing.drawAttempts)

      ' and it must settle straight back into the latch rather than re-entering the draw
      ' path every frame - the bypass frame records the new version, so the next frame runs
      ' the real frustum check, culls again, and latches again
      m.drawFrames(1)
      m.assertEqual(attemptsWhileCulled + 1, failing.drawAttempts)
    end function

  end class

end namespace
