namespace tests
  @suite("BGE.SceneObjectParticle")
  class SceneObjectParticleTests extends rooibos.BaseTestSuite
    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 200, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap)
      m.entity.position = BGE.Math.VectorOps.create(100, 100, 0)
    end function

    private function drawOnce(emitter as BGE.DrawableParticles) as integer
      sceneObj = emitter.addToRenderer(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.resetDrawCallCounter()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)
      return m.renderer.getDrawCallsLastFrame()
    end function

    @describe("drawable field")

    @it("is set by direct construction, not just via addToRenderer (issue #69)")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle)
      sceneObj = new BGE.SceneObjectParticle("test", emitter)
      m.assertNotInvalid(sceneObj.drawable)
    end function

    @describe("frustum check follows live particles, not just the emitter's own anchor (issue #114)")

    @it("draws a particle that has drifted into view even though the stationary off-screen emitter never moves")
    function _()
      ' Emitter itself sits far off-screen and never moves - only its particle does.
      m.entity.position = BGE.Math.VectorOps.create(-5000, 100, 0)
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle, {lifetime: 100})
      sceneObj = emitter.addToRenderer(m.renderer)
      m.entity.updateTransformationMatrix()
      emitter.burst(1)

      ' A SceneObject's very first update/draw always treats it as on-screen regardless
      ' of position (isFirstFrameSinceEnabled) - burn that frame first so the real
      ' frustum check actually runs on the next one.
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)

      ' Baseline: off-screen and correctly culled on a real check.
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)
      m.assertTrue(sceneObj.isCulled())

      ' Move the particle directly into the on-screen region - deterministic, rather than
      ' relying on wall-clock velocity integration - while the emitter's own anchor
      ' position never changes.
      emitter.particles[0].position = BGE.Math.VectorOps.create(100, 100, 0)
      m.renderer.setupCameraForFrame()
      m.renderer.resetDrawCallCounter()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)
      m.assertTrue(m.renderer.getDrawCallsLastFrame() > 0)
    end function

    @describe("draw call count scales with live particle count")
    @it("issues zero draw calls with zero live particles")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle)
      m.assertEqual(0, m.drawOnce(emitter))
    end function

    @it("issues one draw call per live rectangle particle")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle)
      emitter.burst(5)
      m.assertEqual(5, m.drawOnce(emitter))
    end function

    @it("issues one draw call per live line particle")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Line, {velocity: BGE.Math.VectorOps.create(10, 0)})
      emitter.burst(3)
      m.assertEqual(3, m.drawOnce(emitter))
    end function

    @it("registers exactly one SceneObject regardless of live particle count")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle)
      emitter.addToRenderer(m.renderer)
      emitter.burst(20)
      m.assertEqual(1, emitter.getSceneObjects().count())
    end function

    @describe("animated sprite-sheet image particles")
    @it("issues one draw call per live image particle with a plain static bitmap (no sprite sheet)")
    function _()
      bitmap = CreateObject("roBitmap", {width: 32, height: 32, alphaEnable: true})
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Image)
      emitter.image = bitmap
      emitter.burst(3)
      m.assertEqual(3, m.drawOnce(emitter))
    end function

    @it("still draws one call per particle when the image emitter is configured as a sprite sheet")
    function _()
      sheet = CreateObject("roBitmap", {width: 32, height: 16, alphaEnable: true})
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Image, {cellWidth: 16, cellHeight: 16})
      emitter.image = sheet
      emitter.burst(4)
      m.assertEqual(4, m.drawOnce(emitter))
    end function

    @describe("participatesInOverlapDetection")
    @it("opts out of overlap-cluster candidacy")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle)
      sceneObj = emitter.addToRenderer(m.renderer)
      m.assertFalse((sceneObj as BGE.SceneObjectParticle).participatesInOverlapDetection())
    end function
    @describe("bounding points cover what it draws (issue #463)")

    @it("can be occluded")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle)
      sceneObj = emitter.addToRenderer(m.renderer)
      m.assertTrue(sceneObj.canBeOccluded())
    end function

    @it("returns the emitter's anchor while no particles are alive")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle)
      sceneObj = emitter.addToRenderer(m.renderer)
      m.entity.updateTransformationMatrix()
      sceneObj.update(m.renderer.camera)
      points = sceneObj.getBoundingPoints(m.renderer.camera)
      m.assertEqual(1, points.count())
    end function

    @it("pads every particle by half a rectangle's diagonal, in pixels on a Camera2d")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle, {lifetime: 100, startSize: 10, endSize: 20})
      sceneObj = emitter.addToRenderer(m.renderer)
      emitter.burst(2)
      emitter.particles[0].position = BGE.Math.VectorOps.create(50, 60, 0)
      emitter.particles[1].position = BGE.Math.VectorOps.create(150, 80, 0)
      bounds = BGE.Math.getBounds(sceneObj.getBoundingPoints(m.renderer.camera))
      ' the larger of startSize/endSize: 20 * 0.7072
      m.assertTrue(abs(bounds[0].x - (50 - 14.144)) < 0.01, `min x ${bounds[0].x}`)
      m.assertTrue(abs(bounds[1].x - (150 + 14.144)) < 0.01, `max x ${bounds[1].x}`)
      m.assertTrue(abs(bounds[0].y - (60 - 14.144)) < 0.01, `min y ${bounds[0].y}`)
      m.assertTrue(abs(bounds[1].y - (80 + 14.144)) < 0.01, `max y ${bounds[1].y}`)
    end function

    @it("returns the 8 corners of the padded box")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle, {lifetime: 100})
      sceneObj = emitter.addToRenderer(m.renderer)
      emitter.burst(3)
      m.assertEqual(8, sceneObj.getBoundingPoints(m.renderer.camera).count())
    end function

    @it("includes the far end of a line particle")
    function _()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Line, {lifetime: 100, startSize: 30, endSize: 30})
      sceneObj = emitter.addToRenderer(m.renderer)
      emitter.burst(1)
      emitter.particles[0].position = BGE.Math.VectorOps.create(50, 60, 0)
      emitter.particles[0].velocity = BGE.Math.VectorOps.create(0, -5, 0)
      bounds = BGE.Math.getBounds(sceneObj.getBoundingPoints(m.renderer.camera))
      m.assertTrue(bounds[0].y <= 30 - 1, `min y ${bounds[0].y}`)
      m.assertTrue(bounds[1].y >= 60 + 1, `max y ${bounds[1].y}`)
    end function

    @it("pads an image particle by its scaled diagonal")
    function _()
      bitmap = CreateObject("roBitmap", {width: 6, height: 8, alphaEnable: true})
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Image, {lifetime: 100, startSize: 2, endSize: 1})
      emitter.image = bitmap
      sceneObj = emitter.addToRenderer(m.renderer)
      emitter.burst(1)
      emitter.particles[0].position = BGE.Math.VectorOps.create(100, 100, 0)
      bounds = BGE.Math.getBounds(sceneObj.getBoundingPoints(m.renderer.camera))
      ' sqr(6^2 + 8^2) * 2
      m.assertTrue(abs(bounds[1].x - 120) < 0.01, `max x ${bounds[1].x}`)
    end function

    @it("pads by enough world units to cover the particle's pixels on a Camera3d")
    function _()
      camera = new BGE.Camera3d()
      camera.fieldOfViewDegrees = 90
      camera.position = BGE.Math.VectorOps.create(0, 0, 0)
      camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      renderer = new BGE.Renderer(m.bitmap, m.game, camera)
      renderer.setupCameraForFrame()
      emitter = new BGE.DrawableParticles(m.entity, BGE.ParticleShape.Rectangle, {lifetime: 100, startSize: 20, endSize: 20})
      sceneObj = emitter.addToRenderer(renderer)
      emitter.burst(1)
      particlePos = BGE.Math.VectorOps.create(0, 0, -10)
      emitter.particles[0].position = particlePos
      centre = camera.worldPointToCanvasPoint(particlePos)
      minX = centre.x
      maxX = centre.x
      for each point in sceneObj.getBoundingPoints(camera)
        canvasPoint = camera.worldPointToCanvasPoint(point)
        if canvasPoint.x < minX
          minX = canvasPoint.x
        end if
        if canvasPoint.x > maxX
          maxX = canvasPoint.x
        end if
      end for
      ' the rectangle draws 10 pixels each side of its centre
      m.assertTrue(minX <= centre.x - 10, `min x ${minX} vs centre ${centre.x}`)
      m.assertTrue(maxX >= centre.x + 10, `max x ${maxX} vs centre ${centre.x}`)
    end function
  end class
end namespace
