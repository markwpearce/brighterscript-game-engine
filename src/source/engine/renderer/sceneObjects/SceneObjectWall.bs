import "../../../math/Matrix44.bs"
import "../../../math/vector.bs"
import "../../drawables/DrawableWall.bs"
import "SceneObject.bs"
import "SceneObjectImage.bs"

namespace BGE

  ' A `BGE.DrawableWall`'s quad: built from its floor ends and heights, drawn as an image,
  ' with its texture tiled when the wall asks for it.
  class SceneObjectWall extends SceneObjectImage

    wall as DrawableWall

    private corners as BGE.Math.Vector[] = invalid
    private cornersTransformVersion as integer = -1
    private cornersGeometryVersion as integer = -1

    sub new(name as string, drawableObj as DrawableWall)
      super(name, drawableObj)
      m.wall = drawableObj
    end sub

    protected override function updateWorldPosition(drawMode as SceneObjectDrawMode) as boolean
      if isScreenAlignedDrawMode(drawMode)
        return super.updateWorldPosition(drawMode)
      end if
      corners = m.computeBillboardWorldCorners()
      m.worldPoints.topLeft = corners[0]
      m.worldPoints.topRight = corners[1]
      m.worldPoints.bottomLeft = corners[2]
      m.worldPoints.bottomRight = corners[3]
      m.worldPosition = m.worldPoints.topLeft
      m.surfaceNormal = m.worldPoints.getNormal()
      return true
    end function

    ' The wall's corners in world space: top-left, top-right, bottom-left, bottom-right, with
    ' the left edge at its startPoint.
    protected override function computeBillboardWorldCorners() as BGE.Math.Vector[]
      wall = m.wall
      if m.cornersTransformVersion = m.transformVersion and m.cornersGeometryVersion = wall.geometryVersion and invalid <> m.corners
        return m.corners
      end if
      s = wall.startPoint
      e = wall.endPoint
      mat = m.transformationMatrix
      m.corners = [
        BGE.Math.Matrix44.multVecMatrix(BGE.Math.VectorOps.create(s.x, wall.top, s.z), mat),
        BGE.Math.Matrix44.multVecMatrix(BGE.Math.VectorOps.create(e.x, wall.top, e.z), mat),
        BGE.Math.Matrix44.multVecMatrix(BGE.Math.VectorOps.create(s.x, wall.bottom, s.z), mat),
        BGE.Math.Matrix44.multVecMatrix(BGE.Math.VectorOps.create(e.x, wall.bottom, e.z), mat)
      ]
      m.cornersTransformVersion = m.transformVersion
      m.cornersGeometryVersion = wall.geometryVersion
      return m.corners
    end function

    protected override function getColumnTextureRepeats() as BGE.Math.Vector
      return m.wall.getTextureRepeats()
    end function

    ' The one-call fast path stretches the texture, so only an untiled wall can use it.
    protected override function isEligibleForFastDrawCheck(drawMode as SceneObjectDrawMode) as boolean
      if m.isTiled()
        return false
      end if
      return super.isEligibleForFastDrawCheck(drawMode)
    end function

    private function isTiled() as boolean
      repeats = m.wall.getTextureRepeats()
      return abs(repeats.x - 1) > 0.001 or abs(repeats.y - 1) > 0.001
    end function

  end class

end namespace
