import "../../../math/vector.bs"
import "../../drawables/Image.bs"
import "../cameras/Camera.bs"
import "../occlusion/OcclusionTypes.bs"
import "../../../math/CornerPoints.bs"
import "../quadColumns/QuadColumnTexture.bs"
import "../Renderer.bs"
import "../RendererHelpers.bs"
import "SceneObject.bs"
import "SceneObjectBillboard.bs"

namespace BGE

  class SceneObjectImage extends SceneObjectBillboard

    drawable as Image

    public frameNumber as integer = 0

    private lastFrameNumberDrawn as integer = 0
    ' Column textures by frame number, for an image with no regionId (see getColumnTexture())
    private ownColumnTextures as roAssociativeArray = {}

    sub new(name as string, drawableObj as Image)
      super(name, drawableObj, BGE.SceneObjectType.Bitmap)
      ' Redeclaring `drawable` above auto-inits it to invalid after super() - this wins since it runs last (issue #69).
      m.drawable = drawableObj
    end sub

    ' An image always has a real width/height, unlike SceneObjectPolygon/SceneObjectModel
    ' (see the comment on SceneObjectBillboard.computeBillboardWorldCorners()) - so this
    ' overrides the base SceneObject.getBoundingPoints() wrapper to always return the
    ' object's 4 world-space corners rather than the frustum check's single-point
    ' shortcut in screen-aligned draw modes.
    '
    ' @param {Camera} cameraObj
    ' @return {BGE.Math.Vector[]} the object's 4 world-space corners
    override function getBoundingPoints(cameraObj as Camera) as BGE.Math.Vector[]
      return m.computeBillboardWorldCorners()
    end function

    protected function getUniqueRegionName() as string
      regionId = m.drawable.regionId
      if regionId = ""
        regionId = m.name
      end if
      return `${regionId}_${m.frameNumber.toStr()}`
    end function

    protected override function getRegionWithIdToDraw(rendererObj as BGE.Renderer) as BGE.RendererHelpers.RegionWithId
      regionId = m.getUniqueRegionName()
      drawableRegion = BGE.RendererHelpers.createRegionWithId(m.drawable.region, regionId)
      return drawableRegion
    end function

    ' A sprite's frames share column cuts through its BGE.SpriteFrames, and images with a
    ' regionId through the renderer. Otherwise they're kept here by frame, so images keyed
    ' only by their own name don't fill the renderer's shared cache.
    protected override function getColumnTexture(rendererObj as BGE.Renderer) as BGE.QuadColumnTexture
      texture = m.drawable.getColumnTexture()
      if invalid <> texture
        return texture
      end if
      region = m.drawable.region
      if invalid = region
        return invalid
      end if
      if m.drawable.regionId <> ""
        return super.getColumnTexture(rendererObj)
      end if
      key = m.frameNumber.toStr()
      texture = m.ownColumnTextures[key] as BGE.QuadColumnTexture
      if invalid = texture or not texture.hasRect(region)
        texture = new BGE.QuadColumnTexture(region)
        m.ownColumnTextures[key] = texture
      end if
      return texture
    end function

    protected override sub afterDraw()
      m.lastFrameNumberDrawn = m.frameNumber
    end sub

    protected override function didRegionToDrawChange() as boolean
      return m.lastFrameNumberDrawn <> m.frameNumber
    end function

    ' Columns from its texture, where the one-call fast path can't be used. Not in the solid
    ' modes, which draw a flat fill.
    '
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected override function canDrawAsColumns(drawMode as SceneObjectDrawMode) as boolean
      return drawMode = SceneObjectDrawMode.oriented or drawMode = SceneObjectDrawMode.orientedDrawBackFace
    end function

    ' A plain image is always a single flat quad, same as DrawableCircle - so the same
    ' exact analytic check (#105/#163) applies: only the oriented modes ever pay for a
    ' temp bitmap at all (see the base class's default useTempBitmapMap), and only need
    ' to when this frame's projected quad isn't a plain rotated rectangle.
    '
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected override function isEligibleForFastDrawCheck(drawMode as SceneObjectDrawMode) as boolean
      if m.drawsOccluderExactly()
        return false
      end if
      return drawMode = SceneObjectDrawMode.oriented or drawMode = SceneObjectDrawMode.orientedDrawBackFace
    end function

    ' oriented modes only reach here once usesTempBitmap() has already decided the fast
    ' path is safe - drawn via the base class's drawFastPath() instead of the inherited
    ' column path (correct but more expensive - the whole point of this fast path).
    protected override function drawToCanvas(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      if m.isEligibleForFastDrawCheck(drawMode)
        return m.drawFastPath(rendererObj, drawMode)
      end if
      return super.drawToCanvas(rendererObj, drawMode)
    end function

    ' A plain image is a single flat textured quad whose worldPoints exactly match its
    ' drawn fill - eligible for the static geometry BSP tree (issue #107).
    '
    ' @return {boolean}
    override function isEligibleForStaticBsp() as boolean
      return true
    end function

    ' When this frame's quad takes the fast path, the claim is the rectangle that path
    ' paints, 1px in for rounding - see SceneObjectBillboard.getOccluderClaim().
    '
    ' @param {Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @param {BGE.Math.CornerPoints} canvasQuad
    ' @param {float} depth
    ' @return {BGE.OccluderPolygon}
    protected override function getOccluderClaim(rendererObj as Renderer, drawMode as SceneObjectDrawMode, canvasQuad as BGE.Math.CornerPoints, depth as float) as BGE.OccluderPolygon
      ' the same test usesTempBitmap() makes at draw time, with the same tolerances
      settings = rendererObj.qualitySettings
      if m.shrinksOccluderClaim() and m.isEligibleForFastDrawCheck(drawMode) and canvasQuad.isApproximatelyRotatedRectangle(settings.fastDrawParallelogramTolerance, settings.fastDrawPerpendicularityTolerance)
        return m.newOccluderPolygon(m.getRotatedQuadPaintedCorners(canvasQuad), depth, 1)
      end if
      return super.getOccluderClaim(rendererObj, drawMode, canvasQuad, depth)
    end function

    ' Opaque, so it can hide what's behind it (see Drawable.isOccluder).
    '
    ' @return {boolean}
    override function isEligibleOccluderType() as boolean
      return true
    end function

  end class

end namespace
