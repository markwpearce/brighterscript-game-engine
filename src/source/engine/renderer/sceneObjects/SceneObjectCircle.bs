namespace BGE

  ' Draws a DrawableCircle. The fill is inherited, unmodified SceneObjectBillboard
  ' machinery (pinned-corners texture warp, tinting, temp-bitmap caching) blitting the
  ' renderer's shared circle resource (Renderer.getCircleResource(), built lazily on
  ' first use) - exactly like SceneObjectImage, just with a fixed texture instead of one
  ' supplied by the drawable. Only the outline differs from a plain Image: it's stroked
  ' as an N-gon inscribed in this object's own already-transformed canvasPoints quad (via
  ' the generic getOutlineCanvasPoints() hook), which is far cheaper than rasterizing the
  ' fill itself as a many-sided polygon and needs no new Renderer draw method.
  class SceneObjectCircle extends SceneObjectBillboard

    drawable as DrawableCircle

    sub new(name as string, drawableObj as DrawableCircle)
      super(name, drawableObj, SceneObjectType.Circle)
    end sub


    protected override function getRegionWithIdToDraw(rendererObj as BGE.Renderer) as BGE.RendererHelpers.RegionWithId
      circleBitmap = rendererObj.getCircleResource()
      if invalid = circleBitmap
        return invalid
      end if
      region = CreateObject("roRegion", circleBitmap, 0, 0, circleBitmap.getWidth(), circleBitmap.getHeight())
      return BGE.RendererHelpers.createRegionWithId(region, "__bge_circle")
    end function


    ' The base class's own wireFrame and solid branches both draw the plain 4-corner
    ' quad directly (a square) - correct for DrawableRectangle, whose fill genuinely is
    ' its own quad, but wrong for a circle. wireFrame is routed through
    ' drawOutlineToCanvas()/getOutlineCanvasPoints() below (same pattern
    ' SceneObjectRectangle uses); solid draws the circular texture straight to the
    ' canvas via drawPinnedCorners (the same warp drawToTempBitmap uses for the oriented
    ' modes, just targeting the real canvas directly since solid modes don't use a temp
    ' bitmap - see useTempBitmapMap). Every other draw mode is unchanged.
    protected override function drawToCanvas(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      if isWireFrameDrawMode(drawMode)
        return m.drawOutlineToCanvas(rendererObj, drawMode)
      end if
      if isSolidDrawMode(drawMode)
        regionToDraw = m.getRegionWithIdToDraw(rendererObj)
        if invalid = regionToDraw or invalid = regionToDraw.region
          return false
        end if
        return rendererObj.drawPinnedCorners(m.canvasPoints, regionToDraw, m.getPinnedCornersOptions(), m.getDrawColorRGBA(rendererObj))
      end if
      return super.drawToCanvas(rendererObj, drawMode)
    end function


    ' N points around the ellipse inscribed in this object's own transformed
    ' canvasPoints quad, computed from the quad's own corner vectors as the ellipse's
    ' basis rather than a fresh world-to-canvas transform pass - so this automatically
    ' gets the same foreshortening the quad itself has in oriented 3D draw modes.
    '
    ' No hasOutline() check here, matching the base class's own default implementation -
    ' that gating already happens at the "stroke on top of the fill" call site
    ' (performDraw), and a wireFrame draw mode (see drawToCanvas above) needs these
    ' points regardless of whether an outline color was ever set, the same way
    ' SceneObjectRectangle's wireFrame mode still strokes with the fill color when no
    ' outlineRGBA is set (see Drawable.getOutlineColorRGBA's fallback).
    protected override function getOutlineCanvasPoints() as BGE.Math.Vector[]
      center = m.canvasPoints.getCenter()
      halfAcross = BGE.Math.VectorOps.scale(BGE.Math.VectorOps.subtract(m.canvasPoints.topRight, m.canvasPoints.topLeft), 0.5)
      halfDown = BGE.Math.VectorOps.scale(BGE.Math.VectorOps.subtract(m.canvasPoints.bottomLeft, m.canvasPoints.topLeft), 0.5)
      segments = m.drawable.outlineSegments
      points = []
      for i = 0 to segments - 1
        theta = (2 * BGE.Math.PI) * (i / segments)
        offset = BGE.Math.VectorOps.add(
        BGE.Math.VectorOps.scale(halfAcross, cos(theta)),
        BGE.Math.VectorOps.scale(halfDown, sin(theta)))
        points.push(BGE.Math.VectorOps.add(center, offset))
      end for
      return points
    end function

  end class

end namespace
