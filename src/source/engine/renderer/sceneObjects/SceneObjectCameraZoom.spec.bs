namespace tests

  ' Screen-aligned drawables under a zoomed Camera2d (#588): projecting their position isn't
  ' enough, their size has to grow with the zoom too.
  @suite("BGE.SceneObject camera zoom")
  class SceneObjectCameraZoomTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer
    camera as BGE.Camera2d

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 200, alphaEnable: true})
      m.camera = new BGE.Camera2d()
      m.renderer = new BGE.Renderer(m.bitmap, m.game, m.camera)
      ' looking at world (0, 0): canvas (100, 100)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, 0))
      m.entity.position = BGE.Math.VectorOps.create(0, 0, 0)
    end function

    private function newImage(width as integer, height as integer, rgba as integer, args = {} as roAssociativeArray) as BGE.Image
      sourceBitmap = CreateObject("roBitmap", {width: width, height: height, alphaEnable: true})
      sourceBitmap.Clear(rgba)
      region = CreateObject("roRegion", sourceBitmap, 0, 0, width, height)
      return new BGE.Image(m.entity, region, args)
    end function

    private sub drawFrame()
      m.bitmap.Clear(&h000000FF)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      m.renderer.render()
    end sub

    private function isRed(x as integer, y as integer) as boolean
      bytes = m.bitmap.GetByteArray(x, y, 1, 1)
      return bytes[0] > 128 and bytes[2] < 128
    end function

    private function isGreen(x as integer, y as integer) as boolean
      bytes = m.bitmap.GetByteArray(x, y, 1, 1)
      return bytes[1] > 128 and bytes[0] < 128
    end function

    @describe("images")

    @it("draws a 10x10 image 20x20 at zoom 2")
    function _()
      image = m.newImage(10, 10, &hFF0000FF)
      image.addToRenderer(m.renderer)
      m.camera.zoom = 2
      m.drawFrame()
      ' top left at the canvas centre, 20 px across and down
      m.assertTrue(m.isRed(101, 101))
      m.assertTrue(m.isRed(118, 118))
      m.assertFalse(m.isRed(122, 110))
      m.assertFalse(m.isRed(110, 122))
    end function

    @it("still draws it 10x10 at zoom 1")
    function _()
      image = m.newImage(10, 10, &hFF0000FF)
      image.addToRenderer(m.renderer)
      m.drawFrame()
      m.assertTrue(m.isRed(108, 108))
      m.assertFalse(m.isRed(112, 105))
    end function

    @it("redraws bigger when only the zoom changes")
    function _()
      image = m.newImage(10, 10, &hFF0000FF)
      image.addToRenderer(m.renderer)
      m.drawFrame()
      m.drawFrame()
      m.assertFalse(m.isRed(115, 105))
      m.camera.zoom = 2
      m.drawFrame()
      m.assertTrue(m.isRed(115, 105))
    end function

    @it("leaves no gap between edge-to-edge tiles at a fractional zoom")
    function _()
      left = m.newImage(10, 10, &hFF0000FF)
      right = m.newImage(10, 10, &h00FF00FF, {offset: BGE.Math.VectorOps.create(10, 0, 0)})
      left.addToRenderer(m.renderer)
      right.addToRenderer(m.renderer)
      m.camera.zoom = 1.37
      m.drawFrame()
      ' the left tile spans canvas 100 to round(13.7) = 114, the right one 114 to round(27.4) = 127
      for x = 101 to 126
        m.assertTrue(m.isRed(x, 105) or m.isGreen(x, 105), `gap at x = ${x}`)
      end for
      m.assertFalse(m.isRed(128, 105) or m.isGreen(128, 105))
    end function

    @describe("a still Camera3d zooming")

    ' A projection change with nothing moving used to blit the old cached temp bitmap (and
    ' replay it) at the new position: the zoomed-in object stayed its old size.
    @it("redraws a cached oriented image at its zoomed size")
    function _()
      camera = new BGE.Camera3d()
      camera.drawDistanceFadeFraction = 0
      ' inside the headless 900 draw distance
      camera.position = BGE.Math.VectorOps.create(0, 0, 500)
      m.renderer = new BGE.Renderer(m.bitmap, m.game, camera)
      ' tilted, so it's drawn as texture columns and cached in a temp bitmap once still
      image = m.newImage(64, 64, &hFF0000FF, {drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace, rotation: BGE.Math.VectorOps.create(1.0, 0, 0)})
      image.addToRenderer(m.renderer)
      for i = 1 to 3
        m.drawFrame()
      end for
      before = m.countRed()
      m.assertTrue(before > 20, `zoom 1: ${before}`)
      camera.zoom = 2
      m.drawFrame()
      zooming = m.countRed()
      m.drawFrame()
      m.drawFrame()
      after = m.countRed()
      ' twice as big each way
      m.assertTrue(zooming > before * 3, `zooming frame: ${before} -> ${zooming}`)
      m.assertTrue(after > before * 3, `still frames after: ${before} -> ${after}`)
    end function

    private function countRed() as integer
      bytes = m.bitmap.GetByteArray(0, 0, 200, 200)
      count = 0
      for i = 0 to bytes.Count() - 4 step 4
        if bytes[i] > 128 and bytes[i + 2] < 128
          count++
        end if
      end for
      return count
    end function

    @describe("rectangles")

    @it("fills a 10x10 rectangle 20x20 at zoom 2")
    function _()
      rect = new BGE.DrawableRectangle(m.entity, 10, 10, {color: BGE.ColorsRGB.Red})
      rect.addToRenderer(m.renderer)
      m.camera.zoom = 2
      m.drawFrame()
      m.assertTrue(m.isRed(101, 101))
      m.assertTrue(m.isRed(118, 118))
      m.assertFalse(m.isRed(122, 110))
    end function

    @it("keeps a centre-anchored rectangle centred on its position at zoom 2")
    function _()
      rect = new BGE.DrawableRectangle(m.entity, 10, 10, {color: BGE.ColorsRGB.Red})
      rect.setAnchor(0.5, 0.5)
      rect.addToRenderer(m.renderer)
      m.camera.zoom = 2
      m.drawFrame()
      m.assertTrue(m.isRed(91, 91))
      m.assertTrue(m.isRed(108, 108))
      m.assertFalse(m.isRed(88, 100))
      m.assertFalse(m.isRed(112, 100))
    end function

  end class

end namespace
