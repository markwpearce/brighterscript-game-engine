import "../../../math/vector.bs"
import "../../drawables/DrawableGridWalls.bs"
import "../../drawables/DrawablePlane.bs"
import "../../drawables/DrawableSkybox.bs"
import "../../drawables/Image.bs"
import "../cameras/Camera2d.bs"
import "../cameras/Camera3d.bs"
import "../gridWalls/GridWallsMap.bs"
import "../lighting/Light.bs"
import "../Renderer.bs"
import "SceneObjectGridWalls.bs"
import "SceneObjectImage.bs"
import "SceneObjectPlane.bs"
import "SceneObjectSkybox.bs"

namespace tests

  ' Records log() calls instead of needing a Game to log through.
  class LogSpyDrawableGridWalls extends BGE.DrawableGridWalls

    public warnings = [] as string[]

    sub new(owner as BGE.GameEntity, map as BGE.GridWallsMap, textures as roAssociativeArray, args = {} as object)
      super(owner, map, textures, args)
    end sub

    override sub log(message as string, level = BGE.Debug.LogLevel.info as BGE.Debug.LogLevel)
      if level = BGE.Debug.LogLevel.warning
        m.warnings.push(message)
      end if
    end sub

  end class

  ' A 3x3-cell room (cells 4 units, walls 4 high) whose open floor spans x and z -6..6. The
  ' camera stands at (0, 2, 4) looking down -z at the north wall (z = -6), 10 units away.
  @suite("BGE.SceneObjectGridWalls")
  class SceneObjectGridWallsTests extends rooibos.BaseTestSuite

    private game as BGE.Game
    private renderer as BGE.Renderer
    private camera as BGE.Camera3d
    private map as BGE.GridWallsMap
    private textures as roAssociativeArray
    private drawable as tests.LogSpyDrawableGridWalls
    private walls as BGE.SceneObjectGridWalls

    protected override sub beforeEach()
      m.game = new BGE.Game(1280, 720)
      bitmap = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      m.camera = new BGE.Camera3d()
      m.camera.fieldOfViewDegrees = 90
      m.camera.position = BGE.Math.VectorOps.create(0, 2, 4)
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.camera.drawDistanceFadeFraction = 0
      m.camera.drawDistanceTransitionSeconds = 0
      m.renderer = new BGE.Renderer(bitmap, m.game, m.camera)
      m.map = new BGE.GridWallsMap(["#####", "#...#", "#...#", "#...#", "#####"], {
        cellSize: 4.0,
        wallHeight: 4.0,
        origin: BGE.Math.VectorOps.create(-10, 0, -10),
        solid: {"#": "stone"}
      })
      texture = CreateObject("roBitmap", {width: 16, height: 32, alphaEnable: true})
      texture.Clear(&hFFFFFFFF)
      m.textures = {stone: CreateObject("roRegion", texture, 0, 0, 16, 32)}
      m.drawable = new tests.LogSpyDrawableGridWalls(invalid, m.map, m.textures)
      m.walls = m.drawable.addToRenderer(m.renderer) as BGE.SceneObjectGridWalls
    end sub

    private sub assertNear(expected as float, actual as float, tolerance as float, label = "" as string)
      m.assertTrue(abs(expected - actual) <= tolerance, `${label} expected ${expected} but got ${actual}`)
    end sub

    private sub pitchDown(degrees as float)
      rad = degrees * 3.14159265 / 180
      m.camera.orientation = BGE.Math.VectorOps.create(0, -sin(rad), -cos(rad))
    end sub

    ' Sets the camera up as a frame would, then fans the rays.
    private function updateView() as boolean
      m.renderer.setupCameraForFrame()
      m.camera.computeWorldToCameraMatrix()
      m.renderer.updateLighting()
      return m.walls.updateView(m.renderer)
    end function

    private function newStrip() as BGE.GridWallStrip
      return {x: 0.0, y: 0.0, angle: 0.0, scaleX: 0.0, scaleY: 0.0, column: invalid, rgba: 0, distance: 0.0}
    end function

    ' Asserts the strip's foot and top land on the projected foot and top of ray i's hit.
    private sub assertStripMatchesProjection(i as integer, strip as BGE.GridWallStrip)
      hit = m.walls.view.getHit(i)
      foot = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(hit.x, 0, hit.z))
      top = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(hit.x, 4, hit.z))
      length = strip.scaleY * 32
      topX = strip.x - length * sin(strip.angle)
      topY = strip.y - length * cos(strip.angle)
      m.assertNear(foot.x, strip.x, 1, "foot x")
      m.assertNear(foot.y, strip.y, 1, "foot y")
      m.assertNear(top.x, topX, 1, "top x")
      m.assertNear(top.y, topY, 1, "top y")
    end sub

    private function renderFrame() as integer
      m.renderer.resetDrawCallCounter()
      m.renderer.setupCameraForFrame()
      m.renderer.render()
      return m.renderer.getDrawCallsLastFrame()
    end function

    @describe("computeStrip")

    @it("puts the middle strip's foot and top on the projected wall foot and top")
    function _()
      m.assertTrue(m.updateView())
      mid = int(m.walls.view.rayCount / 2)
      strip = m.newStrip()
      m.assertTrue(m.walls.computeStrip(mid, strip))
      m.assertStripMatchesProjection(mid, strip)
      m.assertNear(0, strip.angle, 0.01, "angle")
      m.assertNear(m.walls.view.getDepth(mid), strip.distance, 0.0001, "distance")
    end function

    @it("matches the projection pitched 35 degrees down, with edge strips leaning")
    function _()
      m.pitchDown(35)
      m.assertTrue(m.updateView())
      mid = int(m.walls.view.rayCount / 2)
      strip = m.newStrip()
      m.assertTrue(m.walls.computeStrip(mid, strip))
      m.assertStripMatchesProjection(mid, strip)

      edge = -1
      for i = 0 to m.walls.view.rayCount - 1
        if m.walls.computeStrip(i, strip)
          edge = i
          exit for
        end if
      end for
      m.assertTrue(edge >= 0 and edge < mid, `edge ${edge}`)
      m.assertStripMatchesProjection(edge, strip)
      m.assertTrue(abs(strip.angle) > 0.01, `angle ${strip.angle}`)
    end function

    @it("leaves no gap between neighbouring strips on one wall")
    function _()
      m.assertTrue(m.updateView())
      mid = int(m.walls.view.rayCount / 2)
      a = m.newStrip()
      b = m.newStrip()
      for i = mid - 3 to mid + 3
        m.assertTrue(m.walls.computeStrip(i, a))
        m.assertTrue(m.walls.computeStrip(i + 1, b))
        rightEdge = a.x + a.scaleX * cos(a.angle)
        m.assertTrue(rightEdge >= b.x, `ray ${i}: right edge ${rightEdge} < next ${b.x}`)
      end for
    end function

    @it("skips a hit beyond the draw distance and fades one in the fade band")
    function _()
      mid = 0
      strip = m.newStrip()
      m.camera.maxDrawDistance = 8
      m.camera.snapDrawDistance()
      m.assertTrue(m.updateView())
      mid = int(m.walls.view.rayCount / 2)
      m.assertFalse(m.walls.computeStrip(mid, strip))

      m.camera.maxDrawDistance = 12
      m.camera.drawDistanceFadeFraction = 0.5
      m.camera.snapDrawDistance()
      m.assertTrue(m.updateView())
      mid = int(m.walls.view.rayCount / 2)
      m.assertTrue(m.walls.computeStrip(mid, strip))
      alpha = strip.rgba and &hFF
      m.assertTrue(alpha < 255 and alpha > 0, `alpha ${alpha}`)
    end function

    @describe("lighting")

    @it("tints with the drawable's color when not shaded")
    function _()
      m.drawable.color = &h808080
      m.assertTrue(m.updateView())
      strip = m.newStrip()
      m.assertTrue(m.walls.computeStrip(int(m.walls.view.rayCount / 2), strip))
      m.assertEqual(&h808080FF, strip.rgba)
    end function

    @it("lights a wall beside a point light brighter than a far wall")
    function _()
      m.drawable.isShaded = true
      m.renderer.addLight(new BGE.PointLight(BGE.Math.VectorOps.create(-5, 2, -2), 6))
      m.assertTrue(m.updateView())
      near = m.newStrip()
      far = m.newStrip()
      ' the leftmost strips are on the west wall (x = -6) near the light
      m.assertTrue(m.walls.computeStrip(1, near))
      m.assertTrue(m.walls.computeStrip(int(m.walls.view.rayCount / 2), far))
      nearRed = (near.rgba >> 24) and &hFF
      farRed = (far.rgba >> 24) and &hFF
      m.assertTrue(nearRed > farRed, `near ${nearRed} far ${farRed}`)
    end function

    @it("falls back to camera-facing shading with no lights")
    function _()
      m.drawable.isShaded = true
      m.assertTrue(m.updateView())
      side = m.newStrip()
      ahead = m.newStrip()
      m.assertTrue(m.walls.computeStrip(1, side))
      m.assertTrue(m.walls.computeStrip(int(m.walls.view.rayCount / 2), ahead))
      sideRed = (side.rgba >> 24) and &hFF
      aheadRed = (ahead.rgba >> 24) and &hFF
      m.assertTrue(aheadRed >= 250, `ahead ${aheadRed}`)
      m.assertTrue(sideRed < aheadRed, `side ${sideRed} ahead ${aheadRed}`)
    end function

    @it("lights sampled strips exactly and interpolates the ones between")
    function _()
      m.drawable.isShaded = true
      m.renderer.addLight(new BGE.PointLight(BGE.Math.VectorOps.create(-5.5, 2, -5), 3))
      m.renderFrame()
      interval = m.renderer.qualitySettings.gridWallLightInterval
      m.assertTrue(interval > 1)
      ' the first drawn strip on the north wall starts a run, so it's a sample
      first = -1
      for i = 0 to m.walls.raysLastFrame - 1
        drawn = m.walls.getDrawnStrip(i)
        if invalid <> drawn and m.walls.view.getHit(i).normalZ = 1
          first = i
          exit for
        end if
      end for
      m.assertTrue(first >= 0)
      exact = m.newStrip()
      for each sampleRay in [first, first + interval]
        m.assertTrue(m.walls.computeStrip(sampleRay, exact))
        m.assertEqual(exact.rgba, m.walls.getDrawnStrip(sampleRay).rgba)
      end for
      redA = (m.walls.getDrawnStrip(first).rgba >> 24) and &hFF
      redB = (m.walls.getDrawnStrip(first + interval).rgba >> 24) and &hFF
      m.assertNotEqual(redA, redB)
      redMid = (m.walls.getDrawnStrip(first + 1).rgba >> 24) and &hFF
      m.assertTrue(redMid >= BGE.Math.Min(redA, redB) and redMid <= BGE.Math.Max(redA, redB), `${redA} ${redMid} ${redB}`)
    end function

    @describe("drawsInFixedStage")

    @it("is true for planes, skyboxes and grid walls, and false for an image")
    function _()
      region = m.textures.stone
      plane = new BGE.DrawablePlane(invalid, invalid, {normal: BGE.Math.VectorOps.create(0, 1, 0), point: BGE.Math.VectorOps.create(0, 0, 0)}, {fillMode: BGE.PlaneFillMode.color})
      planeObj = new BGE.SceneObjectPlane("plane", plane)
      skybox = new BGE.DrawableSkybox(invalid, region)
      skyboxObj = new BGE.SceneObjectSkybox("skybox", skybox)
      image = new BGE.Image(invalid, region)
      imageObj = new BGE.SceneObjectImage("image", image)
      m.assertTrue(planeObj.drawsInFixedStage())
      m.assertTrue(skyboxObj.drawsInFixedStage())
      m.assertTrue(m.walls.drawsInFixedStage())
      m.assertFalse(imageObj.drawsInFixedStage())
    end function

    @describe("Renderer stage")

    @it("draws the strips, counts them, and reports the walls drawn this frame")
    function _()
      drawCalls = m.renderFrame()
      m.assertTrue(m.walls.raysLastFrame > 0)
      m.assertTrue(m.walls.stripsDrawnLastFrame > 0)
      m.assertTrue(drawCalls >= m.walls.stripsDrawnLastFrame, `draw calls ${drawCalls}`)
      active = m.renderer.getGridWalls()
      m.assertNotInvalid(active)
      m.assertEqual(m.walls.id, active.id)
    end function

    @it("warns about a second grid walls object and never draws it")
    function _()
      second = new tests.LogSpyDrawableGridWalls(invalid, m.map, m.textures)
      secondObj = second.addToRenderer(m.renderer) as BGE.SceneObjectGridWalls
      m.assertEqual(1, second.warnings.count())
      m.assertEqual(0, m.drawable.warnings.count())
      m.renderFrame()
      m.assertEqual(m.walls.id, m.renderer.getGridWalls().id)
      m.assertEqual(0, secondObj.stripsDrawnLastFrame)
    end function

    @it("draws nothing with a Camera2d and warns once")
    function _()
      bitmap = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      renderer2d = new BGE.Renderer(bitmap, m.game, new BGE.Camera2d())
      drawable2d = new tests.LogSpyDrawableGridWalls(invalid, m.map, m.textures)
      drawable2d.addToRenderer(renderer2d)
      renderer2d.resetDrawCallCounter()
      renderer2d.setupCameraForFrame()
      renderer2d.render()
      renderer2d.setupCameraForFrame()
      renderer2d.render()
      m.assertEqual(0, renderer2d.getDrawCallsLastFrame())
      m.assertEqual(1, drawable2d.warnings.count())
      m.assertInvalid(renderer2d.getGridWalls())
    end function

    @it("forgets the walls once the drawable is disabled")
    function _()
      m.renderFrame()
      m.assertNotInvalid(m.renderer.getGridWalls())
      m.drawable.enabled = false
      m.renderFrame()
      m.assertInvalid(m.renderer.getGridWalls())
    end function

    @it("forgets the walls once they're removed from the renderer")
    function _()
      m.renderFrame()
      m.assertNotInvalid(m.renderer.getGridWalls())
      m.drawable.removeFromRenderer(m.renderer)
      m.renderFrame()
      m.assertInvalid(m.renderer.getGridWalls())
    end function

    @it("lets a new grid walls object draw once the first is removed")
    function _()
      m.drawable.removeFromRenderer(m.renderer)
      second = new tests.LogSpyDrawableGridWalls(invalid, m.map, m.textures)
      secondObj = second.addToRenderer(m.renderer) as BGE.SceneObjectGridWalls
      m.assertEqual(0, second.warnings.count())
      m.renderFrame()
      m.assertEqual(secondObj.id, m.renderer.getGridWalls().id)
    end function

    @it("draws foot dots and ray counts with entity details on")
    function _()
      plain = m.renderFrame()
      m.drawable.removeFromRenderer(m.renderer)
      entity = new BGE.GameEntity(m.game, {name: "Maze"})
      owned = new tests.LogSpyDrawableGridWalls(entity, m.map, m.textures)
      m.walls = owned.addToRenderer(m.renderer) as BGE.SceneObjectGridWalls
      m.game.debugDrawEntityDetails(true)
      withDebug = m.renderFrame()
      dots = int((m.walls.raysLastFrame + 7) / 8)
      m.assertTrue(withDebug > plain, `plain ${plain} debug ${withDebug}`)
      m.assertTrue(withDebug <= plain + dots + 1, `plain ${plain} debug ${withDebug} dots ${dots}`)
    end function

    @describe("redrawStrips")

    @it("redraws only the strips in range that are nearer than the given depth")
    function _()
      m.renderFrame()
      mid = int(m.walls.view.rayCount / 2)
      m.renderer.resetDrawCallCounter()
      m.walls.redrawStrips(m.renderer, mid - 2, mid + 2, 100)
      m.assertEqual(5, m.renderer.getDrawCallsLastFrame())
      m.renderer.resetDrawCallCounter()
      m.walls.redrawStrips(m.renderer, mid - 2, mid + 2, 5)
      m.assertEqual(0, m.renderer.getDrawCallsLastFrame())
    end function

  end class

end namespace
