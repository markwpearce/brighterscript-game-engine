namespace tests

  ' Constructs a real BGE.Game (and the roScreen/roCompositor that come with
  ' it) to exercise SceneObject behavior - in particular, update()'s misuse
  ' check needs a real Drawable/GameEntity/Game chain to log through.
  @suite("BGE.SceneObject - static geometry")
  class SceneObjectStaticTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
    end function

    @describe("isEligibleForStaticBsp")

    @it("is false for the base SceneObject default")
    function _()
      ' SceneObjectCircle does not override isEligibleForStaticBsp() - its worldPoints
      ' are a bounding proxy, not its actual drawn silhouette (see the doc comment on
      ' SceneObject.isEligibleForStaticBsp()) - so it exercises the base class default,
      ' unlike addRectangle()'s SceneObjectRectangle, which Step 4 overrides to true.
      drawable = m.entity.addCircle("plainCircle", 10)
      sceneObj = drawable.getSceneObjects()[0]
      m.assertFalse(sceneObj.isEligibleForStaticBsp())
    end function

    @describe("getWorldPoints")

    @it("returns non-invalid CornerPoints for a SceneObjectRectangle (SceneObjectBillboard override)")
    function _()
      rectDrawable = m.entity.addRectangle("plainRect2", 10, 10)
      rectSceneObj = rectDrawable.getSceneObjects()[0]
      m.assertNotInvalid(rectSceneObj.getWorldPoints())
    end function

    @describe("getDepthPosition")

    @it("matches worldPosition for a screen-aligned (non-oriented) billboard")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(0, 0, 100)
      drawable = m.entity.addRectangle("wall", 40, 20, {drawMode: BGE.SceneObjectDrawMode.directToCamera})
      sceneObj = drawable.getSceneObjects()[0]
      sceneObj.update(m.game.canvas.renderer.camera)
      depthPos = sceneObj.getDepthPosition()
      m.assertEqual(sceneObj.worldPosition.x, depthPos.x)
      m.assertEqual(sceneObj.worldPosition.y, depthPos.y)
      m.assertEqual(sceneObj.worldPosition.z, depthPos.z)
    end function

    @it("returns the quad's center, not its corner, for an oriented billboard")
    function _()
      ' Regression test for finding 1 (final whole-branch review): before the fix,
      ' Renderer.drawStaticAndDynamicSceneObjects() classified dynamic objects by
      ' worldPosition, which SceneObjectBillboard.updateWorldPosition() sets to
      ' worldPoints.topLeft (a corner) for an oriented object - offsetting
      ' classification by half the quad's width/height.
      m.entity.position = BGE.Math.VectorOps.create(0, 0, 100)
      drawable = m.entity.addRectangle("wall", 40, 20, {drawMode: BGE.SceneObjectDrawMode.oriented})
      sceneObj = drawable.getSceneObjects()[0]
      sceneObj.update(m.game.canvas.renderer.camera)
      depthPos = sceneObj.getDepthPosition()
      ' worldPosition is still the corner (topLeft) - depthPosition must be the center,
      ' offset by half the quad's width/height from it.
      m.assertEqual(sceneObj.worldPosition.x + 20.0, depthPos.x)
      m.assertEqual(sceneObj.worldPosition.y - 10.0, depthPos.y)
    end function

    @describe("isReadyForStaticBspBuild")

    @it("returns true for an eligible object in an oriented draw mode")
    function _()
      drawable = m.entity.addRectangle("wall", 50, 50, {drawMode: BGE.SceneObjectDrawMode.oriented})
      sceneObj = drawable.getSceneObjects()[0]
      m.assertTrue(sceneObj.isReadyForStaticBspBuild(m.game.canvas.renderer.camera))
    end function

    @it("returns false and logs once for an eligible object left in a non-oriented draw mode")
    function _()
      ' Regression test for finding 3: a static entity left in the default
      ' matchCamera/directToCamera/directScaled mode has no populated worldPoints, so
      ' including it in the tree would build a degenerate (all-zero) plane.
      drawable = m.entity.addRectangle("wall", 50, 50, {drawMode: BGE.SceneObjectDrawMode.directToCamera})
      sceneObj = drawable.getSceneObjects()[0]
      camera = m.game.canvas.renderer.camera
      m.assertFalse(sceneObj.isReadyForStaticBspBuild(camera))
      logHistory = m.game.getLogHistory()
      lastEntry = logHistory[logHistory.count() - 1]
      m.assertEqual(BGE.Debug.LogLevel.warning, lastEntry.level)
      countAfterFirst = logHistory.count()
      sceneObj.isReadyForStaticBspBuild(camera)
      m.assertEqual(countAfterFirst, m.game.getLogHistory().count())
    end function

    @describe("participatesInOverlapDetection")

    @it("returns false once isStatic is set, regardless of concrete type")
    function _()
      ' Regression test for finding 6: static geometry must opt out of overlap
      ' clustering - the BSP tree already orders it, and a multi-member cluster would
      ' defer it to Renderer.drawPendingClusterPrimitives(), silently discarding that
      ' order.
      drawable = m.entity.addRectangle("wall", 50, 50)
      sceneObj = drawable.getSceneObjects()[0]
      m.assertTrue(sceneObj.participatesInOverlapDetection())
      sceneObj.isStatic = true
      m.assertFalse(sceneObj.participatesInOverlapDetection())
    end function

    @describe("static misuse detection")

    @it("logs nothing and does not flag movement on the first update")
    function _()
      drawable = m.entity.addRectangle("wall", 50, 50)
      sceneObj = drawable.getSceneObjects()[0]
      sceneObj.isStatic = true
      sceneObj.update(m.game.canvas.renderer.camera)
      m.assertFalse(sceneObj.staticGeometryMovedThisFrame)
    end function

    @it("flags movement and logs a warning once the entity moves after being marked static")
    function _()
      drawable = m.entity.addRectangle("wall", 50, 50)
      sceneObj = drawable.getSceneObjects()[0]
      sceneObj.isStatic = true
      camera = m.game.canvas.renderer.camera
      sceneObj.update(camera) ' first update - settles the motion checker, no flag
      m.entity.position = BGE.Math.VectorOps.create(500, 0, 0)
      sceneObj.update(camera)
      m.assertTrue(sceneObj.staticGeometryMovedThisFrame)
      logHistory = m.game.getLogHistory()
      lastEntry = logHistory[logHistory.count() - 1]
      m.assertEqual(BGE.Debug.LogLevel.warning, lastEntry.level)
    end function

    @it("only logs the warning once across repeated moves")
    function _()
      drawable = m.entity.addRectangle("wall", 50, 50)
      sceneObj = drawable.getSceneObjects()[0]
      sceneObj.isStatic = true
      camera = m.game.canvas.renderer.camera
      sceneObj.update(camera)
      m.entity.position = BGE.Math.VectorOps.create(500, 0, 0)
      sceneObj.update(camera)
      countAfterFirstMove = m.game.getLogHistory().count()
      m.entity.position = BGE.Math.VectorOps.create(600, 0, 0)
      sceneObj.update(camera)
      m.assertEqual(countAfterFirstMove, m.game.getLogHistory().count())
    end function

  end class

end namespace
