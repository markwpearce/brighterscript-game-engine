import "../../../math/vector.bs"
import "../../drawables/DrawableWalls.bs"
import "../cameras/Camera3d.bs"
import "../lighting/Lighting.bs"
import "../walls/WallSegment.bs"
import "../walls/WallsView.bs"
import "../Renderer.bs"
import "../RendererHelpers.bs"
import "SceneObject.bs"

namespace BGE

  ' Draws a DrawableWalls: walks its WallsView each time the camera changes, then draws the
  ' visible strips far to near.
  class SceneObjectWalls extends SceneObject

    drawable as DrawableWalls

    ' This frame's strips and the depth windows that hide things behind walls.
    view as BGE.WallsView

    ' Rays in the fan and strips drawn by the last draw, and how many of those were fog strips
    ' (see BGE.Fog)
    raysLastFrame as integer = 0
    stripsDrawnLastFrame as integer = 0
    fogStripsDrawnLastFrame as integer = 0

    private rendererObj as Renderer
    private warnedCamera2d as boolean = false
    private castRequested as boolean = true
    ' Bumped on each view update; the shade cache keys off it.
    private viewStamp as integer = 0
    private viewStripWidth as integer = -1
    private viewGeometryVersion as integer = -1
    private shadeStamp as integer = -1
    private shadeBase as integer = 0
    private shadeShaded as boolean = false
    private shadeAmbient as float = -1.0
    private shadeWrap as float = -1.0
    ' DrawableWalls.mipmapped when segmentColumns was filled
    private shadeMipmapped as boolean = true
    ' Per piece, packed RGBA with light and distance fade
    private pieceRgba = [] as integer[]
    ' Per piece, its texture column (invalid for a missing texture) and vertical scale
    private pieceColumn = [] as dynamic[]
    private pieceScaleY = [] as float[]
    ' Per piece, whether a solid fog strip goes under it, until buildFogRuns() merges it into a run
    private pieceFogUnder = [] as boolean[]
    ' A white column, tinted with the fog colour for fog strips
    private fogColumn as object = invalid
    private fogColumnHeight as float = 64
    ' Fog strips, merged up to maxFogRun neighbours on a wall: foot x and y, width, vertical
    ' scale and lean each, all in fogRunRgba (see buildFogRuns())
    private fogRunX = [] as float[]
    private fogRunY = [] as float[]
    private fogRunWidth = [] as float[]
    private fogRunScale = [] as float[]
    private fogRunAngle = [] as float[]
    private fogRunRgba as integer = 0
    private maxFogRun as integer = 4
    ' Per piece, whether it's past the draw distance, so only a fog strip
    private pieceFogOnly = [] as boolean[]
    ' The fog the shading was worked out for (-1 colour for none)
    private shadeFogColor as integer = -1
    private shadeFogStart as float = -1.0
    ' Per segment, its columns at each mip level (invalid for a missing texture)
    private segmentColumns = [] as dynamic[]
    ' Per segment, tiles along it (0 for one stretched copy), full-size texture columns along
    ' it, and 1 / column height
    private segmentTiles = [] as float[]
    private segmentTexels = [] as float[]
    private segmentInvHeights = [] as float[]
    ' Lit colors per segment and side ("index*2+side"), one per light bucket along it, kept
    ' until the lights or the shading inputs change
    private lightCache = {} as roAssociativeArray
    private redrawOrder = [] as integer[]
    private shadePoint as BGE.Math.Vector
    ' The camera the view was last walked for (keyValid false if never, or it failed)
    private keyValid as boolean = false
    private keyX as float = 0
    private keyY as float = 0
    private keyZ as float = 0
    private keyOx as float = 0
    private keyOy as float = 0
    private keyOz as float = 0
    private keyRoll as float = 0
    private keyFocal as float = 0
    private keyFar as float = 0
    private keyW as float = 0
    private keyH as float = 0
    private keyLod as float = 0
    private keyRecord as boolean = false
    private shadeNormal as BGE.Math.Vector

    sub new(name as string, drawableObj as DrawableWalls)
      super(name, drawableObj, BGE.SceneObjectType.Walls)
      ' Redeclaring `drawable` above auto-inits it to invalid after super() - this wins since it runs last (issue #69).
      m.drawable = drawableObj
      m.view = new BGE.WallsView(drawableObj.segments, drawableObj.getBsp())
      m.viewGeometryVersion = drawableObj.geometryVersion
      m.shadePoint = BGE.Math.VectorOps.create(0, 0, 0)
      m.shadeNormal = BGE.Math.VectorOps.create(0, 0, 0)
    end sub

    override function drawsInFixedStage() as boolean
      return true
    end function

    ' The walls are drawn in their own stage, never interleaved.
    override function participatesInOverlapDetection() as boolean
      return false
    end function

    ' Strips fade one by one instead.
    override function participatesInDistanceFade() as boolean
      return false
    end function

    override function isEligibleForStaticBsp() as boolean
      return false
    end function

    protected override function isPotentiallyOnScreen(cameraObj as Camera) as boolean
      return true
    end function

    ' Only requests a walk, so performDraw() walks at most once per draw - and not at all when
    ' only the lights changed.
    protected override function findCanvasPosition(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      if not m.hasCamera3d(rendererObj)
        return false
      end if
      camera = rendererObj.camera
      if m.lastFrameWasCulled or not m.hasValidCanvasPosition or m.isFirstFrameSinceEnabled or m.objMovedInRelationToCamera(camera) or m.geometryChanged() or m.projectionChanged(camera) or m.drawModeChanged(drawMode)
        m.castRequested = true
      end if
      return true
    end function

    ' Walks the view for rendererObj's camera now. The renderer does this each frame the
    ' camera changes; call it yourself only in tests.
    '
    ' @param {Renderer} rendererObj
    ' @return {boolean} false with a Camera2d, or a camera looking straight up or down
    function updateView(rendererObj as Renderer) as boolean
      m.rendererObj = rendererObj
      if not m.hasCamera3d(rendererObj)
        return false
      end if
      d = m.drawable
      if m.viewGeometryVersion <> d.geometryVersion
        m.view.setSegments(d.segments, d.getBsp())
        m.segmentColumns = []
        m.segmentTiles = []
        m.segmentTexels = []
        m.segmentInvHeights = []
        m.lightCache = {}
        m.viewGeometryVersion = d.geometryVersion
      end if
      m.view.hideTolerance = d.hideTolerance
      m.viewStripWidth = m.getStripWidth(rendererObj)
      camera = rendererObj.camera as Camera3d
      m.view.lodDepth = m.getLodDepth(rendererObj, camera)
      m.keyValid = false
      if not m.view.update(camera, m.viewStripWidth, m.getWalkFar(camera))
        return false
      end if
      m.viewStamp++
      m.keyX = camera.position.x
      m.keyY = camera.position.y
      m.keyZ = camera.position.z
      m.keyOx = camera.orientation.x
      m.keyOy = camera.orientation.y
      m.keyOz = camera.orientation.z
      m.keyRoll = camera.rollDegrees
      m.keyFocal = camera.getFocalLength()
      m.keyFar = m.getWalkFar(camera)
      m.keyW = camera.frameSize.x
      m.keyH = camera.frameSize.y
      m.keyLod = m.view.lodDepth
      m.keyRecord = m.view.recordSurfaces
      m.keyValid = true
      return true
    end function

    ' Walks the view now unless it was already walked for the camera as it is, so its pieces
    ' and surfaces (WallsView.recordSurfaces) can be read before render(), which then reuses
    ' the walk. Call after Renderer.setupCameraForFrame().
    '
    ' @param {Renderer} rendererObj
    ' @return {boolean} false with a Camera2d, or a camera looking straight up or down
    function prepareView(rendererObj as Renderer) as boolean
      if not m.hasCamera3d(rendererObj)
        return false
      end if
      if m.viewMatches(rendererObj, rendererObj.camera as Camera3d)
        return m.view.rayCount > 0
      end if
      return m.updateView(rendererObj)
    end function

    ' How far out strips are widened over two rays (WallsView.lodDepth); 0 for none.
    private function getLodDepth(rendererObj as Renderer, camera as Camera3d) as float
      fraction = rendererObj.qualitySettings.wallLodDistanceFraction
      if fraction > 0 and fraction < 1
        return camera.getCurrentDrawDistance() * fraction
      end if
      return 0
    end function

    ' How far out to walk: past the draw distance to the fog's silhouette reach while the walls
    ' cast fog silhouettes (see BGE.Fog), else the draw distance.
    private function getWalkFar(camera as Camera3d) as float
      return camera.getCurrentDrawDistance() * m.getWalkReach(camera)
    end function

    ' getWalkFar() as a multiple of the draw distance: past it, the walls can't hide anything.
    '
    ' @param {Camera3d} camera
    ' @return {float}
    function getWalkReach(camera as Camera3d) as float
      fog = camera.fog
      if fog.enabled and fog.silhouetteReach > 1 and m.drawable.castsFogSilhouette
        return fog.silhouetteReach
      end if
      return 1.0
    end function

    ' True when the last walk's settings (strip width, LOD, recording, geometry, how far) still
    ' hold.
    private function walkSettingsMatch(rendererObj as Renderer, camera as Camera3d) as boolean
      return m.keyFar = m.getWalkFar(camera) and m.keyValid and m.viewGeometryVersion = m.drawable.geometryVersion and m.viewStripWidth = m.getStripWidth(rendererObj) and m.keyRecord = m.view.recordSurfaces and m.keyLod = m.getLodDepth(rendererObj, camera)
    end function

    ' True when the last walk was for this camera and walkSettingsMatch().
    private function viewMatches(rendererObj as Renderer, camera as Camera3d) as boolean
      if not m.walkSettingsMatch(rendererObj, camera)
        return false
      end if
      p = camera.position
      o = camera.orientation
      return p.x = m.keyX and p.y = m.keyY and p.z = m.keyZ and o.x = m.keyOx and o.y = m.keyOy and o.z = m.keyOz and camera.rollDegrees = m.keyRoll and camera.getFocalLength() = m.keyFocal and camera.frameSize.x = m.keyW and camera.frameSize.y = m.keyH
    end function

    ' Draws again, far to near, the strips drawn this frame on rays firstRay..lastRay nearer
    ' than nearerThan - to put walls back over something drawn after them.
    '
    ' @param {Renderer} rendererObj
    ' @param {integer} firstRay
    ' @param {integer} lastRay
    ' @param {float} nearerThan forward depth
    sub redrawStrips(rendererObj as Renderer, firstRay as integer, lastRay as integer, nearerThan as float)
      view = m.view
      if firstRay < 0
        firstRay = 0
      end if
      if lastRay > view.rayCount - 1
        lastRay = view.rayCount - 1
      end if
      order = m.redrawOrder
      depths = view.pieceDepth
      nexts = view.pieceNext
      for i = firstRay to lastRay
        order.Clear()
        k = view.rayFirstPiece[i]
        while k >= 0 and depths[k] < nearerThan
          order.push(k)
          k = nexts[k]
        end while
        for n = order.count() - 1 to 0 step -1
          m.drawPiece(rendererObj, order[n])
        end for
      end for
      order.Clear()
    end sub

    protected override function performDraw(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      if not m.hasCamera3d(rendererObj)
        return false
      end if
      m.rendererObj = rendererObj
      ' read every frame: hiding uses it whether or not the walls are walked again
      m.view.hideTolerance = m.drawable.hideTolerance
      camera = rendererObj.camera as Camera3d
      profile = rendererObj.profileStages
      lap = 0
      if profile
        lap = rendererObj.getProfileClockMs()
      end if
      if m.castRequested or m.viewStamp = 0 or camera.farDistanceChangedThisFrame() or not m.walkSettingsMatch(rendererObj, camera)
        m.castRequested = false
        ' prepareView() may have walked for this camera already
        if not m.viewMatches(rendererObj, camera)
          if not m.updateView(rendererObj)
            return false
          end if
        end if
      end if
      if profile
        lap = m.lapStage(rendererObj, "wallsWalk", lap)
      end if
      m.raysLastFrame = m.view.rayCount
      m.shadePieces(rendererObj, camera)
      if profile
        lap = m.lapStage(rendererObj, "wallsShade", lap)
      end if
      m.stripsDrawnLastFrame = m.drawPieces(rendererObj)
      if profile
        m.lapStage(rendererObj, "wallsStrips", lap)
      end if
      return true
    end function

    ' Draws every piece, far to near; returns how many drew.
    private function drawPieces(rendererObj as Renderer) as integer
      view = m.view
      pX = view.pieceX
      pY = view.pieceY
      pWidth = view.pieceWidth
      pAngle = view.pieceAngle
      pColumn = m.pieceColumn
      pScaleY = m.pieceScaleY
      rgbas = m.pieceRgba
      draw2d = rendererObj.getDraw2d()
      fogColumn = m.fogColumn
      drawn = 0
      fogDrawn = m.fogRunX.count()
      runX = m.fogRunX
      runY = m.fogRunY
      runWidth = m.fogRunWidth
      runScale = m.fogRunScale
      runAngle = m.fogRunAngle
      fogRgba = m.fogRunRgba
      for i = 0 to fogDrawn - 1
        draw2d.DrawTransformedObject(runX[i], runY[i], runAngle[i], runWidth[i], runScale[i], fogColumn, fogRgba)
      end for
      for k = view.pieceCount - 1 to 0 step -1
        column = pColumn[k]
        if invalid <> column
          draw2d.DrawTransformedObject(pX[k], pY[k], pAngle[k], pWidth[k], pScaleY[k], column, rgbas[k])
          drawn++
        end if
      end for
      m.fogStripsDrawnLastFrame = fogDrawn
      rendererObj.incrementDrawCalls(drawn + fogDrawn)
      return drawn + fogDrawn
    end function

    ' Draws piece k (see drawPieces()).
    private sub drawPiece(rendererObj as Renderer, k as integer)
      column = m.pieceColumn[k]
      if invalid = column
        return
      end if
      view = m.view
      rendererObj.getDraw2d().DrawTransformedObject(view.pieceX[k], view.pieceY[k], view.pieceAngle[k], view.pieceWidth[k], m.pieceScaleY[k], column, m.pieceRgba[k])
      rendererObj.incrementDrawCalls(1)
    end sub

    ' Sets each piece's rgba: the tint, lit from its segment's light cache, then faded.
    private sub shadePieces(rendererObj as Renderer, camera as Camera3d)
      d = m.drawable
      view = m.view
      base = d.getFillColorRGBA()
      fog = camera.fog
      fogColor = -1
      if fog.enabled and fog.silhouetteReach > 0 and m.drawable.castsFogSilhouette
        fogColor = fog.color
      end if
      fogStart = fog.silhouetteStartAlpha
      if fogColor = m.shadeFogColor and fogStart = m.shadeFogStart and m.shadeStamp = m.viewStamp and not m.lightingChangedThisDraw and not m.qualityChangedThisDraw and base = m.shadeBase and d.isShaded = m.shadeShaded and d.ambientBrightness = m.shadeAmbient and d.lightWrap = m.shadeWrap and d.mipmapped = m.shadeMipmapped
        return
      end if
      if d.mipmapped <> m.shadeMipmapped
        m.shadeMipmapped = d.mipmapped
        m.segmentColumns = []
        m.segmentTiles = []
        m.segmentTexels = []
        m.segmentInvHeights = []
      end if
      ' with no lights, shading follows the camera, so it's only cached within a frame
      if m.lightingChangedThisDraw or base <> m.shadeBase or d.isShaded <> m.shadeShaded or d.ambientBrightness <> m.shadeAmbient or d.lightWrap <> m.shadeWrap or not rendererObj.hasLights()
        m.lightCache = {}
      end if
      m.shadeStamp = m.viewStamp
      m.shadeFogColor = fogColor
      m.shadeFogStart = fogStart
      m.shadeBase = base
      m.shadeShaded = d.isShaded
      m.shadeAmbient = d.ambientBrightness
      m.shadeWrap = d.lightWrap

      segs = d.segments
      columns = m.segmentColumns
      for i = columns.count() to segs.count() - 1
        segLevels = d.getMipColumns(segs[i].texture, segs[i].tileCount)
        columns.push(segLevels)
        tiles = 0.0
        if segs[i].tileWidth > 0
          tiles = segs[i].length / segs[i].tileWidth
        end if
        m.segmentTiles.push(tiles)
        invHeight = 1.0
        texels = 0.0
        if invalid <> segLevels
          full = segLevels[0]
          ' every column is cut from one texture, so they share its height
          invHeight = 1.0 / full[0].GetHeight()
          texels = full.count() * BGE.Math.Max(tiles, 1)
        end if
        m.segmentTexels.push(texels)
        m.segmentInvHeights.push(invHeight)
      end for

      far = camera.getCurrentDrawDistance()
      fraction = camera.drawDistanceFadeFraction
      if fraction > 1
        fraction = 1.0
      end if
      bandStart = far * (1 - fraction)
      fades = fraction > 0
      rgbas = m.pieceRgba
      pColumn = m.pieceColumn
      pScaleY = m.pieceScaleY
      pFog = m.pieceFogUnder
      pFogOnly = m.pieceFogOnly
      for k = rgbas.count() to view.pieceCount - 1
        rgbas.push(base)
        pColumn.push(invalid)
        pScaleY.push(1.0)
        pFog.push(false)
        pFogOnly.push(false)
      end for
      ' fog strips: solid under pieces whose fade alpha is below fogStart, and alone past
      ' the draw distance
      fogs = fogColor >= 0
      fogBase = 0
      if fogs
        fogBase = fogColor << 8
        if invalid = m.fogColumn
          m.fogColumn = m.createFogColumn()
        end if
      end if
      pSeg = view.pieceSegment
      pAlong = view.pieceAlong
      pDepth = view.pieceDepth
      pLength = view.pieceLength
      pX = view.pieceX
      pWidth = view.pieceWidth
      segTiles = m.segmentTiles
      segTexels = m.segmentTexels
      segInvHeights = m.segmentInvHeights
      shaded = d.isShaded
      lastSegment = -1
      shades = invalid
      lastBucket = 0
      segLevels = invalid
      lastLevel = 0
      texels = 0.0
      dudx = 0.0
      pieceCount = view.pieceCount
      tiles = 0.0
      invHeight = 1.0
      for k = 0 to pieceCount - 1
        n = pSeg[k]
        u = pAlong[k]
        if n <> lastSegment
          lastSegment = n
          segLevels = columns[n]
          lastLevel = -1
          if invalid <> segLevels
            lastLevel = segLevels.count() - 1
          end if
          texels = segTexels[n]
          dudx = 0.0
          tiles = segTiles[n]
          invHeight = segInvHeights[n]
          if shaded
            shades = m.segmentShades(rendererObj, n, base)
            lastBucket = shades.count() - 1
          end if
        end if
        shade = base
        if shaded
          shade = shades[int(u * lastBucket + 0.5)]
        end if
        depth = pDepth[k]
        if fogs
          pFog[k] = false
          pFogOnly[k] = false
        end if
        if fogs and depth >= far
          ' past the draw distance: only a fog strip, merged with its neighbours below
          pFogOnly[k] = true
          pColumn[k] = invalid
          rgbas[k] = shade
        else
          if fades and depth > bandStart
            alpha = (far - depth) / (far - bandStart)
            shade = BGE.RendererHelpers.applyAlphaFade(shade, alpha)
            ' solid fog under it, so the faded wall and the fog add up to fully opaque
            if fogs and alpha < fogStart
              pFog[k] = true
            end if
          end if
          rgbas[k] = shade
          ' the texture column, picked here so drawing is just the draw call
          if lastLevel >= 0
            ' how far along the wall each pixel across is, from a neighbouring strip of it (else
            ' the last one's)
            x = pX[k]
            j = k + 1
            if j >= pieceCount or pSeg[j] <> n or Abs(pX[j] - x) < 0.5
              j = k - 1
            end if
            if j >= 0 and pSeg[j] = n and Abs(pX[j] - x) >= 0.5
              dudx = (pAlong[j] - u) / (pX[j] - x)
            end if
            ' sample the strip's middle, not its left edge
            width = pWidth[k]
            u += dudx * width * 0.5
            if u < 0
              u = 0.0
            else if u > 1
              u = 1.0
            end if
            ' the coarsest level that still has a column or more per strip, so no column is
            ' skipped outright
            span = Abs(dudx) * width * texels
            level = 0
            while span >= 1.5 and level < lastLevel
              span *= 0.5
              level++
            end while
            if tiles > 0
              along = u * tiles
              u = along - int(along)
            end if
            ' via the full-size column, as a level with an odd count's last column covers fewer
            fullCount = segLevels[0].count()
            ci = int(u * fullCount)
            if ci >= fullCount
              ci = fullCount - 1
            end if
            pColumn[k] = segLevels[level][ci >> level]
            pScaleY[k] = pLength[k] * invHeight
          else
            pColumn[k] = invalid
          end if
        end if
      end for
      if fogs
        m.fogRunRgba = fogBase + &hFF
        m.buildFogRuns()
      else if m.fogRunX.count() > 0
        m.fogRunX.Clear()
        m.fogRunY.Clear()
        m.fogRunWidth.Clear()
        m.fogRunScale.Clear()
        m.fogRunAngle.Clear()
      end if
    end sub

    ' Merges fog strips into runs of up to maxFogRun touching strips of one wall, each as tall
    ' as the tallest of them: the fog-only pieces past the draw distance, and the solid fog
    ' under fading pieces. All are drawn first: those past the draw distance are behind every
    ' textured strip, and one under a fading piece only differs where a farther fading piece
    ' shows through, which it then covers instead.
    private sub buildFogRuns()
      view = m.view
      runX = m.fogRunX
      runY = m.fogRunY
      runWidth = m.fogRunWidth
      runScale = m.fogRunScale
      runAngle = m.fogRunAngle
      runX.Clear()
      runY.Clear()
      runWidth.Clear()
      runScale.Clear()
      runAngle.Clear()
      pFog = m.pieceFogUnder
      pFogOnly = m.pieceFogOnly
      pSeg = view.pieceSegment
      pX = view.pieceX
      pY = view.pieceY
      pWidth = view.pieceWidth
      pLength = view.pieceLength
      pAngle = view.pieceAngle
      invHeight = 1.0 / m.fogColumnHeight
      count = view.pieceCount
      maxRun = m.maxFogRun
      k = 0
      while k < count
        fogOnly = pFogOnly[k]
        if fogOnly or pFog[k]
          pFog[k] = false
          seg = pSeg[k]
          minX = pX[k]
          maxX = minX + pWidth[k]
          foot = pY[k]
          top = foot - pLength[k]
          angles = pAngle[k]
          n = 1
          j = k + 1
          while j < count and n < maxRun
            if pFogOnly[j] <> fogOnly or pSeg[j] <> seg or (not fogOnly and not pFog[j])
              exit while
            end if
            x = pX[j]
            right = x + pWidth[j]
            ' touching the run on either side
            if x > maxX + 1.5 or right < minX - 1.5
              exit while
            end if
            if x < minX
              minX = x
            end if
            if right > maxX
              maxX = right
            end if
            if pY[j] > foot
              foot = pY[j]
            end if
            if pY[j] - pLength[j] < top
              top = pY[j] - pLength[j]
            end if
            angles += pAngle[j]
            pFog[j] = false
            n++
            j++
          end while
          runX.push(minX)
          runY.push(foot)
          runWidth.push(maxX - minX)
          runScale.push((foot - top) * invHeight)
          runAngle.push(angles / n)
          k = j
        else
          k++
        end if
      end while
    end sub

    ' Lit colors along segment n for the side the eye is on, from the cache.
    private function segmentShades(rendererObj as Renderer, n as integer, base as integer) as integer[]
      d = m.drawable
      seg = d.segments[n]
      nx = seg.normalX
      nz = seg.normalZ
      side = 0
      if (m.view.originX - seg.ax) * nx + (m.view.originZ - seg.az) * nz < 0
        side = 1
        nx = -nx
        nz = -nz
      end if
      key = (n * 2 + side).toStr()
      shades = m.lightCache[key]
      if invalid <> shades
        return shades
      end if
      bucketLength = d.lightBucketLength
      if bucketLength <= 0
        bucketLength = seg.length + 1
      end if
      buckets = int(seg.length / bucketLength) + 1
      shades = [] as integer[]
      normal = m.shadeNormal
      normal.x = nx
      normal.y = 0
      normal.z = nz
      point = m.shadePoint
      hasLights = rendererObj.hasLights()
      for b = 0 to buckets
        f = b / buckets
        point.x = seg.ax + (seg.bx - seg.ax) * f
        point.y = (seg.bottom + seg.top) * 0.5
        point.z = seg.az + (seg.bz - seg.az) * f
        if hasLights
          shades.push(BGE.Lighting.shadeColor(base, rendererObj.getPreparedLights(), point, normal, d.ambientBrightness, d.lightWrap))
        else
          facing = getOutwardNormalFacingAmount(rendererObj, point, normal)
          shades.push(BGE.colorBrightness(base, BGE.Math.Max(facing, d.ambientBrightness)))
        end if
      end for
      m.lightCache[key] = shades
      return shades
    end function

    ' A white 1px column for fog strips, pre-translated so its foot is at the draw point (see
    ' DrawableWalls.getColumns())
    private function createFogColumn() as object
      height = cint(m.fogColumnHeight)
      bitmap = CreateObject("roBitmap", {width: 1, height: height, alphaEnable: false})
      bitmap.Clear(&hFFFFFFFF)
      column = CreateObject("roRegion", bitmap, 0, 0, 1, height)
      column.SetPreTranslation(0, -height)
      return column
    end function

    private function lapStage(rendererObj as Renderer, name as string, lap as integer) as integer
      now = rendererObj.getProfileClockMs()
      rendererObj.addStageMs(name, now - lap)
      return now
    end function

    private function hasCamera3d(rendererObj as Renderer) as boolean
      if rendererObj.camera.name = "Camera3d"
        return true
      end if
      if not m.warnedCamera2d
        m.warnedCamera2d = true
        m.drawable.log("Drawable '" + m.drawable.name + "' (walls) needs a Camera3d - it draws nothing with a " + rendererObj.camera.name, BGE.Debug.LogLevel.warning)
      end if
      return false
    end function

    private function getStripWidth(rendererObj as Renderer) as integer
      width = rendererObj.qualitySettings.wallStripWidth
      if width < 1
        width = 1
      end if
      return width
    end function

  end class

end namespace
