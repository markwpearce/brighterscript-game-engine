namespace tests

  ' SceneObjectModel is the one SceneObject type with a variable number of per-frame draw
  ' primitives (one per triangle face), unlike every other SceneObject type which is always
  ' exactly 1. These tests drive the same update/draw passes Renderer.drawScene() runs and
  ' assert on the cluster draw contract (getPrimitiveCount/getPrimitiveDepth/drawPrimitive)
  ' that Renderer's interleaved cluster draw loop depends on.
  @suite("BGE.SceneObjectModel")
  class SceneObjectModelTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap)
      m.entity.position = BGE.Math.VectorOps.create(100, 50, 0)
    end function

    @describe("drawable field")

    @it("is set by direct construction, not just via addToScene (issue #69)")
    function _()
      face = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      model = new BGE.Model3d([face])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      sceneObj = new BGE.SceneObjectModel("test", drawableModel)
      m.assertNotInvalid(sceneObj.drawable)
    end function

    @describe("textured faces")

    function makeTexturedFace() as BGE.Model3dFace
      face = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      textureBitmap = CreateObject("roBitmap", {width: 8, height: 8, alphaEnable: true})
      region = CreateObject("roRegion", textureBitmap, 0, 0, 8, 8)
      regionWithId = BGE.RendererHelpers.createRegionWithId(region, "test-texture")
      face.Texture = new BGE.Model3dTexture(regionWithId, [
        BGE.Math.VectorOps.create(0, 0, 0),
        BGE.Math.VectorOps.create(8, 0, 0),
        BGE.Math.VectorOps.create(4, 8, 0)
      ])
      return face
    end function

    @it("draws a textured face via the solo draw path without crashing, using drawBitmapTriangle")
    function _()
      face = m.makeTexturedFace()
      model = new BGE.Model3d([face])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      m.renderer.resetDrawCallCounter()
      sceneObj.draw(m.renderer)
      m.assertTrue(m.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("draws a textured face via the cluster drawPrimitive path without crashing, and can repeat across frames without leaking staged regions")
    function _()
      face = m.makeTexturedFace()
      model = new BGE.Model3d([face])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)
      for i = 1 to 5
        m.renderer.resetDrawCallCounter()
        result = sceneObj.drawPrimitive(m.renderer, 0)
        m.assertTrue(result)
        m.assertTrue(m.renderer.getDrawCallsLastFrame() > 0)
      end for
    end function

    @it("still draws an untextured face via the flat-color path (no regression)")
    function _()
      face1 = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      model = new BGE.Model3d([face1])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      m.renderer.resetDrawCallCounter()
      sceneObj.draw(m.renderer)
      m.assertTrue(m.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("does not crash drawing a face whose Texture is still an unfinalized placeholder (invalid region)")
    function _()
      face = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      ' Exactly what OBJParser.appendOBJFace produces before applyTexture() finalizes
      ' it - an invalid region, the same placeholder shape a face is left with when
      ' texture resolution/loading fails and Model3dOps.clearTextures isn't called.
      face.Texture = new BGE.Model3dTexture(BGE.RendererHelpers.createRegionWithId(invalid, ""), [
        BGE.Math.VectorOps.create(0, 0, 0),
        BGE.Math.VectorOps.create(8, 0, 0),
        BGE.Math.VectorOps.create(4, 8, 0)
      ])
      model = new BGE.Model3d([face])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      m.renderer.resetDrawCallCounter()
      sceneObj.draw(m.renderer)
      ' Completing without throwing is the assertion - this is the exact crash
      ' scenario (issue #89 final review finding) being fixed.
      m.assertTrue(true)
    end function

    @describe("getPrimitiveCount / getPrimitiveDepth / drawPrimitive (cluster draw contract)")

    @it("getPrimitiveCount reflects the actual number of faces, not the base class's default of 1")
    function _()
      face1 = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      face2 = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 5), BGE.Math.VectorOps.create(10, -10, 5), BGE.Math.VectorOps.create(0, 10, 5)])
      model = new BGE.Model3d([face1, face2])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.orientedDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      ' modelCanvasFaces (which getPrimitiveCount reads) is only rebuilt by
      ' updateCanvasPosition, which runs inside draw() (via findCanvasPosition), not
      ' update() - a real draw() call is needed first, exactly like the real per-frame
      ' flow (SceneObject.draw() always runs before Renderer.drawPendingClusterPrimitives()
      ' calls getPrimitiveCount() later in the same frame).
      sceneObj.draw(m.renderer)
      m.assertEqual(2, sceneObj.getPrimitiveCount())
    end function

    @it("drawPrimitive draws a face directly, without going through the whole-model temp bitmap cache")
    function _()
      face1 = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      model = new BGE.Model3d([face1])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      ' A real draw() call first, exactly like the real per-frame flow takes - this
      ' establishes lastDrawMode/modelCanvasFaces, which drawPrimitive relies on
      ' (SceneObject.draw() always runs before Renderer.drawPendingClusterPrimitives()
      ' ever calls drawPrimitive() later in the same frame).
      sceneObj.draw(m.renderer)
      m.assertEqual(1, sceneObj.getPrimitiveCount())
      m.renderer.resetDrawCallCounter()
      result = sceneObj.drawPrimitive(m.renderer, 0)
      m.assertTrue(result)
      m.assertTrue(m.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("getPrimitiveDepth returns the negated face priority (negative-in-front convention, matching negDistanceFromCamera)")
    function _()
      face1 = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      model = new BGE.Model3d([face1])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      ' modelCanvasFaces (which getPrimitiveDepth reads) is only rebuilt inside draw()
      ' (see the other tests in this suite for why).
      sceneObj.draw(m.renderer)
      m.assertEqual(1, sceneObj.getPrimitiveCount())
      ' The base class's contract (see SceneObject.getPrimitiveDepth's doc comment) is
      ' negative in front of the camera - the raw face priority computed in
      ' updateCanvasPosition is a positive distance-like value, so getPrimitiveDepth
      ' must negate it, not return it directly.
      m.assertTrue(sceneObj.getPrimitiveDepth(0) < 0)
    end function

    @it("getPrimitiveDepth ranks a closer face as greater (less negative) than a farther face - descending sort must draw farthest-first (issue #112)")
    function _()
      ' A default (unpositioned) 2d camera measures distanceFromCameraFront as
      ' `camera.position.z - point.z` (see Camera2d.distanceFromCameraFront), so a more
      ' negative world z is farther from the camera. faceFar's vertices sit well behind
      ' faceNear's.
      faceNear = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, -5), BGE.Math.VectorOps.create(10, -10, -5), BGE.Math.VectorOps.create(0, 10, -5)])
      faceFar = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, -500), BGE.Math.VectorOps.create(10, -10, -500), BGE.Math.VectorOps.create(0, 10, -500)])
      model = new BGE.Model3d([faceFar, faceNear])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)
      m.assertEqual(2, sceneObj.getPrimitiveCount())
      ' modelCanvasFaces is sorted descending by priority (farthest first, fixed per issue
      ' #112), so index 0 is faceFar and index 1 is faceNear regardless of the model's own
      ' face order above.
      farDepth = sceneObj.getPrimitiveDepth(0)
      nearDepth = sceneObj.getPrimitiveDepth(1)
      m.assertTrue(nearDepth < 0)
      m.assertTrue(farDepth < 0)
      m.assertTrue(nearDepth > farDepth)
    end function

    @describe("intra-model solo draw order (issue #112)")

    @it("stores the farthest face first and the nearest face last, so the solo draw loop paints farthest-first (painter's algorithm)")
    function _()
      ' Two faces at very different depths from the camera - faceFar should be
      ' drawn first (as background), faceNear drawn last (on top, correctly
      ' occluding faceFar if they overlapped on screen).
      faceNear = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, -5), BGE.Math.VectorOps.create(10, -10, -5), BGE.Math.VectorOps.create(0, 10, -5)])
      faceFar = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, -500), BGE.Math.VectorOps.create(10, -10, -500), BGE.Math.VectorOps.create(0, 10, -500)])
      model = new BGE.Model3d([faceNear, faceFar])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)
      m.assertEqual(2, sceneObj.getPrimitiveCount())
      ' getPrimitiveDepth(index) reads -m.modelCanvasFaces[index].priority (more
      ' negative = farther). Index 0 must be the farthest face (drawn first, as
      ' background) and the last index must be the nearest face (drawn last, on
      ' top) - this directly verifies modelCanvasFaces' stored order without
      ' needing pixel-level rendering readback.
      m.assertTrue(sceneObj.getPrimitiveDepth(0) < sceneObj.getPrimitiveDepth(1))
    end function

    @describe("temp bitmap reuse (issue #128/#163)")

    ' No prior tempBitmap/limitPointMap exists yet at this point (no draw() call has
    ' happened), so the base class's own check already returns invalid regardless of
    ' the rotation gate below - see the "gates whole-model reuse..." tests further down
    ' for real coverage of that gate across two actual frames.
    @it("reports no reusable transform before anything has ever been drawn")
    function _()
      face = m.makeTexturedFace()
      model = new BGE.Model3d([face])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      m.assertFalse((sceneObj as BGE.SceneObjectModel).canReuseTransformedTempBitmap(m.renderer, BGE.SceneObjectDrawMode.oriented))
    end function

    @describe("ambientBrightness floor (issue #128 follow-up)")

    ' A face lying flat in the camera's own XZ plane (normal along Y) is exactly
    ' edge-on to a Camera3d looking down -Z from (0, 0, 1000) - the camera-facing dot
    ' product is exactly 0, which colorBrightness's own [0,1] clamp alone would render
    ' as pure black (this is what was actually happening in examples/3d's D20Room,
    ' mistaken at first for a draw failure rather than a shading gap - see #128).
    @it("never lets an edge-on shaded face's brightness reach zero")
    function _()
      game3d = new BGE.Game(320, 240)
      entity3d = new BGE.GameEntity(game3d, {name: "TestEntity3d"})
      bitmap3d = CreateObject("roBitmap", {width: 320, height: 240, alphaEnable: true})
      renderer3d = new BGE.Renderer(bitmap3d, game3d, new BGE.Camera3d())
      entity3d.position = BGE.Math.VectorOps.create(0, 0, 0)

      face = BGE.Model3dFaceOps.create([
        BGE.Math.VectorOps.create(-10, 0, -10),
        BGE.Math.VectorOps.create(10, 0, -10),
        BGE.Math.VectorOps.create(0, 0, 10)
      ])
      model = new BGE.Model3d([face])
      drawableModel = new BGE.DrawableModel(entity3d, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(renderer3d) as BGE.SceneObjectModel
      entity3d.updateTransformationMatrix()
      renderer3d.setupCameraForFrame()
      renderer3d.drawScene()

      m.assertEqual(1, sceneObj.getPrimitiveCount())
      m.assertTrue(sceneObj.getFaceBrightness(0) >= drawableModel.ambientBrightness)
    end function

    @describe("per-face raster reuse (issue #163)")

    ' A textured, continuously-rotating model was paying the full drawBitmapTriangleTo
    ' pipeline for every visible face on every single frame after #128's fix disabled
    ' the (unsound) whole-model reuse - this is what actually cuts that cost back down:
    ' each face reuses its own last-rendered raster (repositioned, not redrawn) for
    ' maxStaleFrames frames before a real redraw, alternating fresh/reused/fresh/...
    @it("redraws a face fresh, then reuses its cache once, then redraws fresh again")
    function _()
      game3d = new BGE.Game(320, 240)
      entity3d = new BGE.GameEntity(game3d, {name: "TestEntity3d"})
      bitmap3d = CreateObject("roBitmap", {width: 320, height: 240, alphaEnable: true})
      renderer3d = new BGE.Renderer(bitmap3d, game3d, new BGE.Camera3d())
      entity3d.position = BGE.Math.VectorOps.create(0, 0, 500)

      face = m.makeTexturedFace()
      model = new BGE.Model3d([face])
      drawableModel = new BGE.DrawableModel(entity3d, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.orientedDrawBackFace
      sceneObj = drawableModel.addToScene(renderer3d) as BGE.SceneObjectModel

      staleCounts = []
      for i = 1 to 3
        entity3d.rotation = BGE.Math.VectorOps.create(0, 0.01 * i, 0)
        entity3d.updateTransformationMatrix()
        renderer3d.setupCameraForFrame()
        renderer3d.drawScene()
        staleCounts.push(sceneObj.getFaceStaleFrameCount(0))
      end for

      m.assertEqual(0, staleCounts[0]) ' frame 1: no cache yet, fresh redraw
      m.assertEqual(1, staleCounts[1]) ' frame 2: reused (maxStaleFrames defaults to 1)
      m.assertEqual(0, staleCounts[2]) ' frame 3: maxStaleFrames reached, fresh again
    end function

    ' DrawableModel.maxStaleFrames is the tunable knob - confirms it's actually read,
    ' not just a hardcoded default.
    @it("never reuses when maxStaleFrames is set to 0")
    function _()
      game3d = new BGE.Game(320, 240)
      entity3d = new BGE.GameEntity(game3d, {name: "TestEntity3d"})
      bitmap3d = CreateObject("roBitmap", {width: 320, height: 240, alphaEnable: true})
      renderer3d = new BGE.Renderer(bitmap3d, game3d, new BGE.Camera3d())
      entity3d.position = BGE.Math.VectorOps.create(0, 0, 500)

      face = m.makeTexturedFace()
      model = new BGE.Model3d([face])
      drawableModel = new BGE.DrawableModel(entity3d, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.orientedDrawBackFace
      drawableModel.maxStaleFrames = 0
      sceneObj = drawableModel.addToScene(renderer3d) as BGE.SceneObjectModel

      for i = 1 to 3
        entity3d.rotation = BGE.Math.VectorOps.create(0, 0.01 * i, 0)
        entity3d.updateTransformationMatrix()
        renderer3d.setupCameraForFrame()
        renderer3d.drawScene()
        m.assertEqual(0, sceneObj.getFaceStaleFrameCount(0))
      end for
    end function

    @it("keeps drawing correctly across many frames of continuous rotation")
    function _()
      game3d = new BGE.Game(320, 240)
      entity3d = new BGE.GameEntity(game3d, {name: "TestEntity3d"})
      bitmap3d = CreateObject("roBitmap", {width: 320, height: 240, alphaEnable: true})
      renderer3d = new BGE.Renderer(bitmap3d, game3d, new BGE.Camera3d())
      entity3d.position = BGE.Math.VectorOps.create(0, 0, 500)

      face = m.makeTexturedFace()
      model = new BGE.Model3d([face])
      drawableModel = new BGE.DrawableModel(entity3d, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.orientedDrawBackFace
      drawableModel.addToScene(renderer3d)

      totalDrawCalls = 0
      for i = 1 to 10
        entity3d.rotation = BGE.Math.VectorOps.create(0, 0.05 * i, 0)
        entity3d.updateTransformationMatrix()
        renderer3d.resetDrawCallCounter()
        renderer3d.setupCameraForFrame()
        renderer3d.drawScene()
        totalDrawCalls += renderer3d.getDrawCallsLastFrame()
      end for
      m.assertTrue(totalDrawCalls > 0)
    end function

  end class

end namespace
