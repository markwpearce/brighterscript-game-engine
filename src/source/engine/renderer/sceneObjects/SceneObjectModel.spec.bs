namespace tests

  ' SceneObjectModel is the one SceneObject type with a variable number of per-frame draw
  ' primitives (one per triangle face), unlike every other SceneObject type which is always
  ' exactly 1. These tests drive the same update/draw passes Renderer.drawScene() runs and
  ' assert on the cluster draw contract (getPrimitiveCount/getPrimitiveDepth/drawPrimitive)
  ' that Renderer's interleaved cluster draw loop depends on.
  @suite("BGE.SceneObjectModel")
  class SceneObjectModelTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap)
      m.entity.position = BGE.Math.VectorOps.create(100, 50, 0)
    end function

    @describe("getPrimitiveCount / getPrimitiveDepth / drawPrimitive (cluster draw contract)")

    @it("getPrimitiveCount reflects the actual number of faces, not the base class's default of 1")
    function _()
      face1 = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      face2 = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 5), BGE.Math.VectorOps.create(10, -10, 5), BGE.Math.VectorOps.create(0, 10, 5)])
      model = new BGE.Model3d([face1, face2])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.orientedDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      ' modelCanvasFaces (which getPrimitiveCount reads) is only rebuilt by
      ' updateCanvasPosition, which runs inside draw() (via findCanvasPosition), not
      ' update() - a real draw() call is needed first, exactly like the real per-frame
      ' flow (SceneObject.draw() always runs before Renderer.drawPendingClusterPrimitives()
      ' calls getPrimitiveCount() later in the same frame).
      sceneObj.draw(m.renderer)
      m.assertEqual(2, sceneObj.getPrimitiveCount())
    end function

    @it("drawPrimitive draws a face directly, without going through the whole-model temp bitmap cache")
    function _()
      face1 = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      model = new BGE.Model3d([face1])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      ' A real draw() call first, exactly like the real per-frame flow takes - this
      ' establishes lastDrawMode/modelCanvasFaces, which drawPrimitive relies on
      ' (SceneObject.draw() always runs before Renderer.drawPendingClusterPrimitives()
      ' ever calls drawPrimitive() later in the same frame).
      sceneObj.draw(m.renderer)
      m.assertEqual(1, sceneObj.getPrimitiveCount())
      m.renderer.resetDrawCallCounter()
      result = sceneObj.drawPrimitive(m.renderer, 0)
      m.assertTrue(result)
      m.assertTrue(m.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("getPrimitiveDepth returns the same value as the face's own priority")
    function _()
      face1 = BGE.Model3dFaceOps.create([BGE.Math.VectorOps.create(-10, -10, 0), BGE.Math.VectorOps.create(10, -10, 0), BGE.Math.VectorOps.create(0, 10, 0)])
      model = new BGE.Model3d([face1])
      drawableModel = new BGE.DrawableModel(m.entity, model)
      drawableModel.drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
      sceneObj = drawableModel.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      sceneObj.update(m.renderer.camera)
      ' modelCanvasFaces (which getPrimitiveDepth reads) is only rebuilt inside draw()
      ' (see the other tests in this suite for why).
      sceneObj.draw(m.renderer)
      m.assertEqual(1, sceneObj.getPrimitiveCount())
      m.assertTrue(sceneObj.getPrimitiveDepth(0) <> invalid)
    end function

  end class

end namespace
