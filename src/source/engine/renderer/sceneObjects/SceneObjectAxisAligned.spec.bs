namespace tests

  ' The axisAligned draw mode: an upright billboard that faces the camera's yaw and
  ' foreshortens with real perspective (issue #391).
  @suite("BGE.SceneObjectDrawMode.axisAligned")
  class SceneObjectAxisAlignedTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      ' big enough that whole-pixel projection rounding stays small next to the sizes measured
      m.game = new BGE.Game(1280, 720)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap, m.game, new BGE.Camera3d())
      (m.renderer.camera as BGE.Camera3d).drawDistanceFadeFraction = 0
      ' 500 units in front of the camera, which starts at (0, 0, 1000) looking down -z
      m.entity.position = BGE.Math.VectorOps.create(0, 0, 500)
    end function

    private function newImage(args = {} as roAssociativeArray) as BGE.Image
      sourceBitmap = CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: true})
      region = CreateObject("roRegion", sourceBitmap, 0, 0, 64, 64)
      image = new BGE.Image(m.entity, region, args)
      ' feet on the ground
      image.setAnchor(0.5, 1)
      return image
    end function

    ' Puts the camera 500 units from the entity, looking down at it by `pitchDegrees`
    private sub lookDownAt(pitchDegrees as float)
      pitch = BGE.Math.DegreesToRadians(pitchDegrees)
      camera = m.renderer.camera
      camera.position = BGE.Math.VectorOps.create(0, 500 * sin(pitch), 500 + 500 * cos(pitch))
      camera.setTarget(m.entity.position)
    end sub

    private function drawFrame() as integer
      m.entity.updateTransformationMatrix()
      m.renderer.resetDrawCallCounter()
      m.renderer.setupCameraForFrame()
      m.renderer.render()
      return m.renderer.getDrawCallsLastFrame()
    end function

    private function drawQuad(imageDrawable as BGE.Image) as BGE.Math.CornerPoints
      sceneObj = imageDrawable.addToRenderer(m.renderer) as BGE.SceneObjectImage
      m.drawFrame()
      return sceneObj.getCanvasPoints()
    end function

    private sub assertNear(expected as float, actual as float, tolerance as float, label as string)
      m.assertTrue(Abs(expected - actual) <= Abs(expected) * tolerance, `${label}: expected ~${expected.toStr()}, got ${actual.toStr()}`)
    end sub

    @describe("height")

    @it("matches directScaled's height with a level camera")
    function _()
      m.lookDownAt(0)
      scaledHeight = m.drawQuad(m.newImage({drawMode: BGE.SceneObjectDrawMode.directScaled})).getAvgHeight()
      m.renderer = new BGE.Renderer(m.bitmap, m.game, new BGE.Camera3d())
      m.lookDownAt(0)
      alignedHeight = m.drawQuad(m.newImage({drawMode: BGE.SceneObjectDrawMode.axisAligned})).getAvgHeight()

      m.assertNear(scaledHeight, alignedHeight, 0.02, "height")
    end function

    @it("foreshortens like an upright card looking down 45 degrees, keeping its width")
    function _()
      image = m.newImage({drawMode: BGE.SceneObjectDrawMode.axisAligned})
      m.lookDownAt(0)
      level = m.drawQuad(image)
      levelWidth = level.getAvgWidth()
      levelHeight = level.getAvgHeight()

      m.lookDownAt(45)
      m.drawFrame()
      pitched = (image.getSceneObjects()[0] as BGE.SceneObjectImage).getCanvasPoints()

      ' real perspective: a 64-unit pole standing on the entity's position
      feet = m.renderer.worldPointToCanvasPoint(m.entity.position)
      head = m.renderer.worldPointToCanvasPoint(BGE.Math.VectorOps.add(m.entity.position, BGE.Math.VectorOps.create(0, 64, 0)))
      poleHeight = Abs(feet.y - head.y)
      m.assertTrue(Abs(poleHeight - pitched.getAvgHeight()) <= 2, `height ${pitched.getAvgHeight().toStr()}, pole ${poleHeight.toStr()}`)
      m.assertTrue(pitched.getAvgHeight() < levelHeight * 0.85, "should be foreshortened")
      ' a little wider, being a little closer
      m.assertNear(levelWidth, pitched.getAvgWidth(), 0.08, "width")
    end function

    @it("is full height at its full-height pitch")
    function _()
      m.lookDownAt(0)
      levelHeight = m.drawQuad(m.newImage({drawMode: BGE.SceneObjectDrawMode.axisAligned})).getAvgHeight()
      m.renderer = new BGE.Renderer(m.bitmap, m.game, new BGE.Camera3d())
      m.lookDownAt(12)
      height = m.drawQuad(m.newImage({drawMode: BGE.SceneObjectDrawMode.axisAligned, axisAlignedFullHeightPitch: 12})).getAvgHeight()

      ' within perspective: its middle is a little nearer the camera when looking down
      m.assertNear(levelHeight, height, 0.04, "height")
    end function

    @describe("anchor")

    @it("keeps its feet on the entity's position as the camera pitches")
    function _()
      image = m.newImage({drawMode: BGE.SceneObjectDrawMode.axisAligned, axisAlignedFullHeightPitch: 12})
      sceneObj = image.addToRenderer(m.renderer) as BGE.SceneObjectImage
      for each pitch in [0, 12, 45]
        m.lookDownAt(pitch)
        m.drawFrame()
        quad = sceneObj.getCanvasPoints()
        feetX = (quad.bottomLeft.x + quad.bottomRight.x) / 2
        feetY = (quad.bottomLeft.y + quad.bottomRight.y) / 2
        expected = m.renderer.worldPointToCanvasPoint(m.entity.position)
        m.assertTrue(Abs(feetX - expected.x) <= 1 and Abs(feetY - expected.y) <= 1, `pitch ${pitch.toStr()}: feet at ${feetX.toStr()},${feetY.toStr()}, expected ${expected.x.toStr()},${expected.y.toStr()}`)
      end for
    end function

    @describe("camera roll")

    @it("stays upright on screen under camera roll by default")
    function _()
      (m.renderer.camera as BGE.Camera3d).rollDegrees = 30
      m.lookDownAt(30)
      quad = m.drawQuad(m.newImage({drawMode: BGE.SceneObjectDrawMode.axisAligned}))
      rotation = quad.getAvgRotation()
      ' getAvgRotation() can come back as a whole turn off
      while rotation > 3.14159
        rotation -= 2 * 3.14159265
      end while
      while rotation < -3.14159
        rotation += 2 * 3.14159265
      end while
      m.assertTrue(Abs(rotation) < 0.02, `rotation ${rotation.toStr()}`)
    end function

    @it("rotates with camera roll when banksWithCameraRoll is true")
    function _()
      (m.renderer.camera as BGE.Camera3d).rollDegrees = 30
      m.lookDownAt(30)
      quad = m.drawQuad(m.newImage({drawMode: BGE.SceneObjectDrawMode.axisAligned, banksWithCameraRoll: true}))
      m.assertTrue(Abs(quad.getAvgRotation()) > 0.1)
    end function

    @describe("edge cases")

    @it("skips the draw from straight above without latching a failure")
    function _()
      image = m.newImage({drawMode: BGE.SceneObjectDrawMode.axisAligned})
      image.addToRenderer(m.renderer)
      m.renderer.camera.position = BGE.Math.VectorOps.create(0, 500, 500)
      m.renderer.camera.setTarget(m.entity.position)
      m.assertEqual(0, m.drawFrame())

      m.lookDownAt(0)
      m.assertTrue(m.drawFrame() > 0)
    end function

    @it("keeps drawing when switched between directScaled and axisAligned")
    function _()
      image = m.newImage({drawMode: BGE.SceneObjectDrawMode.directScaled})
      image.addToRenderer(m.renderer)
      m.lookDownAt(30)
      m.assertTrue(m.drawFrame() > 0)
      image.drawMode = BGE.SceneObjectDrawMode.axisAligned
      m.assertTrue(m.drawFrame() > 0)
      image.drawMode = BGE.SceneObjectDrawMode.directScaled
      m.assertTrue(m.drawFrame() > 0)
    end function

  end class

end namespace
