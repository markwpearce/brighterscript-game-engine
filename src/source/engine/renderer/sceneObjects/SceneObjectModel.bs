import "../../../math/math.bs"
import "../../../math/Matrix44.bs"
import "../../../math/vector.bs"
import "../../../utils/colors.bs"
import "../../drawables/Model3d.bs"
import "../occlusion/OccluderPanels.bs"
import "../Renderer.bs"
import "../ImpostorFit.bs"
import "../RendererHelpers.bs"
import "SceneObject.bs"
import "SceneObjectBillboard.bs"

namespace BGE

  class SceneObjectModel extends SceneObjectBillboard

    drawable as DrawableModel

    ' Convex opaque panels merged from the model's faces, in model-local space. Built
    ' when the model is registered as an occluder (see prepareOccluder()), and again
    ' after Drawable.invalidateGeometry().
    occluderPanels as BGE.OccluderPanel[] = []
    ' occluderPanels in world space, rebuilt when the model moves.
    private occluderPanelsWorld as BGE.OccluderPanel[] = []
    private occluderPanelsWorldValid as boolean = false
    ' The drawable's geometryVersion occluderPanels were built from.
    private occluderPanelsGeometryVersion as integer = -1

    private modelWorldBounds as BGE.Math.Vector[] = []
    private modelWorldFaces as BGE.Model3dFace[] = []

    private modelCanvasSamplePoints as BGE.Math.Vector[] = []
    private modelCanvasBounds as BGE.Math.Vector[] = []
    private modelCanvasFaces as BGE.Model3dFace[] = []

    ' Reused across every textured face's drawToTempBitmap call, every frame, to avoid
    ' allocating a fresh 3-Vector array (and 3 fresh Vectors) per textured face per frame
    ' just to add drawBitmapTriangleTo's missing offsetX/offsetY - mutated in place via
    ' getOffsetTriangleBuffer() below, never reassigned.
    private offsetTriangleBuffer as BGE.Math.Vector[] = [BGE.Math.VectorOps.create(), BGE.Math.VectorOps.create(), BGE.Math.VectorOps.create()]

    ' Per-face raster reuse (issue #163) - indexed by Model3dFace.faceIndex, which is
    ' stable across frames even though modelCanvasFaces itself is re-filtered/re-sorted
    ' every frame. See getFaceRasterCache()/drawFaceWithReuse() below.
    private faceRasterCaches as BGE.RendererHelpers.FaceRasterCache[] = []

    ' Whether every face drawn in the most recent drawToTempBitmap() call was a genuine
    ' fresh redraw - reset true at the top of that call, flipped false the moment any
    ' face instead reuses its own cached raster (drawFaceWithReuse()'s reuse branch).
    ' See attemptTransformTempBitmap()'s gate on it.
    private lastDrawWasFullyFresh as boolean = true

    ' The impostor's capture (see DrawableModel.useImpostor): the bounding box corners'
    ' canvas x/y when the temp bitmap was last drawn fully fresh, the direction it was seen
    ' from, and that bitmap's canvas origin. invalid when there's nothing to reuse.
    private impostorCapture as roAssociativeArray = invalid
    private impostorProjected as float[] = []
    ' this frame's impostor blit, decided before projecting the faces so a reused frame
    ' can skip that - see updateCanvasPosition()
    private impostorThisFrame as TransformTempBitmapDetails = invalid
    ' true while modelCanvasFaces is left over from an earlier frame (an impostor frame)
    private canvasFacesStale as boolean = false
    ' whether a corner pin has been drawn (and its triangles cached) since the last capture
    private pinUsedSinceCapture as boolean = false
    private impostorCaptureId as integer = 0
    ' this frame's impostor kind, for tests and profiling: "", "rotate" or "pin"
    private impostorKindThisFrame as string = ""

    sub new(name as string, drawableObj as DrawableModel)
      super(name, drawableObj, SceneObjectType.Model)
      m.useTempBitmapMap = BGE.getDrawModeBooleanLookupArray(true)
      ' Redeclaring `drawable` above auto-inits it to invalid after super() - this wins since it runs last (issue #69).
      m.drawable = drawableObj
    end sub

    protected override function didRegionToDrawChange() as boolean
      return false ' Assume model is static - interior parts do not change
    end function

    ' For tests/telemetry only - how many consecutive frames the face at `faceIndex`
    ' has reused its cached raster since its last real redraw (0 right after a redraw).
    '
    ' @param {integer} faceIndex
    ' @return {integer} -1 if this face has never been drawn at all
    function getFaceStaleFrameCount(faceIndex as integer) as integer
      if faceIndex < 0 or faceIndex >= m.faceRasterCaches.count() or invalid = m.faceRasterCaches[faceIndex].bitmap
        return -1
      end if
      return m.faceRasterCaches[faceIndex].staleFrameCount
    end function

    ' For tests/telemetry only - the isShaded brightness (0-1, floored by
    ' Drawable.ambientBrightness - see updateCanvasPosition()) computed this frame for
    ' the face at `index` in front-to-back draw order.
    '
    ' @param {integer} index
    ' @return {float} -1 if `index` is out of range
    function getFaceBrightness(index as integer) as float
      if index < 0 or index >= m.modelCanvasFaces.count()
        return -1
      end if
      return m.modelCanvasFaces[index].brightness
    end function


    protected override function drawToCanvas(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      someWorked = false
      for each face in m.modelCanvasFaces
        someWorked = m.drawFaceToCanvas(rendererObj, face, drawMode) or someWorked
      end for
      return someWorked
    end function

    ' Draws one face directly to the live canvas - the single place per-face draw
    ' dispatch lives, shared by the normal solo draw path (drawToCanvas, above) and the
    ' cluster draw path (drawPrimitive, below). Deliberately does not touch
    ' m.modelCanvasFaces/m.tempBitmap - this always draws live, never builds or relies
    ' on the whole-model temp-bitmap cache, since that cache aggregates every face in
    ' this model's own internal order and can't represent this face being interleaved
    ' with a different object's primitives.
    '
    ' A textured face (face.Texture <> invalid) draws via drawBitmapTriangle, warping
    ' the texture's UV points onto this face's canvas points, tinted by the same
    ' brightness-shaded color a flat face gets. ScratchBitmapPool self-flushes its
    ' staged regions once enough build up (see #129), so a caller batching many faces
    ' (drawToCanvas/drawToTempBitmap) doesn't need to flush the pool itself.
    '
    ' @param {Renderer} rendererObj
    ' @param {Model3dFace} face
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    private function drawFaceToCanvas(rendererObj as BGE.Renderer, face as BGE.Model3dFace, drawMode as SceneObjectDrawMode) as boolean
      shadedColor = BGE.RendererHelpers.applyAlphaFade(BGE.colorBrightness(face.color, face.brightness), m.distanceFadeAlpha)
      if drawMode = BGE.SceneObjectDrawMode.oriented or drawMode = BGE.SceneObjectDrawMode.orientedDrawBackFace or drawMode = BGE.SceneObjectDrawMode.solid or drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
        if face.Texture <> invalid and face.Texture.srcRegionWithId.region <> invalid
          return rendererObj.drawBitmapTriangle(face.Texture.srcRegionWithId, face.Texture.points, face.vertices, shadedColor)
        end if
        return rendererObj.drawTriangle(face.vertices, 0, 0, shadedColor)
      else if drawMode = BGE.SceneObjectDrawMode.wireFrame or drawMode = BGE.SceneObjectDrawMode.wireFrameDrawBackFace
        return rendererObj.drawTriangleOutline(face.vertices, shadedColor)
      end if
      return false
    end function


    ' Writes `vertices` (always exactly 3, one per triangle corner) offset by
    ' (offsetX, offsetY) into the reused `offsetTriangleBuffer`, mutating its 3 Vectors in
    ' place rather than allocating a fresh array/Vectors - see the field's own doc comment.
    '
    ' @param {BGE.Math.Vector[]} vertices
    ' @param {float} offsetX
    ' @param {float} offsetY
    ' @return {BGE.Math.Vector[]}
    private function getOffsetTriangleBuffer(vertices as BGE.Math.Vector[], offsetX as float, offsetY as float) as BGE.Math.Vector[]
      for i = 0 to 2
        m.offsetTriangleBuffer[i].x = vertices[i].x + offsetX
        m.offsetTriangleBuffer[i].y = vertices[i].y + offsetY
      end for
      return m.offsetTriangleBuffer
    end function

    ' faceIndex is stable across frames (set once in updateCanvasPosition), but
    ' modelCanvasFaces itself is rebuilt fresh every frame - this is where that index
    ' actually becomes a persistent per-face cache slot, growing lazily to fit the
    ' model's own face count.
    '
    ' @param {integer} faceIndex
    ' @return {BGE.RendererHelpers.FaceRasterCache}
    private function getFaceRasterCache(faceIndex as integer) as BGE.RendererHelpers.FaceRasterCache
      if invalid = faceIndex or faceIndex < 0
        ' No stable identity to key a cache slot by - draw fresh every time rather
        ' than risk two different faces silently sharing one slot.
        return new BGE.RendererHelpers.FaceRasterCache()
      end if
      while m.faceRasterCaches.count() <= faceIndex
        m.faceRasterCaches.push(new BGE.RendererHelpers.FaceRasterCache())
      end while
      return m.faceRasterCaches[faceIndex]
    end function

    ' Draws one face onto `tempBitmap`, reusing its own small cached raster - unchanged
    ' content, repositioned to this frame's actual (always freshly, correctly computed)
    ' position - for up to `maxStaleFrames` frames before doing a real redraw (issue
    ' #163). This is what actually cuts the per-frame cost that #128's fix introduced:
    ' a continuously-rotating textured model was paying the full drawBitmapTriangleTo
    ' pipeline (multiple scratch-bitmap allocations and draws) for every visible face,
    ' every single frame. Only the pixel CONTENT can go briefly stale here, never the
    ' position, so there's no rotate/scale transform to get right - a stale frame just
    ' shows this face's texture at its last-redrawn orientation, correctly placed.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {ifDraw2d} tempBitmap the model's shared temp bitmap to draw onto
    ' @param {BGE.Model3dFace} face
    ' @param {float} modelOffsetX the model's own canvas-bounds top-left, negated (see drawToTempBitmap)
    ' @param {float} modelOffsetY
    ' @param {boolean} allowFastDraw whether the model is moving (see mayReuseFaceRaster()), and
    '   forwarded to drawTriangleTo for an untextured face - see Renderer.drawTriangleTo
    ' @return {boolean} true if something was actually drawn
    private function drawFaceWithReuse(rendererObj as BGE.Renderer, tempBitmap as ifDraw2d, face as BGE.Model3dFace, modelOffsetX as float, modelOffsetY as float, allowFastDraw as boolean) as boolean
      bounds = BGE.Math.getBounds(face.vertices)
      if bounds.count() < 2
        return false
      end if
      faceOffsetX = modelOffsetX + bounds[0].x
      faceOffsetY = modelOffsetY + bounds[0].y

      width = fix(bounds[1].x - bounds[0].x) + 1
      height = fix(bounds[1].y - bounds[0].y) + 1
      if width < 1 or height < 1
        return false
      end if

      cache = m.getFaceRasterCache(face.faceIndex)

      ' The drift check below only bounds each vertex's own movement since the cache's
      ' last real redraw, not the resulting bounding-box size - three vertices can each
      ' drift by just under maxFaceDriftDistance and still grow this frame's width/height
      ' beyond what the cached bitmap was actually allocated for (grow-only sizing is tied
      ' to the LAST redraw's footprint, not this frame's). Require the cache to already be
      ' big enough before cropping it to this size, or a reused frame could ask
      ' getCroppedFaceRegion() for a region larger than its backing bitmap.
      if invalid <> cache.bitmap and cache.bitmap.GetWidth() >= width and cache.bitmap.GetHeight() >= height and cache.staleFrameCount < m.drawable.maxStaleFrames and not m.drawable.useImpostor and m.mayReuseFaceRaster(allowFastDraw) and not m.qualityChangedThisDraw and not m.hasFaceDriftedTooFar(face.vertices, cache.triangleAtCapture)
        cache.staleFrameCount++
        m.lastDrawWasFullyFresh = false
        return rendererObj.drawObjectTo(tempBitmap, faceOffsetX, faceOffsetY, m.getCroppedFaceRegion(cache.bitmap, width, height))
      end if

      faceBitmap = BGE.RendererHelpers.growOrClearBitmap(cache.bitmap, width, height)
      if invalid = faceBitmap
        return false
      end if

      localOffsetX = -bounds[0].x
      localOffsetY = -bounds[0].y
      shadedColor = BGE.colorBrightness(face.color, face.brightness)
      drawn = false
      if face.Texture <> invalid and face.Texture.srcRegionWithId.region <> invalid
        drawn = rendererObj.drawBitmapTriangleTo(faceBitmap, face.Texture.srcRegionWithId, face.Texture.points, m.getOffsetTriangleBuffer(face.vertices, localOffsetX, localOffsetY), shadedColor)
      else
        drawn = rendererObj.drawTriangleTo(faceBitmap, face.vertices, localOffsetX, localOffsetY, shadedColor, allowFastDraw)
      end if

      if not drawn
        return false
      end if

      cache.bitmap = faceBitmap
      cache.staleFrameCount = 0
      cache.triangleAtCapture = BGE.Math.vectorArrayCopy(face.vertices)
      return rendererObj.drawObjectTo(tempBitmap, faceOffsetX, faceOffsetY, m.getCroppedFaceRegion(faceBitmap, width, height))
    end function

    ' Whether a face may reuse its cached raster this draw. A fastShrink occluder only reuses
    ' while moving, so a still one ends up exact and can claim its exact outline; an exact
    ' occluder never reuses.
    '
    ' @param {boolean} moving whether the model moved relative to the camera
    ' @return {boolean}
    private function mayReuseFaceRaster(moving as boolean) as boolean
      if not m.isOccluder
        return true
      end if
      if m.occluderDrawPolicy = BGE.OccluderDrawPolicy.exact
        return false
      end if
      return moving or m.occluderDrawPolicy <> BGE.OccluderDrawPolicy.fastShrink
    end function

    ' Crops `bitmap` (which may be larger than `width`x`height` due to grow-only reuse -
    ' see RendererHelpers.growOrClearBitmap) down to this frame's actual face footprint,
    ' so a blit never carries stale/blank capacity left over from a previous, larger
    ' frame's use of the same cached bitmap.
    '
    ' @param {roBitmap} bitmap
    ' @param {integer} width
    ' @param {integer} height
    ' @return {roRegion}
    private function getCroppedFaceRegion(bitmap as roBitmap, width as integer, height as integer) as roRegion
      return CreateObject("roRegion", bitmap, 0, 0, width, height)
    end function

    ' Whether any of this face's 3 vertices has moved more than
    ' DrawableModel.maxFaceDriftDistance (Manhattan distance) since `capturedVertices`
    ' was rendered - the same measure (and, by default, the same magnitude) the base
    ' class's own whole-object reuse check uses, just applied per vertex/per face
    ' instead of to 4 whole-silhouette limit points.
    '
    ' @param {BGE.Math.Vector[]} currentVertices this frame's 3 canvas-space vertices
    ' @param {BGE.Math.Vector[]} capturedVertices the cache's vertices as of its last real redraw, or invalid if there is no cache yet
    ' @return {boolean}
    private function hasFaceDriftedTooFar(currentVertices as BGE.Math.Vector[], capturedVertices as BGE.Math.Vector[]) as boolean
      if invalid = capturedVertices
        return true
      end if
      maxDistance = m.drawable.maxFaceDriftDistance
      for i = 0 to 2
        drift = BGE.Math.VectorOps.manhattanLength(BGE.Math.VectorOps.subtract(currentVertices[i], capturedVertices[i]))
        if drift > maxDistance
          return true
        end if
      end for
      return false
    end function


    protected override function drawToTempBitmap(rendererObj as BGE.Renderer, tempBitmap as ifDraw2d, canvasPointsTopLeftBound as BGE.Math.Vector, drawMode as SceneObjectDrawMode, allowFastDraw = false as boolean) as TempBitmapDrawResult
      if tempBitmap = invalid
        return {worked: false, didFastDraw: false}
      end if
      if m.canvasFacesStale
        ' the impostor blit was decided but failed - the bitmap is sized from the fitted
        ' bounds, which are within the allowed error of the real ones
        m.projectCanvasFaces(rendererObj, drawMode)
      end if
      someWorked = false
      offsetX = -canvasPointsTopLeftBound.x
      offsetY = -canvasPointsTopLeftBound.y
      ' Tracked so attemptTransformTempBitmap() can refuse to whole-model-stretch a
      ' temp bitmap that's itself a patchwork of some-fresh-some-reused per-face
      ' content - see the field's own doc comment. Flipped false by drawFaceWithReuse()
      ' the moment any face takes the reuse path this frame.
      m.lastDrawWasFullyFresh = true

      for each face in m.modelCanvasFaces
        if drawMode = BGE.SceneObjectDrawMode.oriented or drawMode = BGE.SceneObjectDrawMode.orientedDrawBackFace or drawMode = BGE.SceneObjectDrawMode.solid or drawMode = BGE.SceneObjectDrawMode.solidDrawBackFace
          thisWorked = m.drawFaceWithReuse(rendererObj, tempBitmap, face, offsetX, offsetY, allowFastDraw and not m.drawable.useImpostor)
        else if drawMode = BGE.SceneObjectDrawMode.wireFrame or drawMode = BGE.SceneObjectDrawMode.wireFrameDrawBackFace
          ' Outlines are cheap already (no texture warp) - not worth caching, and a
          ' debug wireframe shouldn't lag a frame behind the model's real position.
          thisWorked = rendererObj.drawTriangleOutlineTo(tempBitmap, face.vertices, face.color, {x: offsetX, y: offsetY})
        else
          thisWorked = false
        end if
        someWorked = thisWorked or someWorked
      end for
      if m.drawable.useImpostor
        m.captureImpostor(rendererObj, canvasPointsTopLeftBound, drawMode)
      end if
      return {worked: someWorked, didFastDraw: allowFastDraw}
    end function

    private sub captureImpostor(rendererObj as BGE.Renderer, origin as BGE.Math.Vector, drawMode as SceneObjectDrawMode)
      m.impostorCapture = invalid
      samples = m.projectImpostorSamples(rendererObj)
      if invalid = samples or not m.lastDrawWasFullyFresh
        return
      end if
      samples.originX = origin.x
      samples.originY = origin.y
      samples.transformVersion = m.transformVersion
      samples.geometryVersion = m.drawable.geometryVersion
      samples.drawMode = drawMode
      samples.triangleSkipSize = rendererObj.qualitySettings.triangleSkipSize
      samples.triangleQuickDrawStep = rendererObj.qualitySettings.triangleQuickDrawStep
      samples.canvasBounds = m.modelCanvasBounds
      samples.canvasSamplePoints = m.modelCanvasSamplePoints
      if m.drawable.useImpostorPin
        if m.pinUsedSinceCapture
          ' the triangles cached from the old rendering are stale now
          rendererObj.triangleCache.removeTrianglesWithId(m.getImpostorPinRegionId())
          m.pinUsedSinceCapture = false
        end if
        ' the outline is only worked out if a pin is tried (see getImpostorOutline()), so it
        ' costs nothing on this frame, which is already a full redraw; both face lists are
        ' replaced, not changed, when they're rebuilt
        samples.canvasFaces = m.modelCanvasFaces
        samples.worldFaces = m.modelWorldFaces
        m.impostorCaptureId++
      end if
      m.impostorCapture = samples
    end sub

    ' The visible faces' outline (their canvas convex hull) as world points, with where they
    ' sat in the temp bitmap - what a corner pin is fitted against. Worked out from the
    ' capture the first time it's asked for. invalid if there isn't one.
    private function getImpostorOutline(capture as roAssociativeArray, maxPoints as integer) as roAssociativeArray
      if invalid <> capture.outline and capture.outline.maxPoints = maxPoints
        return capture.outline
      end if
      bounds = capture.canvasBounds
      if invalid = capture.canvasFaces or invalid = bounds or bounds.count() < 2
        return invalid
      end if
      xs = [] as float[]
      ys = [] as float[]
      worldPoints = [] as BGE.Math.Vector[]
      for each face in capture.canvasFaces
        worldFace = capture.worldFaces[face.faceIndex]
        for i = 0 to 2
          xs.push(face.vertices[i].x)
          ys.push(face.vertices[i].y)
          worldPoints.push(worldFace.vertices[i])
        end for
      end for
      hull = BGE.ImpostorFit.convexHullIndexes(xs, ys)
      if hull.count() < 4
        return invalid
      end if
      outline = {maxPoints: maxPoints, world: [] as BGE.Math.Vector[], x: [] as float[], y: [] as float[]}
      stepSize = BGE.Math.Max(1, hull.count() / BGE.Math.Max(4, maxPoints))
      position = 0.0
      while Int(position) < hull.count()
        index = hull[Int(position)]
        outline.world.push(worldPoints[index])
        outline.x.push(xs[index] - capture.originX)
        outline.y.push(ys[index] - capture.originY)
        position += stepSize
      end while
      ' the temp bitmap's size - see createTempBitmap()
      outline.bitmapWidth = Int(bounds[1].x - bounds[0].x + 1)
      outline.bitmapHeight = Int(bounds[1].y - bounds[0].y + 1)
      capture.outline = outline
      return outline
    end function

    ' a new id per capture, so a pin never draws triangles cached from an older rendering
    private function getImpostorPinRegionId() as string
      return m.id + "_impostor" + m.impostorCaptureId.toStr()
    end function

    ' The bounding box corners' canvas x and y this frame and the direction from the camera
    ' to their centre, or invalid if one won't project.
    private function projectImpostorSamples(rendererObj as BGE.Renderer) as roAssociativeArray
      if rendererObj.camera.name <> "Camera3d"
        return invalid
      end if
      points = m.getBoundingPointsThisFrame(rendererObj.camera)
      if points.count() = 0 or not (rendererObj.camera as Camera3d).projectPointsWithDepth(points, m.impostorProjected)
        return invalid
      end if
      xs = [] as float[]
      ys = [] as float[]
      centre = BGE.Math.VectorOps.create()
      for i = 0 to points.count() - 1
        xs.push(m.impostorProjected[i * 3])
        ys.push(m.impostorProjected[i * 3 + 1])
        BGE.Math.VectorOps.plusEquals(centre, points[i])
      end for
      direction = BGE.Math.VectorOps.subtract(BGE.Math.VectorOps.scale(centre, 1.0 / points.count()), rendererObj.camera.position)
      BGE.Math.VectorOps.normalize(direction)
      return {xs: xs, ys: ys, direction: direction}
    end function

    ' The blit of the captured rendering that fits this frame, or invalid: a scale and
    ' rotation fitted to the box corners first, then a corner pin fitted to the outline.
    private function attemptImpostor(renderObj as Renderer, drawMode as SceneObjectDrawMode) as TransformTempBitmapDetails
      capture = m.impostorCapture
      if invalid = capture or m.drawsOccluderExactly()
        return invalid
      end if
      ' the box fit only follows the camera - a model turning in place can keep the same box
      if capture.transformVersion <> m.transformVersion or capture.geometryVersion <> m.drawable.geometryVersion or capture.drawMode <> drawMode
        return invalid
      end if
      samples = m.projectImpostorSamples(renderObj)
      if invalid = samples
        return invalid
      end if
      settings = renderObj.qualitySettings
      ' which faces show, and their shading, depend on the direction the model is seen from
      cosine = BGE.Math.VectorOps.dotProduct(samples.direction, capture.direction)
      diagonal = m.getScreenDiagonal(samples.xs, samples.ys)
      if cosine >= Cos(BGE.Math.DegreesToRadians(settings.modelImpostorMaxAngleDegrees))
        fit = BGE.ImpostorFit.fitRotateScale(capture.xs, capture.ys, samples.xs, samples.ys)
        p = fit.params
        if invalid <> p and BGE.Math.Max(p.scaleX, p.scaleY) <= settings.modelImpostorMaxZoom and fit.residual <= m.getImpostorAllowedError(settings.modelImpostorError, diagonal, drawMode)
          capture.fit = {kind: "rotate", params: p}
          origin = BGE.ImpostorFit.mapRotateScale(p, capture.originX, capture.originY)
          ' DrawTransformedObject turns counterclockwise on screen, the fit's angle clockwise (y down)
          return {origin: origin, rotation: -p.rotation, scaleX: p.scaleX, scaleY: p.scaleY}
        end if
      end if
      if not m.drawable.useImpostorPin or cosine < Cos(BGE.Math.DegreesToRadians(settings.modelImpostorPinMaxAngleDegrees))
        return invalid
      end if
      outline = m.getImpostorOutline(capture, settings.modelImpostorPinOutlinePoints)
      if invalid = outline
        return invalid
      end if
      projected = m.projectImpostorOutline(renderObj, outline.world)
      if invalid = projected
        return invalid
      end if
      fit = BGE.ImpostorFit.fitPinnedCorners(outline.x, outline.y, projected.xs, projected.ys, outline.bitmapWidth, outline.bitmapHeight)
      p = fit.params
      if invalid = p or fit.residual > m.getImpostorAllowedError(settings.modelImpostorPinError, diagonal, drawMode)
        return invalid
      end if
      corners = new BGE.Math.CornerPoints()
      corners.topLeft = BGE.Math.VectorOps.create(p.cornersX[0], p.cornersY[0])
      corners.topRight = BGE.Math.VectorOps.create(p.cornersX[1], p.cornersY[1])
      corners.bottomRight = BGE.Math.VectorOps.create(p.cornersX[2], p.cornersY[2])
      corners.bottomLeft = BGE.Math.VectorOps.create(p.cornersX[3], p.cornersY[3])
      zoom = BGE.Math.Max(corners.getAvgWidth() / outline.bitmapWidth, corners.getAvgHeight() / outline.bitmapHeight)
      if zoom > settings.modelImpostorMaxZoom
        return invalid
      end if
      capture.fit = {kind: "pin", params: p}
      m.pinUsedSinceCapture = true
      return {origin: corners.topLeft, rotation: 0, scaleX: zoom, scaleY: zoom, pinCorners: corners, pinRegionId: m.getImpostorPinRegionId()}
    end function

    ' The error allowed scales with the model's size on screen (2px at least, so a small
    ' model can still use it); an occluder's is capped at the reuse threshold, which is
    ' what a fastShrink occluder's claim already shrinks by.
    private function getImpostorAllowedError(fraction as float, diagonal as float, drawMode as SceneObjectDrawMode) as float
      allowed = BGE.Math.Max(2, fraction * diagonal)
      if m.isOccluder
        allowed = BGE.Math.Min(allowed, m.getTempBitmapThreshold(drawMode))
      end if
      return allowed
    end function

    ' The captured outline's canvas x and y this frame, or invalid if a point won't project.
    private function projectImpostorOutline(rendererObj as BGE.Renderer, points as BGE.Math.Vector[]) as roAssociativeArray
      if not (rendererObj.camera as Camera3d).projectPointsWithDepth(points, m.impostorProjected)
        return invalid
      end if
      xs = [] as float[]
      ys = [] as float[]
      for i = 0 to points.count() - 1
        xs.push(m.impostorProjected[i * 3])
        ys.push(m.impostorProjected[i * 3 + 1])
      end for
      return {xs: xs, ys: ys}
    end function

    private function getScreenDiagonal(xs as float[], ys as float[]) as float
      width = BGE.Math.arrayMax(xs) - BGE.Math.arrayMin(xs)
      height = BGE.Math.arrayMax(ys) - BGE.Math.arrayMin(ys)
      return Sqr(width * width + height * height)
    end function

    protected override function updateWorldPosition(drawMode as SceneObjectDrawMode) as boolean
      if m.isOccluder and m.occluderPanelsGeometryVersion <> m.drawable.geometryVersion
        m.prepareOccluder()
      end if
      m.occluderPanelsWorldValid = false
      m.modelWorldFaces = []
      m.worldPosition = m.drawable.getWorldPosition()
      m.modelWorldBounds = []
      i = 0

      for each face in m.drawable.model.faces as BGE.Model3dFace[]
        worldVerts = [] as BGE.Math.Vector[]
        for each vert in face.vertices
          ' modelWorldBounds must be in WORLD space (it feeds getPositionsForFrustumCheck,
          ' which compares against the camera's frustum) - using the raw, untransformed
          ' `vert` here silently pointed frustum checks at the model's local-space
          ' coordinates instead of its actual position, culling any model whose entity
          ' isn't near the world origin the moment a real (non-shortcut) frustum recheck
          ' ran. Only ever exercised by a multi-frame test that keeps genuinely moving a
          ' displaced entity - the far more common single-draw-call test pattern always
          ' hits isFirstFrameSinceEnabled's unconditional "true" shortcut instead.
          worldVert = BGE.Math.Matrix44.multVecMatrix(vert, m.transformationMatrix)
          if m.modelWorldBounds.Count() <> 2
            m.modelWorldBounds.push(worldVert)
            m.modelWorldBounds.push(worldVert)
          end if
          m.modelWorldBounds[0] = BGE.Math.VectorOps.minBound(m.modelWorldBounds[0], worldVert)
          m.modelWorldBounds[1] = BGE.Math.VectorOps.maxBound(m.modelWorldBounds[1], worldVert)
          worldVerts.push(worldVert)
        end for
        worldFace = BGE.Model3dFaceOps.create(worldVerts)
        worldFace.Texture = face.Texture
        worldFace.color = face.color
        m.modelWorldFaces.Push(worldFace)
        i++
        if i > 1200
          exit for
        end if
      end for

      return true
    end function


    override function getPositionForCameraDistance(drawMode as SceneObjectDrawMode) as BGE.Math.Vector
      ' worldPoints is never filled for a model, so use the centre of its world bounds
      if not isScreenAlignedDrawMode(drawMode) and m.modelWorldBounds.Count() = 2
        lo = m.modelWorldBounds[0]
        hi = m.modelWorldBounds[1]
        return BGE.Math.VectorOps.create((lo.x + hi.x) / 2, (lo.y + hi.y) / 2, (lo.z + hi.z) / 2)
      end if
      return m.worldPosition
    end function

    protected override function getPositionsForFrustumCheck(drawMode as SceneObjectDrawMode) as BGE.Math.Vector[]
      'TODO: this is probably too slow - this gives 8 points and needs to loop through all points
      return BGE.Math.getBoundingCubePoints(m.modelWorldBounds)
    end function

    protected override function getAllCanvasPoints() as BGE.Math.Vector[]
      return m.modelCanvasSamplePoints
    end function

    ' A model is a triangle mesh, not a single quad, so there is no one perimeter to stroke -
    ' outlining a model means the wireFrame draw modes (which stroke every face), not the
    ' `Drawable.outlineRGBA` outline the other billboard SceneObjects support.
    protected override function getOutlineCanvasPoints() as BGE.Math.Vector[]
      return invalid
    end function

    protected override function getCanvasBounds() as BGE.Math.Vector[]
      return m.modelCanvasBounds
    end function

    ' An impostor frame (see DrawableModel.useImpostor) skips projecting every vertex:
    ' only the 8 box corners are projected, and the canvas bounds and sample points are moved
    ' by the same fit the blit uses.
    protected override function updateCanvasPosition(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      m.impostorThisFrame = invalid
      m.impostorKindThisFrame = ""
      m.keepImpostorThroughQualityDrop(rendererObj)
      ' overlap clusters draw per face, from faces this would leave unprojected
      if m.drawable.useImpostor and not rendererObj.computeOverlapClusters and not m.qualityChangedThisDraw and m.mayReuseTransformedTempBitmap(drawMode) and m.objMovedInRelationToCamera(rendererObj.camera)
        m.impostorThisFrame = m.attemptImpostor(rendererObj, drawMode)
        if invalid <> m.impostorThisFrame
          m.impostorKindThisFrame = m.impostorCapture.fit.kind
          m.moveCanvasPointsByImpostor()
          m.canvasFacesStale = true
          return true
        end if
      end if
      return m.projectCanvasFaces(rendererObj, drawMode)
    end function

    ' A step down in quality keeps the impostor's rendering, since it was drawn at least as
    ' well as the new level would draw it - only a step up redraws it.
    protected override function performDraw(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      if m.canvasFacesStale and invalid = m.impostorThisFrame
        ' the impostor isn't drawing this frame, and the bitmap is sized from the canvas bounds
        m.projectCanvasFaces(rendererObj, drawMode)
      end if
      return super.performDraw(rendererObj, drawMode)
    end function

    protected override function isRedrawToCanvasRequired(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      m.keepImpostorThroughQualityDrop(rendererObj)
      return super.isRedrawToCanvasRequired(rendererObj, drawMode)
    end function

    private sub keepImpostorThroughQualityDrop(rendererObj as BGE.Renderer)
      if m.qualityChangedThisDraw and m.drawable.useImpostor and invalid <> m.impostorCapture
        settings = rendererObj.qualitySettings
        if settings.triangleSkipSize >= m.impostorCapture.triangleSkipSize and settings.triangleQuickDrawStep >= m.impostorCapture.triangleQuickDrawStep
          m.qualityChangedThisDraw = false
        end if
      end if
    end sub

    private sub moveCanvasPointsByImpostor()
      capture = m.impostorCapture
      m.modelCanvasBounds = []
      corners = [] as BGE.Math.Vector[]
      if capture.canvasBounds.count() = 2
        lo = capture.canvasBounds[0]
        hi = capture.canvasBounds[1]
        ' a rotation or pin moves the bounds' corners apart, so bound all four
        for each corner in [[lo.x, lo.y], [hi.x, lo.y], [hi.x, hi.y], [lo.x, hi.y]]
          corners.push(m.mapByImpostorFit(capture, corner[0], corner[1]))
        end for
        m.modelCanvasBounds.push(BGE.Math.VectorOps.copy(corners[0]))
        m.modelCanvasBounds.push(BGE.Math.VectorOps.copy(corners[0]))
        for each corner in corners
          m.modelCanvasBounds[0] = BGE.Math.VectorOps.minBound(m.modelCanvasBounds[0], corner)
          m.modelCanvasBounds[1] = BGE.Math.VectorOps.maxBound(m.modelCanvasBounds[1], corner)
        end for
      end if
      m.modelCanvasSamplePoints = []
      for each point in capture.canvasSamplePoints
        m.modelCanvasSamplePoints.push(m.mapByImpostorFit(capture, point.x, point.y))
      end for
    end sub

    ' Where this frame's impostor fit takes a canvas point of the captured rendering.
    private function mapByImpostorFit(capture as roAssociativeArray, x as float, y as float) as BGE.Math.Vector
      if capture.fit.kind = "pin"
        return BGE.ImpostorFit.mapPinnedCorners(capture.fit.params, x - capture.originX, y - capture.originY)
      end if
      return BGE.ImpostorFit.mapRotateScale(capture.fit.params, x, y)
    end function

    private function projectCanvasFaces(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      m.canvasFacesStale = false
      m.modelCanvasFaces = []
      m.modelCanvasSamplePoints = []
      m.modelCanvasBounds = []

      'dataToDraw = []
      'i = 0
      ' for each face in m.modelCanvasFaces
      '   negDistances = []
      '   for each point in face.vertices
      '     negDistance = -rendererObj.camera.distanceFromCameraFront(point)
      '     negDistances.Push(negDistance)
      '   end for
      '   dataToDraw.push({face: face, negDistanceToCamera: BGE.Math.arrayMin(negDistances)})
      '   i++
      ' end for

      isShaded = m.drawable.isShaded

      worldFaceIndex = 0
      for each worldFace in m.modelWorldFaces
        thisFaceIndex = worldFaceIndex
        worldFaceIndex++
        canvasPoints = [] as BGE.Math.Vector[]
        if isBackFaceDrawMode(drawMode) or isOutwardNormalFacingCamera(rendererObj, worldFace.vertices[0], worldFace.normal)
          negDistances = []

          for each vert in worldFace.vertices
            canvasPoint = rendererObj.worldPointToCanvasPoint(vert)

            if invalid = canvasPoint
              exit for
            end if
            if m.modelCanvasBounds.Count() <> 2
              m.modelCanvasBounds.push(canvasPoint)
              m.modelCanvasBounds.push(canvasPoint)
            end if
            m.modelCanvasBounds[0] = BGE.Math.VectorOps.minBound(m.modelCanvasBounds[0], canvasPoint)
            m.modelCanvasBounds[1] = BGE.Math.VectorOps.maxBound(m.modelCanvasBounds[1], canvasPoint)
            negDistance = -rendererObj.camera.distanceFromCameraFront(vert)
            canvasPoints.push(canvasPoint)
            negDistances.Push(negDistance)
          end for

          if canvasPoints.Count() = 3
            canvasFace = BGE.Model3dFaceOps.create(canvasPoints)
            canvasFace.Texture = worldFace.Texture
            canvasFace.color = worldFace.color
            canvasFace.brightness = isShaded? BGE.Math.Max(getOutwardNormalFacingAmount(rendererObj, worldFace.vertices[0], worldFace.normal), m.drawable.ambientBrightness) : 1
            canvasFace.priority = -BGE.Math.arrayMax(negDistances)
            canvasFace.faceIndex = thisFaceIndex
            m.modelCanvasFaces.Push(canvasFace)
            m.modelCanvasSamplePoints.push(canvasPoints[0])
          end if
        end if
      end for

      m.modelCanvasFaces.SortBy("priority", "r")
      return true
    end function

    ' A rotation this small (radians) is treated as "no real rotation happened" - see
    ' attemptTransformTempBitmap() below. Small enough that no visible face orientation
    ' change could hide behind it.
    private negligibleRotation as float = 0.001

    ' How far scaleX/scaleY may differ (see attemptTransformTempBitmap()) and still count
    ' as a uniform zoom rather than an anisotropic stretch.
    private negligibleScaleDifference as float = 0.01

    ' The base class's reuse check (SceneObjectBillboard.attemptTransformTempBitmap) fits
    ' one rotate+scale from the whole-model silhouette - exact for a single rigid quad, but
    ' not for a model: rotating around any axis but the one facing the camera changes each
    ' face's shape/occlusion non-rigidly relative to the others even while the silhouette
    ' still fits (the cause of issue #128's rotation glitch). A pure camera-distance zoom
    ' has no such risk (every face scales identically, no rotation), so this only accepts
    ' the base class's fit when both its rotation and its scaleX/scaleY are negligible, and
    ' only when every face was freshly redrawn this frame (lastDrawWasFullyFresh) rather
    ' than reused per-face (drawFaceWithReuse()) - stretching an already-patchwork bitmap
    ' would compound each face's own staleness/drift. See #163.
    protected override function attemptTransformTempBitmap(renderObj as Renderer, drawMode as SceneObjectDrawMode) as TransformTempBitmapDetails
      if m.drawable.useImpostor
        ' decided in updateCanvasPosition(), before the faces were (or weren't) projected
        details = m.impostorThisFrame
        m.impostorThisFrame = invalid
        return details
      end if
      if not m.lastDrawWasFullyFresh
        return invalid
      end if
      candidate = super.attemptTransformTempBitmap(renderObj, drawMode)
      if invalid = candidate or abs(candidate.rotation) > m.negligibleRotation
        return invalid
      end if
      if abs(candidate.scaleX - candidate.scaleY) > m.negligibleScaleDifference
        return invalid
      end if
      return candidate
    end function

    ' Restores the wider drift tolerance the base class's 16px default is too tight for -
    ' a model's whole-silhouette reuse (see attemptTransformTempBitmap() above) only ever
    ' fires for a pure zoom, so it can safely tolerate more drift than a single quad's
    ' rotate+scale fit before falling back to per-face reuse (drawFaceWithReuse()).
    '
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {integer}
    protected override function getTempBitmapThreshold(drawMode as SceneObjectDrawMode) as integer
      if drawMode = SceneObjectDrawMode.wireFrame
        return 24
      end if
      return 64
    end function

    ' For tests/profiling: how this frame reused the last full rendering - "rotate" (scaled
    ' and rotated), "pin" (corner pinned), or "" (it didn't).
    '
    ' @return {string}
    function getImpostorKindThisFrame() as string
      return m.impostorKindThisFrame
    end function

    ' For tests/telemetry only - exposes attemptTransformTempBitmap()'s result without
    ' needing test code to reach a protected member directly.
    '
    ' @return {boolean}
    function canReuseTransformedTempBitmap(renderObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      return invalid <> m.attemptTransformTempBitmap(renderObj, drawMode)
    end function

    ' Overrides the base class's "always 1" default: a model's real primitive count is
    ' its actual current face list, which m.modelCanvasFaces (rebuilt every frame by
    ' updateCanvasPosition, above) already reflects correctly for whatever draw mode is
    ' active - front-facing-only for oriented/solid/wireFrame, front+back for the
    ' *DrawBackFace variants, and empty for matchCamera/directToCamera/directScaled
    ' (which this class doesn't render at all via any path). No new draw-mode-awareness
    ' is needed here - it's inherited for free from updateCanvasPosition's existing,
    ' already-correct backface-cull logic.
    '
    ' @return {integer}
    override function getPrimitiveCount() as integer
      return m.modelCanvasFaces.count()
    end function

    ' `priority` (computed in updateCanvasPosition, above) is a positive value equal to
    ' the distance of the face's closest vertex to the camera - larger for a farther
    ' face. That's the OPPOSITE sign convention from the base class's
    ' negDistanceFromCamera (negative in front of the camera, more negative = farther),
    ' which is what Renderer.drawPendingClusterPrimitives()'s combined sort assumes for
    ' every primitive regardless of SceneObject subtype. Negating it here converts to
    ' that shared convention: -priority is negative, and more negative for a farther
    ' face (e.g. a face 100 units out has priority 100 -> depth -100, versus a face 10
    ' units out with priority 10 -> depth -10; ascending sort puts -100 before -10, i.e.
    ' farthest first, matching negDistanceFromCamera and the main scene's own
    ' painter's-algorithm sort).
    '
    ' Fixed (issue #112): updateCanvasPosition()'s `m.modelCanvasFaces.SortBy("priority", "r")`
    ' now sorts descending (farthest-first), matching this method's own farthest-first
    ' convention - the solo draw loop (drawToCanvas/drawToTempBitmap, which iterate
    ' modelCanvasFaces in stored order with no reversal) and the cluster draw path
    ' (this method + drawPrimitive, which look up by index and get re-sorted by
    ' Renderer.drawPendingClusterPrimitives independently) now agree: both draw a
    ' model's self-overlapping faces farthest-first, nearest-last-on-top, regardless
    ' of whether the model draws solo or as part of a multi-member overlap cluster.
    '
    ' @param {integer} index
    ' @return {float}
    override function getPrimitiveDepth(index as integer) as float
      return -m.modelCanvasFaces[index].priority
    end function

    ' @param {Renderer} rendererObj
    ' @param {integer} index
    ' @return {boolean}
    override function drawPrimitive(rendererObj as Renderer, index as integer) as boolean
      return m.drawFaceToCanvas(rendererObj, m.modelCanvasFaces[index], m.lastDrawMode as SceneObjectDrawMode)
    end function

    ' A model hides what's behind it through its merged opaque panels (see Drawable.isOccluder).
    '
    ' @return {boolean}
    override function isEligibleOccluderType() as boolean
      return true
    end function

    ' Builds and caches the model's occluder panels.
    override sub prepareOccluder()
      m.occluderPanels = BGE.Occlusion.buildModelPanels(m.drawable.model.faces)
      m.occluderPanelsGeometryVersion = m.drawable.geometryVersion
      m.occluderPanelsWorldValid = false
    end sub

    ' Adds one polygon per panel the draw path draws this frame: facing the camera (or
    ' any panel in a *DrawBackFace mode), with every vertex projecting. While moving, each
    ' panel is shrunk by getOccluderInset(), and a panel with a vertex inside it is left out,
    ' since a tiny face there may be skipped.
    '
    ' @param {Renderer} rendererObj
    ' @param {BGE.OccluderPolygon[]} out
    override function appendOccluderPolygons(rendererObj as Renderer, out as BGE.OccluderPolygon[]) as void
      if not m.canOccludeThisFrame(rendererObj)
        return
      end if
      drawMode = m.getOccluderDrawMode(rendererObj)
      inset = m.getOccluderInset(rendererObj, drawMode)
      drawBackFaces = isBackFaceDrawMode(drawMode)
      if not m.occluderPanelsWorldValid
        m.occluderPanelsWorld = m.getOccluderPanelsInWorld()
        m.occluderPanelsWorldValid = true
      end if
      for each panel in m.occluderPanelsWorld
        if inset > 0 and panel.hasInnerVertices
          continue for
        end if
        if not drawBackFaces and not isOutwardNormalFacingCamera(rendererObj, panel.vertices[0], panel.normal)
          continue for
        end if
        polygon = m.projectOccluderPolygon(rendererObj, panel.vertices, inset)
        if invalid <> polygon
          out.push(polygon)
        end if
      end for
    end function

    private function getOccluderPanelsInWorld() as BGE.OccluderPanel[]
      worldPanels = [] as BGE.OccluderPanel[]
      for each panel in m.occluderPanels
        worldVertices = [] as BGE.Math.Vector[]
        for each vertex in panel.vertices
          worldVertices.push(BGE.Math.Matrix44.multVecMatrix(vertex, m.transformationMatrix))
        end for
        ' world-space normal built like Model3dFaceOps.resetNormal(), as updateCanvasPosition() tests it
        normal = BGE.Math.VectorOps.crossProduct(BGE.Math.VectorOps.subtract(worldVertices[1], worldVertices[0]), BGE.Math.VectorOps.subtract(worldVertices[2], worldVertices[0]))
        BGE.Math.VectorOps.normalize(normal)
        worldPanels.push({vertices: worldVertices, normal: normal, hasInnerVertices: panel.hasInnerVertices})
      end for
      return worldPanels
    end function

    ' How far a moving model's draw may fall short of its exact faces: the larger of the
    ' whole-model stretch threshold (when that may run) and a reused face raster's error,
    ' plus any coarse fill - and never less than a skippable tiny face's reach.
    '
    ' @param {Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {float}
    protected override function getOccluderInset(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as float
      ' every approximation is only taken while moving (see drawFaceWithReuse())
      if not m.shrinksOccluderClaim() or not m.objMovedInRelationToCamera(rendererObj.camera)
        return 0.0
      end if
      inset = 0.0
      if m.drawable.maxStaleFrames > 0
        ' a reused raster sits at this frame's bounding box, so each vertex can be off by
        ' its own drift plus the box corner's
        inset = m.drawable.maxFaceDriftDistance * (1 + Sqr(2))
      end if
      if m.mayReuseTransformedTempBitmap(drawMode)
        inset = BGE.Math.Max(inset, m.getTempBitmapThreshold(drawMode))
      end if
      inset += rendererObj.getQuickDrawFillError()
      ' a skipped face lies within its own bounding box's diagonal of the panel's edge
      return BGE.Math.Max(inset, rendererObj.qualitySettings.triangleSkipSize * Sqr(2))
    end function

    ' Also needs the cached bitmap to be every face freshly drawn - see attemptTransformTempBitmap().
    '
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean}
    protected override function mayReuseTransformedTempBitmap(drawMode as SceneObjectDrawMode) as boolean
      return m.lastDrawWasFullyFresh and super.mayReuseTransformedTempBitmap(drawMode)
    end function

  end class

end namespace
