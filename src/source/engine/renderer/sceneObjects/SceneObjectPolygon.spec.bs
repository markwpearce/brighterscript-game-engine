namespace tests

  ' SceneObjectPolygon.getPositionsForFrustumCheck() used to build a conservative 8-point
  ' bounding cube (BGE.Math.getBoundingCubePoints()) around the polygon's world points,
  ' costing an O(N) scan plus 8 fresh Vector allocations on every off-screen frustum check.
  ' DrawablePolygon.points defines a convex, planar polygon, so its own world points are
  ' already a tight bound - these tests lock in that the frustum check (on-screen and
  ' off-screen) still behaves correctly now that it uses those points directly, mirroring
  ' SceneObjectBillboard's equivalent override.
  @suite("BGE.SceneObjectPolygon")
  class SceneObjectPolygonTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap)
      ' The default Camera2d centers on its canvas, so world (100, 50) is canvas (100, 50).
      m.entity.position = BGE.Math.VectorOps.create(100, 50, 0)
    end function

    private function newTrianglePolygon() as BGE.DrawablePolygon
      points = [
        BGE.Math.VectorOps.create(0, -20, 0),
        BGE.Math.VectorOps.create(-20, 20, 0),
        BGE.Math.VectorOps.create(20, 20, 0)
      ]
      return new BGE.DrawablePolygon(m.entity, points)
    end function

    @describe("drawable field")

    @it("is set by direct construction, not just via addToScene (issue #69)")
    function _()
      polygon = m.newTrianglePolygon()
      sceneObj = new BGE.SceneObjectPolygon("test", polygon)
      m.assertNotInvalid(sceneObj.drawable)
    end function

    ' Runs one frame of update+draw for an already-registered scene object, returning how
    ' many draw calls that frame took.
    private function drawOneFrame(sceneObj as BGE.SceneObject) as integer
      m.entity.updateTransformationMatrix()
      m.renderer.resetDrawCallCounter()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)
      return m.renderer.getDrawCallsLastFrame()
    end function

    ' Runs several frames at the entity's current (unchanging) position and returns the
    ' last frame's draw call count. Repeated calls at the same position are what let
    ' GameEntity's own MotionChecker notice nothing moved and "settle" - only once settled
    ' does isPotentiallyOnScreen() run its real frustum check instead of the
    ' first-frame-since-enabled bypass or a cached cull/draw answer from a still-moving object.
    private function settledDrawCalls(sceneObj as BGE.SceneObject, frames as integer) as integer
      draws = 0
      for i = 1 to frames
        draws = m.drawOneFrame(sceneObj)
      end for
      return draws
    end function

    @describe("registration")

    @it("registers itself as a Polygon type scene object")
    function _()
      sceneObj = m.newTrianglePolygon().addToScene(m.renderer)
      m.assertEqual(BGE.SceneObjectType.Polygon, sceneObj.type)
    end function

    @describe("frustum check")

    @it("draws when on screen")
    function _()
      sceneObj = m.newTrianglePolygon().addToScene(m.renderer)
      m.assertTrue(m.settledDrawCalls(sceneObj, 3) > 0)
    end function

    @it("is culled once settled entirely outside the camera frustum")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(100000, 0, 0)
      sceneObj = m.newTrianglePolygon().addToScene(m.renderer)
      m.assertEqual(0, m.settledDrawCalls(sceneObj, 4))
    end function

    @it("draws again once moved back into the frustum")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(100000, 0, 0)
      sceneObj = m.newTrianglePolygon().addToScene(m.renderer)
      m.assertEqual(0, m.settledDrawCalls(sceneObj, 4))

      m.entity.position = BGE.Math.VectorOps.create(100, 50, 0)
      m.assertTrue(m.drawOneFrame(sceneObj) > 0)
    end function

  end class

end namespace
