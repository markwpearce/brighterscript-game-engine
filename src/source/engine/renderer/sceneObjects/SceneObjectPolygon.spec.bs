namespace tests

  ' SceneObjectPolygon.getPositionsForFrustumCheck() used to build a conservative 8-point
  ' bounding cube (BGE.Math.getBoundingCubePoints()) around the polygon's world points,
  ' costing an O(N) scan plus 8 fresh Vector allocations on every off-screen frustum check.
  ' DrawablePolygon.points defines a convex, planar polygon, so its own world points are
  ' already a tight bound - these tests lock in that the frustum check (on-screen and
  ' off-screen) still behaves correctly now that it uses those points directly, mirroring
  ' SceneObjectBillboard's equivalent override.
  @suite("BGE.SceneObjectPolygon")
  class SceneObjectPolygonTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap)
      ' The default Camera2d centers on its canvas, so world (100, 50) is canvas (100, 50).
      m.entity.position = BGE.Math.VectorOps.create(100, 50, 0)
    end function

    private function newTrianglePolygon() as BGE.DrawablePolygon
      points = [
        BGE.Math.VectorOps.create(0, -20, 0),
        BGE.Math.VectorOps.create(-20, 20, 0),
        BGE.Math.VectorOps.create(20, 20, 0)
      ]
      return new BGE.DrawablePolygon(m.entity, points)
    end function

    @describe("drawable field")

    @it("is set by direct construction, not just via addToRenderer (issue #69)")
    function _()
      polygon = m.newTrianglePolygon()
      sceneObj = new BGE.SceneObjectPolygon("test", polygon)
      m.assertNotInvalid(sceneObj.drawable)
    end function

    ' Runs one frame of update+draw for an already-registered scene object, returning how
    ' many draw calls that frame took.
    private function drawOneFrame(sceneObj as BGE.SceneObject) as integer
      m.entity.updateTransformationMatrix()
      m.renderer.resetDrawCallCounter()
      sceneObj.update(m.renderer.camera)
      sceneObj.draw(m.renderer)
      return m.renderer.getDrawCallsLastFrame()
    end function

    ' Runs several frames at the entity's current (unchanging) position and returns the
    ' last frame's draw call count. Repeated calls at the same position are what let
    ' GameEntity's own MotionChecker notice nothing moved and "settle" - only once settled
    ' does isPotentiallyOnScreen() run its real frustum check instead of the
    ' first-frame-since-enabled bypass or a cached cull/draw answer from a still-moving object.
    private function settledDrawCalls(sceneObj as BGE.SceneObject, frames as integer) as integer
      draws = 0
      for i = 1 to frames
        draws = m.drawOneFrame(sceneObj)
      end for
      return draws
    end function

    @describe("registration")

    @it("registers itself as a Polygon type scene object")
    function _()
      sceneObj = m.newTrianglePolygon().addToRenderer(m.renderer)
      m.assertEqual(BGE.SceneObjectType.Polygon, sceneObj.type)
    end function

    @describe("frustum check")

    @it("draws when on screen")
    function _()
      sceneObj = m.newTrianglePolygon().addToRenderer(m.renderer)
      m.assertTrue(m.settledDrawCalls(sceneObj, 3) > 0)
    end function

    @it("is culled once settled entirely outside the camera frustum")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(100000, 0, 0)
      sceneObj = m.newTrianglePolygon().addToRenderer(m.renderer)
      m.assertEqual(0, m.settledDrawCalls(sceneObj, 4))
    end function

    @it("draws again once moved back into the frustum")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(100000, 0, 0)
      sceneObj = m.newTrianglePolygon().addToRenderer(m.renderer)
      m.assertEqual(0, m.settledDrawCalls(sceneObj, 4))

      m.entity.position = BGE.Math.VectorOps.create(100, 50, 0)
      m.assertTrue(m.drawOneFrame(sceneObj) > 0)
    end function

    @describe("concave")

    ' A chevron pointing right, its notch at the entity (canvas (100, 50)).
    private function newChevron() as BGE.DrawablePolygon
      return new BGE.DrawablePolygon(m.entity, [
        BGE.Math.VectorOps.create(-40, -30, 0),
        BGE.Math.VectorOps.create(40, 0, 0),
        BGE.Math.VectorOps.create(-40, 30, 0),
        BGE.Math.VectorOps.create(0, 0, 0)
      ])
    end function

    private function alphaAt(x as integer, y as integer) as integer
      return m.bitmap.GetByteArray(x, y, 1, 1)[3]
    end function

    @it("fills its hull by default")
    function _()
      sceneObj = m.newChevron().addToRenderer(m.renderer)
      m.drawOneFrame(sceneObj)
      m.bitmap.Finish()
      m.assertEqual(255, m.alphaAt(80, 50))
    end function

    @it("fills its outline as drawn when concave")
    function _()
      polygon = m.newChevron()
      polygon.concave = true
      sceneObj = polygon.addToRenderer(m.renderer)
      m.drawOneFrame(sceneObj)
      m.bitmap.Finish()
      m.assertEqual(0, m.alphaAt(80, 50))
      m.assertEqual(255, m.alphaAt(120, 50))
    end function

    @it("redraws when concave is switched on")
    function _()
      polygon = m.newChevron()
      sceneObj = polygon.addToRenderer(m.renderer)
      m.settledDrawCalls(sceneObj, 3)
      polygon.concave = true
      m.bitmap.Clear(&h00000000)
      m.drawOneFrame(sceneObj)
      m.bitmap.Finish()
      m.assertEqual(0, m.alphaAt(80, 50))
      m.assertEqual(255, m.alphaAt(120, 50))
    end function

    ' One frame with the camera's movement checked too, as Game does, so a still scene settles.
    private function drawCameraFrame(sceneObj as BGE.SceneObject) as integer
      m.renderer.setupCameraForFrame()
      return m.drawOneFrame(sceneObj)
    end function

    @it("blits its cached fill once still, rather than re-banding every frame")
    function _()
      polygon = m.newChevron()
      polygon.concave = true
      sceneObj = polygon.addToRenderer(m.renderer)
      m.assertTrue(m.drawCameraFrame(sceneObj) > 1)
      for i = 1 to 3
        m.drawCameraFrame(sceneObj)
      end for
      m.bitmap.Clear(&h00000000)
      m.assertEqual(1, m.drawCameraFrame(sceneObj))
      m.bitmap.Finish()
      m.assertEqual(0, m.alphaAt(80, 50))
      m.assertEqual(255, m.alphaAt(120, 50))
    end function

    @it("re-rasterizes its cached fill when its color changes")
    function _()
      polygon = m.newChevron()
      polygon.concave = true
      sceneObj = polygon.addToRenderer(m.renderer)
      for i = 1 to 4
        m.drawCameraFrame(sceneObj)
      end for
      polygon.color = BGE.ColorsRGB.Red
      m.bitmap.Clear(&h00000000)
      m.assertTrue(m.drawCameraFrame(sceneObj) > 1)
      m.bitmap.Finish()
      ' white before: green drops to 0 once it's redrawn red
      pixel = m.bitmap.GetByteArray(120, 50, 1, 1)
      m.assertEqual(0, pixel[1])
      m.assertEqual(255, pixel[3])
    end function

    @it("never moves a cached fill of its old color into place while moving")
    function _()
      polygon = m.newChevron()
      polygon.concave = true
      sceneObj = polygon.addToRenderer(m.renderer)
      for i = 1 to 4
        m.drawCameraFrame(sceneObj)
      end for
      m.entity.position = BGE.Math.VectorOps.create(101, 50, 0)
      polygon.color = BGE.ColorsRGB.Red
      m.bitmap.Clear(&h00000000)
      m.drawCameraFrame(sceneObj)
      m.bitmap.Finish()
      pixel = m.bitmap.GetByteArray(121, 50, 1, 1)
      m.assertEqual(0, pixel[1])
      m.assertEqual(255, pixel[3])
    end function

    @it("bands straight onto the canvas while moving, then caches once still")
    function _()
      polygon = m.newChevron()
      polygon.concave = true
      sceneObj = polygon.addToRenderer(m.renderer) as BGE.SceneObjectPolygon
      for i = 1 to 4
        m.drawCameraFrame(sceneObj)
      end for
      m.assertNotInvalid(sceneObj.getTempBitmapCapacity())
      ' too far to move the cached fill into place
      m.entity.position = BGE.Math.VectorOps.create(100, 50, 0)
      polygon.points[1] = BGE.Math.VectorOps.create(60, 0, 0)
      polygon.rotation = BGE.Math.VectorOps.create(0, 0, 0.5)
      m.drawCameraFrame(sceneObj)
      m.assertInvalid(sceneObj.getTempBitmapCapacity())
      for i = 1 to 3
        m.drawCameraFrame(sceneObj)
      end for
      m.assertNotInvalid(sceneObj.getTempBitmapCapacity())
    end function

    @it("is never an occluder, so a notch can't hide what's behind it")
    function _()
      polygon = m.newChevron()
      polygon.concave = true
      sceneObj = polygon.addToRenderer(m.renderer)
      m.assertFalse(sceneObj.isEligibleOccluderType())
    end function

    @describe("oriented depth")

    private function assertDepthFromCentre(drawMode as BGE.SceneObjectDrawMode)
      camera = new BGE.Camera3d()
      camera.position = BGE.Math.VectorOps.create(0, 0, -500)
      camera.setTarget(BGE.Math.VectorOps.create(0, 0, 0))
      depthRenderer = new BGE.Renderer(m.bitmap, m.game, camera)
      m.entity.position = BGE.Math.VectorOps.create(0, 0, 300)
      polygon = new BGE.DrawablePolygon(m.entity, [
        BGE.Math.VectorOps.create(-20, -20, 0),
        BGE.Math.VectorOps.create(20, -20, 0),
        BGE.Math.VectorOps.create(20, 20, 0),
        BGE.Math.VectorOps.create(-20, 20, 0)
      ])
      polygon.drawMode = drawMode
      sceneObj = polygon.addToRenderer(depthRenderer)
      m.entity.updateTransformationMatrix()
      depthRenderer.setupCameraForFrame()
      depthRenderer.render()
      m.assertTrue(abs(sceneObj.getDepthPosition().z - 300) < 1)
    end function

    @it("measures oriented depth from the object's own centre, not the world origin")
    function _()
      m.assertDepthFromCentre(BGE.SceneObjectDrawMode.oriented)
    end function

    @it("measures solid depth from the object's own centre, not the world origin")
    function _()
      m.assertDepthFromCentre(BGE.SceneObjectDrawMode.solid)
    end function

  end class

end namespace
