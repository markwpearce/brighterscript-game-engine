namespace tests

  ' SceneObjectText does the actual drawing for a DrawableText. This covers the plain 2D
  ' fast path's anchor support specifically - the rest of SceneObjectText's behavior (region
  ' swapping, pinned corners) is exercised indirectly through the inherited
  ' SceneObjectBillboard paths SceneObjectImage's tests already cover.
  @suite("BGE.SceneObjectText")
  class SceneObjectTextTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    bitmap as roBitmap
    renderer as BGE.Renderer

    ' A real Camera3d, for the "transformed fast draw path" tests below - see
    ' SceneObjectCircle.spec.bs's identical setup for why Camera2d can't exercise this.
    game3d as BGE.Game
    entity3d as BGE.GameEntity
    bitmap3d as roBitmap
    renderer3d as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap)
      m.entity.position = BGE.Math.VectorOps.create(100, 50, 0)

      m.game3d = new BGE.Game(320, 240)
      m.entity3d = new BGE.GameEntity(m.game3d, {name: "TestEntity3d"})
      m.bitmap3d = CreateObject("roBitmap", {width: 320, height: 240, alphaEnable: true})
      m.renderer3d = new BGE.Renderer(m.bitmap3d, m.game3d, new BGE.Camera3d())
      ' Close to the camera and scaled up, like SceneObjectCircle.spec.bs's own "drawn
      ' closer" comment explains: a couple of default-font-sized "hi" pixels at z=500 is
      ' too small for isApproximatelyRotatedRectangle's tolerance to behave predictably -
      ' whole-pixel canvasPoint rounding alone is a large fraction of a tiny quad's size.
      m.entity3d.position = BGE.Math.VectorOps.create(0, 0, 700)
      m.entity3d.scale = BGE.Math.VectorOps.create(4, 4, 4)
    end function

    private function newText(name as string, text = "hi" as string) as BGE.DrawableText
      textDrawable = new BGE.DrawableText(m.entity, text, m.game.getFont("default"))
      m.entity.addDrawable(name, textDrawable)
      return textDrawable
    end function

    @describe("drawable field")

    @it("is set by direct construction, not just via addToScene (issue #69)")
    function _()
      textDrawable = new BGE.DrawableText(m.entity, "hi", m.game.getFont("default"))
      sceneObj = new BGE.SceneObjectText("test", textDrawable)
      m.assertNotInvalid(sceneObj.drawable)
    end function

    @describe("anchor in the plain 2D fast path")

    @it("shifts the drawn text's canvas position by its anchor under directToCamera")
    function _()
      unanchored = m.newText("unanchoredText")
      unanchoredSceneObj = unanchored.addToScene(m.renderer)
      m.entity.updateTransformationMatrix()
      unanchoredSceneObj.update(m.renderer.camera)
      unanchoredSceneObj.draw(m.renderer)

      anchored = m.newText("anchoredText")
      ' anchor.x = 1 (not 0.5) deliberately - halving an odd-pixel-width string's width
      ' would introduce a fractional pixel whose rounding can differ by a font's exact
      ' metrics, making the assertion below flaky. A full-width shift has no such
      ' ambiguity: getSize().width is already a whole pixel count.
      anchored.setAnchor(1, 0)
      anchoredSceneObj = anchored.addToScene(m.renderer)
      anchoredSceneObj.update(m.renderer.camera)
      anchoredSceneObj.draw(m.renderer)

      width = anchored.getSize().width
      unanchoredPos = (unanchoredSceneObj as BGE.SceneObjectText).getCanvasPosition()
      anchoredPos = (anchoredSceneObj as BGE.SceneObjectText).getCanvasPosition()
      m.assertEqual(unanchoredPos.x - Fix(width), anchoredPos.x)
      m.assertEqual(unanchoredPos.y, anchoredPos.y)
    end function

    @describe("transformed fast draw path (issue #163, extending #105 from SceneObjectCircle)")

    ' Registers the text and runs one frame of update+draw for it, mirroring the Game loop
    ' (setupCameraForFrame() then drawScene()).
    private function drawOnce3d(textDrawable as BGE.DrawableText) as BGE.SceneObjectText
      sceneObj = textDrawable.addToScene(m.renderer3d) as BGE.SceneObjectText
      m.entity3d.updateTransformationMatrix()
      m.renderer3d.resetDrawCallCounter()
      m.renderer3d.setupCameraForFrame()
      m.renderer3d.drawScene()
      return sceneObj
    end function

    @it("takes the fast path for text rotated only about the axis facing the camera")
    function _()
      textDrawable = new BGE.DrawableText(m.entity3d, "hi", m.game3d.getFont("default"), {
        rotation: BGE.Math.VectorOps.create(0, 0, BGE.Math.PI / 6)
      })
      sceneObj = m.drawOnce3d(textDrawable)
      m.assertTrue(sceneObj.usedTransformedFastDraw())
    end function

    @it("falls back to the exact drawPinnedCorners path when tilted away from the camera")
    function _()
      textDrawable = new BGE.DrawableText(m.entity3d, "hi", m.game3d.getFont("default"), {
        drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace,
        rotation: BGE.Math.VectorOps.create(1.0, 0, 0)
      })
      sceneObj = m.drawOnce3d(textDrawable)
      m.assertFalse(sceneObj.usedTransformedFastDraw())
      m.assertTrue(m.renderer3d.getDrawCallsLastFrame() > 0)
    end function

  end class

end namespace
