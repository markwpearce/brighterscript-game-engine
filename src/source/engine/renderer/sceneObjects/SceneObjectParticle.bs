import "../../../math/math.bs"
import "../../../math/vector.bs"
import "../../../utils/colors.bs"
import "../../drawables/DrawableParticles.bs"
import "../cameras/Camera.bs"
import "../cameras/Camera3d.bs"
import "../Renderer.bs"
import "../RendererHelpers.bs"
import "SceneObject.bs"

namespace BGE
  ' Draws an entire DrawableParticles emitter's live particles with a single SceneObject
  ' - not one SceneObject per particle. See
  ' specs/2026-08-18-particle-system-design.md ("Why one SceneObjectParticle per
  ' emitter, not per particle") for why: per-particle SceneObjects would call
  ' Renderer.addSceneObject/removeSceneObject every frame during continuous emission,
  ' permanently defeating the depth-sort skip-optimization for the whole renderer.
  '
  class SceneObjectParticle extends SceneObject
    drawable as DrawableParticles

    ' Scratch for drawRectanglesFast()
    private fastPositions as BGE.Math.Vector[] = []
    private fastProjected as float[] = []

    sub new(name as string, drawableObj as DrawableParticles)
      super(name, drawableObj, BGE.SceneObjectType.Particle)
      ' Redeclaring `drawable` above auto-inits it to invalid after super() - this wins since it runs last (issue #69).
      m.drawable = drawableObj
    end sub

    ' A multi-particle emitter can't pass the narrow-phase hull-validity check as a
    ' single object, and clustering doesn't add anything here since particles already
    ' draw as one batched unit - skip broad-phase candidacy entirely.
    override function participatesInOverlapDetection() as boolean
      return false
    end function

    ' The base class only re-checks the frustum when the emitter's own transform/camera
    ' moved (see SceneObject.objMovedInRelationToCamera) - wrong here, since a stationary
    ' emitter's particles still move every frame on their own. Forcing a re-check whenever
    ' particles are alive fixes issue #114 (a stationary off-screen emitter's particles
    ' drifting into view would otherwise stay culled forever). No cost once the emitter is
    ' idle (zero live particles) - same cheap cached-answer path as any other SceneObject.
    protected override function objMovedInRelationToCamera(cameraObj as Camera) as boolean
      return super.objMovedInRelationToCamera(cameraObj) or m.drawable.particles.count() > 0
    end function

    ' The base default checks only the emitter's own anchor (m.worldPosition), which is
    ' wrong for an emitter whose particles have spread away from it (#114). Returns the 8
    ' corners of the box around every live particle (and line end), padded by the most any
    ' particle draws beyond its position in pixels, so they bound everything performDraw()
    ' draws - which lets walls and occluders hide or redraw over it (#463). Still a
    ' fixed number of points to test, whatever the live particle count.
    '
    ' @param {Camera} cameraObj
    ' @return {BGE.Math.Vector[]}
    override function getBoundingPoints(cameraObj as Camera) as BGE.Math.Vector[]
      particles = m.drawable.particles
      if particles.count() = 0
        return [m.worldPosition]
      end if
      isLine = m.drawable.shape = BGE.ParticleShape.Line
      ' each particle keeps the sizes it spawned with, even if the emitter's change since
      maxSize = 0.0
      first = particles[0].position
      minX = first.x
      maxX = minX
      minY = first.y
      maxY = minY
      minZ = first.z ?? 0.0
      maxZ = minZ
      ' scalars rather than a list of points: this runs every frame for every emitter
      for each particle in particles
        size = particle.startSize
        if particle.endSize > size
          size = particle.endSize
        end if
        if size > maxSize
          maxSize = size
        end if
        point = particle.position
        for pass = 0 to 1
          if pass = 1
            if not isLine
              exit for
            end if
            point = m.getLineParticleEnd(particle, BGE.Math.lerp(particle.startSize, particle.endSize, particle.age / particle.lifetime))
          end if
          x = point.x
          y = point.y
          z = point.z ?? 0.0
          if x < minX
            minX = x
          else if x > maxX
            maxX = x
          end if
          if y < minY
            minY = y
          else if y > maxY
            maxY = y
          end if
          if z < minZ
            minZ = z
          else if z > maxZ
            maxZ = z
          end if
        end for
      end for
      minPoint = BGE.Math.VectorOps.create(minX, minY, minZ)
      maxPoint = BGE.Math.VectorOps.create(maxX, maxY, maxZ)
      pad = m.getCanvasRadius(maxSize) * m.getWorldUnitsPerPixel(cameraObj, minPoint, maxPoint)
      x0 = minPoint.x - pad
      x1 = maxPoint.x + pad
      y0 = minPoint.y - pad
      y1 = maxPoint.y + pad
      z0 = minZ - pad
      z1 = maxZ + pad
      return [
        BGE.Math.VectorOps.create(x0, y0, z0), BGE.Math.VectorOps.create(x1, y0, z0),
        BGE.Math.VectorOps.create(x0, y1, z0), BGE.Math.VectorOps.create(x1, y1, z0),
        BGE.Math.VectorOps.create(x0, y0, z1), BGE.Math.VectorOps.create(x1, y0, z1),
        BGE.Math.VectorOps.create(x0, y1, z1), BGE.Math.VectorOps.create(x1, y1, z1)
      ]
    end function

    ' Its bounding points cover every particle it draws (see getBoundingPoints()).
    '
    ' @return {boolean}
    override function canBeOccluded() as boolean
      return true
    end function

    ' The furthest, in pixels, a particle of `size` can draw from its projected position.
    ' A line's length is in world units, so it's already in the bounds.
    private function getCanvasRadius(size as float) as float
      shape = m.drawable.shape
      if shape = BGE.ParticleShape.Rectangle
        ' half the diagonal of a centred square
        return size * 0.7072
      else if shape = BGE.ParticleShape.Image
        image = m.drawable.image
        if invalid = image
          return 0
        end if
        width = image.GetWidth()
        height = image.GetHeight()
        frameRegions = m.drawable.getFrameRegions()
        if invalid <> frameRegions and frameRegions.count() > 0
          width = frameRegions[0].GetWidth()
          height = frameRegions[0].GetHeight()
        end if
        ' a scaled image rotated about any point inside it stays within its diagonal
        return sqr(width * width + height * height) * size
      end if
      return 1
    end function

    ' How many world units one pixel covers at the far side of the box, so padding by it
    ' over-covers nearer particles rather than under-covering far ones.
    private function getWorldUnitsPerPixel(cameraObj as Camera, minPoint as BGE.Math.Vector, maxPoint as BGE.Math.Vector) as float
      if not cameraObj.isPerspective()
        return 1.0
      end if
      camera3d = cameraObj as BGE.Camera3d
      camPos = camera3d.position
      ' the box corner furthest from the camera on each axis
      dx = BGE.Math.max(abs(minPoint.x - camPos.x), abs(maxPoint.x - camPos.x))
      dy = BGE.Math.max(abs(minPoint.y - camPos.y), abs(maxPoint.y - camPos.y))
      dz = BGE.Math.max(abs((minPoint.z ?? 0) - (camPos.z ?? 0)), abs((maxPoint.z ?? 0) - (camPos.z ?? 0)))
      return sqr(dx * dx + dy * dy + dz * dz) / camera3d.getFocalLength()
    end function

    protected override function performDraw(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      if m.drawable.shape = BGE.ParticleShape.Rectangle and rendererObj.camera.isPerspective()
        return m.drawRectanglesFast(rendererObj)
      end if
      return m.drawEachParticle(rendererObj)
    end function

    ' Rectangle particles with a Camera3d: projected in one pass, with the color maths inline.
    private function drawRectanglesFast(rendererObj as BGE.Renderer) as boolean
      particles = m.drawable.particles
      if particles.count() = 0
        return false
      end if
      camera = rendererObj.camera
      fadesWithDistance = camera.fadesWithDistance() and m.drawable.fadesWithDistance
      positions = m.fastPositions
      positions.Clear()
      for each particle in particles
        positions.push(particle.position)
      end for
      projected = m.fastProjected
      (camera as BGE.Camera3d).projectPointsWithDepth(positions, projected, true)
      didDrawAny = false
      i = -3
      for each particle in particles
        i += 3
        ' behind the camera, as drawEachParticle() skips it
        if projected[i + 2] = BGE.PROJECTED_BEHIND_CAMERA_DEPTH
          continue for
        end if
        fade = 1.0
        if fadesWithDistance
          fade = camera.getDistanceFadeAlpha(particle.position)
        end if
        t = particle.age / particle.lifetime
        if t > 1
          t = 1
        end if
        a = particle.startColor
        b = particle.endColor
        red = (a >> 16) and &hFF
        green = (a >> 8) and &hFF
        blue = a and &hFF
        red = Int(red + (((b >> 16) and &hFF) - red) * t + 0.5)
        green = Int(green + (((b >> 8) and &hFF) - green) * t + 0.5)
        blue = Int(blue + ((b and &hFF) - blue) * t + 0.5)
        alpha = Int((particle.startAlpha + (particle.endAlpha - particle.startAlpha) * t) * fade + 0.5)
        if alpha > 255
          alpha = 255
        else if alpha < 0
          alpha = 0
        end if
        size = particle.startSize + (particle.endSize - particle.startSize) * t
        ' DrawPoint: a centred square, about twice as fast as DrawRect on device
        if fade > 0
          didDrawAny = rendererObj.drawSquare(projected[i], projected[i + 1], size, (red << 24) + (green << 16) + (blue << 8) + alpha) or didDrawAny
        end if
      end for
      return didDrawAny
    end function

    private function drawEachParticle(rendererObj as BGE.Renderer) as boolean
      didDrawAny = false

      fadesWithDistance = rendererObj.camera.fadesWithDistance() and m.drawable.fadesWithDistance
      for each particle in m.drawable.particles
        particleFade = 1.0
        if fadesWithDistance
          particleFade = rendererObj.camera.getDistanceFadeAlpha(particle.position)
          if particleFade <= 0
            continue for
          end if
        end if
        canvasPos = rendererObj.worldPointToCanvasPoint(particle.position)
        if canvasPos = invalid
          continue for
        end if

        t = particle.age / particle.lifetime
        if t > 1
          t = 1
        end if
        color = BGE.lerpColorRGB(particle.startColor, particle.endColor, t)
        alpha = BGE.Math.lerp(particle.startAlpha, particle.endAlpha, t) / 255.0
        rgba = BGE.RGBAtoRGBA((color >> 16) and &hFF, (color >> 8) and &hFF, color and &hFF, alpha)
        rgba = BGE.RendererHelpers.applyAlphaFade(rgba, particleFade)
        size = BGE.Math.lerp(particle.startSize, particle.endSize, t)

        if m.drawable.shape = BGE.ParticleShape.Line
          didDrawAny = m.drawLineParticle(rendererObj, particle, canvasPos, size, rgba) or didDrawAny
        else if m.drawable.shape = BGE.ParticleShape.Rectangle
          didDrawAny = rendererObj.drawSquare(canvasPos.x, canvasPos.y, size, rgba) or didDrawAny
        else if m.drawable.shape = BGE.ParticleShape.Image and m.drawable.image <> invalid
          regionToDraw = m.drawable.image
          frameRegions = m.drawable.getFrameRegions()
          if frameRegions <> invalid and frameRegions.count() > 0
            frameIndex = Int(t * frameRegions.count())
            if frameIndex >= frameRegions.count()
              frameIndex = frameRegions.count() - 1
            end if
            if frameIndex < 0
              frameIndex = 0
            end if
            regionToDraw = frameRegions[frameIndex]
          end if
          didDrawAny = rendererObj.drawRegion(regionToDraw, canvasPos.x, canvasPos.y, size, size, BGE.Math.DegreesToRadians(particle.rotation), rgba) or didDrawAny
        end if
      end for

      return didDrawAny
    end function

    private function drawLineParticle(rendererObj as BGE.Renderer, particle as BGE.ParticleRecord, canvasPos as BGE.Math.Vector, length as float, rgba as integer) as boolean
      endCanvasPos = rendererObj.worldPointToCanvasPoint(m.getLineParticleEnd(particle, length))
      if endCanvasPos = invalid
        return false
      end if
      return rendererObj.drawLine(canvasPos.x, canvasPos.y, endCanvasPos.x, endCanvasPos.y, rgba)
    end function

    ' A line particle runs `length` world units from its position along its velocity.
    private function getLineParticleEnd(particle as BGE.ParticleRecord, length as float) as BGE.Math.Vector
      direction = BGE.Math.VectorOps.create(1, 0)
      if not BGE.Math.VectorOps.isZero(particle.velocity)
        direction = BGE.Math.VectorOps.getNormalizedCopy(particle.velocity)
      end if
      return BGE.Math.VectorOps.add(particle.position, BGE.Math.VectorOps.scale(direction, length))
    end function
    ' Particles fade one by one in performDraw(), each by its own distance, rather than
    ' the whole emitter fading (or being culled) as one.
    override function participatesInDistanceFade() as boolean
      return false
    end function

  end class
end namespace
