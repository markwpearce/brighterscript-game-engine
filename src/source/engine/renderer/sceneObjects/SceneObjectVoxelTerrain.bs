import "../../../math/math.bs"
import "../../../math/vector.bs"
import "../../drawables/DrawableVoxelTerrain.bs"
import "../../voxel/VoxelMap.bs"
import "../cameras/Camera3d.bs"
import "../voxel/VoxelTerrainView.bs"
import "../Renderer.bs"
import "SceneObject.bs"

namespace BGE

  ' Where an object sits against the terrain's hills - see SceneObjectVoxelTerrain.testHidden().
  enum VoxelHidden
    visible = 0
    partly = 1
    all = 2
  end enum

  ' Draws a DrawableVoxelTerrain: marches a VoxelTerrainView from the camera whenever anything
  ' that shapes it changes (otherwise draws last frame's spans again), straight to the target,
  ' or with roll into a level view as wide as the frame's diagonal that's rotated on.
  class SceneObjectVoxelTerrain extends SceneObject

    drawable as DrawableVoxelTerrain

    ' The march: its spans are in level-view pixels
    view as BGE.VoxelTerrainView

    ' Whether the last draw marched (false: it reused the spans) and was rolled
    marchedLastFrame as boolean = false
    rolledLastFrame as boolean = false
    ' Spans drawn again over objects in the last frame
    redrawsLastFrame as integer = 0

    private warnedCamera2d as boolean = false
    private marchKey as string = ""
    private mapVersion as integer = -1
    private levelBitmap as object = invalid
    private whitePixel as object = invalid
    ' the last march's level view: its size, where the target's top left sits in it, the roll
    private levelWidth as float = 0
    private levelHeight as float = 0
    private cropX as float = 0
    private cropY as float = 0
    private rollRad as float = 0
    private rollCos as float = 1
    private rollSin as float = 0
    ' where depth is measured from (world) and along (level forward)
    private eyeX as float = 0
    private eyeZ as float = 0
    private levelForwardX as float = 0
    private levelForwardZ as float = -1

    sub new(name as string, drawableObj as DrawableVoxelTerrain)
      super(name, drawableObj, BGE.SceneObjectType.VoxelTerrain)
      ' Redeclaring `drawable` above auto-inits it to invalid after super() - this wins since it runs last (issue #69).
      m.drawable = drawableObj
      m.view = new BGE.VoxelTerrainView(drawableObj.map)
      m.mapVersion = drawableObj.geometryVersion
    end sub

    override function drawsInFixedStage() as boolean
      return true
    end function

    override function participatesInOverlapDetection() as boolean
      return false
    end function

    ' Fades by its own fog table instead.
    override function participatesInDistanceFade() as boolean
      return false
    end function

    override function isEligibleForStaticBsp() as boolean
      return false
    end function

    protected override function isPotentiallyOnScreen(cameraObj as Camera) as boolean
      return true
    end function

    ' The march runs in performDraw(), when its key changes.
    protected override function findCanvasPosition(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      return m.hasCamera3d(rendererObj)
    end function

    protected override function performDraw(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      if not m.hasCamera3d(rendererObj)
        return false
      end if
      camera = rendererObj.camera as Camera3d
      d = m.drawable
      m.redrawsLastFrame = 0
      m.marchedLastFrame = false
      if m.mapVersion <> d.geometryVersion
        m.mapVersion = d.geometryVersion
        m.view.setMap(d.map)
      end if
      view = m.view
      quality = rendererObj.qualitySettings
      view.columns = quality.voxelColumns
      view.bandSteps = quality.voxelBandSteps
      view.fogColor = -1
      view.fogStart = 0.5
      fog = camera.fog
      if fog.enabled
        view.fogColor = fog.color
        ' the draw distance's fade band, like objects and walls
        view.fogStart = 1 - BGE.Math.Clamp(camera.drawDistanceFadeFraction, 0, 1)
      else if invalid <> d.fade
        view.fogColor = d.fade.color
        if invalid <> d.fade.start
          view.fogStart = d.fade.start
        end if
      end if

      pose = m.buildPose(camera)
      if invalid = pose
        return false
      end if
      ' the rolled level view is wider than the frame: as many columns across the frame
      if pose.viewWidth > camera.frameSize.x
        view.columns = cint(view.columns * pose.viewWidth / camera.frameSize.x)
      end if
      rolled = camera.rollDegrees <> 0
      key = `${pose.camX}|${pose.camZ}|${pose.camHeight}|${pose.forwardX}|${pose.forwardZ}|${pose.pitch}|${pose.horizon}|${pose.focal}|${pose.viewWidth}|${pose.viewHeight}|${pose.distance}|${pose.cellSize}|${pose.heightScale}|${pose.exactPitch}|${view.columns}|${view.bandSteps}|${view.fogColor}|${view.fogStart}|${m.mapVersion}|${rolled}`
      if key <> m.marchKey
        m.marchKey = key
        view.march(pose)
        m.marchedLastFrame = true
      end if
      m.rolledLastFrame = rolled
      if not rolled
        ' last frame's queued draws from it have run
        m.levelBitmap = invalid
        m.drawSpans(rendererObj, rendererObj.getDraw2d())
        return true
      end if
      if m.marchedLastFrame or invalid = m.levelBitmap
        size = cint(m.levelWidth)
        if invalid = m.levelBitmap or m.levelBitmap.GetWidth() <> size
          m.levelBitmap = CreateObject("roBitmap", {width: size, height: size, AlphaEnable: true})
          if invalid = m.levelBitmap
            print "[BGE.SceneObjectVoxelTerrain] warning: couldn't allocate a "; size; " square level bitmap - skipping the terrain this frame"
            m.marchKey = ""
            return false
          end if
        end if
        m.levelBitmap.Clear(&h00000000)
        m.drawSpans(rendererObj, m.levelBitmap)
      end if
      centre = BGE.Math.VectorOps.create(m.levelWidth / 2, m.levelHeight / 2)
      return rendererObj.drawRotatedImageWithCenterTo(rendererObj.getDraw2d(), m.levelBitmap, centre, m.rollRad, BGE.Math.VectorOps.create(-m.cropX, -m.cropY))
    end function

    ' The view's pose for the camera: invalid looking straight up or down
    private function buildPose(camera as Camera3d) as dynamic
      d = m.drawable
      o = camera.orientation
      lenXZ = sqr(o.x * o.x + o.z * o.z)
      if lenXZ < 0.0001
        return invalid
      end if
      forwardX = o.x / lenXZ
      forwardZ = o.z / lenXZ
      right = camera.getLevelRightVector()
      rightLen = sqr(right.x * right.x + right.z * right.z)
      if rightLen < 0.0001
        return invalid
      end if
      pitch = atn(o.y / lenXZ)
      origin = d.getMapOrigin()
      p = camera.position
      cellSize = d.cellSize
      focal = camera.getFocalLength()
      width = camera.frameSize.x
      height = camera.frameSize.y
      m.cropX = 0
      m.cropY = 0
      m.rollRad = 0
      ' a shear camera shows its pitch by moving the image centre down this far
      shift = camera.getPitchShiftY()
      shear = camera.pitchMode = BGE.CameraPitchMode.shear
      if shear
        pitch = 0
      end if
      if camera.rollDegrees <> 0
        ' turned about the image centre, so it must reach the frame's corners from there
        size = camera.getRollViewSize()
        m.cropX = (size - width) / 2
        m.cropY = (size - height) / 2 - shift
        width = size
        height = size
        m.rollRad = BGE.Math.DegreesToRadians(camera.rollDegrees)
      end if
      m.rollCos = cos(m.rollRad)
      m.rollSin = sin(m.rollRad)
      m.levelWidth = width
      m.levelHeight = height
      m.eyeX = p.x
      m.eyeZ = p.z
      m.levelForwardX = forwardX
      m.levelForwardZ = forwardZ
      exact = d.pitchMode = BGE.VoxelPitchMode.exact and not shear
      horizon = height / 2
      if shear
        ' level, like the camera: its image centre, which the roll's composite is centred on
        if camera.rollDegrees = 0
          horizon += shift
        end if
      else if not exact
        horizon = height / 2 + focal * tan(pitch)
      end if
      camX = (p.x - origin.x) / cellSize
      camZ = (p.z - (origin.z ?? 0)) / cellSize
      map = d.map
      if map.edgeMode = BGE.VoxelEdgeMode.wrap
        ' the same view from the copy of the map the camera is over: keeps the march's 16.16
        ' positions small however far it flies
        camX -= map.size * int(camX / map.size)
        camZ -= map.size * int(camZ / map.size)
      end if
      return {
        camX: camX,
        camZ: camZ,
        camHeight: (p.y - (origin.y ?? 0)) / d.heightScale,
        forwardX: forwardX,
        forwardZ: forwardZ,
        rightX: right.x / rightLen,
        rightZ: right.z / rightLen,
        focal: focal,
        viewWidth: width,
        viewHeight: height,
        horizon: horizon,
        pitch: pitch,
        exactPitch: exact,
        distance: camera.getCurrentDrawDistance() / cellSize,
        cellSize: cellSize,
        heightScale: d.heightScale
      }
    end function

    ' Every span of the last march into a target, in level-view pixels
    private sub drawSpans(rendererObj as Renderer, target as object)
      view = m.view
      colWidth = view.columnWidth
      columnSpans = view.columnSpans
      count = 0
      for i = 0 to columnSpans.count() - 1
        record = columnSpans[i]
        colX = i * colWidth
        for r = 0 to record.count() - 1 step 4
          target.DrawRect(colX, record[r], colWidth + 1, record[r + 1], record[r + 2])
        end for
        count += record.count() \ 4
      end for
      rendererObj.incrementDrawCalls(count)
    end sub

    ' How far a world point is along the level view direction, as the spans' depths are.
    '
    ' @param {BGE.Math.Vector} point
    ' @return {float}
    function levelDepthOf(point as BGE.Math.Vector) as float
      return (point.x - m.eyeX) * m.levelForwardX + ((point.z ?? 0) - m.eyeZ) * m.levelForwardZ
    end function

    ' Where a point on the target is in the level view (the same with no roll).
    '
    ' @param {float} x
    ' @param {float} y
    ' @return {BGE.Math.Vector}
    function levelPointOf(x as float, y as float) as BGE.Math.Vector
      if m.rollRad = 0
        return BGE.Math.VectorOps.create(x, y)
      end if
      ' the level view is turned by the roll about its centre onto the target's centre
      cx = m.levelWidth / 2
      cy = m.levelHeight / 2
      dx = x + m.cropX - cx
      dy = y + m.cropY - cy
      return BGE.Math.VectorOps.create(cx + dx * m.rollCos - dy * m.rollSin, cy + dx * m.rollSin + dy * m.rollCos)
    end function

    ' Whether hills hide an object, from its projected points (x, y, depth triples from
    ' Camera3d.projectPointsWithDepth()). Only partly if any point is behind the camera: its
    ' on-screen part then reaches past the box of the rest.
    '
    ' @param {float[]} projected
    ' @param {float} allLimit level depth (see levelDepthOf()) hills must be nearer than to hide
    '   all of it: its nearest point's, less the tolerance
    ' @param {float} limit level depth hills nearer than are drawn back over it
    ' @param {BGE.VoxelHideBox} hideBox filled with the object's level-view box and columns, for
    '   redrawOver()
    ' @return {integer} a BGE.VoxelHidden
    function testHidden(projected as float[], allLimit as float, limit as float, hideBox as BGE.VoxelHideBox) as integer
      left = 1e9
      top = 1e9
      right = -1e9
      bottom = -1e9
      ' levelPointOf(), inline: this runs for every sorted object's points
      rolled = m.rollRad <> 0
      cx = m.levelWidth / 2
      cy = m.levelHeight / 2
      offsetX = m.cropX - cx
      offsetY = m.cropY - cy
      rollCos = m.rollCos
      rollSin = m.rollSin
      behind = BGE.PROJECTED_BEHIND_CAMERA_DEPTH
      anyBehind = false
      for i = 0 to projected.count() - 1 step 3
        if projected[i + 2] = behind
          anyBehind = true
        else
          px = projected[i]
          py = projected[i + 1]
          if rolled
            dx = px + offsetX
            dy = py + offsetY
            px = cx + dx * rollCos - dy * rollSin
            py = cy + dx * rollSin + dy * rollCos
          end if
          if px < left
            left = px
          end if
          if px > right
            right = px
          end if
          if py < top
            top = py
          end if
          if py > bottom
            bottom = py
          end if
        end if
      end for
      view = m.view
      colWidth = view.columnWidth
      lastColumn = view.columnSpans.count() - 1
      if right < left or colWidth <= 0 or lastColumn < 0
        return BGE.VoxelHidden.visible
      end if
      firstCol = int(left / colWidth)
      lastCol = int(right / colWidth)
      if firstCol < 0
        firstCol = 0
      end if
      if lastCol > lastColumn
        lastCol = lastColumn
      end if
      if firstCol > lastCol
        return BGE.VoxelHidden.visible
      end if
      hideBox.top = top
      hideBox.bottom = bottom
      hideBox.firstColumn = firstCol
      hideBox.lastColumn = lastCol
      hideBox.limit = limit
      ' occluderTopAt() is the view's bottom where nothing rises: below it is never hidden
      hideBottom = bottom
      if hideBottom > view.viewHeight
        hideBottom = view.viewHeight
      end if
      anyHidden = false
      allHidden = not anyBehind
      for c = firstCol to lastCol
        if not anyHidden and view.occluderTopAt(c, limit) < hideBottom
          anyHidden = true
        end if
        if allHidden and view.occluderTopAt(c, allLimit) > top
          allHidden = false
        end if
        if anyHidden and not allHidden
          exit for
        end if
      end for
      if allHidden
        return BGE.VoxelHidden.all
      end if
      if anyHidden
        return BGE.VoxelHidden.partly
      end if
      return BGE.VoxelHidden.visible
    end function

    ' Draws again, clipped to a box from testHidden() (one column wider each side), the spans
    ' nearer than its limit - to put the hills back over an object drawn after them.
    '
    ' @param {Renderer} rendererObj
    ' @param {BGE.VoxelHideBox} hideBox
    sub redrawOver(rendererObj as Renderer, hideBox as BGE.VoxelHideBox)
      view = m.view
      colWidth = view.columnWidth
      columnSpans = view.columnSpans
      firstCol = hideBox.firstColumn - 1
      lastCol = hideBox.lastColumn + 1
      if firstCol < 0
        firstCol = 0
      end if
      if lastCol > columnSpans.count() - 1
        lastCol = columnSpans.count() - 1
      end if
      boxTop = int(hideBox.top)
      boxBottom = int(hideBox.bottom) + 1
      limit = hideBox.limit
      draw2d = rendererObj.getDraw2d()
      rolled = m.rollRad <> 0
      count = 0
      for c = firstCol to lastCol
        record = columnSpans[c]
        colX = c * colWidth
        ' only what's nearer than the limit: up to the column's top there (a span may reach
        ' farther than where it starts)
        clipTop = view.occluderTopAt(c, limit)
        if clipTop < boxTop
          clipTop = boxTop
        end if
        for r = 0 to record.count() - 1 step 4
          if record[r + 3] >= limit
            exit for
          end if
          spanTop = record[r]
          spanBottom = spanTop + record[r + 1]
          if spanTop < boxBottom and spanBottom > clipTop
            if spanTop < clipTop
              spanTop = clipTop
            end if
            if spanBottom > boxBottom
              spanBottom = boxBottom
            end if
            if rolled
              m.drawRolledRect(rendererObj, draw2d, colX, spanTop, colWidth + 1, spanBottom - spanTop, record[r + 2])
            else
              draw2d.DrawRect(colX, spanTop, colWidth + 1, spanBottom - spanTop, record[r + 2])
            end if
            count++
          end if
        end for
      end for
      m.redrawsLastFrame += count
      rendererObj.incrementDrawCalls(count)
    end sub

    ' A level-view rect drawn turned by the roll onto the target, as a tinted white pixel
    private sub drawRolledRect(rendererObj as Renderer, draw2d as object, x as float, y as float, width as float, height as float, rgba as integer)
      if invalid = m.whitePixel
        m.whitePixel = CreateObject("roBitmap", {width: 1, height: 1, AlphaEnable: false})
        m.whitePixel.Clear(&hFFFFFFFF)
      end if
      ' where the rect's top left lands: the inverse of levelPointOf()
      cx = m.levelWidth / 2
      cy = m.levelHeight / 2
      dx = x - cx
      dy = y - cy
      tx = cx + dx * m.rollCos + dy * m.rollSin - m.cropX
      ty = cy - dx * m.rollSin + dy * m.rollCos - m.cropY
      draw2d.DrawTransformedObject(tx, ty, BGE.Math.RadiansToDegrees(m.rollRad), width, height, m.whitePixel, rgba)
    end sub

    private function hasCamera3d(rendererObj as Renderer) as boolean
      if rendererObj.camera.name = "Camera3d"
        return true
      end if
      if not m.warnedCamera2d
        m.warnedCamera2d = true
        m.drawable.log("Drawable '" + m.drawable.name + "' (voxel terrain) needs a Camera3d - it draws nothing with a " + rendererObj.camera.name, BGE.Debug.LogLevel.warning)
      end if
      return false
    end function

  end class

end namespace
