namespace tests

  @suite("BGE.SceneObjectPlane")
  class SceneObjectPlaneTests extends rooibos.BaseTestSuite

    game as BGE.Game
    drawable as BGE.DrawablePlane
    testScene as BGE.GameScene
    plane as BGE.SceneObjectPlane

    protected override function beforeEach()
      m.game = new BGE.Game(200, 200)
      m.game.setCamera(new BGE.Camera3d())
      m.game.canvas.renderer.camera.setFrameSize(200, 100)

      m.testScene = new BGE.GameScene(m.game, {name: "TestScene"})
      m.game.defineScene(m.testScene)
      m.game.changeScene("TestScene")

      bmp = CreateObject("roBitmap", {width: 8, height: 8, AlphaEnable: true})
      region = CreateObject("roRegion", bmp, 0, 0, 8, 8)
      m.drawable = new BGE.DrawablePlane(m.testScene, region, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}})
      m.plane = new BGE.SceneObjectPlane("plane", m.drawable)
    end function

    @describe("getRollCanvasSize")

    @it("returns a size at least as large as the frame's diagonal")
    function _()
      size = m.plane.getRollCanvasSize(BGE.Math.VectorOps.create(200, 100))
      diagonal = Sqr(200.0 * 200.0 + 100.0 * 100.0)

      m.assertTrue(size >= diagonal)
    end function

    @describe("a plane keeps drawing once the camera passes its anchor point")

    ' Regression test: render() used to gate draw() on negDistanceFromCamera, measured
    ' from the plane's fixed anchor point - once the camera passed that anchor, it read as
    ' "behind the camera" even though the ground was still in view, permanently blanking
    ' the plane. Needs two stacked planes since a single plane's own isPotentiallyOnScreen()
    ' short-circuit would otherwise mask the missed draw() call.
    @it("still draws every stacked plane after the camera has moved past their shared anchor point")
    function _()
      colorDrawable = new BGE.DrawablePlane(m.testScene, invalid, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.color, color: BGE.ColorsRGB.Green})
      m.testScene.addDrawable("GroundBase", colorDrawable)

      bmp = CreateObject("roBitmap", {width: 120, height: 120, AlphaEnable: true})
      region = CreateObject("roRegion", bmp, 0, 0, 120, 120)
      tiledDrawable = new BGE.DrawablePlane(m.testScene, region, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
      m.testScene.addDrawable("GroundOverlay", tiledDrawable)

      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 38, -100))
      m.game.canvas.renderer.setupCameraForFrame()
      m.game.canvas.renderer.render()

      ' Teleport far past the shared anchor point (0,0,0), same heading.
      camera.position = BGE.Math.VectorOps.create(0, 50, -1600)
      camera.setTarget(BGE.Math.VectorOps.create(0, 38, -1700))
      m.game.canvas.renderer.resetDrawCallCounter()
      m.game.canvas.renderer.setupCameraForFrame()
      m.game.canvas.renderer.render()

      m.assertTrue(m.game.canvas.renderer.getDrawCallsLastFrame() > 0)
    end function

    @describe("far distance follows camera.maxDrawDistance")

    @it("still draws successfully when maxDrawDistance is larger")
    function _()
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 1, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 1, -100))
      camera.maxDrawDistance = 10
      camera.checkMovement()
      m.plane.update(camera)
      m.game.canvas.renderer.resetDrawCallCounter()
      m.plane.draw(m.game.canvas.renderer)

      m.assertTrue(m.game.canvas.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("still draws successfully when maxDrawDistance is small")
    function _()
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 1, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 1, -100))
      camera.maxDrawDistance = 5
      camera.checkMovement()
      m.plane.update(camera)
      m.game.canvas.renderer.resetDrawCallCounter()
      m.plane.draw(m.game.canvas.renderer)

      m.assertTrue(m.game.canvas.renderer.getDrawCallsLastFrame() > 0)
    end function

    @describe("color fillMode")

    @it("draws successfully near the plane's own anchor position")
    function _()
      colorDrawable = new BGE.DrawablePlane(m.testScene, invalid, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.color, color: BGE.ColorsRGB.Green})
      colorPlane = new BGE.SceneObjectPlane("colorPlane", colorDrawable)

      ' Default camera is degenerate for rendering (same height as plane) - use a level-gaze camera instead.
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 1, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 1, -100))
      camera.checkMovement()

      colorPlane.update(camera)
      m.game.canvas.renderer.resetDrawCallCounter()
      colorPlane.draw(m.game.canvas.renderer)

      m.assertTrue(m.game.canvas.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("still draws far from the plane's own anchor position, unlike a staticImage decal")
    function _()
      colorDrawable = new BGE.DrawablePlane(m.testScene, invalid, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.color})
      colorPlane = new BGE.SceneObjectPlane("colorPlane", colorDrawable)

      ' Same geometry as above, translated far from the anchor - a staticImage plane
      ' would run out of texture here, but a color plane skips that bounds check entirely.
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(5000, 1, 5000)
      camera.setTarget(BGE.Math.VectorOps.create(5000, 1, 4900))
      camera.checkMovement()

      colorPlane.update(camera)
      m.game.canvas.renderer.resetDrawCallCounter()
      colorPlane.draw(m.game.canvas.renderer)

      m.assertTrue(m.game.canvas.renderer.getDrawCallsLastFrame() > 0)
    end function

    @describe("tiledImage fillMode")

    @it("draws successfully from a small tile, near the plane's own anchor position")
    function _()
      bmp = CreateObject("roBitmap", {width: 8, height: 8, AlphaEnable: true})
      region = CreateObject("roRegion", bmp, 0, 0, 8, 8)
      tiledDrawable = new BGE.DrawablePlane(m.testScene, region, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
      tiledPlane = new BGE.SceneObjectPlane("tiledPlane", tiledDrawable)

      ' Default camera is degenerate for rendering (same height as plane) - use a level-gaze camera instead.
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 1, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 1, -100))
      camera.maxDrawDistance = 200
      camera.checkMovement()

      tiledPlane.update(camera)
      m.game.canvas.renderer.resetDrawCallCounter()
      tiledPlane.draw(m.game.canvas.renderer)

      m.assertTrue(m.game.canvas.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("still draws far from the plane's own anchor position, unlike a staticImage decal")
    function _()
      bmp = CreateObject("roBitmap", {width: 8, height: 8, AlphaEnable: true})
      region = CreateObject("roRegion", bmp, 0, 0, 8, 8)
      tiledDrawable = new BGE.DrawablePlane(m.testScene, region, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
      tiledPlane = new BGE.SceneObjectPlane("tiledPlane", tiledDrawable)

      ' Same geometry as above, translated far from the anchor - a staticImage plane
      ' would run out of texture here, but a tiled plane repeats to cover maxDrawDistance.
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(5000, 1, 5000)
      camera.setTarget(BGE.Math.VectorOps.create(5000, 1, 4900))
      camera.maxDrawDistance = 200
      camera.checkMovement()

      tiledPlane.update(camera)
      m.game.canvas.renderer.resetDrawCallCounter()
      tiledPlane.draw(m.game.canvas.renderer)

      m.assertTrue(m.game.canvas.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("caps the supertexture's physical bitmap size for a large maxDrawDistance, still draws")
    function _()
      ' Bigger 128px tile (vs. this suite's usual 8px) - an 8px tile against
      ' maxDrawDistance=1000 needs far too many tile-blit calls to build the
      ' supertexture, making the test prohibitively slow under brs-cli.
      bmp = CreateObject("roBitmap", {width: 128, height: 128, AlphaEnable: true})
      region = CreateObject("roRegion", bmp, 0, 0, 128, 128)
      tiledDrawable = new BGE.DrawablePlane(m.testScene, region, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
      tiledPlane = new BGE.SceneObjectPlane("tiledPlane", tiledDrawable)

      ' maxDrawDistance=1000 (examples/terrain's default) overflowed a real device's
      ' bitmap allocator before the physical-size cap existed. Camera3d clamps this to
      ' 900 under brs-cli/the simulator, but the assertions hold at either value.
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 1, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 1, -100))
      camera.maxDrawDistance = 1000
      camera.checkMovement()

      tiledPlane.update(camera)
      m.game.canvas.renderer.resetDrawCallCounter()
      tiledPlane.draw(m.game.canvas.renderer)

      m.assertTrue(m.game.canvas.renderer.getDrawCallsLastFrame() > 0)
      ' getMaxSuperTextureDimension() returns 1024 on this (non-FHD) device budget.
      ' Cast to `object` to reach private fields - BrighterScript's access modifiers
      ' aren't enforced on dynamic member access.
      dynamicPlane = tiledPlane as object
      m.assertTrue(dynamicPlane.superTextureBmp.GetWidth() <= 1024)
      m.assertTrue(dynamicPlane.superTextureBmp.GetHeight() <= 1024)
      m.assertTrue(dynamicPlane.superTextureScale < 1.0)
    end function

    @it("does not downscale the supertexture when logical coverage already fits the device budget")
    function _()
      bmp = CreateObject("roBitmap", {width: 8, height: 8, AlphaEnable: true})
      region = CreateObject("roRegion", bmp, 0, 0, 8, 8)
      tiledDrawable = new BGE.DrawablePlane(m.testScene, region, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
      tiledPlane = new BGE.SceneObjectPlane("tiledPlane", tiledDrawable)

      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 1, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 1, -100))
      camera.maxDrawDistance = 5
      camera.checkMovement()

      tiledPlane.update(camera)
      m.game.canvas.renderer.resetDrawCallCounter()
      tiledPlane.draw(m.game.canvas.renderer)

      m.assertTrue(m.game.canvas.renderer.getDrawCallsLastFrame() > 0)
      dynamicPlane = tiledPlane as object
      m.assertEqual(1.0, dynamicPlane.superTextureScale)
    end function

    @describe("cache invalidation")

    @it("redraws its cached image once after the quality settings change, even when nothing moved")
    function _()
      bmp = CreateObject("roBitmap", {width: 120, height: 120, AlphaEnable: true})
      region = CreateObject("roRegion", bmp, 0, 0, 120, 120)
      ground = new BGE.DrawablePlane(m.testScene, region, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
      m.testScene.addDrawable("Ground", ground)

      renderer = m.game.canvas.renderer
      camera = renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 38, -100))

      for i = 1 to 3
        m.drawFrame(renderer)
      end for
      cachedCalls = renderer.getDrawCallsLastFrame()

      renderer.setQualitySettings(BGE.getRenderQualityPreset(BGE.RenderQualityLevel.ultra))
      m.drawFrame(renderer)
      redrawCalls = renderer.getDrawCallsLastFrame()
      m.drawFrame(renderer)

      m.assertTrue(cachedCalls > 0)
      m.assertTrue(redrawCalls > cachedCalls, `redraw ${redrawCalls} vs cached ${cachedCalls}`)
      m.assertEqual(cachedCalls, renderer.getDrawCallsLastFrame())
    end function

    private sub drawFrame(renderer as BGE.Renderer)
      renderer.resetDrawCallCounter()
      renderer.setupCameraForFrame()
      m.testScene.updateTransformationMatrix()
      renderer.render()
    end sub

    ' Review finding: a draw-distance change no longer bumps projectionVersion, so with a
    ' parked camera nothing made the plane recompute its horizon.
    @it("recomputes its perspective quad when maxDrawDistance changes with the camera parked")
    function _()
      colorDrawable = new BGE.DrawablePlane(m.testScene, invalid, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.color, color: BGE.ColorsRGB.Green})
      m.testScene.addDrawable("Ground", colorDrawable)
      renderer = m.game.canvas.renderer
      camera = renderer.camera as BGE.Camera3d
      ' pitched down at the ground, so the plane has a perspective quad
      camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 38, -100))
      camera.maxDrawDistance = 300
      ' enough frames for the scene entity's own motion check to settle, as in a real game
      for i = 1 to 4
        m.testScene.updateTransformationMatrix()
        renderer.setupCameraForFrame()
        renderer.render()
      end for
      plane = colorDrawable.getSceneObjects()[0] as object
      m.assertNotInvalid(plane.perspectivePoints, "expected the plane to have a perspective quad")
      ' a color fill has no texture mapping; actual.topLeft is the far edge's world point
      firstFarZ = plane.perspectivePoints.actual.topLeft.z

      camera.maxDrawDistance = 600
      m.testScene.updateTransformationMatrix()
      renderer.setupCameraForFrame()
      renderer.render()

      m.assertTrue(plane.perspectivePoints.actual.topLeft.z < firstFarZ - 1, "the far edge didn't move out with the draw distance")
    end function

    @it("rebuilds prePerspectiveBmp after maxDrawDistance changes")
    function _()
      staticPlane = new BGE.SceneObjectPlane("staticPlane", m.drawable)

      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 1, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 1, -100))
      camera.maxDrawDistance = 50
      camera.checkMovement()
      staticPlane.update(camera)
      staticPlane.draw(m.game.canvas.renderer)

      dynamicPlane = staticPlane as object
      firstHeight = dynamicPlane.prePerspectiveBmp.GetHeight()

      camera.maxDrawDistance = 200
      camera.checkMovement()
      staticPlane.update(camera)
      staticPlane.draw(m.game.canvas.renderer)

      m.assertTrue(dynamicPlane.prePerspectiveBmp.GetHeight() > firstHeight)
    end function

    @it("rebuilds the tiledImage supertexture after the drawable's region is swapped for a differently-sized one")
    function _()
      smallBmp = CreateObject("roBitmap", {width: 8, height: 8, AlphaEnable: true})
      smallRegion = CreateObject("roRegion", smallBmp, 0, 0, 8, 8)
      tiledDrawable = new BGE.DrawablePlane(m.testScene, smallRegion, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
      tiledPlane = new BGE.SceneObjectPlane("tiledPlane", tiledDrawable)

      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 1, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 1, -100))
      camera.maxDrawDistance = 20
      camera.checkMovement()
      tiledPlane.update(camera)
      tiledPlane.draw(m.game.canvas.renderer)

      dynamicPlane = tiledPlane as object
      firstTileWidth = dynamicPlane.tileWidth

      largeBmp = CreateObject("roBitmap", {width: 16, height: 16, AlphaEnable: true})
      tiledDrawable.region = CreateObject("roRegion", largeBmp, 0, 0, 16, 16)
      tiledPlane.update(camera)
      tiledPlane.draw(m.game.canvas.renderer)

      m.assertTrue(dynamicPlane.tileWidth > firstTileWidth)
    end function

    @it("does not divide by zero when the drawable's region is degenerate (zero-sized)")
    function _()
      degenerateBmp = CreateObject("roBitmap", {width: 1, height: 1, AlphaEnable: true})
      degenerateRegion = CreateObject("roRegion", degenerateBmp, 0, 0, 0, 0)
      tiledDrawable = new BGE.DrawablePlane(m.testScene, degenerateRegion, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.tiledImage})
      tiledPlane = new BGE.SceneObjectPlane("tiledPlane", tiledDrawable)

      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 1, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 1, -100))
      camera.maxDrawDistance = 20
      camera.checkMovement()

      tiledPlane.update(camera)
      ' Would throw/hang on a divide-by-zero before smallestTileDimension was floored at 1 -
      ' reaching this assertion at all is the real check.
      tiledPlane.draw(m.game.canvas.renderer)
      m.assertTrue(true)
    end function

    @describe("far edge matches the object far-clip (issue #307)")

    ' Adds a color-fill ground plane, points the camera, renders a few settled frames
    ' and returns the plane's scene object.
    private function renderGround(cameraTarget as BGE.Math.Vector) as object
      colorDrawable = new BGE.DrawablePlane(m.testScene, invalid, {normal: {x: 0, y: 1, z: 0}, point: {x: 0, y: 0, z: 0}}, {fillMode: BGE.PlaneFillMode.color, color: BGE.ColorsRGB.Green})
      m.testScene.addDrawable("Ground", colorDrawable)
      renderer = m.game.canvas.renderer
      camera = renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      camera.setTarget(cameraTarget)
      for i = 1 to 4
        m.testScene.updateTransformationMatrix()
        renderer.setupCameraForFrame()
        renderer.render()
      end for
      return colorDrawable.getSceneObjects()[0] as object
    end function

    @it("reaches the forward depth objects are clipped at, so an object near the limit stands on the ground")
    function _()
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.maxDrawDistance = 500
      plane = m.renderGround(BGE.Math.VectorOps.create(0, 50, -100))
      objectBase = BGE.Math.VectorOps.create(0, 0, -450)
      m.assertTrue(camera.isInView(objectBase))
      edgeY = camera.worldPointToCanvasPoint(plane.perspectivePoints.actual.topLeft).y
      baseY = camera.worldPointToCanvasPoint(objectBase).y
      m.assertTrue(edgeY <= baseY, `ground edge at y=${edgeY} is below the object's base at y=${baseY}`)
    end function

    @it("stops at the far-clip depth when the camera is pitched down far enough for the top rays to hit the ground")
    function _()
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.maxDrawDistance = 500
      ' 47 degrees down: the top rays hit the ground ~1400 units out
      plane = m.renderGround(BGE.Math.VectorOps.create(0, 50 - 107.2, -100))
      farCorner = plane.perspectivePoints.actual.topLeft
      depth = BGE.Math.VectorOps.dotProduct(BGE.Math.VectorOps.subtract(farCorner, camera.position), camera.orientation)
      m.assertTrue(depth <= camera.getPlaneDrawDistance() + 1, `far edge at depth ${depth}`)
    end function

    @it("reaches far enough at Ultra that an object near the Ultra limit stands on the ground")
    function _()
      camera = m.game.canvas.renderer.camera as BGE.Camera3d
      camera.maxDrawDistance = 500
      m.game.setQualityLevel(BGE.RenderQualityLevel.ultra)
      plane = m.renderGround(BGE.Math.VectorOps.create(0, 50, -100))
      objectBase = BGE.Math.VectorOps.create(0, 0, -700)
      m.assertTrue(camera.isInView(objectBase))
      edgeY = camera.worldPointToCanvasPoint(plane.perspectivePoints.actual.topLeft).y
      baseY = camera.worldPointToCanvasPoint(objectBase).y
      m.assertTrue(edgeY <= baseY, `ground edge at y=${edgeY} is below the object's base at y=${baseY}`)
    end function

  end class

end namespace
