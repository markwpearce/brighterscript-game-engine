import "../../../math/CornerPoints.bs"
import "../../../math/math.bs"
import "../../../math/Matrix44.bs"
import "../../../math/plane.bs"
import "../../../math/Triangle.bs"
import "../../../math/vector.bs"
import "../../../utils/deviceRenderTier.bs"
import "../../drawables/DrawablePlane.bs"
import "../../interfaces.bs"
import "../cameras/Camera.bs"
import "../cameras/Camera3d.bs"
import "../Renderer.bs"
import "../RendererHelpers.bs"
import "SceneObject.bs"
import "PlaneBitmapSizing.bs"

namespace BGE

  interface PerspectiveCalculationResult
    actual as BGE.Math.CornerPoints
    mapped as BGE.Math.CornerPoints
  end interface

  ' One horizontal band of the ground: a whole-pixel source rect of the top-down
  ' bitmap, and where/how much to scale it on the composite.
  interface PerspectiveSlice
    srcX as integer
    srcY as integer
    srcWidth as integer
    srcHeight as integer
    destX as float
    destY as float
    scaleX as float
    scaleY as float
    ' the exact (fractional) source span that should fill the frame width
    exactSrcLeft as float
    exactSrcWidth as float
    ' camera-forward depths of the band's near and far edges
    nearDepth as float
    farDepth as float
  end interface

  ' Above this, the supertexture build's tilesPerAxis^2 blit count is worth a runtime
  ' warning (63x63 = ~4k blits) - see buildSuperTextureIfNeeded().
  const SCENE_OBJECT_PLANE_TILES_PER_AXIS_WARNING_THRESHOLD = 63

  class SceneObjectPlane extends SceneObject

    ' The plane draw distance this plane last drew at (-1 = never drawn).
    private planeDrawDistanceAtLastDraw as float = -1

    drawable as DrawablePlane
    private perspectivePoints as PerspectiveCalculationResult
    private prePerspectiveBmp as roBitmap
    private prePerspectiveBmpBuiltForMaxDrawDistance as float = -1
    private tempBitmap as ifDraw2d = invalid
    private rotatedTempBitmap as ifDraw2d = invalid
    private hasAccurateTempBitmap = false

    private superTextureBmp as roBitmap
    private superTextureRegion as roRegion
    ' Rotate step's scratch destination - must differ from superTextureBmp since that's the rotate source.
    private tiledScratchBmp as roBitmap
    ' A static decal's rotated texture, sized to the decal (see populatePerspectiveBmp)
    private decalScratchBmp as roBitmap = invalid
    private superTextureBuiltForMaxDrawDistance as float = -1
    private tileWidth as float
    private tileHeight as float
    private tilesPerAxis as integer
    ' The tile region's dimensions when the supertexture was last built - rebuilds if the
    ' drawable's region is reassigned to a differently-sized one, not just on a
    ' maxDrawDistance change. Dimensions, not the region reference itself: comparing two
    ' roRegion values with `=` crashes at runtime with a Type Mismatch (confirmed - the
    ' same class of crash CLAUDE.md documents for custom-class instances turns out to
    ' apply to this native component too), and an `as dynamic` cast doesn't avoid it
    ' either. A same-sized region swap isn't caught by this - see issue #140.
    private superTextureBuiltForTileWidth as float = -1
    private superTextureBuiltForTileHeight as float = -1
    ' Physical/logical pixel ratio: 1.0 until logical size exceeds getMaxSuperTextureDimension()'s
    ' budget, then tiles downscale and every pixel-space consumer must apply this factor.
    private superTextureScale as float = 1.0

    ' Sized to at least the camera frame's diagonal, so a composite rendered into a
    ' canvasSize x canvasSize square can be rotated by any angle without exposing an
    ' empty corner once it's cropped back down to the real frame - see performDraw().
    ' The +2 is slack for the sqrt/int rounding, not a precision requirement.
    '
    ' @param {BGE.Math.Vector} frameSize
    ' @return {float}
    function getRollCanvasSize(frameSize as BGE.Math.Vector) as float
      return Int(Sqr(frameSize.x * frameSize.x + frameSize.y * frameSize.y)) + 2
    end function

    sub new(name as string, drawableObj as DrawablePlane)
      super(name, drawableObj, BGE.SceneObjectType.Plane)
      ' Redeclaring `drawable` above auto-inits it to invalid after super() - this wins since it runs last (issue #69).
      m.drawable = drawableObj
    end sub

    ' getPositionsForFrustumCheck() is unoverridden here, so it inherits the base
    ' class's single-point default - that can never reach BGE.DepthSort.
    ' MIN_VALID_HULL_POINTS (3), so this object's hull can never pass the narrow phase
    ' anyway (see the base class's doc comment for why that means this is a pure cost
    ' avoidance, not a tolerated visual error - matching SceneObjectLine's own
    ' participatesInOverlapDetection() override for the same reason). Making the
    ' exclusion explicit here rather than relying on it being an accidental side effect
    ' of not overriding getPositionsForFrustumCheck() also buys the same broad-phase
    ' cost-avoidance benefit the line exclusion does.
    override function participatesInOverlapDetection() as boolean
      return false
    end function


    ' A draw-distance change moves the horizon, so it counts as movement for both the
    ' perspective quad and the cached composite.
    protected override function objMovedInRelationToCamera(cameraObj as Camera) as boolean
      return super.objMovedInRelationToCamera(cameraObj) or m.planeDrawDistanceChanged(cameraObj)
    end function

    private function planeDrawDistanceChanged(cameraObj as Camera) as boolean
      if cameraObj.name <> "Camera3d"
        return false
      end if
      return (cameraObj as Camera3d).getPlaneDrawDistance() <> m.planeDrawDistanceAtLastDraw
    end function

    protected override function isPotentiallyOnScreen(cameraObj as Camera) as boolean
      ' potentially, the camera could be facing away from the plane, but we'll ignore that for now
      ' TODO: Implement a more robust check for whether the plane is on screen
      return true
    end function

    ' Perform any drawing logic for the object
    ' Override this function in subclasses to provide specific behavior
    '
    ' @param {Renderer} rendererObj
    ' @param {SceneObjectDrawMode} drawMode
    ' @return {boolean} True if the draw call was successful
    protected override function performDraw(rendererObj as BGE.Renderer, drawMode as SceneObjectDrawMode) as boolean
      if invalid = m.perspectivePoints
        return false
      end if
      ' read before recording, since recording clears it from objMovedInRelationToCamera()
      planeDistanceChanged = m.planeDrawDistanceChanged(rendererObj.camera)
      if rendererObj.camera.name = "Camera3d"
        m.planeDrawDistanceAtLastDraw = (rendererObj.camera as Camera3d).getPlaneDrawDistance()
      end if

      if m.drawable.fillMode = PlaneFillMode.color
        return m.performColorDraw(rendererObj)
      end if

      camera = rendererObj.camera
      isRolled = false
      if camera.name = "Camera3d"
        isRolled = (camera as Camera3d).rollDegrees <> 0
      end if
      isTiled = m.drawable.fillMode = PlaneFillMode.tiledImage
      if not m.objMovedInRelationToCamera(camera) and not planeDistanceChanged and m.hasAccurateTempBitmap and not m.qualityChangedThisDraw
        ' If nothing has moved (including no roll change - Camera3d.checkMovement's
        ' own roll dirty-check forces movedLastFrame true only on the frame roll
        ' actually changes), redraw whichever cached bitmap is correct for the
        ' current mode instead of recomputing: the already-rotated/cropped one
        ' while rolled, or the plain composite otherwise. A camera parked at a
        ' fixed bank angle hits this path exactly as cheaply as a level one - only
        ' an actual roll/position/orientation change forces a recompute.
        if isRolled and m.rotatedTempBitmap <> invalid
          return rendererObj.drawObject(0, 0, m.rotatedTempBitmap)
        else if not isRolled and m.tempBitmap <> invalid
          return rendererObj.drawObject(0, 0, m.tempBitmap)
        end if
      end if
      m.hasAccurateTempBitmap = false

      maxDrawDistance = (camera as Camera3d).getPlaneDrawDistance()
      if invalid = m.prePerspectiveBmp or m.prePerspectiveBmpBuiltForMaxDrawDistance <> maxDrawDistance
        ' Release the old bitmap first so the old and new aren't both alive at once.
        m.prePerspectiveBmp = invalid
        m.prePerspectiveBmpBuiltForMaxDrawDistance = -1
        m.prePerspectiveBmp = m.getPrePerspectiveBmp(rendererObj)
        if invalid = m.prePerspectiveBmp
          print "[BGE.SceneObjectPlane] warning: couldn't allocate the plane's perspective bitmap for draw distance "; maxDrawDistance; " - skipping this frame"
          return false
        end if
        m.prePerspectiveBmpBuiltForMaxDrawDistance = maxDrawDistance
      end if

      gotPreBmp = false
      if isTiled
        if not m.buildSuperTextureIfNeeded(rendererObj)
          return false
        end if
        wrappedAnchor = m.wrapAnchorIntoSuperTexture(m.perspectivePoints.mapped.topLeft)
        gotPreBmp = m.populatePerspectiveBmp(rendererObj, m.perspectivePoints.mapped, m.superTextureRegion, m.prePerspectiveBmp, wrappedAnchor, m.tiledScratchBmp, 1 / m.superTextureScale)
      else
        gotPreBmp = m.populatePerspectiveBmp(rendererObj, m.perspectivePoints.mapped, m.drawable.region, m.prePerspectiveBmp, m.perspectivePoints.mapped.topLeft)
      end if
      if not gotPreBmp
        return false
      end if
      m.hasAccurateTempBitmap = m.drawPerspectiveBmpSlicesToByCamera(rendererObj, m.prePerspectiveBmp, m.perspectivePoints, rendererObj.qualitySettings.planeSliceCount)

      return m.hasAccurateTempBitmap
    end function

    ' Flat color fill - no texture warp, no slice rasterization, no bitmap caching.
    ' No texture bounds, so it draws correctly no matter how far the camera has moved.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @return {boolean} True if the draw call was successful
    private function performColorDraw(rendererObj as BGE.Renderer) as boolean
      camera = rendererObj.camera
      corners = [m.perspectivePoints.actual.topLeft, m.perspectivePoints.actual.topRight, m.perspectivePoints.actual.bottomRight, m.perspectivePoints.actual.bottomLeft]
      canvasPoints = []
      for each corner in corners
        canvasPoint = camera.worldPointToCanvasPoint(corner)
        if invalid <> canvasPoint
          canvasPoints.push(canvasPoint)
        end if
      end for

      if canvasPoints.count() < 3
        ' Not enough corners in front of the camera to fill anything this frame;
        ' not a deterministic failure since a corner can come back in front next frame.
        return false
      end if

      ' 3 of 4 corners valid (one behind the camera) fills a triangle instead of the
      ' full quad - the correct approximation of a plane straddling the near plane.
      return rendererObj.drawPolygon(canvasPoints, 0, 0, m.drawable.getFillColorRGBA())
    end function

    protected override function findCanvasPosition(rendererObj as Renderer, drawMode as SceneObjectDrawMode) as boolean
      camera = rendererObj.camera as Camera3d
      m.perspectivePoints = m.getPerspectivePointsByCamera(rendererObj, m.drawable.plane, m.worldPosition, camera.getPlaneDrawDistance())
      if invalid = m.perspectivePoints
        return false
      end if
      if m.drawable.fillMode <> PlaneFillMode.staticImage
        ' Color and tiled fills never "run out" like a finite decal does.
        return true
      end if
      ' The texture is a finite decal, not an infinitely tiling one - skip
      ' the (relatively expensive) perspective warp entirely once the view
      ' has moved so far that there's no possible overlap with the texture
      ' at all. Partial overlaps are handled correctly by performDraw
      ' clearing its scratch/dest bitmaps before drawing into them, so a
      ' partially-out-of-bounds view correctly shows real texture where
      ' valid and background where not, rather than needing an all-or-
      ' nothing gate here.
      return BGE.Math.boundsOverlapRect(m.perspectivePoints.mapped.toArray(), m.drawable.region.GetWidth(), m.drawable.region.GetHeight())
    end function





    private function getPerspectivePointsByCamera(rendererObj as Renderer, plane as BGE.Math.Plane, mapOffset as BGE.Math.Vector, farDistance as float) as PerspectiveCalculationResult
      rendererCamera = rendererObj.camera
      if rendererCamera.name <> "Camera3d"
        return invalid
      end if
      camera = rendererCamera as Camera3d

      'camera.onCameraMovement()

      isRolled = camera.rollDegrees <> 0

      if not isRolled
        ' camera.frustumRays uses Camera3d.getVerticalFOV()'s linear aspect-
        ' ratio approximation for its vertical angle, not a true atan-derived
        ' FOV - close enough for frustum culling, but not accurate enough for
        ' this plane's own near/far corner rays now that they feed true
        ' perspective math (computePerspectiveSlices, in
        ' drawPerspectiveBmpSlicesToByCamera): the mismatch left a visible
        ' gap at the bottom of the frame where the nearest ground didn't
        ' quite reach the bottom edge, confirmed on real hardware. Build
        ' fresh rays here using the true vertical FOV instead -
        ' camera.frustumRays itself (used by every other scene object's
        ' frustum culling) is untouched by this.
        horizFov = camera.fieldOfViewDegrees
        trueVertFov = camera.getFovDegreesForCanvasSize(camera.frameSize.y)
        rays = new CameraFrustumRays()
        rays.setRays(camera.position, camera.orientation, horizFov, trueVertFov, camera.getUpVector(), camera.getRightVector())
      else
        ' Roll can't be represented by this trapezoid-slice rasterizer directly (see
        ' the design doc) - instead, compute every bit of geometry against an
        ' unrolled ("level") view enlarged to cover the frame's diagonal, and apply
        ' the actual roll as a final image rotation in performDraw()/
        ' drawPerspectiveBmpSlicesToByCamera(). A pure roll's projection is exactly
        ' the level projection rotated about the image center, so this is exact, not
        ' an approximation - modulo the finite canvas needing to be big enough to
        ' cover every angle, which getRollCanvasSize() guarantees.
        canvasWidth = m.getRollCanvasSize(camera.frameSize)
        horizFov = camera.getFovDegreesForCanvasSize(canvasWidth)

        rays = new CameraFrustumRays()
        rays.setRays(camera.position, camera.orientation, horizFov, horizFov, camera.getLevelUpVector(), camera.getLevelRightVector())
      end if

      output = new BGE.Math.CornerPoints()

      output.topRight = BGE.Math.intersectRayWithPlane(plane, rays.topRight)
      output.topLeft = BGE.Math.intersectRayWithPlane(plane, rays.topLeft)
      output.bottomRight = BGE.Math.intersectRayWithPlane(plane, rays.bottomRight)
      output.bottomLeft = BGE.Math.intersectRayWithPlane(plane, rays.bottomLeft)

      cameraPointOnPlane = BGE.Math.closestPointOnPlane(plane, camera.position)

      if output.topRight = invalid and output.topLeft = invalid and output.bottomRight = invalid and output.bottomLeft = invalid
        ' camera can not see the plane at all
        return invalid
      end if


      projectedRay = BGE.Math.projectRayOntoPlane(plane, {origin: camera.position, direction: camera.orientation})
      if projectedRay = invalid
        print "failed to project camera ray onto plane"
        return invalid
      end if

      scaledOrientationFromCameraPointOnPlane = BGE.Math.VectorOps.add(cameraPointOnPlane, BGE.Math.VectorOps.scale(BGE.Math.VectorOps.getNormalizedCopy(projectedRay.direction), farDistance))

      projectedForward = BGE.Math.VectorOps.getNormalizedCopy(projectedRay.direction)
      if invalid = output.topRight or m.isPastForwardDepth(camera, output.topRight, farDistance)
        output.topRight = m.getFarEdgeCorner(camera, plane, cameraPointOnPlane, projectedForward, farDistance, horizFov, 1)
      end if
      if invalid = output.topLeft or m.isPastForwardDepth(camera, output.topLeft, farDistance)
        output.topLeft = m.getFarEdgeCorner(camera, plane, cameraPointOnPlane, projectedForward, farDistance, horizFov, -1)
      end if
      if invalid = output.bottomRight
        output.bottomRight = BGE.Math.RotateVectorAroundPoint3d(
        scaledOrientationFromCameraPointOnPlane,
        cameraPointOnPlane,
        plane.normal,
        BGE.Math.DegreesToRadians(horizFov / 2)
        )
      end if
      if invalid = output.bottomLeft
        output.bottomLeft = BGE.Math.RotateVectorAroundPoint3d(
        scaledOrientationFromCameraPointOnPlane,
        cameraPointOnPlane,
        plane.normal,
        - BGE.Math.DegreesToRadians(horizFov / 2)
        )
      end if

      ' A color fill has no texture at all - only the world-space quad (`output`)
      ' matters, so skip the texture-pixel mapping entirely.
      if m.drawable.fillMode = PlaneFillMode.color
        return {actual: output, mapped: invalid}
      end if

      ' Anchor the texture's center on the plane's own world position (mapOffset)
      ' rather than on world-space (0,0) - otherwise world points get used
      ' directly as source-bitmap pixel coordinates, pinning the visible
      ' texture to a fixed absolute-world-space footprint regardless of
      ' where the plane (or camera) actually is.
      textureWidth = m.drawable.region.GetWidth()
      textureHeight = m.drawable.region.GetHeight()

      mapped = new BGE.Math.CornerPoints()

      mapped.topRight = BGE.Math.worldPointToTexturePixel(output.topRight, mapOffset, textureWidth, textureHeight)
      mapped.topLeft = BGE.Math.worldPointToTexturePixel(output.topLeft, mapOffset, textureWidth, textureHeight)
      mapped.bottomRight = BGE.Math.worldPointToTexturePixel(output.bottomRight, mapOffset, textureWidth, textureHeight)
      mapped.bottomLeft = BGE.Math.worldPointToTexturePixel(output.bottomLeft, mapOffset, textureWidth, textureHeight)

      return {actual: output, mapped: mapped}
    end function

    private function isPastForwardDepth(camera as Camera3d, point as BGE.Math.Vector, farDistance as float) as boolean
      return BGE.Math.VectorOps.dotProduct(BGE.Math.VectorOps.subtract(point, camera.position), camera.orientation) > farDistance
    end function

    ' A far corner on the plane at forward depth `farDistance` - the same flat depth
    ' Camera3d.isInView() clips objects at - on the left (side -1) or right (+1)
    ' edge of the view. Not a fixed radius around the camera, which would stop the
    ' ground short of the object far-clip straight ahead (issue #307).
    private function getFarEdgeCorner(camera as Camera3d, plane as BGE.Math.Plane, cameraPointOnPlane as BGE.Math.Vector, projectedForward as BGE.Math.Vector, farDistance as float, horizFov as float, side as float) as BGE.Math.Vector
      cameraOffsetDepth = BGE.Math.VectorOps.dotProduct(BGE.Math.VectorOps.subtract(cameraPointOnPlane, camera.position), camera.orientation)
      forwardRate = BGE.Math.VectorOps.dotProduct(projectedForward, camera.orientation)
      if forwardRate <= 0.0001
        forwardRate = 0.0001
      end if
      along = (farDistance - cameraOffsetDepth) / forwardRate
      farCenter = BGE.Math.VectorOps.add(cameraPointOnPlane, BGE.Math.VectorOps.scale(projectedForward, along))
      right = BGE.Math.VectorOps.getNormalizedCopy(BGE.Math.VectorOps.crossProduct(projectedForward, plane.normal))
      halfWidth = farDistance * tan(BGE.Math.DegreesToRadians(horizFov) / 2)
      return BGE.Math.VectorOps.add(farCenter, BGE.Math.VectorOps.scale(right, halfWidth * side))
    end function

    ' Sizes the "rectified" (top-down) scratch bitmap that populatePerspectiveBmp()
    ' warps the ground texture into. Only its aspect ratio and pixel budget matter:
    ' computePerspectiveSlices() reads slice spans from the quad's own corners in this
    ' bitmap's pixels, whatever its size.
    private function getPrePerspectiveBmp(rendererObj as BGE.Renderer) as roBitmap
      camera = rendererObj.camera as Camera3d
      size = BGE.getPlanePrePerspectiveBmpSize(camera.getPlaneDrawDistance(), camera.fieldOfViewDegrees, BGE.getPlanePrePerspectiveMaxPixels())
      return CreateObject("roBitmap", {width: size.width, height: size.height, AlphaEnable: true})
    end function

    ' Caps the supertexture's physical bitmap size regardless of how much world-space
    ' coverage it logically represents - a large maxDrawDistance with a small tile can
    ' otherwise require an allocation that fails on real hardware. Trades sharpness at
    ' long distances for a fixed allocation budget (device-tiered, like ScratchBitmap.bs).
    '
    ' @return {float}
    private function getMaxSuperTextureDimension() as float
      if BGE.getDeviceRenderTier() = BGE.DeviceRenderTier.fhd
        return 1600
      end if
      return 1024
    end function

    ' Builds (or rebuilds, if maxDrawDistance changed) a bitmap that repeats the
    ' plane's tile enough times per axis to seamlessly cover the world-space footprint,
    ' so a wrapped anchor (see wrapAnchorIntoSuperTexture()) always has enough margin
    ' for the required rotated footprint. Lazy and cached per maxDrawDistance value;
    ' its own persistent bitmap rather than a pooled scratch region since it's reused
    ' across many frames, not just within one.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @return {boolean} false if a bitmap couldn't be allocated (retried next call)
    private function buildSuperTextureIfNeeded(rendererObj as BGE.Renderer) as boolean
      camera = rendererObj.camera as Camera3d
      if invalid <> m.superTextureBmp and m.superTextureBuiltForMaxDrawDistance = camera.getPlaneDrawDistance() and m.superTextureBuiltForTileWidth = m.drawable.region.GetWidth() and m.superTextureBuiltForTileHeight = m.drawable.region.GetHeight()
        return true
      end if
      ' Release the old bitmaps before allocating replacements, and leave the cache
      ' key unset until the build succeeds so a failed allocation is retried.
      m.superTextureRegion = invalid
      m.superTextureBmp = invalid
      m.tiledScratchBmp = invalid
      m.superTextureBuiltForMaxDrawDistance = -1

      ' Floored at 1 - a degenerate 0-sized tile region would otherwise divide by zero
      ' below (and downstream, a 0-sized bmpWidth/bmpHeight feeding CreateObject("roBitmap", ...)).
      m.tileWidth = BGE.Math.Max(1, m.drawable.region.GetWidth())
      m.tileHeight = BGE.Math.Max(1, m.drawable.region.GetHeight())
      smallestTileDimension = BGE.Math.Min(m.tileWidth, m.tileHeight)

      ' m.tiledScratchBmp (the rotate destination) must stay at this unpadded,
      ' maxDrawDistance-bounded size - drawScaledObjectTo reads it whole into the
      ' final composite with no sub-crop, so it can't grow with the rotation padding
      ' computed below. Computed from real tile-quantized dimensions, not an estimate.
      unpaddedTilesPerAxis = Fix(2 * camera.getPlaneDrawDistance() / smallestTileDimension) + 1
      if (unpaddedTilesPerAxis mod 2) = 0
        unpaddedTilesPerAxis = unpaddedTilesPerAxis + 1
      end if
      unpaddedScratchWidth = unpaddedTilesPerAxis * m.tileWidth
      unpaddedScratchHeight = unpaddedTilesPerAxis * m.tileHeight

      ' The rotate call places the wrapped anchor at the destination canvas's ORIGIN,
      ' not its center, so the region needing coverage after rotation is a full D x D
      ' quadrant extending from the anchor - a FULL diagonal away, not the half-diagonal
      ' getRollCanvasSize() uses for its center-anchored case. Since
      ' wrapAnchorIntoSuperTexture() re-centers the anchor in this supertexture, its
      ' half-side must be at least that full diagonal to cover every rotation angle,
      ' or corners bleed through with visible rotation/pitch-dependent artifacts.
      requiredDiagonal = Sqr(unpaddedScratchWidth * unpaddedScratchWidth + unpaddedScratchHeight * unpaddedScratchHeight)
      rotationPaddedWorldDiameter = 2 * requiredDiagonal

      m.tilesPerAxis = Fix(rotationPaddedWorldDiameter / smallestTileDimension) + 1
      if (m.tilesPerAxis mod 2) = 0
        ' Keep it odd, so a tile sits exactly centered in the supertexture - the
        ' center tile is where wrapAnchorIntoSuperTexture() re-centers every anchor.
        m.tilesPerAxis = m.tilesPerAxis + 1
      end if

      ' Not silently truncated - m.tilesPerAxis feeds directly into the corner-bleed
      ' coverage math above, so reducing it here would reintroduce that bug. This is
      ' just visibility: the blit loop below costs tilesPerAxis^2 calls, so a small
      ' tile paired with a large maxDrawDistance can genuinely hitch on real hardware
      ' (see issue #136 for a real fix - a bounded doubling-blit strategy that needs
      ' on-device verification before shipping).
      if m.tilesPerAxis > SCENE_OBJECT_PLANE_TILES_PER_AXIS_WARNING_THRESHOLD
        print "[BGE.SceneObjectPlane] warning: tiledImage supertexture needs "; m.tilesPerAxis; "x"; m.tilesPerAxis; " tile blits ("; m.tilesPerAxis * m.tilesPerAxis; " total) - consider a larger tile or a smaller camera.maxDrawDistance"
      end if

      ' bmpWidth/bmpHeight are the supertexture's LOGICAL size (world coverage / wrap
      ' period); the PHYSICAL bitmap is capped to a device-tiered budget below and only
      ' ever downscaled from this, never upscaled - every pixel-space consumer must
      ' apply m.superTextureScale to convert between the two.
      bmpWidth = m.tilesPerAxis * m.tileWidth
      bmpHeight = m.tilesPerAxis * m.tileHeight
      maxDimension = m.getMaxSuperTextureDimension()
      m.superTextureScale = BGE.Math.Min(1.0, maxDimension / BGE.Math.Max(bmpWidth, bmpHeight))

      physicalWidth = bmpWidth * m.superTextureScale
      physicalHeight = bmpHeight * m.superTextureScale
      m.superTextureBmp = CreateObject("roBitmap", {width: physicalWidth, height: physicalHeight, AlphaEnable: true})
      if invalid = m.superTextureBmp
        print "[BGE.SceneObjectPlane] warning: couldn't allocate a "; physicalWidth; "x"; physicalHeight; " tiledImage supertexture - skipping this plane this frame"
        return false
      end if
      m.superTextureBmp.SetAlphaEnable(true)
      m.superTextureBmp.Clear(&h00000000)

      for row = 0 to m.tilesPerAxis - 1
        for col = 0 to m.tilesPerAxis - 1
          rendererObj.drawScaledObjectTo(m.superTextureBmp, col * m.tileWidth * m.superTextureScale, row * m.tileHeight * m.superTextureScale, m.superTextureScale, m.superTextureScale, m.drawable.region)
        end for
      end for

      m.superTextureRegion = CreateObject("roRegion", m.superTextureBmp, 0, 0, physicalWidth, physicalHeight)
      ' Unpadded size (see unpaddedScratchWidth/Height above) - the destination canvas
      ' must not grow with the source's rotation padding.
      m.tiledScratchBmp = CreateObject("roBitmap", {width: unpaddedScratchWidth * m.superTextureScale, height: unpaddedScratchHeight * m.superTextureScale, AlphaEnable: true})
      if invalid = m.tiledScratchBmp
        print "[BGE.SceneObjectPlane] warning: couldn't allocate the tiledImage scratch bitmap - skipping this plane this frame"
        return false
      end if
      m.tiledScratchBmp.SetAlphaEnable(true)
      m.superTextureBuiltForMaxDrawDistance = camera.getPlaneDrawDistance()
      m.superTextureBuiltForTileWidth = m.tileWidth
      m.superTextureBuiltForTileHeight = m.tileHeight
      return true
    end function

    ' Wraps an unbounded world-derived texture-pixel anchor into this supertexture's
    ' center tile. Only the anchor needs wrapping (not every corner) since the warp's
    ' rotation/scale are translation-invariant. Wrap period is in logical (world/tile)
    ' units; the result is converted to physical pixel space (m.superTextureScale)
    ' only at the end, for the rotate step which reads real bitmap pixels.
    '
    ' @param {BGE.Math.Vector} point
    ' @return {BGE.Math.Vector}
    private function wrapAnchorIntoSuperTexture(point as BGE.Math.Vector) as BGE.Math.Vector
      centerTileIndex = Int(m.tilesPerAxis / 2)
      wrappedX = BGE.Math.wrapValue(point.x, m.tileWidth)
      wrappedY = BGE.Math.wrapValue(point.y, m.tileHeight)
      logicalX = centerTileIndex * m.tileWidth + wrappedX
      logicalY = centerTileIndex * m.tileHeight + wrappedY
      return BGE.Math.VectorOps.create(logicalX * m.superTextureScale, logicalY * m.superTextureScale, 0)
    end function

    ' Where `srcRegion` lands, rotated by `theta` about `pivot` with the pivot at the
    ' origin - the placement drawRotatedImageWithCenterTo() uses with a -pivot translation.
    '
    ' @return {BGE.PlaneScratchBounds}
    private function getRotatedSourceBounds(srcRegion as ifDraw2D, pivot as BGE.Math.Vector, theta as float) as BGE.PlaneScratchBounds
      rotatedPivot = m.rotateLikeDrawRotated(pivot, theta)
      corners = [BGE.Math.VectorOps.create(0, 0), BGE.Math.VectorOps.create(srcRegion.GetWidth(), 0), BGE.Math.VectorOps.create(0, srcRegion.GetHeight()), BGE.Math.VectorOps.create(srcRegion.GetWidth(), srcRegion.GetHeight())]
      minX = invalid
      minY = invalid
      maxX = invalid
      maxY = invalid
      for each corner in corners
        landed = BGE.Math.VectorOps.subtract(m.rotateLikeDrawRotated(corner, theta), rotatedPivot)
        if invalid = minX or landed.x < minX
          minX = landed.x
        end if
        if invalid = minY or landed.y < minY
          minY = landed.y
        end if
        if invalid = maxX or landed.x > maxX
          maxX = landed.x
        end if
        if invalid = maxY or landed.y > maxY
          maxY = landed.y
        end if
      end for
      minX = Int(minX)
      minY = Int(minY)
      return {min: BGE.Math.VectorOps.create(minX, minY), width: Int(maxX - minX) + 2, height: Int(maxY - minY) + 2}
    end function

    ' The rotation drawRotatedImageWithCenterTo() applies to a source point.
    private function rotateLikeDrawRotated(point as BGE.Math.Vector, theta as float) as BGE.Math.Vector
      distance = BGE.Math.VectorOps.length(point)
      if distance = 0
        return BGE.Math.VectorOps.create()
      end if
      angle = theta - BGE.Math.GetAngle(BGE.Math.VectorOps.create(), point)
      return BGE.Math.VectorOps.create(distance * cos(angle), -distance * sin(angle))
    end function

    private function populatePerspectiveBmp(rendererObj as BGE.Renderer, cp as BGE.Math.CornerPoints, srcRegion as ifDraw2D, destRegion as ifDraw2D, anchorPoint as BGE.Math.Vector, ownScratchBmp = invalid as roBitmap, extraScale = 1.0 as float) as boolean
      if invalid = cp
        return false
      end if

      rotation = BGE.Math.atan2(cp.topRight.y - cp.topLeft.y, cp.topRight.x - cp.topLeft.x)
      footInfo = BGE.Math.TriangleOps.getPerpendicularFootFromPoint(cp.topLeft, cp.topRight, cp.bottomRight)

      distanceFromTopToBottom = BGE.Math.TotalDistance(cp.topLeft, cp.topRight)
      if distanceFromTopToBottom = 0
        return false
      end if

      ' extraScale compensates when the source's pixel space no longer maps 1:1 to
      ' world/texture-pixel units (see superTextureScale); the static path passes 1.0.
      horizScale = (destRegion.GetWidth() / distanceFromTopToBottom) * extraScale
      vertScale = (destRegion.GetHeight() / footInfo.distanceToPoint) * extraScale

      ' The rotate puts the quad's top left corner at the scratch origin.
      rotateTranslation = BGE.Math.VectorOps.negative(anchorPoint)
      scratchOffset = BGE.Math.VectorOps.create()
      scratchDrawTo = invalid as ifDraw2D
      if invalid <> ownScratchBmp
        scratchDrawTo = ownScratchBmp
      else
        ' A finite decal: size the scratch to the rotated decal itself and shift it in,
        ' since the quad's corner can be far outside the texture (issue #307).
        bounds = m.getRotatedSourceBounds(srcRegion, anchorPoint, rotation)
        m.decalScratchBmp = BGE.RendererHelpers.growOrClearBitmap(m.decalScratchBmp, bounds.width, bounds.height)
        if invalid = m.decalScratchBmp
          print "[BGE.SceneObjectPlane] warning: couldn't allocate the decal scratch bitmap - skipping this plane this frame"
          return false
        end if
        scratchDrawTo = m.decalScratchBmp
        scratchOffset = bounds.min
        rotateTranslation = BGE.Math.VectorOps.subtract(rotateTranslation, bounds.min)
      end if

      ' Scratch regions/bitmaps are reused and not auto-cleared - without this, a
      ' rotated draw landing mostly outside this canvas would show stale pixel data.
      scratchDrawTo.Clear(&h00000000)
      destRegion.Clear(&h00000000)

      worked = rendererObj.drawRotatedImageWithCenterTo(scratchDrawTo, srcRegion, anchorPoint, rotation, rotateTranslation)
      worked = worked and rendererObj.drawScaledObjectTo(destRegion, scratchOffset.x * horizScale, scratchOffset.y * vertScale, horizScale, vertScale, scratchDrawTo)
      if not worked
        print "failed to draw perspective bmp"
      end if

      return worked
    end function



    ' Splits the ground into `sliceCount` horizontal bands for
    ' drawPerspectiveBmpSlicesToByCamera(). Each band is one scaled blit, so it has one
    ' horizontal scale where true perspective's changes with depth - how far that strays
    ' depends on the band's far/near depth ratio, so bands are spaced to give every one
    ' the same ratio. Each band's span is the ground the camera's projection actually
    ' shows across the frame at the band's mid depth (issue #313) - not the quad's
    ' corners, whose frustum rays are wider than the frame at the near edge.
    '
    ' @param {BGE.Renderer} rendererObj
    ' @param {integer} bmpWidth the top-down bitmap's width
    ' @param {integer} bmpHeight the top-down bitmap's height
    ' @param {PerspectiveCalculationResult} points the quad that bitmap was drawn from
    ' @param {integer} sliceCount
    ' @return {PerspectiveSlice[]} near to far; a band that can't be projected is left out
    private function computePerspectiveSlices(rendererObj as BGE.Renderer, bmpWidth as integer, bmpHeight as integer, points as PerspectiveCalculationResult, sliceCount as integer) as PerspectiveSlice[]
      slices as PerspectiveSlice[] = []
      camera = rendererObj.camera as Camera3d
      destWidth = camera.frameSize.x
      canvasHeight = camera.frameSize.y
      if camera.rollDegrees <> 0
        destWidth = m.getRollCanvasSize(camera.frameSize)
        canvasHeight = destWidth
      end if

      cp = points.actual
      plane = m.drawable.plane
      ' populatePerspectiveBmp() puts the far edge along row 0, from topLeft at x = 0 to
      ' topRight at bmpWidth, and bottomRight's distance from that edge at bmpHeight.
      topEdge = BGE.Math.VectorOps.subtract(cp.topRight, cp.topLeft)
      topLengthSq = BGE.Math.VectorOps.dotProduct(topEdge, topEdge)
      bmpDown = BGE.Math.VectorOps.getNormalizedCopy(BGE.Math.VectorOps.crossProduct(plane.normal, topEdge))
      bottomRowDistance = BGE.Math.VectorOps.dotProduct(BGE.Math.VectorOps.subtract(cp.bottomRight, cp.topLeft), bmpDown)
      if topLengthSq = 0 or bottomRowDistance = 0
        return slices
      end if

      ' The ground straight ahead (screen centre column) as a line in forward depth d:
      ' centre(d) = centreAtZero + centrePerDepth * d.
      projectedRay = BGE.Math.projectRayOntoPlane(plane, {origin: camera.position, direction: camera.orientation})
      if invalid = projectedRay
        return slices
      end if
      forward = BGE.Math.VectorOps.getNormalizedCopy(projectedRay.direction)
      forwardRate = BGE.Math.VectorOps.dotProduct(forward, camera.orientation)
      nearDepth = (m.getForwardDepth(camera, cp.bottomLeft) + m.getForwardDepth(camera, cp.bottomRight)) / 2
      farDepth = (m.getForwardDepth(camera, cp.topLeft) + m.getForwardDepth(camera, cp.topRight)) / 2
      if forwardRate <= 0.0001 or nearDepth <= 0.001 or farDepth <= nearDepth
        return slices
      end if
      cameraFoot = BGE.Math.closestPointOnPlane(plane, camera.position)
      centrePerDepth = BGE.Math.VectorOps.scale(forward, 1 / forwardRate)
      centreAtZero = BGE.Math.VectorOps.subtract(cameraFoot, BGE.Math.VectorOps.scale(centrePerDepth, m.getForwardDepth(camera, cameraFoot)))

      ' Everything below is affine in d, so it's worked out once here as coefficients and
      ' the per-band loop is plain arithmetic - this runs every frame the camera moves.
      bmpXScale = bmpWidth / topLengthSq
      rowScale = bmpHeight / bottomRowDistance
      centreXAtZero = BGE.Math.VectorOps.dotProduct(BGE.Math.VectorOps.subtract(centreAtZero, cp.topLeft), topEdge) * bmpXScale
      centreXPerDepth = BGE.Math.VectorOps.dotProduct(centrePerDepth, topEdge) * bmpXScale
      rowAtZero = BGE.Math.VectorOps.dotProduct(BGE.Math.VectorOps.subtract(centreAtZero, cp.topLeft), bmpDown) * rowScale
      rowPerDepth = BGE.Math.VectorOps.dotProduct(centrePerDepth, bmpDown) * rowScale
      ' The frame's half width at depth d is d * (destWidth / 2) / focalLength world units
      ' along the ground's lateral axis.
      focalLength = camera.getFocalLength()
      lateral = BGE.Math.VectorOps.getNormalizedCopy(BGE.Math.VectorOps.crossProduct(forward, plane.normal))
      halfSpanXPerDepth = Abs(BGE.Math.VectorOps.dotProduct(lateral, topEdge) * bmpXScale) * (destWidth / 2) / focalLength

      ' Screen rows use the same perspective formula as Camera3d.worldPointToCanvasPoint(),
      ' against the level (unrolled) camera cp was built with, so this works for the
      ' rolled case too. Camera-space position is affine in d too.
      levelLookTarget = BGE.Math.VectorOps.add(camera.position, camera.orientation)
      levelWorldToCamera = BGE.Math.Matrix44.inverse(BGE.Math.lookAt(camera.position, levelLookTarget, camera.getLevelUpVector()))
      viewAtZero = BGE.Math.Matrix44.multVecMatrix(centreAtZero, levelWorldToCamera)
      viewAtOne = BGE.Math.Matrix44.multVecMatrix(BGE.Math.VectorOps.add(centreAtZero, centrePerDepth), levelWorldToCamera)
      viewYPerDepth = viewAtOne.y - viewAtZero.y
      viewZPerDepth = viewAtOne.z - viewAtZero.z
      halfCanvasHeight = canvasHeight * 0.5

      depths = []
      canvasYs = []
      rows = []
      depthStep = (farDepth / nearDepth) ^ (1 / sliceCount)
      depth = nearDepth
      for k = 0 to sliceCount
        if k = sliceCount
          depth = farDepth
        end if
        depths.push(depth)
        viewZ = viewAtZero.z + viewZPerDepth * depth
        if viewZ >= 0
          canvasYs.push(invalid)
        else
          canvasYs.push(halfCanvasHeight - focalLength * (viewAtZero.y + viewYPerDepth * depth) / -viewZ)
        end if
        rows.push(rowAtZero + rowPerDepth * depth)
        depth = depth * depthStep
      end for

      ' Bands are drawn far to near, so each one's source runs this many canvas pixels
      ' past its near edge - only ever visible where rounding would leave a gap.
      seamPadding = 2

      for k = 0 to sliceCount - 1
        nearY = canvasYs[k]
        farY = canvasYs[k + 1]
        if invalid = nearY or invalid = farY
          continue for
        end if
        rowNear = rows[k]
        rowFar = rows[k + 1]
        if rowNear - rowFar < 0.0001 or nearY <= farY
          continue for
        end if

        ' one horizontal scale per band: the frame's width at the band's mid depth
        midDepth = (depths[k] + depths[k + 1]) / 2
        halfSpan = halfSpanXPerDepth * midDepth
        if halfSpan <= 0
          continue for
        end if
        exactLeft = centreXAtZero + centreXPerDepth * midDepth - halfSpan
        exactWidth = 2 * halfSpan
        exactRight = exactLeft + exactWidth
        scaleX = destWidth / exactWidth
        scaleY = (nearY - farY) / (rowNear - rowFar)

        ' roRegion takes whole pixels: round the rect outwards, then offset the blit by
        ' however much that moved the exact edges, so rounding never shifts the band.
        srcX = Int(exactLeft)
        if srcX < 0
          srcX = 0
        end if
        srcRight = -Int(-exactRight)
        if srcRight > bmpWidth
          srcRight = bmpWidth
        end if
        srcY = Int(rowFar)
        if srcY < 0
          srcY = 0
        end if
        srcBottom = -Int(-(rowNear + seamPadding / scaleY))
        if srcBottom > bmpHeight
          srcBottom = bmpHeight
        end if
        if srcRight - srcX < 1 or srcBottom - srcY < 1
          continue for
        end if

        slices.push({
          srcX: srcX,
          srcY: srcY,
          srcWidth: srcRight - srcX,
          srcHeight: srcBottom - srcY,
          destX: (srcX - exactLeft) * scaleX,
          destY: farY + (srcY - rowFar) * scaleY,
          scaleX: scaleX,
          scaleY: scaleY,
          exactSrcLeft: exactLeft,
          exactSrcWidth: exactWidth,
          nearDepth: depths[k],
          farDepth: depths[k + 1]
        })
      end for
      return slices
    end function

    private function getForwardDepth(camera as Camera3d, point as BGE.Math.Vector) as float
      return BGE.Math.VectorOps.dotProduct(BGE.Math.VectorOps.subtract(point, camera.position), camera.orientation)
    end function

    private function drawPerspectiveBmpSlicesToByCamera(rendererObj as BGE.Renderer, srcBmp as ifDraw2D, points as PerspectiveCalculationResult, sliceCount as integer) as boolean
      camera = rendererObj.camera as Camera3d
      isRolled = camera.rollDegrees <> 0
      compositeSize = m.getRollCanvasSize(camera.frameSize)
      destWidth = camera.frameSize.x
      canvasHeight = camera.frameSize.y
      if isRolled
        destWidth = compositeSize
        canvasHeight = compositeSize
      end if

      slices = m.computePerspectiveSlices(rendererObj, srcBmp.GetWidth(), srcBmp.GetHeight(), points, sliceCount)

      if invalid = m.tempBitmap or m.tempBitmap.GetWidth() <> destWidth or m.tempBitmap.GetHeight() <> canvasHeight
        m.tempBitmap = CreateObject("roBitmap", {width: destWidth, height: canvasHeight, AlphaEnable: true})
      end if
      if invalid = m.tempBitmap
        print "failed to create temp bitmap for perspective slices"
        return false
      end if
      m.tempBitmap.Clear(&h00000000)

      worked = true
      ' far to near, so each band's seam padding is drawn over by the next
      for i = slices.count() - 1 to 0 step -1
        slice = slices[i]
        sliceRegion = CreateObject("roRegion", srcBmp, slice.srcX, slice.srcY, slice.srcWidth, slice.srcHeight)
        thisSliceWorked = rendererObj.drawScaledObjectTo(m.tempBitmap, Int(slice.destX + 0.5), Int(slice.destY + 0.5), slice.scaleX, slice.scaleY, sliceRegion)
        worked = thisSliceWorked and worked
      end for

      if not isRolled
        finalBlitWorked = rendererObj.drawObject(0, 0, m.tempBitmap)
        worked = worked and finalBlitWorked
        return worked
      end if

      ' m.tempBitmap is the enlarged, level (unrolled) composite here - rotating it
      ' by rollDegrees about its own center and reading off the real frame-sized
      ' region centered on that same point gives exactly the rolled camera's view
      ' (see the design doc: perspective division commutes with an in-plane rotation
      ' about the optical axis for a pure roll).
      ' Cache the rotated/cropped result into its own frame-sized bitmap (rather
      ' than drawing straight to the renderer's live canvas only) so
      ' performDraw's cache check has something correct to redraw on a frame
      ' where nothing moved - see performDraw.
      center = BGE.Math.VectorOps.create(compositeSize / 2, compositeSize / 2)
      rollRad = BGE.Math.DegreesToRadians(camera.rollDegrees)
      cropOffset = BGE.Math.VectorOps.create((compositeSize - camera.frameSize.x) / 2, (compositeSize - camera.frameSize.y) / 2)

      if invalid = m.rotatedTempBitmap or m.rotatedTempBitmap.GetWidth() <> camera.frameSize.x or m.rotatedTempBitmap.GetHeight() <> camera.frameSize.y
        m.rotatedTempBitmap = CreateObject("roBitmap", {width: camera.frameSize.x, height: camera.frameSize.y, AlphaEnable: true})
      end if
      if invalid = m.rotatedTempBitmap
        print "failed to create rotated temp bitmap"
        return false
      end if
      m.rotatedTempBitmap.Clear(&h00000000)

      worked = worked and rendererObj.drawRotatedImageWithCenterTo(m.rotatedTempBitmap, m.tempBitmap, center, rollRad, BGE.Math.VectorOps.negative(cropOffset))
      worked = worked and rendererObj.drawObject(0, 0, m.rotatedTempBitmap)
      return worked
    end function

    ' Has no single distance from the camera, so it never fades.
    override function participatesInDistanceFade() as boolean
      return false
    end function

  end class

end namespace
