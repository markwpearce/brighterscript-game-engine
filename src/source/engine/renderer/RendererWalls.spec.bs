import "../../math/vector.bs"
import "../drawables/DrawableWalls.bs"
import "../drawables/Image.bs"
import "../Game.bs"
import "../GameEntity.bs"
import "cameras/Camera3d.bs"
import "Renderer.bs"
import "sceneObjects/SceneObject.bs"
import "sceneObjects/SceneObjectWalls.bs"
import "walls/WallSegment.bs"

namespace tests

  ' The eye 50 up at the origin looking down -z; walls across the view, facing it.
  @suite("BGE.Renderer - segment walls")
  class RendererWallsTests extends rooibos.BaseTestSuite

    private game as BGE.Game
    private renderer as BGE.Renderer
    private camera as BGE.Camera3d
    private walls as BGE.SceneObjectWalls
    private target as roBitmap

    protected override sub beforeEach()
      m.game = new BGE.Game(1280, 720)
      m.camera = new BGE.Camera3d()
      m.camera.fieldOfViewDegrees = 90
      m.camera.maxDrawDistance = 2000
      m.camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.camera.drawDistanceFadeFraction = 0
      m.camera.drawDistanceTransitionSeconds = 0
      m.target = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.target, m.game, m.camera)
    end sub

    private sub addWalls(segments as BGE.WallSegment[])
      texture = CreateObject("roBitmap", {width: 16, height: 32, alphaEnable: true})
      texture.Clear(&hFFFFFFFF)
      region = CreateObject("roRegion", texture, 0, 0, 16, 32)
      drawable = new BGE.DrawableWalls(invalid, segments, {stone: region})
      m.walls = drawable.addToRenderer(m.renderer) as BGE.SceneObjectWalls
    end sub

    private function across(z as float, top as float) as BGE.WallSegment
      return BGE.createWallSegment(BGE.Math.VectorOps.create(1000, 0, z), BGE.Math.VectorOps.create(-1000, 0, z), 0, top, "stone", {twoSided: true})
    end function

    private function newBillboard(x as float, y as float, z as float) as BGE.SceneObject
      entity = new BGE.GameEntity(m.game, {name: "billboard"})
      entity.position = BGE.Math.VectorOps.create(x, y, z)
      entity.updateTransformationMatrix()
      bitmap = CreateObject("roBitmap", {width: 10, height: 10, alphaEnable: true})
      bitmap.Clear(&hFF0000FF)
      region = CreateObject("roRegion", bitmap, 0, 0, 10, 10)
      drawable = new BGE.Image(entity, region, {drawMode: BGE.SceneObjectDrawMode.axisAligned})
      return drawable.addToRenderer(m.renderer)
    end function

    private sub renderFrames(count = 2 as integer)
      for i = 1 to count
        m.renderer.setupCameraForFrame()
        m.renderer.render()
      end for
    end sub

    @describe("drawing segment walls")

    @it("draws strips and becomes the active walls")
    function _()
      m.addWalls([m.across(-300, 1000)])
      m.renderFrames()
      m.assertTrue(m.walls.stripsDrawnLastFrame > 0)
      active = m.renderer.getWalls()
      m.assertNotInvalid(active)
      m.assertEqual(m.walls.id, active.id)
    end function

    @it("draws nothing with a Camera2d")
    function _()
      m.addWalls([m.across(-300, 1000)])
      m.renderer.setCamera(new BGE.Camera2d())
      m.renderFrames()
      m.assertInvalid(m.renderer.getWalls())
    end function

    @describe("hiding behind segment walls")

    @it("hides world points behind a wall from overlays")
    function _()
      m.addWalls([m.across(-300, 1000)])
      m.renderFrames()
      m.assertTrue(m.renderer.isBehindWalls(BGE.Math.VectorOps.create(0, 20, -500)))
      m.assertFalse(m.renderer.isBehindWalls(BGE.Math.VectorOps.create(0, 20, -200)))
    end function

    @it("skips an object wholly behind a tall wall, as occluded")
    function _()
      m.addWalls([m.across(-300, 1000)])
      billboard = m.newBillboard(0, 20, -500)
      m.renderFrames()
      m.assertTrue(billboard.hiddenByWallsThisFrame)
    end function

    @it("draws an object behind a short wall that it shows over")
    function _()
      m.addWalls([m.across(-100, 10)])
      billboard = m.newBillboard(0, 40, -200)
      m.renderFrames()
      m.assertFalse(billboard.hiddenByWallsThisFrame)
    end function

    @describe("reusing the walls' walk")

    @it("walks again when floor recording is turned on with the camera still")
    function _()
      m.addWalls([m.across(-300, 30)])
      m.renderFrames()
      m.assertEqual(0, m.walls.view.floorCount)
      m.walls.view.recordSurfaces = true
      m.renderer.setupCameraForFrame()
      m.assertTrue(m.walls.prepareView(m.renderer))
      m.assertTrue(m.walls.view.floorCount > 0)
    end function

    @it("walks again when the far strip distance changes with the camera still")
    function _()
      m.addWalls([m.across(-300, 30)])
      m.renderer.setQualitySettings(BGE.getRenderQualityPreset(BGE.RenderQualityLevel.ultra))
      m.renderFrames()
      m.assertEqual(0.0, m.walls.view.lodDepth)
      m.renderer.setQualitySettings(BGE.getRenderQualityPreset(BGE.RenderQualityLevel.basic))
      m.renderFrames(1)
      m.assertTrue(m.walls.view.lodDepth > 0)
    end function

    @describe("fog past the draw distance")

    ' RGBA of one pixel of the target
    private function pixelAt(x as integer, y as integer) as integer
      bytes = m.target.GetByteArray(x, y, 1, 1)
      return (bytes[0] << 24) + (bytes[1] << 16) + (bytes[2] << 8) + bytes[3]
    end function

    ' Fog on, draw distance 1000 with a 0.15 fade band (850 to 1000), reach 2
    private sub setUpFog(casts = true as boolean)
      m.camera.maxDrawDistance = 1000
      (m.camera as object).maxDrawDistanceDeviceCap = 2500
      m.camera.drawDistanceFadeFraction = 0.15
      m.camera.fog.enabled = true
      m.camera.fog.color = &h1C2842
      m.walls.drawable.castsFogSilhouette = casts
    end sub

    private sub renderClearedFrames(count = 1 as integer)
      for i = 1 to count
        m.target.Clear(&h000000FF)
        m.renderer.setupCameraForFrame()
        m.renderer.render()
      end for
    end sub

    @it("draws a wall past the draw distance in fog colour")
    function _()
      m.addWalls([m.across(-1500, 300)])
      m.setUpFog()
      m.renderClearedFrames()
      m.assertTrue(m.walls.fogStripsDrawnLastFrame > 0)
      ' 250 above the eye at 1500: its top is row 360 - 640 * 250 / 1500 = 253
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 340))
      m.assertEqual(&h000000FF, m.pixelAt(640, 200))
    end function

    @it("merges neighbouring fog strips past the draw distance, up to 4 at a time")
    function _()
      m.addWalls([m.across(-1500, 300)])
      m.setUpFog()
      m.renderClearedFrames()
      pieces = m.walls.view.pieceCount
      m.assertTrue(pieces > 8)
      m.assertTrue(m.walls.fogStripsDrawnLastFrame * 4 >= pieces)
      m.assertTrue(m.walls.fogStripsDrawnLastFrame * 3 < pieces)
      ' no gaps between merged strips, across the wall (x +-1000 at 1500: columns 213 to 1067)
      for x = 220 to 1060 step 7
        m.assertEqual(&h1C2842FF, m.pixelAt(x, 340))
      end for
    end function

    @it("draws nothing past the draw distance without the flag")
    function _()
      m.addWalls([m.across(-1500, 300)])
      m.setUpFog(false)
      m.renderClearedFrames()
      m.assertEqual(0, m.walls.stripsDrawnLastFrame)
      m.assertEqual(&h000000FF, m.pixelAt(640, 340))
    end function

    @it("draws nothing past the draw distance with fog off")
    function _()
      m.addWalls([m.across(-1500, 300)])
      m.setUpFog()
      m.camera.fog.enabled = false
      m.renderClearedFrames()
      m.assertEqual(0, m.walls.stripsDrawnLastFrame)
    end function

    @it("draws nothing past the reach")
    function _()
      m.addWalls([m.across(-2500, 300)])
      m.setUpFog()
      m.renderClearedFrames()
      m.assertEqual(0, m.walls.stripsDrawnLastFrame)
    end function

    @it("crossfades a wall late in the fade band")
    function _()
      ' alpha 0.25 at 962.5, under silhouetteStartAlpha
      m.addWalls([m.across(-962.5, 300)])
      m.setUpFog()
      m.renderClearedFrames()
      m.assertTrue(m.walls.fogStripsDrawnLastFrame > 0)
      m.assertTrue(m.walls.stripsDrawnLastFrame > m.walls.fogStripsDrawnLastFrame)
    end function

    @it("puts solid fog under a fading wall, so the two add up to fully opaque")
    function _()
      ' alpha 0.25 at 962.5: a quarter white wall over three quarters fog
      m.addWalls([m.across(-962.5, 300)])
      m.setUpFog()
      m.renderClearedFrames()
      bytes = m.target.GetByteArray(640, 340, 1, 1)
      ' 0.25 * 255 + 0.75 * &h1C, &h28, &h42
      m.assertTrue(Abs(bytes[0] - 85) <= 4)
      m.assertTrue(Abs(bytes[1] - 94) <= 4)
      m.assertTrue(Abs(bytes[2] - 113) <= 4)
    end function

    @it("merges the crossfading fog strips too")
    function _()
      m.addWalls([m.across(-962.5, 300)])
      m.setUpFog()
      m.renderClearedFrames()
      pieces = m.walls.view.pieceCount
      m.assertTrue(m.walls.fogStripsDrawnLastFrame > 0)
      m.assertTrue(m.walls.fogStripsDrawnLastFrame * 3 < pieces)
    end function

    @it("draws no fog strip while the wall is mostly opaque")
    function _()
      m.addWalls([m.across(-500, 300)])
      m.setUpFog()
      m.renderClearedFrames()
      m.assertTrue(m.walls.stripsDrawnLastFrame > 0)
      m.assertEqual(0, m.walls.fogStripsDrawnLastFrame)
    end function

    @it("walks again when fog is turned on with the camera still")
    function _()
      m.addWalls([m.across(-1500, 300)])
      m.setUpFog()
      m.camera.fog.enabled = false
      m.renderClearedFrames(2)
      m.assertEqual(0, m.walls.stripsDrawnLastFrame)
      m.camera.fog.enabled = true
      m.renderClearedFrames()
      m.assertTrue(m.walls.fogStripsDrawnLastFrame > 0)
    end function

    @it("redraws the fog strips in a new colour with the camera still")
    function _()
      m.addWalls([m.across(-1500, 300)])
      m.setUpFog()
      m.renderClearedFrames(2)
      m.camera.fog.color = &h405060
      m.renderClearedFrames()
      m.assertEqual(&h405060FF, m.pixelAt(640, 340))
    end function

    @it("still hides an object behind a near wall with fog on")
    function _()
      m.addWalls([m.across(-300, 1000), m.across(-1500, 300)])
      m.setUpFog()
      billboard = m.newBillboard(0, 20, -500)
      m.renderClearedFrames(2)
      m.assertTrue(billboard.hiddenByWallsThisFrame)
    end function

  end class

end namespace
