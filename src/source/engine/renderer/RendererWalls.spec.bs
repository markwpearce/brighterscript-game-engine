import "../../math/vector.bs"
import "../drawables/DrawableWalls.bs"
import "../drawables/Image.bs"
import "../Game.bs"
import "../GameEntity.bs"
import "cameras/Camera3d.bs"
import "Renderer.bs"
import "sceneObjects/SceneObject.bs"
import "sceneObjects/SceneObjectWalls.bs"
import "walls/WallSegment.bs"

namespace tests

  ' The eye 50 up at the origin looking down -z; walls across the view, facing it.
  @suite("BGE.Renderer - segment walls")
  class RendererWallsTests extends rooibos.BaseTestSuite

    private game as BGE.Game
    private renderer as BGE.Renderer
    private camera as BGE.Camera3d
    private walls as BGE.SceneObjectWalls

    protected override sub beforeEach()
      m.game = new BGE.Game(1280, 720)
      m.camera = new BGE.Camera3d()
      m.camera.fieldOfViewDegrees = 90
      m.camera.maxDrawDistance = 2000
      m.camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.camera.drawDistanceFadeFraction = 0
      m.camera.drawDistanceTransitionSeconds = 0
      bitmap = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      m.renderer = new BGE.Renderer(bitmap, m.game, m.camera)
    end sub

    private sub addWalls(segments as BGE.WallSegment[])
      texture = CreateObject("roBitmap", {width: 16, height: 32, alphaEnable: true})
      texture.Clear(&hFFFFFFFF)
      region = CreateObject("roRegion", texture, 0, 0, 16, 32)
      drawable = new BGE.DrawableWalls(invalid, segments, {stone: region})
      m.walls = drawable.addToRenderer(m.renderer) as BGE.SceneObjectWalls
    end sub

    private function across(z as float, top as float) as BGE.WallSegment
      return BGE.createWallSegment(BGE.Math.VectorOps.create(1000, 0, z), BGE.Math.VectorOps.create(-1000, 0, z), 0, top, "stone", {twoSided: true})
    end function

    private function newBillboard(x as float, y as float, z as float) as BGE.SceneObject
      entity = new BGE.GameEntity(m.game, {name: "billboard"})
      entity.position = BGE.Math.VectorOps.create(x, y, z)
      entity.updateTransformationMatrix()
      bitmap = CreateObject("roBitmap", {width: 10, height: 10, alphaEnable: true})
      bitmap.Clear(&hFF0000FF)
      region = CreateObject("roRegion", bitmap, 0, 0, 10, 10)
      drawable = new BGE.Image(entity, region, {drawMode: BGE.SceneObjectDrawMode.axisAligned})
      return drawable.addToRenderer(m.renderer)
    end function

    private sub renderFrames(count = 2 as integer)
      for i = 1 to count
        m.renderer.setupCameraForFrame()
        m.renderer.render()
      end for
    end sub

    @describe("drawing segment walls")

    @it("draws strips and becomes the active walls")
    function _()
      m.addWalls([m.across(-300, 1000)])
      m.renderFrames()
      m.assertTrue(m.walls.stripsDrawnLastFrame > 0)
      active = m.renderer.getWalls()
      m.assertNotInvalid(active)
      m.assertEqual(m.walls.id, active.id)
    end function

    @it("draws nothing with a Camera2d")
    function _()
      m.addWalls([m.across(-300, 1000)])
      m.renderer.setCamera(new BGE.Camera2d())
      m.renderFrames()
      m.assertInvalid(m.renderer.getWalls())
    end function

    @describe("hiding behind segment walls")

    @it("hides world points behind a wall from overlays")
    function _()
      m.addWalls([m.across(-300, 1000)])
      m.renderFrames()
      m.assertTrue(m.renderer.isBehindWalls(BGE.Math.VectorOps.create(0, 20, -500)))
      m.assertFalse(m.renderer.isBehindWalls(BGE.Math.VectorOps.create(0, 20, -200)))
    end function

    @it("skips an object wholly behind a tall wall, as occluded")
    function _()
      m.addWalls([m.across(-300, 1000)])
      billboard = m.newBillboard(0, 20, -500)
      m.renderFrames()
      m.assertTrue(billboard.hiddenByWallsThisFrame)
    end function

    @it("draws an object behind a short wall that it shows over")
    function _()
      m.addWalls([m.across(-100, 10)])
      billboard = m.newBillboard(0, 40, -200)
      m.renderFrames()
      m.assertFalse(billboard.hiddenByWallsThisFrame)
    end function

    @describe("reusing the walls' walk")

    @it("walks again when floor recording is turned on with the camera still")
    function _()
      m.addWalls([m.across(-300, 30)])
      m.renderFrames()
      m.assertEqual(0, m.walls.view.floorCount)
      m.walls.view.recordSurfaces = true
      m.renderer.setupCameraForFrame()
      m.assertTrue(m.walls.prepareView(m.renderer))
      m.assertTrue(m.walls.view.floorCount > 0)
    end function

    @it("walks again when the far strip distance changes with the camera still")
    function _()
      m.addWalls([m.across(-300, 30)])
      m.renderer.setQualitySettings(BGE.getRenderQualityPreset(BGE.RenderQualityLevel.ultra))
      m.renderFrames()
      m.assertEqual(0.0, m.walls.view.lodDepth)
      m.renderer.setQualitySettings(BGE.getRenderQualityPreset(BGE.RenderQualityLevel.basic))
      m.renderFrames(1)
      m.assertTrue(m.walls.view.lodDepth > 0)
    end function

  end class

end namespace
