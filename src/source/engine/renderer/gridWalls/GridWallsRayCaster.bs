import "GridWallsMap.bs"

namespace BGE

  interface GridWallsHit
    ' Horizontal distance along the unit ray.
    distance as float
    x as float
    z as float
    ' 0..1 across the face, seen from the open side: 0 at the left edge, 1 at the right
    ' (right is (normalZ, -normalX)).
    u as float
    texture as string
    ' The face's outward normal, towards the open side.
    normalX as float
    normalZ as float
    ' The solid cell that was hit.
    col as integer
    row as integer
  end interface

  ' Grid DDA ray caster over a GridWallsMap. Allocation-free: cast() fills a caller's hit.
  class GridWallsRayCaster

    private map as BGE.GridWallsMap

    sub new(map as BGE.GridWallsMap)
      m.map = map
    end sub

    ' Casts a horizontal ray (unit dir) and fills hit with the first solid cell face within
    ' maxDistance. The grid's outside counts as solid, so a ray leaving it hits the boundary,
    ' and an origin outside returns true at distance 0. Returns false (hit untouched) on a miss.
    function cast(originX as float, originZ as float, dirX as float, dirZ as float, maxDistance as float, hit as BGE.GridWallsHit) as boolean
      map = m.map
      cellSize = map.cellSize
      colCount = map.colCount
      rowCount = map.rowCount

      ' work in cell units
      px = (originX - map.origin.x) / cellSize
      pz = (originZ - map.origin.z) / cellSize
      col = int(px)
      row = int(pz)

      if col < 0 or row < 0 or col >= colCount or row >= rowCount
        hit.distance = 0.0
        hit.x = originX
        hit.z = originZ
        hit.u = 0.0
        hit.texture = map.outsideTexture
        hit.normalX = 0.0
        hit.normalZ = 0.0
        hit.col = col
        hit.row = row
        return true
      end if

      stepX = 1
      deltaX = 1.0e30
      tMaxX = 1.0e30
      if dirX > 0
        deltaX = 1.0 / dirX
        tMaxX = (col + 1 - px) * deltaX
      else if dirX < 0
        stepX = -1
        deltaX = -1.0 / dirX
        tMaxX = (px - col) * deltaX
      end if

      stepZ = 1
      deltaZ = 1.0e30
      tMaxZ = 1.0e30
      if dirZ > 0
        deltaZ = 1.0 / dirZ
        tMaxZ = (row + 1 - pz) * deltaZ
      else if dirZ < 0
        stepZ = -1
        deltaZ = -1.0 / dirZ
        tMaxZ = (pz - row) * deltaZ
      end if

      maxT = maxDistance / cellSize
      solidFlags = map.solidFlags
      t = 0.0
      sideX = true

      ' Leaving the grid counts as a hit, so this ends within colCount + rowCount + 1 steps.
      while true
        if tMaxX < tMaxZ
          t = tMaxX
          tMaxX += deltaX
          col += stepX
          sideX = true
        else
          t = tMaxZ
          tMaxZ += deltaZ
          row += stepZ
          sideX = false
        end if

        if t > maxT
          return false
        end if

        if col < 0 or row < 0 or col >= colCount or row >= rowCount
          exit while
        end if
        if solidFlags[row * colCount + col]
          exit while
        end if
      end while

      hitX = px + dirX * t
      hitZ = pz + dirZ * t
      hit.distance = t * cellSize
      hit.x = originX + dirX * hit.distance
      hit.z = originZ + dirZ * hit.distance
      hit.texture = map.textureAt(col, row)
      hit.col = col
      hit.row = row

      ' right = (nz, -nx): +x for nz=1, -x for nz=-1, +z for nx=-1, -z for nx=1
      if sideX
        hit.normalX = -stepX * 1.0
        hit.normalZ = 0.0
        u = hitZ - row
        if stepX < 0
          u = 1.0 - u
        end if
      else
        hit.normalX = 0.0
        hit.normalZ = -stepZ * 1.0
        u = hitX - col
        if stepZ > 0
          u = 1.0 - u
        end if
      end if
      if u < 0
        u = 0.0
      else if u > 1
        u = 1.0
      end if
      hit.u = u
      return true
    end function

  end class

end namespace
