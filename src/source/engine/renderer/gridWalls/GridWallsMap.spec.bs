import "GridWallsMap.bs"
import "../../../math/vector.bs"

namespace tests

  @suite("BGE.GridWallsMap")
  class GridWallsMapTests extends rooibos.BaseTestSuite

    private function makeMap(outsideTexture = "" as string) as BGE.GridWallsMap
      args = {
        cellSize: 6.0,
        wallHeight: 10.0,
        origin: BGE.Math.VectorOps.create(-9, 0, -9),
        solid: {"#": "stone", "A": "door"}
      } as BGE.GridWallsMapArgs
      if outsideTexture <> ""
        args.outsideTexture = outsideTexture
      end if
      return new BGE.GridWallsMap(["###", "#.#", "#A#"], args)
    end function

    @describe("GridWallsMap")

    @it("reports its size")
    function _()
      map = m.makeMap()
      m.assertEqual(map.colCount, 3)
      m.assertEqual(map.rowCount, 3)
    end function

    @it("isSolid is true for walls and outside the grid")
    function _()
      map = m.makeMap()
      m.assertFalse(map.isSolid(1, 1))
      m.assertTrue(map.isSolid(-1, 1))
      m.assertTrue(map.isSolid(3, 0))
      m.assertTrue(map.isSolid(0, 0))
    end function

    @it("textureAt returns the texture, empty when open")
    function _()
      map = m.makeMap()
      m.assertEqual(map.textureAt(1, 2), "door")
      m.assertEqual(map.textureAt(1, 1), "")
    end function

    @it("textureAt outside defaults to the alphabetically first solid texture")
    function _()
      m.assertEqual(m.makeMap().textureAt(5, 5), "stone")
      m.assertEqual(m.makeMap("door").textureAt(5, 5), "door")
    end function

    @it("cellAt maps world positions to cells")
    function _()
      map = m.makeMap()
      cell = map.cellAt(0.0, 0.0)
      m.assertEqual(cell.col, 1)
      m.assertEqual(cell.row, 1)
      cell = map.cellAt(-9.0, -9.0)
      m.assertEqual(cell.col, 0)
      m.assertEqual(cell.row, 0)
      cell = map.cellAt(-10.0, 100.0)
      m.assertEqual(cell.col, -1)
      m.assertEqual(cell.row, 18)
    end function

    @describe("GridWallsMap.toSegments")

    @it("gives one wall per face round the open cell, facing it")
    function _()
      segs = m.makeMap().toSegments()
      m.assertEqual(4, segs.count())
      doors = 0
      for each seg in segs
        ' the open cell's centre is the origin, in front of every wall
        m.assertTrue((0 - seg.ax) * seg.normalX + (0 - seg.az) * seg.normalZ > 0, `${seg.ax},${seg.az} -> ${seg.bx},${seg.bz}`)
        m.assertTrue(abs(seg.length - 6) < 0.001)
        m.assertTrue(abs(seg.top - 10) < 0.001)
        m.assertTrue(abs(seg.tileWidth - 6) < 0.001)
        m.assertEqual(1, seg.tileCount)
        if seg.texture = "door"
          doors++
        end if
      end for
      m.assertEqual(1, doors)
    end function

    @it("merges a straight run of one texture and splits at a texture change")
    function _()
      map = new BGE.GridWallsMap(["#####", "#...#", "##A##"], {
        cellSize: 2.0,
        wallHeight: 4.0,
        origin: BGE.Math.VectorOps.create(0, 0, 0),
        solid: {"#": "stone", "A": "door"}
      })
      segs = map.toSegments()
      ' north run, south (stone, door, stone), west, east
      m.assertEqual(6, segs.count())
      longest = 0.0
      for each seg in segs
        if seg.length > longest
          longest = seg.length
        end if
      end for
      m.assertTrue(abs(longest - 6) < 0.001)
    end function

  end class

end namespace
