import "../../../math/vector.bs"
import "../walls/WallSegment.bs"

namespace BGE

  interface GridWallsMapArgs
    cellSize as float
    wallHeight as float
    ' The -x/-z corner of cell (0, 0); origin.y is the floor height.
    origin as BGE.Math.Vector
    ' Map character -> texture name. Any other character is open. roAssociativeArray keys are
    ' case-insensitive, so legend characters differing only by case ("a"/"A") collide.
    solid as roAssociativeArray
    optional outsideTexture as string
  end interface

  interface GridWallsCell
    col as integer
    row as integer
  end interface

  ' A rectangular grid of solid and open cells. Row 0 is -z, column 0 is -x.
  class GridWallsMap

    colCount as integer
    rowCount as integer
    cellSize as float
    wallHeight as float
    origin as BGE.Math.Vector

    ' Per-cell lookups, indexed row * colCount + col (read directly by the ray caster).
    solidFlags = []
    textures = []
    outsideTexture = ""

    sub new(rows as string[], args as BGE.GridWallsMapArgs)
      m.cellSize = args.cellSize
      m.wallHeight = args.wallHeight
      m.origin = args.origin
      m.rowCount = rows.count()
      m.colCount = 0
      for each line in rows
        if len(line) > m.colCount
          m.colCount = len(line)
        end if
      end for

      solid = args.solid
      keys = solid.keys()
      keys.sort()
      m.outsideTexture = args.outsideTexture ?? ""
      if m.outsideTexture = "" and keys.count() > 0
        m.outsideTexture = solid[keys[0]]
      end if

      for each line in rows
        for col = 0 to m.colCount - 1
          ch = mid(line, col + 1, 1)
          if ch <> "" and solid.doesExist(ch)
            m.solidFlags.push(true)
            m.textures.push(solid[ch])
          else
            m.solidFlags.push(false)
            m.textures.push("")
          end if
        end for
      end for
    end sub

    ' True for solid cells and for everything outside the grid.
    function isSolid(col as integer, row as integer) as boolean
      if col < 0 or row < 0 or col >= m.colCount or row >= m.rowCount
        return true
      end if
      return m.solidFlags[row * m.colCount + col]
    end function

    ' The texture name of a solid cell, "" when open. Outside the grid: the outside texture.
    function textureAt(col as integer, row as integer) as string
      if col < 0 or row < 0 or col >= m.colCount or row >= m.rowCount
        return m.outsideTexture
      end if
      return m.textures[row * m.colCount + col]
    end function

    ' The walls as segments for a BGE.DrawableWalls: every face between a solid cell (or the
    ' outside) and an open cell, merged into straight runs of one texture, one-sided facing the
    ' open side. A texture spans one cell across and the wall height up, as for grid walls.
    '
    ' @return {BGE.WallSegment[]}
    function toSegments() as BGE.WallSegment[]
      segs = [] as BGE.WallSegment[]
      ' faces along x at each row boundary r (z = r): facing -z (solid row r, open r - 1) or
      ' +z (solid r - 1, open r)
      for r = 0 to m.rowCount
        for each dir in [-1, 1]
          solidRow = r
          openRow = r - 1
          if dir > 0
            solidRow = r - 1
            openRow = r
          end if
          runStart = -1
          runTexture = ""
          for c = 0 to m.colCount
            texture = ""
            if c < m.colCount and m.isSolid(c, solidRow) and not m.isSolid(c, openRow)
              texture = m.textureAt(c, solidRow)
            end if
            if runStart >= 0 and texture <> runTexture
              m.addRun(segs, runStart, c, r, true, dir, runTexture)
              runStart = -1
            end if
            if texture <> "" and runStart < 0
              runStart = c
              runTexture = texture
            end if
          end for
        end for
      end for
      ' faces along z at each column boundary c (x = c): facing -x or +x
      for c = 0 to m.colCount
        for each dir in [-1, 1]
          solidCol = c
          openCol = c - 1
          if dir > 0
            solidCol = c - 1
            openCol = c
          end if
          runStart = -1
          runTexture = ""
          for r = 0 to m.rowCount
            texture = ""
            if r < m.rowCount and m.isSolid(solidCol, r) and not m.isSolid(openCol, r)
              texture = m.textureAt(solidCol, r)
            end if
            if runStart >= 0 and texture <> runTexture
              m.addRun(segs, runStart, r, c, false, dir, runTexture)
              runStart = -1
            end if
            if texture <> "" and runStart < 0
              runStart = r
              runTexture = texture
            end if
          end for
        end for
      end for
      return segs
    end function

    ' A run of faces from cell `first` to before `last` along a boundary line, facing -1/+1
    ' along z (alongX) or x.
    private sub addRun(segs as BGE.WallSegment[], first as integer, last as integer, line as integer, alongX as boolean, dir as integer, texture as string)
      size = m.cellSize
      o = m.origin
      lineOffset = line * size
      p0 = first * size
      p1 = last * size
      ' one-sided walls face the left of start -> end (see createWallSegment())
      if alongX
        z = o.z + lineOffset
        a = BGE.Math.VectorOps.create(o.x + p0, 0, z)
        b = BGE.Math.VectorOps.create(o.x + p1, 0, z)
        if dir > 0
          a = BGE.Math.VectorOps.create(o.x + p1, 0, z)
          b = BGE.Math.VectorOps.create(o.x + p0, 0, z)
        end if
      else
        x = o.x + lineOffset
        a = BGE.Math.VectorOps.create(x, 0, o.z + p1)
        b = BGE.Math.VectorOps.create(x, 0, o.z + p0)
        if dir > 0
          a = BGE.Math.VectorOps.create(x, 0, o.z + p0)
          b = BGE.Math.VectorOps.create(x, 0, o.z + p1)
        end if
      end if
      segs.push(BGE.createWallSegment(a, b, o.y, o.y + m.wallHeight, texture, {tileWidth: size, tileHeight: m.wallHeight}))
    end sub

    ' The cell containing a world position (may be outside the grid).
    function cellAt(x as float, z as float) as BGE.GridWallsCell
      return {
        col: int((x - m.origin.x) / m.cellSize),
        row: int((z - m.origin.z) / m.cellSize)
      }
    end function

  end class

end namespace
