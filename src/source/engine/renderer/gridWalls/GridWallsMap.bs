import "../../../math/vector.bs"

namespace BGE

  interface GridWallsMapArgs
    cellSize as float
    wallHeight as float
    ' The -x/-z corner of cell (0, 0); origin.y is the floor height.
    origin as BGE.Math.Vector
    ' Map character -> texture name. Any other character is open.
    solid as roAssociativeArray
    optional outsideTexture as string
  end interface

  interface GridWallsCell
    col as integer
    row as integer
  end interface

  ' A rectangular grid of solid and open cells. Row 0 is -z, column 0 is -x.
  class GridWallsMap

    colCount as integer
    rowCount as integer
    cellSize as float
    wallHeight as float
    origin as BGE.Math.Vector

    ' Per-cell lookups, indexed row * colCount + col (read directly by the ray caster).
    solidFlags = []
    textures = []
    outsideTexture = ""

    sub new(rows as string[], args as BGE.GridWallsMapArgs)
      m.cellSize = args.cellSize
      m.wallHeight = args.wallHeight
      m.origin = args.origin
      m.rowCount = rows.count()
      m.colCount = 0
      for each line in rows
        if len(line) > m.colCount
          m.colCount = len(line)
        end if
      end for

      solid = args.solid
      keys = solid.keys()
      keys.sort()
      m.outsideTexture = args.outsideTexture ?? ""
      if m.outsideTexture = "" and keys.count() > 0
        m.outsideTexture = solid[keys[0]]
      end if

      for each line in rows
        for col = 0 to m.colCount - 1
          ch = mid(line, col + 1, 1)
          if ch <> "" and solid.doesExist(ch)
            m.solidFlags.push(true)
            m.textures.push(solid[ch])
          else
            m.solidFlags.push(false)
            m.textures.push("")
          end if
        end for
      end for
    end sub

    ' True for solid cells and for everything outside the grid.
    function isSolid(col as integer, row as integer) as boolean
      if col < 0 or row < 0 or col >= m.colCount or row >= m.rowCount
        return true
      end if
      return m.solidFlags[row * m.colCount + col]
    end function

    ' The texture name of a solid cell, "" when open. Outside the grid: the outside texture.
    function textureAt(col as integer, row as integer) as string
      if col < 0 or row < 0 or col >= m.colCount or row >= m.rowCount
        return m.outsideTexture
      end if
      return m.textures[row * m.colCount + col]
    end function

    ' The cell containing a world position (may be outside the grid).
    function cellAt(x as float, z as float) as BGE.GridWallsCell
      return {
        col: int((x - m.origin.x) / m.cellSize),
        row: int((z - m.origin.z) / m.cellSize)
      }
    end function

  end class

end namespace
