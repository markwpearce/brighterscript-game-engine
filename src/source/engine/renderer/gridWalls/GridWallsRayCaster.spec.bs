import "GridWallsMap.bs"
import "GridWallsRayCaster.bs"
import "../../../math/vector.bs"

namespace tests

  @suite("BGE.GridWallsRayCaster")
  class GridWallsRayCasterTests extends rooibos.BaseTestSuite

    private caster as BGE.GridWallsRayCaster
    private hit as BGE.GridWallsHit

    protected override sub beforeEach()
      map = new BGE.GridWallsMap(["###", "#.#", "#A#"], {
        cellSize: 6.0,
        wallHeight: 10.0,
        origin: BGE.Math.VectorOps.create(-9, 0, -9),
        solid: {"#": "stone", "A": "door"}
      })
      m.caster = new BGE.GridWallsRayCaster(map)
      m.hit = {distance: -1.0, x: 0.0, z: 0.0, u: 0.0, texture: "", normalX: 0.0, normalZ: 0.0, col: -9, row: -9}
    end sub

    @describe("GridWallsRayCaster.cast")

    @it("hits the -z wall head on")
    function _()
      m.assertTrue(m.caster.cast(0.0, 0.0, 0.0, -1.0, 100.0, m.hit))
      m.assertEqual(m.hit.distance, 3.0)
      m.assertEqual(m.hit.normalZ, 1.0)
      m.assertEqual(m.hit.normalX, 0.0)
      m.assertEqual(m.hit.row, 0)
      m.assertEqual(m.hit.u, 0.5)
      m.assertEqual(m.hit.texture, "stone")
    end function

    @it("hits the +z door")
    function _()
      m.assertTrue(m.caster.cast(0.0, 0.0, 0.0, 1.0, 100.0, m.hit))
      m.assertEqual(m.hit.texture, "door")
      m.assertEqual(m.hit.normalZ, -1.0)
    end function

    @it("hits the +x wall")
    function _()
      m.assertTrue(m.caster.cast(0.0, 0.0, 1.0, 0.0, 100.0, m.hit))
      m.assertEqual(m.hit.distance, 3.0)
      m.assertEqual(m.hit.normalX, -1.0)
    end function

    @it("u runs left to right as seen from the open side")
    function _()
      m.assertTrue(m.caster.cast(-1.5, 0.0, 0.0, -1.0, 100.0, m.hit))
      m.assertEqual(m.hit.u, 0.25)
      ' looking +z, right is -x, so the same point is mirrored
      m.assertTrue(m.caster.cast(-1.5, 0.0, 0.0, 1.0, 100.0, m.hit))
      m.assertEqual(m.hit.u, 0.75)
      ' looking +x, right is +z
      m.assertTrue(m.caster.cast(0.0, -1.5, 1.0, 0.0, 100.0, m.hit))
      m.assertEqual(m.hit.u, 0.25)
      ' looking -x, right is -z
      m.assertTrue(m.caster.cast(0.0, -1.5, -1.0, 0.0, 100.0, m.hit))
      m.assertEqual(m.hit.u, 0.75)
    end function

    @it("returns false and leaves hit untouched beyond maxDistance")
    function _()
      m.assertFalse(m.caster.cast(0.0, 0.0, 0.0, -1.0, 2.0, m.hit))
      m.assertEqual(m.hit.distance, -1.0)
      m.assertEqual(m.hit.col, -9)
    end function

    @it("handles an exact diagonal")
    function _()
      m.assertTrue(m.caster.cast(0.0, 0.0, 0.7071, 0.7071, 100.0, m.hit))
      m.assertTrue(abs(m.hit.distance - 4.243) < 0.001, `distance ${m.hit.distance}`)
    end function

    @it("terminates from a point exactly on a cell edge")
    function _()
      m.assertTrue(m.caster.cast(-3.0, 0.0, -1.0, 0.0, 100.0, m.hit))
      m.assertTrue(m.caster.cast(-3.0, 0.0, 0.0, -1.0, 100.0, m.hit))
      m.assertTrue(m.caster.cast(-3.0, 0.0, 1.0, 0.0, 100.0, m.hit))
    end function

    @it("treats an origin outside the grid as solid at distance 0")
    function _()
      m.assertTrue(m.caster.cast(100.0, 100.0, 0.0, -1.0, 1000.0, m.hit))
      m.assertEqual(m.hit.distance, 0.0)
      m.assertEqual(m.hit.texture, "stone")
    end function

  end class

end namespace
