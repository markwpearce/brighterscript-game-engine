import "quadColumns/TriangleColumnCuts.bs"
import "ScratchBitmap.bs"

namespace BGE

  const RendererResourceSize = 400
  const DEPTH_TIE_EPSILON = 0.5

  ' Most bands (one `DrawRect` each) a triangle is filled with before the two-call exact fill
  ' is cheaper. Measured the same on a Roku Ultra (rendererTest's "Triangle Fill Check") and
  ' the simulator ("Static Geometry BSP Benchmark": 8 and 16 tied, 30 was 6% slower).
  ' A cost break-even rather than a quality knob, so it isn't in RenderQualitySettings - the
  ' quality trade is the band size while moving, `triangleQuickDrawStep`.
  const TRIANGLE_SPAN_MAX_BANDS = 16

  ' A scene object id no other renderer has handed out. Shared across renderers, since one
  ' Drawable registered with two renderers keys its scene objects by id (issue #343).
  function newSceneObjectId() as string
    globals = GetGlobalAA()
    if invalid = globals.bgeNextSceneObjectId
      globals.bgeNextSceneObjectId = 0
    end if
    id = globals.bgeNextSceneObjectId
    globals.bgeNextSceneObjectId = id + 1
    return id.toStr()
  end function

  ' The triangle fill values a `Renderer` is using - see `getTriangleQuickDrawParams()`.
  interface TriangleQuickDrawParams
    ' While moving, triangles smaller than this many pixels on both axes are skipped
    skipSize as float
    ' A triangle whose shorter bounding-box side, divided by the band size, is at most this
    ' is filled with `DrawRect` bands rather than the exact fill
    maxBands as integer
    ' Band size, in pixels, of the coarse fill used while moving
    step as integer
  end interface

  interface LevelOfDetailOptions
    levelOffset as integer
    levelOfDetail as integer
  end interface

  interface RendererOptions
    useBitmapPooling as boolean
  end interface

  ' Wrapper for Draw2D calls, so that we can keep track of how much is being drawn per frame
  class Renderer

    ' Frame rate target - the game will reduce quality if this target is not met
    protected minimumFrameRateTarget as integer = 12

    protected onlyDrawWhenInFrame as boolean = true

    private drawCallsLastFrame = 0
    private activeDebugCells = 0
    private debugCellSize = 50
    private debugCellStart as BGE.Math.Vector = BGE.Math.VectorOps.create(100, 100)
    drawDebugCells = false
    drawDebugTrianglePoints = false

    private draw2d as ifDraw2D = invalid

    private sceneObjects as SceneObject[] = []
    private needsDepthSort as boolean = true

    ' The static geometry BSP tree (see BGE.BSP), or invalid if no static SceneObject has
    ' ever registered with this renderer. Staying invalid is what makes render() take
    ' today's exact code path for a renderer with no static geometry - see hasStaticGeometry.
    private staticTree as object = invalid
    private needsStaticTreeRebuild as boolean = false

    ' Whether any SceneObject has ever been marked static on this renderer. Distinct from
    ' `staticTree <> invalid` so that removing every static object still routes through
    ' the (now-empty, harmless) BSP draw path rather than silently reverting to the plain
    ' sorted path mid-scene - see buildStaticGeometryTree().
    private hasStaticGeometry as boolean = false

    private lastFrameDidSort as boolean = false
    private overlapClusters as BGE.SceneObject[][] = []
    ' Last frame's overlap-cluster sort order (by SceneObject.id) - fed back into
    ' groupIntoClusters() as previousOrderIds so its sort-and-sweep broad phase can do
    ' an incremental (nearly-sorted) insertion sort instead of a fresh one every frame.
    private lastClusterSortOrder as string[] = []

    ' Whether computeOverlapClusters was true on the previous frame - see render()'s
    ' clusterMemberCount reset-to-1 loop, which uses this to skip itself on any frame
    ' where clustering has never been (or is no longer) turned on, rather than running
    ' unconditionally every single frame regardless of whether it's needed.
    private wasComputingOverlapClusters as boolean = false

    ' SceneObjects deferred from the normal per-object draw path this frame because
    ' their clusterMemberCount > 1 - see SceneObject.draw()/addPendingClusterDraw().
    ' Drawn all together, interleaved by primitive depth, at the end of render().
    private pendingClusterDraws as object[] = []

    ' Whether render() computes overlap clusters (BGE.DepthSort.groupIntoClusters)
    ' this frame. Off by default: nothing in the engine's actual draw path consumes
    ' getOverlapClusters() yet (that's a future follow-up - see #59's Plan 2), the cost
    ' of the O(n^2)-ish broad phase across every scene object hasn't been measured
    ' on-device, and the design's own requirement is that a solo (non-overlapping)
    ' scene sees zero regression from today's cost. Set this true to opt in (see
    ' examples/depthsort's ClusterVisualizerScene, which visualizes the result) -
    ' TieBreakScene deliberately does NOT opt in, since it only demonstrates the
    ' tie-break fix, not clustering.
    '
    ' Known limitation: see drawPendingClusterPrimitives()'s doc comment for a
    ' disclosed draw-order gap affecting objects excluded from cluster candidacy
    ' entirely (lines, planes, or anything else with a degenerate bounding-point set).
    public computeOverlapClusters as boolean = false

    ' Whether static drawables flagged isOccluder hide what's behind them.
    public occlusionCullingEnabled as boolean = true
    ' Number of vertical bands in the occlusion span map.
    public occlusionBandCount as integer = 45
    ' The most occluders considered per frame.
    public maxOccluders as integer = 32
    ' Pixels added around each tested object's canvas box (plus its outline width) before
    ' it's checked against the occluders, so an object near an occluder's edge still draws.
    public occlusionMargin as float = 2.0
    ' Whether to draw the occlusion debug overlay (see Game.debugDrawOcclusion()).
    public showOcclusionDebug as boolean = false
    ' How occluders trade exactness for speed - see BGE.OccluderDrawPolicy. Takes effect
    ' from the next render(); every cached drawing is redrawn once when it changes.
    public occluderDrawPolicy as BGE.OccluderDrawPolicy = BGE.OccluderDrawPolicy.fastShrink
    ' The policy last handed to the registered occluders.
    private appliedOccluderDrawPolicy as BGE.OccluderDrawPolicy = BGE.OccluderDrawPolicy.fastShrink

    ' Registered occluder scene objects by id.
    private occluders as roAssociativeArray = {}
    private occludersChanged as boolean = false
    private occlusionMap as BGE.OcclusionSpanMap = invalid
    ' Bumped on every map build, so scene objects know their verdict is stale.
    private occlusionMapVersion as integer = 0
    private occlusionMapBuildCount as integer = 0
    private occludedCountLastFrame as integer = 0
    private occlusionMsLastFrame as integer = 0
    private occlusionTestsLastFrame as integer = 0
    private occlusionTimer as roTimespan = CreateObject("roTimespan")
    private occlusionBuildMsLastFrame as integer = 0

    ' When true, render() times each of its stages, and each scene object type's draws -
    ' see getStageMsLastFrame(). Costs a timer read per scene object drawn, so leave it off
    ' outside profiling.
    public profileStages as boolean = false

    ' The grid walls object this renderer draws (one at most), and the one drawn this frame.
    private gridWallsObject as dynamic = invalid
    private activeGridWalls as dynamic = invalid
    ' Wall spans to redraw over partly hidden cluster members once the cluster pass has drawn.
    private pendingWallRedraws = [] as BGE.GridWallsSpan[]
    ' Scratch for the span each sorted object is tested by.
    private wallSpan = {valid: false, firstRay: 0, lastRay: 0, nearestDistance: 0.0} as BGE.GridWallsSpan
    private stageMs as roAssociativeArray = {}
    private stageCounts as roAssociativeArray = {}
    ' Scratch for projected occlusion test points: x, y, depth per point.
    private occlusionProjected as float[] = []
    private occlusionDepthPoint as BGE.Math.Vector[] = [invalid]
    ' Whether updateOcclusion() did any work last frame - so turning it off clears verdicts once.
    private occlusionWasActive as boolean = false
    ' What the current map was built for - any change forces a rebuild.
    private occlusionMapWidth as integer = 0
    private occlusionMapHeight as integer = 0
    private occlusionMapBandCount as integer = 0
    private occlusionMapProjectionVersion as integer = -1
    private occlusionMapMaxOccluders as integer = -1
    private occlusionMapMargin as float = -1.0

    camera as Camera

    ' Draws textured quads as projected texture columns (see drawTexturedQuadTo())
    quadColumns = new BGE.QuadColumnDrawer()
    ' Most textures getQuadColumnTexture() keeps before starting over (each holds its bitmap)
    maxQuadColumnTextures as integer = 64
    private quadColumnTextures as roAssociativeArray = {}
    private quadColumnTextureCount as integer = 0

    frameCount = 0

    bmpPool as BGE.ScratchBitmapPool = invalid

    private defaultFont as roFont = invalid
    private defaultDebugFont as roFont = invalid

    private isSimulator as boolean = false

    ' The draw-quality values this renderer uses. `Game` sets these from the current
    ' render quality level; a Renderer used without a Game starts at Medium.
    qualitySettings as BGE.RenderQualitySettings = BGE.getRenderQualityPreset(BGE.RenderQualityLevel.medium)

    ' Ground plane reach pushed to the camera each frame, once set; until then, qualitySettings'.
    private hasPlaneDrawDistanceRange as boolean = false
    private planeDrawDistanceScale as float = 1.0
    private planeDrawDistanceOverride as float = 0.0

    ' Bumped by every setQualitySettings() call, so scene objects know to redraw their
    ' cached bitmaps at the new quality even when nothing moved.
    qualityVersion as integer = 0
    ' The lights shading this renderer's `isShaded` drawables - see addLight(). With no
    ' enabled light, a shaded surface is lit from the camera instead, by how directly it
    ' faces it.
    lights as BGE.Light[] = []

    ' Bumped whenever a light is added, removed or changed, so scene objects know to
    ' relight their cached drawings even when nothing moved.
    lightingVersion as integer = 0

    private preparedLights as BGE.Lighting.PreparedLight[] = []
    private lightingSignature as object[] = []

    ' Derived from qualitySettings once per change, since triangle drawing reads it per call.
    private triangleQuickDrawParams as TriangleQuickDrawParams = invalid
    ' Counts triangles drawn with a coarse or skipped fill - see getLossyTriangleFillCount().
    private lossyTriangleFillCount = 0

    game as BGE.Game = invalid

    name as string = "Renderer"

    statsString as string = ""

    resources as {
      rightTriangle as BGE.RendererHelpers.TriangleBitmap,
      circle as ifDraw2d,
      circleRegionWithId as BGE.RendererHelpers.RegionWithId,
      whiteColumnTexture as BGE.QuadColumnTexture,
      circleQuadrants as {
        topLeft as roRegion,
        topRight as roRegion,
        bottomLeft as roRegion,
        bottomRight as roRegion
      }
    } = {}


    dummyScreen as roScreen

    ' Turns on alpha blending on `draw2d` (`SetAlphaEnable(true)`), which scene objects need -
    ' so later drawing of your own onto that surface blends too.
    sub new(draw2d as ifDraw2d, mainGame = invalid as BGE.Game, cam = invalid as BGE.Camera, options = {useBitmapPooling: true} as RendererOptions)
      m.game = mainGame
      m.useDrawTarget(draw2d)
      if BGE.getDeviceRenderTier() = BGE.DeviceRenderTier.simulator
        ' The simulator does not need pooling
        m.isSimulator = true
      end if
      m.bmpPool = new BGE.ScratchBitmapPool(options.useBitmapPooling)
      m.setCamera(cam)
      m.updateTriangleQuickDrawParams()
    end sub


    ' The renderer's shared right-triangle texture (see drawTriangleTo's oriented triangle
    ' fill), built lazily on first use rather than eagerly in the constructor - this used
    ' to be built upfront for every single Renderer constructed (i.e. every single Game),
    ' most of which never draw a triangle at all. Cached in resources.rightTriangle after
    ' the first call, exactly like resources.circle. See issue #103.
    '
    ' @return {BGE.RendererHelpers.TriangleBitmap} the built triangle resource, or invalid
    '   if it couldn't be created
    function getRightTriangleResource() as BGE.RendererHelpers.TriangleBitmap
      if invalid = m.resources.rightTriangle
        m.resources.rightTriangle = m.createRightTriangleResource()
      end if
      return m.resources.rightTriangle
    end function

    private function createRightTriangleResource() as BGE.RendererHelpers.TriangleBitmap
      rightTriPoints = [
        BGE.Math.VectorOps.create(0, 0),
        BGE.Math.VectorOps.create(0, RendererResourceSize),
        BGE.Math.VectorOps.create(RendererResourceSize, 0)
      ]
      rightTriBitmap = CreateObject("roBitmap", {width: RendererResourceSize, height: RendererResourceSize, AlphaEnable: true})
      if invalid = rightTriBitmap
        return invalid
      end if
      ' Exact rows, so every pixel along the legs and hypotenuse is opaque - a softer edge
      ' shows as dotted seams wherever two fills meet (issue #339)
      rightTriBitmap.Clear(0)
      for row = 0 to RendererResourceSize - 1
        rightTriBitmap.DrawRect(0, row, RendererResourceSize - row, 1, -1)
      end for
      rightTriBitmap.Finish()
      return BGE.RendererHelpers.createTriangleBitmap(rightTriBitmap, rightTriPoints)
    end function


    ' The renderer's shared circle texture (see DrawableCircle/DrawableSphere/drawCircle),
    ' rasterized lazily on first use rather than eagerly in the constructor - rasterizing
    ' it (there is no native filled-circle draw call, so it's approximated with a
    ' row-by-row scanline fill) is expensive enough that building one for every single
    ' Renderer constructed - which is every single Game constructed, most of which never
    ' draw a circle at all - was measurably slowing down the entire test suite. Cached in
    ' resources.circle after the first call, exactly like resources.rightTriangle (see
    ' getRightTriangleResource(), issue #103), just built on demand instead of upfront.
    '
    ' @return {ifDraw2d} the rasterized circle bitmap, or invalid if it couldn't be created
    function getCircleResource() as ifDraw2d
      if invalid = m.resources.circle
        m.resources.circle = m.createCircleResource()
      end if
      return m.resources.circle
    end function


    ' The single shared roRegion wrapping getCircleResource(), cached after the first
    ' call - every DrawableCircle/DrawableSphere instance draws the exact same region,
    ' so SceneObjectCircle fetches this once per renderer instead of calling
    ' CreateObject("roRegion", ...) fresh on every single frame for every circle (which
    ' measurably tanked FPS with more than a couple on screen at once - unlike
    ' SceneObjectImage, which already caches its own region on the drawable at
    ' construction, this had no per-instance drawable to cache on, so it lives here).
    '
    ' @return {BGE.RendererHelpers.RegionWithId}
    function getCircleRegionWithId() as BGE.RendererHelpers.RegionWithId
      if invalid = m.resources.circleRegionWithId
        circleBitmap = m.getCircleResource()
        if invalid = circleBitmap
          ' Not cached - a struct with an invalid .region, never bare `invalid` itself,
          ' matching the convention every other getRegionWithIdToDraw() override follows
          ' (e.g. SceneObjectImage's, via a drawable whose own .region can be invalid).
          ' SceneObjectBillboard.drawToCanvas dereferences `regionToDraw.region` before
          ' its own invalid-check, so a bare `invalid` return here would crash instead
          ' of gracefully failing.
          return BGE.RendererHelpers.createRegionWithId(invalid, "__bge_circle")
        end if
        region = CreateObject("roRegion", circleBitmap, 0, 0, circleBitmap.getWidth(), circleBitmap.getHeight())
        m.resources.circleRegionWithId = BGE.RendererHelpers.createRegionWithId(region, "__bge_circle")
      end if
      return m.resources.circleRegionWithId
    end function


    ' Filling this as a many-sided polygon (via drawPolygonTo's fan triangulation) leaves
    ' visible seam lines radiating from the center, where each triangle's own blended edge
    ' meets the still-transparent background of a neighboring triangle - fine for a single
    ' opaque shape drawn once to a canvas, but visible here since every triangle shares
    ' this bitmap's edges. A row-by-row scanline fill has no adjacent shapes to seam
    ' against - each row is one flat, fully-opaque DrawRect - so it's used instead, even
    ' though it's conceptually simpler than reusing the polygon fill machinery.
    private function createCircleResource() as ifDraw2d
      margin = 2
      radius = (RendererResourceSize / 2) - margin
      center = RendererResourceSize / 2
      circleBitmap = CreateObject("roBitmap", {width: RendererResourceSize, height: RendererResourceSize, AlphaEnable: true})
      if invalid = circleBitmap
        return invalid
      end if
      for y = -radius to radius
        halfWidth = Sqr((radius * radius) - (y * y))
        if halfWidth > 0
          m.drawRectangleTo(circleBitmap, center - halfWidth, center + y, halfWidth * 2, 1, &hFFFFFFFF)
        end if
      end for
      return circleBitmap
    end function

    ' Scene objects are blitted from bitmaps with transparent corners, which a surface with
    ' alpha blending off would copy as opaque black over whatever is already drawn (#332).
    private sub useDrawTarget(draw2d as ifDraw2d)
      m.draw2d = draw2d
      if invalid <> draw2d
        draw2d.SetAlphaEnable(true)
      end if
    end sub

    ' Points this renderer at a different surface. Turns on alpha blending on it, which
    ' scene objects need.
    '
    ' @param {ifDraw2d} draw2d
    sub setDraw2d(draw2d as ifDraw2d)
      m.useDrawTarget(draw2d)
      m.camera.setFrameSize(m.draw2d.getWidth(), m.draw2d.getHeight())
    end sub

    sub setCamera(camera as Camera)
      isDefaultCamera = invalid = camera
      if isDefaultCamera
        camera = new Camera2d()
      end if
      m.camera = camera
      m.camera.setFrameSize(m.draw2d.getWidth(), m.draw2d.getHeight())
      if isDefaultCamera
        m.camera.useDefaultCameraTarget()
      end if
    end sub

    ' Sets how far a ground plane reaches: the largest draw-distance scale and override
    ' any quality level uses. `RenderQualityManager` calls this; without it the ground
    ' reaches this renderer's own level's distance.
    '
    ' @param {float} scale
    ' @param {float} override 0 for none
    sub setPlaneDrawDistanceRange(scale as float, override as float)
      m.hasPlaneDrawDistanceRange = true
      m.planeDrawDistanceScale = scale
      m.planeDrawDistanceOverride = override
    end sub

    ' Adds a light that shades this renderer's `isShaded` drawables. Adding the first
    ' light switches shading from camera-facing to these lights.
    '
    ' @param {BGE.Light} light e.g. `new BGE.DirectionalLight(BGE.Math.VectorOps.create(1, -1, -1))`
    sub addLight(light as BGE.Light)
      if light.id = ""
        ' global, so a light shared between renderers can't collide with another's id
        globals = GetGlobalAA()
        nextId = globals.bgeNextLightId ?? 0
        globals.bgeNextLightId = nextId + 1
        light.id = "light_" + nextId.toStr()
      end if
      for each existing in m.lights
        if existing.id = light.id
          return
        end if
      end for
      m.lights.push(light)
    end sub

    ' Removes a light added with addLight().
    '
    ' @param {BGE.Light} light
    ' @return {boolean} true if it was found
    function removeLight(light as BGE.Light) as boolean
      for i = 0 to m.lights.count() - 1
        if m.lights[i].id = light.id
          m.lights.delete(i)
          return true
        end if
      end for
      return false
    end function

    ' Removes every light, returning shading to camera-facing.
    sub clearLights()
      m.lights = []
    end sub

    ' Whether shading uses this renderer's lights (at least one is enabled) as of this frame.
    '
    ' @return {boolean}
    function hasLights() as boolean
      return m.preparedLights.count() > 0
    end function

    ' This frame's enabled lights, ready for BGE.Lighting.computeLightAmount().
    '
    ' @return {BGE.Lighting.PreparedLight[]}
    function getPreparedLights() as BGE.Lighting.PreparedLight[]
      return m.preparedLights
    end function

    ' Picks up any light change since last frame. render() calls this first; lights are
    ' compared by value, so changing a light's fields directly is noticed too.
    sub updateLighting()
      signature = BGE.Lighting.getLightingSignature(m.lights)
      if not BGE.Lighting.isSameLightingSignature(signature, m.lightingSignature)
        m.lightingSignature = signature
        m.preparedLights = BGE.Lighting.prepareLights(m.lights)
        m.lightingVersion++
      end if
    end sub

    ' Replaces this renderer's draw-quality values. Takes effect from the next draw.
    ' Use this rather than assigning `qualitySettings` directly.
    '
    ' @param {BGE.RenderQualitySettings} settings - e.g. `BGE.getRenderQualityPreset(BGE.RenderQualityLevel.high)`
    sub setQualitySettings(settings as BGE.RenderQualitySettings)
      m.qualitySettings = settings
      m.qualityVersion++
      m.updateTriangleQuickDrawParams()
    end sub

    ' The triangle fill parameters in effect for this quality level.
    '
    ' @return {object} {skipSize, maxBands, step}
    function getTriangleQuickDrawParams() as TriangleQuickDrawParams
      return m.triangleQuickDrawParams
    end function

    ' How many triangles this renderer has drawn with a coarse (or skipped) fill so far.
    ' Compare it before and after drawing to tell whether that drawing needs redoing exactly
    ' once the object stops moving.
    '
    ' @return {integer}
    function getLossyTriangleFillCount() as integer
      return m.lossyTriangleFillCount
    end function

    ' How far, in pixels, a triangle filled with allowQuickDraw may fall short of its exact
    ' edges: the coarse band size, or 0 when quick drawing never coarsens a fill.
    '
    ' @return {float}
    function getQuickDrawFillError() as float
      bandStep = m.triangleQuickDrawParams.step
      if bandStep > 1
        return bandStep * 1.0
      end if
      return 0.0
    end function

    private sub updateTriangleQuickDrawParams()
      bandStep = m.qualitySettings.triangleQuickDrawStep
      if bandStep < 1
        bandStep = 1
      end if
      m.triangleQuickDrawParams = {skipSize: m.qualitySettings.triangleSkipSize, maxBands: BGE.TRIANGLE_SPAN_MAX_BANDS, step: bandStep}
    end sub

    sub resetDrawCallCounter()
      m.drawCallsLastFrame = 0
      m.activeDebugCells = 0
    end sub


    ' How many draw calls have been issued since `resetDrawCallCounter()` - i.e. over the
    ' course of the current frame. Handy when working out how expensive a scene is to draw.
    '
    ' @return {integer} the number of draw calls so far this frame
    function getDrawCallsLastFrame() as integer
      return m.drawCallsLastFrame
    end function

    ' Whether render() actually re-sorted the scene objects last frame, or skipped
    ' the sort because nothing that could change draw order happened. Exposed for
    ' testing/diagnostics, not meant to drive game logic.
    '
    ' @return {boolean}
    function didSortLastFrame() as boolean
      return m.lastFrameDidSort
    end function

    ' How many SceneObjects are currently registered with this renderer.
    '
    ' @return {integer}
    function getSceneObjectCount() as integer
      return m.sceneObjects.count()
    end function

    ' This frame's overlap clusters - most objects are alone in a cluster of one. Only
    ' computed when computeOverlapClusters is true (off by default - see that field);
    ' otherwise this returns whatever was last computed (or [] if never enabled). Plan 2
    ' will use this to decide caching/draw behavior; for now it's purely diagnostic/
    ' visualized by examples/depthsort.
    '
    ' @return {BGE.SceneObject[][]} each cluster as an array of its member SceneObjects
    function getOverlapClusters() as BGE.SceneObject[][]
      return m.overlapClusters
    end function

    ' The current array index of the SceneObject with the given id, or -1 if none
    ' matches. Exposed for testing stable sort order - not meant for game logic.
    '
    ' @param {string} id
    ' @return {integer}
    function getSceneObjectIndexById(id as string) as integer
      for i = 0 to m.sceneObjects.count() - 1
        if m.sceneObjects[i].id = id
          return i
        end if
      end for
      return -1
    end function

    sub addSceneObject(sceneObj as SceneObject)
      sceneObj.setId(BGE.newSceneObjectId())
      m.sceneObjects.push(sceneObj)
      ' Initialize lastSortIndex to the current insertion position so objects added
      ' at the same time are ordered by their addition order even before the first sort.
      sceneObj.setLastSortIndex(m.sceneObjects.count() - 1)
      m.needsDepthSort = true

      owner = sceneObj.drawable.owner
      if owner <> invalid and owner.isStatic
        m.markStatic(sceneObj)
      end if

      m.syncOccluderFlag(sceneObj)

      if sceneObj.type = SceneObjectType.GridWalls
        if invalid = m.gridWallsObject
          m.gridWallsObject = sceneObj
        else
          sceneObj.drawable.log("Drawable '" + sceneObj.drawable.name + "' is a second grid walls object on this renderer - only one is supported, so it will not draw", BGE.Debug.LogLevel.warning)
        end if
      end if
    end sub

    ' The grid walls scene object drawn this frame (a BGE.SceneObjectGridWalls), or invalid
    ' if none drew - e.g. none is registered, it's disabled, or the camera is a Camera2d.
    '
    ' @return {dynamic}
    function getGridWalls() as dynamic
      return m.activeGridWalls
    end function

    ' Whether a world point is hidden behind the grid walls, as seen from the camera, so a
    ' game can hide its own overlays. As of the last render(): false when no walls drew then.
    ' drawWorldBar/drawWorldPolyline (and so drawWorldCircle/drawWorldArc) already use this.
    '
    ' @param {BGE.Math.Vector} point - world space
    ' @return {boolean}
    function isBehindGridWalls(point as BGE.Math.Vector) as boolean
      if invalid = m.activeGridWalls
        return false
      end if
      walls = m.activeGridWalls as BGE.SceneObjectGridWalls
      return walls.view.isPointHidden(point)
    end function

    ' Registers or unregisters an owned scene object as an occluder when its Drawable's
    ' isOccluder changes (checked every frame). Ownerless scene objects opt in by calling
    ' markOccluder() directly, so they're left alone.
    private sub syncOccluderFlag(sceneObj as SceneObject)
      drawable = sceneObj.drawable
      if drawable.isOccluder = sceneObj.occluderFlagSeen
        return
      end if
      owner = drawable.owner
      if owner = invalid
        return
      end if
      if drawable.isOccluder and not owner.isStatic
        ' not latched, so it registers once the owner is made static
        drawable.warnOccluderNeedsStaticOwner()
        return
      end if
      sceneObj.occluderFlagSeen = drawable.isOccluder
      if drawable.isOccluder
        m.markOccluder(sceneObj)
      else
        m.unmarkOccluder(sceneObj)
      end if
    end sub

    private sub unmarkOccluder(sceneObj as SceneObject)
      if sceneObj.isOccluder
        m.occluders.delete(sceneObj.id)
        sceneObj.isOccluder = false
        m.occludersChanged = true
      end if
    end sub

    ' Registers a SceneObject as an occluder, so it can hide objects behind it. Called
    ' automatically by addSceneObject() for a Drawable with isOccluder set on a static
    ' entity - exposed publicly so a SceneObject with no owning GameEntity can opt in
    ' directly. Declines (with a warning) a type that can't occlude, or a drawable whose
    ' own drawMode is screen-aligned.
    '
    ' @param {SceneObject} sceneObj
    sub markOccluder(sceneObj as SceneObject)
      drawable = sceneObj.drawable
      if not sceneObj.isEligibleOccluderType()
        drawable.log("Drawable '" + drawable.name + "' has isOccluder set but its " + sceneObj.type.toStr() + " scene object type can't occlude (only Image, Rectangle and Model can) - it will draw normally", BGE.Debug.LogLevel.warning)
        return
      end if
      if isScreenAlignedDrawMode(drawable.drawMode)
        drawable.log("Drawable '" + drawable.name + "' has isOccluder set but uses a screen-aligned draw mode, which can't occlude - it will draw normally", BGE.Debug.LogLevel.warning)
        return
      end if
      sceneObj.prepareOccluder()
      sceneObj.isOccluder = true
      sceneObj.occluderDrawPolicy = m.occluderDrawPolicy
      m.occluders[sceneObj.id] = sceneObj
      m.occludersChanged = true
    end sub

    ' Hands a changed occluderDrawPolicy to every occluder. Bumping qualityVersion redraws
    ' the cached bitmaps (drawn under the old policy) and rebuilds the occlusion map.
    private sub applyOccluderDrawPolicy()
      if m.occluderDrawPolicy = m.appliedOccluderDrawPolicy
        return
      end if
      m.appliedOccluderDrawPolicy = m.occluderDrawPolicy
      for each id in m.occluders
        occluder = m.occluders[id] as SceneObject
        occluder.occluderDrawPolicy = m.occluderDrawPolicy
      end for
      m.qualityVersion++
    end sub

    ' Whether any occluder is currently registered.
    '
    ' @return {boolean}
    function hasOccluders() as boolean
      return m.occluders.count() > 0
    end function

    ' The occlusion span map built from this frame's occluders, for debug drawing and tests.
    '
    ' @return {BGE.OcclusionSpanMap} invalid until occlusion culling has first had work to do
    function getOcclusionMap() as BGE.OcclusionSpanMap
      return m.occlusionMap
    end function

    ' How many times the occlusion map has been built. It's only rebuilt when the camera,
    ' an occluder, the canvas or an occlusion setting changes.
    '
    ' @return {integer}
    function getOcclusionMapBuildCount() as integer
      return m.occlusionMapBuildCount
    end function

    ' How many scene objects occlusion culling or grid walls hid in the last rendered frame.
    '
    ' @return {integer}
    function getOccludedCountLastFrame() as integer
      return m.occludedCountLastFrame
    end function

    ' How long occlusion culling took in the last rendered frame, in whole milliseconds.
    '
    ' @return {integer}
    function getOcclusionMsLastFrame() as integer
      return m.occlusionMsLastFrame
    end function

    ' How many scene objects were fully tested against the occlusion map in the last
    ' rendered frame - those not ruled out by a cheaper check first.
    '
    ' @return {integer}
    function getOcclusionTestsLastFrame() as integer
      return m.occlusionTestsLastFrame
    end function

    ' Marks a SceneObject as static geometry and schedules a tree rebuild. Called
    ' automatically by addSceneObject() when the object's owning GameEntity is isStatic -
    ' exposed publicly so a SceneObject with no owning GameEntity (e.g.
    ' examples/rendererTest, which builds scene objects directly - see SkyboxTest.bs)
    ' can still opt in directly.
    '
    ' Self-guards on isEligibleForStaticBsp(): a type that doesn't support static BSP
    ' (v1 supports SceneObjectImage/SceneObjectRectangle only) is declined rather than
    ' flagged isStatic, since buildStaticGeometryTree() would otherwise call
    ' getWorldPoints() on it (base-class default `invalid`) and crash on the next
    ' rebuild. This guard lives here rather than only at addSceneObject()'s call site so
    ' a direct call to this public method gets the same protection.
    '
    ' @param {SceneObject} sceneObj
    sub markStatic(sceneObj as SceneObject)
      if not sceneObj.isEligibleForStaticBsp()
        owner = sceneObj.drawable.owner
        ' an occluder only needs isStatic to occlude, so a static model occluder is expected
        isOccluderOnly = sceneObj.drawable.isOccluder and sceneObj.isEligibleOccluderType()
        if owner <> invalid and not isOccluderOnly
          sceneObj.drawable.log("GameEntity '" + owner.name + "' is marked isStatic but its " + sceneObj.type.toStr() + " scene object type doesn't support static geometry yet (v1 supports SceneObjectImage/SceneObjectRectangle only) - it will draw using the normal sorted order instead", BGE.Debug.LogLevel.warning)
        end if
        return
      end if
      sceneObj.isStatic = true
      m.hasStaticGeometry = true
      m.needsStaticTreeRebuild = true
    end sub

    ' Registers a SceneObject as deferred to the end-of-frame interleaved cluster draw
    ' pass - called by SceneObject.draw() when clusterMemberCount > 1. Not meant to be
    ' called directly by game code.
    '
    ' @param {SceneObject} sceneObj
    sub addPendingClusterDraw(sceneObj as SceneObject)
      m.pendingClusterDraws.push(sceneObj)
    end sub

    sub removeSceneObject(sceneObjToRemove as SceneObject)
      indexToDelete = -1
      for i = 0 to m.sceneObjects.count()
        sceneObj = m.sceneObjects[i]
        if sceneObj.id = sceneObjToRemove.id
          indexToDelete = i
          exit for
        end if
      end for
      if indexToDelete >= 0
        m.sceneObjects.delete(indexToDelete)
        m.needsDepthSort = true
        if sceneObjToRemove.isStatic
          m.needsStaticTreeRebuild = true
        end if
        m.unmarkOccluder(sceneObjToRemove)
        if invalid <> m.gridWallsObject and m.gridWallsObject.id = sceneObjToRemove.id
          m.gridWallsObject = invalid
        end if
      end if
      sceneObjToRemove.id = ""
    end sub

    ' Scene objects worth handing to BGE.DepthSort.groupIntoClusters() this frame:
    ' disabled objects and already-culled objects are excluded, since neither will
    ' actually be drawn this frame - clustering them would waste the broad-phase cost on
    ' objects whose transforms may also be stale (a culled object's geometry isn't
    ' guaranteed to have been recomputed this frame). Objects that opt out via
    ' participatesInOverlapDetection() (e.g. SceneObjectLine - see its doc comment) are
    ' excluded too - for a line specifically, this is pure cost avoidance for a
    ' computation that was always going to reject it anyway (its 2-point hull can never
    ' pass the narrow phase's MIN_VALID_HULL_POINTS check), not a tolerated correctness
    ' gap.
    '
    ' @return {BGE.SceneObject[]}
    private function getClusterCandidates() as BGE.SceneObject[]
      candidates = []
      for each sceneObj in m.sceneObjects
        if sceneObj.isEnabled() and not sceneObj.isCulled() and not sceneObj.occludedThisFrame and sceneObj.participatesInOverlapDetection()
          candidates.push(sceneObj)
        end if
      end for
      return candidates
    end function

    private sub updateSceneObjects()
      for each sceneObj in m.sceneObjects
        ' Checked unconditionally (not just while enabled) - a disabled object never
        ' reaches update() below, so this is the only place a static object *becoming*
        ' disabled is ever detected. See checkStaticEnabledStateChanged()'s doc comment.
        if sceneObj.checkStaticEnabledStateChanged()
          m.needsStaticTreeRebuild = true
        end if
        m.syncOccluderFlag(sceneObj)
        sceneObj.hiddenByWallsThisFrame = false
        if sceneObj.isEnabled()
          if m.profileStages
            start = m.occlusionTimer.TotalMilliseconds()
            sceneObj.update(m.camera)
            m.addStageMs("update" + sceneObj.type, m.occlusionTimer.TotalMilliseconds() - start)
          else
            sceneObj.update(m.camera)
          end if
          if sceneObj.depthChangedThisFrame
            m.needsDepthSort = true
          end if
          if sceneObj.staticGeometryMovedThisFrame
            m.needsStaticTreeRebuild = true
          end if
        else
          sceneObj.markSkippedWhileDisabled()
        end if
      end for
    end sub

    ' Judges which scene objects this frame's occluders hide (see SceneObject.occludedThisFrame),
    ' rebuilding the span map only when something it depends on changed.
    private sub updateOcclusion()
      wasActive = m.occlusionWasActive
      m.occludedCountLastFrame = 0
      m.occlusionTestsLastFrame = 0
      m.occlusionBuildMsLastFrame = 0
      if not m.occlusionCullingEnabled or not m.hasOccluders() or not m.camera.supportsOcclusionCulling()
        if wasActive
          for each sceneObj in m.sceneObjects
            m.clearOcclusionVerdict(sceneObj)
          end for
          m.occlusionWasActive = false
        end if
        return
      end if
      m.occlusionWasActive = true

      width = m.draw2d.getWidth()
      height = m.draw2d.getHeight()
      needsBuild = not wasActive or m.occludersChanged or m.camera.movedLastFrame() or m.camera.projectionVersion <> m.occlusionMapProjectionVersion or m.maxOccluders <> m.occlusionMapMaxOccluders or m.occlusionMargin <> m.occlusionMapMargin
      if invalid = m.occlusionMap or width <> m.occlusionMapWidth or height <> m.occlusionMapHeight or m.occlusionBandCount <> m.occlusionMapBandCount
        m.occlusionMap = new BGE.OcclusionSpanMap(width, height, BGE.Math.Max(1, m.occlusionBandCount))
        m.occlusionMapWidth = width
        m.occlusionMapHeight = height
        m.occlusionMapBandCount = m.occlusionBandCount
        needsBuild = true
      end if
      ' every occluder is asked, so each one's change tracking stays current
      for each id in m.occluders
        occluder = m.occluders[id] as SceneObject
        if occluder.occluderChangedThisFrame(m)
          needsBuild = true
        end if
      end for

      if needsBuild
        buildStart = m.occlusionTimer.TotalMilliseconds()
        m.buildOcclusionMap()
        m.occlusionBuildMsLastFrame = m.occlusionTimer.TotalMilliseconds() - buildStart
      end if

      for each sceneObj in m.sceneObjects
        if m.isOcclusionCandidate(sceneObj)
          if sceneObj.occlusionMapVersion <> m.occlusionMapVersion or sceneObj.canvasShapeMayHaveChanged()
            sceneObj.occludedThisFrame = false
            sceneObj.occlusionTestBounds = invalid
            if m.mayBeHiddenByOccluders(sceneObj)
              m.occlusionTestsLastFrame++
              sceneObj.occludedThisFrame = m.isHiddenByOccluders(sceneObj)
            end if
            sceneObj.occlusionMapVersion = m.occlusionMapVersion
          end if
          if sceneObj.occludedThisFrame
            m.occludedCountLastFrame++
          end if
        else
          m.clearOcclusionVerdict(sceneObj)
        end if
      end for
    end sub

    private sub buildOcclusionMap()
      polygons = [] as BGE.OccluderPolygon[]
      for each id in m.occluders
        (m.occluders[id] as SceneObject).appendOccluderPolygons(m, polygons)
      end for
      if polygons.count() > m.maxOccluders
        polygons.SortBy("area", "r")
        largest = [] as BGE.OccluderPolygon[]
        for i = 0 to m.maxOccluders - 1
          largest.push(polygons[i])
        end for
        polygons = largest
      end if
      ' nearest first, so a far span inside a near one doesn't push its depth back
      polygons.SortBy("depth")
      m.occlusionMap.build(polygons)
      m.occlusionMapVersion++
      m.occlusionMapBuildCount++
      m.occludersChanged = false
      m.occlusionMapProjectionVersion = m.camera.projectionVersion
      m.occlusionMapMaxOccluders = m.maxOccluders
      m.occlusionMapMargin = m.occlusionMargin
    end sub

    ' Planes, skyboxes, parallax layers and particles never can be (canBeOccluded());
    ' occluders always draw. An object latched off camera stays off camera, so its cull
    ' latch isn't released.
    private function isOcclusionCandidate(sceneObj as SceneObject) as boolean
      ' cheapest checks first
      return sceneObj.negDistanceFromCamera < 0 and not sceneObj.isOccluder and sceneObj.distanceFadeAlpha > 0 and sceneObj.canBeOccluded() and not sceneObj.isCulled() and sceneObj.isEnabled()
    end function

    private sub clearOcclusionVerdict(sceneObj as SceneObject)
      sceneObj.occludedThisFrame = false
      sceneObj.occlusionMapVersion = -1
      sceneObj.occlusionTestBounds = invalid
    end sub

    ' A cheap first check by the object's depth position, which lies within what it draws:
    ' an object reaching nearer than every occluder, or whose position isn't covered by a
    ' nearer occluder, can't be hidden. Only rules objects out, so it never hides anything.
    private function mayBeHiddenByOccluders(sceneObj as SceneObject) as boolean
      depth = -sceneObj.negDistanceFromCamera
      if depth <= m.occlusionMap.getNearestDepth()
        return false
      end if
      projected = m.occlusionProjected
      m.occlusionDepthPoint[0] = sceneObj.getDepthPosition()
      if not (m.camera as Camera3d).projectPointsWithDepth(m.occlusionDepthPoint, projected)
        return false
      end if
      return m.occlusionMap.isPointCovered(projected[0], projected[1], depth)
    end function

    ' Whether every point the object could draw at is behind the occluders. Any point that
    ' doesn't project means it can't be judged, so it isn't hidden.
    private function isHiddenByOccluders(sceneObj as SceneObject) as boolean
      sceneObj.occlusionTestBounds = invalid
      points = sceneObj.getOcclusionTestPoints(m.camera)
      if invalid = points or points.count() = 0
        return false
      end if
      projected = m.occlusionProjected
      if not (m.camera as Camera3d).projectPointsWithDepth(points, projected)
        return false
      end if
      minX = projected[0]
      maxX = minX
      minY = projected[1]
      maxY = minY
      nearest = projected[2]
      for i = 3 to projected.count() - 1 step 3
        x = projected[i]
        y = projected[i + 1]
        depth = projected[i + 2]
        if x < minX
          minX = x
        else if x > maxX
          maxX = x
        end if
        if y < minY
          minY = y
        else if y > maxY
          maxY = y
        end if
        if depth < nearest
          nearest = depth
        end if
      end for
      margin = m.occlusionMargin
      ' an outline is stroked across the object's edge
      if sceneObj.drawable.hasOutline()
        margin += sceneObj.drawable.outlineWidth
      end if
      bounds = {minX: minX - margin, minY: minY - margin, maxX: maxX + margin, maxY: maxY + margin} as BGE.OcclusionTestBounds
      sceneObj.occlusionTestBounds = bounds
      return m.occlusionMap.isHidden(bounds.minX, bounds.minY, bounds.maxX, bounds.maxY, nearest)
    end function

    ' Draws every deferred multi-member-cluster object's primitives in one combined
    ' depth order, then calls afterDraw() once per object (matching the normal
    ' single-object draw path's bookkeeping). Called once per frame, at the end of
    ' render(), after every SceneObject.draw() call has either drawn directly or
    ' deferred here.
    '
    ' Deliberately one GLOBAL primitive list spanning every deferred cluster this
    ' frame, not one list scoped per cluster (the design spec's original description) -
    ' (a) it's simpler than sorting each cluster separately, (b) it's correct as long as
    ' every SceneObject's getPrimitiveDepth() shares one convention (negative in front of
    ' camera, ascending = farthest-first - see SceneObject.getPrimitiveDepth()'s doc
    ' comment), which is now guaranteed, and (c) cross-cluster ordering is harmless even
    ' though it's somewhat arbitrary: two different clusters are non-overlapping by
    ' definition (union-find only merges objects whose hulls actually overlap), so their
    ' relative draw order against each other was never meaningful to begin with.
    '
    ' Known limitation: this runs after both the plane loop and the main sorted loop in
    ' render(), which is correct for a genuinely solo object (anything overlapping a
    ' cluster is itself pulled into that cluster by union-find) but NOT for an object
    ' that's excluded from cluster candidacy entirely - SceneObjectLine/SceneObjectPlane/
    ' SceneObjectParallaxLayer (see participatesInOverlapDetection() and the degenerate
    ' <3-point-hull case in getPositionsForFrustumCheck()'s doc comment). Such an object
    ' can be nearer to the camera than a cluster while never joining it, and would then
    ' incorrectly draw underneath that cluster's members, since clusters are always
    ' deferred to the end of the frame. This is a real, disclosed gap in the current
    ' design (not a silent one) - a real fix would mean drawing each cluster at its
    ' farthest member's normal sorted position instead of always at the end, which is a
    ' larger architectural change deliberately left out of this fix round.

    ' Rebuilds the static geometry BSP tree from every currently-registered static
    ' SceneObject's world-space plane. Called lazily from render() only when
    ' needsStaticTreeRebuild is set (registration, removal, or a static object that
    ' moved - see SceneObject.update()'s misuse detection) - not every frame.
    private sub buildStaticGeometryTree()
      items = []
      for each sceneObj in m.sceneObjects
        if sceneObj.isStatic and sceneObj.isEnabled() and sceneObj.isReadyForStaticBspBuild(m.camera)
          worldPoints = sceneObj.getWorldPoints()
          items.push({
            sceneObj: sceneObj,
            planePoint: worldPoints.getCenter(),
            planeNormal: worldPoints.getNormal()
          })
        end if
      end for
      m.staticTree = BGE.BSP.buildTree(items)
      m.needsStaticTreeRebuild = false
    end sub

    ' The static+dynamic draw path used once any SceneObject has ever been marked static
    ' on this renderer (see hasStaticGeometry) - replaces the plain per-object sorted
    ' loop for every non-plane, non-skybox object. Static objects that define a BSP
    ' plane draw via the tree walk; every other enabled, in-front-of-camera object -
    ' genuinely dynamic objects, AND a static object that failed
    ' isReadyForStaticBspBuild() (e.g. a screen-aligned static billboard that can't
    ' define a plane - see that method's doc comment) - is threaded into that same walk
    ' as a dynamic item (see BGE.BSP.collectDrawOrder) instead of being drawn in a
    ' separate pass, so a dynamic object between two static quads' depths draws in the
    ' correct interleaved position, and a plane-ineligible static object still draws,
    ' classified against the tree's real planes every frame instead of vanishing.
    private sub drawStaticAndDynamicSceneObjects()
      if m.needsStaticTreeRebuild
        m.buildStaticGeometryTree()
      end if

      dynamicItems = []
      for each sceneObj in m.sceneObjects
        isDynamicItem = sceneObj.isEnabled() and not sceneObj.drawsInFixedStage() and (not sceneObj.isStatic or not sceneObj.isReadyForStaticBspBuild(m.camera))
        if isDynamicItem and sceneObj.negDistanceFromCamera >= 0
          sceneObj.markSkippedBehindCamera(m.camera)
        else if isDynamicItem
          dynamicItems.push({
            sceneObj: sceneObj,
            position: sceneObj.getDepthPosition(),
            ' The same stable, tie-break-aware key render()'s legacy sorted path
            ' uses (see the needsDepthSort block above) - not the raw
            ' negDistanceFromCamera float, which would reintroduce the frame-to-frame
            ' order flicker #59 fixed for near-tied depths landing in the same leaf.
            ' It's kept current here because Renderer.updateSceneObjects() sets
            ' needsDepthSort whenever any object's depth changes, and that block
            ' recomputes stableSortKey for every SceneObject (not just the ones that
            ' moved) - so a value from a stale (no-op) frame is still valid to compare.
            depthKey: sceneObj.stableSortKey
          })
        end if
      end for

      drawOrder = []
      BGE.BSP.collectDrawOrder(m.staticTree, m.camera.position, dynamicItems, drawOrder)
      for each sceneObj in drawOrder
        ' A static item's isEnabled() was already true when the (cached) tree was
        ' built, but may have changed since - the tree itself doesn't get rebuilt for
        ' every enable/disable toggle mid-frame-sequence the instant it happens (only
        ' on the next needsStaticTreeRebuild pass - see checkStaticEnabledStateChanged()),
        ' so this check (matching the legacy sorted path's own isEnabled() gate) is
        ' what keeps a disabled object from drawing out of a stale tree in the meantime.
        if sceneObj.isEnabled()
          m.drawSortedObject(sceneObj)
        end if
      end for
    end sub

    ' Draws one object of the sorted pass, unless the span map or the grid walls hide it. An
    ' object partly behind the walls draws, then the nearer wall strips are drawn over it.
    private sub drawSortedObject(sceneObj as SceneObject)
      if sceneObj.occludedThisFrame
        sceneObj.markSkippedOccluded(m.camera)
        return
      end if
      partialSpan = invalid
      ' unlike the span map, culled objects are tested too, so one turning into view behind a
      ' wall doesn't draw through it for a frame; markSkippedOccluded() releases the latch
      if invalid <> m.activeGridWalls and sceneObj.distanceFadeAlpha > 0
        walls = m.activeGridWalls as BGE.SceneObjectGridWalls
        ' only a type whose points bound what it draws may be skipped whole
        canSkip = sceneObj.canBeOccluded()
        if canSkip
          points = sceneObj.getOcclusionTestPoints(m.camera)
        else
          points = sceneObj.getBoundingPointsThisFrame(m.camera)
        end if
        span = m.wallSpan
        if invalid <> points
          view = walls.view
          if view.findSpan(points, span)
            limit = span.nearestDistance - view.hideTolerance
            anyHidden = false
            allHidden = true
            for i = span.firstRay to span.lastRay
              if view.getDepth(i) < limit
                anyHidden = true
              else
                allHidden = false
              end if
              if anyHidden and not allHidden
                exit for
              end if
            end for
            if allHidden and canSkip and not span.anyAboveWalls
              sceneObj.hiddenByWallsThisFrame = true
              sceneObj.markSkippedOccluded(m.camera)
              m.occludedCountLastFrame++
              return
            end if
            if anyHidden
              partialSpan = span
            end if
          end if
        end if
      end if
      if m.profileStages
        m.drawAndTime(sceneObj)
      else
        sceneObj.draw(m)
      end if
      if invalid <> partialSpan and sceneObj.didDrawLastFrame()
        if sceneObj.clusterMemberCount > 1
          ' copied, since the scratch span is reused by the next object
          m.pendingWallRedraws.push({valid: true, firstRay: partialSpan.firstRay, lastRay: partialSpan.lastRay, nearestDistance: partialSpan.nearestDistance})
        else
          m.redrawWallsOver(partialSpan)
        end if
      end if
    end sub

    ' Redraws the wall strips that hide part of the span (nearer than its nearest point by
    ' more than hideTolerance), one ray wider each side.
    private sub redrawWallsOver(span as BGE.GridWallsSpan)
      walls = m.activeGridWalls as BGE.SceneObjectGridWalls
      firstRay = span.firstRay - 1
      if firstRay < 0
        firstRay = 0
      end if
      lastRay = span.lastRay + 1
      if lastRay > walls.view.rayCount - 1
        lastRay = walls.view.rayCount - 1
      end if
      walls.redrawStrips(m, firstRay, lastRay, span.nearestDistance - walls.view.hideTolerance)
    end sub

    ' Draws one scene object, adding its time to its type's "draw<type>" stage.
    private sub drawAndTime(sceneObj as SceneObject)
      start = m.occlusionTimer.TotalMilliseconds()
      sceneObj.draw(m)
      m.addStageMs("draw" + sceneObj.type, m.occlusionTimer.TotalMilliseconds() - start)
    end sub

    ' Adds `ms` to a stage while profileStages is on - see getStageMsLastFrame(). For the
    ' engine's own profiling.
    '
    ' @param {string} name
    ' @param {integer} ms
    sub addStageMs(name as string, ms as integer)
      if invalid = m.stageMs[name]
        m.stageMs[name] = 0
        m.stageCounts[name] = 0
      end if
      m.stageMs[name] += ms
      m.stageCounts[name]++
    end sub

    ' Milliseconds each stage of the last render() took, by name, while profileStages is
    ' on: "update", "occlusion" (of which "occlusionBuild" rebuilt the span map), "sort"
    ' (overlap clusters and the depth sort), "skybox", "planes", "gridWalls", "objects" (everything else,
    ' including the static geometry walk), "clusters" and "finish", plus "draw<type>" for
    ' each SceneObjectType drawn (e.g. "drawModel", "drawBillboard") - those are part of
    ' "objects". Readings are whole milliseconds, so average them over many frames.
    '
    ' @return {roAssociativeArray} stage name to milliseconds
    ' A free-running millisecond clock for timing stages - see addStageMs().
    '
    ' @return {integer}
    function getProfileClockMs() as integer
      return m.occlusionTimer.TotalMilliseconds()
    end function

    function getStageMsLastFrame() as roAssociativeArray
      return m.stageMs
    end function

    ' How many times each stage in getStageMsLastFrame() ran last frame - for a
    ' "draw<type>" stage, how many objects of that type were drawn.
    '
    ' @return {roAssociativeArray} stage name to count
    function getStageCountsLastFrame() as roAssociativeArray
      return m.stageCounts
    end function

    ' Whether any static geometry has ever been registered on this renderer - true even
    ' if every static object has since been removed (see hasStaticGeometry's own doc
    ' comment). Exposed for tests/diagnostics, not meant for game logic.
    '
    ' @return {boolean}
    function hasStaticGeometryTree() as boolean
      return m.hasStaticGeometry
    end function

    ' A shallow copy of every currently-registered SceneObject - for diagnostics/tests
    ' (see Task 6's rendererTest benchmark) that need to enumerate them without a direct
    ' reference to the live internal array.
    '
    ' @return {BGE.SceneObject[]}
    function getSceneObjectsCopy() as BGE.SceneObject[]
      return m.sceneObjects.slice()
    end function

    private sub drawPendingClusterPrimitives()
      primitiveEntries = []
      for each sceneObj in m.pendingClusterDraws
        for i = 0 to sceneObj.getPrimitiveCount() - 1
          primitiveEntries.push({sceneObj: sceneObj, index: i, depth: sceneObj.getPrimitiveDepth(i)})
        end for
      end for
      primitiveEntries.SortBy("depth")
      for each entry in primitiveEntries
        entry.sceneObj.drawPrimitive(m, entry.index)
      end for
      for each sceneObj in m.pendingClusterDraws
        sceneObj.afterDraw()
      end for
      m.pendingClusterDraws = []
    end sub

    sub setupCameraForFrame()
      ' pushed every frame so a camera assigned directly (renderer.camera = cam) picks them up
      m.camera.drawDistanceScale = m.qualitySettings.drawDistanceScale
      m.camera.drawDistanceOverride = m.qualitySettings.drawDistanceOverride
      if not m.hasPlaneDrawDistanceRange
        m.camera.planeDrawDistanceScale = m.qualitySettings.drawDistanceScale
        m.camera.planeDrawDistanceOverride = m.qualitySettings.drawDistanceOverride
      else
        m.camera.planeDrawDistanceScale = m.planeDrawDistanceScale
        m.camera.planeDrawDistanceOverride = m.planeDrawDistanceOverride
      end if

      m.camera.setFrameSize(m.draw2d.getWidth(), m.draw2d.getHeight())
      m.camera.checkMovement()

      if m.camera.movedLastFrame() or invalid = m.camera.worldToCamera
        m.camera.computeWorldToCameraMatrix()
      end if
    end sub

    ' Draws one frame: updates every SceneObject, depth-sorts them, and draws them to
    ' this renderer's surface. `Game` calls this for you each frame; call it yourself
    ' only when using a Renderer without a Game.
    sub render()
      profile = m.profileStages
      if profile
        m.stageMs = {}
        m.stageCounts = {}
      end if
      ' a free-running timer, so both readings round down alike and averages stay unbiased
      lap = m.occlusionTimer.TotalMilliseconds()
      m.activeGridWalls = invalid
      m.quadColumns.beginFrame(m.qualitySettings)
      m.updateLighting()
      m.applyOccluderDrawPolicy()
      m.updateSceneObjects()
      occlusionStart = m.occlusionTimer.TotalMilliseconds()
      if profile
        m.addStageMs("update", occlusionStart - lap)
      end if
      m.updateOcclusion()
      lap = m.occlusionTimer.TotalMilliseconds()
      m.occlusionMsLastFrame = lap - occlusionStart
      if profile
        m.addStageMs("occlusion", m.occlusionMsLastFrame)
        m.addStageMs("occlusionBuild", m.occlusionBuildMsLastFrame)
      end if

      if m.computeOverlapClusters
        clusterResult = BGE.DepthSort.groupIntoClusters(m.getClusterCandidates(), m, m.lastClusterSortOrder)
        m.overlapClusters = clusterResult.clusters
        m.lastClusterSortOrder = clusterResult.sortedIds
        for each cluster in m.overlapClusters
          for each sceneObj in cluster
            sceneObj.clusterMemberCount = cluster.count()
          end for
        end for
      else if m.wasComputingOverlapClusters
        ' Only reset clusterMemberCount back to 1 on the transition frame (clustering
        ' was on last frame, off this frame) - every SceneObject defaults to 1 already
        ' (see SceneObject.clusterMemberCount's own field default), so if clustering has
        ' never been turned on this loop would otherwise run every single frame for
        ' nothing, which breaks the "zero perf change when clustering is off" claim.
        ' Running it on the transition frame (rather than skipping it entirely) is what
        ' keeps this correct: any object left with a stale count > 1 from the last
        ' clustered frame gets reset exactly once, here.
        for each sceneObj in m.sceneObjects
          sceneObj.clusterMemberCount = 1
        end for
      end if
      m.wasComputingOverlapClusters = m.computeOverlapClusters

      m.lastFrameDidSort = m.needsDepthSort
      if m.needsDepthSort
        ' A combined key: the quantized depth dominates, with the previous frame's
        ' sort position as the tie-breaker for anything that quantizes to the same
        ' bucket. This is bucket quantization, not a true epsilon-tolerance comparison -
        ' two depths that differ by far less than DEPTH_TIE_EPSILON but straddle a
        ' bucket boundary (Int() truncation) still land in different buckets and can
        ' still swap order; only depths that quantize into the *same* bucket are
        ' guaranteed to keep their previous relative order. The multiplier is scaled to
        ' the actual object count (rather than a fixed large constant) so lastSortIndex
        ' - which never reaches the object count - can never spill into the next depth
        ' bucket, while keeping the combined key's magnitude small enough that Float32
        ' precision doesn't silently round the tie-break term away at larger depth
        ' values.
        sortKeyMultiplier = m.sceneObjects.count() + 1
        for each sceneObj in m.sceneObjects
          quantizedDepth = Int(sceneObj.negDistanceFromCamera / DEPTH_TIE_EPSILON)
          sceneObj.stableSortKey = (quantizedDepth * sortKeyMultiplier) + sceneObj.getLastSortIndex()
        end for
        m.sceneObjects.sortBy("stableSortKey")
        for i = 0 to m.sceneObjects.count() - 1
          m.sceneObjects[i].setLastSortIndex(i)
        end for
        m.needsDepthSort = false
      end if
      lap = m.lapStage("sort", lap)

      for each sceneObj in m.sceneObjects
        if sceneObj.isEnabled() and sceneObj.type = SceneObjectType.Skybox
          sceneObj.draw(m)
        end if
      end for
      lap = m.lapStage("skybox", lap)

      'TODO - Do proper occlusion culling
      ' draw planes first

      m.pendingClusterDraws = []

      for each sceneObj in m.sceneObjects
        if sceneObj.isEnabled() and sceneObj.type = SceneObjectType.Plane
          ' A plane's negDistanceFromCamera is measured from its fixed anchor point, not
          ' from what's actually visible - gating draw() on it permanently blanked the
          ' plane once the camera passed the anchor. findCanvasPosition() already
          ' determines real visibility via frustum-ray/plane intersection, so no
          ' front-of-camera pre-filter is needed here.
          sceneObj.draw(m)
        end if
      end for
      lap = m.lapStage("planes", lap)

      walls = m.gridWallsObject
      if invalid <> walls and walls.isEnabled()
        walls.draw(m)
        if walls.didDrawLastFrame()
          m.activeGridWalls = walls
        end if
      end if
      lap = m.lapStage("gridWalls", lap)

      ' draw sceneObjects in sorted order - the static-geometry BSP walk (see
      ' drawStaticAndDynamicSceneObjects) once anything has ever been marked static on
      ' this renderer, otherwise exactly the plain per-object painter's sort from before
      ' this feature existed. hasStaticGeometry starting (and staying, once true) false
      ' for any renderer that never registers static geometry is what guarantees the
      ' zero-static case sees byte-identical draw order to before.
      if m.hasStaticGeometry
        m.drawStaticAndDynamicSceneObjects()
      else
        ' ignore any that are too far away (TBD) or behind camera
        for each sceneObj in m.sceneObjects
          if sceneObj.isEnabled() and not sceneObj.drawsInFixedStage()
            if sceneObj.negDistanceFromCamera >= 0
              sceneObj.markSkippedBehindCamera(m.camera)
            else
              m.drawSortedObject(sceneObj)
            end if
          end if
        end for
      end if
      lap = m.lapStage("objects", lap)

      m.drawPendingClusterPrimitives()
      if m.pendingWallRedraws.count() > 0
        for each span in m.pendingWallRedraws
          m.redrawWallsOver(span)
        end for
        m.pendingWallRedraws.clear()
      end if
      lap = m.lapStage("clusters", lap)

      if m.showOcclusionDebug
        m.drawOcclusionDebug()
      end if

      ' Every other path that draws into a bitmap and relies on reading it back
      ' afterward (a further draw, or SwapBuffers()) already forces completion via
      ' forceDraw() (see SceneObjectBillboard.createTempBitmap for the oriented temp-bitmap paths) -
      ' but render() itself never did, for the plain single-blit path every
      ' screen-aligned Image (matchCamera/directToCamera) actually uses. One
      ' .Finish() per frame here is cheap insurance against the same class of
      ' issue - see issue #211, where a baked tilemap chunk could silently fail to
      ' present on real hardware despite its content being provably correct.
      ' Not for a double-buffered roScreen though (the game canvas on a 720p device):
      ' there Finish() presents the frame early, before the UI is drawn, so the UI
      ' flickers (#151). Game's SwapBuffers() presents it anyway.
      if type(m.draw2d) <> "roScreen"
        m.draw2d.Finish()
      end if
      m.lapStage("finish", lap)
    end sub

    ' Records the time since `lap` as a stage while profileStages is on, and returns now.
    private function lapStage(name as string, lap as integer) as integer
      if not m.profileStages
        return lap
      end if
      now = m.occlusionTimer.TotalMilliseconds()
      m.addStageMs(name, now - lap)
      return now
    end function


    ' Draws the covered spans as translucent rectangles and each hidden object's tested box in red.
    private sub drawOcclusionDebug()
      ' the map is left as it was when occlusion stopped running
      if m.occlusionWasActive and m.occlusionMap <> invalid
        bandHeight = m.occlusionMap.getBandHeight()
        for band = 0 to m.occlusionMap.getBandCount() - 1
          spans = m.occlusionMap.getBandSpans(band)
          for i = 0 to spans.count() - 3 step 3
            m.drawRectangle(spans[i], band * bandHeight, spans[i + 1] - spans[i], bandHeight, &h3060C080)
          end for
        end for
      end if
      for each sceneObj in m.sceneObjects
        bounds = sceneObj.occlusionTestBounds
        if sceneObj.occludedThisFrame and bounds <> invalid
          m.drawLine(bounds.minX, bounds.minY, bounds.maxX, bounds.minY, BGE.Colors.Red)
          m.drawLine(bounds.maxX, bounds.minY, bounds.maxX, bounds.maxY, BGE.Colors.Red)
          m.drawLine(bounds.maxX, bounds.maxY, bounds.minX, bounds.maxY, BGE.Colors.Red)
          m.drawLine(bounds.minX, bounds.maxY, bounds.minX, bounds.minY, BGE.Colors.Red)
        else if sceneObj.hiddenByWallsThisFrame
          m.drawWallHiddenDebugBox(sceneObj)
        end if
      end for
    end sub

    ' Outlines the canvas box of a wall-hidden object's test points, as drawOcclusionDebug()
    ' does for the span map's.
    private sub drawWallHiddenDebugBox(sceneObj as SceneObject)
      projected = m.occlusionProjected
      if not (m.camera as Camera3d).projectPointsWithDepth(sceneObj.getOcclusionTestPoints(m.camera), projected)
        return
      end if
      minX = projected[0]
      maxX = minX
      minY = projected[1]
      maxY = minY
      for i = 3 to projected.count() - 1 step 3
        minX = BGE.Math.Min(minX, projected[i])
        maxX = BGE.Math.Max(maxX, projected[i])
        minY = BGE.Math.Min(minY, projected[i + 1])
        maxY = BGE.Math.Max(maxY, projected[i + 1])
      end for
      m.drawLine(minX, minY, maxX, minY, BGE.Colors.Red)
      m.drawLine(maxX, minY, maxX, maxY, BGE.Colors.Red)
      m.drawLine(maxX, maxY, minX, maxY, BGE.Colors.Red)
      m.drawLine(minX, maxY, minX, minY, BGE.Colors.Red)
    end sub


    ' Call once per frame, after the screen is swapped (Game does this). Scratch bitmaps used
    ' this frame are only reused after it, so a Renderer used without a Game must call it too.
    sub onSwapBuffers()
      m.bmpPool.onFrameEnd()
      m.frameCount++
      if m.frameCount = 30
        m.statsString = `[${m.name}] Draw Calls: ${m.drawCallsLastFrame} | Scene Objects: ${m.sceneObjects.count()}`
        m.frameCount = 0
      end if

    end sub

    function worldPointToCanvasPoint(pWorld as BGE.Math.Vector) as BGE.Math.Vector
      return m.camera.worldPointToCanvasPoint(pWorld)
    end function

    function getRayFromCameraToWorldPoint(pWorld as BGE.Math.Vector) as BGE.Math.Vector
      return BGE.Math.VectorOps.subtract(pWorld, m.camera.position)
    end function

    function drawLine(x as float, y as float, endX as float, endY as float, rgba as integer) as boolean
      return m.drawLineTo(m.draw2d, x, y, endX, endY, rgba)
    end function

    ' Draws lines joining world-space points, e.g. a path or a zone on the ground in a debug
    ' overlay. A segment is skipped when either end can't be projected (behind a Camera3d) or
    ' is behind the grid walls.
    '
    ' @param {BGE.Math.Vector[]} points - world space
    ' @param {integer} rgba
    ' @param {boolean} [closed=false] - also join the last point back to the first
    ' @return {boolean} true if every segment was drawn
    function drawWorldPolyline(points as BGE.Math.Vector[], rgba as integer, closed = false as boolean) as boolean
      allDrawn = true
      count = points.Count()
      if count < 2
        return false
      end if
      lastIndex = count - 1
      if closed
        lastIndex = count
      end if
      previous = m.overlayCanvasPoint(points[0])
      first = previous
      for i = 1 to lastIndex
        if i < count
          current = m.overlayCanvasPoint(points[i])
        else
          current = first
        end if
        if invalid <> previous and invalid <> current
          allDrawn = m.drawLine(previous.x, previous.y, current.x, current.y, rgba) and allDrawn
        else
          allDrawn = false
        end if
        previous = current
      end for
      return allDrawn
    end function

    ' Draws a flat ring on the ground plane (XZ) through `center`, at center's height.
    '
    ' @param {BGE.Math.Vector} center - world space
    ' @param {float} radius - world units
    ' @param {integer} rgba
    ' @param {integer} [segments=24]
    ' @return {boolean} true if every segment was drawn
    function drawWorldCircle(center as BGE.Math.Vector, radius as float, rgba as integer, segments = 24 as integer) as boolean
      return m.drawWorldPolyline(m.worldArcPoints(center, radius, 0, 2 * BGE.Math.PI, segments, false), rgba)
    end function

    ' Draws an arc on the ground plane (XZ) round `center`, from one heading to another (see
    ' BGE.Math.headingForward() for the convention), e.g. a melee attack's reach.
    '
    ' @param {BGE.Math.Vector} center - world space
    ' @param {float} radius - world units
    ' @param {float} fromHeading - radians
    ' @param {float} toHeading - radians
    ' @param {integer} rgba
    ' @param {boolean} [wedge=false] - also draw both edges back to the centre, like a pie slice
    ' @param {integer} [segments=16]
    ' @return {boolean} true if every segment was drawn
    function drawWorldArc(center as BGE.Math.Vector, radius as float, fromHeading as float, toHeading as float, rgba as integer, wedge = false as boolean, segments = 16 as integer) as boolean
      return m.drawWorldPolyline(m.worldArcPoints(center, radius, fromHeading, toHeading, segments, wedge), rgba)
    end function

    ' Draws a screen-aligned bar (e.g. a health bar) at a world point, centred on it
    ' horizontally with its bottom edge on it, so a point at the top of an entity's head puts
    ' the bar just above. Its size is in canvas pixels, whatever the distance. The fill is
    ' inset by `border` pixels, leaving a frame in backColor. Skipped when the point is behind
    ' a Camera3d or the grid walls.
    '
    ' @param {BGE.Math.Vector} worldPoint - world space
    ' @param {float} width - canvas pixels, including the border
    ' @param {float} height - canvas pixels, including the border
    ' @param {float} fraction - how full, clamped to 0..1
    ' @param {integer} fillColor - rgba
    ' @param {integer} backColor - rgba, behind the fill and as the border
    ' @param {integer} [border=1] - pixels between the edge and the fill
    ' @return {boolean} true if the bar was drawn
    function drawWorldBar(worldPoint as BGE.Math.Vector, width as float, height as float, fraction as float, fillColor as integer, backColor as integer, border = 1 as integer) as boolean
      anchor = m.overlayCanvasPoint(worldPoint)
      if invalid = anchor
        return false
      end if
      left = anchor.x - width / 2
      top = anchor.y - height
      if not m.drawRectangle(left, top, width, height, backColor)
        return false
      end if
      fraction = BGE.Math.Clamp(fraction, 0, 1)
      innerWidth = (width - 2 * border) * fraction
      innerHeight = height - 2 * border
      if innerWidth > 0 and innerHeight > 0
        m.drawRectangle(left + border, top + border, innerWidth, innerHeight, fillColor)
      end if
      return true
    end function

    ' The canvas point for an in-world overlay, or invalid if it can't be projected or is
    ' hidden behind the grid walls.
    private function overlayCanvasPoint(worldPoint as BGE.Math.Vector) as dynamic
      if m.isBehindGridWalls(worldPoint)
        return invalid
      end if
      return m.worldPointToCanvasPoint(worldPoint)
    end function

    private function worldArcPoints(center as BGE.Math.Vector, radius as float, fromHeading as float, toHeading as float, segments as integer, wedge as boolean) as BGE.Math.Vector[]
      points = []
      if wedge
        points.push(center)
      end if
      segments = BGE.Math.Max(1, segments)
      for i = 0 to segments
        offset = BGE.Math.headingForward(fromHeading + (toHeading - fromHeading) * i / segments)
        points.push(BGE.Math.VectorOps.create(center.x + offset.x * radius, center.y, center.z + offset.z * radius))
      end for
      if wedge
        points.push(center)
      end if
      return points
    end function

    function drawLineTo(draw2d as ifDraw2d, x as float, y as float, endX as float, endY as float, rgba as integer) as boolean
      width = abs(x - endX) + 1
      height = abs(y - endY) + 1
      if not m.shouldDrawTo(draw2d, x, y, width, height)
        return false
      end if
      draw2d.DrawLine(x, y, endX, endY, rgba)
      m.drawCallsLastFrame++
      return true
    end function


    function drawSquare(x as float, y as float, sideLength as float, rgba as integer) as boolean
      return m.drawSquareTo(m.draw2d, x, y, sideLength, rgba)
    end function

    function drawSquareTo(draw2d as ifDraw2d, x as float, y as float, sideLength as float, rgba as integer) as boolean
      if not m.shouldDrawTo(draw2d, x - sideLength / 2, y - sideLength / 2, sideLength, sideLength)
        return false
      end if
      draw2d.DrawPoint(x, y, sideLength, rgba)
      m.drawCallsLastFrame++
      return true
    end function

    function drawRectangle(x as float, y as float, width as float, height as float, rgba as integer) as boolean
      return m.drawRectangleTo(m.draw2d, x, y, width, height, rgba)
    end function

    function drawRectangleTo(draw2d as ifDraw2d, x as float, y as float, width as float, height as float, rgba as integer) as boolean
      if not m.shouldDrawTo(draw2d, x, y, width, height)
        return false
      end if
      draw2d.DrawRect(x, y, width, height, rgba)
      m.drawCallsLastFrame++
      return true
    end function


    ' Draws a filled circle, centered at (x, y). There is no native filled-circle draw
    ' call, so this scales the renderer's own pre-rasterized circle resource
    ' (see getCircleResource()) rather than rasterizing a polygon fresh every call, the
    ' same way drawRectangle draws a native DrawRect instead of rasterizing a quad.
    '
    ' @param {float} x center x
    ' @param {float} y center y
    ' @param {float} radius
    ' @param {integer} rgba fill color to tint the circle resource with
    ' @return {boolean} true if anything was drawn
    function drawCircle(x as float, y as float, radius as float, rgba as integer) as boolean
      return m.drawCircleTo(m.draw2d, x, y, radius, rgba)
    end function

    function drawCircleTo(draw2d as ifDraw2d, x as float, y as float, radius as float, rgba as integer) as boolean
      circleBitmap = m.getCircleResource()
      if invalid = circleBitmap
        return false
      end if
      scale = (radius * 2) / RendererResourceSize
      return m.drawScaledObjectTo(draw2d, x - radius, y - radius, scale, scale, circleBitmap, rgba)
    end function

    ' Exposes the underlying draw surface to a helper that needs to draw without
    ' going through a Renderer.draw* call (e.g. BGE.QrCode.draw()) - see that
    ' function's own doc comment for why it takes a Renderer instead of Renderer
    ' exposing a drawQRCode() of its own.
    '
    ' @return {ifDraw2d}
    function getDraw2d() as ifDraw2d
      return m.draw2d
    end function

    ' Lets an external helper that draws directly to getDraw2d() (bypassing every
    ' normal Renderer.draw* call) still contribute to the same per-frame draw-call
    ' count as everything else - see getDraw2d()'s doc comment.
    '
    ' @param {integer} [count=1]
    sub incrementDrawCalls(count = 1 as integer)
      m.drawCallsLastFrame += count
    end sub


    ' The renderer's four cached quadrant roRegions of getCircleResource(), one per
    ' rounded corner - built lazily on first use and cached in resources.circleQuadrants
    ' exactly like getCircleRegionWithId(), so drawRoundedRectangle doesn't re-run
    ' CreateObject("roRegion", ...) on every single call.
    '
    ' @return {object} an associative array with topLeft/topRight/bottomLeft/bottomRight
    '   roRegion keys, or invalid if the circle resource couldn't be created
    function getCircleQuadrantRegions() as dynamic
      if invalid = m.resources.circleQuadrants
        circleBitmap = m.getCircleResource()
        if invalid = circleBitmap
          return invalid
        end if
        half = RendererResourceSize / 2
        m.resources.circleQuadrants = {
          topLeft: CreateObject("roRegion", circleBitmap, 0, 0, half, half),
          topRight: CreateObject("roRegion", circleBitmap, half, 0, half, half),
          bottomLeft: CreateObject("roRegion", circleBitmap, 0, half, half, half),
          bottomRight: CreateObject("roRegion", circleBitmap, half, half, half, half)
        }
      end if
      return m.resources.circleQuadrants
    end function


    ' Draws a filled rectangle with rounded corners, top-left anchored at (x, y). The four
    ' corners are quadrant sections of the renderer's shared circle resource (see
    ' getCircleResource()/getCircleQuadrantRegions()) scaled to `radius`, composited with
    ' native DrawRect calls for the straight edges/fill - the same "reuse the pre-rasterized
    ' circle instead of rasterizing fresh" approach drawCircle takes.
    '
    ' @param {float} x top-left x
    ' @param {float} y top-left y
    ' @param {float} width
    ' @param {float} height
    ' @param {float} radius corner radius - clamped to at most half of width/height, so an
    '   oversized radius degrades to a "stadium"/circle shape rather than drawing garbage
    ' @param {integer} rgba fill color (also tints the corner regions, matching drawCircle)
    ' @return {boolean} true if anything was drawn
    function drawRoundedRectangle(x as float, y as float, width as float, height as float, radius as float, rgba as integer) as boolean
      return m.drawRoundedRectangleTo(m.draw2d, x, y, width, height, radius, rgba)
    end function

    function drawRoundedRectangleTo(draw2d as ifDraw2d, x as float, y as float, width as float, height as float, radius as float, rgba as integer) as boolean
      if not m.shouldDrawTo(draw2d, x, y, width, height)
        return false
      end if

      clampedRadius = BGE.Math.Max(0, BGE.Math.Min(radius, BGE.Math.Min(width, height) / 2))
      if clampedRadius <= 0
        return m.drawRectangleTo(draw2d, x, y, width, height, rgba)
      end if

      quadrants = m.getCircleQuadrantRegions()
      if invalid = quadrants
        return m.drawRectangleTo(draw2d, x, y, width, height, rgba)
      end if

      ' Straight-edge fill: a full-width middle band plus top/bottom bands spanning only
      ' the gap between each pair of rounded corners - the corner squares themselves are
      ' left untouched here, for the quadrant regions below to fill instead.
      draw2d.DrawRect(x, y + clampedRadius, width, height - (clampedRadius * 2), rgba)
      draw2d.DrawRect(x + clampedRadius, y, width - (clampedRadius * 2), clampedRadius, rgba)
      draw2d.DrawRect(x + clampedRadius, y + height - clampedRadius, width - (clampedRadius * 2), clampedRadius, rgba)
      m.drawCallsLastFrame += 3

      scale = (clampedRadius * 2) / RendererResourceSize
      worked = true
      worked = m.drawScaledObjectTo(draw2d, x, y, scale, scale, quadrants.topLeft, rgba) and worked
      worked = m.drawScaledObjectTo(draw2d, x + width - clampedRadius, y, scale, scale, quadrants.topRight, rgba) and worked
      worked = m.drawScaledObjectTo(draw2d, x, y + height - clampedRadius, scale, scale, quadrants.bottomLeft, rgba) and worked
      worked = m.drawScaledObjectTo(draw2d, x + width - clampedRadius, y + height - clampedRadius, scale, scale, quadrants.bottomRight, rgba) and worked
      return worked
    end function

    ' Draws text to the screen
    '
    ' @param {string} text the test to display
    ' @param {integer} x
    ' @param {integer} y
    ' @param {integer} [color=-1] RGBA color to use
    ' @param {roFont} [font=invalid] Font object to use (uses default font if none provided)
    ' @param {string} [horizAlign="left"] Horizontal Alignment - "left", "right" or "center"
    ' @param {string} [vertAlign="left"] Vertical Alignment - "top", "bottom" or "center"
    function drawText(text as string, x as integer, y as integer, color = -1 as integer, font = invalid as roFont, horizAlign = "left" as string, vertAlign = "top" as string) as boolean
      return m.drawTextTo(m.draw2d, text, x, y, color, font, horizAlign, vertAlign)
    end function


    ' Draws text to a canvas
    '
    ' @param {string} text the test to display
    ' @param {integer} x
    ' @param {integer} y
    ' @param {integer} [color=-1] RGBA color to use
    ' @param {roFont} [font=invalid] Font object to use (uses default font if none provided)
    ' @param {string} [horizAlign="left"] Horizontal Alignment - "left", "right" or "center"
    ' @param {string} [vertAlign="left"] Vertical Alignment - "top", "bottom" or "center"
    ' @param {integer} [lineSpace=0] Additional space between lines
    function drawTextTo(draw2d as ifDraw2d, text as string, x as integer, y as integer, color = -1 as integer, font = invalid as roFont, horizAlign = "left" as string, vertAlign = "top" as string, lineSpace = 0 as integer) as boolean
      if font = invalid
        font = m.getFont("default")
      end if

      textLines = text.split(Chr(10))
      worked = true
      for each textLine in textLines
        width = font.GetOneLineWidth(textLine, BGE.TEXT_MAX_LINE_SIZE)
        height = font.GetOneLineHeight()
        textX = x
        textY = y

        if horizAlign = "right"
          textX = x - width
        else if horizAlign = "center"
          textX = x - width / 2
        end if

        if vertAlign = "bottom"
          textY = y - height
        else if vertAlign = "center"
          textY = y - height / 2
        end if
        if m.shouldDrawTo(draw2d, textX, textY, width, height)
          draw2d.DrawText(textLine, textX, textY, color, font)
          m.drawCallsLastFrame++
          worked = worked and true
        end if
        y = y + font.GetOneLineHeight() + lineSpace
      end for
      return worked
    end function

    ' Draws a region to the canvas at the given scale, rotation and position.
    function drawTransformedObject(x as float, y as float, scaleX as float, scaleY as float, theta as float, region as ifDraw2d, rgba = -1 as integer) as boolean
      return m.drawTransformedObjectTo(m.draw2d, x, y, scaleX, scaleY, theta, region, rgba)
    end function

    function drawTransformedObjectTo(draw2d as ifDraw2d, x as float, y as float, scale_x as float, scale_y as float, theta as float, region as ifDraw2d, rgba = -1 as integer) as boolean
      thetaDeg = BGE.Math.RadiansToDegrees(theta)
      result = draw2d.DrawTransformedObject(x, y, thetaDeg, scale_x, scale_y, region, rgba)
      m.drawCallsLastFrame++
      return result
    end function


    ' Convenience wrapper for drawRotatedImageWithCenterTo that draws to this renderer's own canvas.
    '
    ' @param {ifDraw2d} srcRegion the source region to draw from
    ' @param {BGE.Math.Vector} srcRotationPoint the position in srcRegion to rotate about, relative to the region's pretranslation
    ' @param {float} theta the angle to rotate by (in radians)
    ' @param {BGE.Math.Vector} [translation=BGE.Math.VectorOps.create()] the translation to apply after rotation
    ' @param {BGE.Math.Vector} [drawScale=BGE.Math.createScaleVector(1)] the scale to apply when drawing
    ' @return {boolean} true if the drawing succeeded
    function drawRotatedImageWithCenter(srcRegion as ifDraw2d, srcRotationPoint as BGE.Math.Vector, theta as float, translation = BGE.Math.VectorOps.create() as BGE.Math.Vector, drawScale = BGE.Math.createScaleVector(1) as BGE.Math.Vector) as boolean
      return m.drawRotatedImageWithCenterTo(m.draw2d, srcRegion, srcRotationPoint, theta, translation, drawScale)
    end function


    ' Rotates a region about a point, and draws it to a given draw2d surface with a given scale and translation.
    '
    ' @param {ifDraw2d} draw2d the final destination for the drawing
    ' @param {ifDraw2d} srcRegion the source region to draw from
    ' @param {BGE.Math.Vector} srcRotationPoint the position in srcRegion to rotate about, relative to the region's pretranslation
    ' @param {float} theta the angle to rotate by (in radians)
    ' @param {BGE.Math.Vector} [translation=BGE.Math.VectorOps.create()] the translation to apply after rotation
    ' @param {BGE.Math.Vector} [drawScale=BGE.Math.createScaleVector(1)] the scale to apply when drawing
    ' @return {boolean} true if the drawing succeeded
    function drawRotatedImageWithCenterTo(draw2d as ifDraw2d, srcRegion as ifDraw2d, srcRotationPoint as BGE.Math.Vector, theta as float, translation = BGE.Math.VectorOps.create() as BGE.Math.Vector, drawScale = BGE.Math.createScaleVector(1) as BGE.Math.Vector) as boolean
      distanceToCenter = BGE.Math.VectorOps.length(srcRotationPoint)
      angleToCenter = BGE.Math.GetAngle(BGE.Math.VectorOps.create(), srcRotationPoint)
      centerRotationAngle = theta - angleToCenter
      rotatedCenter = BGE.Math.VectorOps.create(distanceToCenter * cos(centerRotationAngle), -distanceToCenter * sin(centerRotationAngle))
      finalTranslation = BGE.Math.VectorOps.add(translation, BGE.Math.VectorOps.subtract(srcRotationPoint, rotatedCenter))

      if drawScale.x = 1 and drawScale.y = 1
        return m.drawRotatedObjectTo(draw2d, finalTranslation.x, finalTranslation.y, theta, srcRegion)
      end if
      return m.drawTransformedObjectTo(draw2d, finalTranslation.x, finalTranslation.y, drawScale.x, drawScale.y, theta, srcRegion)
    end function

    ' The column texture for `texture`, cut once and cached by its id (an empty id isn't
    ' cached). The id must name the pixels: a cached one is only rechecked for its region's
    ' place and size.
    '
    ' @param {BGE.RendererHelpers.RegionWithId} texture
    ' @return {BGE.QuadColumnTexture}
    function getQuadColumnTexture(texture as BGE.RendererHelpers.RegionWithId) as BGE.QuadColumnTexture
      id = texture.id
      region = texture.region
      if id <> ""
        cached = m.quadColumnTextures[id] as BGE.QuadColumnTexture
        if invalid <> cached and cached.hasRect(region)
          return cached
        end if
      end if
      columnTexture = new BGE.QuadColumnTexture(region, id)
      if id <> ""
        ' ids like a text's change with its content, so don't let stale ones pile up
        if m.quadColumnTextureCount >= m.maxQuadColumnTextures
          m.clearQuadColumnTextures()
        end if
        if not m.quadColumnTextures.DoesExist(id)
          m.quadColumnTextureCount++
        end if
        m.quadColumnTextures[id] = columnTexture
      end if
      return columnTexture
    end function

    ' Forgets every cached column texture, releasing their bitmaps.
    sub clearQuadColumnTextures()
      m.quadColumnTextures = {}
      m.quadColumnTextureCount = 0
    end sub

    ' Draws a texture onto a world-space quad as projected texture columns (perspective
    ' correct, no scratch bitmaps), with as many columns as render quality allows. Needs a
    ' Camera3d.
    '
    ' @param {ifDraw2D} target an roBitmap or roScreen
    ' @param {BGE.Math.Vector[]} corners the texture's top-left, top-right, bottom-left and bottom-right in world space
    ' @param {BGE.RendererHelpers.RegionWithId} texture
    ' @param {integer[]} colors one RGBA tint, or one per corner (blended across the quad)
    ' @return {integer} columns drawn
    function drawTexturedQuadTo(target as ifDraw2D, corners as BGE.Math.Vector[], texture as BGE.RendererHelpers.RegionWithId, colors = [-1] as integer[]) as integer
      return m.drawColumnTextureTo(target, corners, m.getQuadColumnTexture(texture), colors)
    end function

    ' drawTexturedQuadTo() with an already cut column texture.
    '
    ' @param {ifDraw2D} target an roBitmap or roScreen
    ' @param {BGE.Math.Vector[]} corners the texture's top-left, top-right, bottom-left and bottom-right in world space
    ' @param {BGE.QuadColumnTexture} columnTexture
    ' @param {integer[]} colors one RGBA tint, or one per corner
    ' @param {BGE.Math.Vector} [targetOrigin=invalid] for a target smaller than the canvas: where
    '   its (0,0) sits on the canvas
    ' @return {integer} columns drawn
    function drawColumnTextureTo(target as ifDraw2D, corners as BGE.Math.Vector[], columnTexture as BGE.QuadColumnTexture, colors = [-1] as integer[], targetOrigin = invalid as BGE.Math.Vector) as integer
      cameraCorners = m.prepareColumnProjection(target, corners, targetOrigin)
      if invalid = cameraCorners
        return 0
      end if
      drawn = m.quadColumns.drawTo(target, cameraCorners, columnTexture, colors)
      m.drawCallsLastFrame += drawn
      return drawn
    end function

    ' Draws a textured triangle (a model face) as texture strips cut to it, perspective
    ' correct, with no scratch bitmaps. Needs a Camera3d.
    '
    ' @param {ifDraw2D} target an roBitmap or roScreen
    ' @param {BGE.Math.Vector[]} vertices the triangle's 3 world-space vertices, in the order of the texture points `cuts` was made from
    ' @param {BGE.TriangleColumnCuts} cuts
    ' @param {integer} rgba tint
    ' @param {BGE.Math.Vector} [targetOrigin=invalid] for a target smaller than the canvas: where
    '   its (0,0) sits on the canvas
    ' @return {integer} strips drawn, or -1 if it can't be drawn this way (see QuadColumnDrawer.drawTriangleTo())
    function drawTriangleColumnsTo(target as ifDraw2D, vertices as BGE.Math.Vector[], cuts as BGE.TriangleColumnCuts, rgba = -1 as integer, targetOrigin = invalid as BGE.Math.Vector) as integer
      cameraVertices = m.prepareColumnProjection(target, vertices, targetOrigin)
      if invalid = cameraVertices
        return -1
      end if
      drawn = m.quadColumns.drawTriangleTo(target, cameraVertices, cuts, rgba)
      if drawn > 0
        m.drawCallsLastFrame += drawn
      end if
      return drawn
    end function

    ' drawTriangleColumnsTo() on this renderer's canvas.
    '
    ' @param {BGE.Math.Vector[]} vertices the triangle's 3 world-space vertices
    ' @param {BGE.TriangleColumnCuts} cuts
    ' @param {integer} rgba tint
    ' @return {integer} strips drawn, or -1 if it can't be drawn this way
    function drawTriangleColumns(vertices as BGE.Math.Vector[], cuts as BGE.TriangleColumnCuts, rgba = -1 as integer) as integer
      return m.drawTriangleColumnsTo(m.draw2d, vertices, cuts, rgba)
    end function

    ' Sets the column drawer's projection for `target`, and returns `points` in camera space
    ' (x, y, z each). A Camera2d's camera space is its orthographic clip space.
    private function prepareColumnProjection(target as ifDraw2D, points as BGE.Math.Vector[], targetOrigin as BGE.Math.Vector) as float[]
      camera = m.camera
      if invalid = camera.worldToCamera
        camera.computeWorldToCameraMatrix()
      end if
      mat = camera.worldToCamera
      m0 = mat[0]
      m1 = mat[1]
      m2 = mat[2]
      m3 = mat[3]
      cameraPoints = [] as float[]
      for each point in points
        w = point.x * m0[3] + point.y * m1[3] + point.z * m2[3] + m3[3]
        cameraPoints.push((point.x * m0[0] + point.y * m1[0] + point.z * m2[0] + m3[0]) / w)
        cameraPoints.push((point.x * m0[1] + point.y * m1[1] + point.z * m2[1] + m3[1]) / w)
        cameraPoints.push((point.x * m0[2] + point.y * m1[2] + point.z * m2[2] + m3[2]) / w)
      end for
      width = camera.frameSize.x
      height = camera.frameSize.y
      if invalid <> targetOrigin
        targetBitmap = target as roBitmap
        width = targetBitmap.GetWidth()
        height = targetBitmap.GetHeight()
      end if
      if camera.isPerspective()
        m.quadColumns.setProjection((camera as BGE.Camera3d).getFocalLength(), width, height)
      else
        ' clip space -1..1 spans the frame
        m.quadColumns.setOrthographicProjection(camera.frameSize.x * 0.5, camera.frameSize.y * 0.5, width, height)
      end if
      if invalid <> targetOrigin
        m.quadColumns.setProjectionCenter(camera.frameSize.x * 0.5 - targetOrigin.x, camera.frameSize.y * 0.5 - targetOrigin.y)
      end if
      return cameraPoints
    end function

    ' Draws a column texture onto a world-space quad on this renderer's canvas (see drawTexturedQuadTo()).
    '
    ' @param {BGE.Math.Vector[]} corners the texture's top-left, top-right, bottom-left and bottom-right in world space
    ' @param {BGE.QuadColumnTexture} columnTexture
    ' @param {integer[]} colors one RGBA tint, or one per corner
    ' @return {integer} columns drawn
    function drawColumnTexture(corners as BGE.Math.Vector[], columnTexture as BGE.QuadColumnTexture, colors = [-1] as integer[]) as integer
      return m.drawColumnTextureTo(m.draw2d, corners, columnTexture, colors)
    end function

    ' A shared white texture, tinted to fill solid quads as columns.
    '
    ' @return {BGE.QuadColumnTexture}
    function getWhiteColumnTexture() as BGE.QuadColumnTexture
      if invalid = m.resources.whiteColumnTexture
        ' wide enough that render quality, not the texture, sets a big quad's column count
        size = 256
        bitmap = CreateObject("roBitmap", {width: size, height: size, alphaEnable: true})
        bitmap.Clear(BGE.Colors.White)
        m.resources.whiteColumnTexture = new BGE.QuadColumnTexture(CreateObject("roRegion", bitmap, 0, 0, size, size), "__bge_white")
      end if
      return m.resources.whiteColumnTexture
    end function



    function drawCircleOutline(line_count as integer, x as float, y as float, radius as float, rgba as integer) as boolean
      if not m.shouldDraw(x - radius, y - radius, radius * 2, radius * 2)
        return false
      end if

      previous_x = radius
      previous_y = 0
      for i = 0 to line_count
        degrees = 360 * (i / line_count)
        current_x = cos(degrees * .01745329) * radius
        current_y = sin(degrees * .01745329) * radius

        m.draw2d.DrawLine(x + previous_x, y + previous_y, x + current_x, y + current_y, rgba)
        m.drawCallsLastFrame++

        previous_x = current_x
        previous_y = current_y
      end for
      return true
    end function


    ' Draws the outline of an axis-aligned rectangle
    '
    ' @param {float} x left edge
    ' @param {float} y top edge
    ' @param {float} width
    ' @param {float} height
    ' @param {integer} rgba color to stroke with
    ' @param {integer} [lineWidth=1] stroke thickness in pixels, drawn inwards from the given bounds
    ' @return {boolean} true if anything was drawn
    function drawRectangleOutline(x as float, y as float, width as float, height as float, rgba as integer, lineWidth = 1 as integer) as boolean
      return m.drawRectangleOutlineTo(m.draw2d, x, y, width, height, rgba, lineWidth)
    end function


    ' Draws the outline of an axis-aligned rectangle to the given surface
    '
    ' @param {ifDraw2d} draw2d surface to draw to
    ' @param {float} x left edge
    ' @param {float} y top edge
    ' @param {float} width
    ' @param {float} height
    ' @param {integer} rgba color to stroke with
    ' @param {integer} [lineWidth=1] stroke thickness in pixels, drawn inwards from the given bounds
    ' @return {boolean} true if anything was drawn
    function drawRectangleOutlineTo(draw2d as ifDraw2d, x as float, y as float, width as float, height as float, rgba as integer, lineWidth = 1 as integer) as boolean
      if invalid = draw2d or not m.shouldDrawTo(draw2d, x, y, width, height)
        return false
      end if

      ' Roku's DrawLine is always a single pixel wide, so a thicker stroke is
      ' drawn as nested 1px outlines working inwards from the given bounds.
      for inset = 0 to lineWidth - 1
        left = x + inset
        top = y + inset
        right = x + width - inset
        bottom = y + height - inset
        if right < left or bottom < top
          exit for
        end if
        draw2d.DrawLine(left, top, right, top, rgba)
        draw2d.DrawLine(left, top, left, bottom, rgba)
        draw2d.DrawLine(right, top, right, bottom, rgba)
        draw2d.DrawLine(left, bottom, right, bottom, rgba)
        m.drawCallsLastFrame += 4
      end for
      return true
    end function


    ' Draws the outline of a polygon, connecting each point to the next and the last back to the first
    '
    ' @param {BGE.Math.Vector[]} pointsArray points in outline (perimeter) order, not bounds order
    ' @param {integer} colorRgba color to stroke with
    ' @param {integer} [lineWidth=1] stroke thickness in pixels - approximated by nested outlines shrunk towards the polygon's center
    ' @return {boolean} true if anything was drawn
    function drawPolygonOutline(pointsArray as BGE.Math.Vector[], colorRgba as integer, lineWidth = 1 as integer) as boolean
      return m.drawPolygonOutlineTo(m.draw2d, pointsArray, colorRgba, lineWidth)
    end function


    ' Draws the outline of a polygon to the given surface
    '
    ' @param {ifDraw2d} draw2d surface to draw to
    ' @param {BGE.Math.Vector[]} pointsArray points in outline (perimeter) order, not bounds order
    ' @param {integer} colorRgba color to stroke with
    ' @param {integer} [lineWidth=1] stroke thickness in pixels - approximated by nested outlines shrunk towards the polygon's center
    ' @return {boolean} true if anything was drawn
    function drawPolygonOutlineTo(draw2d as ifDraw2d, pointsArray as BGE.Math.Vector[], colorRgba as integer, lineWidth = 1 as integer) as boolean
      if invalid = pointsArray or pointsArray.count() < 2
        return false
      end if
      if lineWidth <= 1
        return m.drawPolygonOutlineRingTo(draw2d, pointsArray, colorRgba)
      end if

      ' A polygon has no single "inwards" direction the way a rectangle does, so a
      ' thicker stroke is approximated by re-stroking the outline shrunk one pixel at
      ' a time towards the polygon's center.
      center = BGE.Math.averagePoint(pointsArray)
      worked = false
      for inset = 0 to lineWidth - 1
        ringPoints = []
        for each point in pointsArray
          toCenter = BGE.Math.VectorOps.subtract(center, point)
          BGE.Math.VectorOps.normalize(toCenter)
          ringPoints.push(BGE.Math.VectorOps.add(point, BGE.Math.VectorOps.scale(toCenter, inset)))
        end for
        worked = m.drawPolygonOutlineRingTo(draw2d, ringPoints, colorRgba) or worked
      end for
      return worked
    end function


    private function drawPolygonOutlineRingTo(draw2d as ifDraw2d, pointsArray as BGE.Math.Vector[], colorRgba as integer) as boolean
      worked = true
      for i = 0 to pointsArray.count() - 1
        thisPoint = pointsArray[i]
        nextPoint = pointsArray[(i + 1) mod pointsArray.count()]
        worked = worked and m.drawLineTo(draw2d, thisPoint.x, thisPoint.y, nextPoint.x, nextPoint.y, colorRgba)
        m.drawCallsLastFrame++
      end for
      return worked
    end function


    function drawObject(x as integer, y as integer, src as ifDraw2d, rgba = -1 as integer) as boolean
      return m.drawObjectTo(m.draw2d, x, y, src, rgba)
    end function


    function drawObjectTo(draw2d as ifDraw2d, x as integer, y as integer, src as ifDraw2d, rgba = -1 as integer) as boolean
      if not m.shouldDrawTo(draw2d, x, y, src.getWidth(), src.getHeight())
        return false
      end if
      ' using undocumented ifDraw2d function
      result = (draw2d as dynamic).drawObject(fix(x), fix(y), src, rgba)
      m.drawCallsLastFrame++
      return result
    end function


    function drawScaledObject(x as integer, y as integer, scaleX as float, scaleY as float, src as ifDraw2d, rgba = -1 as integer) as boolean
      return m.drawScaledObjectTo(m.draw2d, x, y, scaleX, scaleY, src, rgba)
    end function

    function drawScaledObjectTo(draw2d as ifDraw2d, x as integer, y as integer, scaleX as float, scaleY as float, src as ifDraw2d, rgba = -1 as integer) as boolean
      if src = invalid or not m.shouldDrawTo(draw2d, x, y, src.getWidth() * scaleX, src.getHeight() * scaleY)
        return false
      end if
      result = draw2d.DrawScaledObject(fix(x), fix(y), scaleX, scaleY, src, rgba)
      m.drawCallsLastFrame++
      return result
    end function

    function drawRotatedObject(x as integer, y as integer, theta as float, src as ifDraw2d, rgba = -1 as integer) as boolean
      return m.drawRotatedObjectTo(m.draw2d, x, y, theta, src, rgba)
    end function

    function drawRotatedObjectTo(draw2d as ifDraw2d, x as integer, y as integer, theta as float, src as ifDraw2d, rgba = -1 as integer) as boolean
      if draw2d = invalid or src = invalid or not m.shouldDrawTo(draw2d, x, y, src.getWidth(), src.getHeight(), theta)
        return false
      end if
      thetaDeg = BGE.Math.RadiansToDegrees(theta)
      ' using undocumented ifDraw2d function
      fixX = fix(x)
      fixY = fix(y)
      result = draw2d.DrawRotatedObject(fixX, fixY, thetaDeg, src, rgba)
      m.drawCallsLastFrame++
      return result
    end function


    function drawRegion(regionToDraw as ifDraw2d, x as float, y as float, scaleX = 1 as float, scaleY = 1 as float, rotation = 0 as float, rgba = -1 as integer) as boolean
      return m.drawRegionTo(m.draw2d, regionToDraw, x, y, scaleX, scaleY, rotation, rgba)
    end function

    function drawRegionTo(canvasDrawTo as ifDraw2d, regionToDraw as ifDraw2d, x as float, y as float, scaleX = 1 as float, scaleY = 1 as float, rotation = 0 as float, rgba = -1 as integer) as boolean
      if regionToDraw = invalid or canvasDrawTo = invalid
        return false
      end if

      if regionToDraw.GetWidth() < 1 or regionToDraw.GetHeight() < 1
        return false
      end if
      if scaleX = 1 and scaleY = 1 and rotation = 0
        return m.DrawObjectTo(canvasDrawTo, x, y, regionToDraw, rgba)
      else if rotation = 0
        ' DrawScaledObjectTo's underlying native call has no rgba param, so a real
        ' tint (rgba <> -1, the "no tint"/white sentinel used throughout this file)
        ' must go through drawTransformedObjectTo instead, which does support rgba -
        ' see issue #197. Untinted draws (the common case) keep the cheaper path.
        if rgba <> -1
          return m.drawTransformedObjectTo(canvasDrawTo, x, y, scaleX, scaleY, 0, regionToDraw, rgba)
        end if
        return m.DrawScaledObjectTo(canvasDrawTo, x, y, scaleX, scaleY, regionToDraw)
      else if scaleX = 1 and scaleY = 1
        return m.DrawRotatedObjectTo(canvasDrawTo, x, y, -rotation, regionToDraw, rgba)
      end if
      return m.drawTransformedObjectTo(canvasDrawTo, x, y, scaleX, scaleY, -rotation, regionToDraw, rgba)
    end function

    ' Fills the triangle with DrawRect bands when that's no dearer than the exact fill. A
    ' band fill at 1px is as accurate as the exact one, so it's used
    ' whether or not the object is moving; coarser bands, or skipping a tiny triangle, only
    ' with allowQuickDraw.
    '
    ' @return {boolean} true if the triangle was handled here
    private function drawTriangleWithSpansIfCheaperTo(canvasDrawTo as ifDraw2d, points as BGE.Math.Vector[], x as float, y as float, rgba as integer, allowQuickDraw as boolean, bandAcrossY as dynamic) as boolean
      bounds = BGE.Math.getBounds(points)
      params = m.triangleQuickDrawParams
      width = bounds[1].x - bounds[0].x
      height = bounds[1].y - bounds[0].y
      if allowQuickDraw and width < params.skipSize and height < params.skipSize
        m.lossyTriangleFillCount++
        return true
      end if
      if invalid = bandAcrossY
        bandAcrossY = height <= width
      end if
      bandedSide = width
      if bandAcrossY
        bandedSide = height
      end if
      if bandedSide <= params.maxBands
        m.drawTriangleAsSpansTo(canvasDrawTo, points, x, y, rgba, 1, bandAcrossY)
        return true
      end if
      if allowQuickDraw and params.step > 1 and bandedSide <= params.maxBands * params.step
        m.lossyTriangleFillCount++
        m.drawTriangleAsSpansTo(canvasDrawTo, points, x, y, rgba, params.step, bandAcrossY)
        return true
      end if
      return false
    end function

    function drawTriangle(points as BGE.Math.Vector[], x as float, y as float, rgba as integer, allowQuickDraw = false as boolean, bandAcrossY = invalid as dynamic) as boolean
      return m.drawTriangleTo(m.draw2d, points, x, y, rgba, allowQuickDraw, bandAcrossY)
    end function

    ' Fills a triangle with a flat color, picking the cheapest way to do it well: small
    ' triangles are filled with `DrawRect` bands (see `drawTriangleAsSpansTo()`), larger ones
    ' with `drawTriangleExactTo()`.
    '
    ' @param {ifDraw2d} canvasDrawTo
    ' @param {BGE.Math.Vector[]} points the triangle's 3 corners
    ' @param {float} x offset added to every point
    ' @param {float} y offset added to every point
    ' @param {integer} rgba fill color
    ' @param {boolean} [allowQuickDraw=false] allow a coarser fill (or skipping a tiny
    '   triangle) for something that's moving - see `getLossyTriangleFillCount()`
    ' @param {dynamic} [bandAcrossY=invalid] band direction if banded - pass the same value
    '   for triangles sharing an edge (see `drawTriangleAsSpansTo()`)
    ' @return {boolean} true if the triangle was drawn (or deliberately skipped)
    function drawTriangleTo(canvasDrawTo as ifDraw2d, points as BGE.Math.Vector[], x as float, y as float, rgba as integer, allowQuickDraw = false as boolean, bandAcrossY = invalid as dynamic) as boolean
      if canvasDrawTo = invalid or points = invalid
        return false
      end if

      if points.count() <> 3
        return false
      end if

      if m.drawTriangleWithSpansIfCheaperTo(canvasDrawTo, points, x, y, rgba, allowQuickDraw, bandAcrossY)
        return true
      end if
      return m.drawTriangleExactTo(canvasDrawTo, points, x, y, rgba)
    end function

    ' Fills a triangle with two `DrawTransformedObject` calls of a shared right-triangle
    ' texture - a fixed cost whatever the triangle's size.
    '
    ' @param {ifDraw2d} canvasDrawTo
    ' @param {BGE.Math.Vector[]} points the triangle's 3 corners
    ' @param {float} x offset added to every point
    ' @param {float} y offset added to every point
    ' @param {integer} rgba fill color
    ' @return {boolean} true if both draws worked
    function drawTriangleExactTo(canvasDrawTo as ifDraw2d, points as BGE.Math.Vector[], x as float, y as float, rgba as integer) as boolean
      if canvasDrawTo = invalid or points = invalid or points.count() <> 3
        return false
      end if
      rightTriangle = m.getRightTriangleResource()
      if invalid = rightTriangle
        return false
      end if

      srcTriangle = BGE.Math.TriangleOps.create(points, true)

      perpFootInfo = BGE.Math.TriangleOps.getPerpendicularFootOfHeight(srcTriangle)
      perpFoot = BGE.Math.VectorOps.add({x: x, y: y}, perpFootInfo.point)
      vertScale = perpFootInfo.height / BGE.RendererResourceSize
      horizScale1 = perpFootInfo.firstDistance / BGE.RendererResourceSize

      angleFromPerpFootToPoint = -srcTriangle.anglesToNext[0] + BGE.Math.PI
      worked = m.drawTransformedObjectTo(canvasDrawTo, perpFoot.x, perpFoot.y, horizScale1, vertScale, angleFromPerpFootToPoint, rightTriangle.bitmap, rgba)
      horizScale2 = perpFootInfo.secondDistance / BGE.RendererResourceSize
      worked = worked and m.drawTransformedObjectTo(canvasDrawTo, perpFoot.x, perpFoot.y, vertScale, horizScale2, angleFromPerpFootToPoint - BGE.Math.HALF_PI, rightTriangle.bitmap, rgba)

      if m.drawDebugTrianglePoints
        m.drawSquareTo(canvasDrawTo, perpFoot.x, perpFoot.y, 5, BGE.Colors.Pink)
        m.drawTrianglePointsTo(canvasDrawTo, srcTriangle.points, 5, {x: x, y: y})
      end if

      return worked
    end function


    function drawPolygon(points as BGE.Math.Vector[], x as float, y as float, rgba as integer, allowQuickDraw = false as boolean) as boolean
      return m.drawPolygonTo(m.draw2d, points, x, y, rgba, allowQuickDraw)
    end function

    function drawPolygonTo(canvasDrawTo as ifDraw2d, points as BGE.Math.Vector[], x as float, y as float, rgba as integer, allowQuickDraw = false as boolean) as boolean
      if points.count() < 3
        return false
      end if

      'return m.drawPolygonAsRectanglesTo(canvasDrawTo, points, x, y, rgba, {levelOffset: 0, levelOfDetail: 4})


      if points.count() = 3
        return m.drawTriangleTo(canvasDrawTo, points, x, y, rgba, allowQuickDraw)
      end if

      triangles = BGE.QuickHull.getTrianglesFromPoints(points, true)
      bandAcrossY = m.shouldBandAcrossY(points)
      didDraw = true
      for each tri in triangles
        didDraw = m.drawTriangleTo(canvasDrawTo, tri, x, y, rgba, allowQuickDraw, bandAcrossY) or didDraw
      end for
      return didDraw
    end function


    function drawPolygonAsRectangles(canvasDrawTo as ifDraw2d, points as BGE.Math.Vector[], x as float, y as float, rgba as integer, options = {levelOffset: 0, levelOfDetail: 2} as LevelOfDetailOptions) as boolean
      return m.drawPolygonAsRectanglesTo(canvasDrawTo, points, x, y, rgba, options)
    end function


    ' Draw a filled convex polygon with rectangles
    '
    function drawPolygonAsRectanglesTo(canvasDrawTo as ifDraw2d, points as BGE.Math.Vector[], x as float, y as float, rgba as integer, options = {levelOffset: 0, levelOfDetail: 2} as LevelOfDetailOptions) as boolean
      if invalid = canvasDrawTo or points.count() < 3
        return false
      end if
      nodeX = []
      nPoints = points.count()
      x1 = x
      y1 = y
      bounds = BGE.Math.getBounds(points)
      maxY = bounds[1].y

      levelOfDetail = options.levelOfDetail
      levelOffset = options.levelOffset
      precision = (levelOfDetail - levelOffset) * 1.0
      if precision <= 1
        return false
      end if

      worked = true
      for pixelY = y1 to maxY step precision
        nodes = 0
        j = nPoints - 1
        for i = 0 to (nPoints - 1)
          if (points[i].y < pixelY and points[j].y >= pixelY) or (points[j].y < pixelY and points[i].y >= pixelY)
            if (points[j].y - points[i].y) = 0
              nodeX[nodes] = points[i].x
            else
              nodeX[nodes] = points[i].x + (pixelY - points[i].y) / (points[j].y - points[i].y) * (points[j].x - points[i].x)
            end if
            nodes++
          end if
          j = i
        end for

        nodeX.sort()
        for i = 0 to (nodes - 1) step precision
          pixelX = nodeX[i]
          if precision > 1 and i < nodes - precision
            if nodeX[i + precision] < pixelX
              pixelX = nodeX[i + precision]
            end if
          end if
          rectX = BGE.Math.Max(0, x1 + pixelX - 2 * x)
          rectY = BGE.Math.Max(0, y1 + pixelY - 2 * y - precision / 2)
          endX = BGE.Math.Min(cint(i + precision / 2 + 1), nodes - 1)
          width = nodeX[endX] - pixelX

          worked = m.drawRectangleTo(canvasDrawTo, rectX, rectY, width, precision, rgba) or worked
        end for
      end for
      return worked
    end function


    ' Fills a triangle with one `DrawRect` per band of `bandSize` pixels, banding across
    ' whichever axis of its bounding box is shorter (fewest rects) unless `bandAcrossY` says
    ' which. Each band's span is the triangle's cross-section at the band's middle, so the
    ' fill has no gaps. Two triangles sharing an edge (a quad) neither overlap nor leave a
    ' seam as long as they band across the same axis - pass the same `bandAcrossY` for both.
    ' Edges come out stepped by up to `bandSize` pixels.
    '
    ' @param {ifDraw2d} canvasDrawTo
    ' @param {BGE.Math.Vector[]} points the triangle's 3 corners
    ' @param {float} x offset added to every point
    ' @param {float} y offset added to every point
    ' @param {integer} rgba fill color
    ' @param {integer} [bandSize=1] band thickness in pixels
    ' @param {dynamic} [bandAcrossY=invalid] true for horizontal bands, false for vertical,
    '   invalid to pick by the triangle's own shape
    ' @return {boolean} true if anything was drawn
    function drawTriangleAsSpansTo(canvasDrawTo as ifDraw2d, points as BGE.Math.Vector[], x as float, y as float, rgba as integer, bandSize = 1 as integer, bandAcrossY = invalid as dynamic) as boolean
      if invalid = canvasDrawTo or invalid = points or points.count() <> 3
        return false
      end if
      if bandSize < 1
        bandSize = 1
      end if
      ' Work in (u, v) where v is the banded axis.
      if invalid = bandAcrossY
        bandAcrossY = m.shouldBandAcrossY(points)
      end if
      u = []
      v = []
      for each p in points
        if bandAcrossY
          u.push(p.x + x)
          v.push(p.y + y)
        else
          u.push(p.y + y)
          v.push(p.x + x)
        end if
      end for
      minV = BGE.Math.Min(v[0], BGE.Math.Min(v[1], v[2]))
      maxV = BGE.Math.Max(v[0], BGE.Math.Max(v[1], v[2]))

      drewAny = false
      ' On a shared grid, so neighbouring triangles' bands line up along their shared edge
      bandStart = Int(minV / bandSize) * bandSize
      while bandStart < maxV
        sampleV = bandStart + bandSize / 2.0
        if sampleV > maxV
          sampleV = (bandStart + maxV) / 2.0
        end if
        if sampleV < minV
          sampleV = (minV + BGE.Math.Min(bandStart + bandSize, maxV)) / 2.0
        end if
        spanMin = 1e9
        spanMax = -1e9
        j = 2
        for i = 0 to 2
          vi = v[i]
          vj = v[j]
          if (vi <= sampleV and vj >= sampleV) or (vj <= sampleV and vi >= sampleV)
            if vi = vj
              crossU = BGE.Math.Min(u[i], u[j])
              spanMin = BGE.Math.Min(spanMin, crossU)
              spanMax = BGE.Math.Max(spanMax, BGE.Math.Max(u[i], u[j]))
            else
              crossU = u[i] + (sampleV - vi) / (vj - vi) * (u[j] - u[i])
              spanMin = BGE.Math.Min(spanMin, crossU)
              spanMax = BGE.Math.Max(spanMax, crossU)
            end if
          end if
          j = i
        end for
        startU = Int(spanMin + 0.5)
        endU = Int(spanMax + 0.5)
        if endU <= startU and spanMax >= spanMin
          ' a sliver thinner than a pixel still gets one
          endU = startU + 1
        end if
        if endU > startU
          if bandAcrossY
            canvasDrawTo.DrawRect(startU, bandStart, endU - startU, bandSize, rgba)
          else
            canvasDrawTo.DrawRect(bandStart, startU, bandSize, endU - startU, rgba)
          end if
          m.drawCallsLastFrame++
          drewAny = true
        end if
        bandStart += bandSize
      end while
      return drewAny
    end function


    ' Whether a set of points is cheaper to band across y (horizontal bands) than across x.
    '
    ' @param {BGE.Math.Vector[]} points
    ' @return {boolean}
    function shouldBandAcrossY(points as BGE.Math.Vector[]) as boolean
      bounds = BGE.Math.getBounds(points)
      return (bounds[1].y - bounds[0].y) <= (bounds[1].x - bounds[0].x)
    end function


    function drawTriangleAsRaysTo(canvasDrawTo as ifDraw2d, points as BGE.Math.Vector[], x as float, y as float, rgba as integer, options = {levelOffset: 0, levelOfDetail: 2} as LevelOfDetailOptions) as boolean
      if invalid = canvasDrawTo or invalid = points
        return false
      end if

      len0 = BGE.Math.TotalDistance(points[1], points[2])
      len1 = BGE.Math.TotalDistance(points[0], points[2])
      len2 = BGE.Math.TotalDistance(points[0], points[1])
      apexIndex = 0
      shortLength = 0

      if len0 <= len1 and len0 <= len2
        apexIndex = 0
        shortLength = len0
      else if len1 <= len0 and len1 <= len2
        apexIndex = 1
        shortLength = len1
      else ' if len2 < len0 and len2 < len1
        apexIndex = 2
        shortLength = len2
      end if
      apex = points[apexIndex]
      startP = points[(apexIndex + 1) mod 3]
      endP = points[(apexIndex + 2) mod 3]

      if shortLength > 0
        for i = options.levelOffset to shortLength step options.levelOfDetail
          lineX = BGE.Tweens.LinearTween(startP.x, endP.x, i, shortLength)
          lineY = BGE.Tweens.LinearTween(startP.y, endP.y, i, shortLength)
          m.drawLineTo(canvasDrawTo, apex.x + x, apex.y + y, lineX + x, lineY + y, rgba)
        end for
      end if
      return true
    end function



    function getCanvasSize() as BGE.Math.Vector
      return BGE.Math.VectorOps.create(m.draw2d.getWidth(), m.draw2d.getHeight())
    end function

    function getCanvasCenter() as BGE.Math.Vector
      return BGE.Math.VectorOps.create(fix(m.draw2d.getWidth() / 2), fix(m.draw2d.getHeight() / 2))
    end function

    private function shouldDraw(x as float, y as float, width as float, height as float, rotation = 0 as float) as boolean
      return m.shouldDrawTo(m.draw2d, x, y, width, height, rotation)
    end function

    private function shouldDrawTo(draw2d as ifDraw2d, x as float, y as float, width as float, height as float, rotation = 0 as float) as boolean
      if draw2d = invalid or draw2d.GetWidth() = 0 or draw2d.getHeight() = 0 or width = 0 or height = 0
        return false
      end if
      if not m.onlyDrawWhenInFrame
        return true
      end if
      return m.isInsideCanvas(draw2d, x, y, width, height, rotation)
    end function


    ' Checks to see if a rectangle will be in a Draw2d Canvas
    '
    ' @param {object} draw2d
    ' @param {float} originalX
    ' @param {float} originalY
    ' @param {float} width
    ' @param {float} height
    ' @param {float} [rotation=0] in radians
    ' @return {boolean} true if this rectangle overlaps with the canvas
    function isInsideCanvas(draw2d as ifDraw2d, x as float, y as float, width as float, height as float, rotation = 0 as float) as boolean
      canvasWidth = draw2d.getWidth()
      canvasHeight = draw2d.getHeight()
      bounds = [
        {x: x, y: y},
        {x: x + width, y: y},
        {x: x + width, y: y + height},
        {x: x, y: y + height},
      ]


      if rotation <> 0
        offsets = [
          {x: 0, y: 0},
          {x: width, y: 0},
          {x: width, y: height},
          {x: 0, y: height},
        ]
        i = 0
        rotatedCorners = [] as BGE.Math.Vector[]
        for each point in offsets
          rotatedX = cos(rotation) * (point.x) + sin(rotation) * (point.y)
          rotatedY = cos(rotation) * (point.y) - sin(rotation) * (point.x)
          rotatedCorners.push({x: x + rotatedX, y: y + rotatedY})
          i = i + 1
        end for
        boundingPoints = BGE.math.getBounds(rotatedCorners)

        bounds = [
          {x: boundingPoints[0].x, y: boundingPoints[0].y},
          {x: boundingPoints[1].x, y: boundingPoints[0].y},
          {x: boundingPoints[1].x, y: boundingPoints[1].y},
          {x: boundingPoints[0].x, y: boundingPoints[1].y},
        ]
        width = boundingPoints[1].x - boundingPoints[0].x
        height = boundingPoints[1].y - boundingPoints[0].y
        x = boundingPoints[0].x
        y = boundingPoints[0].y
      end if


      ' check each corner
      insideCanvas = false
      for each point in bounds
        if point.x >= 0 and point.x <= canvasWidth and point.y >= 0 and point.y <= canvasHeight
          ' if one corner is in then this will be drawn
          insideCanvas = true
          exit for
        end if
      end for
      ' no corner is in the canvas, but this whole thing could overlap somehow
      if not insideCanvas and x < 0 and (x + width) > canvasWidth
        if y < 0
          insideCanvas = (y + height) >= 0
        else if y <= canvasHeight
          insideCanvas = true
        end if
      end if
      if not insideCanvas and y < 0 and (y + height) > canvasHeight
        if x < 0
          insideCanvas = (x + width) >= 0
        else if x <= canvasWidth
          insideCanvas = true
        end if
      end if

      return insideCanvas
    end function

    ' Whether the axis-aligned bounding box of the given canvas-space points is entirely
    ' outside this renderer's canvas - a cheap, deterministic version of the check
    ' shouldDrawTo()/isInsideCanvas() run against a specific draw call's rectangle. A
    ' SceneObject already holding its own canvas points (e.g. getAllCanvasPoints()) can use
    ' this to tell a draw failure that will keep failing every frame (off-canvas) apart
    ' from a transient one, so it's safe to latch the same way a frustum cull does - see
    ' SceneObject.isDeterministicDrawFailure().
    '
    ' This assumes shouldDrawTo() would actually reject an off-canvas draw, which is only
    ' true while onlyDrawWhenInFrame is left at its default `true` - there's currently no
    ' public way to turn that off, so this holds everywhere in this codebase today. If that
    ' ever changes, a caller with onlyDrawWhenInFrame = false could misidentify a genuinely
    ' transient failure as deterministic just because it happens to also be off-canvas.
    '
    ' @param {BGE.Math.Vector[]} points - canvas-space points
    ' @return {boolean} true if every point lies outside the canvas, with no overlap at all
    function isBoundingBoxOutsideCanvas(points as BGE.Math.Vector[]) as boolean
      if invalid = points or points.count() = 0
        return false
      end if
      bounds = BGE.Math.getBounds(points)
      canvasWidth = m.draw2d.getWidth()
      canvasHeight = m.draw2d.getHeight()
      return bounds[1].x < 0 or bounds[0].x > canvasWidth or bounds[1].y < 0 or bounds[0].y > canvasHeight
    end function

    function drawTrianglePoints(points as BGE.Math.Vector[], size = 5 as integer, offset = {x: 0, y: 0} as PositionXY, drawRegardlessOfDebugValue = false as boolean) as boolean
      return m.drawTrianglePointsTo(m.draw2d, points, size, offset, drawRegardlessOfDebugValue)
    end function

    function drawTrianglePointsTo(draw2dRegion as object, points as BGE.Math.Vector[], size = 5 as integer, offset = {x: 0, y: 0} as PositionXY, drawRegardlessOfDebugValue = false as boolean) as boolean
      if not m.drawDebugCells and not drawRegardlessOfDebugValue
        return false
      end if
      if draw2dRegion = invalid or points = invalid or points.count() < 3
        return false
      end if
      worked = m.drawSquareTo(draw2dRegion, points[0].x + offset.x, points[0].y + offset.y, size, BGE.Colors.Red)
      worked = worked and m.drawSquareTo(draw2dRegion, points[1].x + offset.x, points[1].y + offset.y, size, BGE.Colors.Green)
      worked = worked and m.drawSquareTo(draw2dRegion, points[2].x + offset.x, points[2].y + offset.y, size, BGE.Colors.Blue)
      return worked
    end function

    function drawTriangleOutline(pointsArray as BGE.Math.Vector[], colorRgba as integer, offset = {x: 0, y: 0} as PositionXY) as boolean
      return m.drawTriangleOutlineTo(m.draw2d, pointsArray, colorRgba, offset)
    end function

    function drawTriangleOutlineTo(draw2d as ifDraw2d, pointsArray as BGE.Math.Vector[], colorRgba as integer, offset = {x: 0, y: 0} as PositionXY) as boolean
      worked = true
      for i = 0 to 2
        pThis = pointsArray[i]
        nextI = (i + 1) mod 3
        pNext = pointsArray[nextI]
        worked = m.drawLineTo(draw2d, pThis.x + offset.x, pThis.y + offset.y, pNext.x + offset.x, pNext.y + offset.y, colorRgba) and worked
      end for
      return worked
    end function


    sub addDebugCell(region as ifDraw2d, text = "" as string)
      if not m.drawDebugCells
        return
      end if
      regionWidth = region.getWidth()
      regionHeight = region.getHeight()
      scale = m.debugCellSize - 2
      offsetX = 1
      offsetY = 1
      if regionWidth <> 0 and regionHeight <> 0
        if regionWidth > regionHeight
          scale = scale / regionWidth
          offsetY = m.debugCellSize / 2 - scale * regionHeight / 2 + 1
        else
          scale = scale / regionHeight
          offsetX = m.debugCellSize / 2 - scale * regionWidth / 2 + 1
        end if
      end if
      cellX = m.debugCellStart.x + m.debugCellSize * m.activeDebugCells
      cellY = m.debugCellStart.y
      textY = cellY + m.debugCellSize + 2

      m.drawRectangleOutline(cellX, cellY, m.debugCellSize, m.debugCellSize, BGE.Colors.White)
      m.draw2d.drawScaledObject(cellX + offsetX, cellY + offsetY, scale, scale, region)
      m.drawCallsLastFrame++

      debugText = `(${fix(regionWidth)}, ${fix(regionHeight)})`
      m.drawText(text, cellX, textY, BGE.Colors.White, m.getFont("debugUiSmall"))
      m.drawText(debugText, cellX, textY + 12, BGE.Colors.White, m.getFont("debugUiSmall"))
      m.activeDebugCells++
    end sub

    private function getFont(fontName as string) as roFont
      if invalid <> m.game
        return m.game.getFont(fontName)
      end if
      if lcase(fontName).StartsWith("debug") and invalid <> m.defaultDebugFont
        return m.defaultDebugFont
      end if
      if invalid <> m.defaultFont
        return m.defaultFont
      end if
      print "No roFontRegistry found - using Default font"
      fontRegistry = CreateObject("roFontRegistry")
      m.defaultFont = fontRegistry.GetDefaultFont() as roFont
      m.defaultDebugFont = fontRegistry.GetDefaultFont(10, false, false) as roFont
      return m.getFont(fontName)
    end function


    function forceDraw(drawSurface as ifDraw2d) as void
      if invalid <> drawSurface
        drawSurface.Finish()
      end if
      if m.dummyScreen <> invalid and not m.isSimulator
        m.dummyScreen.DrawObject(0, 0, drawSurface)
        m.dummyScreen.SwapBuffers()
        m.dummyScreen.clear(0)
      end if
    end function

  end class



end namespace
