namespace tests

  @suite("BGE.Renderer world-space debug drawing")
  class RendererWorldDrawingTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      camera = new BGE.Camera3d()
      camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 0, -200))
      m.renderer = new BGE.Renderer(CreateObject("roBitmap", {width: 200, height: 200, alphaEnable: true}), m.game, camera)
      m.renderer.setupCameraForFrame()
    end function

    @describe("drawWorldPolyline")

    @it("draws every segment of points in front of the camera")
    function _()
      points = [BGE.Math.VectorOps.create(-20, 0, -200), BGE.Math.VectorOps.create(20, 0, -200), BGE.Math.VectorOps.create(20, 0, -240)]
      m.assertTrue(m.renderer.drawWorldPolyline(points, &hFF0000FF, true))
    end function

    @it("skips segments with a point behind the camera")
    function _()
      points = [BGE.Math.VectorOps.create(0, 0, -200), BGE.Math.VectorOps.create(0, 0, 200)]
      m.assertFalse(m.renderer.drawWorldPolyline(points, &hFF0000FF))
    end function

    @it("needs at least two points")
    function _()
      m.assertFalse(m.renderer.drawWorldPolyline([BGE.Math.VectorOps.create(0, 0, -200)], &hFF0000FF))
    end function

    @describe("drawWorldCircle / drawWorldArc")

    @it("draws a ring and a wedge on the ground in front of the camera")
    function _()
      center = BGE.Math.VectorOps.create(0, 0, -200)
      m.assertTrue(m.renderer.drawWorldCircle(center, 30, &h00FF00FF))
      m.assertTrue(m.renderer.drawWorldArc(center, 30, -0.5, 0.5, &hFF0000FF, true))
    end function

    @describe("3D collider debugDraw")

    @it("draws sphere and box colliders through a perspective camera without error")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(0, 0, -200)
      sphere = new BGE.SphereCollider3d("sphere", {radius: 10})
      sphere.debugDraw(m.renderer, m.entity.position, &hFF0000FF, true)
      boxCollider = new BGE.BoxCollider3d("box", {width: 20, height: 30, depth: 10})
      boxCollider.debugDraw(m.renderer, m.entity.position, &hFF0000FF, true)
    end function

  end class

end namespace
