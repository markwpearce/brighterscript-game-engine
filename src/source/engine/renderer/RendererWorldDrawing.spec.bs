namespace tests

  @suite("BGE.Renderer world-space debug drawing")
  class RendererWorldDrawingTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    renderer as BGE.Renderer
    target as roBitmap

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      camera = new BGE.Camera3d()
      camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 0, -200))
      m.target = CreateObject("roBitmap", {width: 200, height: 200, alphaEnable: true})
      m.target.Clear(&h000000FF)
      m.renderer = new BGE.Renderer(m.target, m.game, camera)
      m.renderer.setupCameraForFrame()
    end function

    private function barAnchor(point as BGE.Math.Vector) as BGE.Math.Vector
      anchor = m.renderer.worldPointToCanvasPoint(point)
      m.assertNotInvalid(anchor)
      return anchor
    end function

    ' Red is the fill, blue the background
    private sub assertBarColor(x as float, y as float, isFill as boolean, message as string)
      pixel = m.target.GetByteArray(Int(x), Int(y), 1, 1)
      if isFill
        m.assertEqual(pixel[0], 255, message)
        m.assertEqual(pixel[2], 0, message)
      else
        m.assertEqual(pixel[0], 0, message)
        m.assertEqual(pixel[2], 255, message)
      end if
    end sub

    @describe("drawWorldPolyline")

    @it("draws every segment of points in front of the camera")
    function _()
      points = [BGE.Math.VectorOps.create(-20, 0, -200), BGE.Math.VectorOps.create(20, 0, -200), BGE.Math.VectorOps.create(20, 0, -240)]
      m.assertTrue(m.renderer.drawWorldPolyline(points, &hFF0000FF, true))
    end function

    @it("skips segments with a point behind the camera")
    function _()
      points = [BGE.Math.VectorOps.create(0, 0, -200), BGE.Math.VectorOps.create(0, 0, 200)]
      m.assertFalse(m.renderer.drawWorldPolyline(points, &hFF0000FF))
    end function

    @it("needs at least two points")
    function _()
      m.assertFalse(m.renderer.drawWorldPolyline([BGE.Math.VectorOps.create(0, 0, -200)], &hFF0000FF))
    end function

    @describe("drawWorldCircle / drawWorldArc")

    @it("draws a ring and a wedge on the ground in front of the camera")
    function _()
      center = BGE.Math.VectorOps.create(0, 0, -200)
      m.assertTrue(m.renderer.drawWorldCircle(center, 30, &h00FF00FF))
      m.assertTrue(m.renderer.drawWorldArc(center, 30, -0.5, 0.5, &hFF0000FF, true))
    end function

    @describe("drawWorldBar")

    @it("draws the fill from the left over a bordered background, sitting on the point")
    function _()
      point = BGE.Math.VectorOps.create(0, 0, -200)
      anchor = m.barAnchor(point)
      ' 3px border so the samples stay clear of sub-pixel edges
      m.assertTrue(m.renderer.drawWorldBar(point, 40, 8, 0.5, &hFF0000FF, &h0000FFFF, 3))
      m.assertBarColor(anchor.x - 10, anchor.y - 4, true, "left half filled")
      m.assertBarColor(anchor.x + 5, anchor.y - 4, false, "right half background")
      m.assertBarColor(anchor.x - 19, anchor.y - 4, false, "left border")
      m.assertBarColor(anchor.x - 10, anchor.y - 7, false, "top border")
      m.assertEqual(m.target.GetByteArray(Int(anchor.x - 10), Int(anchor.y + 2), 1, 1)[2], 0, "nothing below the point")
    end function

    @it("clamps the fraction to 0..1")
    function _()
      point = BGE.Math.VectorOps.create(0, 0, -200)
      anchor = m.barAnchor(point)
      m.renderer.drawWorldBar(point, 40, 8, 3, &hFF0000FF, &h0000FFFF, 3)
      m.assertBarColor(anchor.x + 15, anchor.y - 4, true, "overfull stops inside the border")
      m.assertBarColor(anchor.x + 18, anchor.y - 4, false, "right border")
      m.renderer.drawWorldBar(point, 40, 8, -1, &hFF0000FF, &h0000FFFF, 3)
      m.assertBarColor(anchor.x - 10, anchor.y - 4, false, "negative is empty")
    end function

    @it("skips a point behind the camera")
    function _()
      m.assertFalse(m.renderer.drawWorldBar(BGE.Math.VectorOps.create(0, 0, 200), 40, 8, 0.5, &hFF0000FF, &h0000FFFF))
    end function

    @describe("3D collider debugDraw")

    @it("draws sphere and box colliders through a perspective camera without error")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(0, 0, -200)
      sphere = new BGE.SphereCollider3d("sphere", {radius: 10})
      sphere.debugDraw(m.renderer, m.entity.position, &hFF0000FF, true)
      boxCollider = new BGE.BoxCollider3d("box", {width: 20, height: 30, depth: 10})
      boxCollider.debugDraw(m.renderer, m.entity.position, &hFF0000FF, true)
    end function

  end class

end namespace
