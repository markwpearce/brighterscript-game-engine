import "pkg:/source/testing/PixelReadback.spec.bs"
import "../../math/vector.bs"
import "../drawables/DrawableRectangle.bs"
import "../drawables/Model3d.bs"
import "../Game.bs"
import "../GameEntity.bs"
import "cameras/Camera3d.bs"
import "Fog.bs"
import "Renderer.bs"
import "sceneObjects/SceneObject.bs"

namespace tests

  ' The eye 50 up at the origin, level, looking down -z, 90 degree view: the horizon is row 360
  ' and the focal length 640 px. The target is cleared to black before each frame.
  @suite("BGE.Renderer - fog")
  class RendererFogTests extends rooibos.BaseTestSuite

    private game as BGE.Game
    private renderer as BGE.Renderer
    private camera as BGE.Camera3d
    private bitmap as roBitmap

    protected override sub beforeEach()
      m.game = new BGE.Game(1280, 720)
      m.camera = new BGE.Camera3d()
      m.camera.fieldOfViewDegrees = 90
      m.camera.maxDrawDistance = 1000
      (m.camera as object).maxDrawDistanceDeviceCap = 2500
      m.camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.camera.drawDistanceFadeFraction = 0.15
      m.camera.drawDistanceTransitionSeconds = 0
      m.bitmap = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap, m.game, m.camera)
    end sub

    private sub renderFrames(count = 1 as integer)
      for i = 1 to count
        m.bitmap.Clear(&h000000FF)
        m.renderer.setupCameraForFrame()
        m.renderer.render()
      end for
    end sub

    ' RGBA of one pixel of the target
    private function pixelAt(x as integer, y as integer) as integer
      bytes = tests.readPixels(m.bitmap, x, y, 1, 1)
      return (bytes[0] << 24) + (bytes[1] << 16) + (bytes[2] << 8) + bytes[3]
    end function

    private sub turnOnFog(backdropHeight as float)
      m.camera.fog.enabled = true
      m.camera.fog.color = &h1C2842
      m.camera.fog.backdropHeight = backdropHeight
    end sub

    @describe("the backdrop")

    @it("draws nothing when fog is off")
    function _()
      m.camera.fog.backdropHeight = 200
      m.renderFrames(2)
      m.assertEqual(0, m.renderer.getDrawCallsLastFrame())
      m.assertEqual(&h000000FF, m.pixelAt(640, 340))
    end function

    @it("fills from the fog's top down to where the ground ends")
    function _()
      m.turnOnFog(20)
      m.renderFrames()
      ' its top is 30 below the eye at 1000: row 360 + 640 * 30 / 1000 = 379
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 382))
      m.assertEqual(&h000000FF, m.pixelAt(640, 375))
      m.assertEqual(&h000000FF, m.pixelAt(640, 715))
    end function

    @it("stops at the horizon when the fog's top is above it")
    function _()
      m.turnOnFog(200)
      m.renderFrames()
      ' 200 would reach row 264, but the horizon is row 360
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 365))
      m.assertEqual(&h000000FF, m.pixelAt(640, 355))
      m.assertEqual(&h000000FF, m.pixelAt(640, 270))
    end function

    @it("draws nothing with no backdrop height")
    function _()
      m.turnOnFog(0)
      m.renderFrames()
      m.assertEqual(&h000000FF, m.pixelAt(640, 340))
    end function

    @it("draws the backdrop image tinted the fog colour, clear where it's clear")
    function _()
      m.turnOnFog(200)
      ' white, its top half clear: like a mist that thins out upward
      image = CreateObject("roBitmap", {width: 4, height: 64, alphaEnable: true})
      image.Clear(&h00000000)
      image.DrawRect(0, 32, 4, 32, &hFFFFFFFF)
      m.camera.fog.backdropRegion = CreateObject("roRegion", image, 0, 0, 4, 64)
      m.renderFrames()
      ' the band is the horizon (row 360) down to just under the ground's edge: its top half is clear
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 380))
      m.assertEqual(&h000000FF, m.pixelAt(640, 362))
    end function

    @it("draws nothing looking straight down")
    function _()
      m.turnOnFog(200)
      m.camera.orientation = BGE.Math.VectorOps.create(0, -1, 0)
      m.renderFrames()
      m.assertEqual(0, m.renderer.getDrawCallsLastFrame())
    end function

    ' A 400 wide, 600 tall rectangle facing the camera, centred on x at depth -z, spanning the
    ' eye's height (row 360), on a static entity
    private function newTower(z as float, casts = true as boolean, x = 0.0 as float) as BGE.SceneObject
      entity = new BGE.GameEntity(m.game, {name: "tower", isStatic: true})
      entity.position = BGE.Math.VectorOps.create(x - 200, 300, z)
      entity.updateTransformationMatrix()
      drawable = new BGE.DrawableRectangle(entity, 400, 600, {drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace, castsFogSilhouette: casts})
      return drawable.addToRenderer(m.renderer)
    end function

    ' The 12 triangles of an axis-aligned box
    private function boxFaces(loX as float, loY as float, loZ as float, hiX as float, hiY as float, hiZ as float) as BGE.Model3dFace[]
      c = []
      for each y in [loY, hiY]
        for each z in [loZ, hiZ]
          for each x in [loX, hiX]
            c.push(BGE.Math.VectorOps.create(x, y, z))
          end for
        end for
      end for
      quads = [[0, 1, 3, 2], [4, 5, 7, 6], [0, 1, 5, 4], [2, 3, 7, 6], [0, 2, 6, 4], [1, 3, 7, 5]]
      faces = [] as BGE.Model3dFace[]
      for each q in quads
        faces.push(BGE.Model3dFaceOps.create([c[q[0]], c[q[1]], c[q[2]]]))
        faces.push(BGE.Model3dFaceOps.create([c[q[0]], c[q[2]], c[q[3]]]))
      end for
      return faces
    end function

    ' A 400 square nave 200 tall with a 100 square tower 600 tall in its middle, on the ground at
    ' depth -z, as a fog-casting model
    private function newChapel(z as float) as BGE.DrawableModel
      entity = new BGE.GameEntity(m.game, {name: "chapel", isStatic: true})
      entity.position = BGE.Math.VectorOps.create(0, 0, z)
      entity.updateTransformationMatrix()
      faces = m.boxFaces(-200, 0, -200, 200, 200, 200)
      faces.append(m.boxFaces(-50, 0, -50, 50, 600, 50))
      drawable = new BGE.DrawableModel(entity, new BGE.Model3d(faces), {castsFogSilhouette: true})
      drawable.addToRenderer(m.renderer)
      return drawable
    end function

    ' A 120 square box 240 tall under a pyramid roof up to 400, on the ground at depth -z
    private function newPointedTower(z as float) as BGE.DrawableModel
      entity = new BGE.GameEntity(m.game, {name: "pointed", isStatic: true})
      entity.position = BGE.Math.VectorOps.create(0, 0, z)
      entity.updateTransformationMatrix()
      faces = m.boxFaces(-60, 0, -60, 60, 240, 60)
      v = BGE.Math.VectorOps.create
      apex = v(0, 400, 0)
      corners = [v(-60, 240, -60), v(60, 240, -60), v(60, 240, 60), v(-60, 240, 60)]
      for i = 0 to 3
        faces.push(BGE.Model3dFaceOps.create([corners[i], corners[(i + 1) mod 4], apex]))
      end for
      drawable = new BGE.DrawableModel(entity, new BGE.Model3d(faces), {castsFogSilhouette: true})
      drawable.addToRenderer(m.renderer)
      return drawable
    end function

    ' The fog rects drawn last frame, [x, y, w, h] each
    private function fogRects() as float[]
      return (m.renderer as object).fogBoxes
    end function

    @describe("silhouettes")

    @it("leaves fog colour where a caster past the draw distance stands")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500)
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 360))
    end function

    @it("leaves the sky for a drawable that doesn't cast")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500, false)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h000000FF, m.pixelAt(640, 360))
    end function

    @it("draws nothing with fog off")
    function _()
      m.newTower(-1500)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h000000FF, m.pixelAt(640, 360))
    end function

    @it("draws nothing for a caster past the reach or behind the camera")
    function _()
      m.turnOnFog(0)
      m.newTower(-2500)
      m.newTower(500)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("draws no box for a caster that hasn't started fading")
    function _()
      m.turnOnFog(0)
      m.newTower(-500)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("draws no box above silhouetteStartAlpha")
    function _()
      m.turnOnFog(0)
      m.camera.fog.silhouetteStartAlpha = 0.5
      ' in the fade band at alpha 2/3
      m.newTower(-900)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("gives the box the opacity the caster has lost")
    function _()
      m.turnOnFog(0)
      m.camera.fog.silhouetteOpacityLead = 1
      ' the band is 850 to 1000: alpha 0.25 at 962.5, so the box is 0.75
      m.newTower(-962.5)
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual((&h1C2842 << 8) + 191, m.renderer.getFogSilhouetteRgbas()[0])
    end function

    @it("makes up the lost opacity faster with silhouetteOpacityLead")
    function _()
      m.turnOnFog(0)
      m.camera.fog.silhouetteOpacityLead = 1.2
      ' alpha 0.25 at 962.5: 0.75 lost, times 1.2
      m.newTower(-962.5)
      m.renderFrames()
      m.assertEqual((&h1C2842 << 8) + 229, m.renderer.getFogSilhouetteRgbas()[0])
      m.camera.fog.silhouetteOpacityLead = 4
      m.renderFrames()
      m.assertEqual(&h1C2842FF, m.renderer.getFogSilhouetteRgbas()[0])
    end function

    @it("draws a solid box past the draw distance with fading off, and none inside")
    function _()
      m.camera.drawDistanceFadeFraction = 0
      m.turnOnFog(0)
      m.newTower(-1500)
      m.newTower(-990)
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h1C2842FF, m.renderer.getFogSilhouetteRgbas()[0])
    end function

    @it("draws no box for a caster that reaches behind the camera")
    function _()
      m.camera.drawDistanceFadeFraction = 0
      m.turnOnFog(0)
      ' 2600 long along z, from 200 behind the eye to 2400 ahead: its centre is past the draw distance
      entity = new BGE.GameEntity(m.game, {name: "longWall", isStatic: true})
      ' it runs from its position along -z
      entity.position = BGE.Math.VectorOps.create(200, 300, 200)
      entity.rotation = BGE.Math.VectorOps.create(0, -BGE.Math.PI / 2, 0)
      entity.updateTransformationMatrix()
      drawable = new BGE.DrawableRectangle(entity, 2600, 600, {drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace, castsFogSilhouette: true})
      drawable.addToRenderer(m.renderer)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("repeats the boxes without projecting while the camera is still")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500)
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesProjectedLastFrame)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesProjectedLastFrame)
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 360))
      m.camera.position.x += 5
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesProjectedLastFrame)
    end function

    @it("works the boxes out again when a still caster turns in place")
    function _()
      m.turnOnFog(0)
      ' pivoting about its centre, so its depth point barely moves
      entity = new BGE.GameEntity(m.game, {name: "tower"})
      entity.position = BGE.Math.VectorOps.create(0, 300, -1500)
      entity.updateTransformationMatrix()
      drawable = new BGE.DrawableRectangle(entity, 400, 600, {drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace, castsFogSilhouette: true})
      drawable.offset.x = -200
      drawable.addToRenderer(m.renderer)
      m.renderFrames(3)
      m.assertEqual(0, m.renderer.fogSilhouettesProjectedLastFrame)
      entity.rotation.y = 0.7
      entity.updateTransformationMatrix()
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesProjectedLastFrame)
    end function

    @it("redraws the boxes in a new fog colour with the camera still")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500)
      m.renderFrames(2)
      m.camera.fog.color = &h405060
      m.renderFrames()
      m.assertEqual(&h405060FF, m.pixelAt(640, 360))
    end function

    @it("notices a caster flag set after adding")
    function _()
      m.turnOnFog(0)
      tower = m.newTower(-1500, false)
      m.renderFrames(2)
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
      tower.drawable.castsFogSilhouette = true
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("works the boxes out again when the field of view changes with the camera still")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500)
      m.renderFrames(2)
      m.assertEqual(0, m.renderer.fogSilhouettesProjectedLastFrame)
      m.camera.fieldOfViewDegrees = 60
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesProjectedLastFrame)
    end function

    @it("boxes a caster that doesn't fade once it's past the draw distance")
    function _()
      m.turnOnFog(0)
      tower = m.newTower(-1500)
      tower.drawable.fadesWithDistance = false
      near = m.newTower(-500)
      near.drawable.fadesWithDistance = false
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h1C2842FF, m.renderer.getFogSilhouetteRgbas()[0])
    end function

    @it("draws no box looking straight down")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500)
      m.camera.orientation = BGE.Math.VectorOps.create(0, -1, 0)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("draws a tower-on-nave model as two rects past the draw distance")
    function _()
      m.turnOnFog(0)
      m.camera.fog.silhouetteHulls = false
      m.newChapel(-1500)
      m.renderFrames()
      m.assertEqual(2, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 250))
      ' beside the tower, above the nave
      m.assertEqual(&h000000FF, m.pixelAt(720, 250))
    end function

    @it("gives every rect of a fading model the same alpha")
    function _()
      m.turnOnFog(0)
      m.camera.fog.silhouetteHulls = false
      m.camera.fog.silhouetteOpacityLead = 1
      m.newChapel(-1150)
      m.renderFrames()
      rgbas = m.renderer.getFogSilhouetteRgbas()
      m.assertEqual(2, rgbas.count())
      m.assertEqual(rgbas[0], rgbas[1])
      alpha = rgbas[0] and &hFF
      m.assertTrue(alpha > 0 and alpha < 255, `alpha ${alpha}`)
    end function

    @it("works the parts out again after invalidateGeometry")
    function _()
      m.turnOnFog(0)
      m.camera.fog.silhouetteHulls = false
      chapel = m.newChapel(-1500)
      m.renderFrames()
      m.assertEqual(2, m.renderer.fogSilhouettesDrawnLastFrame)
      chapel.model = new BGE.Model3d(m.boxFaces(-200, 0, -200, 200, 200, 200))
      chapel.invalidateGeometry()
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("follows a scaled and offset model")
    function _()
      m.turnOnFog(0)
      m.camera.fog.silhouetteHulls = false
      chapel = m.newChapel(-1500)
      chapel.scale = BGE.Math.createScaleVector(2)
      chapel.offset = BGE.Math.VectorOps.create(0, 0, 100)
      m.renderFrames()
      ' the tower's rect is first: 200 wide, its near face at depth 1300
      rects = m.fogRects()
      m.assertEqual(8, rects.count())
      expected = 200 * 640 / 1300
      m.assertTrue(Abs(rects[2] - expected) <= 1, `width ${rects[2]}, expected ${expected}`)
    end function

    @it("outlines a pointed roof by its point")
    function _()
      m.turnOnFog(0)
      m.newPointedTower(-1500)
      m.renderFrames()
      ' row 240 is up the roof, where it's about 22 px wide
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 240))
      m.assertEqual(&h000000FF, m.pixelAt(660, 240))
    end function

    @it("boxes a pointed roof with silhouetteHulls off")
    function _()
      m.turnOnFog(0)
      m.camera.fog.silhouetteHulls = false
      m.newPointedTower(-1500)
      m.renderFrames()
      m.assertEqual(&h1C2842FF, m.pixelAt(660, 240))
    end function

    @it("boxes a pointed roof at a quality level without fog silhouette hulls (#686)")
    function _()
      m.turnOnFog(0)
      m.renderer.setQualitySettings(BGE.getRenderQualityPreset(BGE.RenderQualityLevel.basic))
      m.newPointedTower(-1500)
      m.renderFrames()
      m.assertEqual(&h1C2842FF, m.pixelAt(660, 240))
    end function

    @it("fills the outline in bands of the quality level's height")
    function _()
      m.turnOnFog(0)
      m.newPointedTower(-1500)
      m.renderFrames()
      fine = m.renderer.fogSilhouettesDrawnLastFrame
      m.renderer.setQualitySettings(BGE.mergeRenderQualitySettings(m.renderer.qualitySettings, {fogSilhouetteBand: 16.0}))
      m.renderFrames()
      m.assertTrue(m.renderer.fogSilhouettesDrawnLastFrame < fine, `${m.renderer.fogSilhouettesDrawnLastFrame} rects with 16 px bands, ${fine} with 4`)
    end function

    @it("forgets a removed caster")
    function _()
      m.turnOnFog(0)
      tower = m.newTower(-1500)
      m.renderFrames(2)
      m.renderer.removeSceneObject(tower)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h000000FF, m.pixelAt(640, 360))
    end function

  end class

end namespace
