import "../../math/vector.bs"
import "../drawables/DrawableRectangle.bs"
import "../Game.bs"
import "../GameEntity.bs"
import "cameras/Camera3d.bs"
import "Fog.bs"
import "Renderer.bs"
import "sceneObjects/SceneObject.bs"

namespace tests

  ' The eye 50 up at the origin, level, looking down -z, 90 degree view: the horizon is row 360
  ' and the focal length 640 px. The target is cleared to black before each frame.
  @suite("BGE.Renderer - fog")
  class RendererFogTests extends rooibos.BaseTestSuite

    private game as BGE.Game
    private renderer as BGE.Renderer
    private camera as BGE.Camera3d
    private bitmap as roBitmap

    protected override sub beforeEach()
      m.game = new BGE.Game(1280, 720)
      m.camera = new BGE.Camera3d()
      m.camera.fieldOfViewDegrees = 90
      m.camera.maxDrawDistance = 1000
      (m.camera as object).maxDrawDistanceDeviceCap = 2500
      m.camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.camera.drawDistanceFadeFraction = 0.15
      m.camera.drawDistanceTransitionSeconds = 0
      m.bitmap = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap, m.game, m.camera)
    end sub

    private sub renderFrames(count = 1 as integer)
      for i = 1 to count
        m.bitmap.Clear(&h000000FF)
        m.renderer.setupCameraForFrame()
        m.renderer.render()
      end for
    end sub

    ' RGBA of one pixel of the target
    private function pixelAt(x as integer, y as integer) as integer
      bytes = m.bitmap.GetByteArray(x, y, 1, 1)
      return (bytes[0] << 24) + (bytes[1] << 16) + (bytes[2] << 8) + bytes[3]
    end function

    private sub turnOnFog(backdropHeight as float)
      m.camera.fog.enabled = true
      m.camera.fog.color = &h1C2842
      m.camera.fog.backdropHeight = backdropHeight
    end sub

    @describe("the backdrop")

    @it("draws nothing when fog is off")
    function _()
      m.camera.fog.backdropHeight = 200
      m.renderFrames(2)
      m.assertEqual(0, m.renderer.getDrawCallsLastFrame())
      m.assertEqual(&h000000FF, m.pixelAt(640, 340))
    end function

    @it("fills from the fog's top down to where the ground ends")
    function _()
      m.turnOnFog(200)
      m.renderFrames()
      ' its top is 150 above the eye at 1000: row 360 - 640 * 150 / 1000 = 264
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 340))
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 270))
      m.assertEqual(&h000000FF, m.pixelAt(640, 100))
      m.assertEqual(&h000000FF, m.pixelAt(640, 715))
    end function

    @it("draws nothing with no backdrop height")
    function _()
      m.turnOnFog(0)
      m.renderFrames()
      m.assertEqual(&h000000FF, m.pixelAt(640, 340))
    end function

    @it("draws nothing looking straight down")
    function _()
      m.turnOnFog(200)
      m.camera.orientation = BGE.Math.VectorOps.create(0, -1, 0)
      m.renderFrames()
      m.assertEqual(0, m.renderer.getDrawCallsLastFrame())
    end function

    ' A 400 wide, 600 tall rectangle facing the camera, centred on x at depth -z, spanning the
    ' eye's height (row 360), on a static entity
    private function newTower(z as float, casts = true as boolean, x = 0.0 as float) as BGE.SceneObject
      entity = new BGE.GameEntity(m.game, {name: "tower", isStatic: true})
      entity.position = BGE.Math.VectorOps.create(x - 200, 300, z)
      entity.updateTransformationMatrix()
      drawable = new BGE.DrawableRectangle(entity, 400, 600, {drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace, castsFogSilhouette: casts})
      return drawable.addToRenderer(m.renderer)
    end function

    @describe("silhouettes")

    @it("leaves fog colour where a caster past the draw distance stands")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500)
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 360))
    end function

    @it("leaves the sky for a drawable that doesn't cast")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500, false)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h000000FF, m.pixelAt(640, 360))
    end function

    @it("draws nothing with fog off")
    function _()
      m.newTower(-1500)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h000000FF, m.pixelAt(640, 360))
    end function

    @it("draws nothing for a caster past the reach or behind the camera")
    function _()
      m.turnOnFog(0)
      m.newTower(-2500)
      m.newTower(500)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("draws no box while the caster is still mostly opaque")
    function _()
      m.turnOnFog(0)
      m.newTower(-500)
      ' in the fade band at alpha 2/3: above silhouetteStartAlpha
      m.newTower(-900)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("fades the box in as the caster fades out")
    function _()
      m.turnOnFog(0)
      ' the band is 850 to 1000: alpha 0.25 at 962.5, so the box is half solid
      m.newTower(-962.5)
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual((&h1C2842 << 8) + 127, m.renderer.fogSilhouetteRgbas[0])
    end function

    @it("draws a solid box past the draw distance with fading off, and none inside")
    function _()
      m.camera.drawDistanceFadeFraction = 0
      m.turnOnFog(0)
      m.newTower(-1500)
      m.newTower(-990)
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h1C2842FF, m.renderer.fogSilhouetteRgbas[0])
    end function

    @it("draws no box for a caster that reaches behind the camera")
    function _()
      m.camera.drawDistanceFadeFraction = 0
      m.turnOnFog(0)
      ' 2600 long along z, from 200 behind the eye to 2400 ahead: its centre is past the draw distance
      entity = new BGE.GameEntity(m.game, {name: "longWall", isStatic: true})
      ' it runs from its position along -z
      entity.position = BGE.Math.VectorOps.create(200, 300, 200)
      entity.rotation = BGE.Math.VectorOps.create(0, -BGE.Math.PI / 2, 0)
      entity.updateTransformationMatrix()
      drawable = new BGE.DrawableRectangle(entity, 2600, 600, {drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace, castsFogSilhouette: true})
      drawable.addToRenderer(m.renderer)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("repeats the boxes without projecting while the camera is still")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500)
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesProjectedLastFrame)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesProjectedLastFrame)
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h1C2842FF, m.pixelAt(640, 360))
      m.camera.position.x += 5
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesProjectedLastFrame)
    end function

    @it("redraws the boxes in a new fog colour with the camera still")
    function _()
      m.turnOnFog(0)
      m.newTower(-1500)
      m.renderFrames(2)
      m.camera.fog.color = &h405060
      m.renderFrames()
      m.assertEqual(&h405060FF, m.pixelAt(640, 360))
    end function

    @it("notices a caster flag set after adding")
    function _()
      m.turnOnFog(0)
      tower = m.newTower(-1500, false)
      m.renderFrames(2)
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
      tower.drawable.castsFogSilhouette = true
      m.renderFrames()
      m.assertEqual(1, m.renderer.fogSilhouettesDrawnLastFrame)
    end function

    @it("forgets a removed caster")
    function _()
      m.turnOnFog(0)
      tower = m.newTower(-1500)
      m.renderFrames(2)
      m.renderer.removeSceneObject(tower)
      m.renderFrames()
      m.assertEqual(0, m.renderer.fogSilhouettesDrawnLastFrame)
      m.assertEqual(&h000000FF, m.pixelAt(640, 360))
    end function

  end class

end namespace
