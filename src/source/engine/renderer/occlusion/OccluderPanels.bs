import "OcclusionTypes.bs"
import "../../drawables/Model3d.bs"
import "../../../math/vector.bs"
import "../../../math/math.bs"

namespace BGE.Occlusion

  ' Distinct vertex positions, found through a grid of cells keyed by position.
  interface PanelVertexWelder extends roAssociativeArray
    points as BGE.Math.Vector[]
    cells as roAssociativeArray
    cellSize as float
    epsilon as float
  end interface

  ' A convex polygon being merged, as welded vertex ids. Straight corners along an edge
  ' are kept, so a neighbour sharing only part of that edge still finds it.
  interface PanelPolygon extends roAssociativeArray
    ids as integer[]
    ' a corner of a merged triangle ended up inside it
    hasInnerVertices as boolean
    alive as boolean
  end interface

  interface PanelPlaneGroup extends roAssociativeArray
    normal as BGE.Math.Vector
    offset as float
    ' creation order, so a face joins the first group that fits, as a scan in order would
    index as integer
    polygons as PanelPolygon[]
  end interface

  ' how far apart two unit normals can be per component and still be "the same" plane
  ' (dot > 0.999 is a distance under sqrt(0.002) = 0.0447)
  const PANEL_NORMAL_TOLERANCE = 0.045
  const PANEL_TURN_EPSILON = 0.0001

  ' Merges a static model's coplanar, edge-sharing triangles into convex panels that can
  ' act as occluders. Panels keep the source triangles' winding.
  '
  ' @param {BGE.Model3dFace[]} faces triangles in model-local space
  ' @return {BGE.OccluderPanel[]} one panel per merged region; degenerate triangles are dropped
  function buildModelPanels(faces as BGE.Model3dFace[]) as BGE.OccluderPanel[]
    panels = []
    points = []
    for each face in faces
      for each v in face.vertices
        points.push(v)
      end for
    end for
    if points.Count() = 0
      return panels
    end if
    bounds = BGE.Math.getBounds(points)
    extent = BGE.Math.VectorOps.subtract(bounds[1], bounds[0])
    size = BGE.Math.Max(extent.x, BGE.Math.Max(extent.y, extent.z))
    if size <= 0
      return panels
    end if
    posEpsilon = size * 0.001
    planeEpsilon = size * 0.01
    ' a face's offset can differ from its group's by planeEpsilon plus the normals'
    ' difference times how far the vertex is from the origin
    farX = BGE.Math.Max(Abs(bounds[0].x), Abs(bounds[1].x))
    farY = BGE.Math.Max(Abs(bounds[0].y), Abs(bounds[1].y))
    farZ = BGE.Math.Max(Abs(bounds[0].z), Abs(bounds[1].z))
    offsetTolerance = planeEpsilon + BGE.Occlusion.PANEL_NORMAL_TOLERANCE * Sqr(farX * farX + farY * farY + farZ * farZ)
    ' cells over twice the tolerance, so at most one neighbour per axis can hold a match;
    ' ninths put 0 and 1 mid-cell, so axis-aligned normals look in one cell
    normalCell = 1 / 9
    offsetCell = offsetTolerance * 2.5

    welder = {points: [], cells: {}, cellSize: posEpsilon * 16, epsilon: posEpsilon} as PanelVertexWelder
    groups = [] as PanelPlaneGroup[]
    groupCells = {}
    minCrossLength = size * size * 0.000001
    for each face in faces
      if face.vertices.Count() = 3
        v0 = face.vertices[0]
        v1 = face.vertices[1]
        v2 = face.vertices[2]
        e1x = v1.x - v0.x
        e1y = v1.y - v0.y
        e1z = v1.z - v0.z
        e2x = v2.x - v0.x
        e2y = v2.y - v0.y
        e2z = v2.z - v0.z
        nx = e1y * e2z - e1z * e2y
        ny = e1z * e2x - e1x * e2z
        nz = e1x * e2y - e1y * e2x
        crossLength = Sqr(nx * nx + ny * ny + nz * nz)
        ids = invalid
        if crossLength >= minCrossLength
          ids = [weldVertex(welder, v0), weldVertex(welder, v1), weldVertex(welder, v2)]
          ' a sliver thinner than the weld collapses two corners into one id, which would
          ' make the merge's turn checks pass for anything
          if ids[0] = ids[1] or ids[1] = ids[2] or ids[0] = ids[2]
            ids = invalid
          end if
        end if
        if invalid <> ids
          normal = BGE.Math.VectorOps.create(nx / crossLength, ny / crossLength, nz / crossLength)
          offset = normal.x * v0.x + normal.y * v0.y + normal.z * v0.z
          target = findPlaneGroup(groupCells, normal, offset, v0, normalCell, offsetCell, offsetTolerance, planeEpsilon)
          if invalid = target
            target = {normal: normal, offset: offset, index: groups.Count(), polygons: []} as PanelPlaneGroup
            groups.push(target)
            half = normalCell / 2
            key = getPlaneNormalKey(Int((normal.x + half) / normalCell), Int((normal.y + half) / normalCell), Int((normal.z + half) / normalCell)) + Int(offset / offsetCell).toStr()
            if not groupCells.DoesExist(key)
              groupCells[key] = []
            end if
            groupCells[key].push(target)
          end if
          target.polygons.push({ids: ids, hasInnerVertices: false, alive: true})
        end if
      end if
    end for

    for each group in groups
      mergePanelPolygons(group.polygons, welder.points, group.normal)
      for each polygon in group.polygons
        if polygon.alive
          vertices = getPanelCorners(polygon.ids, welder.points, group.normal)
          if vertices.Count() >= 3
            panels.push({vertices: vertices, normal: group.normal, hasInnerVertices: polygon.hasInnerVertices})
          end if
        end if
      end for
    end for
    return panels
  end function

  ' The first-made group whose plane `v0` lies on with a normal within tolerance, looking
  ' only in the cells that could hold one.
  function findPlaneGroup(groupCells as roAssociativeArray, normal as BGE.Math.Vector, offset as float, v0 as BGE.Math.Vector, normalCell as float, offsetCell as float, offsetTolerance as float, planeEpsilon as float) as dynamic
    found = invalid
    tolerance = BGE.Occlusion.PANEL_NORMAL_TOLERANCE
    lowO = getNearCellLow(offset, offsetCell, offsetTolerance)
    highO = getNearCellHigh(offset, offsetCell, offsetTolerance)
    half = normalCell / 2
    for cx = getNearCellLow(normal.x + half, normalCell, tolerance) to getNearCellHigh(normal.x + half, normalCell, tolerance)
      for cy = getNearCellLow(normal.y + half, normalCell, tolerance) to getNearCellHigh(normal.y + half, normalCell, tolerance)
        for cz = getNearCellLow(normal.z + half, normalCell, tolerance) to getNearCellHigh(normal.z + half, normalCell, tolerance)
          prefix = getPlaneNormalKey(cx, cy, cz)
          for co = lowO to highO
            bucket = groupCells[prefix + co.toStr()]
            if invalid <> bucket
              for each group in bucket
                if invalid = found or group.index < found.index
                  groupNormal = group.normal
                  if normal.x * groupNormal.x + normal.y * groupNormal.y + normal.z * groupNormal.z > 0.999 and Abs(groupNormal.x * v0.x + groupNormal.y * v0.y + groupNormal.z * v0.z - group.offset) < planeEpsilon
                    found = group
                  end if
                end if
              end for
            end if
          end for
        end for
      end for
    end for
    return found
  end function

  ' unit normals' cells are within +-9 per axis, so one number names all three
  function getPlaneNormalKey(cx as integer, cy as integer, cz as integer) as string
    return (((cx + 16) * 32 + cy + 16) * 32 + cz + 16).toStr() + ","
  end function

  ' The cell `value` is in, or the one below if it's within `tolerance` of that edge.
  ' Cells are over twice the tolerance, so at most one neighbour can be that near.
  function getNearCellLow(value as float, cellSize as float, tolerance as float) as integer
    cell = Int(value / cellSize)
    if value - cell * cellSize < tolerance
      return cell - 1
    end if
    return cell
  end function

  ' The cell `value` is in, or the one above if it's within `tolerance` of that edge.
  function getNearCellHigh(value as float, cellSize as float, tolerance as float) as integer
    cell = Int(value / cellSize)
    if (cell + 1) * cellSize - value < tolerance
      return cell + 1
    end if
    return cell
  end function

  ' The id of the first-seen position within the welder's epsilon of `v`, adding it if none.
  function weldVertex(welder as PanelVertexWelder, v as BGE.Math.Vector) as integer
    cellSize = welder.cellSize
    epsilon = welder.epsilon
    epsilonSquared = epsilon * epsilon
    points = welder.points
    cells = welder.cells
    found = -1
    lowZ = getNearCellLow(v.z, cellSize, epsilon)
    highZ = getNearCellHigh(v.z, cellSize, epsilon)
    for cx = getNearCellLow(v.x, cellSize, epsilon) to getNearCellHigh(v.x, cellSize, epsilon)
      for cy = getNearCellLow(v.y, cellSize, epsilon) to getNearCellHigh(v.y, cellSize, epsilon)
        prefix = cx.toStr() + "," + cy.toStr() + ","
        for cz = lowZ to highZ
          bucket = cells[prefix + cz.toStr()]
          if invalid <> bucket
            for each id in bucket
              if found < 0 or id < found
                p = points[id]
                dx = p.x - v.x
                dy = p.y - v.y
                dz = p.z - v.z
                if dx * dx + dy * dy + dz * dz <= epsilonSquared
                  found = id
                end if
              end if
            end for
          end if
        end for
      end for
    end for
    if found >= 0
      return found
    end if
    found = points.Count()
    points.push(v)
    key = Int(v.x / cellSize).toStr() + "," + Int(v.y / cellSize).toStr() + "," + Int(v.z / cellSize).toStr()
    if not cells.DoesExist(key)
      cells[key] = []
    end if
    cells[key].push(found)
    return found
  end function

  ' Greedily merges polygons that share an edge while the result stays convex, until no
  ' neighbouring pair can merge. Each directed edge a -> b is listed under a with the
  ' polygon that first had it, followed through `owners` to whichever absorbed that one.
  sub mergePanelPolygons(polygons as PanelPolygon[], points as BGE.Math.Vector[], normal as BGE.Math.Vector)
    edgeEnds = CreateObject("roArray", points.Count(), true)
    edgeOwners = CreateObject("roArray", points.Count(), true)
    owners = CreateObject("roArray", polygons.Count(), true)
    for i = 0 to polygons.Count() - 1
      owners.push(i)
      ids = polygons[i].ids
      for k = 0 to 2
        from = ids[k]
        if invalid = edgeEnds[from]
          edgeEnds[from] = []
          edgeOwners[from] = []
        end if
        edgeEnds[from].push(ids[(k + 1) mod 3])
        edgeOwners[from].push(i)
      end for
    end for

    for i = 0 to polygons.Count() - 1
      ' a merge reshapes the polygon, so an edge that failed may now succeed: repeat
      ' until a pass merges nothing
      mergedInPass = polygons[i].alive
      while mergedInPass
        mergedInPass = false
        k = 0
        while k < polygons[i].ids.Count()
          ids = polygons[i].ids
          a = ids[k]
          b = ids[(k + 1) mod ids.Count()]
          merged = false
          ' the polygon with edge b -> a
          owner = -1
          ends = edgeEnds[b]
          if invalid <> ends
            for e = 0 to ends.Count() - 1
              if ends[e] = a
                owner = edgeOwners[b][e]
                exit for
              end if
            end for
          end if
          if owner >= 0
            j = owner
            while owners[j] <> j
              j = owners[j]
            end while
            owners[owner] = j
            if j <> i
              candidate = mergePanelPolygonsAlong(polygons[i], polygons[j], k, points, normal)
              if invalid <> candidate
                polygons[i] = candidate
                polygons[j].alive = false
                owners[j] = i
                merged = true
                mergedInPass = true
              end if
            end if
          end if
          ' after a merge, edge k leads into the absorbed polygon's corners: check it again
          if not merged
            k++
          end if
        end while
      end while
    end for
  end sub

  ' Joins p and q along p's edge k, which q walks the other way (as same-winding
  ' neighbours do), or returns invalid when q doesn't have it or the union isn't convex.
  ' Two convex polygons share one run of edges at most: the union is both walks without
  ' it, and only the corners at its two ends get new neighbours, so their turns decide
  ' whether it's convex. Corners inside the run end up inside the union.
  function mergePanelPolygonsAlong(p as PanelPolygon, q as PanelPolygon, k as integer, points as BGE.Math.Vector[], normal as BGE.Math.Vector) as dynamic
    pIds = p.ids
    qIds = q.ids
    pCount = pIds.Count()
    qCount = qIds.Count()
    a = pIds[k]
    b = pIds[(k + 1) mod pCount]
    start = -1
    for j = 0 to qCount - 1
      if qIds[j] = b
        if qIds[(j + 1) mod qCount] = a
          start = j
          exit for
        end if
      end if
    end for
    if start < 0
      return invalid
    end if
    ' extend the shared run past a (back) and past b (forward)
    maxExtra = BGE.Math.Min(pCount, qCount) - 2
    back = 0
    while back < maxExtra and pIds[(k - 1 - back + pCount) mod pCount] = qIds[(start + 2 + back) mod qCount]
      back++
    end while
    forward = 0
    while back + forward < maxExtra and pIds[(k + 2 + forward) mod pCount] = qIds[(start - 1 - forward + qCount) mod qCount]
      forward++
    end while

    ' p from the run's b end round to its a end, then q's corners off the run
    pKept = pCount - back - forward
    qKept = qCount - back - forward - 2
    if pKept + qKept < 3
      return invalid
    end if
    endB = (k + 1 + forward) mod pCount
    endA = (k - back + pCount) mod pCount
    beforeA = pIds[(endA - 1 + pCount) mod pCount]
    afterB = pIds[(endB + 1) mod pCount]
    if qKept > 0
      afterA = qIds[(start + 2 + back) mod qCount]
      beforeB = qIds[(start - 1 - forward + qCount) mod qCount]
    else
      afterA = pIds[endB]
      beforeB = pIds[endA]
    end if
    if getPanelTurnSine(points[beforeA], points[pIds[endA]], points[afterA], normal) <= -BGE.Occlusion.PANEL_TURN_EPSILON
      return invalid
    end if
    if getPanelTurnSine(points[beforeB], points[pIds[endB]], points[afterB], normal) <= -BGE.Occlusion.PANEL_TURN_EPSILON
      return invalid
    end if

    ' p's corners in p's order with q's spliced in after the run's a end, so the merge
    ' loop's place in p's edges still means the same edges
    ids = CreateObject("roArray", pKept + qKept, true)
    if endA < endB
      for i = 0 to endA
        ids.push(pIds[i])
      end for
      for i = 0 to qKept - 1
        ids.push(qIds[(start + 2 + back + i) mod qCount])
      end for
      for i = endB to pCount - 1
        ids.push(pIds[i])
      end for
    else
      for i = endB to endA
        ids.push(pIds[i])
      end for
      for i = 0 to qKept - 1
        ids.push(qIds[(start + 2 + back + i) mod qCount])
      end for
    end if
    return {ids: ids, hasInnerVertices: p.hasInnerVertices or q.hasInnerVertices or back + forward > 0, alive: true}
  end function

  ' A polygon's corners without the straight ones along its edges. Dropping a straight
  ' corner leaves its neighbours' turns as they were, so one pass does it.
  function getPanelCorners(ids as integer[], points as BGE.Math.Vector[], normal as BGE.Math.Vector) as BGE.Math.Vector[]
    corners = []
    count = ids.Count()
    for i = 0 to count - 1
      corner = points[ids[i]]
      if Abs(getPanelTurnSine(points[ids[(i + count - 1) mod count]], corner, points[ids[(i + 1) mod count]], normal)) >= BGE.Occlusion.PANEL_TURN_EPSILON
        corners.push(corner)
      end if
    end for
    return corners
  end function

  ' The turn at b (coming from a, going to c), signed against the plane normal and
  ' scaled by the edge lengths so it is the sine of the angle.
  function getPanelTurnSine(a as BGE.Math.Vector, b as BGE.Math.Vector, c as BGE.Math.Vector, normal as BGE.Math.Vector) as float
    e1x = b.x - a.x
    e1y = b.y - a.y
    e1z = b.z - a.z
    e2x = c.x - b.x
    e2y = c.y - b.y
    e2z = c.z - b.z
    lengths = Sqr((e1x * e1x + e1y * e1y + e1z * e1z) * (e2x * e2x + e2y * e2y + e2z * e2z))
    if lengths = 0
      return 0.0
    end if
    return ((e1y * e2z - e1z * e2y) * normal.x + (e1z * e2x - e1x * e2z) * normal.y + (e1x * e2y - e1y * e2x) * normal.z) / lengths
  end function

end namespace
