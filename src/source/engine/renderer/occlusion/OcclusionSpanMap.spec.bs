import "OcclusionSpanMap.bs"

namespace tests

  @suite("BGE.OcclusionSpanMap")
  class OcclusionSpanMapTests extends rooibos.BaseTestSuite

    map as BGE.OcclusionSpanMap

    protected override function beforeEach()
      m.map = new BGE.OcclusionSpanMap(1280, 720, 45)
    end function

    private function quad(x0 as float, y0 as float, x1 as float, y1 as float, depth as float) as BGE.OccluderPolygon
      return {xs: [x0, x1, x1, x0], ys: [y0, y0, y1, y1], depth: depth, area: (x1 - x0) * (y1 - y0)}
    end function

    @describe("isHidden")

    @it("hides a box fully inside one nearer quad")
    function _()
      m.map.build([m.quad(100, 100, 600, 500, 10)])
      m.assertTrue(m.map.isHidden(200, 200, 300, 300, 20))
    end function

    @it("does not hide an object nearer than the occluder")
    function _()
      m.map.build([m.quad(100, 100, 600, 500, 10)])
      m.assertFalse(m.map.isHidden(200, 200, 300, 300, 5))
    end function

    @it("hides a box covered only by the union of two touching quads")
    function _()
      m.map.build([m.quad(100, 100, 400, 500, 10), m.quad(400, 100, 700, 500, 12)])
      m.assertTrue(m.map.isHidden(350, 200, 450, 300, 20))
      ' A merged range keeps the farthest depth.
      m.assertFalse(m.map.isHidden(350, 200, 450, 300, 11))
    end function

    @it("does not hide across a gap between two occluders")
    function _()
      m.map.build([m.quad(100, 100, 399, 500, 10), m.quad(401, 100, 700, 500, 10)])
      m.assertFalse(m.map.isHidden(350, 200, 450, 300, 20))
    end function

    @it("does not hide a box poking out of the occluder")
    function _()
      m.map.build([m.quad(100, 100, 600, 500, 10)])
      m.assertFalse(m.map.isHidden(550, 200, 650, 300, 20))
    end function

    @it("only counts bands lying wholly inside a triangle")
    function _()
      m.map.build([{xs: [100.0, 700.0, 400.0], ys: [100.0, 100.0, 600.0], depth: 10.0, area: 150000.0}])
      m.assertFalse(m.map.isHidden(390, 560, 410, 590, 20))
      m.assertTrue(m.map.isHidden(380, 150, 420, 200, 20))
    end function

    @it("treats a box spanning several bands as hidden only if every band covers it")
    function _()
      m.map.build([m.quad(100, 100, 600, 500, 10)])
      m.assertFalse(m.map.isHidden(200, 90, 300, 300, 20))
    end function

    @it("never hides a box that extends off the canvas")
    function _()
      m.map.build([m.quad(0, 0, 1280, 720, 10)])
      m.assertFalse(m.map.isHidden(-10, 200, 50, 300, 20))
    end function

    @it("hides nothing when built with no polygons")
    function _()
      m.map.build([])
      m.assertFalse(m.map.isHidden(200, 200, 300, 300, 20))
    end function

    @it("rebuilding replaces the previous frame's spans")
    function _()
      m.map.build([m.quad(100, 100, 600, 500, 10)])
      m.map.build([])
      m.assertFalse(m.map.isHidden(200, 200, 300, 300, 20))
    end function

    @describe("band accessors")

    @it("reports band height and count")
    function _()
      m.assertEqual(m.map.getBandCount(), 45)
      m.assertEqual(m.map.getBandHeight(), 16.0)
    end function

  end class

end namespace
