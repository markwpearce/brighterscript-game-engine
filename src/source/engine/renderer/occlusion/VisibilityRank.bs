import "OcclusionTypes.bs"

namespace BGE

  ' Returns whichever state is more visible, in the order visible > occluded > offCamera >
  ' unknown. Used to roll a SceneObject's state up into its Drawable and GameEntity.
  '
  ' @param {BGE.VisibilityState} a
  ' @param {BGE.VisibilityState} b
  ' @return {BGE.VisibilityState}
  function mostVisibleState(a as BGE.VisibilityState, b as BGE.VisibilityState) as BGE.VisibilityState
    if BGE.visibilityRank(b) > BGE.visibilityRank(a)
      return b
    end if
    return a
  end function

  function visibilityRank(state as BGE.VisibilityState) as integer
    if state = BGE.VisibilityState.visible
      return 3
    else if state = BGE.VisibilityState.occluded
      return 2
    else if state = BGE.VisibilityState.offCamera
      return 1
    end if
    return 0
  end function

end namespace
