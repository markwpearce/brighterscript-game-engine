import "ConvexInset.bs"

namespace tests

  @suite("BGE.Occlusion.insetConvexPolygon")
  class ConvexInsetTests extends rooibos.BaseTestSuite

    ' Whether the polygon has a vertex within 0.001 of (x, y).
    private function hasVertex(polygon as BGE.CanvasPolygon, x as float, y as float) as boolean
      for i = 0 to polygon.xs.count() - 1
        if Abs(polygon.xs[i] - x) < 0.001 and Abs(polygon.ys[i] - y) < 0.001
          return true
        end if
      end for
      return false
    end function

    @describe("insetting")

    @it("insets a square on every side")
    function _()
      inset = BGE.Occlusion.insetConvexPolygon([0.0, 10.0, 10.0, 0.0], [0.0, 0.0, 10.0, 10.0], 2)
      m.assertNotInvalid(inset)
      m.assertEqual(4, inset.xs.count())
      m.assertTrue(m.hasVertex(inset, 2, 2))
      m.assertTrue(m.hasVertex(inset, 8, 2))
      m.assertTrue(m.hasVertex(inset, 8, 8))
      m.assertTrue(m.hasVertex(inset, 2, 8))
    end function

    @it("insets a square wound the other way the same")
    function _()
      inset = BGE.Occlusion.insetConvexPolygon([0.0, 0.0, 10.0, 10.0], [0.0, 10.0, 10.0, 0.0], 2)
      m.assertNotInvalid(inset)
      m.assertEqual(4, inset.xs.count())
      m.assertTrue(m.hasVertex(inset, 2, 2))
      m.assertTrue(m.hasVertex(inset, 8, 2))
      m.assertTrue(m.hasVertex(inset, 8, 8))
      m.assertTrue(m.hasVertex(inset, 2, 8))
    end function

    @it("insets a triangle's slanted edge by its perpendicular distance")
    function _()
      corner = 11 - Sqr(2)
      for each points in [[[0.0, 12.0, 0.0], [0.0, 0.0, 12.0]], [[0.0, 0.0, 12.0], [0.0, 12.0, 0.0]]]
        inset = BGE.Occlusion.insetConvexPolygon(points[0], points[1], 1)
        m.assertNotInvalid(inset)
        m.assertEqual(3, inset.xs.count())
        m.assertTrue(m.hasVertex(inset, 1, 1))
        m.assertTrue(m.hasVertex(inset, corner, 1))
        m.assertTrue(m.hasVertex(inset, 1, corner))
      end for
    end function

    @it("ignores a vertex lying on an edge")
    function _()
      inset = BGE.Occlusion.insetConvexPolygon([0.0, 5.0, 10.0, 10.0, 0.0], [0.0, 0.0, 0.0, 10.0, 10.0], 2)
      m.assertNotInvalid(inset)
      m.assertEqual(4, inset.xs.count())
      m.assertTrue(m.hasVertex(inset, 8, 8))
    end function

    @it("returns the polygon unchanged for an inset of 0")
    function _()
      inset = BGE.Occlusion.insetConvexPolygon([0.0, 10.0, 10.0, 0.0], [0.0, 0.0, 10.0, 10.0], 0)
      m.assertNotInvalid(inset)
      m.assertTrue(m.hasVertex(inset, 0, 0))
      m.assertTrue(m.hasVertex(inset, 10, 10))
    end function

    @describe("collapsing")

    @it("returns invalid once the inset reaches the middle of a square")
    function _()
      m.assertInvalid(BGE.Occlusion.insetConvexPolygon([0.0, 10.0, 10.0, 0.0], [0.0, 0.0, 10.0, 10.0], 5))
      m.assertInvalid(BGE.Occlusion.insetConvexPolygon([0.0, 0.0, 10.0, 10.0], [0.0, 10.0, 10.0, 0.0], 6))
    end function

    @it("returns invalid when a long thin quad is narrower than twice the inset")
    function _()
      m.assertInvalid(BGE.Occlusion.insetConvexPolygon([0.0, 100.0, 100.0, 0.0], [0.0, 0.0, 3.0, 3.0], 2))
    end function

    @it("returns invalid once the inset passes a triangle's inradius")
    function _()
      ' inradius of this right triangle is 12 - 6 * sqrt(2), about 3.5
      m.assertInvalid(BGE.Occlusion.insetConvexPolygon([0.0, 12.0, 0.0], [0.0, 0.0, 12.0], 4))
      m.assertNotInvalid(BGE.Occlusion.insetConvexPolygon([0.0, 12.0, 0.0], [0.0, 0.0, 12.0], 3))
    end function

    @it("returns invalid for fewer than 3 distinct corners")
    function _()
      m.assertInvalid(BGE.Occlusion.insetConvexPolygon([0.0, 10.0, 20.0], [0.0, 0.0, 0.0], 1))
      m.assertInvalid(BGE.Occlusion.insetConvexPolygon([0.0, 10.0], [0.0, 0.0], 0))
    end function

    @describe("area")

    @it("measures area in either winding")
    function _()
      m.assertEqual(100.0, BGE.Occlusion.getPolygonArea([0.0, 10.0, 10.0, 0.0], [0.0, 0.0, 10.0, 10.0]))
      m.assertEqual(100.0, BGE.Occlusion.getPolygonArea([0.0, 0.0, 10.0, 10.0], [0.0, 10.0, 10.0, 0.0]))
    end function

  end class

end namespace
