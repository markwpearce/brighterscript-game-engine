import "OcclusionTypes.bs"

namespace BGE

  ' Per horizontal band of the canvas, the merged x ranges that occluders cover across the
  ' whole band, each with the farthest depth of the occluders merged into it (conservative).
  ' An object is hidden only if one merged range covers it in every band it touches.
  class OcclusionSpanMap

    private width as float
    private height as float
    private bandHeight as float
    private bandCount as integer
    ' Per band, a flat [left, right, depth, left, right, depth, ...] list.
    private bandSpans as object[] = []
    ' The nearest depth of any span, 1e30 with no spans.
    private nearestDepth as float = 1e30

    ' @param width - canvas width in pixels
    ' @param height - canvas height in pixels
    ' @param bandCount - number of horizontal bands the canvas is divided into
    sub new(width as float, height as float, bandCount as integer)
      m.width = width
      m.height = height
      m.bandCount = bandCount
      m.bandHeight = height / bandCount
    end sub

    ' Rebuilds the map from this frame's occluders, replacing the previous frame's spans.
    ' @param polygons - convex canvas-space occluders
    sub build(polygons as BGE.OccluderPolygon[])
      if m.bandSpans.count() <> m.bandCount
        m.bandSpans = []
        for r = 0 to m.bandCount - 1
          m.bandSpans.push([])
        end for
      else
        for each row in m.bandSpans
          row.Clear()
        end for
      end if
      bandHeight = m.bandHeight
      lastBand = m.bandCount - 1
      for each poly in polygons
        xs = poly.xs
        ys = poly.ys
        n = xs.count()
        top = 0
        bottom = 0
        for i = 1 to n - 1
          if ys[i] < ys[top]
            top = i
          end if
          if ys[i] > ys[bottom]
            bottom = i
          end if
        end for
        ' Only bands lying wholly inside the polygon's y range can be fully covered.
        r0 = Int(ys[top] / bandHeight)
        if r0 * bandHeight < ys[top]
          r0++
        end if
        r1 = Int(ys[bottom] / bandHeight) - 1
        if r0 < 0
          r0 = 0
        end if
        if r1 > lastBand
          r1 = lastBand
        end if
        if r1 >= r0
          boundaries = r1 - r0 + 2
          y0 = r0 * bandHeight
          ' A convex polygon splits into two y-monotonic chains from top to bottom vertex.
          a = m.chainXs(xs, ys, top, bottom, 1, y0, bandHeight, boundaries)
          b = m.chainXs(xs, ys, top, bottom, -1, y0, bandHeight, boundaries)
          for k = 0 to boundaries - 2
            ' Each chain is linear between vertices, so a band's inner bound is at one of its ends.
            a0 = a[k]
            a1 = a[k + 1]
            b0 = b[k]
            b1 = b[k + 1]
            if a0 < b0
              l = a0
              if a1 > l
                l = a1
              end if
              rr = b0
              if b1 < rr
                rr = b1
              end if
            else
              l = b0
              if b1 > l
                l = b1
              end if
              rr = a0
              if a1 < rr
                rr = a1
              end if
            end if
            if rr > l
              m.insertSpan(m.bandSpans[r0 + k], l, rr, poly.depth)
            end if
          end for
        end if
      end for
      ' merging keeps the farther depth, so read it back from the spans
      m.nearestDepth = 1e30
      for each row in m.bandSpans
        for i = 2 to row.count() - 1 step 3
          if row[i] < m.nearestDepth
            m.nearestDepth = row[i]
          end if
        end for
      end for
    end sub

    ' The nearest depth any span claims. An object reaching this near can't be hidden.
    ' @return a very large number when the map is empty
    function getNearestDepth() as float
      return m.nearestDepth
    end function

    ' Whether a span strictly nearer than `depth` covers the canvas point. An object that
    ' draws over this point no nearer than `depth` can only be hidden if it is.
    ' @param x - canvas x
    ' @param y - canvas y
    ' @param depth - the depth to compare spans against
    ' @return {boolean}
    function isPointCovered(x as float, y as float, depth as float) as boolean
      if x < 0 or y < 0 or x > m.width or y > m.height
        return false
      end if
      r = Int(y / m.bandHeight)
      if r > m.bandCount - 1
        r = m.bandCount - 1
      end if
      spans = m.bandSpans[r]
      for i = 0 to spans.count() - 1 step 3
        if spans[i] <= x and spans[i + 1] >= x and spans[i + 2] < depth
          return true
        end if
      end for
      return false
    end function

    ' True only if the box is covered in every band it touches by one merged span whose depth
    ' is strictly nearer than nearestDepth. A box extending off the canvas is never hidden.
    ' The caller inflates the box by any safety margin first.
    ' @param minX - left edge of the box
    ' @param minY - top edge of the box
    ' @param maxX - right edge of the box
    ' @param maxY - bottom edge of the box
    ' @param nearestDepth - depth of the nearest point of the object
    ' @return true if the object is certainly hidden
    function isHidden(minX as float, minY as float, maxX as float, maxY as float, nearestDepth as float) as boolean
      if minX < 0 or minY < 0 or maxX > m.width or maxY > m.height
        return false
      end if
      ' An empty or inverted box would pass the band loop vacuously.
      if maxX <= minX or maxY <= minY
        return false
      end if
      r0 = Int(minY / m.bandHeight)
      r1 = Int(maxY / m.bandHeight)
      if r1 * m.bandHeight = maxY
        r1--
      end if
      if r1 > m.bandCount - 1
        r1 = m.bandCount - 1
      end if
      if r1 < r0
        return false
      end if
      for r = r0 to r1
        spans = m.bandSpans[r]
        found = false
        for i = 0 to spans.count() - 1 step 3
          if spans[i] <= minX and spans[i + 1] >= maxX and spans[i + 2] < nearestDepth
            found = true
            exit for
          end if
        end for
        if not found
          return false
        end if
      end for
      return true
    end function

    ' @return the height of each band in pixels
    function getBandHeight() as float
      return m.bandHeight
    end function

    ' @return the number of bands
    function getBandCount() as integer
      return m.bandCount
    end function

    ' @param band - band index, 0 at the top
    ' @return the band's merged spans as a flat [left, right, depth, ...] list, for debug drawing
    function getBandSpans(band as integer) as float[]
      return m.bandSpans[band]
    end function

    ' x of the chain walked from vertex `top` in direction `dir` (+1/-1) at y = y0 + k*stepY.
    private function chainXs(xs as float[], ys as float[], top as integer, bottom as integer, dir as integer, y0 as float, stepY as float, count as integer) as float[]
      n = xs.count()
      result = CreateObject("roArray", count, false)
      i = top
      j = (i + dir + n) mod n
      y = y0
      for k = 0 to count - 1
        while ys[j] < y and j <> bottom
          i = j
          j = (i + dir + n) mod n
        end while
        dy = ys[j] - ys[i]
        if dy > 0
          result.push(xs[i] + (y - ys[i]) * (xs[j] - xs[i]) / dy)
        else
          result.push(xs[j])
        end if
        y += stepY
      end for
      return result
    end function

    ' Inserts [l, r] into a band's sorted, merged flat span list, merging any it touches.
    private sub insertSpan(row as object, l as float, r as float, d as float)
      n = row.count()
      i = 0
      while i < n and row[i + 1] < l
        i += 3
      end while
      if i = n
        row.push(l)
        row.push(r)
        row.push(d)
        return
      end if
      j = i
      while j < n and row[j] <= r
        if row[j] < l
          l = row[j]
        end if
        if row[j + 1] > r
          r = row[j + 1]
        end if
        if row[j + 2] > d
          d = row[j + 2]
        end if
        j += 3
      end while
      rebuilt = []
      for k = 0 to i - 1
        rebuilt.push(row[k])
      end for
      rebuilt.push(l)
      rebuilt.push(r)
      rebuilt.push(d)
      for k = j to n - 1
        rebuilt.push(row[k])
      end for
      row.Clear()
      row.append(rebuilt)
    end sub

  end class

end namespace
