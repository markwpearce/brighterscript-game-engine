import "OcclusionTypes.bs"

namespace BGE.Occlusion

  ' Shrinks a convex canvas-space polygon by moving every edge `distance` px inward.
  '
  ' @param {float[]} xs vertex x coordinates, in order around the polygon (either winding)
  ' @param {float[]} ys vertex y coordinates
  ' @param {float} distance how far to move each edge in; 0 or less returns the polygon as is
  ' @return {BGE.CanvasPolygon} the shrunk polygon, or invalid if it has fewer than 3 distinct corners or the inset would collapse it
  function insetConvexPolygon(xs as float[], ys as float[], distance as float) as BGE.CanvasPolygon
    corners = dropFlatCorners(xs, ys)
    if invalid = corners
      return invalid
    end if
    px = corners.xs
    py = corners.ys
    count = px.count()
    if distance <= 0
      return corners
    end if
    ' +1 when the interior is to the left of each edge (counter-clockwise with y up)
    windingSign = 1.0
    if getSignedDoubleArea(px, py) < 0
      windingSign = -1.0
    end if

    ' each edge i runs from corner i to corner i + 1; its offset line passes through (ox, oy)
    ex = [] as float[]
    ey = [] as float[]
    ox = [] as float[]
    oy = [] as float[]
    for i = 0 to count - 1
      j = (i + 1) mod count
      dx = px[j] - px[i]
      dy = py[j] - py[i]
      length = Sqr(dx * dx + dy * dy)
      ex.push(dx)
      ey.push(dy)
      ox.push(px[i] - windingSign * dy / length * distance)
      oy.push(py[i] + windingSign * dx / length * distance)
    end for

    ' corner i is where the offset lines of edges i - 1 and i meet
    insetXs = [] as float[]
    insetYs = [] as float[]
    for i = 0 to count - 1
      k = (i + count - 1) mod count
      denominator = ex[k] * ey[i] - ey[k] * ex[i]
      t = ((ox[i] - ox[k]) * ey[i] - (oy[i] - oy[k]) * ex[i]) / denominator
      insetXs.push(ox[k] + t * ex[k])
      insetYs.push(oy[k] + t * ey[k])
    end for

    ' an edge that now points backwards has been squeezed out, so the polygon has collapsed
    for i = 0 to count - 1
      j = (i + 1) mod count
      if (insetXs[j] - insetXs[i]) * ex[i] + (insetYs[j] - insetYs[i]) * ey[i] <= 0
        return invalid
      end if
    end for
    return {xs: insetXs, ys: insetYs}
  end function

  ' The area of a simple canvas-space polygon, in either winding.
  '
  ' @param {float[]} xs
  ' @param {float[]} ys
  ' @return {float}
  function getPolygonArea(xs as float[], ys as float[]) as float
    return Abs(getSignedDoubleArea(xs, ys)) / 2
  end function

  ' Twice the polygon's signed area (shoelace), positive when counter-clockwise with y up.
  function getSignedDoubleArea(xs as float[], ys as float[]) as float
    twiceArea = 0.0
    count = xs.count()
    for i = 0 to count - 1
      j = (i + 1) mod count
      twiceArea += xs[i] * ys[j] - xs[j] * ys[i]
    end for
    return twiceArea
  end function

  ' A copy of the polygon without repeated or (nearly) collinear corners, which have no
  ' edge direction to offset. Dropping one only trims a sliver off a convex polygon.
  ' invalid when fewer than 3 corners remain.
  function dropFlatCorners(xs as float[], ys as float[]) as BGE.CanvasPolygon
    px = [] as float[]
    py = [] as float[]
    for i = 0 to xs.count() - 1
      px.push(xs[i] * 1.0)
      py.push(ys[i] * 1.0)
    end for
    dropped = true
    while dropped and px.count() >= 3
      dropped = false
      count = px.count()
      for i = 0 to count - 1
        k = (i + count - 1) mod count
        j = (i + 1) mod count
        ax = px[i] - px[k]
        ay = py[i] - py[k]
        bx = px[j] - px[i]
        by = py[j] - py[i]
        lengths = Sqr(ax * ax + ay * ay) * Sqr(bx * bx + by * by)
        if lengths < 0.000001 or Abs(ax * by - ay * bx) / lengths < 0.0001
          px.Delete(i)
          py.Delete(i)
          dropped = true
          exit for
        end if
      end for
    end while
    if px.count() < 3
      return invalid
    end if
    return {xs: px, ys: py}
  end function

end namespace
