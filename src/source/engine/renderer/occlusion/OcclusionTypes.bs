import "../../../math/vector.bs"

namespace BGE

  ' Whether a SceneObject was drawn, hidden or off camera last frame. Ordered by how
  ' visible each is, so the most visible of several states is simply the largest.
  enum VisibilityState
    unknown = 0
    offCamera = 1
    occluded = 2
    visible = 3
  end enum

  ' How occluders draw while occlusion culling relies on them (see Renderer.occluderDrawPolicy).
  enum OccluderDrawPolicy
    ' Occluders always draw exactly - no reused bitmaps, image fast path or coarse fills -
    ' and claim their exact outline. Slowest, never glitches.
    exact = "exact"
    ' Occluders take the fast draw paths, and while one may run each occluder's claim is
    ' shrunk by that path's worst error, so nothing it doesn't paint is hidden.
    fastShrink = "fastShrink"
    ' Occluders take the fast draw paths but still claim their exact outline, so an object
    ' just behind an occluder's edge can be hidden for a frame while the camera moves.
    fastExactClaim = "fastExactClaim"
  end enum

  ' A convex canvas-space polygon that is guaranteed to hide whatever lies behind it.
  interface OccluderPolygon extends roAssociativeArray
    ' Canvas-space vertices, either winding, 3 or more points.
    xs as float[]
    ys as float[]
    ' The farthest vertex's distanceFromCameraFront.
    depth as float
    ' Projected area, used to keep the largest occluders when capping their number.
    area as float
  end interface

  ' A canvas-space polygon, its vertices in order around it.
  interface CanvasPolygon extends roAssociativeArray
    xs as float[]
    ys as float[]
  end interface

  ' A canvas-space box an object was tested against the occlusion map with.
  interface OcclusionTestBounds extends roAssociativeArray
    minX as float
    minY as float
    maxX as float
    maxY as float
  end interface

  ' A convex, opaque face of a model, in model-local space.
  interface OccluderPanel extends roAssociativeArray
    ' Ordered around the perimeter.
    vertices as BGE.Math.Vector[]
    normal as BGE.Math.Vector
    ' Whether a source triangle has a corner inside the panel rather than on its edge.
    hasInnerVertices as boolean
  end interface

end namespace
