import "../drawables/DrawableRectangle.bs"
import "cameras/Camera3d.bs"
import "Fog.bs"

namespace tests

  @suite("BGE.Fog")
  class FogTests extends rooibos.BaseTestSuite

    @describe("defaults")

    @it("is off with no backdrop and a 2x reach")
    function _()
      f = new BGE.Fog()
      m.assertFalse(f.enabled)
      m.assertEqual(&h808080, f.color)
      m.assertEqual(0.0, f.backdropHeight)
      m.assertEqual(2.0, f.silhouetteReach)
      m.assertEqual(1.0, f.silhouetteStartAlpha)
      m.assertInvalid(f.backdropRegion)
    end function

    @it("is on every Camera3d, off")
    function _()
      cam = new BGE.Camera3d()
      m.assertNotInvalid(cam.fog)
      m.assertFalse(cam.fog.enabled)
    end function

    @it("is off on every drawable")
    function _()
      rect = new BGE.DrawableRectangle(invalid, 10, 10)
      m.assertFalse(rect.castsFogSilhouette)
    end function

  end class

end namespace
