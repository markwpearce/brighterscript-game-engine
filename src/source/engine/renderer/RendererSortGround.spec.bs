namespace tests

  ' Issue #564: with the camera tilted down, the view depth counts a higher point as nearer,
  ' so a tall object's centre sorts in front of a shorter one standing nearer the camera.
  ' Camera.sortsByGroundDistance sorts by the distance across the ground instead.
  @suite("BGE.Renderer sorting by ground distance")
  class RendererSortGroundTests extends rooibos.BaseTestSuite

    game as BGE.Game
    camera as BGE.Camera3d
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.camera = new BGE.Camera3d()
      ' 45 degrees down
      m.camera.position = BGE.Math.VectorOps.create(0, 200, 0)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, -200))
      m.camera.drawDistanceTransitionSeconds = 0
      m.renderer = new BGE.Renderer(CreateObject("roBitmap", {width: 320, height: 240, alphaEnable: true}), m.game, m.camera)
      ' a post's centre high up and 300 ahead; the knight's lower and 280 ahead, in front of it
      m.addImage("post", 100, -300)
      m.addImage("knight", 0, -280)
    end function

    ' Ownerless, so it settles (an entity outside the game loop never does), and named
    private sub addImage(name as string, y as float, z as float)
      bitmap = CreateObject("roBitmap", {width: 16, height: 16, alphaEnable: true})
      image = new BGE.Image(invalid, CreateObject("roRegion", bitmap, 0, 0, 16, 16), {drawMode: BGE.SceneObjectDrawMode.directScaled})
      image.offset = BGE.Math.VectorOps.create(0, y, z)
      image.name = name
      image.addToRenderer(m.renderer)
    end sub

    ' The name of the drawable drawn last (nearest), after a frame
    private function drawnLast() as string
      m.renderer.setupCameraForFrame()
      m.renderer.render()
      objects = m.renderer.getSceneObjectsCopy()
      return objects[objects.count() - 1].drawable.name
    end function

    @describe("a tall object behind a short one, the camera tilted down")

    @it("draws the tall one over the short one by view depth")
    function _()
      m.assertEqual(m.drawnLast(), "post")
    end function

    @it("draws the short one, nearer across the ground, over the tall one with sortsByGroundDistance")
    function _()
      m.camera.sortsByGroundDistance = true
      m.assertEqual(m.drawnLast(), "knight")
    end function

    @it("re-sorts when the flag is turned, with nothing moving")
    function _()
      ' until everything has settled, so nothing re-keys by moving
      for i = 1 to 4
        m.assertEqual(m.drawnLast(), "post")
      end for
      m.camera.sortsByGroundDistance = true
      m.assertEqual(m.drawnLast(), "knight")
      m.camera.sortsByGroundDistance = false
      m.assertEqual(m.drawnLast(), "post")
    end function

  end class

end namespace
