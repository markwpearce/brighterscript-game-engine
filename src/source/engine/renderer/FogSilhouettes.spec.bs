import "../../math/vector.bs"
import "../drawables/Model3d.bs"
import "FogSilhouettes.bs"

namespace tests

  @suite("BGE.FogSilhouettes")
  class FogSilhouettesTests extends rooibos.BaseTestSuite

    ' The 12 triangles of an axis-aligned box
    private function boxFaces(loX as float, loY as float, loZ as float, hiX as float, hiY as float, hiZ as float) as BGE.Model3dFace[]
      c = [] as BGE.Math.Vector[]
      for each y in [loY, hiY]
        for each z in [loZ, hiZ]
          for each x in [loX, hiX]
            c.push(BGE.Math.VectorOps.create(x, y, z))
          end for
        end for
      end for
      ' corner index = x + 2z + 4y
      quads = [[0, 1, 3, 2], [4, 5, 7, 6], [0, 1, 5, 4], [2, 3, 7, 6], [0, 2, 6, 4], [1, 3, 7, 5]]
      faces = [] as BGE.Model3dFace[]
      for each q in quads
        faces.push(BGE.Model3dFaceOps.create([c[q[0]], c[q[1]], c[q[2]]]))
        faces.push(BGE.Model3dFaceOps.create([c[q[0]], c[q[2]], c[q[3]]]))
      end for
      return faces
    end function

    ' Whether [x, y, z, ...] holds this point
    private function hasPoint(points as float[], x as float, y as float, z as float) as boolean
      for i = 0 to points.count() - 1 step 3
        if points[i] = x and points[i + 1] = y and points[i + 2] = z
          return true
        end if
      end for
      return false
    end function

    private function tri(a as BGE.Math.Vector, b as BGE.Math.Vector, c as BGE.Math.Vector) as BGE.Model3dFace
      return BGE.Model3dFaceOps.create([a, b, c])
    end function

    @describe("modelParts")

    @it("keeps a plain box as one part")
    function _()
      parts = BGE.FogSilhouettes.modelParts(m.boxFaces(0, 0, 0, 10, 10, 10))
      m.assertEqual([0.0, 0.0, 0.0, 10.0, 10.0, 10.0], parts)
    end function

    @it("splits a tower above a nave into two parts at the nave's top")
    function _()
      faces = m.boxFaces(0, 0, 0, 20, 6, 40)
      faces.append(m.boxFaces(0, 0, 0, 6, 20, 6))
      parts = BGE.FogSilhouettes.modelParts(faces)
      m.assertEqual([0.0, 0.0, 0.0, 20.0, 6.0, 40.0, 0.0, 6.0, 0.0, 6.0, 20.0, 6.0], parts)
    end function

    @it("caps the parts")
    function _()
      faces = [] as BGE.Model3dFace[]
      width = 32.0
      for i = 0 to 4
        faces.append(m.boxFaces(0, i * 4, 0, width, (i + 1) * 4, width))
        width = width / 2
      end for
      parts = BGE.FogSilhouettes.modelParts(faces)
      m.assertEqual(18, parts.count())
      m.assertEqual(20.0, parts[16])
    end function

    @it("keeps a gabled house as one part")
    function _()
      faces = m.boxFaces(0, 0, 0, 10, 6, 10)
      v = BGE.Math.VectorOps.create
      faces.push(m.tri(v(0, 6, 0), v(10, 6, 0), v(5, 9, 0)))
      faces.push(m.tri(v(0, 6, 10), v(10, 6, 10), v(5, 9, 10)))
      faces.push(m.tri(v(0, 6, 0), v(5, 9, 0), v(5, 9, 10)))
      faces.push(m.tri(v(0, 6, 0), v(5, 9, 10), v(0, 6, 10)))
      faces.push(m.tri(v(10, 6, 0), v(5, 9, 0), v(5, 9, 10)))
      faces.push(m.tri(v(10, 6, 0), v(5, 9, 10), v(10, 6, 10)))
      parts = BGE.FogSilhouettes.modelParts(faces)
      m.assertEqual([0.0, 0.0, 0.0, 10.0, 9.0, 10.0], parts)
    end function

    @it("returns no parts for no faces")
    function _()
      m.assertEqual(0, BGE.FogSilhouettes.modelParts([]).count())
    end function

    @it("returns one part for a flat model")
    function _()
      v = BGE.Math.VectorOps.create
      faces = [m.tri(v(0, 2, 0), v(10, 2, 0), v(0, 2, 10)), m.tri(v(10, 2, 0), v(10, 2, 10), v(0, 2, 10))]
      m.assertEqual([0.0, 2.0, 0.0, 10.0, 2.0, 10.0], BGE.FogSilhouettes.modelParts(faces))
    end function

    @describe("modelPartPoints")

    @it("keeps a pointed roof's apex")
    function _()
      faces = m.boxFaces(0, 0, 0, 10, 6, 10)
      v = BGE.Math.VectorOps.create
      apex = v(5, 9, 5)
      corners = [v(0, 6, 0), v(10, 6, 0), v(10, 6, 10), v(0, 6, 10)]
      for i = 0 to 3
        faces.push(m.tri(corners[i], corners[(i + 1) mod 4], apex))
      end for
      parts = BGE.FogSilhouettes.modelParts(faces)
      points = BGE.FogSilhouettes.modelPartPoints(faces, parts)
      m.assertEqual(1, points.count())
      m.assertTrue(m.hasPoint(points[0], 5, 9, 5), "the apex")
      ' 8 box corners and the apex
      m.assertEqual(27, points[0].count())
    end function

    @it("leaves the nave's roof out of the tower's part, and cuts the tower's walls at it")
    function _()
      faces = m.boxFaces(0, 0, 0, 20, 6, 40)
      faces.append(m.boxFaces(0, 0, 0, 6, 20, 6))
      points = BGE.FogSilhouettes.modelPartPoints(faces, BGE.FogSilhouettes.modelParts(faces))
      m.assertEqual(2, points.count())
      m.assertFalse(m.hasPoint(points[1], 20, 6, 40), "a nave roof corner in the tower's part")
      m.assertTrue(m.hasPoint(points[1], 6, 6, 6), "the tower wall cut at the nave's top")
      m.assertTrue(m.hasPoint(points[0], 20, 6, 40), "a nave roof corner in the nave's part")
    end function

    @it("keeps a flat model's points")
    function _()
      v = BGE.Math.VectorOps.create
      faces = [m.tri(v(0, 2, 0), v(10, 2, 0), v(0, 2, 10)), m.tri(v(10, 2, 0), v(10, 2, 10), v(0, 2, 10))]
      points = BGE.FogSilhouettes.modelPartPoints(faces, BGE.FogSilhouettes.modelParts(faces))
      m.assertEqual(12, points[0].count())
    end function

    @it("keeps at most 42 points a part, the extremes among them")
    function _()
      ' a 64-sided drum, 10 tall
      faces = [] as BGE.Model3dFace[]
      v = BGE.Math.VectorOps.create
      sides = 64
      for i = 0 to sides - 1
        a0 = 2 * BGE.Math.PI * i / sides
        a1 = 2 * BGE.Math.PI * (i + 1) / sides
        p0 = v(100 * Cos(a0), 0, 100 * Sin(a0))
        p1 = v(100 * Cos(a1), 0, 100 * Sin(a1))
        q0 = v(100 * Cos(a0), 10, 100 * Sin(a0))
        q1 = v(100 * Cos(a1), 10, 100 * Sin(a1))
        faces.push(m.tri(p0, p1, q1))
        faces.push(m.tri(p0, q1, q0))
      end for
      points = BGE.FogSilhouettes.modelPartPoints(faces, BGE.FogSilhouettes.modelParts(faces))
      m.assertEqual(1, points.count())
      m.assertTrue(points[0].count() <= 42 * 3, `${points[0].count() / 3} points`)
      m.assertTrue(m.hasPoint(points[0], 100, 10, 0), "the +x top corner")
    end function

    @it("trims points inside a part, keeping a gabled house's corners (#686)")
    function _()
      faces = m.boxFaces(0, 0, 0, 10, 6, 10)
      v = BGE.Math.VectorOps.create
      faces.push(m.tri(v(0, 6, 0), v(10, 6, 0), v(5, 9, 0)))
      faces.push(m.tri(v(0, 6, 10), v(10, 6, 10), v(5, 9, 10)))
      faces.push(m.tri(v(0, 6, 0), v(5, 9, 0), v(5, 9, 10)))
      faces.push(m.tri(v(10, 6, 0), v(5, 9, 0), v(5, 9, 10)))
      ' a window inset on the front wall: its corners are inside the house's outline
      faces.push(m.tri(v(3, 2, 0.5), v(7, 2, 0.5), v(7, 4, 0.5)))
      faces.push(m.tri(v(3, 2, 0.5), v(7, 4, 0.5), v(3, 4, 0.5)))
      points = BGE.FogSilhouettes.modelPartPoints(faces, BGE.FogSilhouettes.modelParts(faces))
      m.assertEqual(1, points.count())
      m.assertEqual(10 * 3, points[0].count())
      for each corner in [[0, 0, 0], [10, 0, 0], [0, 0, 10], [10, 0, 10], [0, 6, 0], [10, 6, 0], [0, 6, 10], [10, 6, 10], [5, 9, 0], [5, 9, 10]]
        m.assertTrue(m.hasPoint(points[0], corner[0], corner[1], corner[2]), `corner ${FormatJson(corner)}`)
      end for
    end function

    @describe("convexHull")

    @it("orders whole-pixel points by the packed keys alone, and sub-pixel ones exactly (#686)")
    function _()
      ' a square given out of order, with a point inside
      hull = BGE.FogSilhouettes.convexHull([10.0, 10.0, 0.0, 0.0, 5.0, 5.0, 0.0, 10.0, 10.0, 0.0])
      m.assertEqual([0.0, 0.0, 10.0, 0.0, 10.0, 10.0, 0.0, 10.0], hull)
      ' half a pixel apart on x, which the keys can't tell apart
      hull = BGE.FogSilhouettes.convexHull([0.5, 0.0, 0.0, 5.0, 0.0, 0.0, 0.5, 5.0])
      m.assertEqual([0.0, 0.0, 0.5, 0.0, 0.5, 5.0, 0.0, 5.0], hull)
    end function

    @it("drops points inside the hull")
    function _()
      hull = BGE.FogSilhouettes.convexHull([0.0, 0.0, 10.0, 0.0, 5.0, 5.0, 10.0, 10.0, 0.0, 10.0])
      m.assertEqual(8, hull.count())
      for i = 0 to hull.count() - 1 step 2
        m.assertFalse(hull[i] = 5.0 and hull[i + 1] = 5.0, "the inside point")
      end for
    end function

    @it("drops collinear and repeated points")
    function _()
      hull = BGE.FogSilhouettes.convexHull([0.0, 0.0, 5.0, 0.0, 10.0, 0.0, 10.0, 10.0, 10.0, 10.0, 0.0, 10.0])
      m.assertEqual(8, hull.count())
    end function

    @it("hulls [x, y, depth] points and orders points sharing an x")
    function _()
      ' a square, its left side's corners given bottom first
      hull = BGE.FogSilhouettes.convexHull([0.0, 10.0, 5.0, 0.0, 0.0, 5.0, 10.0, 0.0, 5.0, 10.0, 10.0, 5.0, 5.0, 5.0, 5.0], 3)
      m.assertEqual(8, hull.count())
      for i = 0 to hull.count() - 1 step 2
        m.assertFalse(hull[i] = 5.0 and hull[i + 1] = 5.0, "the inside point")
      end for
    end function

    @it("orders points past the packed key range exactly")
    function _()
      ' a square right of x = 4096, given out of order, with a point inside
      hull = BGE.FogSilhouettes.convexHull([5000.0, 0.0, 6000.0, 100.0, 5500.0, 50.0, 6000.0, 0.0, 5000.0, 100.0])
      m.assertEqual(8, hull.count())
      for i = 0 to hull.count() - 1 step 2
        m.assertFalse(hull[i] = 5500.0, "the inside point")
      end for
    end function

    @it("keeps every point past 64")
    function _()
      pts = [] as float[]
      for i = 0 to 95
        pts.push(10.0 + (i mod 10))
        pts.push(10.0 + (i \ 10))
      end for
      ' the square's corners last
      pts.append([0.0, 0.0, 100.0, 0.0, 100.0, 100.0, 0.0, 100.0])
      hull = BGE.FogSilhouettes.convexHull(pts)
      m.assertEqual(8, hull.count())
      for i = 0 to hull.count() - 1
        m.assertTrue(hull[i] = 0.0 or hull[i] = 100.0, "a corner")
      end for
    end function

    @describe("hullRects")

    @it("fills a rectangle as one rect")
    function _()
      out = [] as float[]
      BGE.FogSilhouettes.hullRects([[10.0, 20.0, 50.0, 20.0, 50.0, 60.0, 10.0, 60.0]], 4, 1280, 720, out)
      m.assertEqual([10.0, 20.0, 40.0, 40.0], out)
    end function

    @it("widens band by band down a triangle, never narrower than it")
    function _()
      out = [] as float[]
      ' apex at (100, 0), base from 80 to 120 at y 8
      BGE.FogSilhouettes.hullRects([[100.0, 0.0, 120.0, 8.0, 80.0, 8.0]], 4, 1280, 720, out)
      m.assertEqual([90.0, 0.0, 20.0, 4.0, 80.0, 4.0, 40.0, 4.0], out)
    end function

    @it("clamps to the frame")
    function _()
      out = [] as float[]
      BGE.FogSilhouettes.hullRects([[-30.0, -10.0, 50.0, -10.0, 50.0, 30.0, -30.0, 30.0]], 4, 1280, 720, out)
      m.assertEqual([0.0, 0.0, 50.0, 30.0], out)
    end function

    @it("joins overlapping outlines without overlapping rects")
    function _()
      out = [] as float[]
      BGE.FogSilhouettes.hullRects([[0.0, 0.0, 40.0, 0.0, 40.0, 8.0, 0.0, 8.0], [20.0, 0.0, 60.0, 0.0, 60.0, 8.0, 20.0, 8.0]], 4, 1280, 720, out)
      m.assertEqual([0.0, 0.0, 60.0, 8.0], out)
    end function

    @it("draws nothing for an outline off the frame")
    function _()
      out = [] as float[]
      BGE.FogSilhouettes.hullRects([[-80.0, 10.0, -20.0, 10.0, -20.0, 50.0, -80.0, 50.0]], 4, 1280, 720, out)
      m.assertEqual(0, out.count())
    end function

    @it("merges a slightly leaning edge into a few rects")
    function _()
      out = [] as float[]
      ' 5 px of lean over 100 rows, as a camera tilted a little down makes of a wall
      BGE.FogSilhouettes.hullRects([[10.0, 0.0, 50.0, 0.0, 55.0, 100.0, 15.0, 100.0]], 4, 1280, 720, out)
      m.assertTrue(out.count() / 4 <= 8, `${out.count() / 4} rects`)
    end function

    @it("keeps an edge leaning under a band in all as one rect")
    function _()
      out = [] as float[]
      ' 4 px of lean over 100 rows, at 4 px bands
      BGE.FogSilhouettes.hullRects([[10.0, 0.0, 50.0, 0.0, 54.0, 100.0, 14.0, 100.0]], 4, 1280, 720, out)
      m.assertEqual([10.0, 0.0, 44.0, 100.0], out)
    end function

    @it("steps a steep edge a band across at a time")
    function _()
      out = [] as float[]
      ' 12 px of lean over 120 rows: 3 steps of 40, not 30 of 4
      BGE.FogSilhouettes.hullRects([[10.0, 0.0, 50.0, 0.0, 50.0, 120.0, -2.0, 120.0]], 4, 1280, 720, out)
      m.assertEqual(12, out.count())
      m.assertEqual(40.0, out[3])
    end function

    @it("skips an outline with no height among others")
    function _()
      out = [] as float[]
      BGE.FogSilhouettes.hullRects([[0.0, 0.0, 40.0, 0.0, 40.0, 20.0, 0.0, 20.0], [50.0, 10.0, 60.0, 10.0, 70.0, 10.0]], 4, 1280, 720, out)
      m.assertEqual([0.0, 0.0, 40.0, 20.0], out)
    end function

    @describe("mergeRects")

    @it("passes one box through")
    function _()
      out = [] as float[]
      BGE.FogSilhouettes.mergeRects([10.0, 20.0, 50.0, 80.0], out)
      m.assertEqual([10.0, 20.0, 40.0, 60.0], out)
    end function

    @it("cuts a tower above a nave into two rects that don't overlap")
    function _()
      out = [] as float[]
      BGE.FogSilhouettes.mergeRects([300.0, 125.0, 340.0, 400.0, 200.0, 300.0, 500.0, 400.0], out)
      m.assertEqual([300.0, 125.0, 40.0, 175.0, 200.0, 300.0, 300.0, 100.0], out)
    end function

    @it("merges side by side boxes in a band")
    function _()
      out = [] as float[]
      BGE.FogSilhouettes.mergeRects([0.0, 0.0, 50.0, 100.0, 50.0, 0.0, 120.0, 100.0], out)
      m.assertEqual([0.0, 0.0, 120.0, 100.0], out)
    end function

    @it("keeps apart boxes that don't touch")
    function _()
      out = [] as float[]
      BGE.FogSilhouettes.mergeRects([0.0, 0.0, 50.0, 100.0, 60.0, 0.0, 120.0, 100.0], out)
      m.assertEqual([0.0, 0.0, 50.0, 100.0, 60.0, 0.0, 60.0, 100.0], out)
    end function

  end class

end namespace
