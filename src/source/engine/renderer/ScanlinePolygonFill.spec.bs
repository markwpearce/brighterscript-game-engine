namespace tests

  @suite("BGE.ScanlinePolygonFill")
  class ScanlinePolygonFillTests extends rooibos.BaseTestSuite

    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 200, alphaEnable: true})
      m.bitmap.Clear(&h00000000)
      m.renderer = new BGE.Renderer(m.bitmap)
    end function

    private function alphaAt(x as integer, y as integer) as integer
      return m.bitmap.GetByteArray(x, y, 1, 1)[3]
    end function

    ' Whether every pixel of the rectangle has the given alpha.
    private function allAlpha(x as integer, y as integer, w as integer, h as integer, alpha as integer) as boolean
      bytes = m.bitmap.GetByteArray(x, y, w, h)
      for i = 3 to bytes.count() - 1 step 4
        if bytes[i] <> alpha
          return false
        end if
      end for
      return true
    end function

    ' How many pixels of the whole bitmap have an alpha other than 0 or `alpha`.
    private function countOtherAlphas(alpha as integer) as integer
      bytes = m.bitmap.GetByteArray(0, 0, 200, 200)
      bad = 0
      for i = 3 to bytes.count() - 1 step 4
        if bytes[i] <> 0 and bytes[i] <> alpha
          bad++
        end if
      end for
      return bad
    end function

    private function v(x as float, y as float) as BGE.Math.Vector
      return BGE.Math.VectorOps.create(x, y)
    end function

    ' A five-pointed star drawn as one line, visiting every second tip.
    private function star() as BGE.Math.Vector[]
      points = [] as BGE.Math.Vector[]
      for i = 0 to 4
        a = 2 * BGE.Math.PI * (i * 2) / 5 - BGE.Math.HALF_PI
        points.push(m.v(100 + 80 * cos(a), 100 + 80 * sin(a)))
      end for
      return points
    end function

    @describe("concave outlines")

    @it("leaves a chevron's notch empty and fills its arms")
    function _()
      m.renderer.drawPolygonAsSpansTo(m.bitmap, [m.v(20, 20), m.v(100, 50), m.v(20, 80), m.v(60, 50)], 0, 0, BGE.Colors.Red)
      m.assertEqual(0, m.alphaAt(40, 50))
      m.assertEqual(0, m.alphaAt(25, 50))
      m.assertEqual(255, m.alphaAt(40, 30))
      m.assertEqual(255, m.alphaAt(40, 70))
      m.assertEqual(255, m.alphaAt(80, 50))
    end function

    @it("fills both legs of an L-shape, not its corner, as one rect per leg")
    function _()
      l = [m.v(20, 20), m.v(60, 20), m.v(60, 120), m.v(160, 120), m.v(160, 160), m.v(20, 160)]
      drawn = m.renderer.drawPolygonAsSpansTo(m.bitmap, l, 0, 0, BGE.Colors.Red)
      m.assertEqual(2, drawn)
      m.assertTrue(m.allAlpha(20, 20, 40, 140, 255))
      m.assertTrue(m.allAlpha(20, 120, 140, 40, 255))
      m.assertTrue(m.allAlpha(60, 20, 100, 100, 0))
    end function

    @it("bands a tall chevron across x")
    function _()
      chevron = [m.v(50, 10), m.v(90, 60), m.v(130, 10), m.v(90, 190)]
      m.renderer.resetDrawCallCounter()
      drawn = m.renderer.drawPolygonAsSpansTo(m.bitmap, chevron, 0, 0, BGE.Colors.Red)
      ' one band per column at most
      m.assertTrue(drawn <= 81)
      m.assertTrue(drawn > 0)
      m.assertEqual(drawn, m.renderer.getDrawCallsLastFrame())
      m.assertEqual(0, m.alphaAt(90, 30))
      m.assertEqual(255, m.alphaAt(90, 120))
      m.assertEqual(255, m.alphaAt(60, 25))
      m.assertEqual(255, m.alphaAt(120, 25))
    end function

    @it("keeps a U-shape's arms apart")
    function _()
      u = [m.v(20, 20), m.v(60, 20), m.v(60, 120), m.v(140, 120), m.v(140, 20), m.v(180, 20), m.v(180, 160), m.v(20, 160)]
      drawn = m.renderer.drawPolygonAsSpansTo(m.bitmap, u, 0, 0, BGE.Colors.Red)
      ' each arm one rect down to the base, then the base
      m.assertEqual(3, drawn)
      m.assertTrue(m.allAlpha(60, 20, 80, 100, 0))
      m.assertTrue(m.allAlpha(20, 20, 40, 140, 255))
      m.assertTrue(m.allAlpha(140, 20, 40, 140, 255))
    end function

    @it("applies the x/y offset")
    function _()
      m.renderer.drawPolygonAsSpansTo(m.bitmap, [m.v(0, 0), m.v(80, 30), m.v(0, 60), m.v(40, 30)], 100, 100, BGE.Colors.Red)
      m.assertEqual(255, m.alphaAt(120, 110))
      m.assertEqual(0, m.alphaAt(120, 130))
      m.assertEqual(0, m.alphaAt(20, 10))
    end function

    @it("follows the outline whichever way round it goes")
    function _()
      m.renderer.drawPolygonAsSpansTo(m.bitmap, [m.v(60, 50), m.v(20, 80), m.v(100, 50), m.v(20, 20)], 0, 0, BGE.Colors.Red)
      m.assertEqual(0, m.alphaAt(40, 50))
      m.assertEqual(255, m.alphaAt(40, 30))
    end function

    @describe("fill rule")

    @it("fills a star solid under nonzero, the default")
    function _()
      m.renderer.drawPolygonAsSpansTo(m.bitmap, m.star(), 0, 0, BGE.Colors.Red)
      m.assertTrue(m.allAlpha(90, 90, 20, 20, 255))
      ' between two tips, inside the hull but outside the star
      a = -BGE.Math.HALF_PI + BGE.Math.PI / 5
      m.assertEqual(0, m.alphaAt(100 + cint(60 * cos(a)), 100 + cint(60 * sin(a))))
      ' a tip
      m.assertEqual(255, m.alphaAt(100, 30))
    end function

    @it("leaves a star's centre hollow under even-odd")
    function _()
      m.renderer.drawPolygonAsSpansTo(m.bitmap, m.star(), 0, 0, BGE.Colors.Red, 1, invalid, BGE.PolygonFillRule.evenOdd)
      m.assertTrue(m.allAlpha(90, 90, 20, 20, 0))
      m.assertEqual(255, m.alphaAt(100, 30))
    end function

    @describe("translucent fills")

    @it("never blends a self-overlapping star twice")
    function _()
      m.renderer.drawPolygonAsSpansTo(m.bitmap, m.star(), 0, 0, &hFF000080)
      m.assertEqual(&h80, m.alphaAt(100, 100))
      m.assertEqual(0, m.countOtherAlphas(&h80))
    end function

    @it("never blends twice with coarse bands")
    function _()
      m.renderer.drawPolygonAsSpansTo(m.bitmap, m.star(), 0, 0, &hFF000080, 3)
      m.assertEqual(&h80, m.alphaAt(100, 100))
      m.assertEqual(0, m.countOtherAlphas(&h80))
    end function

    @it("never blends twice where a notch narrows to a sliver")
    function _()
      ' a deep, thin notch whose two sides round onto the same pixel
      m.renderer.drawPolygonAsSpansTo(m.bitmap, [m.v(10, 10), m.v(100, 10), m.v(100.4, 150), m.v(100.6, 10), m.v(190, 10), m.v(190, 190), m.v(10, 190)], 0, 0, &hFF000080)
      m.assertEqual(0, m.countOtherAlphas(&h80))
      m.assertEqual(&h80, m.alphaAt(50, 100))
    end function

    @describe("edge cases")

    @it("skips bands off the canvas")
    function _()
      drawn = m.renderer.drawPolygonAsSpansTo(m.bitmap, [m.v(0, -5000), m.v(100, 100), m.v(0, 5000), m.v(50, 100)], 0, 0, BGE.Colors.Red, 1, true)
      m.assertTrue(drawn <= 400)
      ' the notch is at (50, 100)
      m.assertEqual(255, m.alphaAt(70, 10))
      m.assertEqual(0, m.alphaAt(20, 100))
    end function

    @it("draws nothing for fewer than three points or no area")
    function _()
      m.assertEqual(0, m.renderer.drawPolygonAsSpansTo(m.bitmap, [m.v(10, 10), m.v(50, 50)], 0, 0, BGE.Colors.Red))
      m.assertEqual(0, m.renderer.drawPolygonAsSpansTo(m.bitmap, [m.v(10, 10), m.v(50, 10), m.v(90, 10)], 0, 0, BGE.Colors.Red))
      m.assertTrue(m.allAlpha(0, 0, 200, 200, 0))
    end function

    @it("can fill again after a bigger polygon, reusing its scratch")
    function _()
      m.renderer.drawPolygonAsSpansTo(m.bitmap, m.star(), 0, 0, BGE.Colors.Red)
      m.bitmap.Clear(&h00000000)
      drawn = m.renderer.drawPolygonAsSpansTo(m.bitmap, [m.v(20, 20), m.v(60, 20), m.v(60, 120), m.v(160, 120), m.v(160, 160), m.v(20, 160)], 0, 0, BGE.Colors.Red)
      m.assertEqual(2, drawn)
      m.assertTrue(m.allAlpha(60, 20, 100, 100, 0))
    end function

  end class

end namespace
