namespace BGE

  ' A texture drawn by `BGE.QuadColumnDrawer`, with its columns and rows (1 texel, or a
  ' power-of-two slab of texels, wide) cut as `roRegion`s on first use and kept. Rows are
  ' drawn rotated a quarter turn, so no transposed copy of the texture is needed. Share one
  ' per texture (an atlas frame is its own texture): `Renderer.getQuadColumnTexture()` caches
  ' them by id.
  class QuadColumnTexture

    id as string = ""
    ' the texture's region within its bitmap
    x as integer = 0
    y as integer = 0
    width as integer = 0
    height as integer = 0

    private bitmap as roBitmap = invalid
    private columns = [] as roRegion[]
    private rows = [] as roRegion[]
    ' by log2 of the slab width, then slab index
    private columnSlabs = [] as roRegion[][]
    private rowSlabs = [] as roRegion[][]

    ' @param {roRegion} region the texture
    ' @param {string} id
    sub new(region as roRegion, id = "" as string)
      m.id = id
      m.bitmap = region.GetBitmap()
      m.x = region.GetX()
      m.y = region.GetY()
      m.width = region.GetWidth()
      m.height = region.GetHeight()
      for i = 0 to m.width - 1
        m.columns.push(invalid)
      end for
      for i = 0 to m.height - 1
        m.rows.push(invalid)
      end for
    end sub

    ' Whether this was cut from `region`'s rect (its bitmap can't be compared).
    '
    ' @param {roRegion} region
    ' @return {boolean}
    function hasRect(region as roRegion) as boolean
      return m.x = region.GetX() and m.y = region.GetY() and m.width = region.GetWidth() and m.height = region.GetHeight()
    end function

    ' Column `u`, 1 texel wide, anchored at its bottom (texel v = height) so it draws upward.
    '
    ' @param {integer} u
    ' @return {roRegion}
    function getColumn(u as integer) as roRegion
      column = m.columns[u]
      if invalid = column
        column = CreateObject("roRegion", m.bitmap, m.x + u, m.y, 1, m.height)
        column.SetPreTranslation(0, -m.height)
        m.columns[u] = column
      end if
      return column
    end function

    ' Row `v`, 1 texel tall, anchored at its right end (texel u = width) and bottom, so drawn
    ' turned a quarter clockwise it runs from u = width up to u = 0.
    '
    ' @param {integer} v
    ' @return {roRegion}
    function getRow(v as integer) as roRegion
      row = m.rows[v]
      if invalid = row
        row = CreateObject("roRegion", m.bitmap, m.x, m.y + v, m.width, 1)
        row.SetPreTranslation(-m.width, -1)
        m.rows[v] = row
      end if
      return row
    end function

    ' Columns `stepLog2` (log2 of their width) texels wide, from u = 0; the last may be
    ' narrower. Anchored like getColumn().
    '
    ' @param {integer} stepLog2
    ' @return {roRegion[]}
    function getColumnSlabs(stepLog2 as integer) as roRegion[]
      return m.getSlabs(false, stepLog2)
    end function

    ' Rows `stepLog2` (log2 of their height) texels tall, from v = 0; the last may be
    ' shorter. Anchored like getRow().
    '
    ' @param {integer} stepLog2
    ' @return {roRegion[]}
    function getRowSlabs(stepLog2 as integer) as roRegion[]
      return m.getSlabs(true, stepLog2)
    end function

    private function getSlabs(useRows as boolean, stepLog2 as integer) as roRegion[]
      sets = m.columnSlabs
      size = m.width
      if useRows
        sets = m.rowSlabs
        size = m.height
      end if
      while sets.count() <= stepLog2
        sets.push(invalid)
      end while
      slabs = sets[stepLog2]
      if invalid = slabs
        slabs = []
        stepSize = 1 << stepLog2
        for first = 0 to size - 1 step stepSize
          across = stepSize
          if first + across > size
            across = size - first
          end if
          if useRows
            slab = CreateObject("roRegion", m.bitmap, m.x, m.y + first, m.width, across)
            slab.SetPreTranslation(-m.width, -across)
          else
            slab = CreateObject("roRegion", m.bitmap, m.x + first, m.y, across, m.height)
            slab.SetPreTranslation(0, -m.height)
          end if
          slabs.push(slab)
        end for
        sets[stepLog2] = slabs
      end if
      return slabs
    end function

  end class

end namespace
