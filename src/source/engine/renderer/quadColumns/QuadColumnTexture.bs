namespace BGE

  ' A texture drawn by `BGE.QuadColumnDrawer`, with its 1-texel columns and rows cut as
  ' `roRegion`s on first use and kept. Rows are drawn rotated a quarter turn, so no
  ' transposed copy of the texture is needed. Share one per texture (an atlas frame is its
  ' own texture): `Renderer.getQuadColumnTexture()` caches them by id.
  class QuadColumnTexture

    id as string = ""
    ' the texture's region within its bitmap
    x as integer = 0
    y as integer = 0
    width as integer = 0
    height as integer = 0

    private bitmap as roBitmap = invalid
    private columns = [] as roRegion[]
    private rows = [] as roRegion[]

    ' @param {roRegion} region the texture
    ' @param {string} id
    sub new(region as roRegion, id = "" as string)
      m.id = id
      m.bitmap = region.GetBitmap()
      m.x = region.GetX()
      m.y = region.GetY()
      m.width = region.GetWidth()
      m.height = region.GetHeight()
      for i = 0 to m.width - 1
        m.columns.push(invalid)
      end for
      for i = 0 to m.height - 1
        m.rows.push(invalid)
      end for
    end sub

    ' Whether this was cut from `region`'s rect (its bitmap can't be compared).
    '
    ' @param {roRegion} region
    ' @return {boolean}
    function hasRect(region as roRegion) as boolean
      return m.x = region.GetX() and m.y = region.GetY() and m.width = region.GetWidth() and m.height = region.GetHeight()
    end function

    ' Column `u`, 1 texel wide, anchored at its bottom (texel v = height) so it draws upward.
    '
    ' @param {integer} u
    ' @return {roRegion}
    function getColumn(u as integer) as roRegion
      column = m.columns[u]
      if invalid = column
        column = CreateObject("roRegion", m.bitmap, m.x + u, m.y, 1, m.height)
        column.SetPreTranslation(0, -m.height)
        m.columns[u] = column
      end if
      return column
    end function

    ' Row `v`, 1 texel tall, anchored at its right end (texel u = width) and bottom, so drawn
    ' turned a quarter clockwise it runs from u = width up to u = 0.
    '
    ' @param {integer} v
    ' @return {roRegion}
    function getRow(v as integer) as roRegion
      row = m.rows[v]
      if invalid = row
        row = CreateObject("roRegion", m.bitmap, m.x, m.y + v, m.width, 1)
        row.SetPreTranslation(-m.width, -1)
        m.rows[v] = row
      end if
      return row
    end function

  end class

end namespace
