import "../../quality/RenderQualityLevel.bs"
import "../../quality/RenderQualityPresets.bs"
import "QuadColumnDrawer.bs"
import "QuadColumnTexture.bs"

namespace tests

  @suite("BGE.QuadColumnDrawer")
  class QuadColumnDrawerTests extends rooibos.BaseTestSuite

    private drawer as BGE.QuadColumnDrawer
    private texture as BGE.QuadColumnTexture
    private target as roBitmap

    protected override sub beforeEach()
      m.drawer = new BGE.QuadColumnDrawer()
      m.drawer.setProjection(640, 1280, 720)
      m.drawer.beginFrame(m.dense(BGE.RenderQualityLevel.medium))
      m.texture = new BGE.QuadColumnTexture(m.quadrantTexture(), "quadrants")
      m.target = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      m.target.Clear(&h000000FF)
    end sub

    ' A preset with no perspective-error cap, so column counts come from density alone
    private function dense(level as BGE.RenderQualityLevel) as BGE.RenderQualitySettings
      settings = BGE.getRenderQualityPreset(level)
      settings.quadMaxAffineErrorPixels = 0
      return settings
    end function

    private sub capError(pixels as float)
      settings = BGE.getRenderQualityPreset(BGE.RenderQualityLevel.medium)
      settings.quadMaxAffineErrorPixels = pixels
      m.drawer.beginFrame(settings)
    end sub

    ' 128x128: top-left red, top-right blue, bottom-left green, bottom-right white
    private function quadrantTexture() as roRegion
      bmp = CreateObject("roBitmap", {width: 128, height: 128, alphaEnable: true})
      bmp.DrawRect(0, 0, 64, 64, &hFF0000FF)
      bmp.DrawRect(64, 0, 64, 64, &h0000FFFF)
      bmp.DrawRect(0, 64, 64, 64, &h00FF00FF)
      bmp.DrawRect(64, 64, 64, 64, &hFFFFFFFF)
      bmp.Finish()
      return CreateObject("roRegion", bmp, 0, 0, 128, 128)
    end function

    ' 200 units square facing the camera at depth 500: 256 px across on screen
    private function facingQuad() as float[]
      return [-100.0, 100.0, -500.0, 100.0, 100.0, -500.0, -100.0, -100.0, -500.0, 100.0, -100.0, -500.0]
    end function

    ' leaning back: the top is farther than the bottom, so depth changes along v
    private function leaningQuad() as float[]
      return [-100.0, 100.0, -400.0, 100.0, 100.0, -400.0, -100.0, -100.0, -200.0, 100.0, -100.0, -200.0]
    end function

    ' 128x128 in red and blue bands 8 texels wide, across u (or v with `alongV`)
    private function bandedTexture(alongV as boolean) as BGE.QuadColumnTexture
      bmp = CreateObject("roBitmap", {width: 128, height: 128, alphaEnable: true})
      bmp.Clear(&hFF0000FF)
      for i = 8 to 127 step 16
        if alongV
          bmp.DrawRect(0, i, 128, 8, &h0000FFFF)
        else
          bmp.DrawRect(i, 0, 8, 128, &h0000FFFF)
        end if
      end for
      bmp.Finish()
      return new BGE.QuadColumnTexture(CreateObject("roRegion", bmp, 0, 0, 128, 128), "bands")
    end function

    ' Draws the banded texture onto `quad` (clip space, an orthographic projection 256 x 144
    ' px from (512, 288)) as slabs 16 texels wide, so each has a red and a blue band.
    private sub drawBandedSlabs(quad as float[], alongV as boolean)
      settings = m.dense(BGE.RenderQualityLevel.medium)
      settings.quadColumnsPerTexel = 1 / 16
      settings.quadMinPixelsPerColumn = 1
      m.drawer.beginFrame(settings)
      m.drawer.setOrthographicProjection(640, 360, 1280, 720)
      m.assertEqual(8, m.drawer.drawTo(m.target, quad, m.bandedTexture(alongV), [-1]))
      m.assertEqual(alongV, m.drawer.lastUsedRows)
    end sub

    private function pixel(x as integer, y as integer) as integer[]
      m.target.Finish()
      bytes = m.target.GetByteArray(x, y, 1, 1)
      return [bytes[0], bytes[1], bytes[2]]
    end function

    private sub assertQuadrants(upperY as integer, lowerY as integer)
      m.assertEqual([255, 0, 0], m.pixel(590, upperY))
      m.assertEqual([0, 0, 255], m.pixel(690, upperY))
      m.assertEqual([0, 255, 0], m.pixel(590, lowerY))
      m.assertEqual([255, 255, 255], m.pixel(690, lowerY))
    end sub

    @describe("QuadColumnTexture")

    @it("cuts 1-texel columns and rows from the texture's region")
    function _()
      bmp = CreateObject("roBitmap", {width: 64, height: 64})
      texture = new BGE.QuadColumnTexture(CreateObject("roRegion", bmp, 8, 16, 32, 24), "t")
      column = texture.getColumn(5)
      m.assertEqual(13, column.GetX())
      m.assertEqual(16, column.GetY())
      m.assertEqual(1, column.GetWidth())
      m.assertEqual(24, column.GetHeight())
      row = texture.getRow(3)
      m.assertEqual(8, row.GetX())
      m.assertEqual(19, row.GetY())
      m.assertEqual(32, row.GetWidth())
      m.assertEqual(1, row.GetHeight())
    end function

    @it("cuts power-of-two slabs, the last narrower")
    function _()
      bmp = CreateObject("roBitmap", {width: 64, height: 64})
      texture = new BGE.QuadColumnTexture(CreateObject("roRegion", bmp, 8, 16, 20, 24), "t")
      columns = texture.getColumnSlabs(3)
      m.assertEqual(3, columns.count())
      m.assertEqual(16, columns[1].GetX())
      m.assertEqual(8, columns[1].GetWidth())
      m.assertEqual(24, columns[1].GetHeight())
      m.assertEqual(4, columns[2].GetWidth())
      rows = texture.getRowSlabs(4)
      m.assertEqual(2, rows.count())
      m.assertEqual(32, rows[1].GetY())
      m.assertEqual(8, rows[1].GetHeight())
      m.assertEqual(20, rows[1].GetWidth())
      ' kept
      m.assertTrue(texture.getColumnSlabs(3)[0].GetWidth() = columns[0].GetWidth())
    end function

    @describe("drawing")

    @it("draws columns along u when depth changes least across them")
    function _()
      m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1])
      m.assertFalse(m.drawer.lastUsedRows)
      m.assertQuadrants(310, 410)
    end function

    @it("draws turned rows when depth changes along v")
    function _()
      m.drawer.drawTo(m.target, m.leaningQuad(), m.texture, [-1])
      m.assertTrue(m.drawer.lastUsedRows)
      m.assertQuadrants(300, 420)
    end function

    @it("draws with an orthographic projection")
    function _()
      m.drawer.setOrthographicProjection(640, 360, 1280, 720)
      ' clip space: 256 x 144 px from (512, 288)
      quad = [-0.2, 0.2, -0.5, 0.2, 0.2, -0.5, -0.2, -0.2, -0.5, 0.2, -0.2, -0.5]
      m.assertTrue(m.drawer.drawTo(m.target, quad, m.texture, [-1]) > 0)
      m.assertQuadrants(310, 410)
    end function

    @it("tints with one color, or blends one per corner")
    function _()
      m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [&h808080FF])
      m.assertEqual([128, 128, 128], m.pixel(690, 410))
      m.target.Clear(&h000000FF)
      m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [&hFFFFFFFF, &h000000FF, &hFFFFFFFF, &h000000FF])
      left = m.pixel(520, 410)
      right = m.pixel(760, 410)
      ' green: the bottom-left quadrant is green and the bottom-right white
      m.assertTrue(left[1] > 200, `left ${left[1]}`)
      m.assertTrue(right[1] < 55, `right ${right[1]}`)
    end function

    @it("draws nothing when the quad is behind the camera")
    function _()
      quad = [-100.0, 100.0, 50.0, 100.0, 100.0, 50.0, -100.0, -100.0, 50.0, 100.0, -100.0, 50.0]
      m.assertEqual(0, m.drawer.drawTo(m.target, quad, m.texture, [-1]))
    end function

    @it("draws the part of a quad in front of the near plane")
    function _()
      ' a floor from behind the camera to depth 600, below eye level
      quad = [-100.0, -50.0, -600.0, 100.0, -50.0, -600.0, -100.0, -50.0, 100.0, 100.0, -50.0, 100.0]
      drawn = m.drawer.drawTo(m.target, quad, m.texture, [-1])
      m.assertTrue(drawn > 0)
      m.assertTrue(drawn < m.drawer.lastColumnCount)
    end function

    @it("keeps the column that crosses the near plane")
    function _()
      ' a wall on the left running from behind the camera to depth 3100: at Basic its 32
      ' columns are 100 units apart, so the one from depth 0 to 100 (cut at the near plane,
      ' depth 10) covers x -3200..256 on screen
      m.drawer.beginFrame(m.dense(BGE.RenderQualityLevel.basic))
      quad = [-60.0, 50.0, 100.0, -60.0, 50.0, -3100.0, -60.0, -50.0, 100.0, -60.0, -50.0, -3100.0]
      m.drawer.drawTo(m.target, quad, m.texture, [-1])
      m.assertNotEqual([0, 0, 0], m.pixel(100, 360))
    end function

    @it("draws a column's whole slab, not just its middle texel")
    function _()
      ' depth changes along u, so columns; 2 px per texel across
      m.drawBandedSlabs([-0.2, 0.2, -0.3, 0.2, 0.2, -0.7, -0.2, -0.2, -0.3, 0.2, -0.2, -0.7], false)
      m.assertEqual([255, 0, 0], m.pixel(518, 350))
      m.assertEqual([0, 0, 255], m.pixel(538, 350))
    end function

    @it("draws a row's whole slab")
    function _()
      ' depth changes along v, so rows; 1.125 px per texel down
      m.drawBandedSlabs([-0.2, 0.2, -0.3, 0.2, 0.2, -0.3, -0.2, -0.2, -0.7, 0.2, -0.2, -0.7], true)
      m.assertEqual([255, 0, 0], m.pixel(600, 291))
      m.assertEqual([0, 0, 255], m.pixel(600, 302))
    end function

    @it("draws a mirrored column's middle texel, so it isn't mirrored within the column")
    function _()
      ' mirrored left to right: u 0 is at x 768; a mirrored slab would put blue here
      m.drawBandedSlabs([0.2, 0.2, -0.3, -0.2, 0.2, -0.7, 0.2, -0.2, -0.3, -0.2, -0.2, -0.7], false)
      m.assertEqual([255, 0, 0], m.pixel(762, 350))
    end function

    @it("draws a mirrored row's middle texel")
    function _()
      ' mirrored top to bottom: v 0 is at y 432
      m.drawBandedSlabs([-0.2, -0.2, -0.3, 0.2, -0.2, -0.3, -0.2, 0.2, -0.7, 0.2, 0.2, -0.7], true)
      m.assertEqual([255, 0, 0], m.pixel(600, 429))
    end function

    @describe("column count")

    @it("takes the smaller of texels x columnsPerTexel and screen span / minPixelsPerColumn")
    function _()
      ' 128 texels; 256 px across
      m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1])
      m.assertEqual(64, m.drawer.lastColumnCount)
      m.drawer.beginFrame(m.dense(BGE.RenderQualityLevel.basic))
      m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1])
      m.assertEqual(32, m.drawer.lastColumnCount)
      m.drawer.beginFrame(m.dense(BGE.RenderQualityLevel.ultra))
      m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1])
      m.assertEqual(128, m.drawer.lastColumnCount)
      ' far away: 64 px across wants 64 / 4 + 1 at Medium, so slabs 8 texels wide
      m.drawer.beginFrame(m.dense(BGE.RenderQualityLevel.medium))
      far = m.facingQuad()
      for i = 2 to 11 step 3
        far[i] = -2000.0
      end for
      m.drawer.drawTo(m.target, far, m.texture, [-1])
      m.assertEqual(16, m.drawer.lastColumnCount)
    end function

    @it("stops at the per-frame budget until the next frame")
    function _()
      m.drawer.maxColumnsPerFrame = 100
      m.assertEqual(64, m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1]))
      ' what's left takes wider slabs
      m.assertEqual(32, m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1]))
      m.assertEqual(4, m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1]))
      m.assertEqual(0, m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1]))
      m.assertEqual(100, m.drawer.columnsThisFrame)
      m.drawer.beginFrame(m.dense(BGE.RenderQualityLevel.medium))
      m.assertEqual(64, m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1]))
    end function

    @it("skips columns off the canvas")
    function _()
      quad = m.facingQuad()
      for i = 0 to 9 step 3
        quad[i] += 500.0
      end for
      ' x 1152..1408 on screen: only about the first half is on the 1280 canvas
      drawn = m.drawer.drawTo(m.target, quad, m.texture, [-1])
      m.assertTrue(drawn > 28 and drawn < 40, `drawn ${drawn}`)
    end function

    @describe("drawTiledTo")

    @it("repeats the texture across instead of stretching it")
    function _()
      drawn = m.drawer.drawTiledTo(m.target, m.facingQuad(), m.texture, [-1], 2, 1)
      m.assertTrue(drawn > 0)
      ' 512..768 across: two copies, each red then blue on top
      m.assertEqual([255, 0, 0], m.pixel(544, 300))
      m.assertEqual([0, 0, 255], m.pixel(608, 300))
      m.assertEqual([255, 0, 0], m.pixel(672, 300))
      m.assertEqual([0, 0, 255], m.pixel(736, 300))
    end function

    @it("cuts a partial last tile across from the texture's left")
    function _()
      m.drawer.drawTiledTo(m.target, m.facingQuad(), m.texture, [-1], 1.5, 1)
      ' the last third is the texture's left half: red
      m.assertEqual([255, 0, 0], m.pixel(740, 300))
      m.assertEqual([0, 0, 255], m.pixel(640, 300))
    end function

    @it("tiles down from the foot, the partial tile on top")
    function _()
      m.drawer.drawTiledTo(m.target, m.facingQuad(), m.texture, [-1], 1, 1.5)
      ' 232..488 down: the top third is the texture's bottom half (green, white)
      m.assertEqual([0, 255, 0], m.pixel(544, 250))
      m.assertEqual([255, 255, 255], m.pixel(736, 250))
      ' below it, a whole copy
      m.assertEqual([255, 0, 0], m.pixel(544, 340))
      m.assertEqual([255, 255, 255], m.pixel(736, 460))
    end function

    @it("blends corner tints across the tiles")
    function _()
      m.drawer.drawTiledTo(m.target, m.facingQuad(), m.whiteTexture(), [&hFF0000FF, &h0000FFFF, &hFF0000FF, &h0000FFFF], 2, 1)
      left = m.pixel(520, 360)
      right = m.pixel(760, 360)
      m.assertTrue(left[0] > 200 and left[2] < 60)
      m.assertTrue(right[2] > 200 and right[0] < 60)
    end function

    @it("draws once with no repeat")
    function _()
      m.drawer.drawTiledTo(m.target, m.facingQuad(), m.texture, [-1], 1, 1)
      m.assertQuadrants(310, 410)
    end function

    @it("keeps partial-tile textures")
    function _()
      part = m.texture.getPart(0, 64, 32, 64)
      m.assertEqual(32, part.width)
      m.assertEqual(64, part.height)
      m.assertEqual(64, part.y)
      m.assertEqual(part.id, m.texture.getPart(0, 64, 32, 64).id)
    end function

    @describe("perspective error cap")

    @it("draws a quad at constant depth as one slab")
    function _()
      m.capError(1)
      m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [-1])
      m.assertEqual(1, m.drawer.lastColumnCount)
      m.assertQuadrants(310, 410)
    end function

    @it("gives a quad more columns the more its depth changes, and fewer for a looser cap")
    function _()
      m.capError(1)
      m.drawer.drawTo(m.target, m.leaningQuad(), m.texture, [-1])
      tight = m.drawer.lastColumnCount
      m.capError(8)
      m.drawer.drawTo(m.target, m.leaningQuad(), m.texture, [-1])
      loose = m.drawer.lastColumnCount
      m.capError(0)
      m.drawer.drawTo(m.target, m.leaningQuad(), m.texture, [-1])
      uncapped = m.drawer.lastColumnCount
      m.assertTrue(tight > 1)
      m.assertTrue(loose < tight)
      m.assertTrue(tight <= uncapped)
    end function

    @it("still draws a slab per repeat")
    function _()
      m.capError(1)
      m.drawer.drawTiledTo(m.target, m.facingQuad(), m.texture, [-1], 3, 1)
      m.assertEqual(3, m.drawer.lastColumnCount)
    end function

    @it("isn't applied to corner tints, which blend per column")
    function _()
      m.capError(1)
      m.drawer.drawTo(m.target, m.facingQuad(), m.texture, [&hFF0000FF, &h0000FFFF, &hFF0000FF, &h0000FFFF])
      m.assertTrue(m.drawer.lastColumnCount > 1)
    end function

    private function whiteTexture() as BGE.QuadColumnTexture
      bmp = CreateObject("roBitmap", {width: 32, height: 32, alphaEnable: true})
      bmp.Clear(&hFFFFFFFF)
      bmp.Finish()
      return new BGE.QuadColumnTexture(CreateObject("roRegion", bmp, 0, 0, 32, 32), "white")
    end function

  end class

end namespace
