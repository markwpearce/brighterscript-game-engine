import "../../../math/math.bs"
import "../../quality/RenderQualitySettings.bs"
import "QuadColumnTexture.bs"
import "TriangleColumnCuts.bs"

namespace BGE

  ' Draws a perspective-textured quad as projected texture columns: one
  ' `DrawTransformedObject` per 1-texel column, perspective correct, with no scratch bitmaps.
  ' Textured triangles (model faces) draw the same way with drawTriangleTo().
  '
  ' Corners are given in camera space and projected once; column ends are lerped in camera
  ' space then divided (or, with an orthographic projection, just scaled). Columns run along whichever texture axis changes depth least, so each
  ' is near constant depth. How many is set by render quality (`quadColumnsPerTexel`,
  ' `quadMinPixelsPerColumn`), and a per-frame budget keeps a bitmap under Roku's limit on
  ' queued draws. Call `beginFrame()` once per frame (`Renderer.render()` does).
  class QuadColumnDrawer

    ' Most columns drawn per frame, across every quad (Roku drops all draws into a bitmap
    ' once about 13,000 queue in a frame)
    maxColumnsPerFrame as integer = 8000
    ' Camera-space z a point must be at or below to be in front of the camera. setProjection()
    ' sets it to -focal / 64, so nothing clipped there projects more than ~64x off center:
    ' huge columns aren't drawn reliably.
    nearZ as float = -10.0

    ' Columns drawn this frame
    columnsThisFrame as integer = 0
    ' Of the last drawTo(): columns it worked out, and whether they were texture rows
    lastColumnCount as integer = 0
    lastUsedRows as boolean = false

    private columnsPerTexel as float = 0.5
    private minPixelsPerColumn as float = 4.0
    private maxAffineError as float = 0.0
    private focal as float = 1.0
    ' orthographic: screen x = centerX + scaleX * x, screen y = centerY - scaleY * y
    private ortho as boolean = false
    private scaleX as float = 1.0
    private scaleY as float = 1.0
    private centerX as float = 0.0
    private centerY as float = 0.0
    private canvasWidth as float = 0.0
    private canvasHeight as float = 0.0
    ' the current quad's top and foot edges: start and per-texel step, camera space
    private tx0 as float = 0.0
    private ty0 as float = 0.0
    private tz0 as float = 0.0
    private tdx as float = 0.0
    private tdy as float = 0.0
    private tdz as float = 0.0
    private fx0 as float = 0.0
    private fy0 as float = 0.0
    private fz0 as float = 0.0
    private fdx as float = 0.0
    private fdy as float = 0.0
    private fdz as float = 0.0

    ' column end points, camera space then screen; grown, never shrunk
    private topX = [] as float[]
    private topY = [] as float[]
    private footX = [] as float[]
    private footY = [] as float[]
    private edgeOk = [] as boolean[]
    ' each column edge's texel across the quad (counting repeats), and each column's first
    ' texel in the texture
    private edgeTexels = [] as integer[]
    private columnTexels = [] as integer[]
    private channels = [] as float[]

    ' Starts a frame: resets the column budget and reads the column density.
    '
    ' @param {BGE.RenderQualitySettings} settings
    sub beginFrame(settings as BGE.RenderQualitySettings)
      m.columnsThisFrame = 0
      m.columnsPerTexel = settings.quadColumnsPerTexel
      m.minPixelsPerColumn = settings.quadMinPixelsPerColumn
      m.maxAffineError = settings.quadMaxAffineErrorPixels
    end sub

    ' Sets the projection: screen x = centerX + focal * x / -z, screen y = centerY - focal * y / -z.
    '
    ' @param {float} focal focal length in pixels
    ' @param {float} canvasWidth
    ' @param {float} canvasHeight
    sub setProjection(focal as float, canvasWidth as float, canvasHeight as float)
      m.ortho = false
      m.focal = focal
      m.nearZ = -focal / 64
      m.canvasWidth = canvasWidth
      m.canvasHeight = canvasHeight
      m.centerX = canvasWidth * 0.5
      m.centerY = canvasHeight * 0.5
    end sub

    ' Sets an orthographic projection (a Camera2d): screen x = centerX + scaleX * x,
    ' screen y = centerY - scaleY * y. In front is still z < 0.
    '
    ' @param {float} scaleX pixels per camera-space unit across
    ' @param {float} scaleY pixels per camera-space unit up
    ' @param {float} canvasWidth
    ' @param {float} canvasHeight
    sub setOrthographicProjection(scaleX as float, scaleY as float, canvasWidth as float, canvasHeight as float)
      m.ortho = true
      m.scaleX = scaleX
      m.scaleY = scaleY
      m.nearZ = 0
      m.canvasWidth = canvasWidth
      m.canvasHeight = canvasHeight
      m.centerX = canvasWidth * 0.5
      m.centerY = canvasHeight * 0.5
    end sub

    ' Moves where the view axis lands on the target, for a bitmap placed elsewhere on the
    ' canvas (may be negative or past its edges). Call after setProjection().
    '
    ' @param {float} centerX
    ' @param {float} centerY
    sub setProjectionCenter(centerX as float, centerY as float)
      m.centerX = centerX
      m.centerY = centerY
    end sub

    ' Draws a textured quad into `target`.
    '
    ' @param {ifDraw2D} target an roBitmap or roScreen
    ' @param {float[]} corners 12 floats: camera-space x, y, z (in front is -z) of the texture's
    '   top-left, top-right, bottom-left and bottom-right
    ' @param {BGE.QuadColumnTexture} texture
    ' @param {integer[]} colors one RGBA tint (with fade alpha), or one per corner in the same
    '   order, blended across the columns (e.g. lighting)
    ' @return {integer} how many columns were drawn
    function drawTo(target as ifDraw2D, corners as float[], texture as BGE.QuadColumnTexture, colors as integer[]) as integer
      return m.drawWrapped(target, corners, texture, colors, 1.0, m.prefersRows(corners), false)
    end function

    ' drawTo(), repeating the texture `repeatU` times across and `repeatV` times down instead
    ' of stretching it once. Tiles start at the texture's left and bottom edges (a wall's
    ' foot), so a partial tile is on the right or top. Columns wrap the texture across them
    ' in one pass; along their length the quad is drawn in bands, one per repeat.
    '
    ' @param {ifDraw2D} target an roBitmap or roScreen
    ' @param {float[]} corners as drawTo()
    ' @param {BGE.QuadColumnTexture} texture
    ' @param {integer[]} colors as drawTo()
    ' @param {float} repeatU times the texture repeats across (u)
    ' @param {float} repeatV times the texture repeats down (v)
    ' @return {integer} how many columns were drawn
    function drawTiledTo(target as ifDraw2D, corners as float[], texture as BGE.QuadColumnTexture, colors as integer[], repeatU as float, repeatV as float) as integer
      m.lastColumnCount = 0
      if repeatU <= 0 or repeatV <= 0
        return 0
      end if
      useRows = m.prefersRows(corners)
      across = repeatU
      along = repeatV
      if useRows
        across = repeatV
        along = repeatU
      end if
      ' rows wrap from the foot, so a partial tile is on top
      if along > 0.999 and along < 1.001
        return m.drawWrapped(target, corners, texture, colors, across, useRows, useRows)
      end if
      tinted = colors.count() >= 4
      bandCorners = CreateObject("roArray", 12, false) as float[]
      for i = 0 to 11
        bandCorners.push(0.0)
      end for
      bandColors = [colors[0]] as integer[]
      if tinted
        bandColors = [colors[0], colors[0], colors[0], colors[0]]
      end if
      bands = int(along + 0.999)
      drawn = 0
      columns = 0
      for b = 0 to bands - 1
        ' quad fractions: across (0 = left) and down (0 = top)
        left = 0.0
        right = 1.0
        top = 0.0
        foot = 1.0
        part = 1.0
        if useRows
          ' bands across from the left
          left = b / along
          right = (b + 1) / along
          if right > 1
            part = (1 - left) * along
            right = 1
          end if
        else
          ' bands up from the foot
          foot = 1 - b / along
          top = 1 - (b + 1) / along
          if top < 0
            part = foot * along
            top = 0
          end if
        end if
        m.lerpCorners(corners, left, top, bandCorners, 0)
        m.lerpCorners(corners, right, top, bandCorners, 3)
        m.lerpCorners(corners, left, foot, bandCorners, 6)
        m.lerpCorners(corners, right, foot, bandCorners, 9)
        if tinted
          bandColors[0] = m.lerpColor(colors, left, top)
          bandColors[1] = m.lerpColor(colors, right, top)
          bandColors[2] = m.lerpColor(colors, left, foot)
          bandColors[3] = m.lerpColor(colors, right, foot)
        end if
        bandTexture = texture
        if part < 0.999
          if useRows
            width = int(texture.width * part + 0.5)
            if width < 1
              width = 1
            end if
            bandTexture = texture.getPart(0, 0, width, texture.height)
          else
            height = int(texture.height * part + 0.5)
            if height < 1
              height = 1
            end if
            bandTexture = texture.getPart(0, texture.height - height, texture.width, height)
          end if
        end if
        drawn += m.drawWrapped(target, bandCorners, bandTexture, bandColors, across, useRows, useRows)
        columns += m.lastColumnCount
      end for
      m.lastColumnCount = columns
      return drawn
    end function

    ' Whether columns should be texture rows: depth changes least along v.
    private function prefersRows(corners as float[]) as boolean
      du = abs(corners[5] - corners[2]) + abs(corners[11] - corners[8])
      dv = abs(corners[8] - corners[2]) + abs(corners[11] - corners[5])
      return du < dv
    end function

    ' Draws the quad as columns (texture rows if `useRows`), the texture repeated `repeat`
    ' times across them. With `alignEnd`, the last repeat ends on the quad's far edge, so a
    ' partial one is at the start.
    private function drawWrapped(target as ifDraw2D, corners as float[], texture as BGE.QuadColumnTexture, colors as integer[], repeat as float, useRows as boolean, alignEnd as boolean) as integer
      m.lastColumnCount = 0
      budget = m.maxColumnsPerFrame - m.columnsThisFrame
      if budget <= 0
        return 0
      end if
      near = m.nearZ
      if corners[2] > near and corners[5] > near and corners[8] > near and corners[11] > near
        return 0
      end if

      ' corners the column tops run between (texture top / left edge), then their feet
      if useRows
        t0 = 0
        t1 = 2
        f0 = 1
        f1 = 3
        texN = texture.height
        texLength = texture.width
      else
        t0 = 0
        t1 = 1
        f0 = 2
        f1 = 3
        texN = texture.width
        texLength = texture.height
      end if
      m.lastUsedRows = useRows
      ' texels across the quad, counting repeats
      total = int(texN * repeat + 0.5)
      if total < 1
        total = 1
      end if
      tiles = (total + texN - 1) \ texN
      phase = 0
      if alignEnd
        phase = tiles * texN - total
      end if

      tinted = colors.count() >= 4
      n = int(total * m.columnsPerTexel + 0.999)
      extent = m.screenExtent(corners, t0, t1, f0, f1)
      if extent >= 0
        byPixels = int(extent / m.minPixelsPerColumn) + 1
        if byPixels < n
          n = byPixels
        end if
        ' a slab is drawn affine, so only depth change across the quad needs more of them
        if m.maxAffineError > 0 and not tinted
          byError = int(sqr(m.affineError(corners, t0, t1, f0, f1) / m.maxAffineError) + 0.999)
          if byError < n
            n = byError
          end if
        end if
      end if
      if n > budget
        n = budget
      end if
      ' a slab can't span two repeats
      if n < tiles
        n = tiles
      end if
      ' columns are whole slabs a power of two texels wide, so their regions can be kept
      stepLog2 = 0
      stepSize = 1
      while stepSize < texN and tiles * ((texN + stepSize - 1) \ stepSize) > n
        stepSize = stepSize * 2
        stepLog2++
      end while
      ' column edges in texels across the quad, cut at slab and repeat boundaries
      edgeTexels = m.edgeTexels
      edgeTexels.Clear()
      columnTexels = m.columnTexels
      columnTexels.Clear()
      edgeTexels.push(0)
      position = 0
      while position < total
        texel = (position + phase) mod texN
        slabEnd = (texel \ stepSize + 1) * stepSize
        if slabEnd > texN
          slabEnd = texN
        end if
        nextPosition = position + slabEnd - texel
        if nextPosition > total
          nextPosition = total
        end if
        columnTexels.push(texel)
        edgeTexels.push(nextPosition)
        position = nextPosition
      end while
      n = columnTexels.count()
      m.lastColumnCount = n

      m.grow(n + 1)
      topX = m.topX
      topY = m.topY
      footX = m.footX
      footY = m.footY
      edgeOk = m.edgeOk
      m.tx0 = corners[t0 * 3]
      m.ty0 = corners[t0 * 3 + 1]
      m.tz0 = corners[t0 * 3 + 2]
      ' steps are per texel across the quad
      m.tdx = (corners[t1 * 3] - m.tx0) / total
      m.tdy = (corners[t1 * 3 + 1] - m.ty0) / total
      m.tdz = (corners[t1 * 3 + 2] - m.tz0) / total
      m.fx0 = corners[f0 * 3]
      m.fy0 = corners[f0 * 3 + 1]
      m.fz0 = corners[f0 * 3 + 2]
      m.fdx = (corners[f1 * 3] - m.fx0) / total
      m.fdy = (corners[f1 * 3 + 1] - m.fy0) / total
      m.fdz = (corners[f1 * 3 + 2] - m.fz0) / total
      anyBehind = false
      for k = 0 to n
        if not m.projectEdge(k, edgeTexels[k])
          anyBehind = true
        end if
      end for
      ' an edge wholly behind the camera next to one in front moves to where the quad
      ' crosses the near plane, so the nearest column isn't lost
      if anyBehind
        for k = 0 to n
          if not edgeOk[k]
            if k < n and edgeOk[k + 1]
              m.projectEdge(k, m.nearCrossing(edgeTexels[k], edgeTexels[k + 1]))
            else if k > 0 and edgeOk[k - 1]
              m.projectEdge(k, m.nearCrossing(edgeTexels[k], edgeTexels[k - 1]))
            end if
          end if
        end for
      end if

      ' a column's width runs to the right of foot->top; seen from behind, that's back toward
      ' the previous edge, so anchor each column at its far edge instead
      reversed = false
      for k = 0 to n - 1
        if edgeOk[k] and edgeOk[k + 1]
          dx = topX[k] - footX[k]
          dy = topY[k] - footY[k]
          reversed = (footX[k + 1] - footX[k]) * -dy + (footY[k + 1] - footY[k]) * dx < 0
          exit for
        end if
      end for

      color = colors[0]
      if tinted
        tinted = m.unpackCornerColors(colors, t0, t1, f0, f1)
      end if

      ' whole slabs, unless they'd draw mirrored (see drawTriangleTo())
      thin = reversed <> useRows
      slabs = []
      if not thin
        if useRows
          slabs = texture.getRowSlabs(stepLog2)
        else
          slabs = texture.getColumnSlabs(stepLog2)
        end if
      end if
      margin = 2.0
      maxX = m.canvasWidth + margin
      maxY = m.canvasHeight + margin
      drawn = 0
      for k = 0 to n - 1
        if drawn >= budget
          exit for
        end if
        if not edgeOk[k] or not edgeOk[k + 1]
          continue for
        end if
        a = k
        b = k + 1
        if reversed
          a = k + 1
          b = k
        end if
        fx = footX[a]
        fy = footY[a]
        tx = topX[a]
        ty = topY[a]
        dx = tx - fx
        dy = ty - fy
        length = sqr(dx * dx + dy * dy)
        if length < 0.5
          continue for
        end if
        sinA = -dx / length
        cosA = -dy / length
        reach = (footX[b] - fx) * cosA - (footY[b] - fy) * sinA
        topReach = (topX[b] - tx) * cosA - (topY[b] - ty) * sinA
        if topReach > reach
          reach = topReach
        end if
        width = reach + 1
        if width < 1
          width = 1.0
        end if
        ' off the canvas: both ends, grown by the width, past the same edge
        reachX = width + margin
        if (fx < -reachX and tx < -reachX) or (fx > maxX + width and tx > maxX + width) or (fy < -reachX and ty < -reachX) or (fy > maxY + width and ty > maxY + width)
          continue for
        end if
        if cosA > 0
          angle = Atn(sinA / cosA) * 57.2957795
        else
          angle = BGE.Math.Atan2(sinA, cosA) * 57.2957795
        end if
        if tinted
          color = m.columnColor((edgeTexels[k] + edgeTexels[k + 1]) * 0.5 / total)
        end if
        first = columnTexels[k]
        acrossTexels = edgeTexels[k + 1] - edgeTexels[k]
        if thin
          texel = first + (acrossTexels - 1) \ 2
          acrossTexels = 1
          if useRows
            region = texture.getRow(texel)
          else
            region = texture.getColumn(texel)
          end if
        else if first mod stepSize = 0 and (acrossTexels = stepSize or first + acrossTexels = texN)
          region = slabs[first \ stepSize]
        else
          ' cut short by a partial repeat
          region = texture.getRange(useRows, first, acrossTexels)
        end if
        if useRows
          ' a row turned a quarter clockwise runs along foot -> top, its thickness across
          target.DrawTransformedObject(fx, fy, angle - 90, length / texLength, width / acrossTexels, region, color)
        else
          target.DrawTransformedObject(fx, fy, angle, width / acrossTexels, length / texLength, region, color)
        end if
        drawn++
      end for
      m.columnsThisFrame += drawn
      return drawn
    end function

    ' The most, in pixels, an affine slab across the quad's top or foot edge strays from
    ' perspective, at its middle. 0 with an orthographic projection.
    private function affineError(corners as float[], t0 as integer, t1 as integer, f0 as integer, f1 as integer) as float
      if m.ortho
        return 0
      end if
      topError = m.edgeAffineError(corners, t0, t1)
      footError = m.edgeAffineError(corners, f0, f1)
      if footError > topError
        return footError
      end if
      return topError
    end function

    private function edgeAffineError(corners as float[], a as integer, b as integer) as float
      focal = m.focal
      za = corners[a * 3 + 2]
      zb = corners[b * 3 + 2]
      dx = focal * (corners[a * 3] / za - corners[b * 3] / zb)
      dy = focal * (corners[a * 3 + 1] / za - corners[b * 3 + 1] / zb)
      wa = -1 / za
      wb = -1 / zb
      return sqr(dx * dx + dy * dy) * abs(wa - wb) / (2 * (wa + wb))
    end function

    ' Writes the camera-space point a fraction `u` across and `v` down the quad `corners`
    ' into `out` at `index`.
    private sub lerpCorners(corners as float[], u as float, v as float, out as float[], index as integer)
      for c = 0 to 2
        top = corners[c] + (corners[3 + c] - corners[c]) * u
        foot = corners[6 + c] + (corners[9 + c] - corners[6 + c]) * u
        out[index + c] = top + (foot - top) * v
      end for
    end sub

    ' The RGBA tint a fraction `u` across and `v` down a quad with corner tints `colors`.
    private function lerpColor(colors as integer[], u as float, v as float) as integer
      color = 0
      for shift = 24 to 0 step -8
        tl = (colors[0] >> shift) and &hFF
        tr = (colors[1] >> shift) and &hFF
        bl = (colors[2] >> shift) and &hFF
        br = (colors[3] >> shift) and &hFF
        top = tl + (tr - tl) * u
        foot = bl + (br - bl) * u
        value = int(top + (foot - top) * v + 0.5)
        if value > 255
          value = 255
        end if
        color = (color << 8) or value
      end for
      return color
    end function

    ' Draws a textured triangle (a model face) into `target` as strips cut to the triangle
    ' (see `BGE.TriangleColumnCuts`), a power of two texels wide, sized like drawTo()'s columns.
    '
    ' @param {ifDraw2D} target an roBitmap or roScreen
    ' @param {float[]} vertices 9 floats: camera-space x, y, z of the face's 3 vertices, in
    '   the order of the texture points `cuts` was made from
    ' @param {BGE.TriangleColumnCuts} cuts
    ' @param {integer} color RGBA tint
    ' @return {integer} how many strips were drawn: 0 if it's wholly behind the camera, or -1 if
    '   it can't be drawn this way (no UV area, or this frame's budget is spent)
    function drawTriangleTo(target as ifDraw2D, vertices as float[], cuts as BGE.TriangleColumnCuts, color as integer) as integer
      m.lastColumnCount = 0
      if not cuts.isValid
        return -1
      end if
      near = m.nearZ
      behind = 0
      for i = 2 to 8 step 3
        if vertices[i] > near
          behind++
        end if
      end for
      if behind = 3
        return 0
      end if
      ' strips crossing the near plane are cut back to it
      crossing = behind > 0
      budget = m.maxColumnsPerFrame - m.columnsThisFrame
      if budget <= 0
        ' the caller fills it instead, so a model isn't left with holes
        return -1
      end if

      ' camera space is affine in (u, v): C = base + u * Cu + v * Cv
      e1x = vertices[3] - vertices[0]
      e1y = vertices[4] - vertices[1]
      e1z = vertices[5] - vertices[2]
      e2x = vertices[6] - vertices[0]
      e2y = vertices[7] - vertices[1]
      e2z = vertices[8] - vertices[2]
      cux = cuts.ua * e1x + cuts.ub * e2x
      cuy = cuts.ua * e1y + cuts.ub * e2y
      cuz = cuts.ua * e1z + cuts.ub * e2z
      cvx = cuts.va * e1x + cuts.vb * e2x
      cvy = cuts.va * e1y + cuts.vb * e2y
      cvz = cuts.va * e1z + cuts.vb * e2z
      u0 = cuts.u[0]
      v0 = cuts.v[0]
      bx = vertices[0] - u0 * cux - v0 * cvx
      by = vertices[1] - u0 * cuy - v0 * cvy
      bz = vertices[2] - u0 * cuz - v0 * cvz

      ' strips run along whichever texture axis changes depth least, as in drawTo()
      useRows = abs(cuz) * (cuts.maxU - cuts.minU) < abs(cvz) * (cuts.maxV - cuts.minV)
      m.lastUsedRows = useRows
      if useRows
        span = cuts.maxV - cuts.minV
        acrossPoints = cuts.v
        ' a strip's step across, and its run along
        sx = cvx
        sy = cvy
        sz = cvz
        lx = cux
        ly = cuy
        lz = cuz
      else
        span = cuts.maxU - cuts.minU
        acrossPoints = cuts.u
        sx = cux
        sy = cuy
        sz = cuz
        lx = cvx
        ly = cvy
        lz = cvz
      end if

      n = int(span * m.columnsPerTexel + 0.999)
      extent = m.triangleScreenExtent(vertices, acrossPoints)
      if extent >= 0
        byPixels = int(extent / m.minPixelsPerColumn) + 1
        if byPixels < n
          n = byPixels
        end if
      end if
      if n < 1
        n = 1
      end if
      stepLog2 = 0
      stepSize = 1
      while stepSize * n < span or cuts.stripCount(useRows, stepSize) > budget
        stepSize = stepSize * 2
        stepLog2++
      end while
      strips = cuts.getStrips(useRows, stepLog2)
      m.lastColumnCount = strips.starts.count()

      focal = m.focal
      ortho = m.ortho
      scaleX = m.scaleX
      scaleY = m.scaleY
      cx = m.centerX
      cy = m.centerY
      margin = 2.0
      maxX = m.canvasWidth + margin
      maxY = m.canvasHeight + margin
      drawn = 0
      for k = 0 to strips.starts.count() - 1
        region = strips.regions[k]
        if invalid = region
          continue for
        end if
        low = strips.lows[k]
        high = strips.highs[k]
        across = strips.starts[k]
        texLength = high - low
        cropLow = -1
        cropHigh = -1
        ' top (low along) and foot (high along) at the strip's near edge
        ax = bx + across * sx
        ay = by + across * sy
        az = bz + across * sz
        width = strips.ends[k] - across
        if crossing
          ' keep the part where both edges are in front, and only its texels
          clipLow = m.nearClipAlong(az, lz, low, high, true)
          clipHigh = m.nearClipAlong(az, lz, low, high, false)
          farLow = m.nearClipAlong(az + width * sz, lz, low, high, true)
          farHigh = m.nearClipAlong(az + width * sz, lz, low, high, false)
          if farLow > clipLow
            clipLow = farLow
          end if
          if farHigh < clipHigh
            clipHigh = farHigh
          end if
          if clipHigh - clipLow < 0.01
            continue for
          end if
          if clipLow > low or clipHigh < high
            ' its whole texels fill the clipped length
            cropLow = int(clipLow)
            cropHigh = -int(-clipHigh)
            texLength = cropHigh - cropLow
            low = clipLow
            high = clipHigh
          end if
        end if
        topX = ax + low * lx
        topY = ay + low * ly
        topZ = az + low * lz
        footX = ax + high * lx
        footY = ay + high * ly
        footZ = az + high * lz
        nTopZ = topZ + width * sz
        nFootZ = footZ + width * sz
        ' a strip can reach a little past the triangle, so past the near plane
        if not crossing and (topZ > near or footZ > near or nTopZ > near or nFootZ > near)
          continue for
        end if
        nTopX = topX + width * sx
        nTopY = topY + width * sy
        nFootX = footX + width * sx
        nFootY = footY + width * sy
        if ortho
          tx = cx + scaleX * topX
          ty = cy - scaleY * topY
          fx = cx + scaleX * footX
          fy = cy - scaleY * footY
          ntx = cx + scaleX * nTopX
          nty = cy - scaleY * nTopY
          nfx = cx + scaleX * nFootX
          nfy = cy - scaleY * nFootY
        else
          tx = cx - focal * topX / topZ
          ty = cy + focal * topY / topZ
          fx = cx - focal * footX / footZ
          fy = cy + focal * footY / footZ
          ntx = cx - focal * nTopX / nTopZ
          nty = cy + focal * nTopY / nTopZ
          nfx = cx - focal * nFootX / nFootZ
          nfy = cy + focal * nFootY / nFootZ
        end if

        ' anchored at the far edge when seen from behind, as in drawTo()
        reversed = (nfx - fx) * (fy - ty) + (nfy - fy) * (tx - fx) < 0
        if reversed
          swap = fx
          fx = nfx
          nfx = swap
          swap = fy
          fy = nfy
          nfy = swap
          swap = tx
          tx = ntx
          ntx = swap
          swap = ty
          ty = nty
          nty = swap
        end if
        dx = tx - fx
        dy = ty - fy
        length = sqr(dx * dx + dy * dy)
        if length < 0.5
          continue for
        end if
        sinA = -dx / length
        cosA = -dy / length
        reach = (nfx - fx) * cosA - (nfy - fy) * sinA
        topReach = (ntx - tx) * cosA - (nty - ty) * sinA
        if topReach > reach
          reach = topReach
        end if
        drawWidth = reach + 1
        if drawWidth < 1
          drawWidth = 1.0
        end if
        reachX = drawWidth + margin
        if (fx < -reachX and tx < -reachX) or (fx > maxX + drawWidth and tx > maxX + drawWidth) or (fy < -reachX and ty < -reachX) or (fy > maxY + drawWidth and ty > maxY + drawWidth)
          continue for
        end if
        if cosA > 0
          angle = Atn(sinA / cosA) * 57.2957795
        else
          angle = BGE.Math.Atan2(sinA, cosA) * 57.2957795
        end if
        ' the whole slab, unless it would draw mirrored: a column's texels run away from its
        ' anchor, a row's (turned a quarter) toward it
        thin = reversed <> useRows
        if cropLow >= 0
          region = cuts.getCroppedRegion(useRows, strips, k, cropLow, cropHigh, thin)
        else if thin
          region = cuts.getThinRegion(useRows, strips, k)
        end if
        if thin
          acrossTexels = 1
        else
          acrossTexels = strips.ends[k] - strips.starts[k]
        end if
        if useRows
          target.DrawTransformedObject(fx, fy, angle - 90, length / texLength, drawWidth / acrossTexels, region, color)
        else
          target.DrawTransformedObject(fx, fy, angle, drawWidth / acrossTexels, length / texLength, region, color)
        end if
        drawn++
      end for
      m.columnsThisFrame += drawn
      return drawn
    end function

    ' The lowest (`fromLow`) or highest `along`, from `low` to `high`, where a strip edge at
    ' camera z `z0 + along * dz` is in front of the near plane. Past the other end if none is.
    private function nearClipAlong(z0 as float, dz as float, low as float, high as float, fromLow as boolean) as float
      near = m.nearZ
      if dz = 0
        if z0 > near
          if fromLow
            return high
          end if
          return low
        end if
        if fromLow
          return low
        end if
        return high
      end if
      crossAt = (near - z0) / dz
      if fromLow
        if dz < 0 and crossAt > low
          ' deeper as along grows: in front from crossAt on
          return crossAt
        end if
        if dz > 0 and crossAt < low
          return high
        end if
        return low
      end if
      if dz > 0 and crossAt < high
        ' shallower as along grows: in front up to crossAt
        return crossAt
      end if
      if dz < 0 and crossAt > high
        return low
      end if
      return high
    end function

    ' How far apart on screen the triangle's vertices nearest and farthest across its strips
    ' are, or -1 if either is behind the camera.
    private function triangleScreenExtent(vertices as float[], acrossPoints as float[]) as float
      lo = 0
      hi = 0
      for i = 1 to 2
        if acrossPoints[i] < acrossPoints[lo]
          lo = i
        end if
        if acrossPoints[i] > acrossPoints[hi]
          hi = i
        end if
      end for
      if m.ortho
        ax = m.scaleX * vertices[lo * 3]
        ay = m.scaleY * vertices[lo * 3 + 1]
        bx = m.scaleX * vertices[hi * 3]
        by = m.scaleY * vertices[hi * 3 + 1]
        return sqr((bx - ax) * (bx - ax) + (by - ay) * (by - ay))
      end if
      if vertices[lo * 3 + 2] > m.nearZ or vertices[hi * 3 + 2] > m.nearZ
        return -1
      end if
      focal = m.focal
      ax = -focal * vertices[lo * 3] / vertices[lo * 3 + 2]
      ay = focal * vertices[lo * 3 + 1] / vertices[lo * 3 + 2]
      bx = -focal * vertices[hi * 3] / vertices[hi * 3 + 2]
      by = focal * vertices[hi * 3 + 1] / vertices[hi * 3 + 2]
      return sqr((bx - ax) * (bx - ax) + (by - ay) * (by - ay))
    end function

    ' Projects column edge k at position s (in texels) along the quad, clipping it to the near
    ' plane, which squeezes its column's texture into what's left (columns run along
    ' constant-ish depth, so this is rare). Sets edgeOk[k]: false if it's wholly behind.
    private function projectEdge(k as integer, s as float) as boolean
      near = m.nearZ
      ax = m.tx0 + m.tdx * s
      ay = m.ty0 + m.tdy * s
      az = m.tz0 + m.tdz * s
      bx = m.fx0 + m.fdx * s
      by = m.fy0 + m.fdy * s
      bz = m.fz0 + m.fdz * s
      if az > near
        if bz > near
          m.edgeOk[k] = false
          return false
        end if
        t = (near - bz) / (az - bz)
        ax = bx + (ax - bx) * t
        ay = by + (ay - by) * t
        az = near
      else if bz > near
        t = (near - az) / (bz - az)
        bx = ax + (bx - ax) * t
        by = ay + (by - ay) * t
        bz = near
      end if
      m.edgeOk[k] = true
      if m.ortho
        m.topX[k] = m.centerX + m.scaleX * ax
        m.topY[k] = m.centerY - m.scaleY * ay
        m.footX[k] = m.centerX + m.scaleX * bx
        m.footY[k] = m.centerY - m.scaleY * by
        return true
      end if
      focal = m.focal
      m.topX[k] = m.centerX - focal * ax / az
      m.topY[k] = m.centerY + focal * ay / az
      m.footX[k] = m.centerX - focal * bx / bz
      m.footY[k] = m.centerY + focal * by / bz
      return true
    end function

    ' Where, between an edge at texel `behind` (wholly behind the near plane) and one at
    ' `ahead`, the top or foot first reaches it, in texels.
    private function nearCrossing(behind as float, ahead as float) as float
      lo = behind
      hi = ahead
      if ahead < behind
        lo = ahead
        hi = behind
      end if
      near = m.nearZ
      best = ahead
      if m.tdz <> 0
        s = (near - m.tz0) / m.tdz
        if s >= lo and s <= hi and abs(s - behind) < abs(best - behind)
          best = s
        end if
      end if
      if m.fdz <> 0
        s = (near - m.fz0) / m.fdz
        if s >= lo and s <= hi and abs(s - behind) < abs(best - behind)
          best = s
        end if
      end if
      ' nudge in front, so rounding can't leave it behind
      return best + (ahead - best) * 0.001
    end function

    ' The longer of the top and foot edges on screen, or -1 if a corner is behind the camera.
    private function screenExtent(corners as float[], t0 as integer, t1 as integer, f0 as integer, f1 as integer) as float
      near = m.nearZ
      for i = 0 to 3
        if corners[i * 3 + 2] > near
          return -1
        end if
      end for
      if m.ortho
        ax = m.scaleX * corners[t0 * 3]
        ay = m.scaleY * corners[t0 * 3 + 1]
        bx = m.scaleX * corners[t1 * 3]
        by = m.scaleY * corners[t1 * 3 + 1]
        topLength = sqr((bx - ax) * (bx - ax) + (by - ay) * (by - ay))
        ax = m.scaleX * corners[f0 * 3]
        ay = m.scaleY * corners[f0 * 3 + 1]
        bx = m.scaleX * corners[f1 * 3]
        by = m.scaleY * corners[f1 * 3 + 1]
      else
        focal = m.focal
        ax = -focal * corners[t0 * 3] / corners[t0 * 3 + 2]
        ay = focal * corners[t0 * 3 + 1] / corners[t0 * 3 + 2]
        bx = -focal * corners[t1 * 3] / corners[t1 * 3 + 2]
        by = focal * corners[t1 * 3 + 1] / corners[t1 * 3 + 2]
        topLength = sqr((bx - ax) * (bx - ax) + (by - ay) * (by - ay))
        ax = -focal * corners[f0 * 3] / corners[f0 * 3 + 2]
        ay = focal * corners[f0 * 3 + 1] / corners[f0 * 3 + 2]
        bx = -focal * corners[f1 * 3] / corners[f1 * 3 + 2]
        by = focal * corners[f1 * 3 + 1] / corners[f1 * 3 + 2]
      end if
      footLength = sqr((bx - ax) * (bx - ax) + (by - ay) * (by - ay))
      if footLength > topLength
        return footLength
      end if
      return topLength
    end function

    ' Splits the corner colors into channels, top-start, top-end, foot-start, foot-end.
    ' False if they're all the same, so one color will do.
    private function unpackCornerColors(colors as integer[], t0 as integer, t1 as integer, f0 as integer, f1 as integer) as boolean
      if colors[0] = colors[1] and colors[0] = colors[2] and colors[0] = colors[3]
        return false
      end if
      m.channels.Clear()
      m.pushChannels(colors[t0])
      m.pushChannels(colors[t1])
      m.pushChannels(colors[f0])
      m.pushChannels(colors[f1])
      return true
    end function

    private sub pushChannels(c as integer)
      m.channels.push((c >> 24) and &hFF)
      m.channels.push((c >> 16) and &hFF)
      m.channels.push((c >> 8) and &hFF)
      m.channels.push(c and &hFF)
    end sub

    ' The tint a fraction `s` of the way across the columns: the top and foot edges' tints there, averaged.
    private function columnColor(s as float) as integer
      ch = m.channels
      color = 0
      for c = 0 to 3
        top = ch[c] + (ch[4 + c] - ch[c]) * s
        foot = ch[8 + c] + (ch[12 + c] - ch[8 + c]) * s
        value = int((top + foot) * 0.5 + 0.5)
        if value > 255
          value = 255
        end if
        color = (color << 8) or value
      end for
      return color
    end function

    private sub grow(count as integer)
      for i = m.topX.count() to count - 1
        m.topX.push(0.0)
        m.topY.push(0.0)
        m.footX.push(0.0)
        m.footY.push(0.0)
        m.edgeOk.push(false)
      end for
    end sub

  end class

end namespace
