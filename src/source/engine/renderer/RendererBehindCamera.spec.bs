namespace tests

  ' Issue #308: Renderer never calls draw() on an object behind the camera, and draw() is
  ' where an object records its draw mode and geometry version - so a stationary object
  ' behind the camera used to look changed every frame, forcing a recompute and a depth
  ' re-sort every frame.
  @suite("BGE.Renderer objects behind the camera")
  class RendererBehindCameraTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    renderer as BGE.Renderer
    camera as BGE.Camera3d

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.camera = new BGE.Camera3d()
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 0)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, -1))
      m.renderer = new BGE.Renderer(CreateObject("roBitmap", {width: 200, height: 200, alphaEnable: true}), m.game, m.camera)
    end function

    private function newImage() as BGE.Image
      sourceBitmap = CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: true})
      region = CreateObject("roRegion", sourceBitmap, 0, 0, 64, 64)
      ' always faces the camera, so turning the camera around can't backface-cull it
      return new BGE.Image(m.entity, region, {drawMode: BGE.SceneObjectDrawMode.directScaled})
    end function

    private function drawFrame() as integer
      m.entity.updateTransformationMatrix()
      m.renderer.resetDrawCallCounter()
      m.renderer.setupCameraForFrame()
      m.renderer.render()
      return m.renderer.getDrawCallsLastFrame()
    end function

    @describe("a stationary object behind a parked camera")

    @it("stops reporting a depth change once everything has settled")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(0, 0, 100)
      sceneObj = m.newImage().addToRenderer(m.renderer)
      for i = 1 to 4
        m.drawFrame()
      end for
      m.assertFalse(sceneObj.depthChangedThisFrame)
    end function

    @it("doesn't make the renderer re-sort every frame")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(0, 0, 100)
      m.newImage().addToRenderer(m.renderer)
      for i = 1 to 4
        m.drawFrame()
      end for
      m.assertFalse(m.renderer.didSortLastFrame())
    end function

    @it("stops reporting a depth change when the scene also has static geometry")
    function _()
      ' a static wall in front switches the renderer to its static geometry (BSP) draw path
      wall = new BGE.GameEntity(m.game, {name: "wall", isStatic: true, position: BGE.Math.VectorOps.create(0, 0, -200)})
      wallRegion = CreateObject("roRegion", CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: true}), 0, 0, 64, 64)
      wallImage = new BGE.Image(wall, wallRegion)
      wallImage.addToRenderer(m.renderer)
      wall.updateTransformationMatrix()

      m.entity.position = BGE.Math.VectorOps.create(0, 0, 100)
      sceneObj = m.newImage().addToRenderer(m.renderer)
      for i = 1 to 4
        m.drawFrame()
      end for
      m.assertTrue(m.renderer.hasStaticGeometryTree(), "expected the static geometry draw path")
      m.assertFalse(sceneObj.depthChangedThisFrame)
    end function

    @it("draws once the camera turns to face it")
    function _()
      m.entity.position = BGE.Math.VectorOps.create(0, 0, 100)
      m.newImage().addToRenderer(m.renderer)
      for i = 1 to 4
        m.drawFrame()
      end for
      m.assertEqual(0, m.drawFrame())

      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, 1))
      m.assertTrue(m.drawFrame() > 0)
    end function

  end class

end namespace
