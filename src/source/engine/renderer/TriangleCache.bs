import "../../math/vector.bs"
import "RendererHelpers.bs"

namespace BGE

  class TriangleCacheEntry

    triangle as BGE.RendererHelpers.TriangleBitmap

    timeLastUsed as integer
    id as string = ""


    sub new(triangle as BGE.RendererHelpers.TriangleBitmap)
      m.triangle = triangle
    end sub


    sub updateTime(newTime as integer)
      m.timeLastUsed = newTime
    end sub

  end class


  class TriangleCache
    private cache = {}
    ' the cache keys added under each id: {id: {key: true}}
    private keysById = {}
    private dateTime as roDateTime
    private cacheKeepSeconds as integer
    sub new(cacheKeepSeconds = 60 as integer)
      m.dateTime = CreateObject("roDateTime")
      m.cacheKeepSeconds = cacheKeepSeconds
    end sub

    function getTriangle(id as string, points as BGE.Math.Vector[]) as BGE.RendererHelpers.TriangleBitmap
      if id = ""
        return invalid
      end if

      key = m.makeKey(id, points)

      if invalid <> m.cache[key]
        triangleEntry = m.cache[key]
        m.dateTime.mark()
        triangleEntry.updateTime(m.dateTime.asSeconds())
        return triangleEntry.triangle
      end if
      return invalid
    end function


    sub addTriangle(id as string, points as BGE.Math.Vector[], triangleBmp as BGE.RendererHelpers.TriangleBitmap)
      if id = "" or invalid = triangleBmp
        return
      end if

      key = m.makeKey(id, points)
      cacheEntry = new TriangleCacheEntry(triangleBmp)
      cacheEntry.id = id
      m.dateTime.mark()
      cacheEntry.updateTime(m.dateTime.asSeconds())
      m.cache[key] = cacheEntry
      if invalid = m.keysById[id]
        m.keysById[id] = {}
      end if
      m.keysById[id][key] = true
    end sub

    private function makeKey(id as string, points as BGE.Math.Vector[]) as string
      arrayString = "["
      i = 0
      for each point in points
        if i > 0
          arrayString += ","
        end if
        arrayString += BGE.Math.VectorOps.toStr(point)
        i++
      end for
      arrayString += "]"
      return id + "-" + arrayString
    end function


    ' Drops every triangle cached for this id, for a source bitmap that has been redrawn.
    '
    ' @param {string} id
    sub removeTrianglesWithId(id as string)
      keys = m.keysById[id]
      if invalid = keys
        return
      end if
      for each key in keys
        m.cache.delete(key)
      end for
      m.keysById.delete(id)
    end sub

    ' How many triangles are cached for this id.
    '
    ' @param {string} id
    ' @return {integer}
    function countTrianglesWithId(id as string) as integer
      count = 0
      keys = m.keysById[id]
      if invalid <> keys
        for each key in keys
          if invalid <> m.cache[key]
            count++
          end if
        end for
      end if
      return count
    end function

    sub cleanCache()
      m.dateTime.mark()
      currentTime = m.dateTime.asSeconds()

      for each item in m.cache.items()
        if invalid <> item.value
          cacheEntry = item.value
          timeDelta = currentTime - cacheEntry.timeLastUsed
          if timeDelta >= m.cacheKeepSeconds
            m.cache.delete(item.key)
            keys = m.keysById[cacheEntry.id]
            if invalid <> keys
              keys.delete(item.key)
              if keys.count() = 0
                m.keysById.delete(cacheEntry.id)
              end if
            end if
          end if
        end if
      end for
    end sub

  end class

end namespace
