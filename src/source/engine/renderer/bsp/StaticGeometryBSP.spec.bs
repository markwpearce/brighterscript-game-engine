namespace tests

  @suite("BGE.BSP")
  class StaticGeometryBSPTests extends rooibos.BaseTestSuite

    ' A quad centered at the origin, facing +Z (normal (0,0,1)) - e.g. the "far" wall
    ' of a box at z=0, box extends toward +Z.
    function planeAt(z as float, normalZ as float) as object
      return {
        planePoint: BGE.Math.VectorOps.create(0, 0, z),
        planeNormal: BGE.Math.VectorOps.create(0, 0, normalZ)
      }
    end function

    @describe("buildTree")

    @it("returns invalid for an empty item list")
    function _()
      m.assertInvalid(BGE.BSP.buildTree([]))
    end function

    @it("builds a single leaf node for one item")
    function _()
      p = m.planeAt(0, 1)
      node = BGE.BSP.buildTree([{sceneObj: "wallA", planePoint: p.planePoint, planeNormal: p.planeNormal}])
      m.assertEqual("wallA", node.item.sceneObj)
      m.assertInvalid(node.front)
      m.assertInvalid(node.back)
    end function

    @it("partitions a second item to front or back based on which side of the first item's plane it's on")
    function _()
      pivotPlane = m.planeAt(0, 1) ' plane through origin, normal +Z
      frontItem = {sceneObj: "front", planePoint: BGE.Math.VectorOps.create(0, 0, 10), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      backItem = {sceneObj: "back", planePoint: BGE.Math.VectorOps.create(0, 0, -10), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      node = BGE.BSP.buildTree([
        {sceneObj: "pivot", planePoint: pivotPlane.planePoint, planeNormal: pivotPlane.planeNormal},
        frontItem,
        backItem
      ])
      m.assertEqual("pivot", node.item.sceneObj)
      m.assertEqual("front", node.front.item.sceneObj)
      m.assertEqual("back", node.back.item.sceneObj)
    end function

    @describe("collectDrawOrder")

    @it("draws the single static item on its own")
    function _()
      p = m.planeAt(0, 1)
      node = BGE.BSP.buildTree([{sceneObj: "wall", planePoint: p.planePoint, planeNormal: p.planeNormal}])
      result = []
      BGE.BSP.collectDrawOrder(node, BGE.Math.VectorOps.create(0, 0, -100), [], result)
      m.assertEqual(1, result.count())
      m.assertEqual("wall", result[0])
    end function

    @it("draws back-to-front: farther wall first, nearer wall last, relative to the camera")
    function _()
      ' Two walls, at z=100 (far) and z=-100 (near), camera at z=-200 looking toward +Z.
      farWall = {sceneObj: "farWall", planePoint: BGE.Math.VectorOps.create(0, 0, 100), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      nearWall = {sceneObj: "nearWall", planePoint: BGE.Math.VectorOps.create(0, 0, -100), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      node = BGE.BSP.buildTree([farWall, nearWall])
      result = []
      BGE.BSP.collectDrawOrder(node, BGE.Math.VectorOps.create(0, 0, -200), [], result)
      m.assertEqual(["farWall", "nearWall"], result)
    end function

    @it("draws a dynamic object between two static planes in correct interleaved order - the ball-inside-a-box case")
    function _()
      ' Near wall at z=-100, far wall at z=100, camera at z=-200, ball at z=0 (between
      ' both walls). Expected order (back-to-front from the camera): far wall, ball, near wall.
      farWall = {sceneObj: "farWall", planePoint: BGE.Math.VectorOps.create(0, 0, 100), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      nearWall = {sceneObj: "nearWall", planePoint: BGE.Math.VectorOps.create(0, 0, -100), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      node = BGE.BSP.buildTree([farWall, nearWall])
      ball = {sceneObj: "ball", position: BGE.Math.VectorOps.create(0, 0, 0), depthKey: 0.0}
      result = []
      BGE.BSP.collectDrawOrder(node, BGE.Math.VectorOps.create(0, 0, -200), [ball], result)
      m.assertEqual(["farWall", "ball", "nearWall"], result)
    end function

    @describe("findLeaf / collectLeafOrder")

    @it("numbers each node in build order")
    function _()
      pivot = {sceneObj: "pivot", planePoint: BGE.Math.VectorOps.create(0, 0, 0), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      front = {sceneObj: "front", planePoint: BGE.Math.VectorOps.create(0, 0, 10), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      back = {sceneObj: "back", planePoint: BGE.Math.VectorOps.create(0, 0, -10), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      node = BGE.BSP.buildTree([pivot, front, back])
      m.assertEqual(0, node.id)
      m.assertEqual(1, node.front.id)
      m.assertEqual(2, node.back.id)
    end function

    @it("puts points on either side of a plane in different leaves, and every point in leaf 0 of an empty tree")
    function _()
      p = m.planeAt(0, 1)
      node = BGE.BSP.buildTree([{sceneObj: "wall", planePoint: p.planePoint, planeNormal: p.planeNormal}])
      m.assertNotEqual(BGE.BSP.findLeaf(node, 0, 0, 5), BGE.BSP.findLeaf(node, 0, 0, -5))
      m.assertEqual(BGE.BSP.findLeaf(node, 3, 7, 5), BGE.BSP.findLeaf(node, -3, 0, 50))
      m.assertEqual(0, BGE.BSP.findLeaf(invalid, 1, 2, 3))
    end function

    @it("appends each leaf's bucket where the leaf falls, back to front from the camera")
    function _()
      farWall = {sceneObj: "farWall", planePoint: BGE.Math.VectorOps.create(0, 0, 100), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      nearWall = {sceneObj: "nearWall", planePoint: BGE.Math.VectorOps.create(0, 0, -100), planeNormal: BGE.Math.VectorOps.create(0, 0, 1)}
      node = BGE.BSP.buildTree([farWall, nearWall])
      buckets = []
      buckets[BGE.BSP.findLeaf(node, 0, 0, 0)] = ["ball"]
      buckets[BGE.BSP.findLeaf(node, 0, 0, 150)] = ["beyond"]
      result = []
      BGE.BSP.collectLeafOrder(node, BGE.Math.VectorOps.create(0, 0, -200), buckets, result)
      m.assertEqual(["beyond", "farWall", "ball", "nearWall"], result)
    end function

    @it("appends leaf 0's bucket alone for an empty tree")
    function _()
      result = []
      BGE.BSP.collectLeafOrder(invalid, BGE.Math.VectorOps.create(0, 0, -200), [["a", "b"]], result)
      m.assertEqual(["a", "b"], result)
    end function

    @describe("findBoundsLeaf")

    ' A fence in the z=0 plane from x=0 to 200, y=0 to 50, facing +z
    function fenceTree() as object
      corners = [
        BGE.Math.VectorOps.create(0, 50, 0),
        BGE.Math.VectorOps.create(200, 50, 0),
        BGE.Math.VectorOps.create(0, 0, 0),
        BGE.Math.VectorOps.create(200, 0, 0)
      ]
      return BGE.BSP.buildTree([{sceneObj: "fence", planePoint: BGE.Math.VectorOps.create(100, 25, 0), planeNormal: BGE.Math.VectorOps.create(0, 0, 1), corners: corners}])
    end function

    ' A box's 8 corners
    function boxPoints(minX as float, maxX as float, minZ as float, maxZ as float) as BGE.Math.Vector[]
      points = [] as BGE.Math.Vector[]
      for each px in [minX, maxX]
        for each py in [0, 100]
          for each pz in [minZ, maxZ]
            points.push(BGE.Math.VectorOps.create(px, py, pz))
          end for
        end for
      end for
      return points
    end function

    @it("places a box wholly on one side by its bounds, without the camera")
    function _()
      tree = m.fenceTree()
      state = {usesCamera: true} as BGE.BSP.LeafState
      leaf = BGE.BSP.findBoundsLeaf(tree, 350, 50, 30, m.boxPoints(300, 400, 10, 50), BGE.Math.VectorOps.create(0, 0, -500), state)
      m.assertEqual(leaf, BGE.BSP.findLeaf(tree, 350, 50, 30))
      m.assertFalse(state.usesCamera)
    end function

    @it("places a box across the plane past the quad's end on the side that draws it after the quad when the camera is beyond it")
    function _()
      tree = m.fenceTree()
      state = {usesCamera: false} as BGE.BSP.LeafState
      ' centre just behind the plane; camera in front of it, past the box's end
      cameraPosition = BGE.Math.VectorOps.create(500, 60, 250)
      buckets = []
      buckets[BGE.BSP.findBoundsLeaf(tree, 350, 50, -10, m.boxPoints(300, 400, -60, 40), cameraPosition, state)] = ["house"]
      m.assertTrue(state.usesCamera)
      result = []
      BGE.BSP.collectLeafOrder(tree, cameraPosition, buckets, result)
      m.assertEqual(result, ["fence", "house"])
    end function

    @it("places the same box before the quad when the camera is past the quad's other end")
    function _()
      tree = m.fenceTree()
      state = {usesCamera: false} as BGE.BSP.LeafState
      cameraPosition = BGE.Math.VectorOps.create(-300, 60, 150)
      buckets = []
      ' centre just in front of the plane this time, on the camera's side
      buckets[BGE.BSP.findBoundsLeaf(tree, 350, 50, 10, m.boxPoints(300, 400, -40, 60), cameraPosition, state)] = ["house"]
      result = []
      BGE.BSP.collectLeafOrder(tree, cameraPosition, buckets, result)
      m.assertEqual(result, ["house", "fence"])
    end function

    @it("uses the centre's side for a box that crosses the quad itself")
    function _()
      tree = m.fenceTree()
      state = {usesCamera: true} as BGE.BSP.LeafState
      leaf = BGE.BSP.findBoundsLeaf(tree, 100, 50, -10, m.boxPoints(50, 150, -60, 40), BGE.Math.VectorOps.create(100, 60, 300), state)
      m.assertEqual(leaf, BGE.BSP.findLeaf(tree, 100, 50, -10))
      m.assertFalse(state.usesCamera)
    end function

    @it("sorts multiple dynamic objects at the same leaf by depthKey ascending (farthest first)")
    function _()
      ' depthKey dot-assigned, not in the literal: brs-cli's SortBy ignores a camelCase
      ' key written in an AA literal (#230)
      farBall = {sceneObj: "farBall", position: BGE.Math.VectorOps.create(0, 0, 50)} as BGE.BSP.DynamicItem
      farBall.depthKey = -50.0
      nearBall = {sceneObj: "nearBall", position: BGE.Math.VectorOps.create(0, 0, -50)} as BGE.BSP.DynamicItem
      nearBall.depthKey = -150.0
      result = []
      BGE.BSP.collectDrawOrder(invalid, BGE.Math.VectorOps.create(0, 0, -200), [farBall, nearBall], result)
      m.assertEqual(["nearBall", "farBall"], result)
    end function

  end class

end namespace
