import "../../../math/vector.bs"

namespace BGE.BSP

  ' One static quad's plane, in world space - planePoint/planeNormal come from the
  ' quad's own BGE.Math.CornerPoints.getCenter()/getNormal(). sceneObj is an opaque
  ' payload this module never inspects - the caller gets it back unchanged in
  ' collectDrawOrder()'s result.
  interface StaticItem
    sceneObj as dynamic
    planePoint as BGE.Math.Vector
    planeNormal as BGE.Math.Vector
    ' The quad's corners (topLeft, topRight, bottomLeft, bottomRight), so findBoundsLeaf() can
    ' order an object that crosses the quad's plane beyond the quad's edges
    optional corners as BGE.Math.Vector[]
    ' A solid's faces (see hullFaces()), outward normals: instead of one plane, the item becomes a
    ' chain of nodes, one per face, and draws at the innermost - so anything outside the solid is
    ' ordered by a face that separates it. planePoint is the solid's centre.
    optional hullFaces as BGE.BSP.HullFace[]
  end interface

  ' One face of a solid's hull: a quad with an outward normal
  interface HullFace
    planePoint as BGE.Math.Vector
    planeNormal as BGE.Math.Vector
    ' topLeft, topRight, bottomLeft, bottomRight, as StaticItem.corners
    corners as BGE.Math.Vector[]
  end interface

  ' One dynamic (non-static) object being threaded into the BSP walk. depthKey mirrors
  ' BGE.SceneObject.negDistanceFromCamera's convention (ascending = farthest from the
  ' camera first) - used only to order objects that land in the same leaf, where no more
  ' static geometry disambiguates them further.
  interface DynamicItem
    sceneObj as dynamic
    position as BGE.Math.Vector
    depthKey as float
    ' Points bounding the object, to place it with findBoundsLeaf() instead of findLeaf()
    optional points as BGE.Math.Vector[]
  end interface

  ' findBoundsLeaf()'s second result
  interface LeafState extends roAssociativeArray
    ' Whether the leaf depends on the camera position as well as the object's
    usesCamera as boolean
  end interface

  ' Builds a classification-only BSP tree over static quads and solids - no polygon splitting
  ' (see the design spec for why). Picks the first item as each node's splitting plane (a
  ' solid: a chain of its faces' planes) and partitions every other remaining item to
  ' front/back by which side of that plane its center falls on. Each node gets an `id` (0 up,
  ' in build order) for findLeaf(); a solid's outer faces' nodes have no item.
  '
  ' @param {BGE.BSP.StaticItem[]} items
  ' @param {object} counter internal: shares the next node id across the recursion
  ' @return {object} `invalid` for an empty list, else `{item, front, back, id}`
  function buildTree(items as BGE.BSP.StaticItem[], counter = invalid as object) as object
    if items.count() = 0
      return invalid
    end if
    if counter = invalid
      counter = {next: 0}
      ' Solids first: a quad's plane runs on past its edges, so a solid across it but beyond
      ' them (a house past the end of a fence, on its line) can't be put on one side for every
      ' camera, while a quad beyond a solid is wholly in front of one of its faces
      ordered = []
      for each item in items
        if item.hullFaces <> invalid and item.hullFaces.count() > 0
          ordered.push(item)
        end if
      end for
      for each item in items
        if item.hullFaces = invalid or item.hullFaces.count() = 0
          ordered.push(item)
        end if
      end for
      items = ordered
    end if
    pivot = items[0]
    if pivot.hullFaces <> invalid and pivot.hullFaces.count() > 0
      return buildHullChain(pivot, items, 1, counter)
    end if
    node = createNode(pivot.planePoint, pivot.planeNormal, pivot.corners, counter)
    node.item = pivot
    front = []
    back = []
    for i = 1 to items.count() - 1
      item = items[i]
      if pointSide(node, item.planePoint) >= 0
        front.push(item)
      else
        back.push(item)
      end if
    end for
    node.front = buildTree(front, counter)
    node.back = buildTree(back, counter)
    return node
  end function

  ' The six faces of a box (any parallelepiped) for StaticItem.hullFaces, sides first, then top
  ' and bottom. A face with no area (a flat box's sides) is left out.
  '
  ' @param {BGE.Math.Vector[]} corners the 8 corners in BGE.Math.getBoundingCubePoints() order
  '   (index bit 4: max x, 2: max y, 1: max z), transformed as you like
  ' @return {BGE.BSP.HullFace[]}
  function boxHullFaces(corners as BGE.Math.Vector[]) as BGE.BSP.HullFace[]
    cx = 0.0
    cy = 0.0
    cz = 0.0
    for each c in corners
      cx += c.x
      cy += c.y
      cz += c.z
    end for
    cx /= 8
    cy /= 8
    cz /= 8
    ' each quad's first corner to its second and to its third run along its two edges
    quads = [[0, 1, 2, 3], [4, 5, 6, 7], [0, 2, 4, 6], [1, 3, 5, 7], [2, 3, 6, 7], [0, 1, 4, 5]]
    faces = [] as BGE.BSP.HullFace[]
    for each q in quads
      a = corners[q[0]]
      b = corners[q[1]]
      c = corners[q[2]]
      d = corners[q[3]]
      ux = b.x - a.x
      uy = b.y - a.y
      uz = b.z - a.z
      vx = c.x - a.x
      vy = c.y - a.y
      vz = c.z - a.z
      nx = uy * vz - uz * vy
      ny = uz * vx - ux * vz
      nz = ux * vy - uy * vx
      length = Sqr(nx * nx + ny * ny + nz * nz)
      if length > 0.000001
        px = (a.x + b.x + c.x + d.x) / 4
        py = (a.y + b.y + c.y + d.y) / 4
        pz = (a.z + b.z + c.z + d.z) / 4
        ' outward: away from the box's centre
        if nx * (px - cx) + ny * (py - cy) + nz * (pz - cz) < 0
          length = -length
        end if
        faces.push({
          planePoint: BGE.Math.VectorOps.create(px, py, pz),
          planeNormal: BGE.Math.VectorOps.create(nx / length, ny / length, nz / length),
          corners: [a, b, c, d]
        })
      end if
    end for
    return faces
  end function

  ' One node per face of pivot's hull, each the next one's back child; the innermost holds pivot,
  ' so the walk draws it after the faces the camera is behind and before those it's in front of.
  ' Each other item goes in front of the one face hullFaceFor() picks, or inside (the innermost
  ' node's back). The first node keeps the face planes, so findBoundsLeaf() picks the same way.
  function buildHullChain(pivot as BGE.BSP.StaticItem, items as BGE.BSP.StaticItem[], firstItem as integer, counter as object) as object
    faces = pivot.hullFaces
    faceCount = faces.count()
    planes = [] as float[]
    for each face in faces
      n = face.planeNormal
      p = face.planePoint
      planes.append([n.x, n.y, n.z, n.x * p.x + n.y * p.y + n.z * p.z])
    end for
    ' one group per face, then inside
    groups = []
    for k = 0 to faceCount
      groups.push([])
    end for
    for i = firstItem to items.count() - 1
      item = items[i]
      c = item.planePoint
      k = hullFaceFor(planes, itemPoints(item), c.x, c.y, c.z)
      if k < 0
        k = faceCount
      end if
      groups[k].push(item)
    end for
    head = invalid
    previous = invalid
    for k = 0 to faceCount - 1
      face = faces[k]
      ' no corners: past a face's edge isn't past the solid, so findBoundsLeaf()'s edge test doesn't apply
      node = createNode(face.planePoint, face.planeNormal, invalid, counter)
      node.front = buildTree(groups[k], counter)
      if k = 0
        node.hullPlanes = planes
        head = node
      else
        previous.back = node
      end if
      previous = node
    end for
    previous.item = pivot
    previous.back = buildTree(groups[faceCount], counter)
    return head
  end function

  ' Which of a solid's faces orders something against it: the first it's wholly in front of
  ' (that plane separates them), else the one its centre is farthest in front of (a fence past a
  ' house's corner crosses every face's plane), else -1 when its centre is inside.
  '
  ' @param {float[]} planes nx, ny, nz, d per face
  ' @param {BGE.Math.Vector[]} points bounding it; empty to go by the centre alone
  ' @return {integer} face index, or -1
  function hullFaceFor(planes as float[], points as BGE.Math.Vector[], cx as float, cy as float, cz as float) as integer
    bestFace = -1
    bestSide = 0.0
    for k = 0 to planes.count() - 1 step 4
      nx = planes[k]
      ny = planes[k + 1]
      nz = planes[k + 2]
      d = planes[k + 3]
      side = nx * cx + ny * cy + nz * cz - d
      wholly = side >= 0
      for each p in points
        if nx * p.x + ny * p.y + nz * p.z < d
          wholly = false
          exit for
        end if
      end for
      if wholly
        return k \ 4
      end if
      if side > bestSide
        bestSide = side
        bestFace = k \ 4
      end if
    end for
    return bestFace
  end function

  ' The points bounding a static item: a quad's corners, or a solid's faces' corners
  function itemPoints(item as BGE.BSP.StaticItem) as BGE.Math.Vector[]
    if item.hullFaces <> invalid
      points = [] as BGE.Math.Vector[]
      for each face in item.hullFaces
        points.append(face.corners)
      end for
      return points
    end if
    if item.corners <> invalid
      return item.corners
    end if
    return []
  end function

  ' How far point is in front of node's plane
  function pointSide(node as object, point as BGE.Math.Vector) as float
    return node.nx * point.x + node.ny * point.y + node.nz * (point.z ?? 0.0) - node.d
  end function

  ' A node on the plane through point with normal, its id the counter's next. With corners
  ' (a quad's, as StaticItem.corners) it also gets the quad's extent along its two edges, for
  ' findBoundsLeaf(). item, front and back are left for the caller.
  function createNode(point as BGE.Math.Vector, normal as BGE.Math.Vector, corners as dynamic, counter as object) as object
    ' the plane as n.x*x + n.y*y + n.z*z = d, so classifying a point is one inline expression
    node = {
      item: invalid,
      id: counter.next,
      nx: normal.x,
      ny: normal.y,
      nz: normal.z,
      d: normal.x * point.x + normal.y * point.y + normal.z * point.z,
      hasExtent: false
    }
    counter.next++
    if corners <> invalid
      ' The quad's extent along its two edges, for findBoundsLeaf()
      u = BGE.Math.VectorOps.subtract(corners[1], corners[0])
      v = BGE.Math.VectorOps.subtract(corners[2], corners[0])
      uLength = Sqr(u.x * u.x + u.y * u.y + u.z * u.z)
      vLength = Sqr(v.x * v.x + v.y * v.y + v.z * v.z)
      if uLength > 0 and vLength > 0
        node.hasExtent = true
        node.ux = u.x / uLength
        node.uy = u.y / uLength
        node.uz = u.z / uLength
        node.vx = v.x / vLength
        node.vy = v.y / vLength
        node.vz = v.z / vLength
        node.uMin = 1e30
        node.uMax = -1e30
        node.vMin = 1e30
        node.vMax = -1e30
        for each corner in corners
          cu = node.ux * corner.x + node.uy * corner.y + node.uz * corner.z
          cv = node.vx * corner.x + node.vy * corner.y + node.vz * corner.z
          if cu < node.uMin
            node.uMin = cu
          end if
          if cu > node.uMax
            node.uMax = cu
          end if
          if cv < node.vMin
            node.vMin = cv
          end if
          if cv > node.vMax
            node.vMax = cv
          end if
        end for
      end if
    end if
    return node
  end function

  ' Which leaf of the tree a point falls in: an index into the buckets collectLeafOrder()
  ' takes. Depends only on the point and the tree, so callers can cache it while neither
  ' changes. An empty tree has the one leaf 0.
  '
  ' @param {object} root result of buildTree(), or invalid
  ' @return {integer} leaf index, 0 to twice the node count - 1
  function findLeaf(root as object, x as float, y as float, z as float) as integer
    node = root
    leaf = 0
    while node <> invalid
      if node.nx * x + node.ny * y + node.nz * z >= node.d
        leaf = node.id * 2
        node = node.front
      else
        leaf = node.id * 2 + 1
        node = node.back
      end if
    end while
    return leaf
  end function

  ' Like findLeaf(), for an object with size: `points` bound it, and (x, y, z) is its centre.
  ' An object wholly on one side of a node's plane goes that side. One that crosses the plane
  ' but lies past the quad's edges (a house across the line of a fence down the street) goes
  ' on whichever side draws it in the right order from the camera, as a plane at the quad's
  ' edge separates them; it then sets state.usesCamera. Otherwise its centre's side is used.
  '
  ' @param {object} root result of buildTree(), or invalid
  ' @param {BGE.Math.Vector[]} points
  ' @param {BGE.Math.Vector} cameraPosition
  ' @param {BGE.BSP.LeafState} state set on return
  ' @return {integer} leaf index, as findLeaf()
  function findBoundsLeaf(root as object, x as float, y as float, z as float, points as BGE.Math.Vector[], cameraPosition as BGE.Math.Vector, state as BGE.BSP.LeafState) as integer
    state.usesCamera = false
    node = root
    leaf = 0
    while node <> invalid
      planes = node.hullPlanes
      if planes <> invalid
        ' a solid's chain: in front of the face hullFaceFor() picks, else on to the inside
        face = hullFaceFor(planes, points, x, y, z)
        last = planes.count() \ 4 - 1
        for k = 0 to last
          if k = face
            leaf = node.id * 2
            node = node.front
            exit for
          end if
          leaf = node.id * 2 + 1
          node = node.back
        end for
      else
        nx = node.nx
        ny = node.ny
        nz = node.nz
        d = node.d
        low = 1e30
        high = -1e30
        for each p in points
          side = nx * p.x + ny * p.y + nz * p.z - d
          if side < low
            low = side
          end if
          if side > high
            high = side
          end if
        end for
        if low >= 0
          inFront = true
        else if high < 0
          inFront = false
        else
          inFront = nx * x + ny * y + nz * z >= d
          if node.hasExtent
            ' 1: the object draws after the quad, -1: before it, 0: they overlap on both edges
            order = separatedOrder(node.ux, node.uy, node.uz, node.uMin, node.uMax, points, cameraPosition)
            if order = 0
              order = separatedOrder(node.vx, node.vy, node.vz, node.vMin, node.vMax, points, cameraPosition)
            end if
            if order <> 0
              state.usesCamera = true
              ' the child on the camera's side draws after the quad
              inFront = (nx * cameraPosition.x + ny * cameraPosition.y + nz * cameraPosition.z >= d) = (order > 0)
            end if
          end if
        end if
        if inFront
          leaf = node.id * 2
          node = node.front
        else
          leaf = node.id * 2 + 1
          node = node.back
        end if
      end if
    end while
    return leaf
  end function

  ' Along one of a quad's edge directions (ax, ay, az), where the quad spans quadMin to
  ' quadMax: 0 if `points` overlap that span, else 1 if the camera is on the points' side of
  ' the gap (they draw after the quad), -1 if on the quad's.
  function separatedOrder(ax as float, ay as float, az as float, quadMin as float, quadMax as float, points as BGE.Math.Vector[], cameraPosition as BGE.Math.Vector) as integer
    low = 1e30
    high = -1e30
    for each p in points
      along = ax * p.x + ay * p.y + az * p.z
      if along < low
        low = along
      end if
      if along > high
        high = along
      end if
    end for
    cameraAlong = ax * cameraPosition.x + ay * cameraPosition.y + az * cameraPosition.z
    if low > quadMax
      if cameraAlong > (quadMax + low) / 2
        return 1
      end if
      return -1
    end if
    if high < quadMin
      if cameraAlong < (high + quadMin) / 2
        return 1
      end if
      return -1
    end if
    return 0
  end function

  ' Walks the tree back-to-front relative to the camera, appending each static item's
  ' sceneObj to result, with each leaf's bucket (buckets[findLeaf(...)], already in draw
  ' order, or invalid when empty) appended where the leaf falls.
  '
  ' @param {object} node result of buildTree(), or invalid
  ' @param {BGE.Math.Vector} cameraPosition
  ' @param {object[]} buckets arrays of payloads by leaf index
  ' @param {dynamic[]} result appended to in draw order
  sub collectLeafOrder(node as object, cameraPosition as BGE.Math.Vector, buckets as object[], result as dynamic[])
    if node = invalid
      if buckets[0] <> invalid
        result.append(buckets[0])
      end if
      return
    end if
    collectNodeOrder(node, cameraPosition.x, cameraPosition.y, cameraPosition.z, buckets, result)
  end sub

  sub collectNodeOrder(node as object, cx as float, cy as float, cz as float, buckets as object[], result as dynamic[])
    frontLeaf = node.id * 2
    if node.nx * cx + node.ny * cy + node.nz * cz >= node.d
      ' camera in front: the back subtree is farther, so it draws first
      firstChild = node.back
      firstLeaf = frontLeaf + 1
      secondChild = node.front
      secondLeaf = frontLeaf
    else
      firstChild = node.front
      firstLeaf = frontLeaf
      secondChild = node.back
      secondLeaf = frontLeaf + 1
    end if
    if firstChild = invalid
      if buckets[firstLeaf] <> invalid
        result.append(buckets[firstLeaf])
      end if
    else
      collectNodeOrder(firstChild, cx, cy, cz, buckets, result)
    end if
    if node.item <> invalid
      result.push(node.item.sceneObj)
    end if
    if secondChild = invalid
      if buckets[secondLeaf] <> invalid
        result.append(buckets[secondLeaf])
      end if
    else
      collectNodeOrder(secondChild, cx, cy, cz, buckets, result)
    end if
  end sub

  ' Walks the tree back-to-front relative to cameraPosition, appending each static
  ' item's sceneObj payload to result in the correct draw position, with dynamicItems
  ' classified against each node's plane and interleaved at the matching point instead
  ' of being split. A leaf (node = invalid) appends its remaining dynamicItems sorted by
  ' depthKey ascending.
  '
  ' @param {object} node result of buildTree(), or invalid
  ' @param {BGE.Math.Vector} cameraPosition
  ' @param {BGE.BSP.DynamicItem[]} dynamicItems
  ' @param {dynamic[]} result appended to in draw order - not returned, so a caller can
  '   reuse one array across a partial traversal if ever needed
  sub collectDrawOrder(node as object, cameraPosition as BGE.Math.Vector, dynamicItems as BGE.BSP.DynamicItem[], result as dynamic[])
    ' Ascending sort = farthest-first (back-to-front painter's order), matching
    ' Renderer.bs's own depth-sort convention. Note: the pinned brs-node@2.6.0 test
    ' binary used by `npm run test:ci` has a confirmed numeric-sortBy bug that sorts
    ' descending instead of ascending - real Roku/brs-engine hardware sorts ascending
    ' as documented. See issue #230.
    dynamicItems.sortBy("depthKey")
    buckets = []
    state = {usesCamera: false} as BGE.BSP.LeafState
    for each dynItem in dynamicItems
      position = dynItem.position
      if dynItem.points <> invalid
        leaf = findBoundsLeaf(node, position.x, position.y, position.z, dynItem.points, cameraPosition, state)
      else
        leaf = findLeaf(node, position.x, position.y, position.z)
      end if
      if buckets[leaf] = invalid
        buckets[leaf] = []
      end if
      buckets[leaf].push(dynItem.sceneObj)
    end for
    collectLeafOrder(node, cameraPosition, buckets, result)
  end sub

end namespace
