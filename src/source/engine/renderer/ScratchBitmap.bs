import "../../math/math.bs"
import "../../math/vector.bs"
import "../../utils/deviceRenderTier.bs"
import "../interfaces.bs"

namespace BGE

  class ScratchBitmap

    bitmap as roBitmap
    id as string

    sub new(id as string, w as integer, h as integer)
      m.bitmap = CreateObject("roBitmap", {width: w, height: h, alphaEnable: true})
      m.id = id
      if invalid = m.bitmap
        print "Failed to create bitmap for ScratchBitmap with id: "; id
        return
      else
        m.bitmap.SetAlphaEnable(true)
        m.bitmap.Clear(0)
      end if

    end sub
  end class


  class ScratchRegion

    region as roRegion
    scratchBmp as ScratchBitmap
    scale = BGE.Math.createScaleVector(1)

    sub new(region as roRegion, scratchBmp as ScratchBitmap)
      m.region = region
      m.scratchBmp = scratchBmp
      m.region.SetAlphaEnable(true)
      m.scratchBmp.bitmap.SetAlphaEnable(true)
      m.region.clear(0)
    end sub

    function getBitmapObject() as roBitmap
      return m.scratchBmp.bitmap
    end function

  end class

  class ScratchBitmapPool

    private pool as ScratchBitmap[] = []

    ' These values work for low-end devices (Express, eg)
    ' Ideally, the width and height of the scratch bitmaps would be bigger
    ' For example, a Roku Ultra 4k can handle 1920x1080
    ' It is unknown what the "correct" size is for various devices
    ' But it would be great to have a look-up table for best values for different devices

    private scratchWidth as integer = 1080
    private scratchHeight as integer = 1080

    private nextId = 0

    private maxPoolCount = 20
    private defaultInitialCount = 10
    private activePoolCount = 0

    private doPooling = true

    ' Only for tests: setUpBasedOnDevice() normally force-disables pooling under the
    ' simulator/brs-cli (it doesn't need pooling), which makes the per-frame reuse behavior
    ' below unobservable in headless Rooibos runs. Setting this bypasses that override
    ' so tests can exercise the real pooling path. Never set outside a test.
    private forcePoolingRegardlessOfDevice = false

    ' Bitmaps returned this frame. A real Roku can still have queued draws reading
    ' from them after Finish(), so they only go back in the pool at onFrameEnd() -
    ' reusing (and clearing) one mid-frame wiped triangles drawn from it (#345).
    private usedThisFrame as ScratchBitmap[] = []

    ' initialCount < 0 uses the device tier's default (see setUpBasedOnDevice())
    sub new(doPooling = true as boolean, initialCount = -1 as integer, forcePoolingRegardlessOfDevice = false as boolean)
      m.doPooling = doPooling
      m.forcePoolingRegardlessOfDevice = forcePoolingRegardlessOfDevice
      m.setUpBasedOnDevice()
      if initialCount < 0
        initialCount = m.defaultInitialCount
      end if
      for i = 0 to initialCount - 1
        m.addNewBitmapToPool()
      end for
    end sub

    private sub setUpBasedOnDevice()

      tier = BGE.getDeviceRenderTier()
      if tier = BGE.DeviceRenderTier.simulator and not m.forcePoolingRegardlessOfDevice
        ' The simulator does not need pooling
        m.doPooling = false
        return
      end if

      ' Get Max UI resolution supported by the device, and use that as the size for the scratch bitmaps
      if tier = BGE.DeviceRenderTier.sd
        m.scratchWidth = 256
        m.scratchHeight = 256
      else if tier = BGE.DeviceRenderTier.hd
        ' A Roku Express has a 64MB texture budget: ten 720x720 scratch bitmaps up front
        ' took ~21MB of it, enough to stop a game's own images loading (#151)
        m.scratchWidth = 512
        m.scratchHeight = 512
        m.defaultInitialCount = 2
        m.maxPoolCount = 10
      else if tier = BGE.DeviceRenderTier.fhd
        m.scratchWidth = 1080
        m.scratchHeight = 1080
      end if

      if m.scratchHeight >= 1080
        ' Each is ~4.5MB of texture memory, and nothing is reused within a frame, so a
        ' busy frame used to grow the pool to 30 (~140MB) and starve other bitmaps (#345).
        ' Past this, regions are exact-size one-off bitmaps, freed when the frame is done.
        m.maxPoolCount = 10
      end if
    end sub

    private sub addNewBitmapToPool()
      if not m.doPooling
        return
      end if

      id = m.nextId.toStr()
      m.nextId++

      m.pool.push(new ScratchBitmap(id, m.scratchWidth, m.scratchHeight))
      m.activePoolCount++
    end sub


    function getRegion(askedForWidth as float, askedForHeight as float, onTopRight = false as boolean) as BGE.ScratchRegion
      if not m.doPooling
        return getNewMemoryScratchRegion(askedForWidth, askedForHeight)
      end if
      width = BGE.Math.Clamp(fix(askedForWidth + 1), 1, m.scratchWidth)
      height = BGE.Math.Clamp(fix(askedForHeight + 1), 1, m.scratchHeight)

      if width > m.scratchWidth or height > m.scratchHeight
        return invalid
      end if
      bmp as ScratchBitmap = invalid
      if m.pool.count() > 0
        'bmp = m.pool[m.pool.count() - 1]
        bmp = m.pool[0]'m.pool.count() - 1]
        m.pool.Shift()'pop()
      end if
      if bmp = invalid and m.activePoolCount < m.maxPoolCount
        print "BMP Pool has been drained, adding new bitmap to pool"
        m.addNewBitmapToPool()
        'bmp = m.pool[m.pool.count() - 1]
        bmp = m.pool[0]
        m.pool.Shift()'pop()
        if bmp = invalid or bmp.bitmap = invalid
          return invalid
        end if
      end if


      region as roRegion = invalid
      if bmp = invalid
        ' every pooled bitmap is in use this frame - a one-off bitmap is safe to draw into
        return getNewMemoryScratchRegion(width, height)
      end if
      if not onTopRight
        ' create region on top left
        region = CreateObject("roRegion", bmp.bitmap, 0, 0, width, height) as roRegion
      else
        ' create region on top right
        region = CreateObject("roRegion", bmp.bitmap, m.scratchWidth - width, 0, width, height) as roRegion
      end if
      if invalid = region
        m.pool.push(bmp)
        print "Valid bitmap could not be used to create region"
        print m.toStr()
        return invalid
      end if

      result = new ScratchRegion(region, bmp)
      if askedForWidth > m.scratchWidth or askedForHeight > m.scratchHeight
        minScale = BGE.Math.min(width / askedForWidth, height / askedForHeight)
        result.scale = BGE.Math.createScaleVector(minScale)
      end if
      return result
    end function

    ' Hands a region back. Its bitmap is reused from the next frame on (see onFrameEnd()).
    '
    ' @param {ScratchRegion} usedRegion
    sub returnRegion(usedRegion as ScratchRegion)
      if usedRegion = invalid or not m.doPooling or usedRegion.scratchBmp.id = "temp"
        return
      end if
      m.usedThisFrame.push(usedRegion.scratchBmp)
    end sub

    sub returnRegions(usedRegions as ScratchRegion[])
      if not m.doPooling
        return
      end if

      for i = usedRegions.count() - 1 to 0 step -1
        region = usedRegions[i]
        m.returnRegion(region)
      end for
    end sub


    ' Same as returnRegions() - kept for callers that draw from the regions later this frame.
    '
    ' @param {ScratchRegion[]} usedRegions
    sub stageRegionsForReturn(usedRegions as ScratchRegion[])
      m.returnRegions(usedRegions)
    end sub

    ' No-op, kept for existing callers: returned regions are reused from the next frame.
    sub returnStagedRegions()
    end sub

    ' Makes every bitmap returned this frame available again. Call once per frame, after
    ' the screen has been swapped (Renderer.onSwapBuffers() does).
    sub onFrameEnd()
      for each bmp in m.usedThisFrame
        m.pool.push(bmp)
      end for
      m.usedThisFrame = []
    end sub

    sub clearPool()
      m.pool = []
      m.usedThisFrame = []
      m.activePoolCount = 0
    end sub

    ' Whether regions come from pooled bitmaps (and so are limited to getMaxSize()).
    function isPooling() as boolean
      return m.doPooling
    end function

    function getMaxSize() as SizeWH
      return {width: m.scratchWidth, height: m.scratchHeight}
    end function

    ' How many returned bitmaps are waiting for onFrameEnd().
    function getUsedThisFrameCount() as integer
      return m.usedThisFrame.count()
    end function

    ' The hard cap on how many ScratchBitmap instances this pool will ever create.
    function getMaxPoolCount() as integer
      return m.maxPoolCount
    end function

    function toStr() as string
      return "ScratchBitmapPool: " + m.pool.count().toStr() + " / " + m.activePoolCount.toStr() + " (" + m.maxPoolCount.toStr() + ")"
    end function

  end class


  function getNewMemoryScratchRegion(width as float, height as float) as ScratchRegion
    if width < 1 or height < 1
      return invalid
    end if
    bmp = new ScratchBitmap("temp", width, height)
    if invalid = bmp
      return invalid
    end if
    region = CreateObject("roRegion", bmp.bitmap, 0, 0, width, height)
    if invalid = region
      return invalid
    end if
    region.SetAlphaEnable(true)
    return new ScratchRegion(region, bmp)
  end function

end namespace
