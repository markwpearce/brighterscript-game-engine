import "../../math/vector.bs"
import "../drawables/DrawableVoxelTerrain.bs"
import "../drawables/Image.bs"
import "../Game.bs"
import "../GameEntity.bs"
import "../quality/RenderQualityLevel.bs"
import "../quality/RenderQualityPresets.bs"
import "../voxel/VoxelMap.bs"
import "../voxel/VoxelMaps.bs"
import "cameras/Camera2d.bs"
import "cameras/Camera3d.bs"
import "Renderer.bs"
import "sceneObjects/SceneObject.bs"
import "sceneObjects/SceneObjectBillboard.bs"
import "sceneObjects/SceneObjectVoxelTerrain.bs"

namespace tests

  ' The eye 50 up at the origin looking down -z, over a 64-cell map of 16-unit cells centred
  ' on it (owner at -512, 0, -512), height scale 4. Map row 13 (world z -304 to -288) is a
  ' wall `wallHeight` high.
  @suite("BGE.Renderer - voxel terrain")
  class RendererVoxelTerrainTests extends rooibos.BaseTestSuite

    private game as BGE.Game
    private renderer as BGE.Renderer
    private camera as BGE.Camera3d
    private terrain as BGE.SceneObjectVoxelTerrain
    private target as roBitmap

    protected override sub beforeEach()
      m.game = new BGE.Game(1280, 720)
      m.camera = new BGE.Camera3d()
      m.camera.fieldOfViewDegrees = 90
      m.camera.maxDrawDistance = 1000
      m.camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.camera.drawDistanceFadeFraction = 0
      m.camera.drawDistanceTransitionSeconds = 0
      m.target = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.target, m.game, m.camera)
    end sub

    private function wallMap(wallHeight as integer) as BGE.VoxelMap
      heights = CreateObject("roArray", 64 * 64, false)
      colors = CreateObject("roArray", 64 * 64, false)
      for z = 0 to 63
        for x = 0 to 63
          heights[z * 64 + x] = 0
          colors[z * 64 + x] = 0
          if z = 13
            heights[z * 64 + x] = wallHeight
            colors[z * 64 + x] = 1
          end if
        end for
      end for
      return BGE.VoxelMaps.fromArrays(64, heights, colors, [&h00FF00, &hFF0000])
    end function

    private function addTerrain(wallHeight as integer) as BGE.SceneObjectVoxelTerrain
      owner = new BGE.GameEntity(m.game, {name: "terrain"})
      owner.position = BGE.Math.VectorOps.create(-512, 0, -512)
      drawable = new BGE.DrawableVoxelTerrain(owner, m.wallMap(wallHeight), {cellSize: 16, heightScale: 4})
      m.terrain = drawable.addToRenderer(m.renderer) as BGE.SceneObjectVoxelTerrain
      return m.terrain
    end function

    ' A billboard `height` units tall standing at (x, y, z)
    private function newBillboard(x as float, y as float, z as float, height = 10 as integer) as BGE.SceneObject
      entity = new BGE.GameEntity(m.game, {name: "billboard"})
      entity.position = BGE.Math.VectorOps.create(x, y, z)
      entity.updateTransformationMatrix()
      bitmap = CreateObject("roBitmap", {width: 10, height: height, alphaEnable: true})
      bitmap.Clear(&hFF0000FF)
      region = CreateObject("roRegion", bitmap, 0, 0, 10, height)
      drawable = new BGE.Image(entity, region, {drawMode: BGE.SceneObjectDrawMode.axisAligned})
      drawable.setAnchor(0.5, 1)
      return drawable.addToRenderer(m.renderer)
    end function

    private sub renderFrames(count = 2 as integer)
      for i = 1 to count
        m.renderer.setupCameraForFrame()
        m.renderer.render()
      end for
    end sub

    @describe("drawing")

    @it("draws spans and becomes the active terrain")
    function _()
      m.addTerrain(10)
      m.renderFrames()
      m.assertTrue(m.terrain.didDrawLastFrame())
      m.assertTrue(m.terrain.view.spanCount > 0)
      m.assertEqual(80, m.terrain.view.columns)
      active = m.renderer.getVoxelTerrain()
      m.assertNotInvalid(active)
      m.assertEqual(m.terrain.id, active.id)
    end function

    @it("draws nothing with a Camera2d")
    function _()
      m.renderer = new BGE.Renderer(m.target, m.game, new BGE.Camera2d())
      m.addTerrain(10)
      m.renderFrames()
      m.assertFalse(m.terrain.didDrawLastFrame())
      m.assertInvalid(m.renderer.getVoxelTerrain())
    end function

    @it("draws only the first of two terrains")
    function _()
      first = m.addTerrain(10)
      second = m.addTerrain(10)
      m.renderFrames()
      m.assertEqual(first.id, m.renderer.getVoxelTerrain().id)
      m.assertFalse(second.didDrawLastFrame())
    end function

    @it("puts a pillar where the camera projects it")
    function _()
      m.addTerrain(0)
      ' a single tall cell, right of the middle: map (40, 13) is world x 128 to 144, z -304
      m.terrain.drawable.map.heightLevels[0][13 * 64 + 40] = 255
      m.terrain.drawable.setMap(m.terrain.drawable.map)
      m.renderFrames()
      expected = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(136, 0, -296))
      column = int(expected.x / m.terrain.view.columnWidth)
      record = m.terrain.view.columnSpans[column]
      m.assertEqual(&hFF0000FF, record[record.count() - 2])
      m.assertEqual(&h00FF00FF, m.terrain.view.columnSpans[20][2])
    end function

    @describe("reusing the march")

    @it("draws the same spans again without marching while nothing changes")
    function _()
      m.addTerrain(10)
      m.renderFrames(1)
      m.assertTrue(m.terrain.marchedLastFrame)
      m.renderFrames(1)
      m.assertFalse(m.terrain.marchedLastFrame)
      m.assertTrue(m.terrain.didDrawLastFrame())
    end function

    @it("marches again when the camera moves")
    function _()
      m.addTerrain(10)
      m.renderFrames()
      m.camera.position.x = 5
      m.renderFrames(1)
      m.assertTrue(m.terrain.marchedLastFrame)
    end function

    @it("marches again with the quality's columns")
    function _()
      m.addTerrain(10)
      m.renderFrames()
      m.renderer.setQualitySettings(BGE.getRenderQualityPreset(BGE.RenderQualityLevel.basic))
      m.renderFrames(1)
      m.assertTrue(m.terrain.marchedLastFrame)
      m.assertEqual(50, m.terrain.view.columns)
    end function

    @it("blends towards the camera's fog colour across its fade band")
    function _()
      m.addTerrain(0)
      m.camera.fog.enabled = true
      m.camera.fog.color = &hFFFFFF
      m.camera.drawDistanceFadeFraction = 0.5
      m.renderFrames()
      m.assertEqual(0.5, m.terrain.view.fogStart)
      record = m.terrain.view.columnSpans[40]
      m.assertTrue(record.count() > 4)
      m.assertEqual(&hFFFFFFFF, record[record.count() - 2])
      m.camera.drawDistanceFadeFraction = 0.2
      m.renderFrames()
      m.assertTrue(abs(m.terrain.view.fogStart - 0.8) < 0.0001)
    end function

    @describe("objects behind hills")

    @it("skips an object wholly behind a hill, as occluded")
    function _()
      m.addTerrain(50)
      billboard = m.newBillboard(0, 0, -500)
      m.renderFrames()
      m.assertFalse(billboard.didDrawLastFrame())
      m.assertEqual(1, m.renderer.getOccludedCountLastFrame())
    end function

    @it("only tests objects draw() won't cull against the hills (issue #658)")
    function _()
      m.addTerrain(50)
      ' in front, but well off the side of the 90 degree view
      aside = m.newBillboard(600, 0, -200)
      ahead = m.newBillboard(0, 0, -200)
      m.renderFrames()
      m.assertFalse(aside.mayDrawThisFrame(m.renderer))
      m.assertTrue(ahead.mayDrawThisFrame(m.renderer))
      m.assertFalse(aside.didDrawLastFrame())
      m.assertTrue(ahead.didDrawLastFrame())
      m.assertEqual(0, m.renderer.getOccludedCountLastFrame())
    end function

    @it("hides an object behind a hill on the first frame it turns into view")
    function _()
      m.addTerrain(50)
      billboard = m.newBillboard(0, 0, -500)
      ' looking off to the side, it's culled
      m.camera.orientation = BGE.Math.VectorOps.getNormalizedCopy(BGE.Math.VectorOps.create(1, 0, -0.3))
      m.renderFrames()
      m.assertFalse(billboard.mayDrawThisFrame(m.renderer))
      m.camera.orientation = BGE.Math.VectorOps.create(0, 0, -1)
      m.renderFrames(1)
      m.assertFalse(billboard.didDrawLastFrame())
      m.assertEqual(1, m.renderer.getOccludedCountLastFrame())
    end function

    @it("draws an object in front of the hill with nothing over it")
    function _()
      m.addTerrain(50)
      billboard = m.newBillboard(0, 0, -200)
      m.renderFrames()
      m.assertTrue(billboard.didDrawLastFrame())
      m.assertEqual(0, m.terrain.redrawsLastFrame)
    end function

    @it("draws an object showing over the hill, then the hill over its foot")
    function _()
      m.addTerrain(10)
      ' the hill's top (40) is 10 under the eye; the billboard stands behind it, 30 tall
      billboard = m.newBillboard(0, 20, -500, 30)
      m.renderFrames()
      m.assertTrue(billboard.didDrawLastFrame())
      m.assertTrue(m.terrain.redrawsLastFrame > 0)
    end function

    @it("only partly hides an object whose nearest point is in front of the hill")
    function _()
      m.addTerrain(50)
      m.renderFrames()
      ' the wall row is ~290 away and fills the middle columns to the top: these points are
      ' behind it in the middle of the screen
      points = [640.0, 400.0, 10.0, 660.0, 380.0, 10.0] as float[]
      m.assertEqual(BGE.VoxelHidden.all, m.terrain.testHidden(points, 450, 480, {} as BGE.VoxelHideBox))
      ' its middle is behind the hill, but its near face is in front of it
      m.assertEqual(BGE.VoxelHidden.partly, m.terrain.testHidden(points, 200, 480, {} as BGE.VoxelHideBox))
    end function

    @it("only partly hides an object reaching behind the camera")
    function _()
      m.addTerrain(50)
      m.renderFrames()
      points = [640.0, 400.0, 10.0, 660.0, 380.0, 10.0, 0.0, 0.0, BGE.PROJECTED_BEHIND_CAMERA_DEPTH] as float[]
      m.assertEqual(BGE.VoxelHidden.partly, m.terrain.testHidden(points, 450, 480, {} as BGE.VoxelHideBox))
    end function

    @it("leaves an object off the side of the view visible")
    function _()
      m.addTerrain(50)
      m.renderFrames()
      points = [-500.0, 400.0, 10.0, -450.0, 380.0, 10.0] as float[]
      m.assertEqual(BGE.VoxelHidden.visible, m.terrain.testHidden(points, 450, 480, {} as BGE.VoxelHideBox))
    end function

    @it("keeps marching the copy of a wrapping map the camera is over")
    function _()
      m.addTerrain(10)
      m.renderFrames()
      near = m.terrain.view.spanCount
      ' 1000 maps over: the same view, so nothing to march again
      m.camera.position.x += 1024 * 1000
      m.renderFrames(1)
      m.assertFalse(m.terrain.marchedLastFrame)
      m.assertTrue(m.terrain.didDrawLastFrame())
      m.assertEqual(near, m.terrain.view.spanCount)
    end function

    @it("boxes a camera-facing billboard exactly as its projected corners do")
    function _()
      m.addTerrain(10)
      for each mode in [BGE.SceneObjectDrawMode.directScaled, BGE.SceneObjectDrawMode.axisAligned]
        for each roll in [0.0, 25.0]
          m.camera.rollDegrees = roll
          sprite = m.newSprite(m.renderer, 40, 0, -400, mode)
          m.renderFrames()
          fast = [] as float[]
          depthPoints = [] as BGE.Math.Vector[]
          m.assertTrue(sprite.projectOcclusionCorners(m.camera, fast, depthPoints), `fast path, mode ${mode} roll ${roll}`)
          slow = [] as float[]
          m.camera.projectPointsWithDepth(sprite.getOcclusionTestPoints(m.camera), slow)
          m.assertEqual(slow, fast, `mode ${mode} roll ${roll}`)
          m.assertEqual(4, depthPoints.count())
          m.renderer.removeSceneObject(sprite)
        end for
      end for
      ' an oriented one takes the corner path
      entity = new BGE.GameEntity(m.game, {name: "card"})
      entity.position = BGE.Math.VectorOps.create(0, 0, -400)
      entity.updateTransformationMatrix()
      region = CreateObject("roRegion", CreateObject("roBitmap", {width: 10, height: 10, alphaEnable: true}), 0, 0, 10, 10)
      card = (new BGE.Image(entity, region, {drawMode: BGE.SceneObjectDrawMode.orientedDrawBackFace})).addToRenderer(m.renderer)
      m.renderFrames()
      m.assertFalse(card.projectOcclusionCorners(m.camera, [] as float[], [] as BGE.Math.Vector[]))
    end function

    @it("draws a billboard the hills were tested against exactly where it draws without them (issue #678)")
    function _()
      m.addTerrain(0)
      ' the same scene with no terrain, so nothing projects the quad ahead of draw()
      plainCamera = new BGE.Camera3d()
      plainCamera.fieldOfViewDegrees = 90
      plainCamera.maxDrawDistance = 1000
      plainCamera.drawDistanceFadeFraction = 0
      plainCamera.drawDistanceTransitionSeconds = 0
      plain = new BGE.Renderer(CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true}), m.game, plainCamera)
      ' a new pose each frame, so a box left from the frame before would be wrong
      poses = [
        {x: 0, y: 50, z: 0, ox: 0, oy: 0, oz: -1, roll: 0, shear: false},
        {x: 10, y: 80, z: -20, ox: 0.1, oy: -0.2, oz: -1, roll: 0, shear: false},
        {x: -30, y: 60, z: 10, ox: 0.2, oy: 0.15, oz: -1, roll: 20, shear: false},
        {x: 25, y: 120, z: -50, ox: -0.1, oy: -0.4, oz: -1, roll: -35, shear: false},
        {x: 5, y: 70, z: -5, ox: 0.05, oy: -0.3, oz: -1, roll: 50, shear: true},
        {x: 60, y: 40, z: 30, ox: -0.25, oy: 0.05, oz: -1, roll: 0, shear: true}
      ]
      for each mode in [BGE.SceneObjectDrawMode.directScaled, BGE.SceneObjectDrawMode.axisAligned]
        tested = m.newSprite(m.renderer, 40, 30, -400, mode)
        untested = m.newSprite(plain, 40, 30, -400, mode)
        for each pose in poses
          for each cam in [m.camera, plainCamera]
            cam.position = BGE.Math.VectorOps.create(pose.x, pose.y, pose.z)
            cam.orientation = BGE.Math.VectorOps.getNormalizedCopy(BGE.Math.VectorOps.create(pose.ox, pose.oy, pose.oz))
            cam.rollDegrees = pose.roll
            cam.pitchMode = BGE.CameraPitchMode.rotate
            if pose.shear
              cam.pitchMode = BGE.CameraPitchMode.shear
            end if
          end for
          m.renderFrames(1)
          plain.setupCameraForFrame()
          plain.render()
          label = `mode ${mode} at (${pose.x}, ${pose.y}, ${pose.z}) roll ${pose.roll}`
          m.assertTrue(tested.didDrawLastFrame(), label)
          m.assertTrue(untested.didDrawLastFrame(), label)
          ' draw() kept the corners the hide test left in the renderer's scratch
          testedPoints = (m.renderer as dynamic).terrainDepthPoints
          m.assertEqual(4, testedPoints.count(), label)
          testedPoints[0].markedByTest = true
          m.assertEqual(true, (tested as dynamic).cameraFacingCorners[0].markedByTest, label)
          m.assertEqual(m.cornersOf(untested), m.cornersOf(tested), label)
        end for
        m.renderer.removeSceneObject(tested)
        plain.removeSceneObject(untested)
      end for
    end function

    @it("doesn't reuse a box the hide test projected once the camera moves (issue #678)")
    function _()
      m.addTerrain(0)
      sprite = m.newSprite(m.renderer, 40, 30, -400, BGE.SceneObjectDrawMode.directScaled)
      m.renderFrames()
      before = m.cornersOf(sprite)
      m.camera.position.x = -40
      m.camera.rollDegrees = 15
      m.renderFrames(1)
      after = m.cornersOf(sprite)
      m.assertNotEqual(before[0], after[0])
      ' as draw() projects it with nothing shared
      expected = [] as float[]
      m.camera.projectPointsWithDepth(sprite.getOcclusionTestPoints(m.camera), expected)
      m.assertEqual([expected[0], expected[1], expected[3], expected[4], expected[6], expected[7], expected[9], expected[10]], after)
    end function

    ' A 10 x 30 camera-facing sprite anchored at its feet, at (x, y, z)
    private function newSprite(rendererObj as BGE.Renderer, x as float, y as float, z as float, mode as BGE.SceneObjectDrawMode) as BGE.SceneObject
      entity = new BGE.GameEntity(m.game, {name: "sprite"})
      entity.position = BGE.Math.VectorOps.create(x, y, z)
      entity.updateTransformationMatrix()
      bitmap = CreateObject("roBitmap", {width: 10, height: 30, alphaEnable: true})
      bitmap.Clear(&hFF0000FF)
      region = CreateObject("roRegion", bitmap, 0, 0, 10, 30)
      drawable = new BGE.Image(entity, region, {drawMode: mode})
      drawable.setAnchor(0.5, 1)
      return drawable.addToRenderer(rendererObj)
    end function

    ' A billboard's canvas corners: x, y of top left, top right, bottom left, bottom right
    private function cornersOf(sceneObj as BGE.SceneObject) as float[]
      quad = (sceneObj as BGE.SceneObjectBillboard).getCanvasPoints()
      return [quad.topLeft.x, quad.topLeft.y, quad.topRight.x, quad.topRight.y, quad.bottomLeft.x, quad.bottomLeft.y, quad.bottomRight.x, quad.bottomRight.y]
    end function

    @describe("roll")

    @it("marches a level view as wide as the diagonal and maps target points into it")
    function _()
      m.addTerrain(10)
      point = BGE.Math.VectorOps.create(100, 20, -400)
      level = m.camera.worldPointToCanvasPoint(point)
      m.camera.rollDegrees = 30
      m.renderFrames()
      m.assertTrue(m.terrain.rolledLastFrame)
      ' sqrt(1280^2 + 720^2) = 1468.6, plus 2, with columns as wide as unrolled: 80 x 1470 / 1280
      m.assertEqual(92, m.terrain.view.columns)
      m.assertEqual(1470 / 92, m.terrain.view.columnWidth)
      onTarget = m.camera.worldPointToCanvasPoint(point)
      mapped = m.terrain.levelPointOf(onTarget.x, onTarget.y)
      ' the level view's frame-sized middle is the unrolled view
      m.assertTrue(abs(mapped.x - (level.x + 95)) < 2, `x ${mapped.x} vs ${level.x + 95}`)
      m.assertTrue(abs(mapped.y - (level.y + 375)) < 2, `y ${mapped.y} vs ${level.y + 375}`)
    end function

    @it("still hides an object behind a hill when rolled")
    function _()
      m.addTerrain(50)
      billboard = m.newBillboard(0, 0, -500)
      m.camera.rollDegrees = 30
      m.renderFrames()
      m.assertFalse(billboard.didDrawLastFrame())
    end function

    @it("redraws hill spans over an object when rolled")
    function _()
      m.addTerrain(10)
      billboard = m.newBillboard(0, 20, -500, 30)
      m.camera.rollDegrees = 20
      m.renderFrames()
      m.assertTrue(billboard.didDrawLastFrame())
      m.assertTrue(m.terrain.redrawsLastFrame > 0)
    end function

    @describe("shear pitch camera")

    @it("puts a hill's top where a shear camera projects it")
    function _()
      m.addTerrain(10)
      m.camera.pitchMode = BGE.CameraPitchMode.shear
      pitch = BGE.Math.DegreesToRadians(-20)
      m.camera.orientation = BGE.Math.VectorOps.create(0, sin(pitch), -cos(pitch))
      m.renderFrames()
      ' the wall row's top (40) between its near (z -288) and far (z -304) faces
      nearTop = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(0, 40, -288)).y
      farTop = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(0, 40, -304)).y
      record = m.terrain.view.columnSpans[40]
      wallTop = -1
      for r = 0 to record.count() - 1 step 4
        if record[r + 2] = &hFF0000FF
          wallTop = record[r]
        end if
      end for
      m.assertTrue(wallTop >= farTop - 2 and wallTop <= nearTop + 2, `wall top ${wallTop}, expected ${farTop}-${nearTop}`)
    end function

    @it("turns a shear camera's level view about its moved image centre")
    function _()
      m.addTerrain(10)
      m.camera.pitchMode = BGE.CameraPitchMode.shear
      pitch = BGE.Math.DegreesToRadians(-20)
      m.camera.orientation = BGE.Math.VectorOps.create(0, sin(pitch), -cos(pitch))
      m.renderFrames()
      point = BGE.Math.VectorOps.create(100, 20, -400)
      unrolled = m.camera.worldPointToCanvasPoint(point)
      shift = m.camera.getPitchShiftY()
      m.camera.rollDegrees = 30
      m.renderFrames()
      onTarget = m.camera.worldPointToCanvasPoint(point)
      mapped = m.terrain.levelPointOf(onTarget.x, onTarget.y)
      size = m.terrain.view.columnWidth * m.terrain.view.columns
      cropX = (size - 1280) / 2
      cropY = (size - 720) / 2 - shift
      m.assertTrue(abs(mapped.x - (unrolled.x + cropX)) < 2, `x ${mapped.x} vs ${unrolled.x + cropX}`)
      m.assertTrue(abs(mapped.y - (unrolled.y + cropY)) < 2, `y ${mapped.y} vs ${unrolled.y + cropY}`)
    end function

    @describe("DrawableVoxelTerrain.heightAt")

    @it("gives world heights from an offset owner")
    function _()
      m.addTerrain(10)
      d = m.terrain.drawable
      d.owner.position.y = 100
      ' row 13's centre is world z -512 + 13.5 * 16; the wall is 10 * 4 high
      m.assertEqual(140.0, d.heightAt(0, -296))
      m.assertEqual(100.0, d.heightAt(0, -100))
      ' halfway between row 12's centre and row 13's
      m.assertEqual(120.0, d.heightAt(0, -304))
    end function

  end class

end namespace
