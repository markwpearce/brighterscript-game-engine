import "../../../math/vector.bs"
import "../../../utils/colors.bs"

namespace BGE

  enum LightType
    ' Lights every surface equally, whichever way it faces
    ambient = "ambient"
    ' Shines from infinitely far away in one direction, like the sun
    directional = "directional"
    ' Shines outward in every direction from one position, like a lamp
    point = "point"
  end enum

  ' A light that shades `isShaded` drawables. Add it to a renderer with
  ' `Game.addLight()` (or `Renderer.addLight()`).
  '
  ' Fields can be changed at any time, including mid-game - the renderer notices and
  ' redraws whatever the light touches. Use `DirectionalLight`, `PointLight` or
  ' `AmbientLight` rather than this class directly.
  class Light

    ' Set by the renderer when the light is added
    id as string = ""

    type as LightType = BGE.LightType.ambient

    ' RGB color (0xRRGGBB, as `BGE.ColorsRGB`)
    color as integer = BGE.ColorsRGB.White

    ' Multiplier on `color`. A surface's total light is capped at full brightness, so
    ' values above 1 brighten dim (glancing) surfaces rather than overexposing lit ones.
    intensity as float = 1.0

    ' A disabled light is ignored, as if it had been removed
    enabled as boolean = true

    sub new(lightType as LightType, color as integer, intensity as float)
      m.type = lightType
      m.color = color
      m.intensity = intensity
    end sub

  end class

  ' A light shining in one direction from infinitely far away. Every surface facing
  ' against `direction` is lit equally, however far away it is.
  class DirectionalLight extends Light

    ' The direction the light travels in (needn't be normalized). World space has +y up,
    ' so `(0, -1, 0)` shines straight down.
    direction as BGE.Math.Vector = BGE.Math.VectorOps.create(0, -1, 0)

    ' @param {BGE.Math.Vector} direction the direction the light travels in
    ' @param {integer} [color=BGE.ColorsRGB.White] RGB color
    ' @param {float} [intensity=1.0]
    sub new(direction as BGE.Math.Vector, color = BGE.ColorsRGB.White as integer, intensity = 1.0 as float)
      super(BGE.LightType.directional, color, intensity)
      m.direction = direction
    end sub

  end class

  ' A light shining outward from `position`, optionally fading out with distance.
  class PointLight extends Light

    position as BGE.Math.Vector = BGE.Math.VectorOps.create()

    ' How far the light reaches: it fades linearly from full strength at `position` to
    ' nothing at `range`. 0 means it never fades.
    range as float = 0

    ' @param {BGE.Math.Vector} position
    ' @param {float} [range=0] how far the light reaches; 0 for no falloff
    ' @param {integer} [color=BGE.ColorsRGB.White] RGB color
    ' @param {float} [intensity=1.0]
    sub new(position as BGE.Math.Vector, range = 0 as float, color = BGE.ColorsRGB.White as integer, intensity = 1.0 as float)
      super(BGE.LightType.point, color, intensity)
      m.position = position
      m.range = range
    end sub

  end class

  ' Light that reaches every surface equally, whichever way it faces - use it to keep
  ' the unlit sides of objects from going too dark, or to tint a whole scene.
  class AmbientLight extends Light

    ' @param {integer} [color=BGE.ColorsRGB.White] RGB color
    ' @param {float} [intensity=0.25]
    sub new(color = BGE.ColorsRGB.White as integer, intensity = 0.25 as float)
      super(BGE.LightType.ambient, color, intensity)
    end sub

  end class

end namespace
