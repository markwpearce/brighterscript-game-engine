import "../../../math/boundingSphere.bs"
import "../../../math/Matrix44.bs"
import "../../../math/vector.bs"
import "../../../utils/MotionChecker.bs"
import "../../../utils/tweens.bs"
import "../sceneObjects/SceneObject.bs"

namespace BGE

  ' The smallest and largest zoom Camera.getEffectiveZoom() allows
  const CAMERA_MIN_ZOOM = 0.1
  const CAMERA_MAX_ZOOM = 100.0

  ' Longest frame step zoomTo() advances by, so one slow frame can't finish a zoom in a jump.
  const MAX_ZOOM_STEP_SECONDS = 0.1

  class Camera

    ' A vector pointed in the direction of the camera
    orientation = BGE.Math.VectorOps.create(0, 0, -1)

    position as BGE.Math.Vector = BGE.Math.VectorOps.create(0, 0, 1000)

    ' Sort whole objects by how far ahead they are across the ground (groundDistanceAhead()),
    ' ignoring height, like a 2.5D sprite engine. With the camera tilted down, depth along the
    ' view counts a higher point as nearer, so a tall object's centre sorts in front of a
    ' shorter one standing nearer to the camera (a post drawn over the knight beside it).
    ' Only the whole-object draw order changes: culling, occlusion, a model's face order and
    ' Renderer.computeOverlapClusters' per-primitive order still use the view depth.
    sortsByGroundDistance as boolean = false

    motionChecker as MotionChecker = new MotionChecker()

    frameSize as BGE.Math.Vector = BGE.Math.VectorOps.create()

    ' Bumped whenever something about the camera's projection - as opposed to its
    ' position or orientation - changes. MotionChecker watches only position and
    ' orientation, so without this a frame-size or field-of-view change is invisible to
    ' every dirty check in the renderer, and a stationary culled object stays culled
    ' through a projection change that should have brought it back into view.
    projectionVersion as integer = 0

    ' Last frame size seen by checkProjectionChange(). Stored as two scalars rather than a
    ' Vector so it can't alias the live frameSize object and compare equal to itself.
    private lastProjectionFrameWidth as float = -1
    private lastProjectionFrameHeight as float = -1

    ' How much bigger the view is drawn, about its middle: 1 as it comes, 2 twice as big, 0.5
    ' half. A Camera2d scales world-to-canvas, a Camera3d multiplies its focal length (see
    ' Camera3d.getEffectiveFieldOfViewDegrees()). Kept within CAMERA_MIN_ZOOM-CAMERA_MAX_ZOOM
    ' (see getEffectiveZoom()). Write it directly, or ease it with zoomTo().
    zoom as float = 1.0

    private lastProjectionZoom as float = 1.0

    ' zoomTo()'s ease: where it started and is going, how far through it is (seconds)
    private zooming as boolean = false
    private zoomFrom as float = 1.0
    private zoomTarget as float = 1.0
    private zoomSeconds as float = 0.0
    private zoomElapsed as float = 0.0
    ' the easing function itself, looked up once per zoomTo()
    private zoomEase as function = invalid
    ' the zoom advanceZoom() last wrote, so a direct write can cancel the ease
    private zoomWritten as float = 1.0
    private zoomClock as roTimespan = invalid

    ' Multiplier on a 3D camera's maxDrawDistance, set from the renderer's quality
    ' settings every frame - see `BGE.RenderQualitySettings`. Ignored by Camera2d.
    drawDistanceScale as float = 1.0

    ' Absolute draw distance from the renderer's quality settings; 0 or less means
    ' "use drawDistanceScale". Ignored by Camera2d.
    drawDistanceOverride as float = 0.0

    ' How far a 3D camera's ground plane reaches, as a multiple of maxDrawDistance - the
    ' largest draw-distance scale any quality level uses, so the ground always reaches
    ' past every object. Set by the renderer every frame. Ignored by Camera2d.
    planeDrawDistanceScale as float = 1.0

    ' The largest absolute draw distance any quality level uses (0 = none). Set by the
    ' renderer every frame. Ignored by Camera2d.
    planeDrawDistanceOverride as float = 0.0

    ' The session's draw distance scale (`Game.setDrawDistanceScale()`), already part of
    ' drawDistanceScale. Set by the renderer every frame. Ignored by Camera2d.
    sessionDrawDistanceScale as float = 1.0

    worldToCamera as float[][]

    name as string = "AbstractCamera"

    sub new()
    end sub

    sub setFrameSize(width as integer, height as integer)
      m.frameSize.x = width
      m.frameSize.y = height
    end sub

    ' Force a projection change to be reported this frame. Public so a future setter can
    ' declare a change explicitly rather than relying on the dirty check to spot it.
    sub bumpProjectionVersion()
      m.projectionVersion++
    end sub

    ' Detect and act on a projection change. Called once per frame from checkMovement().
    protected sub checkProjectionChange()
      if m.projectionChangedThisFrame()
        m.bumpProjectionVersion()
        m.onProjectionChange()
      end if
    end sub

    ' Whether anything feeding the projection changed since the last frame, recording the
    ' new values as it goes. Override in a subclass to add its own terms - and call
    ' super.projectionChangedThisFrame() unconditionally, never inside a boolean
    ' expression, so its recording side effect always runs.
    '
    ' @return {boolean} true if the projection changed
    protected function projectionChangedThisFrame() as boolean
      zoom = m.getEffectiveZoom()
      if m.lastProjectionFrameWidth = m.frameSize.x and m.lastProjectionFrameHeight = m.frameSize.y and m.lastProjectionZoom = zoom
        return false
      end if
      m.lastProjectionFrameWidth = m.frameSize.x
      m.lastProjectionFrameHeight = m.frameSize.y
      m.lastProjectionZoom = zoom
      return true
    end function

    ' The zoom the camera actually uses: `zoom`, kept within CAMERA_MIN_ZOOM-CAMERA_MAX_ZOOM so
    ' a zero or negative zoom can't divide by zero or mirror the view.
    '
    ' @return {float}
    function getEffectiveZoom() as float
      zoom = m.zoom
      if zoom >= BGE.CAMERA_MIN_ZOOM and zoom <= BGE.CAMERA_MAX_ZOOM
        return zoom * 1.0
      else if zoom > BGE.CAMERA_MAX_ZOOM
        return BGE.CAMERA_MAX_ZOOM
      end if
      ' below the minimum, or not a number
      return BGE.CAMERA_MIN_ZOOM
    end function

    ' Eases `zoom` to `target` over `seconds`, from wherever it is now (a zoom already easing
    ' carries on from where it had got to). Runs on the camera's own clock, so it works with or
    ' without a Game, and keeps going while the game is paused. Writing `zoom` yourself, or
    ' stopZooming(), stops it.
    '
    ' @param {float} target - kept within CAMERA_MIN_ZOOM-CAMERA_MAX_ZOOM
    ' @param {float} [seconds=0.5] - 0 or less zooms at once
    ' @param {BGE.Tweens.Easing} [easing=SinusoidalEaseInOut] - the curve, applied to the zoom's
    '   logarithm so equal steps look like equal changes in size
    sub zoomTo(target as float, seconds = 0.5 as float, easing = BGE.Tweens.Easing.SinusoidalEaseInOut as BGE.Tweens.Easing)
      if target < BGE.CAMERA_MIN_ZOOM
        target = BGE.CAMERA_MIN_ZOOM
      else if target > BGE.CAMERA_MAX_ZOOM
        target = BGE.CAMERA_MAX_ZOOM
      end if
      from = m.getEffectiveZoom()
      if seconds <= 0 or from = target
        m.zooming = false
        m.zoom = target
        return
      end if
      m.zooming = true
      m.zoomFrom = from
      m.zoomTarget = target
      m.zoomSeconds = seconds
      m.zoomElapsed = 0.0
      m.zoomEase = BGE.Tweens.GetTweens()[easing]
      m.zoom = from
      m.zoomWritten = from
      if invalid = m.zoomClock
        m.zoomClock = CreateObject("roTimespan")
      end if
      m.zoomClock.Mark()
    end sub

    ' Whether a zoomTo() is still easing.
    '
    ' @return {boolean}
    function isZooming() as boolean
      return m.zooming
    end function

    ' Stops a zoomTo() where it has got to.
    sub stopZooming()
      m.zooming = false
    end sub

    ' Moves a zoomTo() on by `dt` seconds. Called every frame by checkMovement(); only call it
    ' yourself in tests.
    '
    ' @param {float} dt elapsed seconds (clamped to 0-0.1)
    sub advanceZoom(dt as float)
      if not m.zooming
        return
      end if
      if m.zoom <> m.zoomWritten
        ' written directly since the last step
        m.zooming = false
        return
      end if
      if dt < 0
        dt = 0
      else if dt > BGE.MAX_ZOOM_STEP_SECONDS
        dt = BGE.MAX_ZOOM_STEP_SECONDS
      end if
      m.zoomElapsed += dt
      if m.zoomElapsed >= m.zoomSeconds
        m.zoom = m.zoomTarget
        m.zooming = false
      else
        ease = m.zoomEase
        eased = ease(0.0, 1.0, m.zoomElapsed, m.zoomSeconds)
        m.zoom = m.zoomFrom * Exp(eased * Log(m.zoomTarget / m.zoomFrom))
      end if
      m.zoomWritten = m.zoom
    end sub

    ' Seconds since the last call while a zoomTo() runs (0 otherwise).
    protected function getZoomClockSeconds() as float
      if not m.zooming or invalid = m.zoomClock
        return 0.0
      end if
      seconds = m.zoomClock.TotalMilliseconds() / 1000.0
      m.zoomClock.Mark()
      return seconds
    end function

    ' Rebuild whatever the camera derives from its projection. Renderer only rebuilds the
    ' world-to-camera matrix when the camera moved, and Camera2d's isInView bounds
    ' (top/bottom/left/right) are computed inside that matrix build - so a frame-size
    ' change with a stationary camera would otherwise leave them stale.
    protected sub onProjectionChange()
      m.computeWorldToCameraMatrix()
    end sub

    ' Points the camera at the target position
    ' Override in subclasses to implement different camera behaviors
    '
    ' @param {BGE.Math.Vector} targetPos
    sub setTarget(targetPos as BGE.Math.Vector)
      ' m.orientation = targetPos.subtract(m.position).normalize()
    end sub

    sub useDefaultCameraTarget()
      halfW = m.frameSize.x / 2
      halfH = m.frameSize.y / 2

      m.setTarget(BGE.Math.VectorOps.create(halfW, halfH))
    end sub

    ' Rotate the camera by the given rotation
    ' Override in subclasses to implement different camera behaviors
    '
    ' @param {BGE.Math.Vector} targetPos
    sub rotate(rotation as BGE.Math.Vector)
      'm.orientation = BGE.Math.getRotationMatrix(rotation).multDirMatrix(m.orientation).normalize()
    end sub

    sub checkMovement()
      m.advanceZoom(m.getZoomClockSeconds())
      m.checkProjectionAndMotion()
    end sub

    ' checkMovement() after the zoom has advanced: projection, then position/orientation.
    protected sub checkProjectionAndMotion()
      m.checkProjectionChange()

      currentlyMoved = m.motionChecker.check(m.position, m.orientation)
      if m.movedLastFrame() and not currentlyMoved
        m.motionChecker.resetMovedFlag()
        return
      end if

      if currentlyMoved
        m.onCameraMovement()
        m.motionChecker.setTransform(m.position, m.orientation)
      end if
    end sub

    sub onCameraMovement()
    end sub

    ' Whether the camera's pose differs from the last frame's, ahead of this frame's render
    ' (`movedLastFrame()` is only up to date after it). A 2D camera's follow() moves it
    ' during the render, so that isn't seen here.
    '
    ' @return {boolean}
    function isMovingThisFrame() as boolean
      return m.motionChecker.check(m.position, m.orientation)
    end function

    function movedLastFrame() as boolean
      return m.motionChecker.movedLastFrame
    end function


    function distanceFromCameraFront(point as BGE.Math.Vector) as float
      return point.z
    end function

    ' How far ahead of the camera `point` is across the ground - see sortsByGroundDistance. A
    ' 2D camera has no ground, so it's distanceFromCameraFront().
    '
    ' @param {BGE.Math.Vector} point
    ' @return {float}
    function groundDistanceAhead(point as BGE.Math.Vector) as float
      return m.distanceFromCameraFront(point)
    end function

    ' How visible a point is given the draw-distance fade band, from 1 (fully visible)
    ' to 0 (at or past the draw distance). Only a 3D camera has a draw distance, so
    ' this is always 1 here.
    '
    ' @param {BGE.Math.Vector} point world position
    ' @param {float} [distanceScale=1] - fade as if the draw distance were this many times as far (Drawable.fadeDistanceScale)
    ' @return {float}
    function getDistanceFadeAlpha(point as BGE.Math.Vector, distanceScale = 1.0 as float) as float
      return 1.0
    end function

    ' How many times the draw distance a drawable with this `Drawable.fadeDistanceScale` fades
    ' and culls out to (at least 1). Only a 3D camera has a draw distance, so this is 1 here.
    '
    ' @param {float} distanceScale - Drawable.fadeDistanceScale
    ' @return {float}
    function getFadeReach(distanceScale as float) as float
      return 1.0
    end function

    ' Whether this camera projects world z with perspective (Camera3d), rather than ignoring it.
    '
    ' @return {boolean}
    function isPerspective() as boolean
      return false
    end function

    ' How many canvas pixels one world unit covers at `point`, e.g. to draw something sized in
    ' world units. 1 here: a 2D camera draws a world unit as a pixel.
    '
    ' @param {BGE.Math.Vector} point - world position
    ' @return {float} 0 at or nearer than a perspective camera's near plane
    function pixelsPerWorldUnitAt(point as BGE.Math.Vector) as float
      return 1.0
    end function

    ' Whether occluders (see Drawable.isOccluder) can hide objects with this camera. Only a
    ' Camera3d can: occlusion culling needs every point's depth in front of the camera.
    '
    ' @return {boolean}
    function supportsOcclusionCulling() as boolean
      return false
    end function

    ' Whether objects fade out toward a draw distance with this camera. Always false for
    ' a camera with no draw distance.
    '
    ' @return {boolean}
    function fadesWithDistance() as boolean
      return false
    end function

    ' How visible an object is given the draw-distance fade band, judged by whichever of
    ' its points is nearest. Always 1 for a camera with no draw distance.
    '
    ' @param {BGE.Math.Vector[]} points the object's world-space bounding points
    ' @param {float} [distanceScale=1] - see getDistanceFadeAlpha()
    ' @return {float}
    function getDistanceFadeAlphaForPoints(points as BGE.Math.Vector[], distanceScale = 1.0 as float) as float
      return 1.0
    end function

    ' getDistanceFadeAlphaForPoints() for points known only to lie in a sphere: their alpha
    ' when every point in it would get the same one, else -1.
    '
    ' @param {BGE.Math.BoundingSphere} sphere
    ' @param {float} [distanceScale=1] - see getDistanceFadeAlpha()
    ' @return {float}
    function getDistanceFadeAlphaForSphere(sphere as BGE.Math.BoundingSphere, distanceScale = 1.0 as float) as float
      ' a subclass's own fade is left to its points
      return -1.0
    end function

    ' Whether the draw distance stays at maxDrawDistance whatever the render quality level
    ' (a Camera3d with fog on). Always false for a camera with no draw distance.
    '
    ' @return {boolean}
    function fixesDrawDistance() as boolean
      return false
    end function

    ' Whether the draw distance or its fade band changed this frame, so every object's
    ' fade (and far-clip) needs checking again. Always false for a camera with no draw distance.
    '
    ' @return {boolean}
    function farDistanceChangedThisFrame() as boolean
      return false
    end function

    ' Whether the draw distance is still easing toward a new value. Always false for a
    ' camera with no draw distance.
    '
    ' @return {boolean}
    function isDrawDistanceTransitioning() as boolean
      return false
    end function


    function isInView(point as BGE.Math.Vector) as boolean
      return point.x >= 0 and point.x <= m.frameSize.x and point.y >= 0 and point.y <= m.frameSize.y
    end function

    ' isAnyInView() for points known only to lie in a sphere: 1 if it would say they're in
    ' view whatever they are, 0 if it would say they're not, -1 if it depends (the default).
    '
    ' @param {BGE.Math.BoundingSphere} sphere
    ' @param {float} [farScale=1] - see isAnyInView()
    ' @return {integer}
    function getSphereInViewVerdict(sphere as BGE.Math.BoundingSphere, farScale = 1.0 as float) as integer
      return -1
    end function

    ' Checks whether any part of a shape, given by its world-space corner/bounding points,
    ' could be visible. The default is true when at least one point is in view.
    '
    ' @param {BGE.Math.Vector[]} points
    ' @param {float} [farScale=1] - how many times the draw distance counts as in view (getFadeReach())
    ' @return {boolean}
    function isAnyInView(points as BGE.Math.Vector[], farScale = 1.0 as float) as boolean
      for each point in points
        if m.isInView(point)
          return true
        end if
      end for
      return false
    end function

    sub computeWorldToCameraMatrix()
      m.worldToCamera = BGE.Math.getFloat44Identity()
    end sub

    function getDrawMode() as BGE.SceneObjectDrawMode
      return BGE.SceneObjectDrawMode.directToCamera
    end function

    function worldPointToCanvasPoint(pWorld as BGE.Math.Vector) as BGE.Math.Vector
      return pWorld
    end function


    ' A normalized vector pointing up in the camera's own view. Together with
    ' `getRightVector()` this spans the plane the camera is looking at, which is what a
    ' camera-facing billboard is built in. A camera that can't rotate just uses world up.
    '
    ' @return {BGE.Math.Vector}
    function getUpVector() as BGE.Math.Vector
      return BGE.Math.VectorOps.create(0, 1, 0)
    end function


    ' A normalized vector pointing right in the camera's own view - see `getUpVector()`.
    '
    ' @return {BGE.Math.Vector}
    function getRightVector() as BGE.Math.Vector
      return BGE.Math.VectorOps.create(1, 0, 0)
    end function

  end class


end namespace
