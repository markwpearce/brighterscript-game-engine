import "../../../math/Matrix44.bs"
import "../../../math/vector.bs"
import "Camera.bs"

namespace BGE

  class Camera2d extends Camera


    protected top as float
    protected bottom as float
    protected right as float
    protected left as float

    protected near as float = 1000
    protected far as float = -10000

    name as string = "Camera2d"

    ' World rectangle the view is kept inside - see setBounds()
    private bounds as object = invalid
    ' Entity the camera centres on each frame - see follow()
    private followEntity as object = invalid

    'protected orthoProj as BGE.Math.Matrix44

    ' Centres the camera on a point, then keeps the view inside the bounds set with setBounds(), if any.
    '
    ' @param {BGE.Math.Vector} targetPos
    override sub setTarget(targetPos as BGE.Math.Vector)
      m.position.x = targetPos.x
      m.position.y = targetPos.y
      m.applyBounds()
    end sub

    ' Keeps the view inside a world rectangle (world +y up, so (x, y) is its bottom-left corner),
    ' e.g. a level's extent, so the camera never shows past its edges. On an axis where the
    ' rectangle is smaller than the view, the view is centred on it instead.
    '
    ' @param {float} x - left edge
    ' @param {float} y - bottom edge
    ' @param {float} width
    ' @param {float} height
    sub setBounds(x as float, y as float, width as float, height as float)
      m.bounds = {x: x, y: y, width: width, height: height}
      m.applyBounds()
    end sub

    ' Stops keeping the view inside a rectangle.
    sub clearBounds()
      m.bounds = invalid
    end sub

    ' Centres the camera on an entity's position every frame, just before drawing, so the view
    ' is never a frame behind the entity's movement. Bounds from setBounds() still apply.
    ' Following stops by itself once the entity is destroyed.
    '
    ' @param {GameEntity} entity - the entity to follow, or invalid to stop following
    sub follow(entity as object)
      m.followEntity = entity
      if entity <> invalid
        m.setTarget(entity.position)
      end if
    end sub

    ' Stops following the entity passed to follow().
    sub stopFollowing()
      m.followEntity = invalid
    end sub

    ' Called by the renderer once per frame, after every entity has updated and before
    ' anything is drawn.
    override sub checkMovement()
      if m.followEntity <> invalid
        if m.followEntity.id = invalid
          m.followEntity = invalid
        else
          m.setTarget(m.followEntity.position)
        end if
      end if
      ' Re-applied every frame too, since the frame size can change after setBounds().
      m.applyBounds()
      super.checkMovement()
    end sub

    private sub applyBounds()
      if m.bounds = invalid
        return
      end if
      m.position.x = m.clampAxis(m.position.x, m.frameSize.x, m.bounds.x, m.bounds.width)
      m.position.y = m.clampAxis(m.position.y, m.frameSize.y, m.bounds.y, m.bounds.height)
    end sub

    private function clampAxis(centre as float, viewSize as float, boundsStart as float, boundsSize as float) as float
      if boundsSize <= viewSize
        return boundsStart + boundsSize / 2
      end if
      half = viewSize / 2
      if centre < boundsStart + half
        return boundsStart + half
      else if centre > boundsStart + boundsSize - half
        return boundsStart + boundsSize - half
      end if
      return centre
    end function

    override sub rotate(rotation as BGE.Math.Vector)
      ' 2d Cameras don't rotate
      ' TODO: The probably could rotate in in Z axis. hmmm
    end sub

    override function isInView(point as BGE.Math.Vector) as boolean
      ' add a bit of fudge value here, so things don't disappear when still in screen
      xFudge = m.frameSize.x * 0.2
      yFudge = m.frameSize.y * 0.2

      inViewHorizontally = point.x >= (m.left - xFudge) and point.x <= (m.right + xFudge)
      inViewVertically = point.y >= (m.bottom - yFudge) and point.y <= (m.top + yFudge)

      return inViewHorizontally and inViewVertically
    end function

    override sub computeWorldToCameraMatrix()

      halfW = m.frameSize.x * 0.5
      halfH = m.frameSize.y * 0.5

      m.top = m.position.y + halfH
      m.bottom = m.position.y - halfH
      m.right = m.position.x + halfW
      m.left = m.position.x - halfW
      m.near = m.position.z + 1
      m.far = -10000

      m.worldToCamera = BGE.Math.orthographicMatrix(m.top, m.bottom, m.left, m.right, m.far, m.near)
    end sub


    override function distanceFromCameraFront(point as BGE.Math.Vector) as float
      return m.position.z - point.z
    end function

    override function worldPointToCanvasPoint(pWorld as BGE.Math.Vector) as BGE.Math.Vector
      if invalid = m.worldToCamera
        m.computeWorldToCameraMatrix()
      end if

      pCamera = BGE.Math.Matrix44.multVecMatrix(pWorld, m.worldToCamera)
      if pCamera.z >= 0
        return invalid
      end if

      canvasWidth = m.frameSize.x
      canvasHeight = m.frameSize.y
      pScreen = {x: 0, y: 0}
      pScreen.x = pCamera.x * canvasWidth * 0.5
      pScreen.y = pCamera.y * canvasHeight * 0.5
      pNDC = {x: 0, y: 0}

      pNDC.x = (pScreen.x + canvasWidth * 0.5) '/ canvasWidth
      pNDC.y = (-pScreen.y + canvasHeight * 0.5) '/ canvasHeight
      pRaster = {x: fix(pNDC.x), y: fix(pNDC.y), z: 0}

      return pRaster
    end function


  end class


end namespace
