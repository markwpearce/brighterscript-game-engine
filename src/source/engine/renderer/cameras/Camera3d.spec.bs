namespace tests

  @suite("BGE.Camera3d")
  class Camera3dTests extends rooibos.BaseTestSuite

    camera as BGE.Camera3d
    groundPlane as BGE.Math.Plane

    protected override function beforeEach()
      m.camera = new BGE.Camera3d()
      m.camera.setFrameSize(200, 200)
      m.groundPlane = {
        normal: BGE.Math.VectorOps.create(0, 1, 0),
        point: BGE.Math.VectorOps.create(0, 0, 0)
      }
    end function

    @describe("setTarget")

    @it("points orientation at the target as a normalized direction vector")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 0)
      m.camera.setTarget(BGE.Math.VectorOps.create(10, 0, 0))

      m.assertEqual(1.0, m.camera.orientation.x)
      m.assertEqual(0.0, m.camera.orientation.y)
      m.assertEqual(0.0, m.camera.orientation.z)
    end function

    @describe("toggleWireFrame / getDrawMode")

    @it("defaults to oriented and flips to wireFrame and back")
    function _()
      m.assertEqual(BGE.SceneObjectDrawMode.oriented, m.camera.getDrawMode())

      m.camera.toggleWireFrame()
      m.assertEqual(BGE.SceneObjectDrawMode.wireFrame, m.camera.getDrawMode())

      m.camera.toggleWireFrame()
      m.assertEqual(BGE.SceneObjectDrawMode.oriented, m.camera.getDrawMode())
    end function

    @describe("isInView")

    @it("is true for a point directly in front of the camera")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 0)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, -100))
      m.camera.checkMovement()

      m.assertTrue(m.camera.isInView(BGE.Math.VectorOps.create(0, 0, -50)))
    end function

    @it("is false for a point far outside the field of view to the side")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 0)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, -100))
      m.camera.checkMovement()

      m.assertFalse(m.camera.isInView(BGE.Math.VectorOps.create(10000, 0, -50)))
    end function

    ' Regression for issue #70: CameraFrustumNormals.setNormals built each side's
    ' plane normal from the frustum's boundary *edge direction* instead of a true
    ' inward normal, and swapped which FOV (horizontal/vertical) fed which axis.
    ' The combined effect: isInView's accepted region shrinks as the FOV widens -
    ' backwards - and is only accidentally correct at exactly 90 degrees, which is
    ' why it went unnoticed (every existing test above uses the 90-degree default).
    @describe("isInView field of view relationship")

    @it("accepts an off-axis point at a wide FOV that it rejects at a narrow FOV")
    function _()
      ' Scaled down 10x from the original (1000/1500) so forwardDistance (100) stays well
      ' under maxDrawDistance's device-tiered cap (900 on the simulator/headless test
      ' runner, see Camera3d.getMaxDrawDistanceDeviceCap()) - this test is about the FOV/
      ' frustum-side relationship, not distance, and that relationship is scale-invariant.
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 100)
      m.camera.setFrameSize(200, 200)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, 0))

      offAxisPoint = BGE.Math.VectorOps.create(150, 0, 0)

      m.camera.fieldOfViewDegrees = 160
      m.camera.checkMovement()
      m.assertTrue(m.camera.isInView(offAxisPoint))

      m.camera.fieldOfViewDegrees = 20
      m.camera.checkMovement()
      m.assertFalse(m.camera.isInView(offAxisPoint))
    end function

    @it("uses the vertical FOV (not horizontal) for the top/bottom planes on a non-square frame")
    function _()
      ' A tall, narrow frame: horizontal FOV stays 90, vertical FOV becomes much
      ' narrower (getVerticalFOV scales by frameSize.y / frameSize.x). A point
      ' offset vertically should be rejected by that narrow vertical FOV even
      ' though it would be well inside a 90-degree horizontal FOV.
      ' Scaled down 10x from the original (1000/450) so forwardDistance (100) stays well
      ' under maxDrawDistance's device-tiered cap (900 on the simulator/headless test
      ' runner, see Camera3d.getMaxDrawDistanceDeviceCap()) - this test is about the
      ' vertical-FOV/frustum-side relationship, not distance, and that relationship is
      ' scale-invariant.
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 100)
      m.camera.setFrameSize(400, 50)
      m.camera.fieldOfViewDegrees = 90
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, 0))
      m.camera.checkMovement()

      m.assertFalse(m.camera.isInView(BGE.Math.VectorOps.create(0, 45, 0)))
    end function

    @describe("isInView with maxDrawDistance")

    @it("is true for a point closer than maxDrawDistance")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 0)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, -100))
      m.camera.maxDrawDistance = 500
      m.camera.checkMovement()

      m.assertTrue(m.camera.isInView(BGE.Math.VectorOps.create(0, 0, -50)))
    end function

    @it("is false for a point farther than maxDrawDistance, even directly ahead")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 0)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, -100))
      m.camera.maxDrawDistance = 500
      m.camera.checkMovement()

      m.assertFalse(m.camera.isInView(BGE.Math.VectorOps.create(0, 0, -600)))
    end function

    @describe("maxDrawDistance and the projection version")

    @it("bumps projectionVersion when maxDrawDistance changes")
    function _()
      m.camera.setFrameSize(200, 200)
      m.camera.checkMovement()
      before = m.camera.projectionVersion

      m.camera.maxDrawDistance = 250
      m.camera.checkMovement()

      m.assertTrue(m.camera.projectionVersion > before)
    end function

    @it("holds projectionVersion steady when maxDrawDistance is unchanged")
    function _()
      m.camera.setFrameSize(200, 200)
      m.camera.maxDrawDistance = 250
      m.camera.checkMovement()
      before = m.camera.projectionVersion

      m.camera.checkMovement()

      m.assertEqual(before, m.camera.projectionVersion)
    end function

    @describe("getHorizonLine")

    @it("returns a left/right point pair when looking level at the horizon")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 10, 0)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 10, -100))

      horizon = m.camera.getHorizonLine(m.groundPlane)

      m.assertNotInvalid(horizon)
      m.assertEqual(2, horizon.count())
    end function

    @it("returns invalid for a 'wall' plane whose normal runs along the camera's left/right axis (no horizontal horizon to draw)")
    function _()
      ' Default camera: level, looking down -z. A plane normal of (1,0,0) is a
      ' wall running parallel to the camera's view direction - it would be
      ' seen edge-on, with no meaningful horizontal horizon line.
      sideWallPlane = {
        normal: BGE.Math.VectorOps.create(1, 0, 0),
        point: BGE.Math.VectorOps.create(0, 0, 0)
      }

      horizon = m.camera.getHorizonLine(sideWallPlane)

      m.assertInvalid(horizon)
    end function

    @describe("getFocalLength / getFovDegreesForCanvasSize")

    @it("returns a larger field of view for a larger canvas at the same focal length")
    function _()
      m.camera.setFrameSize(200, 200)
      m.camera.fieldOfViewDegrees = 90

      ' Tolerance (not assertEqual) because this round-trips through tan()/Atan2() -
      ' float precision leaves it a few 1e-5 off 90, not exactly equal. See the same
      ' pattern for the same reason in the "rotates up toward the level right vector"
      ' test above.
      m.assertTrue(abs(m.camera.getFovDegreesForCanvasSize(200) - 90.0) < 0.001)
      m.assertTrue(m.camera.getFovDegreesForCanvasSize(400) > 90)
    end function

    @describe("getLevelHorizonLine")

    @it("matches getHorizonLine when the camera isn't rolled and the canvas matches the frame")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 10, 0)
      m.camera.setFrameSize(200, 200)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 10, -100))
      m.camera.checkMovement()

      real = m.camera.getHorizonLine(m.groundPlane)
      level = m.camera.getLevelHorizonLine(m.groundPlane, 200)

      m.assertEqual(real[0].x, level[0].x)
      m.assertEqual(real[0].y, level[0].y)
    end function

    @it("stays the same for the level horizon regardless of rollDegrees")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 10, 0)
      m.camera.setFrameSize(200, 200)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 10, -100))
      m.camera.checkMovement()

      unrolled = m.camera.getLevelHorizonLine(m.groundPlane, 200)

      m.camera.rollDegrees = 45
      m.camera.checkMovement()
      rolled = m.camera.getLevelHorizonLine(m.groundPlane, 200)

      m.assertEqual(unrolled[0].y, rolled[0].y)
    end function

    @describe("projectionVersion and the frustum")

    ' fieldOfViewDegrees is a plain public field, so no setter can intercept a write to it -
    ' it has to be dirty-checked. And the frustum normals it feeds are otherwise only
    ' recomputed when the *orientation* changes, so a FOV change alone would leave isInView
    ' answering from the old frustum. See issue #48.
    @it("bumps projectionVersion when the field of view changes")
    function _()
      m.camera.setFrameSize(200, 200)
      m.camera.checkMovement()
      before = m.camera.projectionVersion

      m.camera.fieldOfViewDegrees = 45
      m.camera.checkMovement()
      m.assertTrue(m.camera.projectionVersion > before)
    end function

    @it("holds projectionVersion steady when the field of view is unchanged")
    function _()
      m.camera.setFrameSize(200, 200)
      m.camera.checkMovement()
      before = m.camera.projectionVersion

      m.camera.checkMovement()
      m.assertEqual(before, m.camera.projectionVersion)
    end function

    @it("rebuilds the frustum when the field of view changes")
    function _()
      m.camera.setFrameSize(200, 200)
      m.camera.checkMovement()
      before = m.camera.frustumRays.topLeft.direction.x

      m.camera.fieldOfViewDegrees = 45
      m.camera.checkMovement()
      m.assertNotEqual(before, m.camera.frustumRays.topLeft.direction.x)
    end function

    @describe("maxDrawDistance device cap")

    ' The headless brs-cli test runner reports a non-FHD device tier (confirmed: these
    ' tests observe an actual 900 cap, not a no-op), so these tests exercise the real
    ' clamping behavior - though note getMaxDrawDistanceDeviceCap() returns the same 900
    ' for both the simulator and SD/HD real devices, so this doesn't distinguish which of
    ' those two branches specifically fired, only that a non-FHD cap applies.
    @it("does not raise maxDrawDistance when already under the device cap")
    function _()
      m.camera.maxDrawDistance = 500
      m.camera.checkMovement()

      m.assertEqual(500, m.camera.maxDrawDistance)
    end function

    @it("clamps an explicitly-set maxDrawDistance down to the device cap")
    function _()
      m.camera.maxDrawDistance = 5000
      m.camera.checkMovement()

      m.assertEqual(900.0, m.camera.maxDrawDistance)
    end function

    @it("clamps the public default (1000) down to the device cap on the very first frame")
    function _()
      freshCamera = new BGE.Camera3d()
      freshCamera.checkMovement()

      m.assertEqual(900.0, freshCamera.maxDrawDistance)
    end function

    @describe("rollDegrees")

    @it("matches the level up/right vectors when rollDegrees is 0")
    function _()
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, -100))

      m.assertTrue(BGE.Math.VectorOps.equals(m.camera.getLevelUpVector(), m.camera.getUpVector()))
      m.assertTrue(BGE.Math.VectorOps.equals(m.camera.getLevelRightVector(), m.camera.getRightVector()))
    end function

    @it("rotates up toward the level right vector on a 90 degree right bank")
    function _()
      ' Default camera looks down -z with level up (0,1,0) and level right (1,0,0).
      ' A 90 degree right-bank puts "up" where "right" used to point - the pilot's
      ' view out the canopy now faces what used to be the horizontal right.
      m.camera.rollDegrees = 90

      ' Component-wise tolerance (not assertEqual) because these values come out of
      ' cos()/sin() via RotateVectorAroundPoint3d - see math.spec.bs's own tests of
      ' that function, which use the same pattern for the same reason: float
      ' precision leaves a "should be zero" component off by a few 1e-7, not exact.
      up = m.camera.getUpVector()
      m.assertTrue(abs(up.x - 1.0) < 0.0001)
      m.assertTrue(abs(up.y) < 0.0001)
      m.assertTrue(abs(up.z) < 0.0001)
    end function

    @it("rotates right toward straight down on a 90 degree right bank")
    function _()
      m.camera.rollDegrees = 90

      right = m.camera.getRightVector()
      m.assertTrue(abs(right.x) < 0.0001)
      m.assertTrue(abs(right.y - (-1.0)) < 0.0001)
      m.assertTrue(abs(right.z) < 0.0001)
    end function

    @describe("worldPointToCanvasPoint with roll")

    @it("projects a world point to a rotated raster position when the camera is rolled")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 0)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 0, -100))
      m.camera.setFrameSize(200, 200)
      m.camera.checkMovement()

      ' A point straight above the camera's forward axis, level.
      levelResult = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(0, 10, -100))

      m.camera.rollDegrees = 90
      ' Manually invalidate the cached world-to-camera matrix so the next projection
      ' call recomputes it with the new roll applied via getUpVector()
      m.camera.worldToCamera = invalid
      rolledResult = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(0, 10, -100))

      ' A 90 degree roll should move a point that was directly above center to
      ' directly beside center instead - x and y raster offsets from the canvas
      ' center should have swapped (up to which side, given rounding).
      centerX = 100
      centerY = 100
      m.assertEqual(0, levelResult.x - centerX)
      m.assertNotEqual(0, rolledResult.x - centerX)
    end function

    @describe("checkMovement with roll")

    @it("rebuilds the frustum rays when only rollDegrees changes")
    function _()
      m.camera.setFrameSize(200, 200)
      m.camera.checkMovement()
      before = m.camera.frustumRays.topLeft.direction.y

      m.camera.rollDegrees = 45
      m.camera.checkMovement()

      m.assertNotEqual(before, m.camera.frustumRays.topLeft.direction.y)
    end function

    @it("reports movedLastFrame true on a roll-only change")
    function _()
      m.camera.setFrameSize(200, 200)
      m.camera.checkMovement()
      m.camera.movedLastFrame() ' drain the initial true-on-construction state

      m.camera.rollDegrees = 45
      m.camera.checkMovement()

      m.assertTrue(m.camera.movedLastFrame())
    end function

    @it("invalidates the cached world-to-camera matrix on a roll-only change")
    function _()
      m.camera.setFrameSize(200, 200)
      m.camera.checkMovement()
      m.camera.computeWorldToCameraMatrix() ' force it to exist

      m.camera.rollDegrees = 45
      m.camera.checkMovement()

      m.assertInvalid(m.camera.worldToCamera)
    end function

  end class

end namespace
