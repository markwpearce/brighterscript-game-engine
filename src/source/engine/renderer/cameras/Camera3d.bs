import "../../../math/boundingSphere.bs"
import "../../../math/math.bs"
import "../../../math/Matrix44.bs"
import "../../../math/plane.bs"
import "../../../math/vector.bs"
import "../../../utils/deviceRenderTier.bs"
import "../sceneObjects/SceneObject.bs"
import "../Fog.bs"
import "../quadColumns/QuadColumnDrawer.bs"
import "Camera.bs"

namespace BGE


  enum CameraFrustumSide
    top = "top"
    bottom = "bottom"
    left = "left"
    right = "right"
    near = "near"
  end enum

  ' The depth projectPointsWithDepth() gives a point behind the camera when asked to mark
  ' them. Every point in front has a positive depth.
  const PROJECTED_BEHIND_CAMERA_DEPTH = -1


  class CameraFrustumNormals
    top as BGE.Math.Vector
    bottom as BGE.Math.Vector
    left as BGE.Math.Vector
    right as BGE.Math.Vector
    near as BGE.Math.Vector


    ' Builds each frustum side as a true inward-pointing plane normal, not the
    ' boundary edge direction the normal is perpendicular to (see issue #70).
    ' Each normal is the forward vector rotated, about the axis that plane hinges
    ' on, by (halfFOV - 90deg): halfway to the edge and then a further quarter
    ' turn past it, landing perpendicular to that edge and tilted back inward.
    ' top/bottom hinge on cameraRight and use the vertical FOV; left/right hinge
    ' on cameraUp and use the horizontal FOV - swapping either pairing silently
    ' wronged this at any FOV but 90, where the two happen to coincide.
    sub setNormals(cameraOrientation as BGE.Math.Vector, fovDegrees as float, fovDegressVertical as float, cameraUp as BGE.Math.Vector, cameraRight as BGE.Math.Vector)
      'near
      m.near = BGE.Math.VectorOps.copy(cameraOrientation)

      fovRad = BGE.Math.DegreesToRadians(fovDegrees)
      vFovRad = BGE.Math.DegreesToRadians(fovDegressVertical)
      origin = BGE.Math.VectorOps.create()

      m.top = BGE.Math.RotateVectorAroundPoint3d(cameraOrientation, origin, cameraRight, vFovRad / 2 - BGE.Math.HALF_PI)
      m.bottom = BGE.Math.RotateVectorAroundPoint3d(cameraOrientation, origin, cameraRight, BGE.Math.HALF_PI - vFovRad / 2)
      m.left = BGE.Math.RotateVectorAroundPoint3d(cameraOrientation, origin, cameraUp, fovRad / 2 - BGE.Math.HALF_PI)
      m.right = BGE.Math.RotateVectorAroundPoint3d(cameraOrientation, origin, cameraUp, BGE.Math.HALF_PI - fovRad / 2)
    end sub

  end class


  class CameraFrustumRays
    topLeft as BGE.Math.Ray
    topRight as BGE.Math.Ray
    bottomLeft as BGE.Math.Ray
    bottomRight as BGE.Math.Ray

    sub setRays(cameraPosition as BGE.Math.Vector, cameraOrientation as BGE.Math.Vector, fovDegrees as float, fovDegressVertical as float, cameraUp as BGE.Math.Vector, cameraRight as BGE.Math.Vector)
      fovRad = BGE.Math.DegreesToRadians(fovDegrees)
      vFovRad = BGE.Math.DegreesToRadians(fovDegressVertical)
      ' rotVect = BGE.Math.VectorOps.create()

      ' ' rotate on X axis for vertical FOV, Y axis for horizontal FOV
      ' ' rotations are clockwise, so top is rotated by negative number

      ' 'topLeft
      ' rotVect.x = -vFovRad / 2
      ' rotVect.y = -fovRad / 2
      ' topLeftDir = BGE.Math.Matrix44.multVecMatrix(cameraOrientation, BGE.Math.getRotationMatrix(rotVect))
      ' m.topLeft = {origin: cameraPosition, direction: topLeftDir}
      ' 'topRight
      ' rotVect.x = -vFovRad / 2
      ' rotVect.y = fovRad / 2
      ' topRightDir = BGE.Math.Matrix44.multVecMatrix(cameraOrientation, BGE.Math.getRotationMatrix(rotVect))
      ' m.topRight = {origin: cameraPosition, direction: topRightDir}
      ' 'bottomLeft
      ' rotVect.x = vFovRad / 2
      ' rotVect.y = -fovRad / 2
      ' 'bottomLeftDir = BGE.Math.Matrix44.multVecMatrix(cameraOrientation, BGE.Math.getRotationMatrix(rotVect))

      leftEdge = BGE.math.RotateVectorAroundPoint3d(cameraOrientation, {x: 0, y: 0, z: 0}, cameraUp, -fovRad / 2)
      rightEdge = BGE.math.RotateVectorAroundPoint3d(cameraOrientation, {x: 0, y: 0, z: 0}, cameraUp, fovRad / 2)

      topLeft = BGE.math.RotateVectorAroundPoint3d(leftEdge, {x: 0, y: 0, z: 0}, cameraRight, vFovRad / 2)
      topRight = BGE.math.RotateVectorAroundPoint3d(rightEdge, {x: 0, y: 0, z: 0}, cameraRight, vFovRad / 2)

      m.topLeft = {origin: cameraPosition, direction: topRight}
      m.topRight = {origin: cameraPosition, direction: topLeft}

      bottomLeft = BGE.math.RotateVectorAroundPoint3d(leftEdge, {x: 0, y: 0, z: 0}, cameraRight, -vFovRad / 2)
      bottomRight = BGE.math.RotateVectorAroundPoint3d(rightEdge, {x: 0, y: 0, z: 0}, cameraRight, -vFovRad / 2)
      m.bottomLeft = {origin: cameraPosition, direction: bottomLeft}
      m.bottomRight = {origin: cameraPosition, direction: bottomRight}
    end sub
  end class

  ' How a Camera3d shows its pitch (looking up or down).
  enum CameraPitchMode
    ' Turn the view: a true perspective, where vertical lines converge when pitched
    rotate = "rotate"
    ' Keep the view level and move the image down (looking up) or up (looking down) by
    ' focal length x tan(pitch): vertical lines stay vertical. Matches a voxel terrain's
    ' horizon-shift pitch exactly; only reads as looking up or down at modest angles, and
    ' pitch is held to +-60 degrees.
    shear = "shear"
  end enum

  ' tan(60 degrees): the steepest pitch a shear camera shows
  const SHEAR_PITCH_MAX_TAN = 1.7320508

  ' Longest frame step the draw-distance transition advances by, so one slow frame
  ' can't finish a transition in a single jump.
  const MAX_DRAW_DISTANCE_TRANSITION_STEP_SECONDS = 0.1

  class Camera3d extends Camera

    ' The horizontal field of view at zoom 1. The one in use is getEffectiveFieldOfViewDegrees().
    fieldOfViewDegrees as float = 90

    ' Rotation about the camera's own forward/view axis, in degrees. Positive = right
    ' side down (aviation convention). getUpVector()/getRightVector() apply this on
    ' top of the "level" vectors - see getLevelUpVector()/getLevelRightVector().
    rollDegrees as float = 0

    ' `BGE.CameraPitchMode`: how the pitch in `orientation` is shown. With "shear", the view
    ' is level and the image moves down by getPitchShiftY(); getViewForward() is the level
    ' direction projections use, while `orientation` keeps the pitch.
    pitchMode as string = "rotate"

    ' How far (world units) in front of the camera your game wants to draw. The
    ' distance actually used is `getEffectiveMaxDrawDistance()`: this value scaled by
    ' the current render quality level and the session's `Game.setDrawDistanceScale()`, and
    ' capped per device.
    maxDrawDistance as float = 1000

    ' Last field of view seen by projectionChangedThisFrame(). fieldOfViewDegrees is a
    ' plain public field that consumers write directly, so it has to be dirty-checked -
    ' a setter would be silently bypassed.
    private lastProjectionFieldOfView as float = -1

    ' The far end of the draw distance over which objects fade out instead of popping
    ' out of view, as a fraction of it: 0.15 fades across the last 15%. 0 turns fading off.
    drawDistanceFadeFraction as float = 0.15

    ' Distance fog (see BGE.Fog). Off by default.
    fog as BGE.Fog = new BGE.Fog()

    ' Seconds a change in draw distance (a quality level change, or a new
    ' maxDrawDistance) takes to ease in, so distant objects fade in or out gradually
    ' instead of all at once. 0 applies a change immediately.
    drawDistanceTransitionSeconds as float = 0.75

    ' Eased draw distance; -1 until the first frame, which starts at the target.
    private currentDrawDistance as float = -1
    private drawDistanceTransitionTarget as float = -1
    private drawDistanceTransitionSpeed as float = 0
    private lastDrawDistanceFadeFraction as float = -1
    private farDistanceChanged as boolean = false
    private drawDistanceClock as roTimespan = invalid

    ' The most a Drawable.fadeDistanceScale counts for (0: no limit). The Renderer sets it each
    ' frame to how far its level walls walk, as a multiple of the draw distance, so nothing
    ' glows on past where the walls could still hide it.
    fadeDistanceScaleLimit as float = 0

    ' Cached device-specific cap for maxDrawDistance (see getMaxDrawDistanceDeviceCap()).
    ' -1 means "not yet computed."
    private maxDrawDistanceDeviceCap as float = -1

    ' Last rollDegrees seen by checkMovement(). rollDegrees is a plain public field a
    ' consumer writes directly, and MotionChecker's position/orientation check has no
    ' way to represent "rotated about the forward axis" - a roll-only frame needs its
    ' own dirty check or the frustum/view-matrix/plane caches would all go stale. See
    ' issue #53's roll design.
    private lastRollDegrees as float = 0
    ' getLevelUpVector()'s last result, and the orientation it was for
    private levelUpCache as BGE.Math.Vector = invalid
    private levelUpCacheOrientation as BGE.Math.Vector = invalid
    private levelUpCachePitchMode as string = ""
    ' getUpVector()/getRightVector() under roll, and the orientation, roll and pitch mode
    ' they were for: every camera-facing billboard asks, each a rotation
    private rolledUpCache as BGE.Math.Vector = invalid
    private rolledRightCache as BGE.Math.Vector = invalid
    private rolledCacheOrientation as BGE.Math.Vector = invalid
    private rolledCacheRoll as float = 0
    private rolledCachePitchMode as string = ""
    ' getViewForward() under shear, cached by orientation
    private viewForward as BGE.Math.Vector = invalid
    private viewForwardOrientation as BGE.Math.Vector = invalid
    ' the projection terms projectionChangedThisFrame() last saw for pitch
    private lastProjectionPitchMode as string = "rotate"
    ' getPitchShiftY() as of the last computeWorldToCameraMatrix()
    private pitchShiftY as float = 0
    ' a shear frustum's corner directions, rebuilt with its normals
    private shearCorners as roAssociativeArray = invalid
    ' projectPointsWithDepth()'s focal length, and the frame width, FOV and zoom it was for
    private projectionNear as float = 0
    private projectionNearFrameWidth as float = -1
    private projectionNearFieldOfView as float = -1
    private projectionNearZoom as float = -1

    protected frustumNormals as CameraFrustumNormals = new CameraFrustumNormals()

    protected frustrumConvergence as BGE.Math.Vector = BGE.Math.VectorOps.create()
    ' the forward direction levelled onto the ground (unit x and z), unless looking straight
    ' up or down - set with the frustum, for groundDistanceAhead()
    protected hasLevelForward as boolean = true
    protected levelForwardX as float = 0.0
    protected levelForwardZ as float = -1.0

    frustumRays as CameraFrustumRays = new CameraFrustumRays()

    private currentDrawMode = BGE.SceneObjectDrawMode.oriented

    name as string = "Camera3d"

    override sub setTarget(targetPos as BGE.Math.Vector)
      m.orientation = BGE.Math.VectorOps.subtract(targetPos, m.position)
      BGE.Math.VectorOps.normalize(m.orientation)
    end sub


    override sub rotate(rotation as BGE.Math.Vector)
      m.orientation = BGE.Math.Matrix44.multDirMatrix(m.orientation, BGE.Math.getRotationMatrix(rotation))
      BGE.Math.VectorOps.normalize(m.orientation)
    end sub

    override sub checkMovement()
      m.advanceDrawDistance(m.getDrawDistanceClockSeconds())
      rollChanged = m.rollDegrees <> m.lastRollDegrees
      m.lastRollDegrees = m.rollDegrees

      super.checkMovement()

      if rollChanged
        m.recomputeFrustum(true)
        m.worldToCamera = invalid
        m.motionChecker.movedLastFrame = true
      end if
    end sub

    override function isMovingThisFrame() as boolean
      return m.rollDegrees <> m.lastRollDegrees or super.isMovingThisFrame()
    end function

    override sub onCameraMovement()
      ' The normals depend only on orientation and FOV, so movement alone doesn't dirty them
      rotated = BGE.Math.VectorOps.norm(m.motionChecker.getRotationDifference(m.orientation)) > 0
      m.recomputeFrustum(rotated)
    end sub

    ' Rebuild the frustum from the camera's current position, orientation and field of view.
    '
    ' @param {boolean} recomputeNormals whether the frustum plane normals need rebuilding too
    protected sub recomputeFrustum(recomputeNormals as boolean)
      fov = m.getEffectiveFieldOfViewDegrees()
      vertFov = m.getVerticalFOV()
      if m.pitchMode = CameraPitchMode.shear
        m.recomputeShearFrustum(recomputeNormals)
        return
      end if

      if recomputeNormals
        ' The real vertical FOV: the side planes meet at the camera, so the fov * aspect
        ' approximation would cut off objects at the top and bottom of the view
        m.frustumNormals.setNormals(m.orientation, fov, m.getTrueVerticalFOV(), m.getUpVector(), m.getRightVector())
      end if

      m.frustumRays.setRays(m.position, m.orientation, fov, vertFov, m.getUpVector(), m.getRightVector())

      ' A point behind the camera: the near plane passes through it, and isAnyInView() gives a
      ' lone anchor point (no real extent) side planes that meet here, as a margin
      fovRad = BGE.Math.DegreesToRadians(fov)
      halfFrameSize = BGE.Math.max(m.frameSize.x, m.frameSize.y) / 2
      m.frustrumConvergence = BGE.Math.VectorOps.subtract(m.position, BGE.Math.VectorOps.scale(m.orientation, halfFrameSize * cos(fovRad / 2)))

      ' the forward direction levelled onto the ground, for groundDistanceAhead()
      levelX = m.orientation.x
      levelZ = m.orientation.z ?? 0
      levelLength = Sqr(levelX * levelX + levelZ * levelZ)
      m.hasLevelForward = levelLength >= 0.001
      if m.hasLevelForward
        m.levelForwardX = levelX / levelLength
        m.levelForwardZ = levelZ / levelLength
      end if
    end sub


    ' The frustum of a shear camera: a level view whose top and bottom edges are moved by the
    ' pitch shift, so they aren't symmetric about the view direction. Each side plane is built
    ' from the rays through the frame's corners.
    private sub recomputeShearFrustum(recomputeNormals as boolean)
      f = m.getViewForward()
      if recomputeNormals or invalid = m.shearCorners
        up = m.getUpVector()
        right = m.getRightVector()
        focal = m.getProjectionNear()
        halfWidth = m.frameSize.x / 2 / focal
        principalY = m.frameSize.y / 2 + m.getPitchShiftY()
        topUp = principalY / focal
        bottomUp = (principalY - m.frameSize.y) / focal
        corners = {
          topLeft: m.shearCornerRay(f, right, up, -halfWidth, topUp),
          topRight: m.shearCornerRay(f, right, up, halfWidth, topUp),
          bottomLeft: m.shearCornerRay(f, right, up, -halfWidth, bottomUp),
          bottomRight: m.shearCornerRay(f, right, up, halfWidth, bottomUp)
        }
        m.shearCorners = corners
        ' the ray through the frame's middle, which is inside every side
        middle = m.shearCornerRay(f, right, up, 0, m.getPitchShiftY() / focal)
        normals = m.frustumNormals
        normals.near = BGE.Math.VectorOps.copy(f)
        normals.top = m.insideNormal(corners.topLeft, corners.topRight, middle)
        normals.bottom = m.insideNormal(corners.bottomLeft, corners.bottomRight, middle)
        normals.left = m.insideNormal(corners.topLeft, corners.bottomLeft, middle)
        normals.right = m.insideNormal(corners.topRight, corners.bottomRight, middle)
      end if
      corners = m.shearCorners
      rays = m.frustumRays
      rays.topLeft = {origin: m.position, direction: corners.topLeft}
      rays.topRight = {origin: m.position, direction: corners.topRight}
      rays.bottomLeft = {origin: m.position, direction: corners.bottomLeft}
      rays.bottomRight = {origin: m.position, direction: corners.bottomRight}

      fovRad = BGE.Math.DegreesToRadians(m.getEffectiveFieldOfViewDegrees())
      halfFrameSize = BGE.Math.max(m.frameSize.x, m.frameSize.y) / 2
      m.frustrumConvergence = BGE.Math.VectorOps.subtract(m.position, BGE.Math.VectorOps.scale(f, halfFrameSize * cos(fovRad / 2)))
      m.hasLevelForward = f.y = 0
      if m.hasLevelForward
        m.levelForwardX = f.x
        m.levelForwardZ = f.z ?? 0
      end if
    end sub

    ' The unit direction forward + right * x + up * y
    private function shearCornerRay(f as BGE.Math.Vector, right as BGE.Math.Vector, up as BGE.Math.Vector, x as float, y as float) as BGE.Math.Vector
      ray = BGE.Math.VectorOps.create(f.x + right.x * x + up.x * y, f.y + right.y * x + up.y * y, (f.z ?? 0) + (right.z ?? 0) * x + (up.z ?? 0) * y)
      BGE.Math.VectorOps.normalize(ray)
      return ray
    end function

    ' The unit normal of the plane through the eye containing directions a and b, facing inside
    private function insideNormal(a as BGE.Math.Vector, b as BGE.Math.Vector, inside as BGE.Math.Vector) as BGE.Math.Vector
      n = BGE.Math.VectorOps.crossProduct(a, b)
      if BGE.Math.VectorOps.dotProduct(n, inside) < 0
        n = BGE.Math.VectorOps.negative(n)
      end if
      BGE.Math.VectorOps.normalize(n)
      return n
    end function

    ' The direction projections look along: `orientation`, or with pitchMode "shear" its level
    ' part (the pitch is shown by getPitchShiftY() instead). Don't change the vector returned.
    '
    ' @return {BGE.Math.Vector}
    function getViewForward() as BGE.Math.Vector
      o = m.orientation
      if m.pitchMode <> CameraPitchMode.shear
        return o
      end if
      cachedFrom = m.viewForwardOrientation
      if invalid <> cachedFrom and o.x = cachedFrom.x and o.y = cachedFrom.y and o.z = cachedFrom.z
        return m.viewForward
      end if
      m.viewForwardOrientation = BGE.Math.VectorOps.copy(o)
      lenXZ = Sqr(o.x * o.x + (o.z ?? 0) * (o.z ?? 0))
      if lenXZ < 0.0001
        ' straight up or down: no level direction, so no shear
        m.viewForward = BGE.Math.VectorOps.copy(o)
      else
        m.viewForward = BGE.Math.VectorOps.create(o.x / lenXZ, 0, (o.z ?? 0) / lenXZ)
      end if
      return m.viewForward
    end function

    ' How far down (pixels) a shear camera moves the image for its pitch: focal length x
    ' tan(pitch), looking up positive, held to +-60 degrees. 0 with pitchMode "rotate".
    '
    ' @return {float}
    function getPitchShiftY() as float
      if m.pitchMode <> CameraPitchMode.shear
        return 0.0
      end if
      o = m.orientation
      lenXZ = Sqr(o.x * o.x + (o.z ?? 0) * (o.z ?? 0))
      if lenXZ < 0.0001
        return 0.0
      end if
      t = o.y / lenXZ
      if t > BGE.SHEAR_PITCH_MAX_TAN
        t = BGE.SHEAR_PITCH_MAX_TAN
      else if t < -BGE.SHEAR_PITCH_MAX_TAN
        t = -BGE.SHEAR_PITCH_MAX_TAN
      end if
      return m.getProjectionNear() * t
    end function

    ' The side of the square a roll composite must have (drawn level, then turned about the
    ' image centre onto the frame) to cover the frame at any roll: the frame's diagonal, or under
    ' shear twice the distance from the moved image centre to the farthest corner.
    '
    ' @return {float}
    function getRollViewSize() as float
      shift = m.getPitchShiftY()
      halfWidth = m.frameSize.x / 2
      halfHeight = m.frameSize.y / 2 + Abs(shift)
      if shift = 0
        return Int(Sqr(m.frameSize.x * m.frameSize.x + m.frameSize.y * m.frameSize.y)) + 2
      end if
      return Int(2 * Sqr(halfWidth * halfWidth + halfHeight * halfHeight)) + 2
    end function

    ' The canvas row the view direction passes through: the frame's middle, moved by
    ' getPitchShiftY() under shear.
    '
    ' @return {float}
    function getPrincipalY() as float
      return m.frameSize.y / 2 + m.getPitchShiftY()
    end function

    override function distanceFromCameraFront(point as BGE.Math.Vector) as float
      ' distanceFromFrustumSide("near", point), inlined - it runs for every moving object
      conv = m.frustrumConvergence
      nearN = m.frustumNormals.near
      return (point.x - conv.x) * nearN.x + (point.y - conv.y) * nearN.y + ((point.z ?? 0) - (conv.z ?? 0)) * (nearN.z ?? 0)
    end function


    ' Along the camera's forward direction levelled onto the ground (y up). Looking straight
    ' up or down there's no level forward, so it's distanceFromCameraFront().
    override function groundDistanceAhead(point as BGE.Math.Vector) as float
      if not m.hasLevelForward
        return m.distanceFromCameraFront(point)
      end if
      eye = m.position
      return (point.x - eye.x) * m.levelForwardX + ((point.z ?? 0) - (eye.z ?? 0)) * m.levelForwardZ
    end function

    ' The near plane's normal, and a point on it below: distanceFromCameraFront(p) is
    ' (p - point) . normal, for inlining over many points.
    '
    ' @return {BGE.Math.Vector}
    function getFrontPlaneNormal() as BGE.Math.Vector
      return m.frustumNormals.near
    end function

    ' @return {BGE.Math.Vector}
    function getFrontPlanePoint() as BGE.Math.Vector
      return m.frustrumConvergence
    end function

    function distanceFromFrustumSide(frustumSide as string, point as BGE.Math.Vector) as float
      frusNorm = m.frustumNormals[frustumSide]
      return BGE.Math.distanceFromPlane(m.frustrumConvergence, frusNorm, point)
    end function


    override function isInView(point as BGE.Math.Vector) as boolean
      return m.isAnyInView([point])
    end function

    ' Judged against the planes isAnyInView() uses for several points: hidden if the sphere is
    ' wholly outside one, in view if it's wholly inside them all.
    override function getSphereInViewVerdict(sphere as BGE.Math.BoundingSphere, farScale = 1.0 as float) as integer
      normals = m.frustumNormals
      nearN = normals.near
      r = sphere.radius
      rr = r * r
      cx = sphere.x
      cy = sphere.y
      cz = sphere.z
      inside = true
      ' near: through the convergence point. Each plane is compared squared, as the normals
      ' needn't be unit length: wholly out when d < 0 and d^2 > r^2 |n|^2.
      conv = m.frustrumConvergence
      nx = nearN.x
      ny = nearN.y
      nz = nearN.z ?? 0
      nn = nx * nx + ny * ny + nz * nz
      d = (cx - conv.x) * nx + (cy - conv.y) * ny + (cz - (conv.z ?? 0)) * nz
      if d * d <= rr * nn
        inside = false
      else if d < 0
        return 0
      end if
      ' far: the view direction from the camera, out to the draw distance
      camPos = m.position
      dx = cx - camPos.x
      dy = cy - camPos.y
      dz = cz - (camPos.z ?? 0)
      reach = r * Sqr(nn)
      forward = dx * nx + dy * ny + dz * nz
      drawDistance = m.getCurrentDrawDistance() * farScale
      if forward - reach > drawDistance
        return 0
      else if forward + reach > drawDistance
        inside = false
      end if
      ' the sides, through the camera, unrolled: this runs for every still object
      n = normals.top
      nx = n.x
      ny = n.y
      nz = n.z ?? 0
      d = dx * nx + dy * ny + dz * nz
      if d * d <= rr * (nx * nx + ny * ny + nz * nz)
        inside = false
      else if d < 0
        return 0
      end if
      n = normals.left
      nx = n.x
      ny = n.y
      nz = n.z ?? 0
      d = dx * nx + dy * ny + dz * nz
      if d * d <= rr * (nx * nx + ny * ny + nz * nz)
        inside = false
      else if d < 0
        return 0
      end if
      n = normals.right
      nx = n.x
      ny = n.y
      nz = n.z ?? 0
      d = dx * nx + dy * ny + dz * nz
      if d * d <= rr * (nx * nx + ny * ny + nz * nz)
        inside = false
      else if d < 0
        return 0
      end if
      n = normals.bottom
      nx = n.x
      ny = n.y
      nz = n.z ?? 0
      d = dx * nx + dy * ny + dz * nz
      if d * d <= rr * (nx * nx + ny * ny + nz * nz)
        inside = false
      else if d < 0
        return 0
      end if
      if inside
        return 1
      end if
      return -1
    end function

    ' Same arithmetic as distanceFromFrustumSide() for each side, inlined - this runs for
    ' every bounding point of every object each frame the camera moves.
    override function isAnyInView(points as BGE.Math.Vector[], farScale = 1.0 as float) as boolean
      normals = m.frustumNormals
      nearN = normals.near
      topN = normals.top
      leftN = normals.left
      rightN = normals.right
      bottomN = normals.bottom
      conv = m.frustrumConvergence
      convX = conv.x
      convY = conv.y
      convZ = conv.z ?? 0
      camPos = m.position
      posX = camPos.x
      posY = camPos.y
      posZ = camPos.z ?? 0
      ' the view direction (level under shear), as the near plane faces
      orient = nearN
      orientZ = orient.z ?? 0
      drawDistance = m.getCurrentDrawDistance() * farScale
      if points.Count() = 0
        return false
      end if
      ' The side planes meet at the camera for an object's real extent. A lone anchor point
      ' can't say how big its object is, so it gets the margin of meeting at the convergence
      ' point behind the camera instead.
      sideX = posX
      sideY = posY
      sideZ = posZ
      if points.Count() = 1
        sideX = convX
        sideY = convY
        sideZ = convZ
      end if
      ' Hidden only if every point is outside the same side, or past the draw distance. Testing
      ' each point on its own would cull a long wall whose ends are both off screen while its
      ' middle crosses the view.
      outNear = true
      outTop = true
      outLeft = true
      outRight = true
      outBottom = true
      outFar = true
      for each point in points
        pz = point.z ?? 0
        dx = point.x - convX
        dy = point.y - convY
        dz = pz - convZ
        if dx * nearN.x + dy * nearN.y + dz * nearN.z >= 0
          outNear = false
        end if
        sx = point.x - sideX
        sy = point.y - sideY
        sz = pz - sideZ
        if sx * topN.x + sy * topN.y + sz * topN.z >= 0
          outTop = false
        end if
        if sx * leftN.x + sy * leftN.y + sz * leftN.z >= 0
          outLeft = false
        end if
        if sx * rightN.x + sy * rightN.y + sz * rightN.z >= 0
          outRight = false
        end if
        if sx * bottomN.x + sy * bottomN.y + sz * bottomN.z >= 0
          outBottom = false
        end if
        if (point.x - posX) * orient.x + (point.y - posY) * orient.y + (pz - posZ) * orientZ <= drawDistance
          outFar = false
        end if
        ' every side has a point inside it: in view, whatever the rest say
        if not (outNear or outTop or outLeft or outRight or outBottom or outFar)
          return true
        end if
      end for
      return not (outNear or outTop or outLeft or outRight or outBottom or outFar)
    end function


    override sub computeWorldToCameraMatrix()
      lookTarget = BGE.Math.VectorOps.add(m.position, m.getViewForward())
      m.worldToCamera = BGE.Math.Matrix44.inverse(BGE.Math.lookAt(m.position, lookTarget, m.getUpVector()))
      ' kept with the matrix it goes with, for the projections' hot loops
      m.pitchShiftY = m.getPitchShiftY()
    end sub

    override function getDrawMode() as BGE.SceneObjectDrawMode
      return m.currentDrawMode
    end function


    sub toggleWireFrame()
      if m.currentDrawMode = SceneObjectDrawMode.oriented
        m.currentDrawMode = SceneObjectDrawMode.wireFrame
      else
        m.currentDrawMode = SceneObjectDrawMode.oriented
      end if
    end sub


    override function worldPointToCanvasPoint(pWorld as BGE.Math.Vector) as BGE.Math.Vector
      if invalid = m.worldToCamera
        m.computeWorldToCameraMatrix()
      end if
      pCamera = BGE.Math.Matrix44.multVecMatrix(pWorld, m.worldToCamera)
      if pCamera.z >= 0
        return invalid
      end if
      near = m.getProjectionNear()
      canvasWidth = m.frameSize.x
      canvasHeight = m.frameSize.y
      ndcX = (near * pCamera.x / -pCamera.z + canvasWidth * 0.5) / canvasWidth
      ndcY = (near * pCamera.y / -pCamera.z + canvasHeight * 0.5) / canvasHeight
      return {x: fix(ndcX * canvasWidth), y: cint((1 - ndcY) * canvasHeight + m.pitchShiftY), z: 0}
    end function


    ' The projection's focal length in pixels, cached until the frame width, FOV or zoom changes.
    ' Zoom multiplies it (see getEffectiveFieldOfViewDegrees()).
    '
    ' @return {float}
    private function getProjectionNear() as float
      if m.frameSize.x <> m.projectionNearFrameWidth or m.fieldOfViewDegrees <> m.projectionNearFieldOfView or m.zoom <> m.projectionNearZoom
        m.projectionNear = (m.frameSize.x / 2) / tan(BGE.Math.DegreesToRadians(m.fieldOfViewDegrees) / 2)
        zoom = m.getEffectiveZoom()
        if zoom <> 1
          m.projectionNear = m.projectionNear * zoom
        end if
        m.projectionNearFrameWidth = m.frameSize.x
        m.projectionNearFieldOfView = m.fieldOfViewDegrees
        m.projectionNearZoom = m.zoom
      end if
      return m.projectionNear
    end function

    ' The horizontal field of view in use: fieldOfViewDegrees narrowed by the zoom, as a lens
    ' with zoom times the focal length sees it (2 * atan(tan(fov / 2) / zoom)). Exactly
    ' fieldOfViewDegrees at zoom 1.
    '
    ' @return {float} degrees
    function getEffectiveFieldOfViewDegrees() as float
      zoom = m.getEffectiveZoom()
      if zoom = 1
        return m.fieldOfViewDegrees
      end if
      halfRad = BGE.Math.DegreesToRadians(m.fieldOfViewDegrees) / 2
      return BGE.Math.RadiansToDegrees(2 * atn(tan(halfRad) / zoom))
    end function


    ' Projects many points at once, giving the same canvas point as worldPointToCanvasPoint()
    ' and the same depth as distanceFromCameraFront() for each, but faster.
    '
    ' @param {BGE.Math.Vector[]} points world points
    ' @param {float[]} out cleared, then filled with x, y, depth for each point in turn
    ' @param {boolean} [markBehind=false] give a point behind the camera x 0, y 0 and depth
    '   BGE.PROJECTED_BEHIND_CAMERA_DEPTH, instead of stopping
    ' @return {boolean} false, leaving `out` incomplete, as soon as a point won't project
    '   (never when markBehind is true)
    function projectPointsWithDepth(points as BGE.Math.Vector[], out as float[], markBehind = false as boolean) as boolean
      out.Clear()
      if invalid = m.worldToCamera
        m.computeWorldToCameraMatrix()
      end if
      ' the same arithmetic, in the same order, as multVecMatrix(), worldPointToCanvasPoint()
      ' and distanceFromPlane(), so the results match exactly
      mat = m.worldToCamera
      m0 = mat[0]
      m1 = mat[1]
      m2 = mat[2]
      m3 = mat[3]
      near = m.getProjectionNear()
      canvasWidth = m.frameSize.x
      canvasHeight = m.frameSize.y
      shiftY = m.pitchShiftY
      nearNormal = m.frustumNormals.near
      convergence = m.frustrumConvergence
      for each point in points
        srcX = point.x
        srcY = point.y
        srcZ = point.z
        if invalid = srcZ
          srcZ = 0
        end if
        w = srcX * m0[3] + srcY * m1[3] + srcZ * m2[3] + m3[3]
        cz = (srcX * m0[2] + srcY * m1[2] + srcZ * m2[2] + m3[2]) / w
        if cz >= 0
          if not markBehind
            return false
          end if
          out.push(0)
          out.push(0)
          out.push(BGE.PROJECTED_BEHIND_CAMERA_DEPTH)
          continue for
        end if
        cx = (srcX * m0[0] + srcY * m1[0] + srcZ * m2[0] + m3[0]) / w
        cy = (srcX * m0[1] + srcY * m1[1] + srcZ * m2[1] + m3[1]) / w
        ndcX = (near * cx / -cz + canvasWidth * 0.5) / canvasWidth
        ndcY = (near * cy / -cz + canvasHeight * 0.5) / canvasHeight
        out.push(fix(ndcX * canvasWidth))
        out.push(cint((1 - ndcY) * canvasHeight + shiftY))
        out.push((srcX - convergence.x) * nearNormal.x + (srcY - convergence.y) * nearNormal.y + (srcZ - convergence.z) * nearNormal.z)
      end for
      return true
    end function


    ' projectPointsWithDepth() for a convex outline, cut where it crosses camera z
    ' BGE.QuadColumnNearZ(), as model faces are cut when drawn, so no point projects more than
    ' ~64x off center.
    '
    ' @param {BGE.Math.Vector[]} points world points in order around the outline
    ' @param {float[]} out cleared, then filled with x, y, depth for each point of the cut outline
    ' @return {boolean} false when none of it is in front of that z
    function projectOutlineCutAtNear(points as BGE.Math.Vector[], out as float[]) as boolean
      if invalid = m.worldToCamera
        m.computeWorldToCameraMatrix()
      end if
      mat = m.worldToCamera
      m0 = mat[0]
      m1 = mat[1]
      m2 = mat[2]
      m3 = mat[3]
      nearZ = BGE.QuadColumnNearZ(m.getProjectionNear())
      n = points.count()
      zs = [] as float[]
      allIn = true
      for each point in points
        srcZ = point.z
        if invalid = srcZ
          srcZ = 0
        end if
        w = point.x * m0[3] + point.y * m1[3] + srcZ * m2[3] + m3[3]
        z = (point.x * m0[2] + point.y * m1[2] + srcZ * m2[2] + m3[2]) / w
        if z > nearZ
          allIn = false
        end if
        zs.push(z)
      end for
      if allIn
        return m.projectPointsWithDepth(points, out)
      end if
      cut = [] as BGE.Math.Vector[]
      for i = 0 to n - 1
        j = (i + 1) mod n
        a = points[i]
        za = zs[i]
        zb = zs[j]
        aIn = za <= nearZ
        if aIn
          cut.push(a)
        end if
        if aIn <> (zb <= nearZ)
          b = points[j]
          t = (nearZ - za) / (zb - za)
          cut.push(BGE.Math.VectorOps.create(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, (a.z ?? 0) + ((b.z ?? 0) - (a.z ?? 0)) * t))
        end if
      end for
      if cut.count() < 3
        out.Clear()
        return false
      end if
      return m.projectPointsWithDepth(cut, out)
    end function

    override sub useDefaultCameraTarget()
      m.setTarget(BGE.Math.VectorOps.create())
    end sub


    ' Returns two screen-space points that define the visible horizon line of a plane.
    ' If the horizon does not intersect the camera frame, an empty array is returned.
    '
    ' @param {BGE.Math.Plane} plane
    ' @return {BGE.Math.Vector[]} Two points in screen space that define the horizon line of the plane, or an empty array if the plane is not visible.
    ' With pitchMode "rotate" only: doesn't apply a shear camera's pitch shift.
    function getHorizonOfPlane_AI(plane as BGE.Math.Plane) as BGE.Math.Vector[]
      output as BGE.Math.Vector[] = []
      if invalid = plane or invalid = plane.normal or invalid = plane.point
        return output
      end if

      if invalid = m.worldToCamera
        m.computeWorldToCameraMatrix()
      end if

      planeNormalCamera = BGE.Math.Matrix44.multDirMatrix(plane.normal, m.worldToCamera)
      planePointCamera = BGE.Math.Matrix44.multVecMatrix(plane.point, m.worldToCamera)

      near = m.getProjectionNear()
      halfW = m.frameSize.x / 2
      halfH = m.frameSize.y / 2

      a = planeNormalCamera.x
      b = planeNormalCamera.y
      planeDot = BGE.Math.VectorOps.dotProduct(planeNormalCamera, planePointCamera)
      rhs = planeNormalCamera.z * near + planeDot
      epsilon = 0.00001

      ' Horizon on near plane: a*x + b*y = rhs. Intersect with view rectangle bounds.
      if abs(b) > epsilon
        yAtLeft = (rhs - a * (-halfW)) / b
        if yAtLeft >= -halfH and yAtLeft <= halfH
          output.push({x: -halfW, y: yAtLeft, z: -near})
        end if

        yAtRight = (rhs - a * halfW) / b
        if yAtRight >= -halfH and yAtRight <= halfH
          didFind = false
          for each p in output
            if abs(p.x - halfW) < epsilon and abs(p.y - yAtRight) < epsilon
              didFind = true
              exit for
            end if
          end for
          if not didFind
            output.push({x: halfW, y: yAtRight, z: -near})
          end if
        end if
      end if

      if abs(a) > epsilon
        xAtTop = (rhs - b * (-halfH)) / a
        if xAtTop >= -halfW and xAtTop <= halfW
          didFind = false
          for each p in output
            if abs(p.x - xAtTop) < epsilon and abs(p.y + halfH) < epsilon
              didFind = true
              exit for
            end if
          end for
          if not didFind
            output.push({x: xAtTop, y: -halfH, z: -near})
          end if
        end if

        xAtBottom = (rhs - b * halfH) / a
        if xAtBottom >= -halfW and xAtBottom <= halfW
          didFind = false
          for each p in output
            if abs(p.x - xAtBottom) < epsilon and abs(p.y - halfH) < epsilon
              didFind = true
              exit for
            end if
          end for
          if not didFind
            output.push({x: xAtBottom, y: halfH, z: -near})
          end if
        end if
      end if

      if output.count() > 2


        maxDist = -1
        bestI = 0
        bestJ = 1
        for i = 0 to output.count() - 1
          for j = i + 1 to output.count() - 1
            dx = output[i].x - output[j].x
            dy = output[i].y - output[j].y
            distSq = dx * dx + dy * dy
            if distSq > maxDist
              maxDist = distSq
              bestI = i
              bestJ = j
            end if
          end for
        end for

        output = [output[bestI], output[bestJ]]
      end if

      for i = 0 to output.count() - 1
        output[i] = {x: output[i].x + halfW, y: output[i].y + halfH}
      end for

      return output
    end function


    function findHorizonPoint(screenX as float, focalLength as float, nv as BGE.Math.Vector) as BGE.Math.Vector
      ' Equation: px * nv.x + py * nv.y + f * nv.z = 0
      ' Solving for py:
      ' py = - (screenX * nv.x + focalLength * nv.z) / nv.y

      py = (screenX * nv.x + focalLength * nv.z) / nv.y
      return {x: screenX, y: py}
    end function

    ' The camera's intrinsic focal length in pixels, derived from its real field of
    ' view and frame width. This is independent of any particular canvas size - see
    ' getFovDegreesForCanvasSize(), which uses it to answer "what FOV would a
    ' differently-sized canvas need to cover the same angular extent this camera
    ' actually sees."
    '
    ' @return {float}
    function getFocalLength() as float
      return m.getProjectionNear()
    end function

    ' The depth (see viewDepth()) of the near plane models are cut back to: focal length / 64, as
    ' BGE.QuadColumnNearZ()
    '
    ' @return {float}
    function getNearDepth() as float
      return m.getProjectionNear() / 64
    end function

    ' How far ahead of the eye `point` is, along the view direction: the depth perspective
    ' divides by. Unlike distanceFromCameraFront(), measured from the eye itself.
    '
    ' @param {BGE.Math.Vector} point - world position
    ' @return {float} negative behind the eye
    function viewDepth(point as BGE.Math.Vector) as float
      o = m.getViewForward()
      p = m.position
      return (point.x - p.x) * o.x + (point.y - p.y) * o.y + ((point.z ?? 0) - (p.z ?? 0)) * (o.z ?? 0)
    end function

    ' Canvas pixels per world unit at `depth` ahead of the eye: focal length / depth.
    '
    ' @param {float} depth - see viewDepth()
    ' @return {float} 0 at or nearer than the near plane (getNearDepth()), where it would blow up
    function pixelsPerWorldUnitAtDepth(depth as float) as float
      focal = m.getProjectionNear()
      if depth <= focal / 64
        return 0.0
      end if
      return focal / depth
    end function

    override function pixelsPerWorldUnitAt(point as BGE.Math.Vector) as float
      return m.pixelsPerWorldUnitAtDepth(m.viewDepth(point))
    end function

    ' The (horizontal = vertical, meant for a square canvas) field of view a
    ' canvasSize x canvasSize canvas would need to cover the same angular extent as
    ' this camera's real field of view does for its own frame width, at the same
    ' focal length. Used by SceneObjectPlane to render its ground geometry into an
    ' enlarged canvas before rotating it for roll - see SceneObjectPlane.
    '
    ' @param {float} canvasSize
    ' @return {float} degrees
    function getFovDegreesForCanvasSize(canvasSize as float) as float
      return BGE.Math.RadiansToDegrees(2 * BGE.Math.Atan2(canvasSize / 2, m.getFocalLength()))
    end function

    ' Returns two screen-space points that define the visible horizon line of a plane.
    ' If the horizon does not intersect the camera frame, invalid is returned.
    '
    ' @param {BGE.Math.Plane} plane
    ' @return {BGE.Math.Vector[]} Two points in screen space that define the horizon line of the plane, or invalid if the plane is not visible.
    ' With pitchMode "rotate" only: doesn't apply a shear camera's pitch shift.
    function getHorizonLine(plane as BGE.Math.Plane) as BGE.Math.Vector[]
      if invalid = m.worldToCamera
        m.computeWorldToCameraMatrix()
      end if
      return m.horizonLineForMatrix(plane, m.worldToCamera, m.frameSize.x, m.getFocalLength())
    end function

    ' The horizon line as seen by an unrolled (rollDegrees = 0) camera at this
    ' camera's real position/orientation, against a canvasSize x canvasSize square
    ' canvas rather than the real frame - useful for a Mode-7-style renderer that
    ' needs a plane's horizon position in an enlarged, unrolled view before applying
    ' roll as a final image rotation. Not currently called anywhere in this engine
    ' (SceneObjectPlane computes each ground slice's own position via true
    ' perspective projection instead, and no longer needs an explicit horizon
    ' position) - kept as public Camera3d API.
    '
    ' @param {BGE.Math.Plane} plane
    ' @param {float} canvasSize
    ' @return {BGE.Math.Vector[]}
    ' With pitchMode "rotate" only: doesn't apply a shear camera's pitch shift.
    function getLevelHorizonLine(plane as BGE.Math.Plane, canvasSize as float) as BGE.Math.Vector[]
      lookTarget = BGE.Math.VectorOps.add(m.position, m.orientation)
      levelWorldToCamera = BGE.Math.Matrix44.inverse(BGE.Math.lookAt(m.position, lookTarget, m.getLevelUpVector()))
      return m.horizonLineForMatrix(plane, levelWorldToCamera, canvasSize, m.getFocalLength())
    end function

    ' Shared core of getHorizonLine()/getLevelHorizonLine() - see those for context.
    '
    ' @param {BGE.Math.Plane} plane
    ' @param {float[][]} worldToCameraMatrix
    ' @param {float} canvasWidth
    ' @param {float} focalLength
    ' @return {BGE.Math.Vector[]}
    private function horizonLineForMatrix(plane as BGE.Math.Plane, worldToCameraMatrix as float[][], canvasWidth as float, focalLength as float) as BGE.Math.Vector[]
      if invalid = plane or invalid = plane.normal or invalid = plane.point
        return invalid
      end if

      ' Transform the plane's normal into view space (ignore translation).
      nv = BGE.Math.Matrix44.multDirMatrix(plane.normal, worldToCameraMatrix)

      ' If nv.y is near 0, the camera is tilted so the horizon is vertical, or
      ' looking straight up/down - no meaningful horizontal horizon to draw.
      if abs(nv.y) < 0.001
        return invalid
      end if

      leftPt = m.findHorizonPoint(-canvasWidth * 0.5, focalLength, nv)
      rightPt = m.findHorizonPoint(canvasWidth * 0.5, focalLength, nv)
      return [leftPt, rightPt]
    end function

    ' Converts from float (-1 to 1) screen space with (0,0) as the center of the screen to pixel coordinates
    '
    ' @param {BGE.Math.Vector} pCamera
    ' @return {BGE.Math.Vector}
    function cameraPointToScreenPoint(pCamera as BGE.Math.Vector) as BGE.Math.Vector
      ' if pCamera.z >= 0
      '   return invalid
      ' end if
      ' pScreen = {x: 0, y: 0}

      ' near = (m.frameSize.x / 2) / tan(BGE.Math.DegreesToRadians(m.fieldOfViewDegrees) / 2)
      ' pScreen.x = near * pCamera.x / -pCamera.z
      ' pScreen.y = near * pCamera.y / -pCamera.z
      width = m.frameSize.x
      height = m.frameSize.y
      return {x: pCamera.x + width * 0.5, y: height * 0.5 - pCamera.y}
    end function




    ' The vertical field of view the projection actually shows, for the frame's aspect ratio
    '
    ' @return {float} degrees
    function getTrueVerticalFOV() as float
      fov = m.getEffectiveFieldOfViewDegrees()
      if m.frameSize.x = 0 or m.frameSize.y = 0
        return fov
      end if
      halfRad = BGE.Math.DegreesToRadians(fov) / 2
      return BGE.Math.RadiansToDegrees(2 * atn(tan(halfRad) * m.frameSize.y / m.frameSize.x))
    end function

    function getVerticalFOV() as float
      fov = m.getEffectiveFieldOfViewDegrees()
      if m.frameSize.x = 0 or m.frameSize.y = 0
        return fov
      end if
      aspectRatio = m.frameSize.y / m.frameSize.x
      return fov * aspectRatio
    end function

    ' The "level" (rollDegrees = 0) up vector - see getUpVector() for the roll-aware
    ' version most callers want. SceneObjectPlane uses this one directly, since its
    ' ground rendering computes its own geometry against an unrolled view and applies
    ' roll as a final image rotation instead (see SceneObjectPlane).
    '
    ' @return {BGE.Math.Vector}
    function getLevelUpVector() as BGE.Math.Vector
      ' cached by orientation, which callers may replace or change in place
      o = m.orientation
      cached = m.levelUpCache
      if invalid <> cached and o.x = m.levelUpCacheOrientation.x and o.y = m.levelUpCacheOrientation.y and o.z = m.levelUpCacheOrientation.z and m.levelUpCachePitchMode = m.pitchMode
        return BGE.Math.VectorOps.copy(cached)
      end if
      m.levelUpCacheOrientation = BGE.Math.VectorOps.copy(o)
      m.levelUpCachePitchMode = m.pitchMode
      m.levelUpCache = m.computeLevelUpVector()
      return BGE.Math.VectorOps.copy(m.levelUpCache)
    end function

    private function computeLevelUpVector() as BGE.Math.Vector
      forward = BGE.Math.VectorOps.copy(m.getViewForward())
      BGE.Math.VectorOps.normalize(forward)

      worldUp = BGE.Math.VectorOps.create(0, 1, 0)
      right = BGE.Math.VectorOps.crossProduct(worldUp, forward)
      epsilon = 0.00001

      if BGE.Math.VectorOps.norm(right) <= epsilon
        worldUp = BGE.Math.VectorOps.create(0, 0, 1)
        right = BGE.Math.VectorOps.crossProduct(worldUp, forward)
      end if

      if BGE.Math.VectorOps.norm(right) <= epsilon
        return BGE.Math.VectorOps.create(0, 1, 0)
      end if

      BGE.Math.VectorOps.normalize(right)
      up = BGE.Math.VectorOps.crossProduct(forward, right)
      BGE.Math.VectorOps.normalize(up)
      return up
    end function

    ' The "level" (rollDegrees = 0) right vector - see getLevelUpVector().
    '
    ' @return {BGE.Math.Vector}
    function getLevelRightVector() as BGE.Math.Vector
      return BGE.Math.VectorOps.crossProduct(m.getViewForward(), m.getLevelUpVector())
    end function

    ' Returns a normalized up vector that is perpendicular to the camera orientation,
    ' rotated around the forward axis by rollDegrees. This assumes a world-up
    ' preference (+Y) before roll is applied, with fallback when forward is parallel
    ' to +Y - see getLevelUpVector().
    override function getUpVector() as BGE.Math.Vector
      if m.rollDegrees = 0
        return m.getLevelUpVector()
      end if
      m.updateRolledAxes()
      return BGE.Math.VectorOps.copy(m.rolledUpCache)
    end function


    override function getRightVector() as BGE.Math.Vector
      if m.rollDegrees = 0
        return m.getLevelRightVector()
      end if
      m.updateRolledAxes()
      return BGE.Math.VectorOps.copy(m.rolledRightCache)
    end function

    ' The level up and right vectors rotated by the roll about the view direction, cached
    ' by orientation (which callers may replace or change in place), roll and pitch mode.
    private sub updateRolledAxes()
      o = m.orientation
      cachedFrom = m.rolledCacheOrientation
      if invalid <> cachedFrom and o.x = cachedFrom.x and o.y = cachedFrom.y and o.z = cachedFrom.z and m.rolledCacheRoll = m.rollDegrees and m.rolledCachePitchMode = m.pitchMode
        return
      end if
      m.rolledCacheOrientation = BGE.Math.VectorOps.copy(o)
      m.rolledCacheRoll = m.rollDegrees
      m.rolledCachePitchMode = m.pitchMode
      forward = m.getViewForward()
      radians = BGE.Math.DegreesToRadians(m.rollDegrees)
      m.rolledUpCache = BGE.Math.RotateVectorAroundPoint3d(m.getLevelUpVector(), BGE.Math.VectorOps.create(), forward, radians)
      m.rolledRightCache = BGE.Math.RotateVectorAroundPoint3d(m.getLevelRightVector(), BGE.Math.VectorOps.create(), forward, radians)
    end sub

    ' Caps the effective draw distance (see getEffectiveMaxDrawDistance()) per device:
    ' SceneObjectPlane's scratch bitmaps scale with it, and the BrightScript Simulator
    ' silently fails to render past ~908 (binary-search confirmed - see
    ' lvcabral/brs-engine#1198), hence the 900 cap.
    '
    ' FHD's 2500 is confirmed by the same binary-search method on a real 2024 Roku
    ' Ultra (issue #142): SceneObjectPlane.getPrePerspectiveBmp()'s per-plane scratch
    ' bitmap grows with maxDrawDistance and, past a threshold, CreateObject("roBitmap")
    ' silently returns Invalid, crashing later with a "Dot operator on invalid" error
    ' in populatePerspectiveBmp() - 2725 confirmed working, 2750 confirmed crashing;
    ' 2500 keeps a real margin below that measured edge.
    '
    ' HD's 1000 (the default maxDrawDistance) runs examples/terrain on a real Roku
    ' Express (model 3930, 64MB texture memory) since its plane bitmaps got a per-tier
    ' pixel budget (see getPlanePrePerspectiveMaxPixels()) and so no longer grow with
    ' draw distance (issue #151). It was 30 before that (#137). SD keeps 30, untested.
    '
    ' @return {float}
    private function getMaxDrawDistanceDeviceCap() as float
      if m.maxDrawDistanceDeviceCap < 0
        tier = BGE.getDeviceRenderTier()
        if tier = BGE.DeviceRenderTier.simulator
          m.maxDrawDistanceDeviceCap = 900
        else if tier = BGE.DeviceRenderTier.fhd
          m.maxDrawDistanceDeviceCap = 2500
        else if tier = BGE.DeviceRenderTier.hd
          m.maxDrawDistanceDeviceCap = 1000
        else
          m.maxDrawDistanceDeviceCap = 30
        end if
      end if
      return m.maxDrawDistanceDeviceCap
    end function

    ' How far a `DrawablePlane` (ground/terrain) draws: the farthest any quality level
    ' would draw objects, so objects always fade out on the ground - never past its
    ' edge. Doesn't change with the level, so the horizon stays put.
    '
    ' @return {float}
    function getPlaneDrawDistance() as float
      return m.getPlaneDrawDistanceForTexelScale(1)
    end function

    ' How far a `DrawablePlane` whose texels each cover `texelScale` world units draws.
    ' The device cap limits the plane's bitmaps, which are sized in texels, so a coarser
    ' plane can reach that much farther. A texel scale of 1 or less is getPlaneDrawDistance().
    '
    ' @param {float} texelScale world units per texel
    ' @return {float}
    function getPlaneDrawDistanceForTexelScale(texelScale as float) as float
      distance = m.maxDrawDistance * m.planeDrawDistanceScale
      if m.planeDrawDistanceOverride > distance
        distance = m.planeDrawDistanceOverride * 1.0
      end if
      ' never shorter than objects reach, whatever set the camera's own scale
      objectDistance = m.maxDrawDistance * m.drawDistanceScale
      if m.drawDistanceOverride > 0
        objectDistance = m.drawDistanceOverride * 1.0
      end if
      if objectDistance > distance
        distance = objectDistance
      end if
      deviceCap = m.getMaxDrawDistanceDeviceCap() * BGE.Math.Max(1, texelScale)
      if distance > deviceCap
        distance = deviceCap * 1.0
      end if
      return distance
    end function

    ' The draw distance the renderer actually uses: `drawDistanceOverride` if set,
    ' otherwise `maxDrawDistance * drawDistanceScale`, then capped for this device.
    '
    ' @return {float}
    function getEffectiveMaxDrawDistance() as float
      distance = m.maxDrawDistance * m.drawDistanceScale
      if m.drawDistanceOverride > 0
        distance = m.drawDistanceOverride * 1.0
      end if
      deviceCap = m.getMaxDrawDistanceDeviceCap()
      if distance > deviceCap
        distance = deviceCap * 1.0
      end if
      return distance
    end function

    ' The draw distance actually used for clipping and fading this frame. Follows
    ' `getEffectiveMaxDrawDistance()`, easing toward it over
    ' `drawDistanceTransitionSeconds` whenever it changes.
    '
    ' @return {float}
    function getCurrentDrawDistance() as float
      if m.currentDrawDistance < 0
        return m.getEffectiveMaxDrawDistance()
      end if
      return m.currentDrawDistance
    end function

    ' How far fog silhouettes reach, as a multiple of the current draw distance: the fog's
    ' `silhouetteReach`. A reach past 1 counts from the draw distance before a session scale under
    ' 1 (`Game.setDrawDistanceScale()`), so a shorter draw distance doesn't pull in the skyline.
    '
    ' @return {float}
    function getFogSilhouetteReach() as float
      reach = m.fog.silhouetteReach
      if reach > 1 and m.sessionDrawDistanceScale < 1
        return reach / m.getSessionDrawDistanceShrink()
      end if
      return reach
    end function

    ' How much the session scale actually shortened the draw distance (1 for not at all). Not
    ' just the scale: the device cap can hold the unscaled distance in too.
    private function getSessionDrawDistanceShrink() as float
      sessionScale = m.sessionDrawDistanceScale
      if sessionScale <= 0 or sessionScale >= 1
        return 1.0
      end if
      unscaled = m.maxDrawDistance * m.drawDistanceScale / sessionScale
      if m.drawDistanceOverride > 0
        unscaled = m.drawDistanceOverride / sessionScale
      end if
      deviceCap = m.getMaxDrawDistanceDeviceCap()
      if unscaled > deviceCap
        unscaled = deviceCap * 1.0
      end if
      if unscaled <= 0
        return 1.0
      end if
      return m.getEffectiveMaxDrawDistance() / unscaled
    end function

    ' Jumps straight to the target draw distance, skipping any transition in progress -
    ' e.g. after a camera cut, where easing the horizon would look odd.
    sub snapDrawDistance()
      m.currentDrawDistance = -1
    end sub

    ' Moves the current draw distance toward its target by `dt` seconds' worth of the
    ' transition. Called every frame by `checkMovement()`; only call it yourself in tests.
    '
    ' @param {float} dt elapsed seconds (clamped to 0-0.1)
    sub advanceDrawDistance(dt as float)
      if dt < 0
        dt = 0
      else if dt > MAX_DRAW_DISTANCE_TRANSITION_STEP_SECONDS
        dt = MAX_DRAW_DISTANCE_TRANSITION_STEP_SECONDS
      end if
      target = m.getEffectiveMaxDrawDistance()
      previous = m.currentDrawDistance
      seconds = m.drawDistanceTransitionSeconds
      if seconds > 0 and m.fog.enabled and m.fog.followsQuality and m.fog.qualityTransitionSeconds > seconds
        seconds = m.fog.qualityTransitionSeconds
      end if
      if m.currentDrawDistance < 0 or seconds <= 0
        m.currentDrawDistance = target
        m.drawDistanceTransitionTarget = target
      else if m.currentDrawDistance <> target
        if target <> m.drawDistanceTransitionTarget
          ' a new target restarts the transition from wherever it is now
          m.drawDistanceTransitionTarget = target
          m.drawDistanceTransitionSpeed = abs(target - m.currentDrawDistance) / seconds
        end if
        stepSize = m.drawDistanceTransitionSpeed * dt
        if abs(target - m.currentDrawDistance) <= stepSize
          m.currentDrawDistance = target
        else if target > m.currentDrawDistance
          m.currentDrawDistance = m.currentDrawDistance + stepSize
        else
          m.currentDrawDistance = m.currentDrawDistance - stepSize
        end if
      end if
      ' objects never reach past the ground, e.g. right after maxDrawDistance shrinks
      planeDistance = m.getPlaneDrawDistance()
      if m.currentDrawDistance > planeDistance
        m.currentDrawDistance = planeDistance
      end if
      fractionChanged = m.drawDistanceFadeFraction <> m.lastDrawDistanceFadeFraction
      m.lastDrawDistanceFadeFraction = m.drawDistanceFadeFraction
      m.farDistanceChanged = fractionChanged or previous <> m.currentDrawDistance
    end sub

    ' Fog hides the draw distance's edge, so it stays put unless the fog follows quality
    '
    ' @return {boolean}
    override function fixesDrawDistance() as boolean
      return m.fog.enabled and not m.fog.followsQuality
    end function

    override function farDistanceChangedThisFrame() as boolean
      return m.farDistanceChanged
    end function

    override function isDrawDistanceTransitioning() as boolean
      return m.currentDrawDistance >= 0 and m.currentDrawDistance <> m.getEffectiveMaxDrawDistance()
    end function

    ' 1 inside the draw distance, falling linearly to 0 across the last
    ' `drawDistanceFadeFraction` of it, 0 at or beyond it.
    '
    ' @param {BGE.Math.Vector} point world position
    ' @param {float} [distanceScale=1] - fade as if the draw distance were this many times as far
    ' @return {float}
    override function getDistanceFadeAlpha(point as BGE.Math.Vector, distanceScale = 1.0 as float) as float
      if m.drawDistanceFadeFraction <= 0
        return 1.0
      end if
      forward = m.getViewForward()
      return m.fadeAlphaForForwardDistance(BGE.Math.VectorOps.dotProduct(point, forward) - BGE.Math.VectorOps.dotProduct(m.position, forward), distanceScale)
    end function

    override function isPerspective() as boolean
      return true
    end function

    override function supportsOcclusionCulling() as boolean
      return true
    end function

    override function fadesWithDistance() as boolean
      return m.drawDistanceFadeFraction > 0
    end function

    ' Like getDistanceFadeAlpha(), judged by whichever point is nearest, so a large
    ' object stays visible while any part of it is well inside the draw distance.
    '
    ' @param {BGE.Math.Vector[]} points world positions
    ' @param {float} [distanceScale=1] - see getDistanceFadeAlpha()
    ' @return {float}
    override function getDistanceFadeAlphaForPoints(points as BGE.Math.Vector[], distanceScale = 1.0 as float) as float
      if m.drawDistanceFadeFraction <= 0 or points.count() = 0
        return 1.0
      end if
      ' dot(point - position, view forward), inlined: this runs for every object each frame the
      ' camera moves. The view direction is level under shear.
      o = m.orientation
      if m.pitchMode = CameraPitchMode.shear
        o = m.getViewForward()
      end if
      ox = o.x
      oy = o.y
      oz = o.z ?? 0
      p = m.position
      cameraOffset = p.x * ox + p.y * oy + (p.z ?? 0) * oz
      point = points[0]
      forwardDistance = point.x * ox + point.y * oy + (point.z ?? 0) * oz - cameraOffset
      for i = 1 to points.count() - 1
        point = points[i]
        pointDistance = point.x * ox + point.y * oy + (point.z ?? 0) * oz - cameraOffset
        if pointDistance < forwardDistance
          forwardDistance = pointDistance
        end if
      end for
      return m.fadeAlphaForForwardDistance(forwardDistance, distanceScale)
    end function

    ' The alpha falls with distance, so if the sphere's nearest and farthest reach get the same
    ' alpha, so does every point in it.
    override function getDistanceFadeAlphaForSphere(sphere as BGE.Math.BoundingSphere, distanceScale = 1.0 as float) as float
      if m.drawDistanceFadeFraction <= 0
        return 1.0
      end if
      o = m.orientation
      if m.pitchMode = CameraPitchMode.shear
        o = m.getViewForward()
      end if
      ox = o.x
      oy = o.y
      oz = o.z ?? 0
      p = m.position
      centerDistance = (sphere.x - p.x) * ox + (sphere.y - p.y) * oy + (sphere.z - (p.z ?? 0)) * oz
      ' the orientation needn't be unit length
      reach = sphere.radius * Sqr(ox * ox + oy * oy + oz * oz)
      nearAlpha = m.fadeAlphaForForwardDistance(centerDistance - reach, distanceScale)
      if nearAlpha <> m.fadeAlphaForForwardDistance(centerDistance + reach, distanceScale)
        return -1.0
      end if
      return nearAlpha
    end function

    ' Over 1, it counts from the draw distance before a session scale under 1, like
    ' getFogSilhouetteReach(), so lights keep showing through fog. Kept within
    ' fadeDistanceScaleLimit.
    override function getFadeReach(distanceScale as float) as float
      if distanceScale <= 1
        return 1.0
      end if
      if m.sessionDrawDistanceScale < 1
        distanceScale = distanceScale / m.getSessionDrawDistanceShrink()
      end if
      limit = m.fadeDistanceScaleLimit
      if limit > 0 and distanceScale > limit
        distanceScale = limit
      end if
      return distanceScale
    end function

    ' `distanceScale` (Drawable.fadeDistanceScale) stretches the band; 0 or less counts as 1, and
    ' over 1 it's getFadeReach()
    private function fadeAlphaForForwardDistance(forwardDistance as float, distanceScale = 1.0 as float) as float
      if distanceScale > 1
        distanceScale = m.getFadeReach(distanceScale)
      end if
      if distanceScale > 0 and distanceScale <> 1
        forwardDistance = forwardDistance / distanceScale
      end if
      fraction = m.drawDistanceFadeFraction
      if fraction > 1
        fraction = 1.0
      end if
      far = m.getCurrentDrawDistance()
      if forwardDistance >= far
        return 0.0
      end if
      bandStart = far * (1 - fraction)
      if forwardDistance <= bandStart
        return 1.0
      end if
      return (far - forwardDistance) / (far - bandStart)
    end function

    ' Seconds since the last call, from this camera's own clock (0 on the first call).
    private function getDrawDistanceClockSeconds() as float
      if invalid = m.drawDistanceClock
        m.drawDistanceClock = CreateObject("roTimespan")
        return 0.0
      end if
      seconds = m.drawDistanceClock.TotalMilliseconds() / 1000.0
      m.drawDistanceClock.Mark()
      return seconds
    end function

    protected override function projectionChangedThisFrame() as boolean
      ' called unconditionally rather than inside an `or`, so it always records the new
      ' frame size even when the FOV changed too
      changed = super.projectionChangedThisFrame()

      if m.lastProjectionFieldOfView <> m.fieldOfViewDegrees
        m.lastProjectionFieldOfView = m.fieldOfViewDegrees
        changed = true
      end if

      ' switching how pitch is shown changes the projection with no movement; a pitch change
      ' under shear is already a move (orientation changed), which refreshes everything
      if m.lastProjectionPitchMode <> m.pitchMode
        m.lastProjectionPitchMode = m.pitchMode
        changed = true
        m.worldToCamera = invalid
      end if


      return changed
    end function

    protected override sub onProjectionChange()
      super.onProjectionChange()
      ' the normals are otherwise only rebuilt on a rotation, and both they and the rays
      ' depend on the field of view and (via getVerticalFOV) the frame size
      m.recomputeFrustum(true)
    end sub

  end class

end namespace
