namespace tests

  @suite("BGE.CameraBoom")
  class CameraBoomTests extends rooibos.BaseTestSuite

    game as BGE.Game
    boom as BGE.CameraBoom
    lookAt as BGE.Math.Vector
    wanted as BGE.Math.Vector

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.boom = new BGE.CameraBoom(m.game, {probeRadius: 5, minDistance: 10, collidableFlags: 2})
      ' Looking at the origin from 100 units behind (+z)
      m.lookAt = BGE.Math.VectorOps.create(0, 0, 0)
      m.wanted = BGE.Math.VectorOps.create(0, 0, 100)
    end function

    ' A 40-unit wall across the line from the origin to the camera, its near face at z = 50
    private function addWall(memberFlags = 2 as integer) as BGE.GameEntity
      wall = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Wall"}))
      wall.position = BGE.Math.VectorOps.create(0, 0, 55)
      collider = wall.addBoxCollider3d("body", 40, 40, 10)
      collider.memberFlags = memberFlags
      return wall
    end function

    private function assertNear(actual as float, expected as float, message = "" as string)
      m.assertTrue(Abs(actual - expected) < 0.01, `${message} expected ${expected}, got ${actual}`)
    end function

    @describe("update")

    @it("keeps the wanted position when nothing is in the way")
    function _()
      position = m.boom.update(m.lookAt, m.wanted, 0.016)
      m.assertNear(position.z, 100)
      m.assertFalse(m.boom.isBlocked())
    end function

    @it("pulls in to probeRadius short of a wall, at once")
    function _()
      m.addWall()
      position = m.boom.update(m.lookAt, m.wanted, 0.016)
      m.assertNear(position.z, 45)
      m.assertTrue(m.boom.isBlocked())
    end function

    @it("ignores colliders outside collidableFlags")
    function _()
      m.addWall(1)
      position = m.boom.update(m.lookAt, m.wanted, 0.016)
      m.assertNear(position.z, 100)
    end function

    @it("catches an edge the centre ray misses")
    function _()
      wall = m.addWall()
      ' The centre ray passes 3 units to the side; the probe circle (radius 5) clips it
      wall.position.x = 23
      position = m.boom.update(m.lookAt, m.wanted, 0.016)
      m.assertNear(position.z, 45)
    end function

    @it("never comes closer than minDistance")
    function _()
      wall = m.addWall()
      wall.position.z = 8
      position = m.boom.update(m.lookAt, m.wanted, 0.016)
      m.assertNear(position.z, 10)
      m.boom.closeDistance = 12
      m.assertTrue(m.boom.isClose())
    end function

    @it("eases back out once the wall is gone, and snaps after reset()")
    function _()
      wall = m.addWall()
      m.boom.update(m.lookAt, m.wanted, 0.016)
      wall.invalidate()
      m.game.processCollisionsForTest()

      position = m.boom.update(m.lookAt, m.wanted, 0.1)
      m.assertTrue(position.z > 45 and position.z < 100, "expected part way out, got " + position.z.toStr())

      m.boom.reset()
      position = m.boom.update(m.lookAt, m.wanted, 0.016)
      m.assertNear(position.z, 100)
    end function

  end class

end namespace
