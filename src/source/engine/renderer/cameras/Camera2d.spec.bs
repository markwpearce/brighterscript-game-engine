namespace tests

  @suite("BGE.Camera2d")
  class Camera2dTests extends rooibos.BaseTestSuite

    camera as BGE.Camera2d

    protected override function beforeEach()
      m.camera = new BGE.Camera2d()
      m.camera.setFrameSize(200, 100)
    end function

    @describe("setTarget")

    @it("centers the camera position on the given target, x and y only")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(0, 0, 500)
      m.camera.setTarget(BGE.Math.VectorOps.create(10, 20, 999))

      m.assertEqual(10.0, m.camera.position.x)
      m.assertEqual(20.0, m.camera.position.y)
      ' z (depth) is untouched by a 2d camera's setTarget
      m.assertEqual(500.0, m.camera.position.z)
    end function

    @describe("setBounds")

    @it("clamps the target so the view stays inside the bounds")
    function _()
      m.camera.setBounds(0, 0, 1000, 500)
      m.camera.setTarget(BGE.Math.VectorOps.create(10, 10, 0))
      ' frame is 200x100, so the centre can get no closer than 100/50 to the bottom-left edges
      m.assertEqual(100.0, m.camera.position.x)
      m.assertEqual(50.0, m.camera.position.y)

      m.camera.setTarget(BGE.Math.VectorOps.create(990, 490, 0))
      m.assertEqual(900.0, m.camera.position.x)
      m.assertEqual(450.0, m.camera.position.y)
    end function

    @it("leaves a target well inside the bounds alone")
    function _()
      m.camera.setBounds(0, 0, 1000, 500)
      m.camera.setTarget(BGE.Math.VectorOps.create(400, 300, 0))
      m.assertEqual(400.0, m.camera.position.x)
      m.assertEqual(300.0, m.camera.position.y)
    end function

    @it("centres on an axis where the bounds are smaller than the view")
    function _()
      m.camera.setBounds(50, 0, 120, 500)
      m.camera.setTarget(BGE.Math.VectorOps.create(0, 300, 0))
      m.assertEqual(110.0, m.camera.position.x)
      m.assertEqual(300.0, m.camera.position.y)
    end function

    @it("stops clamping after clearBounds")
    function _()
      m.camera.setBounds(0, 0, 1000, 500)
      m.camera.clearBounds()
      m.camera.setTarget(BGE.Math.VectorOps.create(-20, -30, 0))
      m.assertEqual(-20.0, m.camera.position.x)
      m.assertEqual(-30.0, m.camera.position.y)
    end function

    @describe("follow")

    @it("centres on the followed entity's current position every checkMovement")
    function _()
      entity = {id: "e1", position: BGE.Math.VectorOps.create(10, 20, 0)}
      m.camera.follow(entity)
      entity.position = BGE.Math.VectorOps.create(300, 400, 0)
      m.camera.checkMovement()
      m.assertEqual(300.0, m.camera.position.x)
      m.assertEqual(400.0, m.camera.position.y)
    end function

    @it("applies bounds to the followed position")
    function _()
      m.camera.setBounds(0, 0, 1000, 500)
      entity = {id: "e1", position: BGE.Math.VectorOps.create(5, 5, 0)}
      m.camera.follow(entity)
      m.camera.checkMovement()
      m.assertEqual(100.0, m.camera.position.x)
      m.assertEqual(50.0, m.camera.position.y)
    end function

    @it("stops following once the entity is destroyed")
    function _()
      entity = {id: "e1", position: BGE.Math.VectorOps.create(10, 20, 0)}
      m.camera.follow(entity)
      entity.id = invalid
      entity.position = BGE.Math.VectorOps.create(300, 400, 0)
      m.camera.checkMovement()
      m.assertEqual(10.0, m.camera.position.x)
      m.assertEqual(20.0, m.camera.position.y)
    end function

    @it("stops following after stopFollowing")
    function _()
      entity = {id: "e1", position: BGE.Math.VectorOps.create(10, 20, 0)}
      m.camera.follow(entity)
      m.camera.stopFollowing()
      entity.position = BGE.Math.VectorOps.create(300, 400, 0)
      m.camera.checkMovement()
      m.assertEqual(10.0, m.camera.position.x)
    end function

    @describe("rotate")

    @it("is a no-op - 2d cameras don't rotate")
    function _()
      before = BGE.Math.VectorOps.copy(m.camera.orientation)
      m.camera.rotate(BGE.Math.VectorOps.create(0, 1, 0))
      m.assertTrue(BGE.Math.VectorOps.equals(before, m.camera.orientation))
    end function

    @describe("isInView")

    @it("includes a fudge factor beyond the exact frame edges")
    function _()
      m.camera.computeWorldToCameraMatrix()
      ' Just past the right edge (frameSize.x / 2 = 100) but within the 20% fudge
      m.assertTrue(m.camera.isInView(BGE.Math.VectorOps.create(105, 0, 0)))
    end function

    @it("is false for a point well outside the frame, even with fudge")
    function _()
      m.camera.computeWorldToCameraMatrix()
      m.assertFalse(m.camera.isInView(BGE.Math.VectorOps.create(1000, 0, 0)))
    end function

    @describe("isAnyInView")

    @it("is true for a box that covers the whole view with every corner outside it")
    function _()
      m.camera.computeWorldToCameraMatrix()
      ' view is x -100..100, y -50..50 (plus fudge); these corners are all well beyond it
      corners = [
        BGE.Math.VectorOps.create(-1000, -1000, 0)
        BGE.Math.VectorOps.create(1000, -1000, 0)
        BGE.Math.VectorOps.create(1000, 1000, 0)
        BGE.Math.VectorOps.create(-1000, 1000, 0)
      ]
      m.assertFalse(m.camera.isInView(corners[0]))
      m.assertTrue(m.camera.isAnyInView(corners))
    end function

    @it("is false for a box entirely off to one side of the view")
    function _()
      m.camera.computeWorldToCameraMatrix()
      corners = [
        BGE.Math.VectorOps.create(500, -1000, 0)
        BGE.Math.VectorOps.create(900, 1000, 0)
      ]
      m.assertFalse(m.camera.isAnyInView(corners))
    end function

    @it("is false for no points")
    function _()
      m.camera.computeWorldToCameraMatrix()
      m.assertFalse(m.camera.isAnyInView([]))
    end function

    @describe("checkMovement / projection change")

    ' Camera.onProjectionChange()'s entire behavioural payload on the 2d path is
    ' refreshing isInView's bounds via computeWorldToCameraMatrix() - a frame-size change
    ' is not camera movement, so without that refresh isInView would keep answering from
    ' stale bounds even after checkMovement() runs. Only projectionVersion itself is
    ' asserted anywhere else; this is what actually exercises the refresh.
    @it("refreshes isInView's bounds via checkMovement() when the frame size changes")
    function _()
      m.camera.setFrameSize(100, 100)
      m.camera.checkMovement()
      point = BGE.Math.VectorOps.create(100, 0, 0)
      ' halfW = 50, xFudge = 100 * 0.2 = 20 -> right edge = 70, so x=100 is outside.
      ' Confirmed failing first, so the second assertion isn't vacuous.
      m.assertFalse(m.camera.isInView(point))

      m.camera.setFrameSize(400, 400)
      m.camera.checkMovement()
      ' halfW = 200, xFudge = 400 * 0.2 = 80 -> right edge = 280, so x=100 is now inside.
      m.assertTrue(m.camera.isInView(point))
    end function

    @describe("worldPointToCanvasPoint")

    @it("maps the camera's own position (centered in frame) to the canvas center")
    function _()
      point = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(0, 0, 0))
      ' rounded to an Integer
      m.assertEqual(100, point.x)
      m.assertEqual(50, point.y)
    end function

    @it("rounds to the nearest pixel instead of truncating")
    function _()
      m.camera.computeWorldToCameraMatrix()
      ' exact raster point is (100.6, 50.6): truncating would give (100, 50)
      point = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(0.6, -0.6, 0))
      m.assertEqual(101, point.x)
      m.assertEqual(51, point.y)
    end function

    @it("keeps edge-to-edge points exactly one width apart at a fractional camera offset")
    function _()
      width = 64
      for each offset in [0.00001, 0.3, 0.49999, 0.5, 0.7, 0.99998, 13.37, -7.25]
        m.camera.position = BGE.Math.VectorOps.create(offset, offset, 0)
        m.camera.computeWorldToCameraMatrix()
        left = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(-width, 0, 0))
        right = m.camera.worldPointToCanvasPoint(BGE.Math.VectorOps.create(0, 0, 0))
        m.assertEqual(width, right.x - left.x, "camera offset " + offset.toStr())
      end for
    end function

  end class

end namespace
