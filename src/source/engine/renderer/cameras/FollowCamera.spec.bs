namespace tests

  @suite("BGE.FollowCamera")
  class FollowCameraTests extends rooibos.BaseTestSuite

    game as BGE.Game
    camera as BGE.Camera3d
    target as BGE.GameEntity

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.camera = new BGE.Camera3d()
      m.target = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Target"}))
    end function

    private function assertNear(actual as float, expected as float, message = "" as string)
      m.assertTrue(Abs(actual - expected) < 0.01, `${message} expected ${expected}, got ${actual}`)
    end function

    ' What a scene would do each frame, whichever rig is active
    private sub drive(rig as BGE.FollowCamera, frames as integer)
      for i = 1 to frames
        rig.follow(0.1, {look: BGE.Math.VectorOps.create(0, 0), heading: 1, pitch: 0, bank: 0})
      end for
    end sub

    @describe("swapping rigs")

    @it("drives an OrbitCamera and a ChaseCamera through the same calls")
    function _()
      rig = new BGE.OrbitCamera(m.camera, m.target) as BGE.FollowCamera
      m.drive(rig, 3)
      ' the orbit camera has no look input, so it stays put
      m.assertNear(rig.heading, 0, "orbit heading")

      rig = new BGE.ChaseCamera(m.camera, m.target, {heading: rig.heading}) as BGE.FollowCamera
      m.drive(rig, 100)
      m.assertNear(rig.heading, 1, "chase heading")
      m.assertTrue(rig.target.id = m.target.id, "same target")
    end function

    @it("picks up where the last rig left off with snapBehind")
    function _()
      orbit = new BGE.OrbitCamera(m.camera, m.target)
      orbit.follow(0.5, {look: BGE.Math.VectorOps.create(1, 0)})
      rig = new BGE.ChaseCamera(m.camera, m.target) as BGE.FollowCamera
      rig.snapBehind(orbit.heading)
      m.assertNear(rig.heading, orbit.heading, "heading")
      lookAt = rig.getLookAt()
      m.assertNear(lookAt.x, 0, "look-at x")
    end function

  end class

end namespace
