namespace tests

  @suite("BGE.OrbitCamera")
  class OrbitCameraTests extends rooibos.BaseTestSuite

    game as BGE.Game
    camera as BGE.Camera3d
    target as BGE.GameEntity

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.camera = new BGE.Camera3d()
      m.target = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Target"}))
    end function

    private function assertNear(actual as float, expected as float, message = "" as string)
      m.assertTrue(Abs(actual - expected) < 0.01, `${message} expected ${expected}, got ${actual}`)
    end function

    private function noLook() as BGE.Math.Vector
      return BGE.Math.VectorOps.create(0, 0)
    end function

    @describe("placement")

    @it("starts behind the target at distance and height")
    function _()
      orbit = new BGE.OrbitCamera(m.camera, m.target)
      ' Heading 0 faces -z, so behind is +z
      m.assertNear(m.camera.position.x, 0, "x")
      m.assertNear(m.camera.position.y, 56, "y")
      m.assertNear(m.camera.position.z, 128, "z")
      lookAt = orbit.getLookAt()
      m.assertNear(lookAt.y, 40, "look-at y")
    end function

    @it("takes options and starts behind a turned target")
    function _()
      m.target.rotation.y = BGE.Math.HALF_PI
      m.target.position = BGE.Math.VectorOps.create(10, 0, 0)
      orbit = new BGE.OrbitCamera(m.camera, m.target, {distance: 50, height: 40, lookHeight: 40})
      m.assertNear(orbit.distance, 50)
      ' Facing +x, so the camera is on -x
      m.assertNear(m.camera.position.x, -40, "x")
      m.assertNear(m.camera.position.y, 40, "y")
      m.assertNear(m.camera.position.z, 0, "z")
    end function

    @describe("update")

    @it("orbits with look x and keeps its distance")
    function _()
      orbit = new BGE.OrbitCamera(m.camera, m.target)
      orbit.update(0.5, BGE.Math.VectorOps.create(1, 0))
      m.assertNear(orbit.heading, 1.3)
      forward = BGE.Math.headingForward(1.3)
      m.assertNear(m.camera.position.x, -forward.x * 128, "x")
      m.assertNear(m.camera.position.z, -forward.z * 128, "z")
    end function

    @it("tilts with look y, within its limits")
    function _()
      orbit = new BGE.OrbitCamera(m.camera, m.target)
      orbit.update(0.1, BGE.Math.VectorOps.create(0, -1))
      m.assertNear(orbit.tilt, 0.16)
      restingY = 56.0
      m.assertTrue(m.camera.position.y > restingY, "looking down raises the camera")
      orbit.update(10, BGE.Math.VectorOps.create(0, -1))
      m.assertNear(orbit.tilt, 0.4)
      orbit.update(10, BGE.Math.VectorOps.create(0, 1))
      m.assertNear(orbit.tilt, -0.4)
    end function

    @it("never goes below minHeight above the target")
    function _()
      orbit = new BGE.OrbitCamera(m.camera, m.target, {minTilt: -1.5})
      m.target.position.y = 100
      orbit.update(10, BGE.Math.VectorOps.create(0, 1))
      m.assertNear(m.camera.position.y, 110)
    end function

    @describe("recenter")

    @it("swings back behind the target and levels the tilt")
    function _()
      orbit = new BGE.OrbitCamera(m.camera, m.target)
      orbit.tilt = 0.4
      m.target.rotation.y = 1
      orbit.recenter()
      orbit.update(0.1, m.noLook())
      m.assertNear(orbit.heading, 0.8)
      m.assertNear(orbit.tilt, 0.2)
      m.assertTrue(orbit.isRecentering())
      orbit.update(0.2, m.noLook())
      m.assertNear(orbit.heading, 1)
      m.assertNear(orbit.tilt, 0)
      m.assertFalse(orbit.isRecentering())
    end function

    @it("is cancelled by look input")
    function _()
      orbit = new BGE.OrbitCamera(m.camera, m.target)
      m.target.rotation.y = 2
      orbit.recenter()
      orbit.update(0.1, BGE.Math.VectorOps.create(-0.5, 0))
      m.assertFalse(orbit.isRecentering())
      m.assertNear(orbit.heading, -0.13)
    end function

    @describe("boom")

    @it("pulls in front of a blocker")
    function _()
      wall = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Wall"}))
      wall.position = BGE.Math.VectorOps.create(0, 0, 55)
      collider = wall.addBoxCollider3d("body", 200, 200, 10)
      collider.memberFlags = 2
      ' Level with the look-at point, so the boom pulls straight in along z
      orbit = new BGE.OrbitCamera(m.camera, m.target, {
        height: 40,
        boom: new BGE.CameraBoom(m.game, {probeRadius: 5, minDistance: 10, collidableFlags: 2})
      })
      m.assertNear(m.camera.position.z, 45)
      m.assertTrue(orbit.boom.isBlocked())
    end function

  end class

end namespace
