import "GridWallsCameraBoom.bs"
import "../gridWalls/GridWallsMap.bs"
import "../../Game.bs"

namespace tests

  @suite("BGE.GridWallsCameraBoom")
  class GridWallsCameraBoomTests extends rooibos.BaseTestSuite

    game as BGE.Game
    map as BGE.GridWallsMap

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      ' 100-unit cells; open from x 100 to 200 and z 100 to 300
      m.map = new BGE.GridWallsMap(["###", "#.#", "#.#", "###"], {
        cellSize: 100.0,
        wallHeight: 100.0,
        origin: BGE.Math.VectorOps.create(0, 0, 0),
        solid: {"#": "stone"}
      })
    end function

    private function makeBoom(args = {} as roAssociativeArray) as BGE.GridWallsCameraBoom
      args.probeRadius = 5.0
      args.minDistance = 10.0
      return new BGE.GridWallsCameraBoom(m.game, m.map, args)
    end function

    private function assertNear(actual as float, expected as float, message = "" as string)
      m.assertTrue(Abs(actual - expected) < 0.01, `${message} expected ${expected}, got ${actual}`)
    end function

    @describe("update")

    @it("keeps the wanted position when the grid is open to it")
    function _()
      boom = m.makeBoom({stepLength: 10.0})
      position = boom.update(BGE.Math.VectorOps.create(150, 0, 150), BGE.Math.VectorOps.create(150, 0, 200), 0.016)
      m.assertNear(position.z, 200)
      m.assertFalse(boom.isBlocked())
    end function

    @it("stops one step short of where the probe enters a solid cell")
    function _()
      boom = m.makeBoom({stepLength: 10.0})
      ' Samples every 10 units: at 150 along (z 300) the probe is in the wall row
      position = boom.update(BGE.Math.VectorOps.create(150, 0, 150), BGE.Math.VectorOps.create(150, 0, 450), 0.016)
      m.assertNear(position.z, 290)
      m.assertTrue(boom.isBlocked())
    end function

    @it("takes stepLength from args, defaulting to 8")
    function _()
      boom = m.makeBoom({stepLength: 100.0})
      m.assertEqual(boom.stepLength, 100.0)
      position = boom.update(BGE.Math.VectorOps.create(150, 0, 150), BGE.Math.VectorOps.create(150, 0, 450), 0.016)
      m.assertNear(position.z, 250)
      boom = m.makeBoom()
      m.assertEqual(boom.stepLength, 8.0)
      position = boom.update(BGE.Math.VectorOps.create(150, 0, 150), BGE.Math.VectorOps.create(150, 0, 450), 0.016)
      m.assertNear(position.z, 294)
    end function

    @it("treats outside the grid as solid")
    function _()
      m.map = new BGE.GridWallsMap(["..", ".."], {
        cellSize: 100.0,
        wallHeight: 100.0,
        origin: BGE.Math.VectorOps.create(0, 0, 0),
        solid: {"#": "stone"}
      })
      boom = m.makeBoom({stepLength: 10.0})
      position = boom.update(BGE.Math.VectorOps.create(50, 0, 50), BGE.Math.VectorOps.create(50, 0, 450), 0.016)
      m.assertNear(position.z, 190)
    end function

    @it("never comes closer than minDistance")
    function _()
      boom = m.makeBoom({stepLength: 10.0})
      ' Looking at a point just inside the wall: blocked at once
      position = boom.update(BGE.Math.VectorOps.create(150, 0, 296), BGE.Math.VectorOps.create(150, 0, 450), 0.016)
      m.assertNear(position.z, 306)
    end function

  end class

end namespace
