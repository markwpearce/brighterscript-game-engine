import "../../../math/vector.bs"
import "../../GameEntity.bs"
import "Camera3d.bs"

namespace BGE

  ' What a game passes to FollowCamera.follow() each frame. Each camera reads only the fields
  ' it uses, so one input can drive whichever camera is active.
  interface FollowCameraInput extends roAssociativeArray
    ' BGE.OrbitCamera: x orbits, y tilts, each -1..1 (e.g. the right stick)
    optional look as BGE.Math.Vector
    ' BGE.ChaseCamera: the target's heading, radians (defaults to its rotation.y, read as a
    ' heading, as OrbitCamera does: pass it for a model built facing +z)
    optional heading as float
    ' BGE.ChaseCamera: the target's pitch, radians, positive nose up
    optional pitch as float
    ' BGE.ChaseCamera: the target's bank, radians
    optional bank as float
  end interface

  ' A camera rig that moves a Camera3d to follow a target entity: BGE.OrbitCamera and
  ' BGE.ChaseCamera. Type a field as this to swap rigs without changing the scene's code:
  '
  '   m.rig = new BGE.ChaseCamera(camera, m.player, {heading: m.rig.heading})
  '   m.rig.follow(dt, {look: look, heading: heading, pitch: pitch, bank: bank})
  interface FollowCamera
    camera as BGE.Camera3d
    target as BGE.GameEntity
    ' Ground heading the camera looks along (0 faces -z, increasing turns clockwise seen from above)
    heading as float

    ' Moves the camera for this frame. Call it after everything has moved, e.g. in onPostUpdate().
    '
    ' @param {float} dt - seconds since last frame
    ' @param {BGE.FollowCameraInput} input - each camera reads the fields it uses
    sub follow(dt as float, input as BGE.FollowCameraInput)

    ' Puts the camera straight behind the target, looking along `heading`, with no easing, e.g.
    ' after a respawn or when switching to this camera.
    '
    ' @param {float} heading - radians
    sub snapBehind(heading as float)

    ' The point on the target the camera is framed round.
    '
    ' @return {BGE.Math.Vector}
    function getLookAt() as BGE.Math.Vector
  end interface

end namespace
