namespace tests

  ' Camera is the base class for Camera2d/Camera3d - covers the shared
  ' per-frame dirty-checking (checkMovement/movedLastFrame, the same pattern
  ' MotionChecker uses for entities) and default frustum/projection behavior.
  @suite("BGE.Camera")
  class CameraTests extends rooibos.BaseTestSuite

    camera as BGE.Camera

    protected override function beforeEach()
      m.camera = new BGE.Camera()
    end function

    @describe("checkMovement / movedLastFrame")

    @it("is considered moved the first time checkMovement is called after a real position change")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(10, 20, 30)
      m.camera.checkMovement()
      m.assertTrue(m.camera.movedLastFrame())
    end function

    @it("stops reporting moved once position/orientation stabilize for a frame")
    function _()
      m.camera.position = BGE.Math.VectorOps.create(10, 20, 30)
      m.camera.checkMovement()
      m.assertTrue(m.camera.movedLastFrame())

      m.camera.checkMovement()
      m.assertFalse(m.camera.movedLastFrame())
    end function

    @describe("isInView")

    @it("is true for a point within the frame bounds")
    function _()
      m.camera.setFrameSize(100, 100)
      m.assertTrue(m.camera.isInView(BGE.Math.VectorOps.create(50, 50, 0)))
    end function

    @it("is false for a point outside the frame bounds")
    function _()
      m.camera.setFrameSize(100, 100)
      m.assertFalse(m.camera.isInView(BGE.Math.VectorOps.create(150, 50, 0)))
    end function

    @describe("default (identity) projection behavior")

    @it("distanceFromCameraFront returns the point's z")
    function _()
      m.assertEqual(42.0, m.camera.distanceFromCameraFront(BGE.Math.VectorOps.create(0, 0, 42)))
    end function

    @it("worldPointToCanvasPoint is the identity transform")
    function _()
      point = BGE.Math.VectorOps.create(1, 2, 3)
      m.assertTrue(BGE.Math.VectorOps.equals(point, m.camera.worldPointToCanvasPoint(point)))
    end function

    @it("getDrawMode defaults to directToCamera")
    function _()
      m.assertEqual(BGE.SceneObjectDrawMode.directToCamera, m.camera.getDrawMode())
    end function

    @describe("projectionVersion")

    ' isInView and the projection matrix are derived from frame size, but Camera's
    ' MotionChecker only watches position and orientation - so a frame-size change is
    ' invisible to every "did anything change?" check in the renderer. See issue #48.
    @it("starts at zero")
    function _()
      m.assertEqual(0, m.camera.projectionVersion)
    end function

    @it("bumps when the frame size changes")
    function _()
      m.camera.setFrameSize(100, 100)
      m.camera.checkMovement()
      before = m.camera.projectionVersion

      m.camera.setFrameSize(200, 100)
      m.camera.checkMovement()
      m.assertTrue(m.camera.projectionVersion > before)
    end function

    @it("holds steady when nothing about the projection changed")
    function _()
      m.camera.setFrameSize(100, 100)
      m.camera.checkMovement()
      before = m.camera.projectionVersion

      m.camera.checkMovement()
      m.assertEqual(before, m.camera.projectionVersion)
    end function

    @it("bumps on demand via bumpProjectionVersion")
    function _()
      before = m.camera.projectionVersion
      m.camera.bumpProjectionVersion()
      m.assertTrue(m.camera.projectionVersion > before)
    end function

    @describe("zoom")

    @it("starts at 1")
    function _()
      m.assertEqual(m.camera.getEffectiveZoom(), 1.0)
    end function

    @it("clamps a zero, negative or huge zoom")
    function _()
      m.camera.zoom = 0
      m.assertEqual(m.camera.getEffectiveZoom(), BGE.CAMERA_MIN_ZOOM)
      m.camera.zoom = -2
      m.assertEqual(m.camera.getEffectiveZoom(), BGE.CAMERA_MIN_ZOOM)
      m.camera.zoom = 1000
      m.assertEqual(m.camera.getEffectiveZoom(), BGE.CAMERA_MAX_ZOOM)
    end function

    @it("bumps projectionVersion when it changes")
    function _()
      m.camera.setFrameSize(100, 100)
      m.camera.checkMovement()
      before = m.camera.projectionVersion

      m.camera.zoom = 2
      m.camera.checkMovement()
      m.assertTrue(m.camera.projectionVersion > before)

      before = m.camera.projectionVersion
      m.camera.checkMovement()
      m.assertEqual(m.camera.projectionVersion, before)
    end function

    @describe("zoomTo")

    @it("eases in log space and lands exactly on the target")
    function _()
      m.camera.zoomTo(4, 1, BGE.Tweens.Easing.LinearTween)
      m.assertTrue(m.camera.isZooming())
      for i = 1 to 5
        m.camera.advanceZoom(0.1)
      end for
      ' half way through a linear ease from 1 to 4 in log space is 2, not 2.5
      m.assertTrue(Abs(m.camera.zoom - 2) < 0.001, `half way: ${m.camera.zoom}`)
      for i = 1 to 5
        m.camera.advanceZoom(0.1)
      end for
      m.assertEqual(m.camera.zoom, 4.0)
      m.assertFalse(m.camera.isZooming())
    end function

    @it("snaps with 0 seconds")
    function _()
      m.camera.zoomTo(2, 0)
      m.assertEqual(m.camera.zoom, 2.0)
      m.assertFalse(m.camera.isZooming())
    end function

    @it("clamps the target")
    function _()
      m.camera.zoomTo(0, 0)
      m.assertEqual(m.camera.zoom, BGE.CAMERA_MIN_ZOOM)
    end function

    @it("steps at most 0.1 seconds at a time")
    function _()
      m.camera.zoomTo(4, 1, BGE.Tweens.Easing.LinearTween)
      m.camera.advanceZoom(5)
      m.assertTrue(m.camera.isZooming())
      m.assertTrue(m.camera.zoom < 1.2, `${m.camera.zoom}`)
    end function

    @it("is cancelled by writing zoom directly")
    function _()
      m.camera.zoomTo(4, 1)
      m.camera.advanceZoom(0.1)
      m.camera.zoom = 3
      m.camera.advanceZoom(0.1)
      m.assertEqual(m.camera.zoom, 3)
      m.assertFalse(m.camera.isZooming())
    end function

    @it("stops where it is with stopZooming")
    function _()
      m.camera.zoomTo(4, 1)
      m.camera.advanceZoom(0.1)
      reached = m.camera.zoom
      m.camera.stopZooming()
      m.camera.advanceZoom(0.1)
      m.assertEqual(m.camera.zoom, reached)
      m.assertFalse(m.camera.isZooming())
    end function

    @it("starts a new zoom from where the last one had got to")
    function _()
      m.camera.zoomTo(4, 1, BGE.Tweens.Easing.LinearTween)
      for i = 1 to 5
        m.camera.advanceZoom(0.1)
      end for
      m.camera.zoomTo(1, 1, BGE.Tweens.Easing.LinearTween)
      m.camera.advanceZoom(0.1)
      m.assertTrue(m.camera.zoom < 2 and m.camera.zoom > 1.8, `${m.camera.zoom}`)
    end function

  end class

end namespace
