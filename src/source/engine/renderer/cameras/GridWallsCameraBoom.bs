import "../../../math/math.bs"
import "../../../math/vector.bs"
import "../gridWalls/GridWallsMap.bs"
import "CameraBoom.bs"

namespace BGE

  ' A camera boom for grid walls (BGE.GridWallsMap): it pulls in by marching through the grid
  ' toward the camera, rather than raycasting colliders, so the walls need no colliders and cost
  ' no per-frame collision checks.
  '
  '   map = new BGE.GridWallsMap(rows, {cellSize: 192, wallHeight: 128, origin: corner, solid: {"#": "stone"}})
  '   boom = new BGE.GridWallsCameraBoom(m.game, map, {probeRadius: 10, minDistance: 25})
  '
  ' Override isBlockedAt() to block on something besides the map's solid cells.
  class GridWallsCameraBoom extends BGE.CameraBoom

    ' How far apart (world units) the march samples the line to the camera. Keep it well under
    ' the map's cellSize so a step can't jump a wall.
    stepLength as float = 8.0

    protected map as BGE.GridWallsMap

    ' @param {BGE.Game} game
    ' @param {BGE.GridWallsMap} map - the walls that block the camera
    ' @param {roAssociativeArray} args - CameraBoom's fields, and stepLength
    sub new(game as BGE.Game, map as BGE.GridWallsMap, args = {} as roAssociativeArray)
      super(game, args)
      m.map = map
      ' set after super(), which can't see this class's fields
      if invalid <> args.stepLength
        m.stepLength = args.stepLength
      end if
    end sub

    ' The farthest the camera can be along `direction` before its probe square enters a solid
    ' cell: one step short of the first blocked sample.
    protected override function unblockedDistance(lookAt as BGE.Math.Vector, direction as BGE.Math.Vector, wanted as float) as float
      allowed = wanted
      distance = 0.0
      while distance < wanted + m.stepLength
        along = BGE.Math.Min(distance, wanted)
        if m.isBlockedAt(lookAt.x + direction.x * along, lookAt.z + direction.z * along)
          allowed = along - m.stepLength
          exit while
        end if
        distance += m.stepLength
      end while
      return BGE.Math.Clamp(allowed, BGE.Math.Min(m.minDistance, wanted), wanted)
    end function

    ' Whether a probeRadius square round (x, z) touches a solid cell.
    '
    ' @param {float} x
    ' @param {float} z
    ' @return {boolean}
    protected function isBlockedAt(x as float, z as float) as boolean
      r = m.probeRadius
      for each corner in [[x - r, z - r], [x + r, z - r], [x - r, z + r], [x + r, z + r]]
        cell = m.map.cellAt(corner[0], corner[1])
        if m.map.isSolid(cell.col, cell.row)
          return true
        end if
      end for
      return false
    end function

  end class

end namespace
