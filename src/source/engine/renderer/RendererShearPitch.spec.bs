import "../../math/vector.bs"
import "../Game.bs"
import "cameras/Camera3d.bs"
import "ImpostorFit.bs"
import "Renderer.bs"
import "RendererHelpers.bs"

namespace tests

  ' Drawing through a Camera3d with pitchMode "shear": everything lands where the camera
  ' projects it. 1280 x 720, 90 degree FOV (focal 640), eye at (0, 50, 0), looking 20 degrees
  ' down -z, so the image is moved up by 640 tan(20) = 233 px.
  @suite("BGE.Renderer - shear pitch")
  class RendererShearPitchTests extends rooibos.BaseTestSuite

    private game as BGE.Game
    private renderer as BGE.Renderer
    private camera as BGE.Camera3d
    private target as roBitmap

    protected override sub beforeEach()
      m.game = new BGE.Game(1280, 720)
      m.camera = new BGE.Camera3d()
      m.camera.fieldOfViewDegrees = 90
      m.camera.maxDrawDistance = 2000
      m.camera.pitchMode = BGE.CameraPitchMode.shear
      m.camera.position = BGE.Math.VectorOps.create(0, 50, 0)
      pitch = BGE.Math.DegreesToRadians(-20)
      m.camera.orientation = BGE.Math.VectorOps.create(0, sin(pitch), -cos(pitch))
      m.camera.drawDistanceFadeFraction = 0
      m.camera.drawDistanceTransitionSeconds = 0
      m.target = CreateObject("roBitmap", {width: 1280, height: 720, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.target, m.game, m.camera)
      m.renderer.setupCameraForFrame()
    end sub

    private function pixelAt(x as integer, y as integer) as integer
      bytes = m.target.GetByteArray(x, y, 1, 1)
      return (bytes[0] << 24) + (bytes[1] << 16) + (bytes[2] << 8) + bytes[3]
    end function

    @describe("column-drawn quads")

    @it("draws a textured quad where the camera projects its corners")
    function _()
      v = BGE.Math.VectorOps.create
      ' a 100 x 100 upright quad 300 ahead
      corners = [v(-50, 100, -300), v(50, 100, -300), v(-50, 0, -300), v(50, 0, -300)]
      bitmap = CreateObject("roBitmap", {width: 16, height: 16, alphaEnable: true})
      bitmap.Clear(&hFF0000FF)
      texture = {id: "red", region: CreateObject("roRegion", bitmap, 0, 0, 16, 16)}
      m.target.Clear(&h00000000)
      m.renderer.drawTexturedQuadTo(m.target, corners, texture)
      top = m.camera.worldPointToCanvasPoint(corners[0])
      bottom = m.camera.worldPointToCanvasPoint(corners[3])
      middleY = (top.y + bottom.y) \ 2
      m.assertEqual(&hFF0000FF, m.pixelAt(640, middleY))
      m.assertEqual(0, m.pixelAt(640, top.y - 8))
      m.assertEqual(0, m.pixelAt(640, bottom.y + 8))
    end function

    @describe("impostors")

    @it("puts the moved image centre in the impostor basis")
    function _()
      m.camera.computeWorldToCameraMatrix()
      basis = BGE.ImpostorFit.basisFromView(m.camera.worldToCamera, m.camera.position, 640, 1280, 720, m.camera.getPitchShiftY())
      m.assertTrue(abs(basis[14] - m.camera.getPrincipalY()) < 0.001)
    end function

  end class

end namespace
