import "../../../math/vector.bs"

namespace BGE

  ' One wall of a BGE.DrawableWalls: an upright quad between two floor points, in world space.
  ' Make them with BGE.createWallSegment().
  interface WallSegment
    ax as float
    az as float
    bx as float
    bz as float
    bottom as float
    top as float
    ' Texture name (a key of DrawableWalls.textures)
    texture as string
    ' World units one texture copy covers along the wall, or 0 to stretch it over the wall
    tileWidth as float
    ' Texture copies stacked up the wall
    tileCount as integer
    ' The side a one-sided wall is seen from (unit, on the floor plane)
    normalX as float
    normalZ as float
    twoSided as boolean
    length as float
  end interface

  interface WallSegmentOptions
    ' World units one texture copy covers along the wall; 0 (default) stretches it
    optional tileWidth as float
    ' World units one texture copy covers up the wall, rounded so a whole number fit; 0
    ' (default) stretches it
    optional tileHeight as float
    ' Seen from both sides (default false: only from the left of start -> end, looking down)
    optional twoSided as boolean
  end interface

  ' A wall from `startPoint` to `endPoint` on the floor (x and z), from height `bottom` to `top`.
  ' One-sided walls face the left of start -> end seen from above, with -z forward (a wall
  ' from x=0 to x=1 at z=0 faces -z), so list a room's walls clockwise to face inwards.
  '
  ' @param {BGE.Math.Vector} startPoint
  ' @param {BGE.Math.Vector} endPoint
  ' @param {float} bottom
  ' @param {float} top
  ' @param {string} texture texture name
  ' @param {BGE.WallSegmentOptions} [options]
  ' @return {BGE.WallSegment}
  function createWallSegment(startPoint as BGE.Math.Vector, endPoint as BGE.Math.Vector, bottom as float, top as float, texture as string, options = {} as BGE.WallSegmentOptions) as BGE.WallSegment
    ax = startPoint.x
    az = startPoint.z ?? 0
    bx = endPoint.x
    bz = endPoint.z ?? 0
    dx = bx - ax
    dz = bz - az
    length = sqr(dx * dx + dz * dz)
    normalX = 0.0
    normalZ = 0.0
    if length > 0
      normalX = dz / length
      normalZ = -dx / length
    end if
    tileCount = 1
    tileHeight = options.tileHeight ?? 0
    if tileHeight > 0
      tileCount = cint((top - bottom) / tileHeight)
      if tileCount < 1
        tileCount = 1
      end if
    end if
    return {
      ax: ax,
      az: az,
      bx: bx,
      bz: bz,
      bottom: bottom,
      top: top,
      texture: texture,
      tileWidth: options.tileWidth ?? 0.0,
      tileCount: tileCount,
      normalX: normalX,
      normalZ: normalZ,
      twoSided: options.twoSided ?? false,
      length: length
    }
  end function

end namespace
