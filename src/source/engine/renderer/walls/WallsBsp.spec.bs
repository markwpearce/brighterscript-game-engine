import "WallSegment.bs"
import "WallsBsp.bs"
import "../../../math/vector.bs"

namespace tests

  @suite("BGE.WallsBsp")
  class WallsBspTests extends rooibos.BaseTestSuite

    private function wall(ax as float, az as float, bx as float, bz as float) as BGE.WallSegment
      return BGE.createWallSegment(BGE.Math.VectorOps.create(ax, 0, az), BGE.Math.VectorOps.create(bx, 0, bz), 0, 100, "stone", {twoSided: true})
    end function

    private function collect(bsp as BGE.WallsBsp, ox as float, oz as float) as integer[]
      order = [] as integer[]
      bsp.collect(ox, oz, order)
      return order
    end function

    @describe("WallsBsp.collect")

    @it("lists every part, nearest first from either side")
    function _()
      bsp = new BGE.WallsBsp([m.wall(100, -300, -100, -300), m.wall(100, -100, -100, -100)])
      order = m.collect(bsp, 0, 0)
      m.assertEqual(2, order.count())
      m.assertEqual(1, bsp.partSegment[order[0]])
      m.assertEqual(0, bsp.partSegment[order[1]])
      order = m.collect(bsp, 0, -500)
      m.assertEqual(0, bsp.partSegment[order[0]])
      m.assertEqual(1, bsp.partSegment[order[1]])
    end function

    @it("puts a pillar in front of a long wall whose nearest point is closer")
    function _()
      longWall = BGE.createWallSegment(BGE.Math.VectorOps.create(100, 0, 0), BGE.Math.VectorOps.create(100, 0, -1000), 0, 100, "stone")
      pillar = BGE.createWallSegment(BGE.Math.VectorOps.create(90, 0, -250), BGE.Math.VectorOps.create(60, 0, -250), 0, 100, "stone")
      bsp = new BGE.WallsBsp([longWall, pillar])
      order = m.collect(bsp, 0, 0)
      m.assertEqual(1, bsp.partSegment[order[0]])
    end function

    @it("splits a wall that crosses another's line, keeping its span")
    function _()
      bsp = new BGE.WallsBsp([m.wall(100, -200, -100, -200), m.wall(0, -100, 0, -300)])
      m.assertEqual(3, bsp.partSegment.count())
      total = 0.0
      for k = 0 to bsp.partSegment.count() - 1
        if bsp.partSegment[k] = 1
          total += bsp.partEnd[k] - bsp.partStart[k]
        end if
      end for
      m.assertTrue(abs(total - 1) < 0.0001)
    end function

    @it("is empty with no walls")
    function _()
      bsp = new BGE.WallsBsp([])
      m.assertEqual(0, m.collect(bsp, 0, 0).count())
    end function

  end class

end namespace
