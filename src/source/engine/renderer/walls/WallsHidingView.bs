import "../../../math/vector.bs"
import "../gridWalls/GridWallsSpan.bs"

namespace BGE

  ' What the renderer asks of a walls view (GridWallsView or WallsView) to hide objects and
  ' overlays behind walls.
  class WallsHidingView

    rayCount as integer = 0
    hideTolerance as float = 0

    ' Fills `out` with the rays covering a set of world points.
    function findSpan(points as BGE.Math.Vector[], out as BGE.GridWallsSpan) as boolean
      out.valid = false
      return false
    end function

    ' Forward depth from which ray i is wholly covered, or 1e30.
    function getDepth(i as integer) as float
      return 1.0e30
    end function

    ' Forward depth of the nearest wall on ray i, or 1e30.
    function getNearestDepth(i as integer) as float
      return 1.0e30
    end function

    function isPointHidden(point as BGE.Math.Vector) as boolean
      return false
    end function

  end class

end namespace
