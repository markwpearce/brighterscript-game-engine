namespace tests

  ' Renderer wraps an ifDraw2D surface. Constructing one just needs a real
  ' bitmap (no Game required) - a real Game is only needed here to get a
  ' Drawable to attach to a SceneObject for the addSceneObject/
  ' removeSceneObject tests.
  @suite("BGE.Renderer")
  class RendererTests extends rooibos.BaseTestSuite

    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap)
    end function

    @describe("getCanvasSize / getCanvasCenter")

    @it("reports the underlying draw2d surface's dimensions")
    function _()
      size = m.renderer.getCanvasSize()
      m.assertEqual(200.0, size.x)
      m.assertEqual(100.0, size.y)
    end function

    @it("getCanvasCenter is half the canvas size")
    function _()
      center = m.renderer.getCanvasCenter()
      m.assertEqual(100.0, center.x)
      m.assertEqual(50.0, center.y)
    end function

    @describe("getCircleResource")

    @it("is invalid before the first call, since it's rasterized lazily")
    function _()
      m.assertInvalid(m.renderer.resources.circle)
    end function

    @it("rasterizes and caches the circle resource on first call, for DrawableCircle/DrawableSphere to blit as a texture")
    function _()
      resource = m.renderer.getCircleResource()
      m.assertNotInvalid(resource)
      m.assertEqual(BGE.RendererResourceSize, resource.getWidth())
      m.assertEqual(BGE.RendererResourceSize, resource.getHeight())
    end function

    @describe("drawCircle")

    @it("draws when the circle is within the canvas bounds")
    function _()
      m.assertTrue(m.renderer.drawCircle(100, 50, 20, BGE.Colors.White))
    end function

    @it("counts as one draw call")
    function _()
      ' Warmed up first - building the lazy circle resource (see getCircleResource())
      ' involves its own internal draw calls, which would otherwise inflate this count.
      m.renderer.getCircleResource()
      m.renderer.resetDrawCallCounter()
      m.renderer.drawCircle(100, 50, 20, BGE.Colors.White)
      m.assertEqual(1, m.renderer.getDrawCallsLastFrame())
    end function

    @it("does not draw when entirely outside the canvas")
    function _()
      m.assertFalse(m.renderer.drawCircle(-1000, -1000, 20, BGE.Colors.White))
    end function

    @describe("depth sort skipping")

    @it("does not re-sort when nothing has moved")
    function _()
      entityA = new BGE.GameEntity(new BGE.Game(320, 240), {name: "A"})
      rectA = new BGE.DrawableRectangle(entityA, 20, 20)
      sceneObjA = rectA.addToScene(m.renderer)
      entityA.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()

      ' Nothing moved between these two calls - the array should be the exact
      ' same objects in the exact same order both times, and (per the fix)
      ' sortBy should not even run the second time.
      m.renderer.setupCameraForFrame()
      countBefore = m.renderer.getSceneObjectCount()
      m.renderer.drawScene()
      m.assertEqual(countBefore, m.renderer.getSceneObjectCount())
      m.assertFalse(m.renderer.didSortLastFrame())
    end function

    @it("does re-sort when the camera moved")
    function _()
      entityA = new BGE.GameEntity(new BGE.Game(320, 240), {name: "A"})
      rectA = new BGE.DrawableRectangle(entityA, 20, 20)
      rectA.addToScene(m.renderer)
      entityA.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()

      m.renderer.camera.position.z += 10
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()
      m.assertTrue(m.renderer.didSortLastFrame())
    end function

    @it("keeps the previous relative order for two objects at the same depth, even after other objects change")
    function _()
      gameA = new BGE.Game(320, 240)
      entityFar = new BGE.GameEntity(gameA, {name: "Far"})
      entityFar.position = BGE.Math.VectorOps.create(0, 0, 100)
      entityTie1 = new BGE.GameEntity(gameA, {name: "Tie1"})
      entityTie1.position = BGE.Math.VectorOps.create(-10, 0, 0)
      entityTie2 = new BGE.GameEntity(gameA, {name: "Tie2"})
      entityTie2.position = BGE.Math.VectorOps.create(10, 0, 0)

      rectFar = new BGE.DrawableRectangle(entityFar, 20, 20)
      rectTie1 = new BGE.DrawableRectangle(entityTie1, 20, 20)
      rectTie2 = new BGE.DrawableRectangle(entityTie2, 20, 20)
      rectFar.addToScene(m.renderer)
      sceneObjTie1 = rectTie1.addToScene(m.renderer)
      sceneObjTie2 = rectTie2.addToScene(m.renderer)

      for each entity in [entityFar, entityTie1, entityTie2]
        entity.updateTransformationMatrix()
      end for
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()
      orderBefore = [sceneObjTie1.id, sceneObjTie2.id]

      ' Move only the far object - the two tied objects never move, so their
      ' relative order must not change even though a sort runs again.
      entityFar.position.z += 50
      entityFar.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()

      tie1Index = m.renderer.getSceneObjectIndexById(sceneObjTie1.id)
      tie2Index = m.renderer.getSceneObjectIndexById(sceneObjTie2.id)
      if orderBefore[0] = sceneObjTie1.id
        m.assertTrue(tie1Index < tie2Index)
      else
        m.assertTrue(tie2Index < tie1Index)
      end if
    end function

    @describe("default camera")

    @it("creates a Camera2d sized to the canvas when none is provided")
    function _()
      m.assertEqual("Camera2d", m.renderer.camera.name)
    end function

    @it("worldPointToCanvasPoint delegates to the camera")
    function _()
      ' The default camera is centered on the canvas, so the point directly
      ' beneath the camera (world (100,50)) should land on the canvas center.
      point = m.renderer.worldPointToCanvasPoint(BGE.Math.VectorOps.create(100, 50, 0))
      m.assertEqual(100, point.x)
      m.assertEqual(50, point.y)
    end function

    @describe("isInsideCanvas")

    @it("is true for a rectangle fully within the canvas")
    function _()
      m.assertTrue(m.renderer.isInsideCanvas(m.bitmap, 10, 10, 50, 50))
    end function

    @it("is true for a rectangle straddling the canvas edge")
    function _()
      m.assertTrue(m.renderer.isInsideCanvas(m.bitmap, -10, -10, 50, 50))
    end function

    @it("is false for a rectangle entirely outside the canvas")
    function _()
      m.assertFalse(m.renderer.isInsideCanvas(m.bitmap, 1000, 1000, 50, 50))
    end function

    @describe("isBoundingBoxOutsideCanvas")

    @it("is false for points inside the canvas")
    function _()
      points = [BGE.Math.VectorOps.create(10, 10, 0), BGE.Math.VectorOps.create(50, 50, 0)]
      m.assertFalse(m.renderer.isBoundingBoxOutsideCanvas(points))
    end function

    @it("is false when the bounding box only partially overlaps the canvas")
    function _()
      points = [BGE.Math.VectorOps.create(-50, -50, 0), BGE.Math.VectorOps.create(10, 10, 0)]
      m.assertFalse(m.renderer.isBoundingBoxOutsideCanvas(points))
    end function

    @it("is true for points entirely outside the canvas")
    function _()
      points = [BGE.Math.VectorOps.create(1000, 1000, 0), BGE.Math.VectorOps.create(1050, 1050, 0)]
      m.assertTrue(m.renderer.isBoundingBoxOutsideCanvas(points))
    end function

    @it("is false for an empty points array")
    function _()
      m.assertFalse(m.renderer.isBoundingBoxOutsideCanvas([]))
    end function

    @describe("addSceneObject / removeSceneObject")

    @it("assigns each added scene object an incrementing id")
    function _()
      game = new BGE.Game(160, 90)
      entity = new BGE.GameEntity(game, {name: "TestEntity"})
      drawable = new BGE.Drawable(entity)

      first = new BGE.SceneObject("first", drawable, BGE.SceneObjectType.Line)
      second = new BGE.SceneObject("second", drawable, BGE.SceneObjectType.Line)
      m.renderer.addSceneObject(first)
      m.renderer.addSceneObject(second)

      m.assertEqual("0", first.id)
      m.assertEqual("1", second.id)
    end function

    @it("removeSceneObject clears the removed object's id")
    function _()
      game = new BGE.Game(160, 90)
      entity = new BGE.GameEntity(game, {name: "TestEntity"})
      drawable = new BGE.Drawable(entity)

      sceneObj = new BGE.SceneObject("only", drawable, BGE.SceneObjectType.Line)
      m.renderer.addSceneObject(sceneObj)
      m.renderer.removeSceneObject(sceneObj)

      m.assertEqual("", sceneObj.id)
    end function

    @describe("getOverlapClusters")

    @it("reports every scene object in its own cluster when nothing overlaps")
    function _()
      entityA = new BGE.GameEntity(new BGE.Game(320, 240), {name: "A"})
      entityA.position = BGE.Math.VectorOps.create(-200, 0, 0)
      rectA = new BGE.DrawableRectangle(entityA, 20, 20)
      rectA.addToScene(m.renderer)
      entityA.updateTransformationMatrix()
      m.renderer.setupCameraForFrame()
      m.renderer.drawScene()

      m.assertEqual(1, m.renderer.getOverlapClusters().count())
    end function

  end class

end namespace
