namespace BGE

  ' Numeric bands for controller-originated buttonCodes (see BGE.Controller.
  ' ControllerRegistry/Game.drainControllerInput, which construct these) -
  ' deliberately far above the remote's own 0-99 (press) / 100-999 (release) /
  ' 1000+ (held) ranges (see the button-code table below) so a controller
  ' event's code can never be misclassified as a remote one. A controller
  ' button's identity is a name, not a code (see `explicitButtonName` below) -
  ' these bands exist only to classify press/release/held, so every
  ' controller-originated GameInput uses the band's base value as-is.
  const CONTROLLER_BUTTON_CODE_PRESS_BASE = 100000
  const CONTROLLER_BUTTON_CODE_RELEASE_BASE = 200000
  const CONTROLLER_BUTTON_CODE_HELD_BASE = 300000

  ' Class that contains all information about the current input during a given frame from the remote
  '   @example
  '   ' -------Button Code Reference--------
  ' 	' Button  Pressed Released  Held
  '   ' ------------------------------
  ' 	' Back         0      100   1000
  ' 	' Up           2      102   1002
  ' 	' Down         3      103   1003
  ' 	' Left         4      104   1004
  ' 	' Right        5      105   1005
  ' 	' OK           6      106   1006
  ' 	' Replay       7      107   1007
  ' 	' Rewind       8      108   1008
  ' 	' FastForward  9      109   1009
  ' 	' Options     10      110   1010
  ' 	' Play        13      113   1013
  class GameInput

    ' The name of the button associated with the current input
    button as string
    ' The code for the input
    buttonCode as integer
    ' Was the button pressed since the last frame
    press as boolean = false
    ' Was the button held down since last frame
    held as boolean = false
    ' Was the button released this frame
    release as boolean = false
    ' How many milliseconds was the current input held for
    heldTimeMs as integer = 0

    ' Which controller this input came from - -1 for the physical remote,
    ' 0+ for a connected browser controller (see BGE.Controller.ControlMap).
    playerIndex as integer = -1

    ' Set by a UiWidget/UiContainer that acted on this event - once set, the
    ' owning UiContainer stops this event from also reaching GameEntity.onInput()
    ' for the rest of this frame (see Game.setInputEntity()).
    consumed as boolean = false

    ' Set by BGE.UI.FocusManager.update() the first time it processes this
    ' exact GameInput instance - the same instance can reach more than one
    ' focusEnabled UiContainer in one dispatch (an outer container broadcasts
    ' onInput() to a nested container before running its own focus-chain
    ' update), and this guards against double-processing the same event.
    focusVisited as boolean = false

    ' Current horizontal directional input: left -> -1, right -> 1
    x as float = 0
    ' Current vertical directional input, in world space (+y is up, matching
    ' the engine's world coordinate convention - the renderer flips this when
    ' projecting to raster/canvas space): up -> 1, down -> -1
    y as float = 0


    ' Creates a GameInput object based on the buttonCode.
    ' A controller-originated event passes playerIndex/explicitButtonName -
    ' see BGE.Controller.ControlMap, which is the normal way to consume
    ' controller input rather than constructing this directly.
    '
    ' @param {integer} buttonCode - button to use for the data
    ' @param {integer} heldTimeMs - how long was this button held for
    ' @param {integer} [playerIndex=-1] - -1 for the remote, 0+ for a controller
    ' @param {string} [explicitButtonName=invalid] - overrides buttonNameFromCode, used for controller buttons
    sub new(buttonCode as integer, heldTimeMs as integer, playerIndex = -1 as integer, explicitButtonName = invalid as dynamic)
      m.buttonCode = buttonCode
      m.playerIndex = playerIndex
      if explicitButtonName <> invalid
        ' Controller-originated: buttonCode uses the CONTROLLER_BUTTON_CODE_*
        ' bands above, not the remote's 0-99/100-999/1000+ ranges.
        m.button = explicitButtonName
        m.press = buttonCode >= CONTROLLER_BUTTON_CODE_PRESS_BASE and buttonCode < CONTROLLER_BUTTON_CODE_RELEASE_BASE
        m.release = buttonCode >= CONTROLLER_BUTTON_CODE_RELEASE_BASE and buttonCode < CONTROLLER_BUTTON_CODE_HELD_BASE
        m.held = buttonCode >= CONTROLLER_BUTTON_CODE_HELD_BASE
      else
        m.button = BGE.buttonNameFromCode(buttonCode)
        m.press = buttonCode < 100
        m.held = buttonCode >= 1000
        m.release = buttonCode >= 100 and buttonCode < 1000
      end if
      m.heldTimeMs = heldTimeMs
      m.x = 0
      m.y = 0
      if not m.release
        if m.isButton("right")
          m.x = 1
        else if m.isButton("left")
          m.x = -1
        else if m.isButton("down")
          m.y = -1
        else if m.isButton("up")
          m.y = 1
        end if
      end if
    end sub


    ' Is this input for the given button name?
    '   Accepts common aliases in addition to BGE's own button names (case insensitive) -
    '   e.g. "select"/"info"/"ff"/"rewind" all resolve to the same buttons as "ok"/"options"/"fastforward"/"rewind".
    '   See BGE.buttonAliasToName() for the full alias list.
    '
    ' @param {string} buttonName - the button name (or alias) to check
    ' @return {boolean} - true if this input matches the given button name
    function isButton(buttonName as string) as boolean
      return invalid <> buttonName and invalid <> m.button and BGE.buttonAliasToName(buttonName) = lcase(m.button)
    end function

    ' Is this input from the directional pad
    '
    ' @return {boolean} - true if this input was generated from the direction pad
    function isDirectionalArrow() as boolean
      return m.x <> 0 or m.y <> 0
    end function

    ' Marks this input as handled by a UI widget, so it won't also reach
    ' regular GameEntity.onInput() callbacks this frame.
    '
    ' @return {void}
    sub consume()
      m.consumed = true
    end sub
  end class

end namespace
