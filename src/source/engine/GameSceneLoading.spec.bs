import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/loading/AssetLoader.bs"

namespace tests

  @suite("BGE.Game scene loading stage")
  class GameSceneLoadingTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.game.defineScene(new BGE.GameScene(m.game, {name: "Plain"}))
      loading = new LoadingTestScene(m.game, "Loading", 3)
      m.game.defineScene(loading)
    end function

    @describe("a scene without onLoad work")

    @it("gets onCreate in the same call, with no loading stage")
    function _()
      m.game.changeScene("Plain")
      m.assertEqual("Plain", m.game.currentScene.name)
      m.assertFalse(m.game.isLoading())
      m.assertEqual(1.0, m.game.getLoadingProgress())
    end function

    @describe("a scene with onLoad work")

    @it("runs onLoad, loads over frames, then calls onCreate once")
    function _()
      m.game.changeScene("Loading")
      scene = m.game.currentScene as LoadingTestScene
      m.assertEqual(1, scene.loadCalls)
      m.assertEqual(0, scene.createCalls)
      m.assertTrue(m.game.isLoading())
      m.assertTrue(m.game.isTransitioning())

      m.game.runSceneTransitionFrameForTest(0.016)
      m.assertTrue(m.game.getLoadingProgress() > 0)
      m.assertEqual(0, scene.createCalls)

      m.runFrames(5)
      m.assertFalse(m.game.isLoading())
      m.assertEqual(1, scene.createCalls)
      m.assertEqual("ok", scene.createdWithArg)
    end function

    @it("destroys the old scene's entities before onLoad runs")
    function _()
      m.game.changeScene("Plain")
      entity = new BGE.GameEntity(m.game, {name: "Old"})
      m.game.addEntity(entity)
      m.game.changeScene("Loading")
      ' the game is "running" (Play() never started), so the change waits for the frame end
      m.game.runSceneTransitionFrameForTest(0.016)
      scene = m.game.currentScene as LoadingTestScene
      m.assertEqual(0, scene.oldEntitiesSeenInLoad)
    end function

    @it("doesn't run the loading scene or entities added in onLoad until onCreate")
    function _()
      m.game.changeScene("Loading")
      scene = m.game.currentScene as LoadingTestScene
      m.game.processEntitiesPreDrawForTest()
      m.assertEqual(0, scene.updateCalls)
      m.assertEqual(0, scene.addedEntity.updateCalls)
      m.runFrames(6)
      m.game.processEntitiesPreDrawForTest()
      m.assertEqual(1, scene.updateCalls)
      m.assertEqual(1, scene.addedEntity.updateCalls)
    end function

    @it("doesn't send game events or quality changes to the loading scene or its entities")
    function _()
      keeper = new CountingEntity(m.game, "Keeper")
      keeper.persistent = true
      m.game.addEntity(keeper)
      m.game.changeScene("Loading")
      scene = m.game.currentScene as LoadingTestScene
      m.game.postGameEvent("ping")
      m.game.setQualityLevel(m.otherQualityLevel())
      m.assertEqual(0, scene.gameEvents)
      m.assertEqual(0, scene.qualityChanges)
      m.assertEqual(0, scene.addedEntity.gameEvents)
      m.assertEqual(0, scene.addedEntity.qualityChanges)
      m.assertEqual(1, keeper.gameEvents)
      m.assertEqual(1, keeper.qualityChanges)
      m.runFrames(6)
      m.game.postGameEvent("ping")
      m.assertEqual(1, scene.gameEvents)
      m.assertEqual(1, scene.addedEntity.gameEvents)
    end function

    @it("builds the default loading screen from the current theme")
    function _()
      m.game.defaultTheme.foregroundColor = &h112233FF
      m.game.changeScene("Loading")
      m.assertEqual(&h112233FF, m.activeLoadingScreen().barColor)
      m.runFrames(6)
      m.game.defaultTheme.foregroundColor = &h445566FF
      m.game.changeScene("Plain")
      m.runFrames(1)
      m.game.changeScene("Loading")
      m.runFrames(1)
      m.assertEqual(&h445566FF, m.activeLoadingScreen().barColor)
    end function

    @it("keeps updating persistent entities while loading")
    function _()
      keeper = new CountingEntity(m.game, "Keeper")
      keeper.persistent = true
      m.game.addEntity(keeper)
      m.game.changeScene("Loading")
      m.game.processEntitiesPreDrawForTest()
      m.assertEqual(1, keeper.updateCalls)
    end function

    @it("records errors on the scene loader for onCreate to check")
    function _()
      scene = m.game.Scenes["Loading"]
      scene.failOneTask = true
      m.game.changeScene("Loading")
      m.runFrames(6)
      m.assertEqual(1, m.game.getSceneLoader().getErrors().count())
      m.assertEqual(1, scene.createCalls)
    end function

    @it("runs the loading stage again on resetScene")
    function _()
      m.game.changeScene("Loading")
      m.runFrames(6)
      m.game.resetScene()
      m.runFrames(6)
      scene = m.game.currentScene as LoadingTestScene
      m.assertEqual(2, scene.loadCalls)
      m.assertEqual(2, scene.createCalls)
    end function

    @describe("scene changes requested while loading")

    @it("defers a changeScene made during loading until loading ends")
    function _()
      m.game.changeScene("Loading")
      loadingScene = m.game.currentScene as LoadingTestScene
      m.game.changeScene("Plain")
      m.assertEqual("Loading", m.game.currentScene.name)
      m.runFrames(6)
      m.assertEqual(1, loadingScene.createCalls)
      m.assertEqual("Plain", m.game.currentScene.name)
    end function

    @it("handles changeScene called from inside onLoad")
    function _()
      scene = m.game.Scenes["Loading"]
      scene.changeToInLoad = "Plain"
      m.game.changeScene("Loading")
      m.runFrames(6)
      m.assertEqual(1, scene.loadCalls)
      m.assertEqual(1, scene.createCalls)
      m.assertEqual("Plain", m.game.currentScene.name)
    end function

    @describe("loading screen")

    @it("only shows once loading has run for showAfterSeconds")
    function _()
      m.game.Scenes["Loading"].taskSteps = 100
      m.game.changeScene("Loading")
      ' each frame counts at most 1/30s, so 0.25s takes 8 frames
      for i = 1 to 3
        m.game.runSceneTransitionFrameForTest(0.0333)
      end for
      m.assertFalse(m.game.isLoadingScreenShown())
      for i = 1 to 5
        m.game.runSceneTransitionFrameForTest(0.0333)
      end for
      m.assertTrue(m.game.isLoadingScreenShown())
    end function

    @it("uses the scene's loading screen over the game's")
    function _()
      gameScreen = new CountingLoadingScreen()
      gameScreen.tag = "game"
      m.game.loadingScreen = gameScreen
      sceneScreen = new CountingLoadingScreen()
      sceneScreen.tag = "scene"
      sceneScreen.showAfterSeconds = 0
      scene = m.game.Scenes["Loading"]
      scene.screen = sceneScreen
      m.game.changeScene("Loading")
      m.game.runSceneTransitionFrameForTest(0.016)
      m.assertEqual(1, sceneScreen.showCalls)
      m.assertEqual(0, gameScreen.showCalls)
      m.runFrames(6)
      m.assertEqual(1, sceneScreen.hideCalls)
    end function

    @it("clamps a long frame so it can't show the loading screen at once")
    function _()
      m.game.Scenes["Loading"].taskSteps = 100
      m.game.changeScene("Loading")
      m.game.runSceneTransitionFrameForTest(5.0)
      m.assertFalse(m.game.isLoadingScreenShown())
    end function

    @describe("gameUi while loading")

    @it("doesn't activate a focused button on OK while loading")
    function _()
      button = new LoadingCountingButton(m.game)
      m.game.gameUi.addChild(button)
      ok = new BGE.GameInput(BGE.CONTROLLER_BUTTON_CODE_PRESS_BASE, 0, 0, "ok")
      m.game.processUiInputForTest([ok])
      m.assertEqual(1, button.clickCount)

      m.game.changeScene("Loading")
      m.assertTrue(m.game.isLoading())
      m.game.processUiInputForTest([ok])
      m.assertEqual(1, button.clickCount)

      m.runFrames(6)
      m.assertFalse(m.game.isLoading())
      m.game.processUiInputForTest([ok])
      m.assertEqual(2, button.clickCount)
    end function

    @describe("changeScene from onCreate")

    @it("applies a change requested in onCreate at the next end of frame")
    function _()
      m.game.defineScene(new ChangingOnCreateScene(m.game))
      m.game.changeScene("Chainer")
      m.assertEqual("Chainer", m.game.currentScene.name)
      m.assertTrue(m.game.isSceneChanging())
      m.runFrames(1)
      m.assertEqual("Plain", m.game.currentScene.name)
    end function

    @describe("with changeSceneWithFade")

    @it("fades out, loads, creates, then fades in")
    function _()
      m.game.changeScene("Plain")
      m.game.changeSceneWithFade("Loading", {}, 0.05)
      m.runFrames(4)
      m.assertEqual("Loading", m.game.currentScene.name)
      m.assertTrue(m.game.isLoading())
      m.assertEqual(1.0, m.game.screenFade.opacity)
      m.runFrames(6)
      m.assertFalse(m.game.isLoading())
      created = m.game.currentScene as LoadingTestScene
      m.assertEqual(1, created.createCalls)
      m.runFrames(10)
      m.assertEqual(0.0, m.game.screenFade.opacity)
      m.assertFalse(m.game.isTransitioning())
    end function

    @describe("end-of-frame ordering")

    @it("calls onCreate at the end of the frame the loader finishes, not mid-frame")
    function _()
      m.game.changeScene("Loading")
      scene = m.game.currentScene as LoadingTestScene
      ' step the loader directly, as Play() does mid-frame; onCreate must not have run yet
      m.game.runLoadingUpdateForTest(0.016)
      m.game.runLoadingUpdateForTest(0.016)
      m.game.runLoadingUpdateForTest(0.016)
      m.assertEqual(0, scene.createCalls)
      m.assertTrue(m.game.isLoading())
      m.game.runEndOfFrameForTest()
      m.assertEqual(1, scene.createCalls)
      m.assertFalse(m.game.isLoading())
    end function

    @it("keeps a change requested during loading pending across frames")
    function _()
      m.game.changeScene("Loading")
      m.game.changeScene("Plain")
      m.runFrames(1)
      m.assertTrue(m.game.isSceneChanging())
      m.runFrames(6)
      m.assertEqual("Plain", m.game.currentScene.name)
      m.assertFalse(m.game.isSceneChanging())
    end function

    @describe("game.assets")

    @it("is ticked every frame for background loads")
    function _()
      context = {calls: 0}
      m.game.assets.addStep(function(ctx as object) as dynamic
        ctx.calls = ctx.calls + 1
        return ctx.calls >= 2
      end function, context)
      ' the step budget is wall-clock, so a slow frame may only get one call in - allow a few frames
      m.runFrames(3)
      m.assertEqual(2, context.calls)
      m.assertTrue(m.game.assets.isDone())
    end function

    private function activeLoadingScreen() as BGE.DefaultLoadingScreen
      gameFields = m.game as roAssociativeArray
      return gameFields.activeLoadingScreen
    end function

    private function otherQualityLevel() as BGE.RenderQualityLevel
      if m.game.renderQuality.getLevel() = BGE.RenderQualityLevel.basic
        return BGE.RenderQualityLevel.ultra
      end if
      return BGE.RenderQualityLevel.basic
    end function

    private sub runFrames(count as integer)
      for i = 1 to count
        m.game.runSceneTransitionFrameForTest(0.016)
      end for
    end sub

  end class

  ' Queues one task that takes `taskSteps` frames (one step per frame), and records calls.
  class LoadingTestScene extends BGE.GameScene
    loadCalls as integer = 0
    createCalls as integer = 0
    updateCalls as integer = 0
    gameEvents as integer = 0
    qualityChanges as integer = 0
    taskSteps as integer = 3
    failOneTask as boolean = false
    changeToInLoad as string = ""
    createdWithArg as string = ""
    oldEntitiesSeenInLoad as integer = -1
    addedEntity as dynamic = invalid
    screen as dynamic = invalid

    sub new(game as BGE.Game, name as string, taskSteps as integer)
      super(game, {name: name})
      m.taskSteps = taskSteps
    end sub

    override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
      m.loadCalls++
      m.oldEntitiesSeenInLoad = m.game.getAllEntities("Old").count()
      entity = new CountingEntity(m.game, "AddedInLoad")
      m.game.addEntity(entity)
      m.addedEntity = entity
      ' one step per frame (oncePerFrame)
      context = {remaining: m.taskSteps, total: m.taskSteps}
      loader.addStep(function(ctx as object) as dynamic
        ctx.remaining = ctx.remaining - 1
        ' a float result is the task's progress (1.0 = done); a boolean would leave it at 0 until done
        return 1.0 - ctx.remaining / ctx.total
      end function, context, 1.0, true)
      if m.failOneTask
        loader.addStep(function(ctx as object) as dynamic
          return ctx.missing.field
        end function, {})
      end if
      if m.changeToInLoad <> ""
        m.game.changeScene(m.changeToInLoad)
      end if
    end sub

    override sub onCreate(args as roAssociativeArray)
      m.createCalls++
      m.createdWithArg = "ok"
    end sub

    override sub onUpdate(dt as float)
      m.updateCalls++
    end sub

    override sub onGameEvent(eventName as string, data as roAssociativeArray)
      m.gameEvents++
    end sub

    override sub onQualityChanged(level as BGE.RenderQualityLevel)
      m.qualityChanges++
    end sub

    override function getLoadingScreen() as BGE.LoadingScreen
      return m.screen
    end function
  end class

  class LoadingCountingButton extends BGE.UI.Button
    clickCount as integer = 0

    sub new(game as BGE.Game)
      super(game)
    end sub

    override sub onClick()
      m.clickCount++
    end sub
  end class

  ' No onLoad work; asks for another scene from onCreate
  class ChangingOnCreateScene extends BGE.GameScene
    sub new(game as BGE.Game)
      super(game, {name: "Chainer"})
    end sub

    override sub onCreate(args as roAssociativeArray)
      m.game.changeScene("Plain")
    end sub
  end class

  class CountingEntity extends BGE.GameEntity
    updateCalls as integer = 0
    gameEvents as integer = 0
    qualityChanges as integer = 0

    sub new(game as BGE.Game, name as string)
      super(game, {name: name})
    end sub

    override sub onUpdate(dt as float)
      m.updateCalls++
    end sub

    override sub onGameEvent(eventName as string, data as roAssociativeArray)
      m.gameEvents++
    end sub

    override sub onQualityChanged(level as BGE.RenderQualityLevel)
      m.qualityChanges++
    end sub
  end class

  class CountingLoadingScreen extends BGE.LoadingScreen
    tag as string = ""
    showCalls as integer = 0
    hideCalls as integer = 0

    sub new()
      super()
    end sub

    override sub onShow()
      m.showCalls++
    end sub

    override sub onHide()
      m.hideCalls++
    end sub
  end class

end namespace
