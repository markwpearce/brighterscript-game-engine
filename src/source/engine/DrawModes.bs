import "GameEntity.bs"
import "renderer/sceneObjects/SceneObject.bs"

namespace BGE

  ' The draw mode after `current`, wrapping from `last` back to `first`. A mode outside the
  ' range goes to `first`.
  '
  ' @param {BGE.SceneObjectDrawMode} current
  ' @param {BGE.SceneObjectDrawMode} [first=matchCamera] - first mode in the cycle
  ' @param {BGE.SceneObjectDrawMode} [last=axisAligned] - last mode in the cycle
  ' @return {BGE.SceneObjectDrawMode}
  function nextDrawMode(current as BGE.SceneObjectDrawMode, first = BGE.SceneObjectDrawMode.matchCamera as BGE.SceneObjectDrawMode, last = BGE.MAX_DRAW_MODE as BGE.SceneObjectDrawMode) as BGE.SceneObjectDrawMode
    if current < first or current >= last
      return first
    end if
    return (current + 1) as BGE.SceneObjectDrawMode
  end function

  ' Puts every drawable on an entity into one draw mode.
  '
  ' @param {BGE.GameEntity} entity
  ' @param {BGE.SceneObjectDrawMode} drawMode
  sub setEntityDrawMode(entity as BGE.GameEntity, drawMode as BGE.SceneObjectDrawMode)
    for each drawable in entity.drawables
      drawable.drawMode = drawMode
    end for
  end sub

  ' Moves every drawable on an entity to the draw mode after its first drawable's (see
  ' nextDrawMode()), so they all end up in the same mode. For demos that step through the
  ' draw modes on a button press.
  '
  ' @param {BGE.GameEntity} entity
  ' @param {BGE.SceneObjectDrawMode} [first=matchCamera] - first mode in the cycle
  ' @param {BGE.SceneObjectDrawMode} [last=axisAligned] - last mode in the cycle
  ' @return {BGE.SceneObjectDrawMode} the new mode (`first` when the entity has no drawables)
  function cycleDrawMode(entity as BGE.GameEntity, first = BGE.SceneObjectDrawMode.matchCamera as BGE.SceneObjectDrawMode, last = BGE.MAX_DRAW_MODE as BGE.SceneObjectDrawMode) as BGE.SceneObjectDrawMode
    if entity.drawables.count() = 0
      return first
    end if
    current = entity.drawables[0].drawMode
    newMode = BGE.nextDrawMode(current, first, last)
    BGE.setEntityDrawMode(entity, newMode)
    return newMode
  end function

end namespace
