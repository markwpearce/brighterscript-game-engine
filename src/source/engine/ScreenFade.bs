import "renderer/Renderer.bs"

namespace BGE

  ' A full-screen colour overlay drawn on top of the game and its UI, faded in or out over time.
  ' `Game` owns one (`game.screenFade`) and drives it for `Game.changeSceneWithFade()`; you can
  ' also call `fadeTo()` on it directly, e.g. to dim the screen behind a pause menu.
  class ScreenFade

    ' Overlay colour, packed RGB (0xRRGGBB)
    color as integer = 0
    ' 0 = invisible, 1 = fully covers the screen
    opacity as float = 0.0

    private fromOpacity as float = 0.0
    private toOpacity as float = 0.0
    private durationSeconds as float = 0.0
    private elapsedSeconds as float = 0.0
    private fading as boolean = false

    ' Starts fading from the current opacity to the given one.
    '
    ' @param {float} targetOpacity - 0 (clear) to 1 (fully covered)
    ' @param {float} seconds - how long the fade takes; 0 or less jumps straight there
    sub fadeTo(targetOpacity as float, seconds as float)
      m.fromOpacity = m.opacity
      m.toOpacity = targetOpacity
      m.durationSeconds = seconds
      m.elapsedSeconds = 0
      m.fading = true
      if seconds <= 0
        m.tick(0)
      end if
    end sub

    ' Whether a fade is in progress.
    '
    ' @return {boolean}
    function isFading() as boolean
      return m.fading
    end function

    ' Advances the fade. Called by Game once per frame.
    '
    ' @param {float} dt - seconds since last frame
    ' @return {boolean} true on the frame the fade finishes
    function tick(dt as float) as boolean
      if not m.fading
        return false
      end if
      ' A long frame (e.g. a scene building itself) shouldn't swallow the whole fade.
      if dt > MAX_FADE_STEP_SECONDS
        dt = MAX_FADE_STEP_SECONDS
      end if
      m.elapsedSeconds += dt
      if m.durationSeconds <= 0 or m.elapsedSeconds >= m.durationSeconds
        m.opacity = m.toOpacity
        m.fading = false
        return true
      end if
      m.opacity = m.fromOpacity + (m.toOpacity - m.fromOpacity) * (m.elapsedSeconds / m.durationSeconds)
      return false
    end function

    ' Draws the overlay, if visible. Called by Game after the UI is drawn.
    '
    ' @param {Renderer} uiRenderer
    sub draw(uiRenderer as Renderer)
      alphaByte = Int(m.opacity * 255 + 0.5)
      if alphaByte <= 0
        return
      end if
      if alphaByte > 255
        alphaByte = 255
      end if
      size = uiRenderer.getCanvasSize()
      uiRenderer.drawRectangle(0, 0, size.x, size.y, (m.color << 8) or alphaByte)
    end sub

  end class

  ' Longest dt a single ScreenFade.tick() counts (one frame at 30fps)
  ' A literal, not 1.0 / 30.0 - the docs plugin can only emit literal const values.
  const MAX_FADE_STEP_SECONDS = 0.0333333

end namespace
