namespace tests

  @suite("BGE.GameScene onPostUpdate")
  class GameScenePostUpdateTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("onPostUpdate")

    @it("runs once on the current scene after every entity has updated")
    function _()
      log = [] as string[]
      scene = new PostUpdateRecordingScene(m.game, log, {name: "Recording"})
      m.game.defineScene(scene)
      m.game.changeScene("Recording")
      first = new UpdateRecordingEntity(m.game, log, {name: "First"})
      second = new UpdateRecordingEntity(m.game, log, {name: "Second"})
      m.game.addEntity(first)
      m.game.addEntity(second)

      m.game.processEntityUpdatesForTest()

      m.assertEqual(log, ["update:Recording", "update:Second", "update:First", "postUpdate"])
    end function

    @it("is skipped while the game is paused for a pauseable scene")
    function _()
      log = [] as string[]
      scene = new PostUpdateRecordingScene(m.game, log, {name: "Recording"})
      m.game.defineScene(scene)
      m.game.changeScene("Recording")
      m.game.Pause()

      m.game.processEntityUpdatesForTest()

      m.assertEqual(log.Count(), 0)
    end function

  end class

  class PostUpdateRecordingScene extends BGE.GameScene
    log as string[]

    sub new(game as BGE.Game, log as string[], args = {} as roAssociativeArray)
      super(game, args)
      m.log = log
    end sub

    override sub onUpdate(deltaTime as float)
      m.log.push("update:" + m.name)
    end sub

    override sub onPostUpdate(deltaTime as float)
      m.log.push("postUpdate")
    end sub
  end class

  class UpdateRecordingEntity extends BGE.GameEntity
    log as string[]

    sub new(game as BGE.Game, log as string[], args = {} as roAssociativeArray)
      super(game, args)
      m.log = log
    end sub

    override sub onUpdate(deltaTime as float)
      m.log.push("update:" + m.name)
    end sub
  end class

end namespace
