import "../../math/vector.bs"
import "../GameInput.bs"
import "ControllerRegistry.bs"

namespace BGE.Controller

  ' One bindAction() binding - internal bookkeeping, not part of the public API.
  ' remoteButtons/controllerButtons are always normalized to arrays by
  ' bindAction() - empty means this action has no binding for that source.
  interface ActionBinding
    remoteButtons as string[]
    controllerButtons as string[]
    playerIndex as integer
    label as dynamic ' string, or invalid if none given
  end interface

  ' One bindAxis() binding - internal bookkeeping, not part of the public API.
  interface AxisBinding
    stick as string
    playerIndex as integer
    label as dynamic ' string, or invalid if none given
  end interface

  ' One action's bindings, described for a controls legend - see ControlMap.describeBindings().
  interface BindingDescription
    ' The action name passed to bindAction().
    name as string
    ' Its label, or the name capitalized when it has none.
    label as string
    ' Display names of every bound button, remote first, without repeats (e.g. ["OK", "X"]).
    buttons as string[]
    ' "<label>: <buttons joined with ' / '>", e.g. "Attack: OK / X".
    text as string
  end interface

  ' One action's live press/held/release/duration state - internal bookkeeping, not part of
  ' the public API (isActionPressed()/isActionHeld()/isActionReleased()/getActionHeldTimeMs()
  ' are how a game reads this).
  interface ActionState
    press as boolean
    held as boolean
    release as boolean
    heldTimeMs as integer
  end interface

  ' Unified mapping from remote-button and controller input to named
  ' actions/axes - the one class a game needs to learn to support both
  ' input sources. Exposed as Game.controls; see Game.enableControllerInput().
  class ControlMap
    private registry as BGE.Controller.ControllerRegistry
    private actionBindings = {} ' name -> ActionBinding
    private axisBindings = {} ' name -> AxisBinding
    private actionState = {} ' name -> ActionState
    private anyBindings = false
    private blockedActions = {} ' name -> true, until the action's button is released
    private actionOrder as string[] = [] ' action names in bindAction() order

    sub new(registry as BGE.Controller.ControllerRegistry)
      m.registry = registry
    end sub

    ' Binds a logical action name to a remote button and/or a specific
    ' player's named controller button - any bound source fires the action.
    ' Either argument accepts a single button name or an array of alternative
    ' names that should all trigger it. A controller button name is whatever
    ' the browser page sends (see controller-web/index.html) - any name
    ' works, with no engine change.
    '
    ' @param {string} name - the logical action name, e.g. "jump"
    ' @param {string|string[]} [remoteButton=invalid] - a remote button name (see BGE.GameInput.isButton), or an array of alternatives
    ' @param {string|string[]} [controllerButton=invalid] - a controller button name, or an array of alternatives
    ' @param {integer} [playerIndex=0] - which controller's button this binds to
    ' @param {string} [label=invalid] - shown to the player on the controller page for this control
    ' @return {void}
    sub bindAction(name as string, remoteButton = invalid as string or string[], controllerButton = invalid as string or string[], playerIndex = 0 as integer, label = invalid as dynamic)
      if not m.actionBindings.DoesExist(name)
        m.actionOrder.push(name)
      end if
      m.actionBindings[name] = {
        remoteButtons: m.asButtonNameArray(remoteButton),
        controllerButtons: m.asButtonNameArray(controllerButton),
        playerIndex: playerIndex,
        label: label
      }
      m.anyBindings = true
    end sub

    ' Normalizes a bindAction() remoteButton/controllerButton argument
    ' (invalid, a single string, or an array of strings) into a plain array.
    '
    ' @return {string[]} - empty if value is invalid, [value] if a string, value unchanged if already an array
    private function asButtonNameArray(value as string or string[]) as string[]
      if value = invalid
        return []
      end if
      if type(value) = "roArray"
        return value as string[]
      end if
      return [value as string]
    end function

    ' Binds a logical axis name to a player's named controller stick. getAxis()
    ' falls back to the remote d-pad whenever that stick reads neutral, so
    ' a game written against this axis works with just a remote connected. A
    ' d-pad-only controller page sends its d-pad as just another named stick
    ' (snapped to -1/0/1 per axis) - no separate binding call needed.
    '
    ' @param {string} name - the logical axis name, e.g. "move"
    ' @param {string} [stick="1"] - the stick's name, as sent in the message's `sticks` map
    ' @param {integer} [playerIndex=0] - which controller's stick this binds to
    ' @param {string} [label=invalid] - shown to the player on the controller page for this control
    ' @return {void}
    sub bindAxis(name as string, stick = "1" as string, playerIndex = 0 as integer, label = invalid as dynamic)
      m.axisBindings[name] = {stick: stick, playerIndex: playerIndex, label: label}
      m.anyBindings = true
    end sub

    ' @return {boolean} - true once any action/axis binding has been added
    function hasBindings() as boolean
      return m.anyBindings
    end function

    ' @param {string} name
    ' @return {boolean} - true if bindAction() has been called for this name
    function hasAction(name as string) as boolean
      return m.actionBindings.DoesExist(name)
    end function

    ' @param {string} name - a name previously passed to bindAxis()
    ' @return {boolean} - true if bindAxis() was called for this name
    function hasAxisBinding(name as string) as boolean
      return m.axisBindings[name] <> invalid
    end function

    ' Starts a new frame: clears the one-shot press/release flags so they only
    ' read true on the frame their event arrived. `held` is a snapshot of
    ' "currently down", not a transient, so it is left alone here and only
    ' changes when a later onInput() says otherwise. Called once per frame by
    ' Game - a game does not call this directly.
    '
    ' @return {void}
    sub beginFrame()
      for each name in m.actionState
        state = m.actionState[name] as ActionState
        state.press = false
        state.release = false
      end for
    end sub

    ' Feeds one GameInput event (remote, simulator gamepad, or browser
    ' controller - all three carry a real playerIndex, see
    ' BGE.Controller.ControllerRegistry.assignPlayerIndexForRemoteId)
    ' through every action binding, updating whichever actions it matches.
    ' Called once per input event by Game - a game does not call this directly.
    '
    ' Several events for the same binding can arrive in one frame (Game feeds
    ' a press and then a held event for the same button), so press/release
    ' accumulate across the frame rather than overwriting each other.
    '
    ' @param {BGE.GameInput} input
    ' @return {void}
    sub onInput(input as BGE.GameInput)
      for each name in m.actionBindings
        binding = m.actionBindings[name] as ActionBinding
        if input.playerIndex <> binding.playerIndex
          continue for
        end if
        matchesRemote = m.matchesAnyButton(binding.remoteButtons, input, true)
        matchesController = m.matchesAnyButton(binding.controllerButtons, input, false)
        if matchesRemote or matchesController
          state = m.actionState[name] as ActionState
          if state = invalid
            state = {press: false, held: false, release: false, heldTimeMs: 0}
            m.actionState[name] = state
          end if
          countsForState = true
          if m.blockedActions.DoesExist(name)
            if input.press or input.release
              ' the release (or a press, should a release have been missed) ends the block
              m.blockedActions.Delete(name)
            end if
            if input.release
              state.held = false
              state.heldTimeMs = 0
            end if
            countsForState = input.press
          end if
          if countsForState
            state.press = state.press or input.press
            state.release = state.release or input.release
            if input.release
              state.held = false
              state.heldTimeMs = 0
            else
              state.held = state.held or input.held
              if input.press or input.held
                state.heldTimeMs = input.heldTimeMs
              end if
            end if
          end if
        end if
      end for
    end sub

    ' @param {boolean} isRemote - true to match via alias-resolving isButton() (remoteButtons), false for exact string equality (controllerButtons)
    ' @return {boolean} - true if any bound name matches this input's button
    private function matchesAnyButton(names as string[], input as BGE.GameInput, isRemote as boolean) as boolean
      for each buttonName in names
        if isRemote
          if input.isButton(buttonName)
            return true
          end if
        else if input.button = buttonName
          return true
        end if
      end for
      return false
    end function

    ' A binding's playerIndex is fixed at bindAction() time, so reading an
    ' action never needs it - the name alone identifies the binding.
    '
    ' @param {string} name
    ' @return {boolean} - true the frame the bound button was pressed
    function isActionPressed(name as string) as boolean
      return m.stateFor(name).press
    end function

    ' @param {string} name
    ' @return {boolean} - true every frame the bound button remains held
    function isActionHeld(name as string) as boolean
      return m.stateFor(name).held
    end function

    ' @param {string} name
    ' @return {boolean} - true the frame the bound button was released
    function isActionReleased(name as string) as boolean
      return m.stateFor(name).release
    end function

    ' @param {string} name
    ' @return {integer} - ms the bound button has been continuously held, 0 if not currently held
    function getActionHeldTimeMs(name as string) as integer
      return m.stateFor(name).heldTimeMs
    end function

    private function stateFor(name as string) as ActionState
      if m.blockedActions.DoesExist(name)
        return {press: false, held: false, release: false, heldTimeMs: 0}
      end if
      return m.actionState[name] ?? {press: false, held: false, release: false, heldTimeMs: 0}
    end function

    ' Makes an action read as not pressed or held until its button is released, e.g. so the
    ' OK that closed a panel doesn't also swing a sword. Does nothing if it isn't held.
    ' The release itself isn't reported either.
    '
    ' @param {string} name
    ' @return {void}
    sub blockUntilReleased(name as string)
      state = m.actionState[name] as ActionState
      if state <> invalid and (state.held or state.press)
        m.blockedActions[name] = true
      end if
    end sub

    ' blockUntilReleased() for every action that's held right now.
    '
    ' @return {void}
    sub blockHeldActions()
      for each name in m.actionState
        m.blockUntilReleased(name)
      end for
    end sub

    ' Is this action waiting for its button to be released (see blockUntilReleased())?
    '
    ' @param {string} name
    ' @return {boolean}
    function isActionBlocked(name as string) as boolean
      return m.blockedActions.DoesExist(name)
    end function

    ' @param {string} name - a name previously passed to bindAxis()
    ' @return {BGE.Math.Vector} - the bound controller stick; if that's
    '   neutral, this player's remote analog stick (simulator-only, or a
    '   real Bluetooth gamepad's left/right stick per bindAxis()'s stick
    '   name); if that's also neutral, this player's remote d-pad
    function getAxis(name as string) as BGE.Math.Vector
      binding = m.axisBindings[name] as AxisBinding
      if binding = invalid
        return BGE.Math.VectorOps.create()
      end if
      stickVector = m.registry.getStick(binding.playerIndex, binding.stick)
      if stickVector.x <> 0 or stickVector.y <> 0
        return stickVector
      end if
      analogVector = m.registry.getRemoteAnalogStick(binding.playerIndex, binding.stick)
      if analogVector.x <> 0 or analogVector.y <> 0
        return analogVector
      end if
      return m.registry.getRemoteDpad(binding.playerIndex)
    end function

    ' Unlike getAxis(), never falls back to the remote d-pad - used to detect
    ' whether a real second/independent stick is actually connected (e.g. to
    ' pick between a dual-stick scheme and a single-source fallback scheme),
    ' where getAxis()'s d-pad fallback would make two axes bound to the same
    ' remote read identically and could not be told apart. A connected
    ' browser controller stick or a real Bluetooth gamepad's own left/right
    ' stick both count as "real" here - a plain remote/keyboard's d-pad
    ' fallback does not, since one d-pad can't represent two independent axes.
    '
    ' @param {string} name - a name previously passed to bindAxis()
    ' @return {BGE.Math.Vector} - the bound controller/gamepad stick only, {0,0} if unbound or neutral
    function getRawAxis(name as string) as BGE.Math.Vector
      binding = m.axisBindings[name] as AxisBinding
      if binding = invalid
        return BGE.Math.VectorOps.create()
      end if
      stickVector = m.registry.getStick(binding.playerIndex, binding.stick)
      if stickVector.x <> 0 or stickVector.y <> 0
        return stickVector
      end if
      return m.registry.getRemoteAnalogStick(binding.playerIndex, binding.stick)
    end function

    ' Like getRawAxis(), but reads a player's stick directly with no bindAxis() needed -
    ' e.g. for a debug display showing every connected stick.
    '
    ' @param {integer} playerIndex
    ' @param {string} [stick="1"] - "1" is the left stick, "2" the right
    ' @return {BGE.Math.Vector} - the player's browser controller or Bluetooth gamepad stick, {0,0} if neutral or none
    function getPlayerStick(playerIndex as integer, stick = "1" as string) as BGE.Math.Vector
      stickVector = m.registry.getStick(playerIndex, stick)
      if stickVector.x <> 0 or stickVector.y <> 0
        return stickVector
      end if
      return m.registry.getRemoteAnalogStick(playerIndex, stick)
    end function

    ' @param {integer} [playerIndex=0]
    ' @return {object} - the latest raw `custom` payload sent by this player's
    '   controller page, {} if none sent yet - an escape hatch for a custom
    '   on-screen control that isn't button/stick shaped (a slider, etc.)
    function getCustomPayload(playerIndex = 0 as integer) as object
      return m.registry.getCustomPayload(playerIndex)
    end function

    ' Describes every bound action, in bindAction() order, for a controls legend: its label
    ' and the buttons that trigger it, e.g. "Attack: OK / X". Format them your own way from
    ' `label` and `buttons`.
    '
    ' @param {boolean} [labelledOnly=false] - skip actions bound without a label
    ' @param {integer} [playerIndex=-1] - only this player's bindings; -1 for all
    ' @return {BGE.Controller.BindingDescription[]}
    function describeBindings(labelledOnly = false as boolean, playerIndex = -1 as integer) as BGE.Controller.BindingDescription[]
      descriptions = [] as BGE.Controller.BindingDescription[]
      for each name in m.actionOrder
        binding = m.actionBindings[name] as ActionBinding
        wanted = binding.label <> invalid or not labelledOnly
        if wanted and (playerIndex < 0 or binding.playerIndex = playerIndex)
          label = binding.label
          if label = invalid
            label = UCase(Left(name, 1)) + Mid(name, 2)
          end if
          buttons = [] as string[]
          seen = {}
          allNames = [] as string[]
          allNames.append(binding.remoteButtons)
          allNames.append(binding.controllerButtons)
          for each buttonName in allNames
            display = BGE.Controller.buttonDisplayName(buttonName)
            if not seen.DoesExist(LCase(display))
              seen[LCase(display)] = true
              buttons.push(display)
            end if
          end for
          descriptions.push({name: name, label: label, buttons: buttons, text: label + ": " + buttons.Join(" / ")})
        end if
      end for
      return descriptions
    end function

    ' @return {object} - every bound action/axis name that was given a label, name -> label.
    '   Sent to a connecting browser page once (see Game.enableControllerInput()) so a
    '   generic controller page can show meaningful text instead of raw names.
    function getLabels() as object
      labels = {}
      for each name in m.actionBindings
        binding = m.actionBindings[name] as ActionBinding
        if binding.label <> invalid
          labels[name] = binding.label
        end if
      end for
      for each name in m.axisBindings
        binding = m.axisBindings[name] as AxisBinding
        if binding.label <> invalid
          labels[name] = binding.label
        end if
      end for
      return labels
    end function

  end class

  ' A button name as a player would read it: "ok" -> "OK", "play" -> "Play", "l1" -> "L1".
  '
  ' @param {string} buttonName
  ' @return {string}
  function buttonDisplayName(buttonName as string) as string
    known = {
      "ok": "OK", "select": "OK", "back": "Back", "play": "Play", "options": "*", "info": "*",
      "fastforward": "FF", "rewind": "Rewind", "replay": "Replay", "start": "Start",
      "up": "Up", "down": "Down", "left": "Left", "right": "Right"
    }
    lowered = LCase(buttonName)
    if known.DoesExist(lowered)
      return known[lowered]
    end if
    if Len(buttonName) <= 2
      return UCase(buttonName)
    end if
    return UCase(Left(buttonName, 1)) + Mid(buttonName, 2)
  end function

end namespace
