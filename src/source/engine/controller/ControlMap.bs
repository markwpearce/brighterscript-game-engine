import "../../math/vector.bs"
import "../GameInput.bs"
import "ControllerRegistry.bs"

namespace BGE.Controller

  ' One bindAction() binding - internal bookkeeping, not part of the public API.
  interface ActionBinding
    remoteButton as dynamic ' string, or invalid if this action has no remote binding
    controllerButton as dynamic ' string, or invalid if this action has no controller binding
    playerIndex as integer
    label as dynamic ' string, or invalid if none given
  end interface

  ' One bindAxis() binding - internal bookkeeping, not part of the public API.
  interface AxisBinding
    stick as string
    playerIndex as integer
    label as dynamic ' string, or invalid if none given
  end interface

  ' One action's live press/held/release/duration state - internal bookkeeping, not part of
  ' the public API (isActionPressed()/isActionHeld()/isActionReleased()/getActionHeldTimeMs()
  ' are how a game reads this).
  interface ActionState
    press as boolean
    held as boolean
    release as boolean
    heldTimeMs as integer
  end interface

  ' Unified mapping from remote-button and controller input to named
  ' actions/axes - the one class a game needs to learn to support both
  ' input sources. Exposed as Game.controls; see Game.enableControllerInput().
  class ControlMap
    private registry as BGE.Controller.ControllerRegistry
    private actionBindings = {} ' name -> ActionBinding
    private axisBindings = {} ' name -> AxisBinding
    private actionState = {} ' name -> ActionState
    private anyBindings = false

    sub new(registry as BGE.Controller.ControllerRegistry)
      m.registry = registry
    end sub

    ' Binds a logical action name to a remote button and/or a specific
    ' player's named controller button - either source fires the action. A
    ' controller button name is whatever the browser page sends (see
    ' controller-web/index.html) - any name works, including one a custom
    ' controller page invents for its own control, with no engine change.
    '
    ' @param {string} name - the logical action name, e.g. "jump"
    ' @param {string} [remoteButton=invalid] - a remote button name (see BGE.GameInput.isButton)
    ' @param {string} [controllerButton=invalid] - a controller button name
    ' @param {integer} [playerIndex=0] - which controller's button this binds to
    ' @param {string} [label=invalid] - shown to the player on the controller page for this control
    ' @return {void}
    sub bindAction(name as string, remoteButton = invalid as dynamic, controllerButton = invalid as dynamic, playerIndex = 0 as integer, label = invalid as dynamic)
      m.actionBindings[name] = {remoteButton: remoteButton, controllerButton: controllerButton, playerIndex: playerIndex, label: label}
      m.anyBindings = true
    end sub

    ' Binds a logical axis name to a player's named controller stick. getAxis()
    ' falls back to the remote d-pad whenever that stick reads neutral, so
    ' a game written against this axis works with just a remote connected. A
    ' d-pad-only controller page sends its d-pad as just another named stick
    ' (snapped to -1/0/1 per axis) - no separate binding call needed.
    '
    ' @param {string} name - the logical axis name, e.g. "move"
    ' @param {string} [stick="1"] - the stick's name, as sent in the message's `sticks` map
    ' @param {integer} [playerIndex=0] - which controller's stick this binds to
    ' @param {string} [label=invalid] - shown to the player on the controller page for this control
    ' @return {void}
    sub bindAxis(name as string, stick = "1" as string, playerIndex = 0 as integer, label = invalid as dynamic)
      m.axisBindings[name] = {stick: stick, playerIndex: playerIndex, label: label}
      m.anyBindings = true
    end sub

    ' @return {boolean} - true once any action/axis binding has been added
    function hasBindings() as boolean
      return m.anyBindings
    end function

    ' @param {string} name - a name previously passed to bindAxis()
    ' @return {boolean} - true if bindAxis() was called for this name
    function hasAxisBinding(name as string) as boolean
      return m.axisBindings[name] <> invalid
    end function

    ' Starts a new frame: clears the one-shot press/release flags so they only
    ' read true on the frame their event arrived. `held` is a snapshot of
    ' "currently down", not a transient, so it is left alone here and only
    ' changes when a later onInput() says otherwise. Called once per frame by
    ' Game - a game does not call this directly.
    '
    ' @return {void}
    sub beginFrame()
      for each name in m.actionState
        state = m.actionState[name] as ActionState
        state.press = false
        state.release = false
      end for
    end sub

    ' Feeds one GameInput event (remote or controller-originated) through
    ' every action binding, updating whichever actions it matches. Called
    ' once per input event by Game - a game does not call this directly.
    '
    ' Several events for the same binding can arrive in one frame (Game feeds
    ' a press and then a held event for the same button), so press/release
    ' accumulate across the frame rather than overwriting each other.
    '
    ' @param {BGE.GameInput} input
    ' @return {void}
    sub onInput(input as BGE.GameInput)
      for each name in m.actionBindings
        binding = m.actionBindings[name] as ActionBinding
        matchesRemote = binding.remoteButton <> invalid and input.playerIndex = -1 and input.isButton(binding.remoteButton)
        matchesController = binding.controllerButton <> invalid and input.playerIndex = binding.playerIndex and input.button = binding.controllerButton
        if matchesRemote or matchesController
          state = m.actionState[name] as ActionState
          if state = invalid
            state = {press: false, held: false, release: false, heldTimeMs: 0}
            m.actionState[name] = state
          end if
          state.press = state.press or input.press
          state.release = state.release or input.release
          if input.release
            state.held = false
            state.heldTimeMs = 0
          else
            state.held = state.held or input.held
            if input.press or input.held
              state.heldTimeMs = input.heldTimeMs
            end if
          end if
        end if
      end for
    end sub

    ' A binding's playerIndex is fixed at bindAction() time, so reading an
    ' action never needs it - the name alone identifies the binding.
    '
    ' @param {string} name
    ' @return {boolean} - true the frame the bound button was pressed
    function isActionPressed(name as string) as boolean
      return m.stateFor(name).press
    end function

    ' @param {string} name
    ' @return {boolean} - true every frame the bound button remains held
    function isActionHeld(name as string) as boolean
      return m.stateFor(name).held
    end function

    ' @param {string} name
    ' @return {boolean} - true the frame the bound button was released
    function isActionReleased(name as string) as boolean
      return m.stateFor(name).release
    end function

    ' @param {string} name
    ' @return {integer} - ms the bound button has been continuously held, 0 if not currently held
    function getActionHeldTimeMs(name as string) as integer
      return m.stateFor(name).heldTimeMs
    end function

    private function stateFor(name as string) as ActionState
      return m.actionState[name] ?? {press: false, held: false, release: false, heldTimeMs: 0}
    end function

    ' @param {string} name - a name previously passed to bindAxis()
    ' @return {BGE.Math.Vector} - the bound controller stick, or the remote d-pad if that stick is neutral
    function getAxis(name as string) as BGE.Math.Vector
      binding = m.axisBindings[name] as AxisBinding
      if binding = invalid
        return BGE.Math.VectorOps.create()
      end if
      stickVector = m.registry.getStick(binding.playerIndex, binding.stick)
      if stickVector.x <> 0 or stickVector.y <> 0
        return stickVector
      end if
      return m.registry.getRemoteDpad()
    end function

    ' @param {integer} [playerIndex=0]
    ' @return {object} - the latest raw `custom` payload sent by this player's
    '   controller page, {} if none sent yet - an escape hatch for a custom
    '   on-screen control that isn't button/stick shaped (a slider, etc.)
    function getCustomPayload(playerIndex = 0 as integer) as object
      return m.registry.getCustomPayload(playerIndex)
    end function

    ' @return {object} - every bound action/axis name that was given a label, name -> label.
    '   Sent to a connecting browser page once (see Game.enableControllerInput()) so a
    '   generic controller page can show meaningful text instead of raw names.
    function getLabels() as object
      labels = {}
      for each name in m.actionBindings
        binding = m.actionBindings[name] as ActionBinding
        if binding.label <> invalid
          labels[name] = binding.label
        end if
      end for
      for each name in m.axisBindings
        binding = m.axisBindings[name] as AxisBinding
        if binding.label <> invalid
          labels[name] = binding.label
        end if
      end for
      return labels
    end function

  end class

end namespace
