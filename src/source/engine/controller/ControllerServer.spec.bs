namespace tests
  @suite("BGE.Controller.ControllerServer")
  class ControllerServerTests extends rooibos.BaseTestSuite

    ' Only the pure request-parsing logic is covered here - the socket/HTTP/
    ' WebSocket path needs a real roStreamSocket, which brs-cli has no support
    ' for, so it is verified by sideload instead.

    private function bufferFor(text as string) as roByteArray
      bytes = CreateObject("roByteArray")
      bytes.FromAsciiString(text)
      return bytes
    end function

    private function crlf() as string
      return chr(13) + chr(10)
    end function

    @describe("parseHttpRequest")

    @it("parses a well-formed GET request, headers included")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      text = "GET /index.html HTTP/1.1" + m.crlf() + "Host: 192.168.1.5:8888" + m.crlf() + "Upgrade: websocket" + m.crlf() + m.crlf()
      buffer = m.bufferFor(text)
      request = server.parseHttpRequest(buffer, buffer.Count())
      m.assertEqual("GET", request.command)
      m.assertEqual("/index.html", request.path)
      m.assertEqual("HTTP/1.1", request.protocol)
      ' a colon inside the value must survive header parsing
      m.assertEqual("192.168.1.5:8888", request.headers["Host"])
      m.assertEqual("websocket", request.headers["Upgrade"])
    end function

    @it("returns invalid for a request line with too few tokens")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      buffer = m.bufferFor("GET" + m.crlf() + m.crlf())
      m.assertInvalid(server.parseHttpRequest(buffer, buffer.Count()))
    end function

    @it("returns invalid for an empty buffer")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      buffer = m.bufferFor("")
      m.assertInvalid(server.parseHttpRequest(buffer, buffer.Count()))
    end function

    @describe("isWebSocketUpgradeRequest")

    @it("is true when all three handshake headers are present")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      request = {headers: {"Upgrade": "websocket", "Connection": "Upgrade", "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ=="}}
      m.assertTrue(server.isWebSocketUpgradeRequest(request))
    end function

    @it("is true when Connection lists Upgrade among other tokens")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      request = {headers: {"Upgrade": "WebSocket", "Connection": "keep-alive, Upgrade", "Sec-WebSocket-Key": "abc"}}
      m.assertTrue(server.isWebSocketUpgradeRequest(request))
    end function

    @it("is false when the Upgrade header is missing or wrong")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"Connection": "Upgrade", "Sec-WebSocket-Key": "abc"}}))
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"Upgrade": "h2c", "Connection": "Upgrade", "Sec-WebSocket-Key": "abc"}}))
    end function

    @it("is false when the Connection header is missing or wrong")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"Upgrade": "websocket", "Sec-WebSocket-Key": "abc"}}))
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"Upgrade": "websocket", "Connection": "keep-alive", "Sec-WebSocket-Key": "abc"}}))
    end function

    @it("is false when Sec-WebSocket-Key is missing")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"Upgrade": "websocket", "Connection": "Upgrade"}}))
    end function

    @it("is false for a plain GET with no headers")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {}}))
    end function

  end class
end namespace
