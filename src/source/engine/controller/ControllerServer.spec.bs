namespace tests
  @suite("BGE.Controller.ControllerServer")
  class ControllerServerTests extends rooibos.BaseTestSuite

    ' Only the pure request-parsing logic is covered here - the socket/HTTP/
    ' WebSocket path (including listen()/poll()/close()) needs a real
    ' roStreamSocket, which brs-cli has no support for, so it is verified by
    ' sideload instead.

    private function bufferFor(text as string) as roByteArray
      bytes = CreateObject("roByteArray")
      bytes.FromAsciiString(text)
      return bytes
    end function

    private function crlf() as string
      return chr(13) + chr(10)
    end function

    @describe("parseHttpRequest")

    @it("parses a well-formed GET request, headers included")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      text = "GET /index.html HTTP/1.1" + m.crlf() + "Host: 192.168.1.5:8888" + m.crlf() + "Upgrade: websocket" + m.crlf() + m.crlf()
      buffer = m.bufferFor(text)
      request = server.parseHttpRequest(buffer, buffer.Count())
      m.assertEqual("GET", request.command)
      m.assertEqual("/index.html", request.path)
      m.assertEqual("HTTP/1.1", request.protocol)
      ' a colon inside the value must survive header parsing
      m.assertEqual("192.168.1.5:8888", request.headers["host"])
      m.assertEqual("websocket", request.headers["upgrade"])
    end function

    @it("returns invalid for a request line with too few tokens")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      buffer = m.bufferFor("GET" + m.crlf() + m.crlf())
      m.assertInvalid(server.parseHttpRequest(buffer, buffer.Count()))
    end function

    @it("returns invalid for an empty buffer")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      buffer = m.bufferFor("")
      m.assertInvalid(server.parseHttpRequest(buffer, buffer.Count()))
    end function

    @it("skips a bare colon header line instead of crashing, and still parses the rest")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      text = "GET /index.html HTTP/1.1" + m.crlf() + ":" + m.crlf() + "Upgrade: websocket" + m.crlf() + m.crlf()
      buffer = m.bufferFor(text)
      request = server.parseHttpRequest(buffer, buffer.Count())
      m.assertEqual("GET", request.command)
      m.assertEqual("/index.html", request.path)
      m.assertEqual("websocket", request.headers["upgrade"])
    end function

    @it("stores and looks up header names case-insensitively, matching RFC 7230")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      ' A real client can send any casing - a differently-cased real browser
      ' request (e.g. Safari sends "Sec-WebSocket-Key", others vary) must
      ' still be recognized.
      text = "GET /ws HTTP/1.1" + m.crlf() + "UPGRADE: websocket" + m.crlf() + "CONNECTION: Upgrade" + m.crlf() + "sec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==" + m.crlf() + m.crlf()
      buffer = m.bufferFor(text)
      request = server.parseHttpRequest(buffer, buffer.Count())
      m.assertEqual("websocket", request.headers["upgrade"])
      m.assertEqual("Upgrade", request.headers["connection"])
      m.assertEqual("dGhlIHNhbXBsZSBub25jZQ==", request.headers["sec-websocket-key"])
      m.assertTrue(server.isWebSocketUpgradeRequest(request))
    end function

    @describe("onHttpReadable buffers a request split across multiple recv() calls")

    @it("does not misparse a request whose headers arrive across two reads as complete/malformed")
    function _()
      ' Root cause of the real WebSocket-handshake hang: onHttpReadable used
      ' to parse whatever a single socket.receive() call returned as if it
      ' were the complete request. A real browser's larger upgrade request
      ' (many headers) can arrive split across TCP segments/recv() calls -
      ' confirmed against a real device via a scripted client that split the
      ' request mid-headers, which previously produced a 404 (falling through
      ' to serveStaticFile because Sec-WebSocket-Key hadn't arrived yet)
      ' instead of the 101 upgrade response. This spec exercises the buffering
      ' fix directly: parseHttpRequest is only meaningful once the full
      ' double-CRLF-terminated header block has accumulated, which callers
      ' (onHttpReadable) are now responsible for waiting on. Since brs-cli
      ' can't fake a real socket's partial-recv() behavior, this documents the
      ' invariant at the parseHttpRequest level - fed a full header block
      ' assembled from two concatenated fragments, it must return the
      ' complete, correctly-parsed request (not a partial/malformed one).
      server = new BGE.Controller.ControllerServer(8888)
      fragment1 = "GET /ws HTTP/1.1" + m.crlf() + "Host: 192.168.1.5:8888" + m.crlf() + "Connection: Upgrade" + m.crlf()
      fragment2 = "Upgrade: websocket" + m.crlf() + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==" + m.crlf() + m.crlf()
      buffer = m.bufferFor(fragment1 + fragment2)
      request = server.parseHttpRequest(buffer, buffer.Count())
      m.assertEqual("GET", request.command)
      m.assertEqual("/ws", request.path)
      m.assertEqual("websocket", request.headers["upgrade"])
      m.assertEqual("Upgrade", request.headers["connection"])
      m.assertEqual("dGhlIHNhbXBsZSBub25jZQ==", request.headers["sec-websocket-key"])
      m.assertTrue(server.isWebSocketUpgradeRequest(request))
    end function

    @describe("httpHeaderTerminatorFound / httpBufferExceedsMax ordering")

    @it("parses a request whose size crosses CONTROLLER_HTTP_BUFFER_SIZE in the same append that completes its terminator")
    function _()
      ' onHttpReadable used to check the size cap BEFORE checking whether
      ' the header terminator had already arrived - a legitimate request
      ' whose total size crosses CONTROLLER_HTTP_BUFFER_SIZE in the exact
      ' same chunk that also completes it got wrongly closed instead of
      ' parsed. Build headers padded well past the cap (10240 bytes) that
      ' still terminate properly, and confirm the terminator-found check
      ' (which onHttpReadable now runs first) reports true, and the whole
      ' thing still parses correctly.
      server = new BGE.Controller.ControllerServer(8888)
      padding = String(11000, "x")
      text = "GET /index.html?pad=" + padding + " HTTP/1.1" + m.crlf() + "Host: 192.168.1.5:8888" + m.crlf() + m.crlf()
      buffer = m.bufferFor(text)
      m.assertTrue(buffer.Count() > 10240)
      m.assertTrue(server.httpHeaderTerminatorFound(buffer))
      request = server.parseHttpRequest(buffer, buffer.Count())
      m.assertEqual("GET", request.command)
      m.assertEqual("192.168.1.5:8888", request.headers["host"])
    end function

    @it("httpBufferExceedsMax is false at and under the cap, true once it's exceeded")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.httpBufferExceedsMax(0))
      m.assertFalse(server.httpBufferExceedsMax(10240))
      m.assertTrue(server.httpBufferExceedsMax(10241))
    end function

    @it("httpHeaderTerminatorFound is false until the double-CRLF arrives")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.httpHeaderTerminatorFound(m.bufferFor("GET / HTTP/1.1" + m.crlf() + "Host: x")))
      m.assertTrue(server.httpHeaderTerminatorFound(m.bufferFor("GET / HTTP/1.1" + m.crlf() + "Host: x" + m.crlf() + m.crlf())))
    end function

    @describe("wsBufferExceedsMax")

    @it("is false at and under the cap, true once it's exceeded")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.wsBufferExceedsMax(0))
      m.assertFalse(server.wsBufferExceedsMax(65536))
      m.assertTrue(server.wsBufferExceedsMax(65537))
    end function

    @describe("isWebSocketUpgradeRequest")

    @it("is true when all three handshake headers are present")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      request = {headers: {"upgrade": "websocket", "connection": "Upgrade", "sec-websocket-key": "dGhlIHNhbXBsZSBub25jZQ=="}} as BGE.Controller.HttpRequest
      m.assertTrue(server.isWebSocketUpgradeRequest(request))
    end function

    @it("is true when Connection lists Upgrade among other tokens")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      request = {headers: {"upgrade": "WebSocket", "connection": "keep-alive, Upgrade", "sec-websocket-key": "abc"}} as BGE.Controller.HttpRequest
      m.assertTrue(server.isWebSocketUpgradeRequest(request))
    end function

    @it("is false when the Upgrade header is missing or wrong")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"connection": "Upgrade", "sec-websocket-key": "abc"}} as BGE.Controller.HttpRequest))
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"upgrade": "h2c", "connection": "Upgrade", "sec-websocket-key": "abc"}} as BGE.Controller.HttpRequest))
    end function

    @it("is false when the Connection header is missing or wrong")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"upgrade": "websocket", "sec-websocket-key": "abc"}} as BGE.Controller.HttpRequest))
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"upgrade": "websocket", "connection": "keep-alive", "sec-websocket-key": "abc"}} as BGE.Controller.HttpRequest))
    end function

    @it("is false when Sec-WebSocket-Key is missing")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {"upgrade": "websocket", "connection": "Upgrade"}} as BGE.Controller.HttpRequest))
    end function

    @it("is false for a plain GET with no headers")
    function _()
      server = new BGE.Controller.ControllerServer(8888)
      m.assertFalse(server.isWebSocketUpgradeRequest({headers: {}} as BGE.Controller.HttpRequest))
    end function

  end class
end namespace
