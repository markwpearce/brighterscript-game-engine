namespace tests
  @suite("BGE.Controller.ControllerRegistry")
  class ControllerRegistryTests extends rooibos.BaseTestSuite

    @describe("assignPlayerIndex / releasePlayerIndex - shareFirstControllerWithRemote (default true)")

    @it("the first browser alone claims index 0")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      first = registry.assignPlayerIndex()
      m.assertEqual(0, first)
    end function

    @it("a second browser gets its own index, starting at 1, then reuses a freed one")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      first = registry.assignPlayerIndex()
      second = registry.assignPlayerIndex()
      third = registry.assignPlayerIndex()
      m.assertEqual(0, first)
      m.assertEqual(1, second)
      m.assertEqual(2, third)
      registry.releasePlayerIndex(1)
      fourth = registry.assignPlayerIndex()
      m.assertEqual(1, fourth)
    end function

    @it("a browser and the first physical remote share index 0, remote connecting first")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      remoteIndex = registry.assignPlayerIndexForRemoteId("30:1")
      browserIndex = registry.assignPlayerIndex()
      m.assertEqual(0, remoteIndex)
      m.assertEqual(0, browserIndex)
    end function

    @it("a browser and the first physical remote share index 0, browser connecting first")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      browserIndex = registry.assignPlayerIndex()
      remoteIndex = registry.assignPlayerIndexForRemoteId("30:1")
      m.assertEqual(0, browserIndex)
      m.assertEqual(0, remoteIndex)
    end function

    @it("a second physical remote still gets its own index, not the shared 0")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.assignPlayerIndex() ' browser shares 0 with the first remote below
      firstRemote = registry.assignPlayerIndexForRemoteId("30:1")
      secondRemote = registry.assignPlayerIndexForRemoteId("30:2")
      m.assertEqual(0, firstRemote)
      m.assertEqual(1, secondRemote)
    end function

    @describe("assignPlayerIndex / releasePlayerIndex - shareFirstControllerWithRemote = false")

    @it("assigns increasing indexes starting at 1, then reuses a freed one")
    function _()
      ' Index 0 is reserved for the first physical remote/gamepad - a browser
      ' connection's own pool starts at 1 (see assignPlayerIndexForRemoteId).
      registry = new BGE.Controller.ControllerRegistry()
      registry.shareFirstControllerWithRemote = false
      first = registry.assignPlayerIndex()
      second = registry.assignPlayerIndex()
      m.assertEqual(1, first)
      m.assertEqual(2, second)
      registry.releasePlayerIndex(1)
      third = registry.assignPlayerIndex()
      m.assertEqual(1, third)
    end function

    @it("reserves index 0 for the first physical remote even if a browser connects first")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.shareFirstControllerWithRemote = false
      browserIndex = registry.assignPlayerIndex()
      m.assertTrue(browserIndex >= 1)
      remoteIndex = registry.assignPlayerIndexForRemoteId("30:1")
      m.assertEqual(0, remoteIndex)
    end function

    @it("gives the browser its own index rather than sharing 0 with an already-connected remote")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.shareFirstControllerWithRemote = false
      remoteIndex = registry.assignPlayerIndexForRemoteId("30:1")
      controllerIndex = registry.assignPlayerIndex()
      m.assertEqual(0, remoteIndex)
      m.assertEqual(1, controllerIndex)
    end function

    @describe("assignPlayerIndexForRemoteId")

    @it("assigns the same index for the same remote id on repeated calls")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      first = registry.assignPlayerIndexForRemoteId("30:1")
      second = registry.assignPlayerIndexForRemoteId("30:1")
      m.assertEqual(first, second)
    end function

    @it("assigns increasing indexes for distinct remote ids")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      first = registry.assignPlayerIndexForRemoteId("30:1")
      second = registry.assignPlayerIndexForRemoteId("30:2")
      m.assertEqual(0, first)
      m.assertEqual(1, second)
    end function

    @it("shares one index pool with browser-controller assignPlayerIndex() when sharing is disabled")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.shareFirstControllerWithRemote = false
      remoteIndex = registry.assignPlayerIndexForRemoteId("30:1")
      controllerIndex = registry.assignPlayerIndex()
      m.assertEqual(0, remoteIndex)
      m.assertEqual(1, controllerIndex)
    end function

    @describe("assignPlayerIndexForRemoteId - combineRemoteInputs = true")

    @it("assigns every distinct remote id to index 0, regardless of connection order")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.combineRemoteInputs = true
      first = registry.assignPlayerIndexForRemoteId("30:1")
      second = registry.assignPlayerIndexForRemoteId("30:2")
      third = registry.assignPlayerIndexForRemoteId("WD:0")
      m.assertEqual(0, first)
      m.assertEqual(0, second)
      m.assertEqual(0, third)
    end function

    @it("still returns the same cached index for a remote id seen again")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.combineRemoteInputs = true
      first = registry.assignPlayerIndexForRemoteId("30:1")
      second = registry.assignPlayerIndexForRemoteId("30:1")
      m.assertEqual(0, first)
      m.assertEqual(0, second)
    end function

    @it("does not change browser-controller assignPlayerIndex() behavior (still shares index 0 by default)")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.combineRemoteInputs = true
      registry.assignPlayerIndexForRemoteId("30:1")
      registry.assignPlayerIndexForRemoteId("30:2")
      browserIndex = registry.assignPlayerIndex()
      m.assertEqual(0, browserIndex)
    end function

    @it("does not change browser-controller assignPlayerIndex() behavior when sharing is also disabled")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.combineRemoteInputs = true
      registry.shareFirstControllerWithRemote = false
      registry.assignPlayerIndexForRemoteId("30:1")
      registry.assignPlayerIndexForRemoteId("30:2")
      browserIndex = registry.assignPlayerIndex()
      m.assertEqual(1, browserIndex)
    end function

    @describe("updateFromMessage")

    @it("returns the names of buttons that changed since last update")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      changed = registry.updateFromMessage(playerIndex, {a: true, b: false}, {}, {})
      m.assertEqual(1, changed.Count())
      m.assertEqual("a", changed[0])
    end function

    @it("reports no change when the same buttons are sent again")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: true, b: false}, {}, {})
      changed = registry.updateFromMessage(playerIndex, {a: true, b: false}, {}, {})
      m.assertEqual(0, changed.Count())
    end function

    @it("isButtonHeld reflects the latest message")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: false, b: true}, {}, {})
      m.assertTrue(registry.isButtonHeld(playerIndex, "b"))
      m.assertFalse(registry.isButtonHeld(playerIndex, "a"))
    end function

    @it("isButtonHeld is false for a name never reported")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      m.assertFalse(registry.isButtonHeld(playerIndex, "nope"))
    end function

    @describe("getButtonNames")

    @it("reflects the last message's button names, empty for a never-seen player")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      m.assertEqual(0, registry.getButtonNames(playerIndex).Count())
      registry.updateFromMessage(playerIndex, {a: false, b: false, c: true}, {}, {})
      m.assertEqual(3, registry.getButtonNames(playerIndex).Count())
      m.assertEqual(0, registry.getButtonNames(playerIndex + 1).Count())
    end function

    @describe("sticks")

    @it("stores each named stick's {x, y}")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.5, y: -0.5}, "2": {x: 1.0, y: -1.0}}, {})
      stick1 = registry.getStick(playerIndex, "1")
      stick2 = registry.getStick(playerIndex, "2")
      m.assertEqual(0.5, stick1.x)
      m.assertEqual(-0.5, stick1.y)
      m.assertEqual(1.0, stick2.x)
      m.assertEqual(-1.0, stick2.y)
    end function

    @it("returns a neutral vector for a stick name never reported")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      stick = registry.getStick(playerIndex, "nope")
      m.assertEqual(0.0, stick.x)
      m.assertEqual(0.0, stick.y)
    end function

    @it("resets a stick to neutral when a later message omits it")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.5, y: -0.5}}, {})
      registry.updateFromMessage(playerIndex, {}, {}, {})
      stick1 = registry.getStick(playerIndex, "1")
      m.assertEqual(0.0, stick1.x)
      m.assertEqual(0.0, stick1.y)
    end function

    @describe("getHeldTimeMs")

    @it("returns 0 for a never-pressed button")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: false, b: false}, {}, {})
      m.assertEqual(0, registry.getHeldTimeMs(playerIndex, "a"))
      m.assertEqual(0, registry.getHeldTimeMs(playerIndex, "b"))
    end function

    @it("returns 0 after a button is released")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: true}, {}, {})
      registry.updateFromMessage(playerIndex, {a: false}, {}, {})
      m.assertEqual(0, registry.getHeldTimeMs(playerIndex, "a"))
    end function

    @it("returns a non-zero value for a currently-held button")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: true}, {}, {})
      heldTime = registry.getHeldTimeMs(playerIndex, "a")
      m.assertTrue(heldTime >= 0)
      m.assertTrue(registry.isButtonHeld(playerIndex, "a"))
    end function

    @describe("button dropped from a later message")

    @it("cleans up held timers when a button disappears, avoiding state leak")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: false, b: false, c: true}, {}, {})
      m.assertTrue(registry.isButtonHeld(playerIndex, "c"))
      registry.updateFromMessage(playerIndex, {a: false}, {}, {})
      m.assertFalse(registry.isButtonHeld(playerIndex, "c"))
      m.assertEqual(0, registry.getHeldTimeMs(playerIndex, "c"))
    end function

    @it("reports a dropped button as changed, so a release event still fires")
    function _()
      ' A button held true in a previous message that simply isn't present in a later
      ' message must still surface in `changed` - a later isButtonHeld() lookup already
      ' reports it correctly released, but nothing driven by change events (e.g.
      ' ControlMap) would ever see the release without this.
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: false, b: false, c: true}, {}, {})
      changed = registry.updateFromMessage(playerIndex, {a: false}, {}, {})
      m.assertEqual(1, changed.Count())
      m.assertEqual("c", changed[0])
    end function

    @describe("malformed message elements")

    @it("coerces a non-boolean button element to false instead of propagating it")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      changed = registry.updateFromMessage(playerIndex, {a: true, b: "not-a-bool", c: 5}, {}, {})
      m.assertTrue(registry.isButtonHeld(playerIndex, "a"))
      m.assertFalse(registry.isButtonHeld(playerIndex, "b"))
      m.assertFalse(registry.isButtonHeld(playerIndex, "c"))
      m.assertEqual(1, changed.Count())
      m.assertEqual("a", changed[0])
    end function

    @it("coerces a non-numeric stick axis to 0.0 instead of propagating it")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.5, y: "not-a-number"}}, {})
      stick1 = registry.getStick(playerIndex, "1")
      m.assertEqual(0.5, stick1.x)
      m.assertEqual(0.0, stick1.y)
    end function

    @it("ignores a malformed stick value that isn't an {x, y} object")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {"1": "not-an-object"}, {})
      stick1 = registry.getStick(playerIndex, "1")
      m.assertEqual(0.0, stick1.x)
      m.assertEqual(0.0, stick1.y)
    end function

    @describe("custom payload")

    @it("stores and returns the latest custom payload")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {}, {slider: 42})
      m.assertEqual(42, registry.getCustomPayload(playerIndex).slider)
    end function

    @it("returns an empty object for a player with no custom payload sent yet")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      m.assertEqual(0, registry.getCustomPayload(playerIndex).Count())
    end function

    @describe("remote d-pad fallback state (per player)")

    @it("stores and returns the remote d-pad vector for a given player")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.setRemoteDpad(0, 1, 0)
      dpad = registry.getRemoteDpad(0)
      m.assertEqual(1.0, dpad.x)
      m.assertEqual(0.0, dpad.y)
    end function

    @it("keeps two players' d-pad state independent")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.setRemoteDpad(0, 1, 0)
      registry.setRemoteDpad(1, 0, -1)
      m.assertEqual(1.0, registry.getRemoteDpad(0).x)
      m.assertEqual(0.0, registry.getRemoteDpad(0).y)
      m.assertEqual(0.0, registry.getRemoteDpad(1).x)
      m.assertEqual(-1.0, registry.getRemoteDpad(1).y)
    end function

    @it("returns a neutral vector for a player never set")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      dpad = registry.getRemoteDpad(0)
      m.assertEqual(0.0, dpad.x)
      m.assertEqual(0.0, dpad.y)
    end function

    @describe("getRemoteAnalogStick")

    @it("returns a neutral vector when no event has been cached for this player")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      stick = registry.getRemoteAnalogStick(0)
      m.assertEqual(0.0, stick.x)
      m.assertEqual(0.0, stick.y)
    end function

    @it("reads GetValue(leftX/leftY) off the cached event when multi_controllers is supported, flipping Y to world space")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      fakeEvent = {
        GetRemoteID: function() as string
          return "BT:1" ' RemoteType.BT (Bluetooth gamepad) - see brs-engine's RemoteType enum
        end function,
        GetValue: function(axis as integer) as float
          if axis = BGE.Controller.ANALOG_AXIS_LEFT_X
            return 0.75
          end if
          if axis = BGE.Controller.ANALOG_AXIS_LEFT_Y
            return -0.25 ' GetValue()'s raw Gamepad API convention: negative = up
          end if
          return 0.0
        end function
      }
      registry.setRemoteEvent(0, fakeEvent)
      stick = registry.getRemoteAnalogStick(0)
      ' roRemoteInfo.HasFeature("multi_controllers", 0) is true under brs-node 2.6.0; Y flips to +0.25 (world space).
      m.assertEqual(0.75, stick.x)
      m.assertEqual(0.25, stick.y)
    end function

    @it("reads GetValue(rightX/rightY) when stick 2 is requested, leaving the left stick's reading unused")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      fakeEvent = {
        GetRemoteID: function() as string
          return "BT:1"
        end function,
        GetValue: function(axis as integer) as float
          if axis = BGE.Controller.ANALOG_AXIS_LEFT_X or axis = BGE.Controller.ANALOG_AXIS_LEFT_Y
            return 0.9 ' should never be read for a stick="2" request
          end if
          if axis = BGE.Controller.ANALOG_AXIS_RIGHT_X
            return 0.4
          end if
          if axis = BGE.Controller.ANALOG_AXIS_RIGHT_Y
            return -0.6
          end if
          return 0.0
        end function
      }
      registry.setRemoteEvent(0, fakeEvent)
      stick = registry.getRemoteAnalogStick(0, "2")
      m.assertEqual(0.4, stick.x)
      m.assertEqual(0.6, stick.y)
    end function

    @it("returns neutral for a value within the resting-drift deadzone")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      fakeEvent = {
        GetRemoteID: function() as string
          return "BT:1"
        end function,
        GetValue: function(axis as integer) as float
          if axis = BGE.Controller.ANALOG_AXIS_LEFT_X
            return 0.05
          end if
          if axis = BGE.Controller.ANALOG_AXIS_LEFT_Y
            return -0.05
          end if
          return 0.0
        end function
      }
      registry.setRemoteEvent(0, fakeEvent)
      stick = registry.getRemoteAnalogStick(0)
      m.assertEqual(0.0, stick.x)
      m.assertEqual(0.0, stick.y)
    end function

    @it("is neutral for a different player index than the one an event was cached for")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      fakeEvent = {
        GetRemoteID: function() as string
          return "BT:1"
        end function,
        GetValue: function(axis as integer) as float
          return 0.5
        end function
      }
      registry.setRemoteEvent(0, fakeEvent)
      stick = registry.getRemoteAnalogStick(1)
      m.assertEqual(0.0, stick.x)
      m.assertEqual(0.0, stick.y)
    end function

    @it("is neutral for a non-Bluetooth remote (e.g. keyboard-sim) even though GetValue() returns nonzero")
    function _()
      ' brs-engine's GetValue() falls back to a non-directional 1.0/0.0
      ' "is anything pressed" signal for any remote that isn't a tracked
      ' Bluetooth gamepad (RoUniversalControlEvent.getFloatValue) - trusting
      ' it here would make every keyboard-sim button press look like a
      ' constant stick deflection, permanently overriding the d-pad
      ' fallback (issue #220's simulator repro).
      registry = new BGE.Controller.ControllerRegistry()
      fakeEvent = {
        GetRemoteID: function() as string
          return "WD:0" ' RemoteType.WD (keyboard simulation)
        end function,
        GetValue: function(axis as integer) as float
          return 1.0
        end function
      }
      registry.setRemoteEvent(0, fakeEvent)
      stick = registry.getRemoteAnalogStick(0)
      m.assertEqual(0.0, stick.x)
      m.assertEqual(0.0, stick.y)
    end function

    @it("does not let a later keyboard-sim event evict an already-cached gamepad event")
    function _()
      ' Under combineRemoteInputs, a keyboard and a gamepad share one
      ' playerIndex. A held-but-unchanging analog stick produces no new
      ' roUniversalControlEvent of its own, so if a keyboard press were
      ' allowed to overwrite the cached gamepad event, the gamepad would
      ' become permanently unreadable until it sent another discrete event.
      registry = new BGE.Controller.ControllerRegistry()
      gamepadEvent = {
        GetRemoteID: function() as string
          return "BT:1"
        end function,
        GetValue: function(axis as integer) as float
          if axis = BGE.Controller.ANALOG_AXIS_LEFT_X
            return 0.6
          end if
          return 0.0
        end function
      }
      keyboardEvent = {
        GetRemoteID: function() as string
          return "WD:0"
        end function,
        GetValue: function(axis as integer) as float
          return 1.0
        end function
      }
      registry.setRemoteEvent(0, gamepadEvent)
      registry.setRemoteEvent(0, keyboardEvent)
      stick = registry.getRemoteAnalogStick(0)
      m.assertEqual(0.6, stick.x)
    end function

  end class
end namespace
