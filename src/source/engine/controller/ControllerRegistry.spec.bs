namespace tests
  @suite("BGE.Controller.ControllerRegistry")
  class ControllerRegistryTests extends rooibos.BaseTestSuite

    @describe("assignPlayerIndex / releasePlayerIndex")

    @it("assigns increasing indexes, then reuses a freed one")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      first = registry.assignPlayerIndex()
      second = registry.assignPlayerIndex()
      m.assertEqual(0, first)
      m.assertEqual(1, second)
      registry.releasePlayerIndex(0)
      third = registry.assignPlayerIndex()
      m.assertEqual(0, third)
    end function

    @describe("updateFromMessage")

    @it("returns the names of buttons that changed since last update")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      changed = registry.updateFromMessage(playerIndex, {a: true, b: false}, {}, {})
      m.assertEqual(1, changed.Count())
      m.assertEqual("a", changed[0])
    end function

    @it("reports no change when the same buttons are sent again")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: true, b: false}, {}, {})
      changed = registry.updateFromMessage(playerIndex, {a: true, b: false}, {}, {})
      m.assertEqual(0, changed.Count())
    end function

    @it("isButtonHeld reflects the latest message")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: false, b: true}, {}, {})
      m.assertTrue(registry.isButtonHeld(playerIndex, "b"))
      m.assertFalse(registry.isButtonHeld(playerIndex, "a"))
    end function

    @it("isButtonHeld is false for a name never reported")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      m.assertFalse(registry.isButtonHeld(playerIndex, "nope"))
    end function

    @describe("getButtonNames")

    @it("reflects the last message's button names, empty for a never-seen player")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      m.assertEqual(0, registry.getButtonNames(playerIndex).Count())
      registry.updateFromMessage(playerIndex, {a: false, b: false, c: true}, {}, {})
      m.assertEqual(3, registry.getButtonNames(playerIndex).Count())
      m.assertEqual(0, registry.getButtonNames(playerIndex + 1).Count())
    end function

    @describe("sticks")

    @it("stores each named stick's {x, y}")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.5, y: -0.5}, "2": {x: 1.0, y: -1.0}}, {})
      stick1 = registry.getStick(playerIndex, "1")
      stick2 = registry.getStick(playerIndex, "2")
      m.assertEqual(0.5, stick1.x)
      m.assertEqual(-0.5, stick1.y)
      m.assertEqual(1.0, stick2.x)
      m.assertEqual(-1.0, stick2.y)
    end function

    @it("returns a neutral vector for a stick name never reported")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      stick = registry.getStick(playerIndex, "nope")
      m.assertEqual(0.0, stick.x)
      m.assertEqual(0.0, stick.y)
    end function

    @it("resets a stick to neutral when a later message omits it")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.5, y: -0.5}}, {})
      registry.updateFromMessage(playerIndex, {}, {}, {})
      stick1 = registry.getStick(playerIndex, "1")
      m.assertEqual(0.0, stick1.x)
      m.assertEqual(0.0, stick1.y)
    end function

    @describe("getHeldTimeMs")

    @it("returns 0 for a never-pressed button")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: false, b: false}, {}, {})
      m.assertEqual(0, registry.getHeldTimeMs(playerIndex, "a"))
      m.assertEqual(0, registry.getHeldTimeMs(playerIndex, "b"))
    end function

    @it("returns 0 after a button is released")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: true}, {}, {})
      registry.updateFromMessage(playerIndex, {a: false}, {}, {})
      m.assertEqual(0, registry.getHeldTimeMs(playerIndex, "a"))
    end function

    @it("returns a non-zero value for a currently-held button")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: true}, {}, {})
      heldTime = registry.getHeldTimeMs(playerIndex, "a")
      m.assertTrue(heldTime >= 0)
      m.assertTrue(registry.isButtonHeld(playerIndex, "a"))
    end function

    @describe("button dropped from a later message")

    @it("cleans up held timers when a button disappears, avoiding state leak")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: false, b: false, c: true}, {}, {})
      m.assertTrue(registry.isButtonHeld(playerIndex, "c"))
      registry.updateFromMessage(playerIndex, {a: false}, {}, {})
      m.assertFalse(registry.isButtonHeld(playerIndex, "c"))
      m.assertEqual(0, registry.getHeldTimeMs(playerIndex, "c"))
    end function

    @it("reports a dropped button as changed, so a release event still fires")
    function _()
      ' A button held true in a previous message that simply isn't present in a later
      ' message must still surface in `changed` - a later isButtonHeld() lookup already
      ' reports it correctly released, but nothing driven by change events (e.g.
      ' ControlMap) would ever see the release without this.
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {a: false, b: false, c: true}, {}, {})
      changed = registry.updateFromMessage(playerIndex, {a: false}, {}, {})
      m.assertEqual(1, changed.Count())
      m.assertEqual("c", changed[0])
    end function

    @describe("malformed message elements")

    @it("coerces a non-boolean button element to false instead of propagating it")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      changed = registry.updateFromMessage(playerIndex, {a: true, b: "not-a-bool", c: 5}, {}, {})
      m.assertTrue(registry.isButtonHeld(playerIndex, "a"))
      m.assertFalse(registry.isButtonHeld(playerIndex, "b"))
      m.assertFalse(registry.isButtonHeld(playerIndex, "c"))
      m.assertEqual(1, changed.Count())
      m.assertEqual("a", changed[0])
    end function

    @it("coerces a non-numeric stick axis to 0.0 instead of propagating it")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {"1": {x: 0.5, y: "not-a-number"}}, {})
      stick1 = registry.getStick(playerIndex, "1")
      m.assertEqual(0.5, stick1.x)
      m.assertEqual(0.0, stick1.y)
    end function

    @it("ignores a malformed stick value that isn't an {x, y} object")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {"1": "not-an-object"}, {})
      stick1 = registry.getStick(playerIndex, "1")
      m.assertEqual(0.0, stick1.x)
      m.assertEqual(0.0, stick1.y)
    end function

    @describe("custom payload")

    @it("stores and returns the latest custom payload")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      registry.updateFromMessage(playerIndex, {}, {}, {slider: 42})
      m.assertEqual(42, registry.getCustomPayload(playerIndex).slider)
    end function

    @it("returns an empty object for a player with no custom payload sent yet")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      playerIndex = registry.assignPlayerIndex()
      m.assertEqual(0, registry.getCustomPayload(playerIndex).Count())
    end function

    @describe("remote d-pad fallback state")

    @it("stores and returns the remote d-pad vector")
    function _()
      registry = new BGE.Controller.ControllerRegistry()
      registry.setRemoteDpad(1, 0)
      dpad = registry.getRemoteDpad()
      m.assertEqual(1.0, dpad.x)
      m.assertEqual(0.0, dpad.y)
    end function

  end class
end namespace
