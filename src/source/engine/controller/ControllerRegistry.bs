import "../../math/vector.bs"
import "../../roku_modules/rodash/rodash.d.bs"

namespace BGE.Controller

  ' Internal per-connection controller state (buttons/sticks/held-timers/custom
  ' payload) plus the remote's own d-pad fallback state. Not part of the public
  ' API - a game uses BGE.Controller.ControlMap (game.controls) instead.
  class ControllerConnectionState
    buttons = {} ' name -> boolean
    heldTimers = {} ' name -> roTimespan, present only while held
    sticks = {} ' name -> BGE.Math.Vector
    custom = {} ' latest raw `custom` payload, untouched
  end class

  class ControllerRegistry
    private connections = {} ' playerIndex.ToStr() -> ControllerConnectionState
    private remoteDpad as BGE.Math.Vector = BGE.Math.VectorOps.create()

    ' Assigns the lowest player index not currently in use.
    function assignPlayerIndex() as integer
      index = 0
      while m.connections.DoesExist(index.ToStr())
        index++
      end while
      m.connections[index.ToStr()] = new BGE.Controller.ControllerConnectionState()
      return index
    end function

    ' Frees a player index previously returned by assignPlayerIndex(), e.g.
    ' when its connection closes - a later assignPlayerIndex() call may
    ' reuse it.
    '
    ' @param {integer} playerIndex - the player index to release
    sub releasePlayerIndex(playerIndex as integer)
      m.connections.Delete(playerIndex.ToStr())
    end sub

    ' Updates one connection's raw state from a decoded {buttons, sticks, custom}
    ' message. Returns the button names whose boolean flipped since the last
    ' update, for Game to synthesize press/release GameInput events. The
    ' message is untrusted - a non-boolean button or non-numeric stick axis is
    ' coerced to a safe default (false / 0.0) rather than propagating whatever
    ' ParseJson happened to hand back.
    '
    ' @param {integer} playerIndex
    ' @param {object} buttons - name -> dynamic (expected boolean)
    ' @param {object} sticks - name -> {x, y} (each dynamic, expected numeric)
    ' @param {object} custom - opaque, passed through untouched
    ' @return {string[]}
    function updateFromMessage(playerIndex as integer, buttons as object, sticks as object, custom as object) as string[]
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return []
      end if
      sanitizedButtons = {}
      for each name in buttons
        sanitizedButtons[name] = m.asBoolean(buttons[name])
      end for
      ' Scan the union of old/new names - a button that dropped out of a later
      ' message must still emit a release, or it can appear permanently "held"
      ' forever to anything driven by change events (e.g. ControlMap), even
      ' though isButtonHeld/getHeldTimeMs already report it correctly released
      ' via their own lookups.
      changed = []
      allNames = {}
      for each name in state.buttons
        allNames[name] = true
      end for
      for each name in sanitizedButtons
        allNames[name] = true
      end for
      for each name in allNames
        previous = m.asBoolean(state.buttons[name])
        current = m.asBoolean(sanitizedButtons[name])
        if previous <> current
          changed.Push(name)
          if current
            timer = CreateObject("roTimespan")
            timer.Mark()
            state.heldTimers[name] = timer
          else
            state.heldTimers.Delete(name)
          end if
        end if
      end for
      state.buttons = sanitizedButtons
      sanitizedSticks = {}
      for each name in sticks
        raw = sticks[name]
        x = 0.0
        y = 0.0
        if raw <> invalid and GetInterface(raw, "ifAssociativeArray") <> invalid
          x = m.asFloat(raw.x)
          y = m.asFloat(raw.y)
        end if
        sanitizedSticks[name] = BGE.Math.VectorOps.create(x, y)
      end for
      state.sticks = sanitizedSticks
      state.custom = custom
      return changed
    end function

    ' @param {integer} playerIndex - which player's connection to read
    ' @param {string} buttonName - which button to check
    ' @return {boolean} - true if this button was reported held in the
    '   last message, false if it wasn't (or the name/player is unknown)
    function isButtonHeld(playerIndex as integer, buttonName as string) as boolean
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return false
      end if
      return state.buttons[buttonName] = true
    end function

    ' @param {integer} playerIndex - which player's connection to read
    ' @param {string} buttonName - which button to check
    ' @return {integer} - how many milliseconds this button has been
    '   continuously held, 0 if it's not currently held (or never was)
    function getHeldTimeMs(playerIndex as integer, buttonName as string) as integer
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return 0
      end if
      timer = state.heldTimers[buttonName]
      if timer = invalid
        return 0
      end if
      return timer.TotalMilliseconds()
    end function

    ' @param {integer} playerIndex
    ' @return {string[]} - names of every button last reported for this
    '   player (empty if never seen), so Game can scan without assuming a
    '   fixed set.
    function getButtonNames(playerIndex as integer) as string[]
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return []
      end if
      return state.buttons.Keys()
    end function

    ' @return {boolean} - value if it's actually a boolean, else false
    private function asBoolean(value as dynamic) as boolean
      if rodash.isBoolean(value)
        return value
      end if
      return false
    end function

    ' @return {float} - value if it's actually numeric, else 0.0
    private function asFloat(value as dynamic) as float
      if rodash.isNumber(value)
        return value
      end if
      return 0.0
    end function

    ' @param {integer} playerIndex - which player's connection to read
    ' @param {string} stickName - the stick's name, as sent in the message's `sticks` map
    ' @return {BGE.Math.Vector} - the stick's current {x, y}, {0, 0} if
    '   never reported or the player is unknown
    function getStick(playerIndex as integer, stickName as string) as BGE.Math.Vector
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return BGE.Math.VectorOps.create()
      end if
      return state.sticks[stickName] ?? BGE.Math.VectorOps.create()
    end function

    ' @param {integer} playerIndex
    ' @return {object} - the latest `custom` payload for this player, {} if
    '   never sent or the player is unknown
    function getCustomPayload(playerIndex as integer) as object
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return {}
      end if
      return state.custom
    end function

    ' Records the remote control's own d-pad fallback state, used by
    ' BGE.Controller.ControlMap.getAxis() when no controller is bound.
    '
    ' @param {float} x - -1..1
    ' @param {float} y - -1..1
    sub setRemoteDpad(x as float, y as float)
      m.remoteDpad = BGE.Math.VectorOps.create(x, y)
    end sub

    ' @return {BGE.Math.Vector} - the remote d-pad's current {x, y}, as
    '   last set by setRemoteDpad()
    function getRemoteDpad() as BGE.Math.Vector
      return m.remoteDpad
    end function

  end class

end namespace
