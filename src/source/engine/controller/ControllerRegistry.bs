import "../../math/vector.bs"
import "../../roku_modules/rodash/rodash.d.bs"

namespace BGE.Controller

  ' Axis indexes for roUniversalControlEvent.GetValue(axis) - brs-engine's
  ' AnalogAxis enum (simulator-only extension, PR lvcabral/brs-engine#1226).
  const ANALOG_AXIS_LEFT_X = 0
  const ANALOG_AXIS_LEFT_Y = 1
  const ANALOG_AXIS_RIGHT_X = 2
  const ANALOG_AXIS_RIGHT_Y = 3

  ' GetRemoteID() prefix for a brs-engine RemoteType.BT (Bluetooth gamepad)
  ' remote - the only remote type GetValue() returns real per-axis analog
  ' data for. GetRemoteID() returns the enum NAME, not its numeric value
  ' (see brs-engine's BrsDevice.updateKeysBuffer(), `RemoteType[remoteType]`)
  ' - "BT:1", not "30:1". Any other remote (e.g. "WD:0" keyboard-sim) gets a
  ' non-directional 1.0/0.0 "is anything pressed" fallback from GetValue()
  ' instead (RoUniversalControlEvent.getFloatValue in brs-engine), which
  ' would otherwise be misread as real stick input and permanently override
  ' the d-pad fallback the instant any button is held.
  const BLUETOOTH_GAMEPAD_REMOTE_ID_PREFIX = "BT:"

  ' Below this magnitude, a real gamepad's resting-stick drift is treated as
  ' neutral rather than a real deflection - otherwise it would permanently
  ' preempt the remote d-pad fallback in ControlMap.getAxis(). Scoped to
  ' controller input only; unrelated to BGE.UI.CURSOR_ANALOG_DEADZONE.
  const ANALOG_DEADZONE = 0.15

  ' Internal per-connection controller state (buttons/sticks/held-timers/custom
  ' payload) plus the remote's own d-pad fallback state. Not part of the public
  ' API - a game uses BGE.Controller.ControlMap (game.controls) instead.
  class ControllerConnectionState
    buttons = {} ' name -> boolean
    heldTimers = {} ' name -> roTimespan, present only while held
    sticks = {} ' name -> BGE.Math.Vector
    custom = {} ' latest raw `custom` payload, untouched
  end class

  class ControllerRegistry
    private connections = {} ' playerIndex.ToStr() -> ControllerConnectionState
    private remoteIdToPlayerIndex = {} ' remoteId (GetRemoteID() string) -> playerIndex
    private remoteDpad = {} ' playerIndex.ToStr() -> BGE.Math.Vector
    private remoteEvents = {} ' playerIndex.ToStr() -> last-seen roUniversalControlEvent (dynamic)
    private multiControllersSupported as dynamic = invalid ' cached HasFeature() check, invalid = not yet checked

    ' Default true - the first browser shares playerIndex 0 with the first
    ' remote/gamepad, so a default bindAction(playerIndex=0) fires for
    ' either. Set false to give every input source its own index instead
    ' (see Game.enableControllerInput()).
    shareFirstControllerWithRemote as boolean = true

    ' Default false - each distinct remote/gamepad gets its own stable
    ' index. Set true to force every one onto index 0 regardless of
    ' connect/input order (see Game.setCombineRemoteInputs()). Independent
    ' of shareFirstControllerWithRemote, which only affects browser
    ' connections.
    combineRemoteInputs as boolean = false

    ' Assigns the lowest free player index to a browser controller connection.
    ' With shareFirstControllerWithRemote (default), the first browser claims
    ' index 0, shared with the first remote/gamepad regardless of connection
    ' order (see assignPlayerIndexForRemoteId); only a second browser onward
    ' gets its own index starting at 1.
    function assignPlayerIndex() as integer
      if m.shareFirstControllerWithRemote and not m.connections.DoesExist("0")
        index = 0
      else
        index = m.lowestFreeIndex(1)
      end if
      m.connections[index.ToStr()] = new BGE.Controller.ControllerConnectionState()
      return index
    end function

    ' Frees a player index previously returned by assignPlayerIndex(), e.g.
    ' when its connection closes - a later assignPlayerIndex() call may
    ' reuse it.
    '
    ' @param {integer} playerIndex - the player index to release
    sub releasePlayerIndex(playerIndex as integer)
      m.connections.Delete(playerIndex.ToStr())
    end sub

    ' Looks up (or lazily assigns) a stable playerIndex for one physical
    ' remote/gamepad, identified by roUniversalControlEvent.GetRemoteID()
    ' (e.g. "30:1"). Never released - a physical remote has no disconnect
    ' signal to key a release off, unlike a browser controller's WebSocket
    ' close. With shareFirstControllerWithRemote (default), the first
    ' remote/gamepad claims index 0 even if a browser already occupies it
    ' too (see assignPlayerIndex). With combineRemoteInputs, every remote/
    ' gamepad is forced onto index 0 instead.
    '
    ' @param {string} remoteId - the string from roUniversalControlEvent.GetRemoteID()
    ' @return {integer} - this remote's playerIndex, stable for the run
    function assignPlayerIndexForRemoteId(remoteId as string) as integer
      existing = m.remoteIdToPlayerIndex[remoteId]
      if existing <> invalid
        return existing
      end if
      if m.combineRemoteInputs
        index = 0
      else if m.shareFirstControllerWithRemote and not m.isRemoteIndex(0)
        index = 0
      else
        index = m.lowestFreeIndex(0)
      end if
      m.remoteIdToPlayerIndex[remoteId] = index
      return index
    end function

    ' @param {integer} startAt - lowest index to consider (0 for a physical
    '   remote/gamepad scan, 1 for a browser-connection scan - see
    '   assignPlayerIndex/assignPlayerIndexForRemoteId)
    private function lowestFreeIndex(startAt as integer) as integer
      index = startAt
      while m.connections.DoesExist(index.ToStr()) or m.isRemoteIndex(index)
        index++
      end while
      return index
    end function

    private function isRemoteIndex(index as integer) as boolean
      for each remoteId in m.remoteIdToPlayerIndex
        if m.remoteIdToPlayerIndex[remoteId] = index
          return true
        end if
      end for
      return false
    end function

    ' Updates one connection's raw state from a decoded {buttons, sticks, custom}
    ' message. Returns the button names whose boolean flipped since the last
    ' update, for Game to synthesize press/release GameInput events. The
    ' message is untrusted - a non-boolean button or non-numeric stick axis is
    ' coerced to a safe default (false / 0.0) rather than propagating whatever
    ' ParseJson happened to hand back.
    '
    ' @param {integer} playerIndex
    ' @param {object} buttons - name -> dynamic (expected boolean)
    ' @param {object} sticks - name -> {x, y} (each dynamic, expected numeric)
    ' @param {object} custom - opaque, passed through untouched
    ' @return {string[]}
    function updateFromMessage(playerIndex as integer, buttons as object, sticks as object, custom as object) as string[]
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return []
      end if
      sanitizedButtons = {}
      for each name in buttons
        sanitizedButtons[name] = m.asBoolean(buttons[name])
      end for
      ' Scan the union of old/new names - a button that dropped out of a later
      ' message must still emit a release, or it can appear permanently "held"
      ' forever to anything driven by change events (e.g. ControlMap), even
      ' though isButtonHeld/getHeldTimeMs already report it correctly released
      ' via their own lookups.
      changed = []
      allNames = {}
      for each name in state.buttons
        allNames[name] = true
      end for
      for each name in sanitizedButtons
        allNames[name] = true
      end for
      for each name in allNames
        previous = m.asBoolean(state.buttons[name])
        current = m.asBoolean(sanitizedButtons[name])
        if previous <> current
          changed.Push(name)
          if current
            timer = CreateObject("roTimespan")
            timer.Mark()
            state.heldTimers[name] = timer
          else
            state.heldTimers.Delete(name)
          end if
        end if
      end for
      state.buttons = sanitizedButtons
      sanitizedSticks = {}
      for each name in sticks
        raw = sticks[name]
        x = 0.0
        y = 0.0
        if raw <> invalid and GetInterface(raw, "ifAssociativeArray") <> invalid
          x = m.asFloat(raw.x)
          y = m.asFloat(raw.y)
        end if
        sanitizedSticks[name] = BGE.Math.VectorOps.create(x, y)
      end for
      state.sticks = sanitizedSticks
      state.custom = custom
      return changed
    end function

    ' @param {integer} playerIndex - which player's connection to read
    ' @param {string} buttonName - which button to check
    ' @return {boolean} - true if this button was reported held in the
    '   last message, false if it wasn't (or the name/player is unknown)
    function isButtonHeld(playerIndex as integer, buttonName as string) as boolean
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return false
      end if
      return state.buttons[buttonName] = true
    end function

    ' @param {integer} playerIndex - which player's connection to read
    ' @param {string} buttonName - which button to check
    ' @return {integer} - how many milliseconds this button has been
    '   continuously held, 0 if it's not currently held (or never was)
    function getHeldTimeMs(playerIndex as integer, buttonName as string) as integer
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return 0
      end if
      timer = state.heldTimers[buttonName]
      if timer = invalid
        return 0
      end if
      return timer.TotalMilliseconds()
    end function

    ' @param {integer} playerIndex
    ' @return {string[]} - names of every button last reported for this
    '   player (empty if never seen), so Game can scan without assuming a
    '   fixed set.
    function getButtonNames(playerIndex as integer) as string[]
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return []
      end if
      return state.buttons.Keys()
    end function

    ' @return {boolean} - value if it's actually a boolean, else false
    private function asBoolean(value as dynamic) as boolean
      if rodash.isBoolean(value)
        return value
      end if
      return false
    end function

    ' @return {float} - value if it's actually numeric, else 0.0
    private function asFloat(value as dynamic) as float
      if rodash.isNumber(value)
        return value
      end if
      return 0.0
    end function

    ' @param {integer} playerIndex - which player's connection to read
    ' @param {string} stickName - the stick's name, as sent in the message's `sticks` map
    ' @return {BGE.Math.Vector} - the stick's current {x, y}, {0, 0} if
    '   never reported or the player is unknown
    function getStick(playerIndex as integer, stickName as string) as BGE.Math.Vector
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return BGE.Math.VectorOps.create()
      end if
      return state.sticks[stickName] ?? BGE.Math.VectorOps.create()
    end function

    ' @param {integer} playerIndex
    ' @return {object} - the latest `custom` payload for this player, {} if
    '   never sent or the player is unknown
    function getCustomPayload(playerIndex as integer) as object
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return {}
      end if
      return state.custom
    end function

    ' Records one physical remote/gamepad's current d-pad-derived {x, y},
    ' used by BGE.Controller.ControlMap.getAxis() when no controller stick
    ' is bound (or it's neutral) for this player.
    '
    ' @param {integer} playerIndex
    ' @param {float} x - -1..1
    ' @param {float} y - -1..1
    sub setRemoteDpad(playerIndex as integer, x as float, y as float)
      m.remoteDpad[playerIndex.ToStr()] = BGE.Math.VectorOps.create(x, y)
    end sub

    ' @param {integer} playerIndex
    ' @return {BGE.Math.Vector} - this player's remote d-pad {x, y}, neutral if never set
    function getRemoteDpad(playerIndex as integer) as BGE.Math.Vector
      return m.remoteDpad[playerIndex.ToStr()] ?? BGE.Math.VectorOps.create()
    end function

    ' Caches the last Bluetooth-gamepad roUniversalControlEvent seen for this
    ' player, so getRemoteAnalogStick() can keep reading its live GetValue()
    ' every frame even on a frame with no new event for this remote (a stick
    ' held at a nonzero deflection produces no new roUniversalControlEvent -
    ' see specs/2026-09-15-multi-controller-input-design.md). A non-gamepad
    ' event (e.g. keyboard-sim) is ignored here rather than overwriting an
    ' already-cached gamepad event - under combineRemoteInputs, where both
    ' share one playerIndex, caching indiscriminately would let a keyboard
    ' press evict the gamepad's slot, and a held-but-unchanging analog stick
    ' has no later event of its own to reclaim it.
    '
    ' @param {integer} playerIndex
    ' @param {dynamic} event - the roUniversalControlEvent, passed as dynamic
    '   since GetValue() isn't part of its typed interface
    sub setRemoteEvent(playerIndex as integer, event as dynamic)
      if not m.isBluetoothGamepadRemote((event as object).GetRemoteID())
        return
      end if
      m.remoteEvents[playerIndex.ToStr()] = event
    end sub

    ' @param {integer} playerIndex
    ' @param {string} [stick="1"] - "2" reads the right stick (RIGHT_X/RIGHT_Y);
    '   any other value (including the default "1") reads the left stick -
    '   matching bindAxis()'s own stick-name convention
    ' @return {BGE.Math.Vector} - this player's analog stick, {0,0} if no
    '   event cached yet, this player's remote isn't a Bluetooth gamepad, or
    '   the running engine doesn't support multi_controllers (always {0,0}
    '   on real Roku hardware)
    function getRemoteAnalogStick(playerIndex as integer, stick = "1" as string) as BGE.Math.Vector
      if not m.isMultiControllersSupported()
        return BGE.Math.VectorOps.create()
      end if
      event = m.remoteEvents[playerIndex.ToStr()]
      if event = invalid
        return BGE.Math.VectorOps.create()
      end if
      if not m.isBluetoothGamepadRemote((event as object).GetRemoteID())
        return BGE.Math.VectorOps.create()
      end if
      if stick = "2"
        axisX = BGE.Controller.ANALOG_AXIS_RIGHT_X
        axisY = BGE.Controller.ANALOG_AXIS_RIGHT_Y
      else
        axisX = BGE.Controller.ANALOG_AXIS_LEFT_X
        axisY = BGE.Controller.ANALOG_AXIS_LEFT_Y
      end if
      x = (event as object).GetValue(axisX)
      ' GetValue()'s Y follows the raw Gamepad API convention (up = negative) - flip to BGE's world space (+y = up).
      y = -(event as object).GetValue(axisY)
      if Sqr(x * x + y * y) < BGE.Controller.ANALOG_DEADZONE
        return BGE.Math.VectorOps.create()
      end if
      return BGE.Math.VectorOps.create(x, y)
    end function

    private function isMultiControllersSupported() as boolean
      if m.multiControllersSupported = invalid
        remoteInfo = CreateObject("roRemoteInfo")
        m.multiControllersSupported = remoteInfo.HasFeature("multi_controllers", 0)
      end if
      return m.multiControllersSupported
    end function

    private function isBluetoothGamepadRemote(remoteId as string) as boolean
      return Left(remoteId, Len(BGE.Controller.BLUETOOTH_GAMEPAD_REMOTE_ID_PREFIX)) = BGE.Controller.BLUETOOTH_GAMEPAD_REMOTE_ID_PREFIX
    end function

  end class

end namespace
