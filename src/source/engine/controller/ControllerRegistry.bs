namespace BGE.Controller

  ' Internal per-connection controller state (buttons/axes/held-timers) plus
  ' the remote's own d-pad fallback state. Not part of the public API - a
  ' game uses BGE.Controller.ControlMap (game.controls) instead.
  class ControllerConnectionState
    buttons as boolean[] = []
    heldTimers = {} ' buttonIndex.ToStr() -> roTimespan, present only while held
    stick1 as BGE.Math.Vector = BGE.Math.VectorOps.create()
    stick2 as BGE.Math.Vector = BGE.Math.VectorOps.create()
  end class

  class ControllerRegistry
    private connections = {} ' playerIndex.ToStr() -> ControllerConnectionState
    private remoteDpad as BGE.Math.Vector = BGE.Math.VectorOps.create()

    ' Assigns the lowest player index not currently in use.
    function assignPlayerIndex() as integer
      index = 0
      while m.connections.DoesExist(index.ToStr())
        index++
      end while
      m.connections[index.ToStr()] = new BGE.Controller.ControllerConnectionState()
      return index
    end function

    ' Frees a player index previously returned by assignPlayerIndex(), e.g.
    ' when its connection closes - a later assignPlayerIndex() call may
    ' reuse it.
    '
    ' @param {integer} playerIndex - the player index to release
    sub releasePlayerIndex(playerIndex as integer)
      m.connections.Delete(playerIndex.ToStr())
    end sub

    ' Updates one connection's raw state from a decoded {axes, buttons}
    ' message. Returns the button indexes whose boolean flipped since the
    ' last update, for Game to synthesize press/release GameInput events.
    ' The message is untrusted (Game only checks axes/buttons are arrays,
    ' not what's inside them) - a non-boolean button or non-numeric axis
    ' element is coerced to a safe default (false / 0.0) rather than
    ' propagating whatever ParseJson happened to hand back.
    function updateFromMessage(playerIndex as integer, axes as dynamic, buttons as dynamic) as integer[]
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return []
      end if
      sanitizedButtons = []
      for each rawButton in buttons
        sanitizedButtons.Push(m.asBoolean(rawButton))
      end for
      sanitizedAxes = []
      for each rawAxis in axes
        sanitizedAxes.Push(m.asFloat(rawAxis))
      end for
      buttons = sanitizedButtons
      axes = sanitizedAxes
      ' Scan the union of old/new indexes, not just the new message's own
      ' length - a shrinking buttons[] (a later message reports fewer
      ' buttons than a previous one) must still emit a release for an index
      ' that dropped out, or that index can appear permanently "held"
      ' forever to anything driven by change events (e.g. ControlMap),
      ' even though isButtonHeld/getHeldTimeMs already report it correctly
      ' released via their own bounds checks.
      changed = []
      previousCount = state.buttons.Count()
      newCount = buttons.Count()
      maxCount = newCount
      if previousCount > maxCount
        maxCount = previousCount
      end if
      for i = 0 to maxCount - 1
        previous = (i < previousCount) ? state.buttons[i] : false
        current = (i < newCount) ? buttons[i] : false
        if previous <> current
          changed.Push(i)
          if current
            timer = CreateObject("roTimespan")
            timer.Mark()
            state.heldTimers[i.ToStr()] = timer
          else
            state.heldTimers.Delete(i.ToStr())
          end if
        end if
      end for
      ' Clean up any held timers for buttons that are no longer in the array
      keysToDelete = []
      for each keyStr in state.heldTimers
        idx = val(keyStr)
        if idx >= buttons.Count()
          keysToDelete.Push(keyStr)
        end if
      end for
      for each keyStr in keysToDelete
        state.heldTimers.Delete(keyStr)
      end for
      state.buttons = buttons
      ' A later message reporting fewer axes than before must reset the
      ' now-missing stick(s) to neutral, not leave them stuck at their
      ' last non-neutral value - matching the button-release fix above.
      if axes.Count() >= 2
        state.stick1 = BGE.Math.VectorOps.create(axes[0], axes[1])
      else
        state.stick1 = BGE.Math.VectorOps.create()
      end if
      if axes.Count() >= 4
        state.stick2 = BGE.Math.VectorOps.create(axes[2], axes[3])
      else
        state.stick2 = BGE.Math.VectorOps.create()
      end if
      return changed
    end function

    ' @return {integer} - the number of buttons last reported for this player (0 if never seen), so
    '   callers can scan the actual reported button count rather than assuming a fixed number.
    function getButtonCount(playerIndex as integer) as integer
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return 0
      end if
      return state.buttons.Count()
    end function

    ' @param {integer} playerIndex - which player's connection to read
    ' @param {integer} buttonIndex - which button to check
    ' @return {boolean} - true if this button was reported held in the
    '   last message, false if it wasn't (or the index/player is unknown)
    function isButtonHeld(playerIndex as integer, buttonIndex as integer) as boolean
      state = m.connections[playerIndex.ToStr()]
      if state = invalid or buttonIndex >= state.buttons.Count()
        return false
      end if
      return state.buttons[buttonIndex]
    end function

    ' @param {integer} playerIndex - which player's connection to read
    ' @param {integer} buttonIndex - which button to check
    ' @return {integer} - how many milliseconds this button has been
    '   continuously held, 0 if it's not currently held (or never was)
    function getHeldTimeMs(playerIndex as integer, buttonIndex as integer) as integer
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return 0
      end if
      timer = state.heldTimers[buttonIndex.ToStr()]
      if timer = invalid
        return 0
      end if
      return timer.TotalMilliseconds()
    end function

    ' @return {boolean} - value if it's actually a boolean, else false
    private function asBoolean(value as dynamic) as boolean
      if rodash.isBoolean(value)
        return value
      end if
      return false
    end function

    ' @return {float} - value if it's actually numeric, else 0.0
    private function asFloat(value as dynamic) as float
      if rodash.isNumber(value)
        return value
      end if
      return 0.0
    end function

    ' @param {integer} playerIndex - which player's connection to read
    ' @param {integer} stick - 1 for the first analog stick (axes[0:1]), 2
    '   for the second (axes[2:3]); any other value is treated as 1
    ' @return {BGE.Math.Vector} - the stick's current {x, y}, {0, 0} if
    '   never reported or the player is unknown
    function getStick(playerIndex as integer, stick as integer) as BGE.Math.Vector
      state = m.connections[playerIndex.ToStr()]
      if state = invalid
        return BGE.Math.VectorOps.create()
      end if
      if stick = 2
        return state.stick2
      end if
      return state.stick1
    end function

    ' Records the remote control's own d-pad fallback state, used by
    ' BGE.Controller.ControlMap.getAxis() when no controller is bound.
    '
    ' @param {float} x - -1..1
    ' @param {float} y - -1..1
    sub setRemoteDpad(x as float, y as float)
      m.remoteDpad = BGE.Math.VectorOps.create(x, y)
    end sub

    ' @return {BGE.Math.Vector} - the remote d-pad's current {x, y}, as
    '   last set by setRemoteDpad()
    function getRemoteDpad() as BGE.Math.Vector
      return m.remoteDpad
    end function

  end class

end namespace
