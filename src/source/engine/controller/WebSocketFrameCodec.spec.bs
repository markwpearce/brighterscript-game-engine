namespace tests
  @suite("BGE.Controller.WebSocketFrameCodec")
  class WebSocketFrameCodecTests extends rooibos.BaseTestSuite

    @describe("computeAcceptKey")

    @it("computes the RFC 6455 example accept key")
    function _()
      ' Example from RFC 6455 section 1.3
      result = BGE.Controller.WebSocketFrameCodec.computeAcceptKey("dGhlIHNhbXBsZSBub25jZQ==")
      m.assertEqual("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", result)
    end function

    @describe("encodeTextFrame / decodeFrames round trip")

    @it("round trips a short unmasked text frame")
    function _()
      frame = BGE.Controller.WebSocketFrameCodec.encodeTextFrame("hello")
      result = BGE.Controller.WebSocketFrameCodec.decodeFrames(frame, frame.Count())
      m.assertEqual(1, result.frames.Count())
      m.assertEqual(BGE.Controller.WebSocketFrameCodec.OpCode.text, result.frames[0].opcode)
      m.assertTrue(result.frames[0].final)
      m.assertEqual("hello", result.frames[0].payload.ToAsciiString())
      m.assertEqual(frame.Count(), result.bytesConsumed)
    end function

    @it("round trips a payload over 125 bytes (16-bit length prefix)")
    function _()
      longMessage = String(200, "x")
      frame = BGE.Controller.WebSocketFrameCodec.encodeTextFrame(longMessage)
      result = BGE.Controller.WebSocketFrameCodec.decodeFrames(frame, frame.Count())
      m.assertEqual(longMessage, result.frames[0].payload.ToAsciiString())
    end function

    @it("encodes and decodes a frame with 64-bit length prefix (payload > 65535)")
    function _()
      ' Test that the 64-bit length encoding/decoding works correctly
      ' Rather than creating a huge payload (which is slow), build a frame manually
      ' with a 64-bit length value and verify decoding parses it correctly
      payload = CreateObject("roByteArray")
      ' Create a small test payload to embed in a large frame structure
      payload.FromAsciiString("test")

      ' Manually build frame with 64-bit length prefix:
      ' byte0: FIN=1, opcode=text (0x81)
      ' byte1: masked=0, payload length 127 (0x7f) - signals 64-bit length follows
      ' bytes 2-9: 8-byte big-endian length value
      frame = CreateObject("roByteArray")
      frame.Push(&h81) ' FIN=1, opcode=1 (text)
      frame.Push(127)  ' masked=0, payloadLen=127 (indicates 64-bit length)

      ' 64-bit length encoding: 0x0000000000000004 (4 bytes for "test")
      frame.Push(0) ' byte 2
      frame.Push(0) ' byte 3
      frame.Push(0) ' byte 4
      frame.Push(0) ' byte 5
      frame.Push(0) ' byte 6
      frame.Push(0) ' byte 7
      frame.Push(0) ' byte 8
      frame.Push(4) ' byte 9 - actual length is 4
      frame.Append(payload)

      result = BGE.Controller.WebSocketFrameCodec.decodeFrames(frame, frame.Count())
      m.assertEqual(1, result.frames.Count())
      m.assertEqual("test", result.frames[0].payload.ToAsciiString())
    end function

    @describe("decodeFrames with a masked client frame")

    @it("unmasks a masked text frame payload")
    function _()
      ' A masked "hi" text frame: FIN+text, masked+len=2, mask key, masked payload
      payload = CreateObject("roByteArray")
      payload.FromAsciiString("hi")
      maskKey = [1, 2, 3, 4]
      masked = CreateObject("roByteArray")
      masked.Push(&h81) ' FIN=1, opcode=text
      masked.Push(&h80 or 2) ' masked=1, len=2
      for each b in maskKey
        masked.Push(b)
      end for
      for i = 0 to payload.Count() - 1
        ' XOR: (A or B) and not (A and B)
        payloadByte = payload[i]
        maskByte = maskKey[i mod 4]
        maskedByte = (payloadByte or maskByte) and (not (payloadByte and maskByte))
        masked.Push(maskedByte)
      end for
      result = BGE.Controller.WebSocketFrameCodec.decodeFrames(masked, masked.Count())
      m.assertEqual("hi", result.frames[0].payload.ToAsciiString())
    end function

    @it("returns no frames and zero bytesConsumed for an incomplete frame")
    function _()
      partial = CreateObject("roByteArray")
      partial.Push(&h81) ' only the first header byte
      result = BGE.Controller.WebSocketFrameCodec.decodeFrames(partial, partial.Count())
      m.assertEqual(0, result.frames.Count())
      m.assertEqual(0, result.bytesConsumed)
    end function

    @describe("a crafted frame with the reserved MSB of a 64-bit length set")

    @it("does not decode a frame and does not crash/index out of bounds")
    function _()
      ' RFC 6455 section 5.2: the MSB of a 64-bit extended payload length
      ' MUST be 0. Craft a frame with it set to &hff in the top length
      ' byte, which - unfixed - decodes as a huge/negative payloadLength,
      ' bypassing the "available < frameLength" bounds check and indexing
      ' the buffer with a garbage negative offset.
      frame = CreateObject("roByteArray")
      frame.Push(&h81) ' FIN=1, opcode=text
      frame.Push(127)  ' masked=0, payloadLen=127 (64-bit length follows)
      frame.Push(&hff) ' byte 2: MSB set - malformed per RFC 6455
      frame.Push(0)
      frame.Push(0)
      frame.Push(0)
      frame.Push(0)
      frame.Push(0)
      frame.Push(0)
      frame.Push(4) ' byte 9
      frame.Push(&h41) ' a few trailing bytes, well short of any huge
      frame.Push(&h42) ' claimed length - if the bug were present, decoding
      frame.Push(&h43) ' would try to read far past the end of this buffer
      result = BGE.Controller.WebSocketFrameCodec.decodeFrames(frame, frame.Count())
      ' Should behave exactly like "not enough data yet" - no frames
      ' decoded, nothing consumed - not a crash, not a garbage frame.
      m.assertEqual(0, result.frames.Count())
      m.assertEqual(0, result.bytesConsumed)
    end function

    @it("bytesToLong returns -1 for a length with the reserved MSB set")
    function _()
      buffer = CreateObject("roByteArray")
      buffer.Push(&hff)
      buffer.Push(0)
      buffer.Push(0)
      buffer.Push(0)
      buffer.Push(0)
      buffer.Push(0)
      buffer.Push(0)
      buffer.Push(0)
      result = BGE.Controller.WebSocketFrameCodec.bytesToLong(buffer, 0)
      m.assertTrue(result < 0)
    end function

  end class
end namespace
