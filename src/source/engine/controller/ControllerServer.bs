namespace BGE.Controller

  const CONTROLLER_HTTP_BUFFER_SIZE = 10240
  const CONTROLLER_WS_READ_SIZE = 10240
  ' Cap on connection.wsBuffer's accumulated size, mirroring CONTROLLER_HTTP_BUFFER_SIZE's
  ' guard on httpBuffer - without this, a client declaring a huge 64-bit extended WebSocket
  ' frame payload length and then trickling/withholding bytes could grow wsBuffer unbounded
  ' while decodeFrames() keeps waiting for the rest of the frame to arrive.
  const CONTROLLER_WS_BUFFER_MAX_SIZE = 65536

  enum ConnectionMode
    http = "http"
    websocket = "websocket"
  end enum

  class ControllerConnection
    socket as roStreamSocket
    mode as string = BGE.Controller.ConnectionMode.http
    wsBuffer as roByteArray = CreateObject("roByteArray")
    ' Accumulates raw bytes across possibly-multiple recv()/poll() calls
    ' until a full HTTP request (terminated by a blank line) has arrived -
    ' see onHttpReadable(). A single recv() is not guaranteed to return an
    ' entire request in one call, especially a real browser's larger
    ' WebSocket-upgrade request (many headers) split across TCP segments.
    httpBuffer as roByteArray = CreateObject("roByteArray")
    ' Consecutive poll() cycles where isReadable() reported true but
    ' receive() returned a negative "not ready yet" result with no bytes
    ' actually delivered - see onHttpReadable()/onWebSocketReadable(). Reset
    ' to 0 on every poll that actually receives bytes. Guards against a dead
    ' connection (peer vanished without a clean FIN) spinning forever now
    ' that a negative receive() no longer closes the connection immediately.
    '
    ' IMPORTANT, confirmed on a real 2024 Roku Ultra with an on-device debug
    ' capture: isReadable() is NOT a reliable "there might be data" signal
    ' for a websocket socket on this hardware - once a connection has ever
    ' been read from, isReadable() reports true on essentially every single
    ' subsequent poll() even while the peer is sitting perfectly idle and
    ' sends nothing, and receive() returns -1 every one of those times, with
    ' no gaps and no distinguishing pattern versus an actually-dead peer.
    ' Concretely: a real browser client left untouched (no stick/button
    ' movement) hit exactly this and got closed after ~300 consecutive
    ' negative-receive polls (~5s) - not a hypothetical, this is what a
    ' silently-idle player looks like on this hardware. There is no signal
    ' available here to tell "healthy but idle" apart from "actually dead" -
    ' both look identical. The real fix is the browser client
    ' (controller-web/index.html) resending its current state once a
    ' second even when nothing changed, so a healthy connection always has
    ' real bytes arriving well inside this threshold; staleReadPolls stays
    ' as a backstop that still reaps a connection whose heartbeats have
    ' genuinely stopped (tab closed, network gone), just no longer trusted
    ' to distinguish idle-vs-dead on its own.
    staleReadPolls as integer = 0
    ' Bytes still waiting to be flushed to the socket - see
    ' ControllerServer.queueSend()/flushPendingSend(). `invalid` when
    ' nothing is queued. roStreamSocket.send() is non-blocking and can
    ' return 0 ("would block, try again") under ordinary backpressure -
    ' looping on that in place would busy-spin the whole render loop
    ' (Roku's socket has no blocking wait), so instead any unsent
    ' remainder is parked here and retried once per poll() cycle until it
    ' fully flushes (or a real send error occurs).
    pendingSend as roByteArray = invalid
    ' How far into pendingSend the previous partial send(s) already got.
    pendingSendOffset as integer = 0
    ' What to do once pendingSend fully flushes - "" (nothing further),
    ' "close" (close the connection - e.g. after an HTTP response), or
    ' "upgrade" (flip into websocket mode and emit onOpen - deferred until
    ' the handshake response has actually reached the client, so a flush
    ' failure never leaves a "ghost" upgraded connection).
    pendingSendAction as string = ""
  end class

  ' Consecutive negative-receive polls before a connection is assumed dead
  ' and closed - see ControllerConnection.staleReadPolls. At ~60 polls/sec
  ' this is a multi-second grace period. The browser client now resends its
  ' state once a second (see controller-web/index.html), so this threshold
  ' only needs to comfortably clear that 1s heartbeat cadence (it does, by
  ' ~5x) - it no longer needs to double as "long enough for the flakiest
  ' possible isReadable() behavior on idle, untouched input," since that
  ' case no longer exists once the client is always sending.
  const CONTROLLER_MAX_STALE_READ_POLLS = 300

  enum ControllerServerEventType
    onOpen = "onOpen"
    onMessage = "onMessage"
    onClose = "onClose"
  end enum

  interface ControllerServerEvent
    type as string ' BGE.Controller.ControllerServerEventType
    connectionId as string
    message as string ' only set for onMessage
  end interface

  ' A parseHttpRequest() result - the request line plus headers, both used verbatim
  ' by onHttpReadable()'s routing. headers stays a plain dictionary (its keys are
  ' whatever header names the client happened to send, not a fixed set).
  interface HttpRequest
    command as string
    path as string
    protocol as string
    headers as object
  end interface

  ' Minimal HTTP + WebSocket (RFC 6455) server for streaming controller
  ' input from a browser page, without SceneGraph. Adapted and trimmed from
  ' https://github.com/markwpearce/roku-gamepad - serves GET only (static
  ' files under pkg:/source/controller-web), no upload/directory listing.
  class ControllerServer
    port as integer
    private tcpListen as roStreamSocket = CreateObject("roStreamSocket")
    private messagePort as roMessagePort
    private connections = {} ' socket id string -> ControllerConnection
    private events as BGE.Controller.ControllerServerEvent[] = []
    private buffer as roByteArray = CreateObject("roByteArray")

    sub new(port as integer)
      m.port = port
      m.buffer[CONTROLLER_HTTP_BUFFER_SIZE] = 0
    end sub

    ' Starts listening. Returns true if the socket bound/listened
    ' successfully (`m.tcpListen.eOK()`), false otherwise - the caller
    ' should surface a false return rather than silently proceeding with
    ' a server that never accepts connections.
    function listen(messagePort as roMessagePort) as boolean
      m.messagePort = messagePort
      addr = CreateObject("roSocketAddress")
      addr.setPort(m.port)
      m.tcpListen.setMessagePort(messagePort)
      m.tcpListen.setAddress(addr)
      m.tcpListen.notifyReadable(true)
      m.tcpListen.listen(4)
      return m.tcpListen.eOK()
    end function

    ' Returns and clears the queue of connection lifecycle/message events
    ' collected since the last call.
    function drainEvents() as BGE.Controller.ControllerServerEvent[]
      drained = m.events
      m.events = []
      return drained
    end function

    ' Drives accept/read directly by polling each tracked socket's own
    ' isReadable() rather than relying on the message port's socket-event
    ' notification. On at least one real device (2024 Roku Ultra), the
    ' roMessagePort passed to setMessagePort()/notifyReadable() never
    ' actually delivers a roSocketEvent for either the listening socket or
    ' an accepted connection, even though isReadable() itself correctly
    ' reflects a pending connection/readable data when polled directly -
    ' confirmed by instrumenting both paths against a real TCP client hung
    ' waiting on the listener. notifyReadable(true) is still called (it's
    ' what keeps isReadable() accurate), just not depended on to *notify*
    ' via the message port. Call this once per frame.
    sub poll()
      if m.tcpListen.isReadable()
        m.acceptConnection()
      end if
      for each id in m.connections.Keys()
        connection = m.connections[id] as BGE.Controller.ControllerConnection
        if connection = invalid
          continue for
        end if
        m.flushPendingSend(id, connection)
        ' flushPendingSend() may have closed this connection (a real send
        ' error, or a queued "close" action finally completing) - re-fetch
        ' before touching it further.
        connection = m.connections[id] as BGE.Controller.ControllerConnection
        if connection = invalid
          continue for
        end if
        ' Don't start parsing a new request while a response is still
        ' being flushed to this same connection - a client that pipelined
        ' a second request before the first response finished sending
        ' would otherwise clobber the in-flight pendingSend with a second,
        ' unrelated one.
        if connection.pendingSend = invalid and connection.socket.isReadable()
          if connection.mode = BGE.Controller.ConnectionMode.websocket
            m.onWebSocketReadable(id, connection)
          else
            m.onHttpReadable(id, connection)
          end if
        end if
      end for
    end sub

    ' Closes every open connection and the listening socket itself, freeing
    ' the port.
    sub close()
      for each id in m.connections.Keys()
        m.closeConnection(id)
      end for
      m.tcpListen.close()
    end sub

    ' Sends one WebSocket text frame to a connection - e.g. Game sending
    ' {playerIndex, labels} once a handshake completes. No-op for an
    ' unknown/closed connection id.
    '
    ' @param {string} id
    ' @param {string} message
    sub sendMessage(id as string, message as string)
      connection = m.connections[id] as BGE.Controller.ControllerConnection
      if connection = invalid
        return
      end if
      m.queueSend(id, connection, BGE.Controller.WebSocketFrameCodec.encodeTextFrame(message), "")
    end sub

    ' Closes and forgets one tracked connection, pushing an onClose event
    ' if it had completed the websocket handshake. Safe to call for an
    ' already-closed/unknown id (no-op).
    '
    ' @param {string} id - the connection id, as passed to a
    '   ControllerServerEvent's connectionId
    sub closeConnection(id as string)
      connection = m.connections[id] as BGE.Controller.ControllerConnection
      if connection = invalid
        return
      end if
      wasWebSocket = connection.mode = BGE.Controller.ConnectionMode.websocket
      connection.socket.close()
      m.connections.Delete(id)
      if wasWebSocket
        m.events.Push({type: BGE.Controller.ControllerServerEventType.onClose, connectionId: id, message: ""})
      end if
    end sub

    private sub acceptConnection()
      newSocket = m.tcpListen.accept() as roStreamSocket
      if newSocket = invalid
        return
      end if
      newSocket.notifyReadable(true)
      newSocket.setMessagePort(m.messagePort)
      connection = new BGE.Controller.ControllerConnection()
      connection.socket = newSocket
      m.connections[newSocket.getID().ToStr()] = connection
    end sub

    private sub onHttpReadable(id as string, connection as BGE.Controller.ControllerConnection)
      socket = connection.socket
      if not socket.isReadable()
        return
      end if
      numReceivedBytes = socket.receive(m.buffer, 0, CONTROLLER_HTTP_BUFFER_SIZE)
      if numReceivedBytes = 0
        ' A clean read of zero bytes is the standard TCP half-close signal -
        ' the peer actually closed the connection.
        m.closeConnection(id)
        return
      else if numReceivedBytes < 0
        ' A negative return does NOT necessarily mean the peer closed the
        ' connection - on at least one real device, isReadable() has been
        ' observed to report true for one poll() cycle with no bytes
        ' actually available yet (e.g. immediately after a previous read
        ' drained everything currently buffered, before a request split
        ' across multiple TCP segments/writes has fully arrived). Treating
        ' this the same as a real close prematurely killed the connection
        ' before the rest of a multi-part request could arrive - confirmed
        ' via a scripted client that split a request mid-headers with a
        ' multi-second gap between writes. Just wait for a later poll(),
        ' up to a point - see staleReadPolls doc comment.
        connection.staleReadPolls += 1
        if connection.staleReadPolls > CONTROLLER_MAX_STALE_READ_POLLS
          m.closeConnection(id)
        end if
        return
      end if
      connection.staleReadPolls = 0
      connection.httpBuffer.Append(m.buffer.Slice(0, numReceivedBytes))
      if not m.httpHeaderTerminatorFound(connection.httpBuffer)
        if m.httpBufferExceedsMax(connection.httpBuffer.Count())
          ' headers never terminated within a reasonable size - nothing safe to do
          m.closeConnection(id)
          return
        end if
        ' full request headers not received yet - a single recv() is not
        ' guaranteed to deliver a whole request, especially a real browser's
        ' larger WebSocket-upgrade request split across TCP segments. Wait
        ' for poll() to call this again once more data is readable.
        return
      end if
      request = m.parseHttpRequest(connection.httpBuffer, connection.httpBuffer.Count())
      if request = invalid
        ' malformed request line - nothing safe to respond with
        m.closeConnection(id)
        return
      end if
      if request.command <> "GET"
        ' sendHttpResponse()/serveStaticFile() now queue a "close" action of
        ' their own, taking effect only once the response has actually
        ' finished flushing (see queueSend()/flushPendingSend()) - don't
        ' close synchronously here, that could cut the response off mid-send.
        m.sendHttpResponse(id, connection, request.protocol, 405, "Method Not Allowed")
      else if m.isWebSocketUpgradeRequest(request)
        m.upgradeToWebSocket(id, connection, request)
      else
        m.serveStaticFile(id, connection, request)
      end if
    end sub

    ' @param {roByteArray} buffer - a connection's accumulated httpBuffer
    ' @return {boolean} - true once the double-CRLF header terminator has
    '   arrived, meaning a full set of request headers is present and
    '   parseHttpRequest() can be called regardless of total buffer size
    '   so far. Engine-internal; not private only so the spec can exercise
    '   it directly (needs no socket).
    function httpHeaderTerminatorFound(buffer as roByteArray) as boolean
      return Instr(1, buffer.ToAsciiString(), chr(13) + chr(10) + chr(13) + chr(10)) > 0
    end function

    ' @param {integer} bufferCount - a connection's accumulated httpBuffer size
    ' @return {boolean} - true if this buffer has grown past
    '   CONTROLLER_HTTP_BUFFER_SIZE and should be rejected. Only meaningful
    '   (and only ever checked by onHttpReadable) when
    '   httpHeaderTerminatorFound() is still false - see its doc comment
    '   for why the terminator check must come first. Engine-internal; not
    '   private only so the spec can exercise it directly.
    function httpBufferExceedsMax(bufferCount as integer) as boolean
      return bufferCount > CONTROLLER_HTTP_BUFFER_SIZE
    end function

    ' Parses a raw request buffer into {command, path, protocol, headers},
    ' or invalid if the request line is malformed (fewer than the three
    ' required tokens) - the caller closes the connection in that case.
    ' Engine-internal; not private only so the spec can exercise it.
    '
    ' Note: `bufferSize` is trusted as-is (no clamp to CONTROLLER_HTTP_BUFFER_SIZE) -
    ' an earlier clamp here silently corrupted any request larger than that cap on
    ' real hardware: buffer[bufferSize] = 0 wrote a null byte mid-buffer (at the
    ' clamped position, not the real end), and roByteArray.ToAsciiString() truncates
    ' at the first null on a real device (confirmed via on-device testing - brs-cli's
    ' ToAsciiString() does NOT truncate this way, so this was invisible to the
    ' headless test suite), silently cutting off everything after it, including the
    ' actual header terminator. onHttpReadable() is the only caller and already
    ' decides whether a buffer this large should even be parsed (see
    ' httpHeaderTerminatorFound()/httpBufferExceedsMax()) - by the time this
    ' function runs, the size is already accepted.
    '
    ' @param {roByteArray} buffer
    ' @param {integer} bufferSize
    ' @return {BGE.Controller.HttpRequest}
    function parseHttpRequest(buffer as roByteArray, bufferSize as integer) as BGE.Controller.HttpRequest
      buffer[bufferSize] = 0
      lines = buffer.ToAsciiString().Tokenize(chr(13) + chr(10))
      if lines.Count() = 0
        return invalid
      end if
      commandLine = lines[0].Tokenize(" ")
      if commandLine.Count() < 3
        return invalid
      end if
      headers = {}
      for lineIndex = 1 to lines.Count() - 1
        line = lines[lineIndex]
        if line = ""
          exit for
        end if
        headerParts = line.Tokenize(":")
        if headerParts.Count() = 0
          continue for
        end if
        ' HTTP header names are case-insensitive (RFC 7230) - normalize to
        ' lowercase at storage time so every lookup below can use one fixed
        ' casing regardless of what casing the client actually sent.
        key = LCase(headerParts[0].Trim())
        headerParts.Shift()
        headers[key] = headerParts.ToArray().Join(":").Trim()
      end for
      return {command: commandLine[0], path: commandLine[1], protocol: commandLine[2], headers: headers}
    end function

    ' True only for a request carrying all three RFC 6455 handshake headers.
    ' Engine-internal; not private only so the spec can exercise it.
    '
    ' @param {BGE.Controller.HttpRequest} request - a parseHttpRequest() result
    ' @return {boolean}
    function isWebSocketUpgradeRequest(request as BGE.Controller.HttpRequest) as boolean
      ' request.headers keys are already lowercased by parseHttpRequest.
      upgrade = LCase(request.headers["upgrade"] ?? "")
      connectionHeader = LCase(request.headers["connection"] ?? "")
      return upgrade = "websocket" and Instr(1, connectionHeader, "upgrade") > 0 and request.headers["sec-websocket-key"] <> invalid
    end function

    ' Completes the RFC 6455 handshake (section 4.2.2) and queues this
    ' connection to flip into websocket framing mode. The mode flip and
    ' onOpen event are deferred until the handshake response has actually
    ' finished sending (see queueSend()/flushPendingSend()) - committing to
    ' websocket mode before that would create a "ghost" upgraded connection
    ' if the flush later fails partway through.
    private sub upgradeToWebSocket(id as string, connection as BGE.Controller.ControllerConnection, request as BGE.Controller.HttpRequest)
      acceptKey = BGE.Controller.WebSocketFrameCodec.computeAcceptKey(request.headers["sec-websocket-key"])
      response = "HTTP/1.1 101 Switching Protocols" + chr(13) + chr(10)
      response += "Upgrade: websocket" + chr(13) + chr(10)
      response += "Connection: Upgrade" + chr(13) + chr(10)
      response += "Sec-WebSocket-Accept: " + acceptKey + chr(13) + chr(10) + chr(13) + chr(10)
      m.queueSend(id, connection, m.stringToBytes(response), "upgrade")
    end sub

    ' @return {boolean} - true if a websocket connection's accumulated buffer has grown past
    '   CONTROLLER_WS_BUFFER_MAX_SIZE (see its own doc comment) and should be rejected.
    '   Engine-internal; not private only so the spec can exercise it directly (needs no socket).
    function wsBufferExceedsMax(bufferCount as integer) as boolean
      return bufferCount > CONTROLLER_WS_BUFFER_MAX_SIZE
    end function

    private sub onWebSocketReadable(id as string, connection as BGE.Controller.ControllerConnection)
      socket = connection.socket
      if not socket.isReadable()
        return
      end if
      chunk = CreateObject("roByteArray")
      chunk[CONTROLLER_WS_READ_SIZE] = 0
      numReceivedBytes = socket.receive(chunk, 0, CONTROLLER_WS_READ_SIZE)
      if numReceivedBytes = 0
        ' A clean read of zero bytes is the standard TCP half-close signal -
        ' the peer actually closed the connection.
        m.closeConnection(id)
        return
      else if numReceivedBytes < 0
        ' A negative return does NOT necessarily mean the peer closed the
        ' connection - see the identical comment in onHttpReadable(). Just
        ' wait for a later poll(); this keeps a long-lived, otherwise-idle
        ' websocket connection from being torn down on a spurious readable
        ' notification with nothing actually behind it - but only up to a
        ' point, see staleReadPolls doc comment.
        connection.staleReadPolls += 1
        if connection.staleReadPolls > CONTROLLER_MAX_STALE_READ_POLLS
          m.closeConnection(id)
        end if
        return
      end if
      connection.staleReadPolls = 0
      connection.wsBuffer.Append(chunk.Slice(0, numReceivedBytes))
      if m.wsBufferExceedsMax(connection.wsBuffer.Count())
        ' A declared frame payload too large to ever legitimately arrive from this
        ' client (or one being trickled in to grow the buffer unbounded) - nothing
        ' safe to do but close.
        m.closeConnection(id)
        return
      end if
      decodeResult = BGE.Controller.WebSocketFrameCodec.decodeFrames(connection.wsBuffer, connection.wsBuffer.Count())
      shouldClose = false
      for each frame in decodeResult.frames
        if frame.opcode = BGE.Controller.WebSocketFrameCodec.OpCode.close
          shouldClose = true
        else if frame.opcode = BGE.Controller.WebSocketFrameCodec.OpCode.text
          m.events.Push({type: BGE.Controller.ControllerServerEventType.onMessage, connectionId: id, message: frame.payload.ToAsciiString()})
        end if
        ' ping/pong/binary/fragmentation intentionally unsupported - the
        ' browser client only ever sends small, unfragmented text frames
      end for
      if decodeResult.bytesConsumed > 0
        ' Slice() already returns a new, independent roByteArray - no need
        ' to copy it again into a fresh array.
        connection.wsBuffer = connection.wsBuffer.Slice(decodeResult.bytesConsumed)
      end if
      if shouldClose
        m.closeConnection(id)
      end if
    end sub

    private sub serveStaticFile(id as string, connection as BGE.Controller.ControllerConnection, request as BGE.Controller.HttpRequest)
      ' No path traversal out of the served directory.
      if Instr(1, request.path, "..") > 0
        m.sendHttpResponse(id, connection, request.protocol, 404, "Not Found")
        return
      end if
      path = "pkg:/source/controller-web" + request.path
      if request.path = "/"
        path += "index.html"
      end if
      contents = CreateObject("roByteArray")
      if not contents.ReadFile(path)
        m.sendHttpResponse(id, connection, request.protocol, 404, "Not Found")
        return
      end if
      header = request.protocol + " 200 OK" + chr(13) + chr(10) + "Content-Type: " + m.contentTypeFor(path) + chr(13) + chr(10) + "Content-Length: " + contents.Count().ToStr() + chr(13) + chr(10) + chr(13) + chr(10)
      ' Combine header + body into one buffer so this is one queued send
      ' (one pendingSend slot per connection - see its doc comment) rather
      ' than two sends racing/overwriting each other across poll() cycles.
      response = m.stringToBytes(header)
      response.Append(contents)
      m.queueSend(id, connection, response, "close")
    end sub

    private function contentTypeFor(path as string) as string
      if path.EndsWith(".html")
        return "text/html"
      else if path.EndsWith(".js")
        return "text/javascript"
      else if path.EndsWith(".css")
        return "text/css"
      end if
      return "application/octet-stream"
    end function

    private sub sendHttpResponse(id as string, connection as BGE.Controller.ControllerConnection, protocol as string, code as integer, body as string)
      statusTexts = {"404": "Not Found", "405": "Method Not Allowed"}
      statusText = statusTexts[code.ToStr()] ?? "Error"
      response = protocol + " " + code.ToStr() + " " + statusText + chr(13) + chr(10) + "Content-Type: text/plain" + chr(13) + chr(10) + chr(13) + chr(10) + body
      m.queueSend(id, connection, m.stringToBytes(response), "close")
    end sub

    private function stringToBytes(s as string) as roByteArray
      bytes = CreateObject("roByteArray")
      bytes.FromAsciiString(s)
      return bytes
    end function

    ' Queues `bytes` to be sent on this connection, replacing the old
    ' blocking-retry-loop sendAll(). Makes one immediate non-blocking
    ' send() attempt (via flushPendingSend()); if that doesn't fully
    ' flush, the remainder is parked on the connection and completed by
    ' poll() calling flushPendingSend() once per frame until done - see
    ' ControllerConnection.pendingSend's doc comment for why this can't
    ' just retry-loop in place (roStreamSocket.send() is non-blocking with
    ' no wait, so a tight `while sent = 0` loop here would busy-spin the
    ' whole render loop under ordinary backpressure).
    '
    ' @param {string} id - the connection id
    ' @param {BGE.Controller.ControllerConnection} connection
    ' @param {roByteArray} bytes - the bytes to send
    ' @param {string} action - what to do once fully flushed: "" (nothing
    '   further), "close", or "upgrade" - see pendingSendAction
    private sub queueSend(id as string, connection as BGE.Controller.ControllerConnection, bytes as roByteArray, action as string)
      connection.pendingSend = bytes
      connection.pendingSendOffset = 0
      connection.pendingSendAction = action
      m.flushPendingSend(id, connection)
    end sub

    ' Makes one non-blocking send() attempt for a connection's queued
    ' bytes (if any), advancing pendingSendOffset on partial progress.
    ' Runs the queued action and clears the pending state once fully
    ' flushed. On a real (negative) send error - as opposed to 0, which
    ' means only "would block, try again" under Roku's non-blocking
    ' socket model, not a failure - gives up and closes the connection,
    ' since there's nothing left to send the queued action's result to
    ' anyway. A no-op if nothing is queued.
    private sub flushPendingSend(id as string, connection as BGE.Controller.ControllerConnection)
      if connection.pendingSend = invalid
        return
      end if
      total = connection.pendingSend.Count()
      sent = connection.socket.send(connection.pendingSend, connection.pendingSendOffset, total - connection.pendingSendOffset)
      if sent < 0
        connection.pendingSend = invalid
        connection.pendingSendAction = ""
        m.closeConnection(id)
        return
      end if
      connection.pendingSendOffset += sent
      if connection.pendingSendOffset < total
        ' 0 (would block) or a partial send - leave it queued, poll()
        ' retries next frame.
        return
      end if
      action = connection.pendingSendAction
      connection.pendingSend = invalid
      connection.pendingSendAction = ""
      if action = "close"
        m.closeConnection(id)
      else if action = "upgrade"
        connection.mode = BGE.Controller.ConnectionMode.websocket
        m.events.Push({type: BGE.Controller.ControllerServerEventType.onOpen, connectionId: id, message: ""})
      end if
    end sub

  end class

end namespace
