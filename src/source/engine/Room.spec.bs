namespace tests

  ' Room is just a GameEntity subclass - the "current room" is processed
  ' like any other entity (see Game.processEntitiesPreDraw), always first/
  ' last in the update and collision passes. This mostly confirms Room
  ' participates correctly in the same GameEntity/Game machinery already
  ' covered by GameEntity.spec.bs/Game.spec.bs.
  @suite("BGE.Room")
  class RoomTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("new")

    @it("takes its name from the constructor args, like any GameEntity")
    function _()
      room = new BGE.Room(m.game, {name: "MainRoom"})
      m.assertEqual("MainRoom", room.name)
    end function

    @it("is valid immediately after creation")
    function _()
      room = new BGE.Room(m.game, {name: "MainRoom"})
      m.assertTrue(room.isValid())
    end function

    @describe("defineRoom / changeRoom / getRoom round trip")

    @it("becomes the game's current room once changed to")
    function _()
      room = new BGE.Room(m.game, {name: "MainRoom"})
      m.game.defineRoom(room)
      m.game.changeRoom("MainRoom")

      m.assertEqual(room.id, m.game.getRoom().id)
      m.assertEqual("MainRoom", m.game.getRoom().name)
    end function

    ' See #144: a Room's own directly-added drawables aren't in Game.sortedEntities, so
    ' they're never touched by Game.handleRoomChange()'s automatic non-persistent-entity
    ' cleanup. Room's default onChangeRoom() compensates for that gap directly.
    @describe("onChangeRoom - default drawable cleanup (#144)")

    @it("removes this room's own directly-added drawables by default when changing to a different room")
    function _()
      roomA = new BGE.Room(m.game, {name: "RoomA"})
      roomB = new BGE.Room(m.game, {name: "RoomB"})
      m.game.defineRoom(roomA)
      m.game.defineRoom(roomB)

      ' Immediate - currentRoom is still invalid at this point.
      m.game.changeRoom("RoomA")
      roomA.addDrawable("rect", new BGE.DrawableRectangle(roomA, 10, 10))
      m.assertNotInvalid(roomA.getDrawable("rect"))

      ' A room change past the first is deferred to end-of-frame unless the game isn't
      ' running - End() forces changeRoom to process it immediately for this test.
      m.game.End()
      m.game.changeRoom("RoomB")

      m.assertEqual(0, roomA.drawablesByName.Count())
    end function

    @it("keeps its own drawables across a room change when persistDrawablesAcrossRoomChange is true")
    function _()
      roomA = new BGE.Room(m.game, {name: "RoomA"})
      roomB = new BGE.Room(m.game, {name: "RoomB"})
      roomA.persistDrawablesAcrossRoomChange = true
      m.game.defineRoom(roomA)
      m.game.defineRoom(roomB)

      m.game.changeRoom("RoomA")
      roomA.addDrawable("rect", new BGE.DrawableRectangle(roomA, 10, 10))

      m.game.End()
      m.game.changeRoom("RoomB")

      m.assertNotInvalid(roomA.getDrawable("rect"))
    end function

    @it("does not remove drawables when 'changing' to the same room (e.g. Game.resetRoom())")
    function _()
      roomA = new BGE.Room(m.game, {name: "RoomA"})
      m.game.defineRoom(roomA)

      m.game.changeRoom("RoomA")
      roomA.addDrawable("rect", new BGE.DrawableRectangle(roomA, 10, 10))

      m.game.End()
      m.game.changeRoom("RoomA")

      m.assertNotInvalid(roomA.getDrawable("rect"))
    end function

  end class

end namespace
