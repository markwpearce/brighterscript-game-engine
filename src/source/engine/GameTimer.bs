namespace BGE

  ' Wrapper for Roku's roTimeSpan that allows time adjustment
  class GameTimer

    private internal_roku_timer as roTimespan = invalid
    private total_milliseconds_modifier as integer = 0
    private frozen as boolean = false

    sub new()
      m.internal_roku_timer = CreateObject("roTimespan")
    end sub


    sub mark()
      m.internal_roku_timer.Mark()
      m.total_milliseconds_modifier = 0
    end sub

    ' Stops counting real time, so only addTime()/removeTime() move the reading (which drops
    ' to just their offset). For tests that sample exact times, where a slow runner's real
    ' time would otherwise add drift.
    sub freeze()
      m.frozen = true
    end sub

    ' @return {boolean} true once freeze() has been called
    function isFrozen() as boolean
      return m.frozen
    end function

    function totalMilliseconds() as integer
      if m.frozen
        return m.total_milliseconds_modifier
      end if
      return m.internal_roku_timer.TotalMilliseconds() + m.total_milliseconds_modifier
    end function

    function totalSeconds() as integer
      if m.frozen
        return fix(m.total_milliseconds_modifier / 1000)
      end if
      return m.internal_roku_timer.TotalSeconds() + cint(m.total_milliseconds_modifier / 1000)
    end function

    function getSecondsToISO8601Date(date as string) as integer
      return m.internal_roku_timer.GetSecondsToISO8601Date(date)
    end function

    sub addTime(milliseconds as integer)
      m.total_milliseconds_modifier += milliseconds
    end sub

    sub removeTime(milliseconds as integer)
      m.total_milliseconds_modifier -= milliseconds
    end sub

  end class
end namespace
