namespace tests

  ' Drives Game's collision pass directly (processCollisionsForTest) against real
  ' entities/colliders to check onCollisionEnter()/onCollisionExit() fire once per contact.
  @suite("BGE.Game collision enter/exit")
  class GameCollisionEventsTests extends rooibos.BaseTestSuite

    game as BGE.Game
    watcher as CollisionEventRecordingEntity
    other as BGE.GameEntity

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.watcher = new CollisionEventRecordingEntity(m.game, {name: "Watcher"})
      m.game.addEntity(m.watcher)
      m.watcher.addRectangleCollider("zone", 20, 20)
      m.other = m.game.addEntity(new BGE.GameEntity(m.game, {name: "Other"}))
      m.other.position = BGE.Math.VectorOps.create(200, 200)
      m.other.addRectangleCollider("body", 10, 10)
      m.game.processCollisionsForTest()
    end function

    ' Moves the other entity and its compositor sprite right away, so the result doesn't depend
    ' on which entity the collision pass happens to process first.
    private sub moveOther(x as float, y as float)
      m.other.position = BGE.Math.VectorOps.create(x, y)
      m.other.colliders["body"].adjustCompositorObject(m.other.position)
    end sub

    @describe("onCollisionEnter")

    @it("fires once when an overlap starts, not on every frame of it")
    function _()
      m.moveOther(5, 5)
      m.game.processCollisionsForTest()
      m.game.processCollisionsForTest()
      m.game.processCollisionsForTest()

      m.assertEqual(1, m.watcher.enterCount)
      m.assertEqual(3, m.watcher.collisionCount)
      m.assertEqual("Other", m.watcher.lastEnterEntityName)
    end function

    @it("fires again after the overlap ends and starts again")
    function _()
      m.moveOther(5, 5)
      m.game.processCollisionsForTest()
      m.moveOther(200, 200)
      m.game.processCollisionsForTest()
      m.moveOther(5, 5)
      m.game.processCollisionsForTest()

      m.assertEqual(2, m.watcher.enterCount)
    end function

    @it("doesn't fire when nothing overlaps")
    function _()
      m.game.processCollisionsForTest()
      m.assertEqual(0, m.watcher.enterCount)
      m.assertEqual(0, m.watcher.exitCount)
    end function

    @describe("onCollisionExit")

    @it("fires once when an overlap ends")
    function _()
      m.moveOther(5, 5)
      m.game.processCollisionsForTest()
      m.moveOther(200, 200)
      m.game.processCollisionsForTest()
      m.game.processCollisionsForTest()

      m.assertEqual(1, m.watcher.exitCount)
      m.assertEqual("Other", m.watcher.lastExitEntityName)
    end function

    @it("fires with an invalid entity once the other entity is destroyed")
    function _()
      m.moveOther(5, 5)
      m.game.processCollisionsForTest()
      m.game.destroyEntity(m.other)
      m.game.processCollisionsForTest()

      m.assertEqual(1, m.watcher.exitCount)
      m.assertTrue(m.watcher.lastExitHadInvalidEntity)
    end function

    @it("fires when my collider is disabled mid-overlap")
    function _()
      m.moveOther(5, 5)
      m.game.processCollisionsForTest()
      m.watcher.colliders["zone"].enabled = false
      m.game.processCollisionsForTest()

      m.assertEqual(1, m.watcher.exitCount)
    end function

    ' Issue #200: also confirmed on a Roku Ultra 4850CA (OS 15.3.4).
    @describe("onCollision for a persistent overlap")

    @it("fires every frame while two colliders stay overlapped")
    function _()
      m.moveOther(5, 5)
      for i = 1 to 60
        m.game.processCollisionsForTest()
      end for
      m.assertEqual(60, m.watcher.collisionCount)
      m.assertEqual(1, m.watcher.enterCount)
      m.assertEqual(0, m.watcher.exitCount)
    end function

    @it("doesn't fire for colliders that only touch edge to edge")
    function _()
      ' Other spans y 0..10 in compositor space, the watcher -20..0.
      m.moveOther(5, 10)
      m.game.processCollisionsForTest()
      m.assertEqual(0, m.watcher.collisionCount)
    end function

    @it("fires for an overlap of less than a pixel")
    function _()
      m.moveOther(5, 9.5)
      m.game.processCollisionsForTest()
      m.assertEqual(1, m.watcher.collisionCount)
    end function

    @describe("static entities")

    @it("are still hit by an entity that moves into them")
    function _()
      m.other.isStatic = true
      m.game.processCollisionsForTest()
      m.watcher.position = BGE.Math.VectorOps.create(195, 195)
      m.game.processCollisionsForTest()
      m.assertEqual(1, m.watcher.collisionCount)
    end function

    @it("don't check for collisions themselves")
    function _()
      m.watcher.isStatic = true
      m.moveOther(5, 5)
      m.game.processCollisionsForTest()
      m.assertEqual(0, m.watcher.collisionCount)
    end function

    @it("pass a collider change on to the compositor after markChanged()")
    function _()
      m.other.isStatic = true
      m.game.processCollisionsForTest()
      m.watcher.position = BGE.Math.VectorOps.create(195, 195)
      m.game.processCollisionsForTest()
      body = m.other.colliders["body"]
      body.enabled = false
      body.markChanged()
      m.game.processCollisionsForTest()
      m.game.processCollisionsForTest()
      m.assertEqual(1, m.watcher.collisionCount)
    end function

    @it("leaves a still static entity's collider alone until markChanged()")
    function _()
      m.makeOtherStillAndStatic()
      m.watcher.position = BGE.Math.VectorOps.create(195, 195)
      m.game.processCollisionsForTest()
      body = m.other.colliders["body"]
      body.offset = BGE.Math.VectorOps.create(-1000, -1000)
      m.game.processCollisionsForTest()
      m.assertEqual(2, m.watcher.collisionCount)
      body.markChanged()
      m.game.processCollisionsForTest()
      m.game.processCollisionsForTest()
      m.assertEqual(2, m.watcher.collisionCount)
    end function

    @it("syncs a collider added to a still static entity")
    function _()
      m.makeOtherStillAndStatic()
      m.other.addRectangleCollider("extra", 10, 10, -100, -100)
      m.watcher.position = BGE.Math.VectorOps.create(100, 100)
      m.game.processCollisionsForTest()
      m.assertEqual(1, m.watcher.collisionCount)
    end function

    ' Static, and settled so movedLastFrame() is false - only a pending sync reaches the compositor
    private sub makeOtherStillAndStatic()
      m.other.isStatic = true
      m.other.updateTransformationMatrix()
      m.other.updateTransformationMatrix()
      m.game.processCollisionsForTest()
    end sub

  end class

  ' Counts and records the collision callbacks it receives.
  class CollisionEventRecordingEntity extends BGE.GameEntity
    enterCount = 0
    exitCount = 0
    collisionCount = 0
    lastEnterEntityName as string = ""
    lastExitEntityName as string = ""
    lastExitHadInvalidEntity as boolean = false

    ' Explicit fully-qualified constructor - see ControlsCountingEntity in Game.spec.bs.
    sub new(gameEngine as BGE.Game, args = {} as roAssociativeArray)
      super(gameEngine, args)
    end sub

    override sub onCollision(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
      m.collisionCount++
    end sub

    override sub onCollisionEnter(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
      m.enterCount++
      m.lastEnterEntityName = otherEntity.name
    end sub

    override sub onCollisionExit(myCollider as BGE.Collider, otherCollider as BGE.Collider, otherEntity as BGE.GameEntity)
      m.exitCount++
      m.lastExitHadInvalidEntity = otherEntity = invalid
      if otherEntity <> invalid
        m.lastExitEntityName = otherEntity.name
      end if
    end sub
  end class

end namespace
