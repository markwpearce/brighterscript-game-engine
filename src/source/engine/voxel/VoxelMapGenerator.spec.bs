import "pkg:/source/engine/voxel/VoxelMapGenerator.bs"

namespace tests

  @suite("BGE.VoxelMapGenerator")
  class VoxelMapGeneratorTests extends rooibos.BaseTestSuite

    @describe("generate")

    @it("makes the same map from the same seed")
    function _()
      a = new BGE.VoxelMapGenerator({size: 64, seed: 7})
      b = new BGE.VoxelMapGenerator({size: 64, seed: 7})
      mapA = a.generate()
      mapB = b.generate()
      m.assertEqual(mapA.heightLevels[0].ToHexString(), mapB.heightLevels[0].ToHexString())
      m.assertEqual(mapA.colorLevels[0].ToHexString(), mapB.colorLevels[0].ToHexString())
      ' and again from the same generator
      m.assertEqual(mapA.heightLevels[0].ToHexString(), a.generate().heightLevels[0].ToHexString())
    end function

    @it("makes a different map from a different seed")
    function _()
      mapA = m.generateMap({size: 64, seed: 7})
      mapB = m.generateMap({size: 64, seed: 8})
      m.assertNotEqual(mapA.heightLevels[0].ToHexString(), mapB.heightLevels[0].ToHexString())
    end function

    @it("keeps heights in 0-255, none under sea level")
    function _()
      map = m.generateMap({size: 64, seaLevel: 60})
      lowest = 255
      highest = 0
      for each value in map.heightLevels[0]
        if value < lowest
          lowest = value
        end if
        if value > highest
          highest = value
        end if
      end for
      m.assertEqual(60, lowest)
      m.assertEqual(255, highest)
    end function

    @it("has 4 shades per biome and every level")
    function _()
      map = m.generateMap({size: 64})
      m.assertEqual(24, map.palette.count())
      m.assertEqual(4, map.getLevelCount())
      m.assertEqual(&h2A5DA8, map.palette[2])
      m.assertEqual(&hEEEEF2, map.palette[22])
    end function

    @it("colours each level by its own averaged heights")
    function _()
      gen = new BGE.VoxelMapGenerator({size: 64})
      map = gen.generate()
      tops = [] as integer[]
      for each biome in gen.biomes
        tops.push(biome.top)
      end for
      for level = 1 to map.getLevelCount() - 1
        heights = map.heightLevels[level]
        colors = map.colorLevels[level]
        for i = 0 to heights.count() - 1
          band = 0
          while band < tops.count() - 1 and heights[i] >= tops[band]
            band++
          end while
          m.assertEqual(band, colors[i] \ 4, `level ${level} cell ${i}`)
        end for
      end for
    end function

    @it("treats a negative seed as positive and ignores unknown options")
    function _()
      mapA = m.generateMap({size: 64, seed: -7, generate: "nope"})
      mapB = m.generateMap({size: 64, seed: 7})
      m.assertEqual(mapA.heightLevels[0].ToHexString(), mapB.heightLevels[0].ToHexString())
    end function

    @it("returns invalid for a bad size")
    function _()
      m.assertInvalid(m.generateMap({size: 100}))
    end function

    private function generateMap(options as BGE.VoxelMapGeneratorOptions) as dynamic
      gen = new BGE.VoxelMapGenerator(options)
      return gen.generate()
    end function


  end class

end namespace
