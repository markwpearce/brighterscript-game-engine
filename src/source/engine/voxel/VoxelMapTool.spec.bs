import "pkg:/source/engine/voxel/VoxelMap.bs"
import "pkg:/source/engine/voxel/VoxelMaps.bs"

namespace tests

  ' VoxelMapTool.spec.bvox was made by tools/voxel-map.py from its --write-test-pngs pair:
  '   python3 tools/voxel-map.py heights.png colors.png VoxelMapTool.spec.bvox --edge flat --flat-height 10
  @suite("BGE.VoxelMap from tools/voxel-map.py")
  class VoxelMapToolTests extends rooibos.BaseTestSuite

    @describe("a baked file")

    @it("matches fromArrays on the same data, level by level")
    function _()
      baked = BGE.VoxelMaps.fromFile("pkg:/source/engine/voxel/VoxelMapTool.spec.bvox")
      m.assertNotInvalid(baked)
      ' the tool's test_height() and test_color(): every 2x2's heights sum to a non-multiple of 4
      ' and the colours hit every kind of tie. Its palette is in order of first appearance, with
      ' the flat colour appended.
      rgbs = [&hFF0000, &h00FF00, &h0000FF]
      heights = CreateObject("roArray", 64 * 64, false)
      colors = CreateObject("roArray", 64 * 64, false)
      palette = [] as integer[]
      paletteIndex = {}
      for z = 0 to 63
        for x = 0 to 63
          heights[z * 64 + x] = (x * x * 3 + z * z * 5 + x * z) mod 256
          rgb = rgbs[((x * x + 3 * z + ((x * z) >> 2)) mod 5) mod 3]
          key = rgb.toStr()
          if not paletteIndex.DoesExist(key)
            paletteIndex[key] = palette.count()
            palette.push(rgb)
          end if
          colors[z * 64 + x] = paletteIndex[key]
        end for
      end for
      palette.push(&h2A5DA8)
      built = BGE.VoxelMaps.fromArrays(64, heights, colors, palette, {edgeMode: "flat", flatHeight: 10, flatColor: palette.count() - 1})
      m.assertEqual(built.palette, baked.palette)
      m.assertEqual("flat", baked.edgeMode)
      m.assertEqual(10, baked.flatHeight)
      m.assertEqual(3, baked.flatColor)
      m.assertEqual(built.getLevelCount(), baked.getLevelCount())
      for level = 0 to built.getLevelCount() - 1
        m.assertEqual(built.heightLevels[level].ToHexString(), baked.heightLevels[level].ToHexString(), `heights ${level}`)
        m.assertEqual(built.colorLevels[level].ToHexString(), baked.colorLevels[level].ToHexString(), `colours ${level}`)
      end for
    end function

  end class

end namespace
