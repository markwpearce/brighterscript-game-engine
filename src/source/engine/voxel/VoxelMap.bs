namespace BGE

  ' What a `BGE.VoxelMap` reads past its edges.
  enum VoxelEdgeMode
    ' The map repeats (it should be tileable)
    wrap = "wrap"
    ' A floor at `flatHeight`, coloured palette index `flatColor` (sea round an island)
    flat = "flat"
  end enum

  ' Options for `BGE.VoxelMaps.fromArrays()`.
  interface VoxelMapOptions extends roAssociativeArray
    ' `BGE.VoxelEdgeMode`, default wrap
    optional edgeMode as string
    ' Height (0-255) past the edges with `edgeMode` flat
    optional flatHeight as integer
    ' Palette index past the edges with `edgeMode` flat
    optional flatColor as integer
    ' Mip levels to use instead of building them (integer[][], level 0 first, each level a
    ' quarter of the one before); `colorLevels` must come with it
    optional heightLevels as dynamic
    optional colorLevels as dynamic
  end interface

  ' A heightmap terrain's data: a square grid of heights (0-255) and colours (palette indexes),
  ' with mip levels, where level n averages 2^n x 2^n cells. Map cell (x, z) is at index
  ' (z << sizeShift) + x.
  '
  ' Make one with `BGE.VoxelMaps.fromArrays()`, `BGE.VoxelMaps.fromFile()` (a `.bvox` from
  ' `tools/voxel-map.py`) or `BGE.VoxelMapGenerator`.
  class VoxelMap

    ' Cells along each side, a power of 2
    size as integer = 0
    ' log2(size)
    sizeShift as integer = 0
    ' size - 1
    mask as integer = 0
    ' RGB colours (0xRRGGBB), at most 256
    palette = [] as integer[]
    ' Heights per level, level 0 (full size) first
    heightLevels = [] as integer[][]
    ' Palette indexes per level, level 0 first
    colorLevels = [] as integer[][]
    ' `BGE.VoxelEdgeMode`
    edgeMode as string = "wrap"
    ' Height past the edges with edgeMode flat
    flatHeight as integer = 0
    ' Palette index past the edges with edgeMode flat
    flatColor as integer = 0

    ' Use `BGE.VoxelMaps.fromArrays()`, which checks its input; this doesn't.
    '
    ' @param {integer} sizeShift log2 of the size
    ' @param {integer[]} palette RGB colours
    ' @param {roArray} heightLevels integer[] per level, level 0 first
    ' @param {roArray} colorLevels integer[] per level, level 0 first
    sub new(sizeShift as integer, palette as integer[], heightLevels as roArray, colorLevels as roArray)
      m.sizeShift = sizeShift
      m.size = 1 << sizeShift
      m.mask = m.size - 1
      m.palette = palette
      m.heightLevels = heightLevels
      m.colorLevels = colorLevels
    end sub

    ' How many mip levels the map has, level 0 included.
    '
    ' @return {integer}
    function getLevelCount() as integer
      return m.heightLevels.count()
    end function

    ' The height (0-255) of a whole cell, past the edges by `edgeMode`.
    '
    ' @param {integer} ix
    ' @param {integer} iz
    ' @return {integer}
    function cellHeight(ix as integer, iz as integer) as integer
      if m.edgeMode = VoxelEdgeMode.flat
        if ix < 0 or iz < 0 or ix > m.mask or iz > m.mask
          return m.flatHeight
        end if
      end if
      return m.heightLevels[0][((iz and m.mask) << m.sizeShift) + (ix and m.mask)]
    end function

    ' The palette index of a whole cell, past the edges by `edgeMode`.
    '
    ' @param {integer} ix
    ' @param {integer} iz
    ' @return {integer}
    function colorAt(ix as integer, iz as integer) as integer
      if m.edgeMode = VoxelEdgeMode.flat
        if ix < 0 or iz < 0 or ix > m.mask or iz > m.mask
          return m.flatColor
        end if
      end if
      return m.colorLevels[0][((iz and m.mask) << m.sizeShift) + (ix and m.mask)]
    end function

    ' The height (0-255, fractional) at a map position in cells, blended between the four
    ' nearest cell centres (cell i's centre is at i + 0.5): for standing on the terrain.
    '
    ' @param {float} x
    ' @param {float} z
    ' @return {float}
    function heightAt(x as float, z as float) as float
      cx = x - 0.5
      cz = z - 0.5
      ix = int(cx)
      iz = int(cz)
      fx = cx - ix
      fz = cz - iz
      h00 = m.cellHeight(ix, iz)
      h10 = m.cellHeight(ix + 1, iz)
      h01 = m.cellHeight(ix, iz + 1)
      h11 = m.cellHeight(ix + 1, iz + 1)
      top = h00 + (h10 - h00) * fx
      bottom = h01 + (h11 - h01) * fx
      return top + (bottom - top) * fz
    end function

    ' The map as a `.bvox` file's bytes (see `BGE.VoxelMaps.fromByteArray()` for the layout).
    '
    ' @return {roByteArray}
    function toByteArray() as roByteArray
      bytes = CreateObject("roByteArray")
      bytes.FromAsciiString("BGEV")
      bytes.push(1)
      bytes.push(m.sizeShift)
      bytes.push(m.heightLevels.count())
      edge = 0
      if m.edgeMode = VoxelEdgeMode.flat
        edge = 1
      end if
      bytes.push(edge)
      bytes.push(m.flatHeight)
      bytes.push(m.flatColor)
      ' 256 colours is written as 0
      bytes.push(m.palette.count() and 255)
      for each rgb in m.palette
        bytes.push((rgb >> 16) and 255)
        bytes.push((rgb >> 8) and 255)
        bytes.push(rgb and 255)
      end for
      for level = 0 to m.heightLevels.count() - 1
        for each value in m.heightLevels[level]
          bytes.push(value)
        end for
        for each value in m.colorLevels[level]
          bytes.push(value)
        end for
      end for
      return bytes
    end function

    ' Writes the map as a `.bvox` file.
    '
    ' @param {string} path e.g. "tmp:/island.bvox"
    ' @return {boolean} whether it was written
    function saveToFile(path as string) as boolean
      return m.toByteArray().WriteFile(path)
    end function

  end class

end namespace
