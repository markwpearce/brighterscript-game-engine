import "pkg:/source/engine/voxel/VoxelMap.bs"
import "pkg:/source/engine/voxel/VoxelMaps.bs"

namespace tests

  @suite("BGE.VoxelMap files")
  class VoxelMapFileTests extends rooibos.BaseTestSuite

    @describe("save and load")

    @it("round-trips through a file")
    function _()
      map = m.sampleMap()
      m.assertTrue(map.saveToFile("tmp:/bge_voxel_test.bvox"))
      loaded = BGE.VoxelMaps.fromFile("tmp:/bge_voxel_test.bvox")
      m.assertNotInvalid(loaded)
      m.assertEqual(64, loaded.size)
      m.assertEqual("flat", loaded.edgeMode)
      m.assertEqual(40, loaded.flatHeight)
      m.assertEqual(2, loaded.flatColor)
      m.assertEqual(map.palette, loaded.palette)
      m.assertEqual(map.getLevelCount(), loaded.getLevelCount())
      for level = 0 to map.getLevelCount() - 1
        m.assertEqual(map.heightLevels[level].ToHexString(), loaded.heightLevels[level].ToHexString(), `heights ${level}`)
        m.assertEqual(map.colorLevels[level].ToHexString(), loaded.colorLevels[level].ToHexString(), `colours ${level}`)
      end for
    end function

    @it("writes the header")
    function _()
      bytes = m.sampleMap().toByteArray()
      expected = [66, 71, 69, 86, 1, 6, 4, 1, 40, 2, 3, &h12, &h34, &h56]
      for i = 0 to expected.count() - 1
        m.assertEqual(expected[i], bytes[i], `byte ${i}`)
      end for
      m.assertEqual(11 + 9 + 2 * (64 * 64 + 32 * 32 + 16 * 16 + 8 * 8), bytes.count())
    end function

    @it("writes 256 colours as a count of 0")
    function _()
      palette = CreateObject("roArray", 256, false)
      for i = 0 to 255
        palette[i] = i
      end for
      map = BGE.VoxelMaps.fromArrays(64, m.filled(64 * 64, 0), m.filled(64 * 64, 255), palette)
      bytes = map.toByteArray()
      m.assertEqual(0, bytes[10])
      loaded = BGE.VoxelMaps.fromByteArray(bytes)
      m.assertEqual(256, loaded.palette.count())
      m.assertEqual(255, loaded.colorAt(0, 0))
      m.assertEqual(255, loaded.palette[255])
    end function

    @describe("bad files")

    @it("rejects a bad header")
    function _()
      for each change in [[0, 65], [4, 2], [5, 5], [5, 11], [6, 0], [6, 5], [7, 2], [9, 3]]
        bytes = m.sampleMap().toByteArray()
        bytes[change[0]] = change[1]
        m.assertInvalid(BGE.VoxelMaps.fromByteArray(bytes), `byte ${change[0]} = ${change[1]}`)
      end for
    end function

    @it("rejects a file of the wrong length")
    function _()
      bytes = m.sampleMap().toByteArray()
      bytes.Pop()
      m.assertInvalid(BGE.VoxelMaps.fromByteArray(bytes))
      bytes.Push(0)
      bytes.Push(0)
      m.assertInvalid(BGE.VoxelMaps.fromByteArray(bytes))
      m.assertInvalid(BGE.VoxelMaps.fromByteArray(CreateObject("roByteArray")))
    end function

    @it("loads a file the same as its bytes")
    function _()
      map = m.sampleMap()
      bytes = map.toByteArray()
      bytes.WriteFile("tmp:/bge_voxel_same.bvox")
      fromFile = BGE.VoxelMaps.fromFile("tmp:/bge_voxel_same.bvox")
      fromBytes = BGE.VoxelMaps.fromByteArray(bytes)
      m.assertEqual(fromBytes.toByteArray().ToHexString(), fromFile.toByteArray().ToHexString())
      m.assertEqual(bytes.ToHexString(), fromFile.toByteArray().ToHexString())
    end function

    @it("rejects a file of the wrong length on disk")
    function _()
      bytes = m.sampleMap().toByteArray()
      bytes.Pop()
      bytes.WriteFile("tmp:/bge_voxel_short.bvox")
      m.assertInvalid(BGE.VoxelMaps.fromFile("tmp:/bge_voxel_short.bvox"))
    end function

    @it("returns invalid for a missing file")
    function _()
      m.assertInvalid(BGE.VoxelMaps.fromFile("tmp:/bge_voxel_missing.bvox"))
    end function

    ' A flat-edged 64 map, height (x + z) mod 256, colour (x + z) mod 3
    private function sampleMap() as dynamic
      heights = CreateObject("roArray", 64 * 64, false)
      colors = CreateObject("roArray", 64 * 64, false)
      for z = 0 to 63
        for x = 0 to 63
          heights[z * 64 + x] = (x * 3 + z) mod 256
          colors[z * 64 + x] = (x + z) mod 3
        end for
      end for
      return BGE.VoxelMaps.fromArrays(64, heights, colors, [&h123456, &h808080, &h0000FF], {edgeMode: "flat", flatHeight: 40, flatColor: 2})
    end function

    private function filled(count as integer, value as integer) as integer[]
      out = CreateObject("roArray", count, false)
      for i = 0 to count - 1
        out[i] = value
      end for
      return out
    end function

  end class

end namespace
