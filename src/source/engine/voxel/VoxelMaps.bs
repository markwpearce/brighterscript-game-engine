import "VoxelMap.bs"

' Building and loading `BGE.VoxelMap`s (kept out of VoxelMap.bs: a namespace function returning a
' class from its own file can corrupt that file's types).
namespace BGE.VoxelMaps

  ' Smallest and largest map sizes, as log2
  const MIN_SIZE_SHIFT = 6
  const MAX_SIZE_SHIFT = 10
  ' Most mip levels a map has, level 0 included
  const MAX_LEVELS = 6
  ' Bytes before a .bvox file's palette
  const HEADER_SIZE = 11

  ' log2 of a map size, or -1 if it isn't a power of 2 from 64 to 1024.
  '
  ' @param {integer} size
  ' @return {integer}
  function sizeShiftOf(size as integer) as integer
    for shift = MIN_SIZE_SHIFT to MAX_SIZE_SHIFT
      if (1 << shift) = size
        return shift
      end if
    end for
    return -1
  end function

  ' How many mip levels a map of this size has: up to 6, none smaller than 8x8.
  '
  ' @param {integer} sizeShift
  ' @return {integer}
  function maxLevelCount(sizeShift as integer) as integer
    count = sizeShift - 2
    if count > MAX_LEVELS
      count = MAX_LEVELS
    end if
    return count
  end function

  ' An integer array (values 0-255) as an roByteArray.
  '
  ' @param {integer[]} values
  ' @return {roByteArray}
  function toBytes(values as integer[]) as roByteArray
    out = CreateObject("roByteArray")
    out[values.count() - 1] = 0
    for i = 0 to values.count() - 1
      out[i] = values[i]
    end for
    return out
  end function

  ' The next mip level of a heightmap: each 2x2 averaged, rounded down.
  '
  ' @param {roByteArray} heights a level (1 << levelShift) cells square
  ' @param {integer} levelShift log2 of that level's size
  ' @return {roByteArray}
  function averageHeights(heights as roByteArray, levelShift as integer) as roByteArray
    outShift = levelShift - 1
    outSize = 1 << outShift
    out = CreateObject("roByteArray")
    out[outSize * outSize - 1] = 0
    for z = 0 to outSize - 1
      row0 = (z * 2) << levelShift
      row1 = row0 + (1 << levelShift)
      outRow = z << outShift
      for x = 0 to outSize - 1
        x2 = x * 2
        out[outRow + x] = (heights[row0 + x2] + heights[row0 + x2 + 1] + heights[row1 + x2] + heights[row1 + x2 + 1]) \ 4
      end for
    end for
    return out
  end function

  ' The next mip level of a colour map: the most common palette index of each 2x2, a tie going
  ' to the first of the tied ones in the order (x, z), (x + 1, z), (x, z + 1), (x + 1, z + 1).
  ' `tools/voxel-map.py` uses the same rule.
  '
  ' @param {roByteArray} colors a level (1 << levelShift) cells square
  ' @param {integer} levelShift log2 of that level's size
  ' @return {roByteArray}
  function mostCommonColors(colors as roByteArray, levelShift as integer) as roByteArray
    outShift = levelShift - 1
    outSize = 1 << outShift
    out = CreateObject("roByteArray")
    out[outSize * outSize - 1] = 0
    for z = 0 to outSize - 1
      row0 = (z * 2) << levelShift
      row1 = row0 + (1 << levelShift)
      outRow = z << outShift
      for x = 0 to outSize - 1
        x2 = x * 2
        a = colors[row0 + x2]
        b = colors[row0 + x2 + 1]
        c = colors[row1 + x2]
        d = colors[row1 + x2 + 1]
        ' a wins with 2 or more; else b with 2 or more; else c = d wins; else (all different) a
        best = a
        bestCount = 1
        if b = a
          bestCount++
        end if
        if c = a
          bestCount++
        end if
        if d = a
          bestCount++
        end if
        if bestCount < 2
          countB = 1
          if c = b
            countB++
          end if
          if d = b
            countB++
          end if
          if countB > bestCount
            best = b
            bestCount = countB
          end if
          if c = d and bestCount < 2
            best = c
          end if
        end if
        out[outRow + x] = best
      end for
    end for
    return out
  end function

  ' A map from flat arrays, with its mip levels built.
  '
  ' @param {integer} size cells along each side: a power of 2 from 64 to 1024
  ' @param {integer[]} heights size * size heights, 0-255, row by row (index z * size + x)
  ' @param {integer[]} colors size * size palette indexes
  ' @param {integer[]} palette RGB colours (0xRRGGBB), 1-256 of them
  ' @param {BGE.VoxelMapOptions} [options]
  ' @return {dynamic} a `BGE.VoxelMap`, or invalid (and a printed reason) if the input is bad
  function fromArrays(size as integer, heights as integer[], colors as integer[], palette as integer[], options = {} as BGE.VoxelMapOptions) as dynamic
    shift = sizeShiftOf(size)
    if shift < 0
      return fail(`size ${size} isn't a power of 2 from 64 to 1024`)
    end if
    paletteCount = palette.count()
    if paletteCount < 1 or paletteCount > 256
      return fail(`a palette needs 1-256 colours, not ${paletteCount}`)
    end if
    cellCount = size * size
    if heights.count() <> cellCount or colors.count() <> cellCount
      return fail(`a ${size} map needs ${cellCount} heights and colours`)
    end if
    for i = 0 to cellCount - 1
      h = heights[i]
      if h < 0 or h > 255
        return fail(`height ${h} at ${i} isn't 0-255`)
      end if
      c = colors[i]
      if c < 0 or c >= paletteCount
        return fail(`colour ${c} at ${i} isn't in the palette`)
      end if
    end for
    heightLevels = [toBytes(heights)] as roByteArray[]
    colorLevels = [toBytes(colors)] as roByteArray[]
    for level = 1 to maxLevelCount(shift) - 1
      heightLevels.push(averageHeights(heightLevels[level - 1], shift - level + 1))
      colorLevels.push(mostCommonColors(colorLevels[level - 1], shift - level + 1))
    end for
    return fromLevels(shift, palette, heightLevels, colorLevels, options)
  end function

  ' A map from mip levels already built (e.g. a generator's, shaded per level). Checks the
  ' sizes, not the values.
  '
  ' @param {integer} sizeShift log2 of the size, 6-10
  ' @param {integer[]} palette RGB colours (0xRRGGBB), 1-256 of them
  ' @param {roByteArray[]} heightLevels level 0 (size x size) first, each a quarter of the last
  ' @param {roByteArray[]} colorLevels the same for palette indexes
  ' @param {BGE.VoxelMapOptions} [options]
  ' @return {dynamic} a `BGE.VoxelMap`, or invalid (and a printed reason) if the input is bad
  function fromLevels(sizeShift as integer, palette as integer[], heightLevels as roByteArray[], colorLevels as roByteArray[], options = {} as BGE.VoxelMapOptions) as dynamic
    if sizeShift < MIN_SIZE_SHIFT or sizeShift > MAX_SIZE_SHIFT
      return fail(`bad size shift ${sizeShift}`)
    end if
    paletteCount = palette.count()
    if paletteCount < 1 or paletteCount > 256
      return fail(`a palette needs 1-256 colours, not ${paletteCount}`)
    end if
    levelCount = heightLevels.count()
    if levelCount < 1 or levelCount > maxLevelCount(sizeShift) or colorLevels.count() <> levelCount
      return fail(`need 1-${maxLevelCount(sizeShift)} height and colour levels, the same number of each`)
    end if
    for level = 0 to levelCount - 1
      levelSize = 1 << (sizeShift - level)
      if heightLevels[level].count() <> levelSize * levelSize or colorLevels[level].count() <> levelSize * levelSize
        return fail(`level ${level} needs ${levelSize * levelSize} heights and colours`)
      end if
    end for
    map = new BGE.VoxelMap(sizeShift, palette, heightLevels, colorLevels)
    if invalid <> options.edgeMode
      map.edgeMode = options.edgeMode
    end if
    if invalid <> options.flatHeight
      map.flatHeight = options.flatHeight
    end if
    if invalid <> options.flatColor
      map.flatColor = options.flatColor
    end if
    if map.edgeMode <> BGE.VoxelEdgeMode.wrap and map.edgeMode <> BGE.VoxelEdgeMode.flat
      return fail(`unknown edgeMode "${map.edgeMode}"`)
    end if
    if map.flatHeight < 0 or map.flatHeight > 255 or map.flatColor < 0 or map.flatColor >= paletteCount
      return fail("flatHeight must be 0-255 and flatColor in the palette")
    end if
    return map
  end function

  ' Prints why a map couldn't be made, and returns invalid.
  function fail(message as string) as dynamic
    print "[BGE.VoxelMap] " + message
    return invalid
  end function

  ' Loads a `.bvox` file (from `tools/voxel-map.py` or `VoxelMap.saveToFile()`). Each level is
  ' read straight into its own byte array, so it's quick: no loop over the cells.
  '
  ' @param {string} path e.g. "pkg:/maps/island.bvox"
  ' @return {dynamic} a `BGE.VoxelMap`, or invalid (and a printed reason)
  function fromFile(path as string) as dynamic
    stat = CreateObject("roFileSystem").Stat(path)
    if invalid = stat or invalid = stat.size
      return fail(`couldn't read ${path}`)
    end if
    header = CreateObject("roByteArray")
    if not header.ReadFile(path, 0, HEADER_SIZE)
      return fail(`couldn't read ${path}`)
    end if
    info = parseHeader(header, stat.size)
    if invalid = info
      return invalid
    end if
    paletteBytes = CreateObject("roByteArray")
    paletteBytes.ReadFile(path, HEADER_SIZE, info.paletteCount * 3)
    offset = HEADER_SIZE + info.paletteCount * 3
    heightLevels = [] as roByteArray[]
    colorLevels = [] as roByteArray[]
    for level = 0 to info.levelCount - 1
      levelSize = 1 << (info.shift - level)
      cellCount = levelSize * levelSize
      heights = CreateObject("roByteArray")
      colors = CreateObject("roByteArray")
      if not heights.ReadFile(path, offset, cellCount) or not colors.ReadFile(path, offset + cellCount, cellCount)
        return fail(`couldn't read ${path}`)
      end if
      offset += cellCount * 2
      heightLevels.push(heights)
      colorLevels.push(colors)
    end for
    return fromParts(info, paletteBytes, 0, heightLevels, colorLevels)
  end function

  ' A map from a `.bvox` file's bytes. Version 1 layout, one byte per value:
  ' "BGEV", version (1), log2 size, level count, edge mode (0 wrap, 1 flat), flat height,
  ' flat colour, palette count (0 = 256), RGB per palette entry, then per level (level 0 first)
  ' its heights then its colours, row by row.
  '
  ' @param {roByteArray} bytes
  ' @return {dynamic} a `BGE.VoxelMap`, or invalid (and a printed reason)
  function fromByteArray(bytes as roByteArray) as dynamic
    info = parseHeader(bytes, bytes.count())
    if invalid = info
      return invalid
    end if
    offset = HEADER_SIZE + info.paletteCount * 3
    heightLevels = [] as roByteArray[]
    colorLevels = [] as roByteArray[]
    for level = 0 to info.levelCount - 1
      levelSize = 1 << (info.shift - level)
      cellCount = levelSize * levelSize
      heights = CreateObject("roByteArray")
      heights[cellCount - 1] = 0
      for i = 0 to cellCount - 1
        heights[i] = bytes[offset + i]
      end for
      offset += cellCount
      colors = CreateObject("roByteArray")
      colors[cellCount - 1] = 0
      for i = 0 to cellCount - 1
        colors[i] = bytes[offset + i]
      end for
      offset += cellCount
      heightLevels.push(heights)
      colorLevels.push(colors)
    end for
    return fromParts(info, bytes, HEADER_SIZE, heightLevels, colorLevels)
  end function

  ' Checks a .bvox header (its first HEADER_SIZE bytes) against the file's length.
  '
  ' @return {dynamic} shift, levelCount, edge, flatHeight, flatColor and paletteCount, or
  '   invalid (and a printed reason)
  function parseHeader(bytes as roByteArray, total as integer) as dynamic
    if bytes.count() < HEADER_SIZE or bytes[0] <> 66 or bytes[1] <> 71 or bytes[2] <> 69 or bytes[3] <> 86
      return fail("not a .bvox file")
    end if
    if bytes[4] <> 1
      return fail(`unsupported .bvox version ${bytes[4]}`)
    end if
    shift = bytes[5]
    if shift < MIN_SIZE_SHIFT or shift > MAX_SIZE_SHIFT
      return fail(`bad size shift ${shift}`)
    end if
    levelCount = bytes[6]
    if levelCount < 1 or levelCount > maxLevelCount(shift)
      return fail(`bad level count ${levelCount}`)
    end if
    edge = bytes[7]
    if edge > 1
      return fail(`bad edge mode ${edge}`)
    end if
    paletteCount = bytes[10]
    if paletteCount = 0
      paletteCount = 256
    end if
    expected = HEADER_SIZE + paletteCount * 3
    for level = 0 to levelCount - 1
      levelSize = 1 << (shift - level)
      expected += 2 * levelSize * levelSize
    end for
    if total <> expected
      return fail(`expected ${expected} bytes, found ${total}`)
    end if
    return {shift: shift, levelCount: levelCount, edge: edge, flatHeight: bytes[8], flatColor: bytes[9], paletteCount: paletteCount}
  end function

  ' The map from a parsed header, its palette bytes (RGB from paletteOffset) and levels
  function fromParts(info as roAssociativeArray, paletteBytes as roByteArray, paletteOffset as integer, heightLevels as roByteArray[], colorLevels as roByteArray[]) as dynamic
    palette = CreateObject("roArray", info.paletteCount, false)
    p = paletteOffset
    for i = 0 to info.paletteCount - 1
      palette[i] = (paletteBytes[p] << 16) + (paletteBytes[p + 1] << 8) + paletteBytes[p + 2]
      p += 3
    end for
    edgeMode = BGE.VoxelEdgeMode.wrap
    if info.edge = 1
      edgeMode = BGE.VoxelEdgeMode.flat
    end if
    return fromLevels(info.shift, palette, heightLevels, colorLevels, {edgeMode: edgeMode, flatHeight: info.flatHeight, flatColor: info.flatColor})
  end function

end namespace
