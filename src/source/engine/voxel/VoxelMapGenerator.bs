import "VoxelMap.bs"
import "VoxelMaps.bs"

namespace BGE

  ' A height band of a generated map and its colour.
  interface VoxelBiome extends roAssociativeArray
    ' Heights below this (and at or above the previous biome's top) are this biome; the last
    ' biome's should be 256
    top as integer
    ' RGB (0xRRGGBB)
    rgb as integer
  end interface

  ' Options for `BGE.VoxelMapGenerator`.
  interface VoxelMapGeneratorOptions extends roAssociativeArray
    ' Cells along each side, a power of 2 from 64 to 1024 (default 256)
    optional size as integer
    ' The same seed makes the same map (default 12345)
    optional seed as integer
    ' How much each finer level of detail keeps of the one before: lower is smoother
    ' (default 0.55)
    optional roughness as float
    ' Heights below this (0-255) are flattened to it, as water (default 70)
    optional seaLevel as integer
    ' Height bands, lowest first (default: water, sand, grass, forest, rock, snow)
    optional biomes as VoxelBiome[]
    ' Shade by slope, lit from the north-west (default true)
    optional slopeShading as boolean
  end interface

  ' Generates a tileable `BGE.VoxelMap`: diamond-square heights, coloured by height band (biome)
  ' in 4 shades by slope. Each mip level is re-shaded from its own averaged heights.
  '
  ' Slow: a 256 map takes ~1.3 s on a Roku Ultra, long enough to risk the watchdog on slower
  ' devices, so games should load a baked map (`tools/voxel-map.py`, or `saveToFile()` a
  ' generated one) instead.
  '
  ' Palette: biome b in shade s (0-3, darkest first) is index b * 4 + s.
  class VoxelMapGenerator

    size as integer = 256
    ' Negative seeds are made positive
    seed as integer = 12345
    roughness as float = 0.55
    seaLevel as integer = 70
    ' Empty for the defaults
    biomes = [] as VoxelBiome[]
    slopeShading as boolean = true

    private state as longinteger = 0
    private shadeFactors = [0.6, 0.8, 1.0, 1.15] as float[]

    ' @param {BGE.VoxelMapGeneratorOptions} [options]
    sub new(options = {} as BGE.VoxelMapGeneratorOptions)
      for each key in ["size", "seed", "roughness", "seaLevel", "biomes", "slopeShading"]
        if options.DoesExist(key)
          m[key] = options[key]
        end if
      end for
      ' the generator's arithmetic needs a non-negative seed; -2^31 has no positive integer
      if m.seed = &h80000000
        m.seed = &h7FFFFFFF
      else if m.seed < 0
        m.seed = -m.seed
      end if
      ' heights are stored in bytes
      if m.seaLevel < 0
        m.seaLevel = 0
      else if m.seaLevel > 255
        m.seaLevel = 255
      end if
      if invalid = m.biomes or m.biomes.count() = 0
        m.biomes = [
          {top: m.seaLevel + 1, rgb: &h2A5DA8}
          {top: m.seaLevel + 8, rgb: &hD8C98A}
          {top: 120, rgb: &h4E9A3A}
          {top: 165, rgb: &h2F6E2A}
          {top: 205, rgb: &h7A6F66}
          {top: 256, rgb: &hEEEEF2}
        ] as VoxelBiome[]
        ' a high sea level would put the fixed tops out of order
        for i = 1 to m.biomes.count() - 1
          if m.biomes[i].top < m.biomes[i - 1].top
            m.biomes[i].top = m.biomes[i - 1].top
          end if
          if m.biomes[i].top > 256
            m.biomes[i].top = 256
          end if
        end for
      end if
    end sub

    ' @return {dynamic} a `BGE.VoxelMap`, or invalid if the size isn't valid
    function generate() as dynamic
      shift = BGE.VoxelMaps.sizeShiftOf(m.size)
      if shift < 0
        return BGE.VoxelMaps.fail(`size ${m.size} isn't a power of 2 from 64 to 1024`)
      end if
      m.state = m.seed
      heights = m.generateHeights(shift)

      palette = [] as integer[]
      for each biome in m.biomes
        for each factor in m.shadeFactors
          palette.push(m.scaleColor(biome.rgb, factor))
        end for
      end for

      heightLevels = [heights] as roByteArray[]
      colorLevels = [m.colorMap(heights, shift, 0)] as roByteArray[]
      levelCount = BGE.VoxelMaps.maxLevelCount(shift)
      for level = 1 to levelCount - 1
        averaged = BGE.VoxelMaps.averageHeights(heightLevels[level - 1], shift - level + 1)
        heightLevels.push(averaged)
        colorLevels.push(m.colorMap(averaged, shift - level, level))
      end for
      return BGE.VoxelMaps.fromLevels(shift, palette, heightLevels, colorLevels)
    end function

    ' Diamond-square on a wrapped grid, normalised to 0-255, with water flattened to sea level
    private function generateHeights(shift as integer) as roByteArray
      size = 1 << shift
      mask = size - 1
      h = CreateObject("roArray", size * size, false)
      for i = 0 to size * size - 1
        h[i] = 0.0
      end for
      scale = 1.0
      stepSize = size
      while stepSize > 1
        half = stepSize \ 2
        ' diamond: the centre of each square
        for y = half to size - 1 step stepSize
          for x = half to size - 1 step stepSize
            x0 = (x - half) and mask
            x1 = (x + half) and mask
            y0 = ((y - half) and mask) << shift
            y1 = ((y + half) and mask) << shift
            avg = (h[y0 + x0] + h[y0 + x1] + h[y1 + x0] + h[y1 + x1]) * 0.25
            h[(y << shift) + x] = avg + (m.rand() - 0.5) * scale
          end for
        end for
        ' square: the middle of each edge
        for y = 0 to size - 1 step half
          startX = 0
          if (y \ half) mod 2 = 0
            startX = half
          end if
          for x = startX to size - 1 step stepSize
            row = y << shift
            up = ((y - half) and mask) << shift
            down = ((y + half) and mask) << shift
            avg = (h[row + ((x - half) and mask)] + h[row + ((x + half) and mask)] + h[up + x] + h[down + x]) * 0.25
            h[row + x] = avg + (m.rand() - 0.5) * scale
          end for
        end for
        stepSize = half
        scale *= m.roughness
      end while

      minH = h[0]
      maxH = h[0]
      for each value in h
        if value < minH
          minH = value
        end if
        if value > maxH
          maxH = value
        end if
      end for
      range = maxH - minH
      if range <= 0
        range = 1
      end if
      seaLevel = m.seaLevel
      out = CreateObject("roByteArray")
      out[size * size - 1] = 0
      for i = 0 to size * size - 1
        value = cint((h[i] - minH) / range * 255)
        if value < seaLevel
          value = seaLevel
        end if
        out[i] = value
      end for
      return out
    end function

    ' Palette indexes for a level of heights (2^level cells per entry): biome by height, shade
    ' by the slope down to the south-east
    private function colorMap(levelHeights as roByteArray, shift as integer, level as integer) as roByteArray
      size = 1 << shift
      mask = size - 1
      cellsPerEntry = 1 << level
      tops = [] as integer[]
      for each biome in m.biomes
        tops.push(biome.top)
      end for
      lastBiome = tops.count() - 1
      out = CreateObject("roByteArray")
      out[size * size - 1] = 0
      for y = 0 to size - 1
        row = y << shift
        nextRow = ((y + 1) and mask) << shift
        for x = 0 to size - 1
          value = levelHeights[row + x]
          band = 0
          while band < lastBiome and value >= tops[band]
            band++
          end while
          ' lit from the north-west: brighter where the terrain falls away to the south-east
          slope = (value - levelHeights[nextRow + ((x + 1) and mask)]) / cellsPerEntry
          shade = 2
          if band > 0 and m.slopeShading
            if slope > 4
              shade = 3
            else if slope < -4
              shade = 0
            else if slope < 0
              shade = 1
            end if
          end if
          out[row + x] = band * 4 + shade
        end for
      end for
      return out
    end function

    ' rgb scaled by factor, clamped
    private function scaleColor(rgb as integer, factor as float) as integer
      r = cint(((rgb >> 16) and 255) * factor)
      g = cint(((rgb >> 8) and 255) * factor)
      b = cint((rgb and 255) * factor)
      if r > 255
        r = 255
      end if
      if g > 255
        g = 255
      end if
      if b > 255
        b = 255
      end if
      return (r << 16) + (g << 8) + b
    end function

    ' Deterministic 0-1 from the seed
    private function rand() as float
      m.state = (m.state * 1103515245& + 12345&) mod 2147483648&
      return m.state / 2147483648.0
    end function

  end class

end namespace
