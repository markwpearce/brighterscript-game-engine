namespace BGE

  ' A point on a `BGE.NavGrid`'s plane, in its `SolidWorld`'s coordinates.
  interface NavPoint
    x as float
    ' World y for a top-down game; world z for a 3D ground plane
    y as float
  end interface

  ' One cell of a `BGE.NavGrid`.
  interface NavCell
    col as integer
    row as integer
  end interface

  ' Options for `new BGE.NavGrid()`.
  interface NavGridOptions extends roAssociativeArray
    ' Width and height of each cell. Smaller finds narrower gaps but costs more memory and
    ' search time. About the agent's diameter or less works well. Default 32.
    optional cellSize as float
    ' Solids are grown by this much before they block cells, so paths keep the agent's body clear
    ' of them. Default 0.
    optional agentRadius as float
    ' Bottom-left corner of the area the grid covers. Default 0 (only used with width/height).
    optional minX as float
    optional minY as float
    ' Size of the area the grid covers. Give both, or the grid covers every solid in the world
    ' plus a margin of `agentRadius` and one cell. Points outside the grid count as blocked, so
    ' give the area if agents walk on open ground beyond the outermost solids.
    optional width as float
    optional height as float
  end interface

  ' Options for `BGE.NavGrid.findPath()` and `startSearch()`.
  interface NavSearchOptions extends roAssociativeArray
    ' Give up after expanding this many cells. Default 20000.
    optional maxExpandedCells as integer
    ' When the goal can't be reached (or the search gives up), return a path to the cell
    ' nearest the goal instead of none. Default true.
    optional allowPartial as boolean
    ' Smooth the path with line-of-sight checks. Default true.
    optional smooth as boolean
    ' A start or goal in a blocked cell moves to the nearest open cell up to this many cells
    ' away. Default 8.
    optional snapRings as integer
  end interface

  ' For internal use: one search's per-cell state, kept by the grid and reused by later searches.
  ' Indexes are into the grid's padded cell array.
  interface NavSearchState
    gCost as float[]
    parentOf as integer[]
    ' A cell is open in this search when its mark is `stamp`, closed when it's `stamp + 1`
    mark as integer[]
    stamp as integer
    heapCells as integer[]
    heapF as float[]
  end interface

  ' Where a `BGE.NavPathSearch` has got to.
  enum NavPathStatus
    ' Still running: keep calling step()
    searching = "searching"
    ' Reached the goal (or the open cell nearest it, if it was blocked)
    found = "found"
    ' Couldn't reach the goal; `path` leads to the cell nearest it (just the start, if the
    ' agent is already there)
    partial = "partial"
    ' No path at all: the start is buried in a solid deeper than `snapRings`, or the goal
    ' can't be reached and partial paths are off
    failed = "failed"
  end enum

end namespace
