import "pkg:/source/engine/ui/Button.bs"
namespace tests

  ' GameScene is just a GameEntity subclass - the "current scene" is processed
  ' like any other entity (see Game.processEntitiesPreDraw), always first/
  ' last in the update and collision passes. This mostly confirms GameScene
  ' participates correctly in the same GameEntity/Game machinery already
  ' covered by GameEntity.spec.bs/Game.spec.bs.
  @suite("BGE.GameScene")
  class GameSceneTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("new")

    @it("takes its name from the constructor args, like any GameEntity")
    function _()
      scene = new BGE.GameScene(m.game, {name: "MainScene"})
      m.assertEqual("MainScene", scene.name)
    end function

    @it("is valid immediately after creation")
    function _()
      scene = new BGE.GameScene(m.game, {name: "MainScene"})
      m.assertTrue(scene.isValid())
    end function

    @describe("defineScene / changeScene / getScene round trip")

    @it("becomes the game's current scene once changed to")
    function _()
      scene = new BGE.GameScene(m.game, {name: "MainScene"})
      m.game.defineScene(scene)
      m.game.changeScene("MainScene")

      m.assertEqual(scene.id, m.game.getScene().id)
      m.assertEqual("MainScene", m.game.getScene().name)
    end function

    @it("lists every defined scene in getSceneNames(), in the order they were defined")
    function _()
      m.game.defineScene(new BGE.GameScene(m.game, {name: "Zebra"}))
      m.game.defineScene(new BGE.GameScene(m.game, {name: "Apple"}))
      m.game.defineScene(new BGE.GameScene(m.game, {name: "Mango"}))

      m.assertEqual(["Zebra", "Apple", "Mango"], m.game.getSceneNames())
    end function

    @it("keeps a scene's first position in getSceneNames() when it is defined again")
    function _()
      m.game.defineScene(new BGE.GameScene(m.game, {name: "Zebra"}))
      m.game.defineScene(new BGE.GameScene(m.game, {name: "Apple"}))
      m.game.defineScene(new BGE.GameScene(m.game, {name: "Zebra"}))

      m.assertEqual(["Zebra", "Apple"], m.game.getSceneNames())
    end function

    @it("returns false and keeps the current scene when changing to an undefined scene")
    function _()
      scene = new BGE.GameScene(m.game, {name: "SceneA"})
      m.game.defineScene(scene)
      m.game.changeScene("SceneA")

      m.assertFalse(m.game.changeScene("DoesNotExist"))
      m.assertEqual("SceneA", m.game.getScene().name)
    end function

    ' See #144: a GameScene's own directly-added drawables aren't in Game.sortedEntities, so
    ' they're never touched by Game.handleSceneChange()'s automatic non-persistent-entity
    ' cleanup. GameScene's default onChangeScene() compensates for that gap directly.
    @describe("onChangeScene - default drawable cleanup (#144)")

    @it("removes this scene's own directly-added drawables by default when changing to a different scene")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      sceneB = new BGE.GameScene(m.game, {name: "SceneB"})
      m.game.defineScene(sceneA)
      m.game.defineScene(sceneB)

      ' Immediate - currentScene is still invalid at this point.
      m.game.changeScene("SceneA")
      sceneA.addDrawable("rect", new BGE.DrawableRectangle(sceneA, 10, 10))
      m.assertNotInvalid(sceneA.getDrawable("rect"))

      ' A scene change past the first is deferred to end-of-frame unless the game isn't
      ' running - End() forces changeScene to process it immediately for this test.
      m.game.End()
      m.game.changeScene("SceneB")

      m.assertEqual(0, sceneA.drawablesByName.Count())
    end function

    @it("keeps its own drawables across a scene change when persistDrawablesAcrossSceneChange is true")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      sceneB = new BGE.GameScene(m.game, {name: "SceneB"})
      sceneA.persistDrawablesAcrossSceneChange = true
      m.game.defineScene(sceneA)
      m.game.defineScene(sceneB)

      m.game.changeScene("SceneA")
      sceneA.addDrawable("rect", new BGE.DrawableRectangle(sceneA, 10, 10))

      m.game.End()
      m.game.changeScene("SceneB")

      m.assertNotInvalid(sceneA.getDrawable("rect"))
    end function

    @describe("changing to the same scene (#575)")

    @it("removes its own drawables on resetScene(), like leaving it")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      m.game.defineScene(sceneA)

      m.game.changeScene("SceneA")
      sceneA.addDrawable("rect", new BGE.DrawableRectangle(sceneA, 10, 10))

      m.game.End()
      m.game.resetScene()

      m.assertEqual(0, sceneA.drawablesByName.Count())
    end function

    @it("re-adds its drawables from onCreate() when changed to itself with new args")
    function _()
      level = new LevelSceneForSceneTests(m.game, {name: "Level"})
      m.game.defineScene(level)
      m.game.changeScene("Level", {level: 1})

      m.game.End()
      m.game.changeScene("Level", {level: 2})

      m.assertEqual(2, level.createCount)
      m.assertEqual(1, level.destroyCount)
      m.assertEqual(2, level.lastLevel)
      m.assertEqual(1, level.drawablesByName.Count())
      m.assertEqual(2, level.floorsAdded)
    end function

    @it("keeps its drawables on a same-scene change when persistDrawablesAcrossSceneChange is true")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      sceneA.persistDrawablesAcrossSceneChange = true
      m.game.defineScene(sceneA)
      m.game.changeScene("SceneA")
      sceneA.addDrawable("rect", new BGE.DrawableRectangle(sceneA, 10, 10))

      m.game.End()
      m.game.resetScene()

      m.assertNotInvalid(sceneA.getDrawable("rect"))
    end function

    @it("keeps its drawables when an onChangeScene() override skips super")
    function _()
      keeper = new KeepDrawablesSceneForSceneTests(m.game, {name: "Keeper"})
      m.game.defineScene(keeper)
      m.game.changeScene("Keeper")
      keeper.addDrawable("rect", new BGE.DrawableRectangle(keeper, 10, 10))

      m.game.End()
      m.game.resetScene()

      m.assertNotInvalid(keeper.getDrawable("rect"))
    end function

    @it("re-creates the scene through changeSceneWithFade() to itself")
    function _()
      level = new LevelSceneForSceneTests(m.game, {name: "Level"})
      m.game.defineScene(level)
      m.game.changeScene("Level", {level: 1})

      m.assertTrue(m.game.changeSceneWithFade("Level", {level: 3}, 0.05))
      for i = 0 to 9
        m.game.updateFadeTransitionForTest(0.02)
      end for

      m.assertEqual(2, level.createCount)
      m.assertEqual(3, level.lastLevel)
      m.assertEqual(2, level.floorsAdded)
    end function

    @describe("addUi - scene-owned UI")

    @it("adds the widget to gameUi")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      m.game.defineScene(sceneA)
      m.game.changeScene("SceneA")
      before = m.game.gameUi.childCount()

      sceneA.addUi(new BGE.UI.Button(m.game))

      m.assertEqual(before + 1, m.game.gameUi.childCount())
      m.assertEqual(1, sceneA.uiCount())
    end function

    @it("adding the same widget twice adds it once")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      m.game.defineScene(sceneA)
      m.game.changeScene("SceneA")
      before = m.game.gameUi.childCount()
      button = new BGE.UI.Button(m.game)

      sceneA.addUi(button)
      sceneA.addUi(button)

      m.assertEqual(before + 1, m.game.gameUi.childCount())
      m.assertEqual(1, sceneA.uiCount())
    end function

    @it("removes its widgets and their focus registrations when the scene changes")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      sceneB = new BGE.GameScene(m.game, {name: "SceneB"})
      m.game.defineScene(sceneA)
      m.game.defineScene(sceneB)
      m.game.changeScene("SceneA")
      before = m.game.gameUi.childCount()
      focusBefore = m.game.focusManager.registeredCount()
      sceneA.addUi(new BGE.UI.Button(m.game))

      m.game.End()
      m.game.changeScene("SceneB")

      m.assertEqual(before, m.game.gameUi.childCount())
      m.assertEqual(focusBefore, m.game.focusManager.registeredCount())
      m.assertEqual(0, sceneA.uiCount())
    end function

    @it("removes its widgets on resetScene()")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      m.game.defineScene(sceneA)
      m.game.changeScene("SceneA")
      before = m.game.gameUi.childCount()
      sceneA.addUi(new BGE.UI.Button(m.game))

      m.game.End()
      m.game.resetScene()

      m.assertEqual(before, m.game.gameUi.childCount())
    end function

    @it("keeps widgets added to gameUi directly")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      sceneB = new BGE.GameScene(m.game, {name: "SceneB"})
      m.game.defineScene(sceneA)
      m.game.defineScene(sceneB)
      m.game.changeScene("SceneA")
      m.game.gameUi.addChild(new BGE.UI.Button(m.game))
      before = m.game.gameUi.childCount()

      m.game.End()
      m.game.changeScene("SceneB")

      m.assertEqual(before, m.game.gameUi.childCount())
    end function

    @it("removeUi() removes one widget")
    function _()
      sceneA = new BGE.GameScene(m.game, {name: "SceneA"})
      m.game.defineScene(sceneA)
      m.game.changeScene("SceneA")
      before = m.game.gameUi.childCount()
      button = new BGE.UI.Button(m.game)
      sceneA.addUi(button)

      sceneA.removeUi(button)

      m.assertEqual(before, m.game.gameUi.childCount())
      m.assertEqual(0, sceneA.uiCount())
    end function

  end class


  ' Adds a "floor" drawable in onCreate(), like a level scene that changes to itself.
  class LevelSceneForSceneTests extends BGE.GameScene
    createCount as integer = 0
    destroyCount as integer = 0
    lastLevel as integer = 0
    ' addDrawable() returns invalid when the name is already taken
    floorsAdded as integer = 0

    sub new(game as BGE.Game, args = {} as roAssociativeArray)
      super(game, args)
    end sub

    override sub onCreate(args as roAssociativeArray)
      m.createCount++
      m.lastLevel = args.level
      floor = new BGE.DrawableRectangle(m, 10, 10)
      if invalid <> m.addDrawable("floor", floor)
        m.floorsAdded++
      end if
    end sub

    override sub onDestroy()
      m.destroyCount++
    end sub
  end class

  ' Overrides onChangeScene() without calling super, so keeps every drawable.
  class KeepDrawablesSceneForSceneTests extends BGE.GameScene
    sub new(game as BGE.Game, args = {} as roAssociativeArray)
      super(game, args)
    end sub

    override sub onChangeScene(newScene as BGE.GameScene)
    end sub
  end class
end namespace
