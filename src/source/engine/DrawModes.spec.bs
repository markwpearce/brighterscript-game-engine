import "pkg:/source/engine/DrawModes.bs"
import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/GameEntity.bs"
import "pkg:/source/engine/drawables/DrawableRectangle.bs"

namespace tests
  @suite("BGE draw mode helpers")
  class DrawModesTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    @describe("nextDrawMode")

    @it("steps to the next mode and wraps after the last")
    function _()
      m.assertEqual(BGE.SceneObjectDrawMode.directToCamera, BGE.nextDrawMode(BGE.SceneObjectDrawMode.matchCamera))
      m.assertEqual(BGE.SceneObjectDrawMode.matchCamera, BGE.nextDrawMode(BGE.SceneObjectDrawMode.axisAligned))
    end function

    @it("keeps to a range")
    function _()
      first = BGE.SceneObjectDrawMode.directToCamera
      last = BGE.SceneObjectDrawMode.solid
      m.assertEqual(BGE.SceneObjectDrawMode.directToCamera, BGE.nextDrawMode(BGE.SceneObjectDrawMode.solid, first, last))
      m.assertEqual(BGE.SceneObjectDrawMode.directToCamera, BGE.nextDrawMode(BGE.SceneObjectDrawMode.matchCamera, first, last))
      m.assertEqual(BGE.SceneObjectDrawMode.oriented, BGE.nextDrawMode(BGE.SceneObjectDrawMode.directScaled, first, last))
    end function

    @describe("cycleDrawMode")

    @it("moves every drawable to the mode after the first one's")
    function _()
      entity = new BGE.GameEntity(m.game, {name: "Thing"})
      a = new BGE.DrawableRectangle(entity, 10, 10)
      a.drawMode = BGE.SceneObjectDrawMode.oriented
      b = new BGE.DrawableRectangle(entity, 10, 10)
      b.drawMode = BGE.SceneObjectDrawMode.wireFrame
      entity.addDrawable("a", a)
      entity.addDrawable("b", b)

      newMode = BGE.cycleDrawMode(entity)

      m.assertEqual(BGE.SceneObjectDrawMode.orientedDrawBackFace, newMode)
      m.assertEqual(BGE.SceneObjectDrawMode.orientedDrawBackFace, a.drawMode)
      m.assertEqual(BGE.SceneObjectDrawMode.orientedDrawBackFace, b.drawMode)
    end function

    @it("returns the first mode for an entity with no drawables")
    function _()
      entity = new BGE.GameEntity(m.game, {name: "Empty"})
      m.assertEqual(BGE.SceneObjectDrawMode.matchCamera, BGE.cycleDrawMode(entity))
    end function

  end class
end namespace
