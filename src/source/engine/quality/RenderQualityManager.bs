import "../renderer/Renderer.bs"
import "QualityController.bs"
import "RenderQualityLevel.bs"
import "RenderQualityPresets.bs"
import "RenderQualitySettings.bs"

namespace BGE

  ' Owns the game's current render quality level. Reach it through
  ' `game.renderQuality`; most games only need `Game.setQualityLevel()` or
  ' `Game.enableAdaptiveQuality()`.
  class RenderQualityManager

    private renderer as BGE.Renderer
    private level as BGE.RenderQualityLevel = RenderQualityLevel.medium
    ' level (as string) -> roAssociativeArray of overridden fields
    private overrides as roAssociativeArray = {}
    private controller as BGE.QualityController = invalid
    ' the game-wide target and range, from enableAdaptive()
    private gameTargetFps as float = 20
    private gameMinLevel as integer = RenderQualityLevel.basic
    private gameMaxLevel as integer = RenderQualityLevel.ultra
    private sceneOptions as BGE.SceneQualityOptions = {}
    private drawDistanceScale as float = 1.0

    ' @param {BGE.Renderer} renderer - the renderer to apply settings to (the game canvas)
    ' @param {integer} initialLevel - a `BGE.RenderQualityLevel` value
    ' @param {float} [drawDistanceScale=1] - see setDrawDistanceScale()
    sub new(renderer as BGE.Renderer, initialLevel as BGE.RenderQualityLevel, drawDistanceScale = 1.0 as float)
      m.renderer = renderer
      m.level = clampRenderQualityLevel(initialLevel)
      m.setDrawDistanceScale(drawDistanceScale)
      m.applyCurrentLevel()
      m.pushPlaneDrawDistanceRange()
    end sub

    ' @return {integer} the current `BGE.RenderQualityLevel`
    function getLevel() as BGE.RenderQualityLevel
      return m.level
    end function

    ' Switches to a level (clamped). Does not change whether adaptive tuning is on -
    ' use `Game.setQualityLevel()` to pin a level.
    '
    ' @param {integer} level - a `BGE.RenderQualityLevel` value
    ' @return {boolean} true if the level changed
    function setLevel(level as BGE.RenderQualityLevel) as boolean
      level = clampRenderQualityLevel(level)
      if level = m.level
        return false
      end if
      m.level = level
      m.applyCurrentLevel()
      if invalid <> m.controller
        m.controller.notifyLevelChanged()
      end if
      return true
    end function

    ' Scales the camera's `maxDrawDistance` (and so a fog's distance) at every level, on top of
    ' what the level does. Unlike the level, adaptive quality never changes it. `Game` starts it
    ' from the device (see `BGE.seedDrawDistanceScale()`).
    '
    ' @param {float} scale - e.g. 0.5 draws half as far; 0 or less is ignored
    sub setDrawDistanceScale(scale as float)
      if scale <= 0
        return
      end if
      m.drawDistanceScale = scale
      m.renderer.sessionDrawDistanceScale = scale
    end sub

    ' @return {float} the scale set by setDrawDistanceScale()
    function getDrawDistanceScale() as float
      return m.drawDistanceScale
    end function

    ' Replaces individual settings for one level, keeping the engine defaults for
    ' everything else. Repeated calls accumulate.
    '
    ' @param {integer} level - a `BGE.RenderQualityLevel` value
    ' @param {roAssociativeArray} fields - e.g. {planeSliceCount: 80, drawDistanceScale: 1.2}
    sub overridePreset(level as BGE.RenderQualityLevel, fields as BGE.RenderQualitySettingsOverrides)
      key = clampRenderQualityLevel(level).toStr()
      existing = m.overrides[key]
      if invalid = existing
        existing = {}
      end if
      for each field in fields.Keys()
        existing[field] = fields[field]
      end for
      m.overrides[key] = existing
      if clampRenderQualityLevel(level) = m.level
        m.applyCurrentLevel()
      end if
      m.pushPlaneDrawDistanceRange()
    end sub

    ' The settings a level uses: the engine preset plus any overrides.
    '
    ' @param {integer} level - a `BGE.RenderQualityLevel` value
    ' @return {BGE.RenderQualitySettings}
    function getSettings(level as BGE.RenderQualityLevel) as BGE.RenderQualitySettings
      level = clampRenderQualityLevel(level)
      return mergeRenderQualitySettings(getRenderQualityPreset(level), m.overrides[level.toStr()])
    end function

    ' Starts adjusting the level automatically to hold a frame rate. If the current
    ' level is outside the options' `minLevel`/`maxLevel`, it moves to the nearest one.
    '
    ' @param {BGE.AdaptiveQualityOptions} [options={}]
    ' @return {boolean} true if the level changed to fit minLevel/maxLevel
    function enableAdaptive(options = {} as BGE.AdaptiveQualityOptions) as boolean
      controller = new BGE.QualityController(options)
      m.controller = controller
      m.gameTargetFps = controller.targetFps
      m.gameMinLevel = controller.minLevel
      m.gameMaxLevel = controller.maxLevel
      m.applySceneTarget()
      m.controller.notifyLevelChanged()
      return m.setLevel(m.clampToRange(m.level))
    end function

    ' Applies a scene's own settings, replacing the last scene's. `Game` calls this when a
    ' scene has loaded, with its `qualityOptions`.
    '
    ' @param {BGE.SceneQualityOptions} options
    ' @return {boolean} true if the level changed to fit the scene's range
    function setSceneOptions(options as BGE.SceneQualityOptions) as boolean
      if invalid = options
        options = {}
      end if
      m.sceneOptions = options
      m.renderer.fixedDrawDistance = options.fixedDrawDistance = true
      if invalid = m.controller
        return false
      end if
      m.applySceneTarget()
      return m.setLevel(m.clampToRange(m.level))
    end function

    sub disableAdaptive()
      m.controller = invalid
    end sub

    ' @return {boolean} whether the level is being adjusted automatically
    function isAdaptive() as boolean
      return invalid <> m.controller
    end function

    ' `Game` calls this once per frame with the full frame time.
    '
    ' @param {float} dt
    ' @return {boolean} true if the level changed this frame
    function update(dt as float) as boolean
      if invalid = m.controller
        return false
      end if
      m.controller.noteCamera(dt, m.renderer.camera.movedLastFrame())
      if m.renderer.camera.isDrawDistanceTransitioning()
        ' the draw distance is still easing to the current level - judge fps once it lands
        m.controller.notifyLevelChanged()
        return false
      end if
      return m.setLevel(m.controller.update(dt, m.level) as BGE.RenderQualityLevel)
    end function

    ' `Game` calls this each frame after the entities update and before anything draws. When
    ' the camera starts moving from still, it drops straight to the level that last held
    ' while moving, rather than drawing the first moving frames at the still level.
    '
    ' @return {boolean} true if the level changed
    function beforeDraw() as boolean
      if invalid = m.controller
        return false
      end if
      if not m.controller.isCameraStill() or not m.renderer.camera.isMovingThisFrame()
        return false
      end if
      return m.setLevel(m.controller.levelForCameraStart(m.level) as BGE.RenderQualityLevel)
    end function

    ' `Game` calls this each frame instead of `update()` while a scene is loading, so
    ' slow loading frames aren't judged against the level.
    sub notifyLoading()
      if invalid <> m.controller
        m.controller.notifyLevelChanged()
      end if
    end sub

    ' `Game` calls this after a scene change.
    sub notifySceneChanged()
      if invalid <> m.controller
        m.controller.notifySceneChanged()
      end if
    end sub

    ' The ground reaches the farthest any level draws objects, so changing level never
    ' moves the horizon and objects always fade out on the ground.
    private sub pushPlaneDrawDistanceRange()
      maxScale = 0.0
      maxOverride = 0.0
      for level = RenderQualityLevel.basic to RenderQualityLevel.ultra
        settings = m.getSettings(level as BGE.RenderQualityLevel)
        if settings.drawDistanceScale > maxScale
          maxScale = settings.drawDistanceScale
        end if
        if settings.drawDistanceOverride > maxOverride
          maxOverride = settings.drawDistanceOverride
        end if
      end for
      m.renderer.setPlaneDrawDistanceRange(maxScale, maxOverride)
    end sub

    ' The game's target and range, with the current scene's in place of any it sets
    private sub applySceneTarget()
      options = m.sceneOptions
      targetFps = m.gameTargetFps
      if options.DoesExist("targetFps")
        targetFps = options.targetFps
      end if
      minLevel = m.gameMinLevel
      if options.DoesExist("minLevel")
        minLevel = options.minLevel
      end if
      maxLevel = m.gameMaxLevel
      if options.DoesExist("maxLevel")
        maxLevel = options.maxLevel
      end if
      m.controller.setTarget(targetFps, minLevel, maxLevel)
    end sub

    private function clampToRange(level as integer) as BGE.RenderQualityLevel
      if level > m.controller.maxLevel
        level = m.controller.maxLevel
      end if
      if level < m.controller.minLevel
        level = m.controller.minLevel
      end if
      return level as BGE.RenderQualityLevel
    end function

    private sub applyCurrentLevel()
      m.renderer.setQualitySettings(m.getSettings(m.level))
    end sub

  end class

end namespace
