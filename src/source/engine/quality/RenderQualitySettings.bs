namespace BGE

  ' Every draw-quality value a `BGE.Renderer` uses. Each `BGE.RenderQualityLevel` has
  ' a preset (see `BGE.getRenderQualityPreset()`); override individual fields per
  ' level with `game.renderQuality.overridePreset()`.
  '
  ' Adding a new quality setting: add the field here, give it a value at every level
  ' in RenderQualityPresets.bs, and read it via `renderer.qualitySettings`.
  interface RenderQualitySettings extends roAssociativeArray
    ' Multiplier on `Camera3d.maxDrawDistance`
    drawDistanceScale as float
    ' Absolute draw distance for this level; 0 or less means "use drawDistanceScale"
    drawDistanceOverride as float
    ' Horizontal slices used to draw a `DrawablePlane` in perspective
    planeSliceCount as integer
    ' Triangles smaller than this many pixels on both axes are skipped
    triangleSkipSize as float
    ' Band thickness, in pixels, of the coarse fill a moving triangle may use (1 = never
    ' coarse). A coarse fill is redrawn exactly once the object stops moving.
    triangleQuickDrawStep as integer
    ' How far from a true parallelogram a billboard's quad may be and still use the
    ' cheap single-call fast draw
    fastDrawParallelogramTolerance as float
    ' How far from perpendicular a billboard's quad edges may be and still use the
    ' cheap single-call fast draw
    fastDrawPerpendicularityTolerance as float
    ' How far a billboard's (rectangle, image, polygon, ...) reused rendering may be off
    ' while it moves, as a fraction of its size on screen. 0 = a fixed 16 pixels.
    billboardReuseError as float
    ' How far, in degrees, the direction a billboard is seen from may turn before its
    ' reused rendering is redrawn
    billboardReuseMaxAngleDegrees as float
    ' How far a reused model rendering (`DrawableModel.useImpostor`) may be off, as a
    ' fraction of the model's size on screen
    modelImpostorError as float
    ' How much a reused model rendering may be enlarged while the camera closes in
    modelImpostorMaxZoom as float
    ' How far, in degrees, the direction a model is seen from may turn before its reused
    ' rendering is redrawn
    modelImpostorMaxAngleDegrees as float
    ' How much any light reaching a model may brighten or dim (a 0-1 fraction of full
    ' brightness, per color channel) before its reused rendering is relit. Its direction
    ' may turn by up to `modelImpostorMaxAngleDegrees`.
    modelImpostorMaxLightChange as float
    ' How far, in pixels of a plane's top-down bitmap, a point light's pool on a shaded
    ' tiledImage plane may drift or grow before the plane redraws it (0 = on any change)
    planeLightPoolMaxDriftPixels as float
    ' How much a pool's color may change (a 0-1 fraction of full brightness, per channel)
    ' before the plane redraws it (0 = on any change)
    planeLightPoolMaxLightChange as float
    ' Screen pixels between wall strips (BGE.DrawableWalls) at the horizon
    wallStripWidth as integer
    ' Walls (BGE.DrawableWalls) further than this fraction of the draw distance draw one strip
    ' per two rays (1 = never)
    wallLodDistanceFraction as float
    ' Most texture columns a quad drawn as columns (`BGE.QuadColumnDrawer`) gets, per texel
    ' across it (1 = every texel)
    quadColumnsPerTexel as float
    ' Fewest screen pixels each such column covers: a quad gets no more columns than
    ' its width on screen over this
    quadMinPixelsPerColumn as float
    ' How far, in pixels, a column's texture may sit from where perspective puts it: a quad
    ' gets only as many columns as that takes, so one at near constant depth needs few. 0
    ' leaves the count to the other two settings
    quadMaxAffineErrorPixels as float
  end interface

  ' Any subset of `BGE.RenderQualitySettings`, for `game.renderQuality.overridePreset()`.
  interface RenderQualitySettingsOverrides extends roAssociativeArray
    optional drawDistanceScale as float
    optional drawDistanceOverride as float
    optional planeSliceCount as integer
    optional triangleSkipSize as float
    optional triangleQuickDrawStep as integer
    optional fastDrawParallelogramTolerance as float
    optional fastDrawPerpendicularityTolerance as float
    optional billboardReuseError as float
    optional billboardReuseMaxAngleDegrees as float
    optional modelImpostorError as float
    optional modelImpostorMaxZoom as float
    optional modelImpostorMaxAngleDegrees as float
    optional modelImpostorMaxLightChange as float
    optional planeLightPoolMaxDriftPixels as float
    optional planeLightPoolMaxLightChange as float
    optional wallStripWidth as integer
    optional wallLodDistanceFraction as float
    optional quadColumnsPerTexel as float
    optional quadMinPixelsPerColumn as float
    optional quadMaxAffineErrorPixels as float
  end interface

end namespace
