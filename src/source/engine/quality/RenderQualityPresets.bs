import "RenderQualityLevel.bs"
import "RenderQualitySettings.bs"

namespace BGE

  ' The engine's built-in settings for a quality level, as a new copy each call.
  '
  ' @param {integer} level - a `BGE.RenderQualityLevel` value (clamped)
  ' @return {BGE.RenderQualitySettings}
  function getRenderQualityPreset(level as RenderQualityLevel) as RenderQualitySettings
    level = clampRenderQualityLevel(level)
    ' One column per level: basic, low, medium, high, ultra. Today's pre-feature
    ' value is at medium for two-way knobs, at ultra for knobs already at best quality.
    drawDistanceScale = [0.75, 0.825, 1.0, 1.25, 1.5]
    planeSliceCount = [20, 28, 36, 44, 50]
    triangleSkipSize = [8.0, 6.0, 4.0, 3.0, 2.0]
    triangleQuickDrawStep = [4, 3, 2, 2, 1]
    fastDrawParallelogramTolerance = [0.10, 0.08, 0.06, 0.045, 0.03]
    fastDrawPerpendicularityTolerance = [0.15, 0.13, 0.10, 0.075, 0.05]
    modelImpostorError = [0.10, 0.075, 0.05, 0.04, 0.03]
    modelImpostorMaxZoom = [8.0, 6.0, 4.0, 2.0, 1.5]
    modelImpostorMaxAngleDegrees = [12.0, 10.0, 8.0, 3.0, 2.0]
    ' 0 = no corner pin: high and ultra redraw instead, so their other pin knobs are unused
    ' and just repeat medium's
    modelImpostorPinMaxAngleDegrees = [16.0, 13.0, 10.0, 0.0, 0.0]
    modelImpostorPinError = [0.16, 0.12, 0.09, 0.09, 0.09]
    modelImpostorPinOutlinePoints = [12, 16, 20, 20, 20]
    modelImpostorPinFourTriangles = [false, true, true, true, true]
    return {
      drawDistanceScale: drawDistanceScale[level],
      drawDistanceOverride: 0.0,
      planeSliceCount: planeSliceCount[level],
      triangleSkipSize: triangleSkipSize[level],
      triangleQuickDrawStep: triangleQuickDrawStep[level],
      fastDrawParallelogramTolerance: fastDrawParallelogramTolerance[level],
      fastDrawPerpendicularityTolerance: fastDrawPerpendicularityTolerance[level],
      modelImpostorError: modelImpostorError[level],
      modelImpostorMaxZoom: modelImpostorMaxZoom[level],
      modelImpostorMaxAngleDegrees: modelImpostorMaxAngleDegrees[level],
      modelImpostorPinError: modelImpostorPinError[level],
      modelImpostorPinMaxAngleDegrees: modelImpostorPinMaxAngleDegrees[level],
      modelImpostorPinOutlinePoints: modelImpostorPinOutlinePoints[level],
      modelImpostorPinFourTriangles: modelImpostorPinFourTriangles[level]
    } as RenderQualitySettings
  end function

  ' Copies `base`, replacing each field named in `overrides`. Keys that aren't
  ' quality settings are ignored.
  '
  ' @param {BGE.RenderQualitySettings} base
  ' @param {BGE.RenderQualitySettingsOverrides} overrides - e.g. {planeSliceCount: 80}
  ' @return {BGE.RenderQualitySettings}
  function mergeRenderQualitySettings(base as RenderQualitySettings, overrides as RenderQualitySettingsOverrides) as RenderQualitySettings
    merged = {}
    for each key in base.Keys()
      merged[key] = base[key]
    end for
    if invalid <> overrides
      for each key in overrides.Keys()
        if merged.DoesExist(key)
          merged[key] = overrides[key]
        end if
      end for
    end if
    return merged as RenderQualitySettings
  end function

end namespace
