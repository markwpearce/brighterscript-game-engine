namespace tests

  @suite("BGE.RenderQualityManager")
  class RenderQualityManagerTests extends rooibos.BaseTestSuite

    renderer as BGE.Renderer
    manager as BGE.RenderQualityManager

    protected override function beforeEach()
      m.renderer = new BGE.Renderer(CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: true}))
      m.manager = new BGE.RenderQualityManager(m.renderer, BGE.RenderQualityLevel.high)
    end function

    @describe("levels and overrides")

    @it("applies the initial level's preset to the renderer")
    function _()
      m.assertEqual(BGE.RenderQualityLevel.high, m.manager.getLevel())
      m.assertEqual(44, m.renderer.qualitySettings.planeSliceCount)
    end function

    @it("setLevel applies the new preset and reports a change")
    function _()
      m.assertTrue(m.manager.setLevel(BGE.RenderQualityLevel.basic))
      m.assertEqual(20, m.renderer.qualitySettings.planeSliceCount)
      m.assertFalse(m.manager.setLevel(BGE.RenderQualityLevel.basic))
    end function

    @it("setLevel clamps out-of-range levels")
    function _()
      m.manager.setLevel(42 as BGE.RenderQualityLevel)
      m.assertEqual(BGE.RenderQualityLevel.ultra, m.manager.getLevel())
    end function

    @it("overridePreset changes only that level's named fields")
    function _()
      m.manager.overridePreset(BGE.RenderQualityLevel.low, {planeSliceCount: 99})
      m.assertEqual(99, m.manager.getSettings(BGE.RenderQualityLevel.low).planeSliceCount)
      m.assertEqual(0.825, m.manager.getSettings(BGE.RenderQualityLevel.low).drawDistanceScale)
      m.assertEqual(36, m.manager.getSettings(BGE.RenderQualityLevel.medium).planeSliceCount)
    end function

    @it("overridePreset on the active level takes effect immediately")
    function _()
      m.manager.overridePreset(BGE.RenderQualityLevel.high, {planeSliceCount: 60})
      m.assertEqual(60, m.renderer.qualitySettings.planeSliceCount)
    end function

    @it("overrides accumulate across calls")
    function _()
      m.manager.overridePreset(BGE.RenderQualityLevel.low, {planeSliceCount: 99})
      m.manager.overridePreset(BGE.RenderQualityLevel.low, {drawDistanceScale: 0.5})
      settings = m.manager.getSettings(BGE.RenderQualityLevel.low)
      m.assertEqual(99, settings.planeSliceCount)
      m.assertEqual(0.5, settings.drawDistanceScale)
    end function

    @describe("adaptive")

    @it("update does nothing unless adaptive is enabled")
    function _()
      for i = 1 to 90
        m.assertFalse(m.manager.update(0.1))
      end for
      m.assertEqual(BGE.RenderQualityLevel.high, m.manager.getLevel())
    end function

    @it("update moves the level when adaptive is enabled")
    function _()
      m.manager.enableAdaptive()
      m.assertTrue(m.manager.isAdaptive())
      changed = false
      ' 0.5s settle + 1.0s half window at 20fps, with margin for float accumulation
      ' 10fps is well below the default 20fps target; 0.25s settle + 0.5s half window
      ' gives one step, stopping before a second settle + half window allows another
      for i = 1 to 12
        if m.manager.update(0.1)
          changed = true
        end if
      end for
      m.assertTrue(changed)
      m.assertEqual(BGE.RenderQualityLevel.medium, m.manager.getLevel())
      m.assertEqual(36, m.renderer.qualitySettings.planeSliceCount)
    end function

    @it("notifyLoading keeps slow frames from lowering the level")
    function _()
      m.manager.enableAdaptive()
      for i = 1 to 40
        m.manager.notifyLoading()
      end for
      m.assertEqual(BGE.RenderQualityLevel.high, m.manager.getLevel())
      ' the window was reset, so the first slow frames after loading don't step down yet
      for i = 1 to 3
        m.manager.update(0.1)
      end for
      m.assertEqual(BGE.RenderQualityLevel.high, m.manager.getLevel())
    end function

    @it("notifyLoading is harmless when adaptive is off")
    function _()
      m.manager.notifyLoading()
      m.assertEqual(BGE.RenderQualityLevel.high, m.manager.getLevel())
    end function

    @it("disableAdaptive stops the controller")
    function _()
      m.manager.enableAdaptive()
      m.manager.disableAdaptive()
      m.assertFalse(m.manager.isAdaptive())
      for i = 1 to 60
        m.manager.update(0.05)
      end for
      m.assertEqual(BGE.RenderQualityLevel.high, m.manager.getLevel())
    end function

    ' Feeds adaptive tuning `seconds` of frames at `fps`, running the camera each frame
    ' like the game loop does.
    private sub runFrames(manager as BGE.RenderQualityManager, fps as float, seconds as float)
      for i = 1 to cint(seconds * fps)
        m.renderer.setupCameraForFrame()
        manager.update(1.0 / fps)
      end for
    end sub

    @it("holds adaptive tuning off while the camera's draw distance is still easing")
    function _()
      cam = new BGE.Camera3d()
      cam.drawDistanceTransitionSeconds = 60 ' far longer than the test runs
      m.renderer.camera = cam
      manager = new BGE.RenderQualityManager(m.renderer, BGE.RenderQualityLevel.medium)
      ' a short window, so the controller judges fps 0.2s after its settle ends
      manager.enableAdaptive({targetFps: 30, windowSeconds: 0.4, settleSeconds: 0.25, stepDownCooldownSeconds: 0.1})
      m.runFrames(manager, 30, 2)
      manager.setLevel(BGE.RenderQualityLevel.low)
      m.runFrames(manager, 10, 1)
      m.assertEqual(BGE.RenderQualityLevel.low, manager.getLevel())
    end function

    @it("doesn't hold adaptive tuning off when the draw distance doesn't change")
    function _()
      cam = new BGE.Camera3d()
      cam.drawDistanceTransitionSeconds = 60
      m.renderer.camera = cam
      manager = new BGE.RenderQualityManager(m.renderer, BGE.RenderQualityLevel.medium)
      ' every level pinned to the same distance, so a level change doesn't move it
      for level = BGE.RenderQualityLevel.basic to BGE.RenderQualityLevel.ultra
        manager.overridePreset(level as BGE.RenderQualityLevel, {drawDistanceOverride: 400})
      end for
      manager.enableAdaptive({targetFps: 30, windowSeconds: 0.4, settleSeconds: 0.25, stepDownCooldownSeconds: 0.1})
      m.runFrames(manager, 30, 2)
      manager.setLevel(BGE.RenderQualityLevel.low)
      m.runFrames(manager, 10, 1)
      m.assertTrue(manager.getLevel() < BGE.RenderQualityLevel.low)
    end function

    @it("gives the ground the same reach at every level: the highest level's")
    function _()
      cam = new BGE.Camera3d()
      cam.maxDrawDistance = 500
      m.renderer.camera = cam
      manager = new BGE.RenderQualityManager(m.renderer, BGE.RenderQualityLevel.basic)
      m.renderer.setupCameraForFrame()
      basicReach = cam.getPlaneDrawDistance()
      manager.setLevel(BGE.RenderQualityLevel.ultra)
      m.renderer.setupCameraForFrame()
      m.assertEqual(basicReach, cam.getPlaneDrawDistance())
      m.assertTrue(basicReach >= cam.getEffectiveMaxDrawDistance())
    end function

    @it("grows the ground's reach when a level's scale is overridden higher")
    function _()
      cam = new BGE.Camera3d()
      cam.maxDrawDistance = 400
      m.renderer.camera = cam
      manager = new BGE.RenderQualityManager(m.renderer, BGE.RenderQualityLevel.medium)
      manager.overridePreset(BGE.RenderQualityLevel.high, {drawDistanceScale: 2.0})
      m.renderer.setupCameraForFrame()
      m.assertTrue(abs(cam.getPlaneDrawDistance() - 800) < 0.01, `reach ${cam.getPlaneDrawDistance()}`)
    end function

    @describe("scene options (#519)")

    @it("holds a scene's own target, and the game's again after")
    function _()
      m.manager.enableAdaptive()
      m.assertFalse(m.manager.setSceneOptions({targetFps: 10}))
      ' 15fps would step down against the game's 20
      for i = 1 to 45
        m.manager.update(1.0 / 15)
      end for
      m.assertEqual(BGE.RenderQualityLevel.ultra, m.manager.getLevel())
      m.manager.setSceneOptions({})
      m.manager.notifySceneChanged()
      for i = 1 to 45
        m.manager.update(1.0 / 15)
      end for
      m.assertTrue(m.manager.getLevel() < BGE.RenderQualityLevel.ultra)
    end function

    @it("moves into a scene's range straight away")
    function _()
      m.manager.enableAdaptive()
      m.assertTrue(m.manager.setSceneOptions({maxLevel: BGE.RenderQualityLevel.low}))
      m.assertEqual(BGE.RenderQualityLevel.low, m.manager.getLevel())
    end function

    @it("keeps a scene's options for adaptive tuning turned on later")
    function _()
      m.manager.setSceneOptions({minLevel: BGE.RenderQualityLevel.ultra})
      m.manager.enableAdaptive()
      m.assertEqual(BGE.RenderQualityLevel.ultra, m.manager.getLevel())
    end function

    @it("draws to maxDrawDistance at every level with fixedDrawDistance, whether adaptive or not")
    function _()
      cam = new BGE.Camera3d()
      cam.maxDrawDistance = 400
      cam.drawDistanceTransitionSeconds = 0
      m.renderer.camera = cam
      m.manager.setSceneOptions({fixedDrawDistance: true})
      for each level in [BGE.RenderQualityLevel.basic, BGE.RenderQualityLevel.ultra]
        m.manager.setLevel(level)
        m.renderer.setupCameraForFrame()
        m.assertEqual(400, cint(cam.getEffectiveMaxDrawDistance()))
        m.assertEqual(400, cint(cam.getPlaneDrawDistance()))
      end for
      m.manager.setSceneOptions({})
      m.renderer.setupCameraForFrame()
      m.assertEqual(600, cint(cam.getEffectiveMaxDrawDistance()))
    end function

    @it("draws to maxDrawDistance at every level with fog on")
    function _()
      cam = new BGE.Camera3d()
      cam.maxDrawDistance = 400
      cam.drawDistanceTransitionSeconds = 0
      cam.fog.enabled = true
      m.renderer.camera = cam
      for each level in [BGE.RenderQualityLevel.basic, BGE.RenderQualityLevel.ultra]
        m.manager.setLevel(level)
        m.renderer.setupCameraForFrame()
        m.assertEqual(400, cint(cam.getEffectiveMaxDrawDistance()))
        m.assertEqual(400, cint(cam.getPlaneDrawDistance()))
      end for
    end function

    @it("follows the level with fog on when the fog follows quality")
    function _()
      cam = new BGE.Camera3d()
      cam.maxDrawDistance = 400
      cam.drawDistanceTransitionSeconds = 0
      cam.fog.enabled = true
      cam.fog.followsQuality = true
      m.renderer.camera = cam
      m.manager.setLevel(BGE.RenderQualityLevel.ultra)
      m.renderer.setupCameraForFrame()
      m.assertEqual(600, cint(cam.getEffectiveMaxDrawDistance()))
      m.manager.setLevel(BGE.RenderQualityLevel.basic)
      m.renderer.setupCameraForFrame()
      m.assertEqual(300, cint(cam.getEffectiveMaxDrawDistance()))
    end function

    @it("treats invalid scene options as none")
    function _()
      m.manager.enableAdaptive()
      m.manager.setSceneOptions(invalid)
      m.assertFalse(m.renderer.fixedDrawDistance)
    end function

    @it("climbs to ultra within about a second of the camera stopping")
    function _()
      cam = new BGE.Camera3d()
      cam.drawDistanceTransitionSeconds = 0
      m.renderer.camera = cam
      m.manager.setLevel(BGE.RenderQualityLevel.low)
      m.manager.enableAdaptive()
      m.runFrames(m.manager, 60, 1.0)
      m.assertEqual(BGE.RenderQualityLevel.ultra, m.manager.getLevel())
    end function

    @it("keeps the level when the camera moves")
    function _()
      cam = new BGE.Camera3d()
      cam.drawDistanceTransitionSeconds = 0
      m.renderer.camera = cam
      m.manager.setLevel(BGE.RenderQualityLevel.low)
      m.manager.enableAdaptive()
      m.runFrames(m.manager, 60, 1.0)
      cam.position = BGE.Math.VectorOps.create(10, 0, 0)
      m.renderer.setupCameraForFrame()
      m.assertFalse(m.manager.update(1.0 / 60))
      m.assertEqual(BGE.RenderQualityLevel.ultra, m.manager.getLevel())
    end function

    @it("drops to the moving level before the draw when the camera starts moving from still")
    function _()
      cam = new BGE.Camera3d()
      cam.drawDistanceTransitionSeconds = 0
      m.renderer.camera = cam
      m.manager.setLevel(BGE.RenderQualityLevel.low)
      m.manager.enableAdaptive()
      ' moving at the target holds low
      for i = 1 to 40
        cam.position = BGE.Math.VectorOps.create(i, 0, 0)
        m.renderer.setupCameraForFrame()
        m.manager.update(1.0 / 20)
      end for
      m.assertEqual(BGE.RenderQualityLevel.low, m.manager.getLevel())
      m.runFrames(m.manager, 60, 1.0)
      m.assertEqual(BGE.RenderQualityLevel.ultra, m.manager.getLevel())
      ' still: nothing to do before the draw
      m.assertFalse(m.manager.beforeDraw())
      ' moved by this frame's update, not yet rendered
      cam.position = BGE.Math.VectorOps.create(100, 0, 0)
      m.assertTrue(m.manager.beforeDraw())
      ' low held while moving; a move drops at most cameraMoveMaxStepDown (2) levels
      m.assertEqual(BGE.RenderQualityLevel.medium, m.manager.getLevel())
    end function

    @it("does nothing before the draw unless adaptive is enabled")
    function _()
      cam = new BGE.Camera3d()
      m.renderer.camera = cam
      m.renderer.setupCameraForFrame()
      cam.position = BGE.Math.VectorOps.create(100, 0, 0)
      m.assertFalse(m.manager.beforeDraw())
    end function

  end class

end namespace
