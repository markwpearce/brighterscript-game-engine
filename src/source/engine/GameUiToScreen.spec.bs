import "pkg:/source/engine/Game.bs"

namespace tests

  @suite("BGE.Game UI drawn to the screen (#685)")
  class GameUiToScreenTests extends rooibos.BaseTestSuite

    @describe("setUiDrawsToScreen")

    @it("keeps its own UI bitmap by default")
    function _()
      game = m.newScreenSizedGame()
      m.assertFalse(game.isUiDrawnToScreen())
      m.assertEqual("roBitmap", type(game.uiCanvas.bitmap))
    end function

    @it("points the UI canvas at the screen when the game canvas is the screen, and back at a bitmap of its own")
    function _()
      game = m.newScreenSizedGame()
      m.assertEqual("roScreen", type(game.canvas.bitmap))
      m.assertTrue(game.setUiDrawsToScreen(true))
      m.assertTrue(game.isUiDrawnToScreen())
      m.assertEqual("roScreen", type(game.uiCanvas.bitmap))
      m.assertEqual("roScreen", type(game.uiCanvas.renderer.getDraw2d()))
      m.assertFalse(game.setUiDrawsToScreen(false))
      m.assertEqual("roBitmap", type(game.uiCanvas.bitmap))
      m.assertEqual("roBitmap", type(game.uiCanvas.renderer.getDraw2d()))
      m.assertEqual(game.getScreen().GetWidth(), game.uiCanvas.getWidth())
    end function

    @it("keeps the UI bitmap when the game canvas is blitted to the screen")
    function _()
      game = new BGE.Game(320, 240)
      m.assertEqual("roBitmap", type(game.canvas.bitmap))
      m.assertFalse(game.setUiDrawsToScreen(true))
      m.assertFalse(game.isUiDrawnToScreen())
      m.assertEqual("roBitmap", type(game.uiCanvas.bitmap))
    end function

    @it("keeps the UI bitmap when the UI canvas isn't the screen's size")
    function _()
      resolution = CreateObject("roDeviceInfo").GetUIResolution()
      game = new BGE.Game(resolution.width, resolution.height, 320, 240)
      m.assertFalse(game.setUiDrawsToScreen(true))
      m.assertEqual("roBitmap", type(game.uiCanvas.bitmap))
    end function

    ' A game whose canvas is the screen itself
    private function newScreenSizedGame() as BGE.Game
      resolution = CreateObject("roDeviceInfo").GetUIResolution()
      return new BGE.Game(resolution.width, resolution.height)
    end function

  end class

end namespace
