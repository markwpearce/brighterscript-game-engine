import "pkg:/source/engine/Game.bs"

namespace tests

  @suite("BGE.Game multi-material .obj models")
  class GameModelMaterialsTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      fs = CreateObject("roFileSystem")
      fs.CreateDirectory("tmp:/bge_mats")
      fs.CreateDirectory("tmp:/bge_mats/tex")
      objLines = ["mtllib house.mtl", "v 0 0 0", "v 1 0 0", "v 0 1 0", "vt 0 0", "vt 1 0", "vt 0 1",
        "usemtl wall", "f 1/1 2/2 3/3",
        "usemtl roof", "f 1/1 2/2 3/3",
        "usemtl door", "f 1/1 2/2 3/3",
        "usemtl paint", "f 1 2 3",
        "usemtl wall", "f 1/1 2/2 3/3"]
      WriteAsciiFile("tmp:/bge_mats/house.obj", objLines.join(chr(10)))
      mtlLines = ["newmtl wall", "map_Kd tex/wall.png",
        "newmtl roof", "map_Kd tex/roof.png",
        "newmtl door", "Kd 0 0 1", "map_Kd tex/missing.png",
        "newmtl paint", "Kd 1 0 0"]
      WriteAsciiFile("tmp:/bge_mats/house.mtl", mtlLines.join(chr(10)))
      wall = CreateObject("roBitmap", {width: 8, height: 4, AlphaEnable: true})
      wall.GetPng(0, 0, 8, 4).WriteFile("tmp:/bge_mats/tex/wall.png")
      roof = CreateObject("roBitmap", {width: 16, height: 16, AlphaEnable: true})
      roof.GetPng(0, 0, 16, 16).WriteFile("tmp:/bge_mats/tex/roof.png")
    end function

    @describe("Game.load3dModel")

    @it("draws each face with its own material's texture")
    function _()
      m.assertTrue(m.game.load3dModel("house", "tmp:/bge_mats/house.obj"))
      faces = m.game.get3dModel("house").faces
      m.assertEqual("tmp:/bge_mats/tex/wall.png", faces[0].Texture.srcRegionWithId.id)
      m.assertEqual("tmp:/bge_mats/tex/roof.png", faces[1].Texture.srcRegionWithId.id)
      m.assertEqual("tmp:/bge_mats/tex/wall.png", faces[4].Texture.srcRegionWithId.id)
      ' UVs are in the pixel space of each face's own texture: v = 1 is y = 0
      m.assertEqual(4.0, faces[0].Texture.points[0].y)
      m.assertEqual(16.0, faces[1].Texture.points[0].y)
    end function

    @it("shares one region between faces with the same texture")
    function _()
      m.game.load3dModel("house", "tmp:/bge_mats/house.obj")
      faces = m.game.get3dModel("house").faces
      faces[0].Texture.srcRegionWithId.id = "marked"
      m.assertEqual("marked", faces[4].Texture.srcRegionWithId.id)
    end function

    @it("fills faces whose texture is missing, or that have none, with their material's color")
    function _()
      m.game.load3dModel("house", "tmp:/bge_mats/house.obj")
      faces = m.game.get3dModel("house").faces
      m.assertInvalid(faces[2].Texture)
      m.assertEqual(&h0000FFFF, faces[2].color)
      m.assertInvalid(faces[3].Texture)
      m.assertEqual(&hFF0000FF, faces[3].color)
    end function

    @it("uses options.texturePath for every textured face instead")
    function _()
      m.game.load3dModel("house", "tmp:/bge_mats/house.obj", {texturePath: "tmp:/bge_mats/tex/roof.png"})
      faces = m.game.get3dModel("house").faces
      m.assertEqual("tmp:/bge_mats/tex/roof.png", faces[0].Texture.srcRegionWithId.id)
      m.assertEqual("tmp:/bge_mats/tex/roof.png", faces[2].Texture.srcRegionWithId.id)
      m.assertInvalid(faces[3].Texture)
    end function

    @describe("Game.unload3dModel")

    @it("removes the model")
    function _()
      m.game.load3dModel("house", "tmp:/bge_mats/house.obj")
      m.game.unload3dModel("house")
      m.assertInvalid(m.game.Models["house"])
    end function

  end class

end namespace
