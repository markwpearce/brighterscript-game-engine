import "Game.bs"
import "GameEntity.bs"
import "colliders/SolidWorld.bs"
import "loading/AssetLoader.bs"
import "loading/LoadingScreen.bs"
import "loading/SceneAsset.bs"
import "drawables/Model3d.bs"
import "ui/UiWidget.bs"

namespace BGE

  ' A GameScene is a GameEntity that represents one distinct state of your game - a title
  ' screen, a menu, a level. Register scenes with `Game.defineScene()` and switch between
  ' them with `Game.changeScene()`. Only one GameScene is current at a time, and it gets the
  ' same per-frame hooks (`onUpdate`, `onInput`, ...) as any other entity.
  '
  ' Every scene change destroys all non-`persistent` entities and, by this class's default
  ' `onChangeScene()`, removes the outgoing scene's own drawables (anything added with
  ' `addDrawable()`/`addImage()`/etc. directly on the scene). Changing to the current scene
  ' again (`Game.resetScene()`, or `changeScene()` with the current scene's name, e.g. the
  ' next level of a level scene) works exactly like leaving it and entering it again.
  '
  ' To keep some or all of a scene's own drawables across a change:
  '  - set `persistDrawablesAcrossSceneChange = true` to keep all of them, or
  '  - override `onChangeScene()` with your own cleanup. An override replaces the default
  '    cleanup unless it calls `super.onChangeScene(newScene)`.
  '
  ' A scene is defined once and reused: leaving it (or resetting it) calls `onChangeScene()`
  ' then `onDestroy()` on it, and entering it again runs `onLoad()`/`onCreate()` again. Free
  ' whatever a visit set up in either hook, or let the scene do it: widgets added with
  ' `addUi()`, lights added with `addLight()` and assets loaded with `loadSceneBitmap()` (and
  ' friends) go when the game leaves the scene. Widgets added straight to `game.gameUi`, lights
  ' added with `game.addLight()` and assets loaded straight on the loader stay until you remove
  ' them (use those for things that should outlive the scene).
  class GameScene extends GameEntity

    ' Whether this scene's own directly-added drawables survive a scene change (including one
    ' to this same scene), instead of being removed by the default `onChangeScene()`.
    persistDrawablesAcrossSceneChange as boolean = false

    ' This scene's own render quality settings, applied once it has loaded (after `onCreate()`)
    ' and replaced by the next scene's: a frame rate to hold, a level range, or a draw distance
    ' that doesn't change with the level. Set it in `new()` or `onCreate()`.
    '
    ' @example
    ' m.qualityOptions = {targetFps: 30, fixedDrawDistance: true}
    qualityOptions as BGE.SceneQualityOptions = {}

    ' A SolidWorld whose tracked bodies the game resolves every frame, right after
    ' `onPostUpdate()` (see `BGE.SolidWorld.track()`). Invalid (the default) resolves nothing: call
    ' `resolveTracked()` yourself instead when it has to happen at another point, e.g. before the
    ' camera follows. Override `resolveTrackedSolids()` to change what runs.
    trackedSolidWorld as BGE.SolidWorld = invalid

    ' Widgets added with addUi(), removed when this visit ends.
    protected sceneUi as BGE.UI.UiWidget[] = []
    ' BGE.SceneAsset by key: what this visit owns (loadSceneBitmap() and friends)
    protected sceneAssets as roAssociativeArray = {}
    ' BGE.SceneAsset by key: the last visit's, between leaving and the next scene's onLoad(),
    ' which can take them over
    protected releasingSceneAssets as roAssociativeArray = {}

    function new(gameEngine as Game, args = {} as roAssociativeArray)
      super(gameEngine, args)
    end function

    ' Adds a widget to `game.gameUi` for this visit only: it's removed (and its buttons
    ' unregistered from focus) when the game leaves or resets this scene, after
    ' `onDestroy()`. Add a widget to `game.gameUi` directly to keep it across scenes.
    '
    ' @param {BGE.UI.UiWidget} widget
    sub addUi(widget as BGE.UI.UiWidget)
      if widget = invalid
        return
      end if
      for each existing in m.sceneUi
        if existing.id = widget.id
          return
        end if
      end for
      m.sceneUi.push(widget)
      m.game.gameUi.addChild(widget)
    end sub

    ' Removes a widget added with addUi() from `game.gameUi`.
    '
    ' @param {BGE.UI.UiWidget} widget
    sub removeUi(widget as BGE.UI.UiWidget)
      if widget = invalid
        return
      end if
      for i = m.sceneUi.count() - 1 to 0 step -1
        if m.sceneUi[i].id = widget.id
          m.sceneUi.delete(i)
        end if
      end for
      m.game.gameUi.removeChild(widget)
    end sub

    ' Removes every widget added with addUi(). The game calls this when the scene changes.
    sub clearUi()
      widgets = m.sceneUi
      m.sceneUi = []
      for each widget in widgets
        m.game.gameUi.removeChild(widget)
      end for
    end sub

    ' How many widgets added with addUi() are still up.
    '
    ' @return {integer}
    function uiCount() as integer
      return m.sceneUi.count()
    end function

    ' Called when this scene is changed to, before `onCreate()`. Queue anything that takes time
    ' on `loader` - asset loads (`loader.loadBitmap()`, `loader.load3dModel()`, ...), your own
    ' `BGE.LoadTask`s, or a function called once per step (`loader.addStep()`). The engine runs
    ' them a little each frame, showing a loading screen, then calls `onCreate(args)`.
    ' Queue nothing (the default) and `onCreate()` runs straight away.
    '
    ' The previous scene's entities are already gone. This scene doesn't get `onUpdate()`,
    ' `onInput()` etc. until `onCreate()` has run - nor do entities added during `onLoad()`.
    '
    ' @param {BGE.AssetLoader} loader - queue this scene's loading work here
    ' @param {object} args - the args passed to `changeScene()`
    sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    end sub

    ' Queues a bitmap this scene owns: it's unloaded when the game leaves the scene, unless the
    ' next scene (this one again, on a reset or the next level) asks for it too, in which case
    ' it's kept for that scene without loading it again. A bitmap that's already loaded by
    ' anything else isn't queued, and stays theirs. Pass `shared = true` for one other scenes
    ' use too: it's loaded unless it's already loaded, and never unloaded by a scene.
    '
    ' @example
    ' override sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    '   m.loadSceneBitmap(loader, "townGround", "pkg:/sprites/town_ground.webp")
    '   m.loadSceneBitmap(loader, "nightSky", "pkg:/sprites/night_sky.webp", {}, true)
    ' end sub
    '
    ' @param {BGE.AssetLoader} loader - the loader `onLoad()` was given
    ' @param {string} bitmapName - the name to get it by later (`game.getBitmap()`)
    ' @param {string} pathOrUrl - local file path or URL
    ' @param {BGE.BitmapLoadOptions} [options={}] - as `AssetLoader.loadBitmap()`
    ' @param {boolean} [shared=false] - keep it after the scene ends
    ' @return {BGE.LoadTask} the queued task, or invalid if it didn't need loading
    function loadSceneBitmap(loader as BGE.AssetLoader, bitmapName as string, pathOrUrl as string, options = {} as BGE.BitmapLoadOptions, shared = false as boolean) as BGE.LoadTask
      if not m.claimSceneAsset(BGE.SceneAssetKind.bitmap, bitmapName, shared)
        return invalid
      end if
      return loader.loadBitmap(bitmapName, pathOrUrl, options)
    end function

    ' Queues a .obj or .stl model this scene owns. See `loadSceneBitmap()` for when it's loaded
    ' and freed.
    '
    ' @param {BGE.AssetLoader} loader - the loader `onLoad()` was given
    ' @param {string} modelName - the name to get it by later (`game.get3dModel()`)
    ' @param {string} pathOrUrl - local file path or URL
    ' @param {BGE.Model3dLoadOptions} [options={}] - as `AssetLoader.load3dModel()`
    ' @param {BGE.DownloadOptions} [downloadOptions={}] - as `AssetLoader.load3dModel()`
    ' @param {boolean} [shared=false] - keep it after the scene ends
    ' @return {BGE.LoadTask} the queued task, or invalid if it didn't need loading
    function loadSceneModel(loader as BGE.AssetLoader, modelName as string, pathOrUrl as string, options = {} as BGE.Model3dLoadOptions, downloadOptions = {} as BGE.DownloadOptions, shared = false as boolean) as BGE.LoadTask
      if not m.claimSceneAsset(BGE.SceneAssetKind.model, modelName, shared)
        return invalid
      end if
      return loader.load3dModel(modelName, pathOrUrl, options, downloadOptions)
    end function

    ' Queues a packed sprite atlas (and its sheets) this scene owns. See `loadSceneBitmap()` for
    ' when it's loaded and freed.
    '
    ' @param {BGE.AssetLoader} loader - the loader `onLoad()` was given
    ' @param {string} atlasName - the name to get it by later (`game.getSpriteAtlasFrames()`)
    ' @param {string} pathOrUrl - the `.json`'s local file path or URL
    ' @param {BGE.DownloadOptions} [options={}] - as `AssetLoader.loadSpriteAtlas()`
    ' @param {boolean} [shared=false] - keep it after the scene ends
    ' @return {BGE.LoadTask} the queued task, or invalid if it didn't need loading
    function loadSceneSpriteAtlas(loader as BGE.AssetLoader, atlasName as string, pathOrUrl as string, options = {} as BGE.DownloadOptions, shared = false as boolean) as BGE.LoadTask
      if not m.claimSceneAsset(BGE.SceneAssetKind.spriteAtlas, atlasName, shared)
        return invalid
      end if
      return loader.loadSpriteAtlas(atlasName, pathOrUrl, options)
    end function

    ' Queues a Tiled map (and its tileset images) this scene owns. See `loadSceneBitmap()` for
    ' when it's loaded and freed.
    '
    ' @param {BGE.AssetLoader} loader - the loader `onLoad()` was given
    ' @param {string} mapName - the name to get it by later (`game.getTiledMap()`)
    ' @param {string} pathOrUrl - local file path or URL of the map
    ' @param {BGE.DownloadOptions} [options={}] - as `AssetLoader.loadTiledMap()`
    ' @param {boolean} [shared=false] - keep it after the scene ends
    ' @return {BGE.LoadTask} the queued task, or invalid if it didn't need loading
    function loadSceneTiledMap(loader as BGE.AssetLoader, mapName as string, pathOrUrl as string, options = {} as BGE.DownloadOptions, shared = false as boolean) as BGE.LoadTask
      if not m.claimSceneAsset(BGE.SceneAssetKind.tiledMap, mapName, shared)
        return invalid
      end if
      return loader.loadTiledMap(mapName, pathOrUrl, options)
    end function

    ' Whether this visit owns an asset (loaded with `loadSceneBitmap()` and friends).
    '
    ' @param {BGE.SceneAssetKind} kind
    ' @param {string} name
    ' @return {boolean}
    function ownsSceneAsset(kind as BGE.SceneAssetKind, name as string) as boolean
      return m.sceneAssets.DoesExist(m.sceneAssetKey(kind, name))
    end function

    ' The assets this visit owns.
    '
    ' @return {BGE.SceneAsset[]}
    function getSceneAssets() as BGE.SceneAsset[]
      assets = [] as BGE.SceneAsset[]
      for each key in m.sceneAssets
        assets.push(m.sceneAssets[key])
      end for
      return assets
    end function

    ' Unloads every asset this visit owns now, e.g. to free memory early. The game frees them
    ' anyway when it leaves the scene.
    sub unloadSceneAssets()
      assets = m.sceneAssets
      m.sceneAssets = {}
      for each key in assets
        m.unloadSceneAsset(assets[key])
      end for
    end sub

    ' Whether an asset is loaded in the game, by anyone. Override it along with
    ' `unloadSceneAsset()` to track assets of your own.
    '
    ' @param {BGE.SceneAssetKind} kind
    ' @param {string} name
    ' @return {boolean}
    protected function isSceneAssetLoaded(kind as BGE.SceneAssetKind, name as string) as boolean
      if kind = BGE.SceneAssetKind.bitmap
        return m.game.hasBitmap(name)
      else if kind = BGE.SceneAssetKind.model
        return invalid <> m.game.Models[name]
      else if kind = BGE.SceneAssetKind.spriteAtlas
        return invalid <> m.game.getSpriteAtlas(name)
      else if kind = BGE.SceneAssetKind.tiledMap
        return invalid <> m.game.getTiledMap(name)
      end if
      return false
    end function

    ' Frees one asset this scene owned. Override it to do something else, e.g. keep some.
    '
    ' @param {BGE.SceneAsset} asset
    protected sub unloadSceneAsset(asset as BGE.SceneAsset)
      if asset.kind = BGE.SceneAssetKind.bitmap
        m.game.unloadBitmap(asset.name)
      else if asset.kind = BGE.SceneAssetKind.model
        m.game.unload3dModel(asset.name)
      else if asset.kind = BGE.SceneAssetKind.spriteAtlas
        m.game.unloadSpriteAtlas(asset.name)
      else if asset.kind = BGE.SceneAssetKind.tiledMap
        m.game.unloadTiledMap(asset.name)
      end if
    end sub

    ' Called by the game once this scene has been left (after `onDestroy()`): what this visit
    ' owned waits for the next scene's `onLoad()`, which can take it over.
    sub beginReleasingSceneAssets()
      m.releasingSceneAssets.Append(m.sceneAssets)
      m.sceneAssets = {}
    end sub

    ' Called by the game right after the next scene's `onLoad()`: frees what this scene owned
    ' last visit that the next scene didn't take over.
    sub unloadReleasedSceneAssets()
      assets = m.releasingSceneAssets
      m.releasingSceneAssets = {}
      for each key in assets
        m.unloadSceneAsset(assets[key])
      end for
    end sub

    ' Gives up an asset this scene owned last visit, so the next scene can have it. Used by
    ' the next scene's `loadSceneBitmap()` and friends.
    '
    ' @param {string} key
    ' @return {boolean} true if this scene was releasing it
    function handOverSceneAsset(key as string) as boolean
      if not m.releasingSceneAssets.DoesExist(key)
        return false
      end if
      m.releasingSceneAssets.Delete(key)
      return true
    end function

    ' Records a scene-owned (or shared) load. True when it needs queueing.
    private function claimSceneAsset(kind as BGE.SceneAssetKind, name as string, shared as boolean) as boolean
      key = m.sceneAssetKey(kind, name)
      if m.sceneAssets.DoesExist(key)
        ' asked for twice this visit; shared wins
        if shared
          m.sceneAssets.Delete(key)
        end if
        return false
      end if
      loaded = m.isSceneAssetLoaded(kind, name)
      leaving = m.game.getLeavingScene()
      handedOver = false
      if invalid <> leaving
        handedOver = leaving.handOverSceneAsset(key)
      end if
      if loaded and not handedOver
        ' someone else's (or already shared): left as it is
        return false
      end if
      if not shared
        m.sceneAssets[key] = {kind: kind, name: name} as BGE.SceneAsset
      end if
      ' a handed-over asset that failed to load last visit is queued again
      return not loaded
    end function

    private function sceneAssetKey(kind as BGE.SceneAssetKind, name as string) as string
      return kind + ":" + name
    end function

    ' The loading screen to show while this scene loads. Return `invalid` (the default) to use
    ' `game.loadingScreen`, or the engine's default if that isn't set.
    '
    ' @return {BGE.LoadingScreen}
    function getLoadingScreen() as BGE.LoadingScreen
      return invalid
    end function

    ' Called once per frame on the current scene after every entity has updated and moved
    ' (and tweens have ticked), before collisions and drawing. For work that needs everyone's
    ' final positions and shouldn't depend on entity update order, e.g. BGE.separateCircles().
    '
    ' @param {float} deltaTime - seconds since last frame, as onUpdate() gets
    sub onPostUpdate(deltaTime as float)
    end sub

    ' Called by the game right after `onPostUpdate()`. By default resolves `trackedSolidWorld`'s
    ' tracked bodies, if it is set.
    sub resolveTrackedSolids()
      if invalid <> m.trackedSolidWorld
        m.trackedSolidWorld.resolveTracked()
      end if
    end sub

    ' Removes every drawable this scene added directly to itself when the game changes scene
    ' (to another scene or to this one again), unless `persistDrawablesAcrossSceneChange` is
    ' true. An override only keeps this behavior if it calls `super.onChangeScene(newScene)`.
    '
    ' @param {GameScene} newScene - The scene being changed to (this scene itself on a reset)
    override sub onChangeScene(newScene as GameScene)
      ' Scenes aren't in Game.sortedEntities, so Game's own non-persistent cleanup never reaches their drawables.
      if m.persistDrawablesAcrossSceneChange
        return
      end if
      for each drawableName in m.drawablesByName.Keys()
        m.removeDrawable(drawableName)
      end for
    end sub
  end class
end namespace
