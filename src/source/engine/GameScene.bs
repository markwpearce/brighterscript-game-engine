import "Game.bs"
import "GameEntity.bs"
import "colliders/SolidWorld.bs"
import "loading/AssetLoader.bs"
import "loading/LoadingScreen.bs"
import "ui/UiWidget.bs"

namespace BGE

  ' A GameScene is a GameEntity that represents one distinct state of your game - a title
  ' screen, a menu, a level. Register scenes with `Game.defineScene()` and switch between
  ' them with `Game.changeScene()`. Only one GameScene is current at a time, and it gets the
  ' same per-frame hooks (`onUpdate`, `onInput`, ...) as any other entity.
  '
  ' Every scene change destroys all non-`persistent` entities and, by this class's default
  ' `onChangeScene()`, removes the outgoing scene's own drawables (anything added with
  ' `addDrawable()`/`addImage()`/etc. directly on the scene). Changing to the current scene
  ' again (`Game.resetScene()`, or `changeScene()` with the current scene's name, e.g. the
  ' next level of a level scene) works exactly like leaving it and entering it again.
  '
  ' To keep some or all of a scene's own drawables across a change:
  '  - set `persistDrawablesAcrossSceneChange = true` to keep all of them, or
  '  - override `onChangeScene()` with your own cleanup. An override replaces the default
  '    cleanup unless it calls `super.onChangeScene(newScene)`.
  '
  ' A scene is defined once and reused: leaving it (or resetting it) calls `onChangeScene()`
  ' then `onDestroy()` on it, and entering it again runs `onLoad()`/`onCreate()` again. Free
  ' whatever a visit set up (bitmaps loaded for it) in either hook. Widgets added with
  ' `addUi()` are removed for you after `onDestroy()`; ones added straight to `game.gameUi`
  ' stay until you remove them (use that for UI that should outlive the scene).
  class GameScene extends GameEntity

    ' Whether this scene's own directly-added drawables survive a scene change (including one
    ' to this same scene), instead of being removed by the default `onChangeScene()`.
    persistDrawablesAcrossSceneChange as boolean = false

    ' This scene's own render quality settings, applied once it has loaded (after `onCreate()`)
    ' and replaced by the next scene's: a frame rate to hold, a level range, or a draw distance
    ' that doesn't change with the level. Set it in `new()` or `onCreate()`.
    '
    ' @example
    ' m.qualityOptions = {targetFps: 30, fixedDrawDistance: true}
    qualityOptions as BGE.SceneQualityOptions = {}

    ' A SolidWorld whose tracked bodies the game resolves every frame, right after
    ' `onPostUpdate()` (see `BGE.SolidWorld.track()`). Invalid (the default) resolves nothing: call
    ' `resolveTracked()` yourself instead when it has to happen at another point, e.g. before the
    ' camera follows. Override `resolveTrackedSolids()` to change what runs.
    trackedSolidWorld as BGE.SolidWorld = invalid

    ' Widgets added with addUi(), removed when this visit ends.
    protected sceneUi as BGE.UI.UiWidget[] = []

    function new(gameEngine as Game, args = {} as roAssociativeArray)
      super(gameEngine, args)
    end function

    ' Adds a widget to `game.gameUi` for this visit only: it's removed (and its buttons
    ' unregistered from focus) when the game leaves or resets this scene, after
    ' `onDestroy()`. Add a widget to `game.gameUi` directly to keep it across scenes.
    '
    ' @param {BGE.UI.UiWidget} widget
    sub addUi(widget as BGE.UI.UiWidget)
      if widget = invalid
        return
      end if
      for each existing in m.sceneUi
        if existing.id = widget.id
          return
        end if
      end for
      m.sceneUi.push(widget)
      m.game.gameUi.addChild(widget)
    end sub

    ' Removes a widget added with addUi() from `game.gameUi`.
    '
    ' @param {BGE.UI.UiWidget} widget
    sub removeUi(widget as BGE.UI.UiWidget)
      if widget = invalid
        return
      end if
      for i = m.sceneUi.count() - 1 to 0 step -1
        if m.sceneUi[i].id = widget.id
          m.sceneUi.delete(i)
        end if
      end for
      m.game.gameUi.removeChild(widget)
    end sub

    ' Removes every widget added with addUi(). The game calls this when the scene changes.
    sub clearUi()
      widgets = m.sceneUi
      m.sceneUi = []
      for each widget in widgets
        m.game.gameUi.removeChild(widget)
      end for
    end sub

    ' How many widgets added with addUi() are still up.
    '
    ' @return {integer}
    function uiCount() as integer
      return m.sceneUi.count()
    end function

    ' Called when this scene is changed to, before `onCreate()`. Queue anything that takes time
    ' on `loader` - asset loads (`loader.loadBitmap()`, `loader.load3dModel()`, ...), your own
    ' `BGE.LoadTask`s, or a function called once per step (`loader.addStep()`). The engine runs
    ' them a little each frame, showing a loading screen, then calls `onCreate(args)`.
    ' Queue nothing (the default) and `onCreate()` runs straight away.
    '
    ' The previous scene's entities are already gone. This scene doesn't get `onUpdate()`,
    ' `onInput()` etc. until `onCreate()` has run - nor do entities added during `onLoad()`.
    '
    ' @param {BGE.AssetLoader} loader - queue this scene's loading work here
    ' @param {object} args - the args passed to `changeScene()`
    sub onLoad(loader as BGE.AssetLoader, args as roAssociativeArray)
    end sub

    ' The loading screen to show while this scene loads. Return `invalid` (the default) to use
    ' `game.loadingScreen`, or the engine's default if that isn't set.
    '
    ' @return {BGE.LoadingScreen}
    function getLoadingScreen() as BGE.LoadingScreen
      return invalid
    end function

    ' Called once per frame on the current scene after every entity has updated and moved
    ' (and tweens have ticked), before collisions and drawing. For work that needs everyone's
    ' final positions and shouldn't depend on entity update order, e.g. BGE.separateCircles().
    '
    ' @param {float} deltaTime - seconds since last frame, as onUpdate() gets
    sub onPostUpdate(deltaTime as float)
    end sub

    ' Called by the game right after `onPostUpdate()`. By default resolves `trackedSolidWorld`'s
    ' tracked bodies, if it is set.
    sub resolveTrackedSolids()
      if invalid <> m.trackedSolidWorld
        m.trackedSolidWorld.resolveTracked()
      end if
    end sub

    ' Removes every drawable this scene added directly to itself when the game changes scene
    ' (to another scene or to this one again), unless `persistDrawablesAcrossSceneChange` is
    ' true. An override only keeps this behavior if it calls `super.onChangeScene(newScene)`.
    '
    ' @param {GameScene} newScene - The scene being changed to (this scene itself on a reset)
    override sub onChangeScene(newScene as GameScene)
      ' Scenes aren't in Game.sortedEntities, so Game's own non-persistent cleanup never reaches their drawables.
      if m.persistDrawablesAcrossSceneChange
        return
      end if
      for each drawableName in m.drawablesByName.Keys()
        m.removeDrawable(drawableName)
      end for
    end sub
  end class
end namespace
