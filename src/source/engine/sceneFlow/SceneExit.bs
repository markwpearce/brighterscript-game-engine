import "ExitArea.bs"
import "../../math/vector.bs"

namespace BGE

  ' One way out of a scene: an area, and the scene (and args) walking into it changes to - see
  ' BGE.SceneExits. Subclass it and override isTriggeredBy() for another condition, e.g. only
  ' on a button press, or while a door is unlocked.
  class SceneExit
    area as BGE.ExitArea
    sceneName as string = ""
    ' Passed to the next scene, e.g. {spawn: "gate"} for its BGE.SpawnPoints
    args as roAssociativeArray = {}
    ' A disabled exit is never taken by SceneExits.update()
    enabled as boolean = true
    ' Each half of the fade; 0 or less changes scene straight away
    fadeSeconds as float = 0.3

    ' @param {BGE.ExitArea} area
    ' @param {string} sceneName
    ' @param {roAssociativeArray} [args={}]
    sub new(area as BGE.ExitArea, sceneName as string, args = {} as roAssociativeArray)
      m.area = area
      m.sceneName = sceneName
      m.args = args
    end sub

    ' Whether SceneExits.update() takes this exit for a position: by default, when it's
    ' enabled and the position is in its area.
    '
    ' @param {BGE.Math.Vector} position
    ' @return {boolean}
    function isTriggeredBy(position as BGE.Math.Vector) as boolean
      return m.enabled and m.area.contains(position)
    end function
  end class

end namespace
