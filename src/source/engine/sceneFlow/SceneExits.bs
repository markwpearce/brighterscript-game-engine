import "SceneExit.bs"
import "ExitArea.bs"
import "../Game.bs"
import "../../math/vector.bs"

namespace BGE

  ' A scene's ways out: areas that change to another scene when the player walks in. Each visit
  ' leaves once - after the first exit is taken the rest are ignored, so a player standing in a
  ' doorway during the fade doesn't ask again. If the change is refused (another transition is
  ' running) nothing is used up and the next update() tries again.
  '
  ' A scene makes one in onCreate() (scenes are reused, so make a new one or clear() it each
  ' visit), adds its exits, and calls update() with the player's position each frame - from
  ' onPostUpdate() to see where everyone ended up this frame. Shapes: BGE.RectExitArea,
  ' BGE.CircleExitArea, BGE.GridCellsExitArea, or subclass BGE.ExitArea. Subclass BGE.SceneExit
  ' for another trigger condition, and this class to change scene some other way
  ' (changeSceneFor()) or react to leaving (onLeave()). trigger() takes an exit directly, e.g.
  ' from a collider's onCollisionEnter().
  '
  ' @example
  ' m.exits = new BGE.SceneExits(m.game)
  ' m.exits.add(new BGE.RectExitArea(-100, 380, 200, 40), "TownScene", {spawn: "gate"})
  ' m.exits.add(new BGE.CircleExitArea(m.doorPosition, 60), "ChapelScene")
  ' ' in onPostUpdate():
  ' m.exits.update(m.player.position)
  class SceneExits

    ' While false, update() takes no exits
    enabled as boolean = true

    protected game as BGE.Game
    ' In the order added: the first that triggers wins
    protected exits as BGE.SceneExit[] = []
    private left as boolean = false

    ' @param {BGE.Game} game
    sub new(game as BGE.Game)
      m.game = game
    end sub

    ' Adds an exit to a scene.
    '
    ' @param {BGE.ExitArea} area
    ' @param {string} sceneName
    ' @param {roAssociativeArray} [args={}] - passed to the next scene
    ' @return {BGE.SceneExit} the exit, e.g. to set fadeSeconds or enabled
    function add(area as BGE.ExitArea, sceneName as string, args = {} as roAssociativeArray) as BGE.SceneExit
      sceneExit = new BGE.SceneExit(area, sceneName, args)
      return m.addExit(sceneExit)
    end function

    ' Adds an exit you made, e.g. a subclass of BGE.SceneExit.
    '
    ' @param {BGE.SceneExit} sceneExit
    ' @return {BGE.SceneExit} sceneExit
    function addExit(sceneExit as BGE.SceneExit) as BGE.SceneExit
      m.exits.push(sceneExit)
      return sceneExit
    end function

    ' Every exit, in the order added.
    '
    ' @return {BGE.SceneExit[]}
    function getAll() as BGE.SceneExit[]
      return m.exits
    end function

    ' @return {integer}
    function count() as integer
      return m.exits.count()
    end function

    ' Drops every exit and forgets having left, for the scene's next visit.
    sub clear()
      m.exits = []
      m.left = false
    end sub

    ' Whether an exit has changed scene this visit.
    '
    ' @return {boolean}
    function hasLeft() as boolean
      return m.left
    end function

    ' Takes the first exit (in the order added) whose isTriggeredBy() passes for a position.
    ' Does nothing while disabled or once one has been taken.
    '
    ' @param {BGE.Math.Vector} position - e.g. the player's
    ' @return {boolean} whether this changed scene
    function update(position as BGE.Math.Vector) as boolean
      if not m.enabled or m.left
        return false
      end if
      for each sceneExit in m.exits
        if sceneExit.isTriggeredBy(position)
          return m.trigger(sceneExit)
        end if
      end for
      return false
    end function

    ' Leaves through an exit wherever the player is, unless one has been taken already. An exit
    ' whose change is refused with no transition running (e.g. an undefined scene) is disabled.
    '
    ' @param {BGE.SceneExit} sceneExit
    ' @return {boolean} whether this changed scene
    function trigger(sceneExit as BGE.SceneExit) as boolean
      if m.left
        return false
      end if
      ' set first: a change while the game isn't running re-creates the scene (which may clear()) before returning
      m.left = true
      if not m.changeSceneFor(sceneExit)
        m.left = false
        if not m.game.isTransitioning()
          ' not a transition in the way (e.g. an undefined scene), so retrying every frame won't help
          sceneExit.enabled = false
        end if
        return false
      end if
      m.onLeave(sceneExit)
      return true
    end function

    ' Changes scene for an exit: Game.changeSceneWithFade() over its fadeSeconds, or
    ' Game.changeScene() when that's 0 or less. Override for another transition.
    '
    ' @param {BGE.SceneExit} sceneExit
    ' @return {boolean} false if the change was refused, e.g. a transition is already running
    protected function changeSceneFor(sceneExit as BGE.SceneExit) as boolean
      if sceneExit.fadeSeconds <= 0
        return m.game.changeScene(sceneExit.sceneName, sceneExit.args)
      end if
      return m.game.changeSceneWithFade(sceneExit.sceneName, sceneExit.args, sceneExit.fadeSeconds)
    end function

    ' Called once an exit has changed scene, e.g. to play a sound. Does nothing by default.
    '
    ' @param {BGE.SceneExit} sceneExit
    protected sub onLeave(sceneExit as BGE.SceneExit)
    end sub

  end class

end namespace
