import "../../math/vector.bs"

namespace BGE

  ' A named place a scene can put the player when it starts - see BGE.SpawnPoints. Subclass it
  ' to keep more with each spawn, e.g. a four-way facing for a 2D sprite.
  class SpawnPoint
    id as string = ""
    position as BGE.Math.Vector
    ' Which way the player faces there, in radians. In a 3D game heading 0 faces -z (see
    ' BGE.Math.headingForward()); a 2D game can use it however it likes, or subclass.
    heading as float = 0.0

    ' @param {string} id
    ' @param {BGE.Math.Vector} position
    ' @param {float} [heading=0.0] - radians
    sub new(id as string, position as BGE.Math.Vector, heading = 0.0 as float)
      m.id = id
      m.position = position
      m.heading = heading
    end sub
  end class

end namespace
