import "pkg:/source/engine/sceneFlow/ExitArea.bs"
import "pkg:/source/math/vector.bs"
import "pkg:/source/engine/colliders/CircleSeparation.bs"

namespace tests
  @suite("BGE.ExitArea shapes")
  class ExitAreaTests extends rooibos.BaseTestSuite

    @describe("RectExitArea")

    @it("on xz (the default) is x and z, including the low edges")
    function _()
      area = new BGE.RectExitArea(10, 20, 30, 40)
      m.assertTrue(area.contains(BGE.Math.VectorOps.create(10, 999, 20)))
      m.assertTrue(area.contains(BGE.Math.VectorOps.create(39.9, 0, 59.9)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(40, 0, 30)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(20, 0, 60)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(9.9, 0, 30)))
    end function

    @it("on xy is x and y")
    function _()
      area = new BGE.RectExitArea(10, 20, 30, 40, BGE.SeparationPlane.xy)
      m.assertTrue(area.contains(BGE.Math.VectorOps.create(15, 25, 999)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(15, 5, 25)))
    end function

    @describe("CircleExitArea")

    @it("is inside within the radius on the plane, ignoring height")
    function _()
      area = new BGE.CircleExitArea(BGE.Math.VectorOps.create(100, 0, 100), 10)
      m.assertTrue(area.contains(BGE.Math.VectorOps.create(105, 50, 105)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(110, 0, 100)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(100, 0, 111)))
    end function

    @it("on xy uses x and y")
    function _()
      area = new BGE.CircleExitArea(BGE.Math.VectorOps.create(0, 0, 0), 10, BGE.SeparationPlane.xy)
      m.assertTrue(area.contains(BGE.Math.VectorOps.create(0, 9, 500)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(0, 11, 0)))
    end function

    @describe("GridCellsExitArea")

    @it("covers its block of cells")
    function _()
      ' 4 x 4 grid of 10-unit cells centred on the origin; cells 1..2 across, 3 down
      area = new BGE.GridCellsExitArea(-20, -20, 10, 1, 3, 2, 1)
      m.assertTrue(area.contains(BGE.Math.VectorOps.create(-10, 0, 10)))
      m.assertTrue(area.contains(BGE.Math.VectorOps.create(9.9, 0, 19.9)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(10, 0, 15)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(-10.1, 0, 15)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(0, 0, 9.9)))
    end function

    @it("defaults to one cell and handles points left of the origin")
    function _()
      area = new BGE.GridCellsExitArea(0, 0, 10, -1, 0)
      m.assertTrue(area.contains(BGE.Math.VectorOps.create(-0.5, 0, 5)))
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(0.5, 0, 5)))
    end function

    @it("cellAt() is [col, row]")
    function _()
      area = new BGE.GridCellsExitArea(-20, -20, 10, 0, 0, 1, 1, BGE.SeparationPlane.xy)
      cell = area.cellAt(BGE.Math.VectorOps.create(5, -15, 0))
      m.assertEqual(2, cell[0])
      m.assertEqual(0, cell[1])
    end function

    @describe("ExitArea")

    @it("contains nothing by default")
    function _()
      area = new BGE.ExitArea()
      m.assertFalse(area.contains(BGE.Math.VectorOps.create(0, 0, 0)))
    end function

  end class
end namespace
