import "../../math/vector.bs"
import "../colliders/CircleSeparation.bs"

namespace BGE

  ' Where a scene exit is - see BGE.SceneExits. Subclass it and override contains() for
  ' another shape. Positions are read on `plane`: xz (the default) is the ground in a 3D game,
  ' xy a 2D game.
  class ExitArea
    plane as BGE.SeparationPlane = BGE.SeparationPlane.xz

    ' Whether a position (e.g. the player's) is inside.
    '
    ' @param {BGE.Math.Vector} position
    ' @return {boolean}
    function contains(position as BGE.Math.Vector) as boolean
      return false
    end function

    ' A position's first coordinate on the plane: always x.
    protected function planeX(position as BGE.Math.Vector) as float
      return position.x
    end function

    ' A position's second coordinate on the plane: y on xy, z on xz.
    protected function planeY(position as BGE.Math.Vector) as float
      if m.plane = BGE.SeparationPlane.xy
        return position.y
      end if
      return position.z ?? 0.0
    end function
  end class

  ' An axis-aligned rectangle, its low edges inside and its high edges not.
  class RectExitArea extends ExitArea
    x as float = 0.0
    ' z on the xz plane
    y as float = 0.0
    width as float = 0.0
    height as float = 0.0

    ' @param {float} x - the low x edge
    ' @param {float} y - the low y edge (z on the xz plane)
    ' @param {float} width
    ' @param {float} height - along y (z on the xz plane)
    ' @param {BGE.SeparationPlane} [plane="xz"]
    sub new(x as float, y as float, width as float, height as float, plane = BGE.SeparationPlane.xz as BGE.SeparationPlane)
      super()
      m.x = x
      m.y = y
      m.width = width
      m.height = height
      m.plane = plane
    end sub

    override function contains(position as BGE.Math.Vector) as boolean
      px = m.planeX(position)
      py = m.planeY(position)
      return px >= m.x and px < m.x + m.width and py >= m.y and py < m.y + m.height
    end function
  end class

  ' A circle round a point, e.g. walking up to a door; its edge isn't inside.
  class CircleExitArea extends ExitArea
    center as BGE.Math.Vector
    radius as float = 0.0

    ' @param {BGE.Math.Vector} center
    ' @param {float} radius
    ' @param {BGE.SeparationPlane} [plane="xz"]
    sub new(center as BGE.Math.Vector, radius as float, plane = BGE.SeparationPlane.xz as BGE.SeparationPlane)
      super()
      m.center = center
      m.radius = radius
      m.plane = plane
    end sub

    override function contains(position as BGE.Math.Vector) as boolean
      dx = m.planeX(position) - m.planeX(m.center)
      dy = m.planeY(position) - m.planeY(m.center)
      return dx * dx + dy * dy < m.radius * m.radius
    end function
  end class

  ' A block of cells in a grid, e.g. a tile map's doorway. Cell [0, 0]'s low corner is at
  ' (originX, originY) and columns run along x.
  class GridCellsExitArea extends ExitArea
    originX as float = 0.0
    ' z on the xz plane
    originY as float = 0.0
    cellSize as float = 1.0
    col as integer = 0
    row as integer = 0
    cols as integer = 1
    rows as integer = 1

    ' @param {float} originX - x of cell [0, 0]'s low corner
    ' @param {float} originY - y (z on the xz plane) of cell [0, 0]'s low corner
    ' @param {float} cellSize
    ' @param {integer} col - the block's first column
    ' @param {integer} row - the block's first row
    ' @param {integer} [cols=1]
    ' @param {integer} [rows=1]
    ' @param {BGE.SeparationPlane} [plane="xz"]
    sub new(originX as float, originY as float, cellSize as float, col as integer, row as integer, cols = 1 as integer, rows = 1 as integer, plane = BGE.SeparationPlane.xz as BGE.SeparationPlane)
      super()
      m.originX = originX
      m.originY = originY
      m.cellSize = cellSize
      m.col = col
      m.row = row
      m.cols = cols
      m.rows = rows
      m.plane = plane
    end sub

    ' The cell a position is in, as [col, row].
    '
    ' @param {BGE.Math.Vector} position
    ' @return {integer[]}
    function cellAt(position as BGE.Math.Vector) as integer[]
      return [Int((m.planeX(position) - m.originX) / m.cellSize), Int((m.planeY(position) - m.originY) / m.cellSize)]
    end function

    override function contains(position as BGE.Math.Vector) as boolean
      cell = m.cellAt(position)
      return cell[0] >= m.col and cell[0] < m.col + m.cols and cell[1] >= m.row and cell[1] < m.row + m.rows
    end function
  end class

end namespace
