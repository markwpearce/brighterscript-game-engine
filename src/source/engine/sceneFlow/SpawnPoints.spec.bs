import "pkg:/source/engine/sceneFlow/SpawnPoints.bs"
import "pkg:/source/engine/sceneFlow/SpawnPoint.bs"
import "pkg:/source/math/vector.bs"

namespace tests
  @suite("BGE.SpawnPoints")
  class SpawnPointsTests extends rooibos.BaseTestSuite

    @describe("add")

    @it("keeps the id, position and heading")
    function _()
      spawns = new BGE.SpawnPoints()
      point = spawns.add("gate", BGE.Math.VectorOps.create(10, 0, -20), 1.5)
      m.assertEqual("gate", point.id)
      m.assertEqual(10.0, point.position.x)
      m.assertEqual(-20.0, point.position.z)
      m.assertEqual(1.5, point.heading)
      m.assertEqual(1, spawns.count())
    end function

    @it("replaces a spawn with the same id, keeping its place in the order")
    function _()
      spawns = new BGE.SpawnPoints()
      spawns.add("a", BGE.Math.VectorOps.create(1, 0, 0))
      spawns.add("b", BGE.Math.VectorOps.create(2, 0, 0))
      spawns.add("a", BGE.Math.VectorOps.create(3, 0, 0))
      m.assertEqual(2, spawns.count())
      m.assertEqual(3.0, spawns.get("a").position.x)
      m.assertEqual("a", spawns.getIds()[0])
    end function

    @it("takes a subclassed point")
    function _()
      spawns = new BGE.SpawnPoints()
      custom = new tests.FacingSpawnForTests("door", BGE.Math.VectorOps.create(0, 0, 0), "down")
      spawns.addPoint(custom)
      found = spawns.get("door") as tests.FacingSpawnForTests
      m.assertEqual("down", found.facing)
    end function

    @it("get() is invalid for an unknown id")
    function _()
      spawns = new BGE.SpawnPoints()
      m.assertInvalid(spawns.get("nope"))
      m.assertFalse(spawns.has("nope"))
    end function

    @describe("resolve")

    @it("picks the spawn args.spawn names")
    function _()
      spawns = m.threeSpawns()
      m.assertEqual("b", spawns.resolve({spawn: "b"}, "c").id)
    end function

    @it("falls back to the default for a missing or unknown arg")
    function _()
      spawns = m.threeSpawns()
      m.assertEqual("c", spawns.resolve({}, "c").id)
      m.assertEqual("c", spawns.resolve({spawn: "nope"}, "c").id)
      m.assertEqual("c", spawns.resolve({spawn: 3}, "c").id)
    end function

    @it("falls back to the first added without a known default")
    function _()
      spawns = m.threeSpawns()
      m.assertEqual("z", spawns.resolve({}).id)
      m.assertEqual("z", spawns.resolve({}, "nope").id)
      m.assertEqual("z", spawns.resolve(invalid).id)
    end function

    @it("is invalid with no spawns")
    function _()
      spawns = new BGE.SpawnPoints()
      m.assertInvalid(spawns.resolve({spawn: "a"}, "a"))
    end function

    @it("reads the arg named by argName")
    function _()
      spawns = new BGE.SpawnPoints("from")
      spawns.add("crypt", BGE.Math.VectorOps.create(0, 0, 0))
      spawns.add("town", BGE.Math.VectorOps.create(0, 0, 0))
      m.assertEqual("town", spawns.resolve({from: "town", spawn: "crypt"}).id)
    end function

    @describe("remove and clear")

    @it("remove() drops one, clear() all")
    function _()
      spawns = m.threeSpawns()
      spawns.remove("b")
      m.assertFalse(spawns.has("b"))
      m.assertEqual(2, spawns.count())
      spawns.clear()
      m.assertEqual(0, spawns.count())
    end function

    private function threeSpawns() as BGE.SpawnPoints
      spawns = new BGE.SpawnPoints()
      spawns.add("z", BGE.Math.VectorOps.create(0, 0, 0))
      spawns.add("b", BGE.Math.VectorOps.create(1, 0, 0))
      spawns.add("c", BGE.Math.VectorOps.create(2, 0, 0))
      return spawns
    end function

  end class

  ' A spawn with a four-way facing, as a 2D game might keep
  class FacingSpawnForTests extends BGE.SpawnPoint
    facing as string = ""

    sub new(id as string, position as BGE.Math.Vector, facing as string)
      super(id, position, 0.0)
      m.facing = facing
    end sub
  end class
end namespace
