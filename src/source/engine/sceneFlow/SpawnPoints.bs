import "SpawnPoint.bs"
import "../../math/vector.bs"

namespace BGE

  ' The places a scene can start the player, by id, and which one this visit's args ask for.
  ' A scene makes one in onCreate() (scenes are reused, so make a new one or clear() it each
  ' visit), adds its spawns, then resolves the args it was changed to with. An exit into the
  ' scene names a spawn in its args, e.g. `{spawn: "gate"}` - see BGE.SceneExits.
  '
  ' @example
  ' m.spawns = new BGE.SpawnPoints()
  ' m.spawns.add("gate", BGE.Math.VectorOps.create(0, 0, 400), BGE.Math.PI)
  ' m.spawns.add("start", BGE.Math.VectorOps.create(0, 0, 0))
  ' spawn = m.spawns.resolve(args, "start")
  ' m.player.position.x = spawn.position.x
  ' m.player.position.z = spawn.position.z
  ' m.player.rotation.y = spawn.heading
  class SpawnPoints

    ' The args field resolve() reads the spawn id from
    argName as string = "spawn"

    ' In the order added
    private points as BGE.SpawnPoint[] = []

    ' @param {string} [argName="spawn"] - the args field resolve() reads the spawn id from
    sub new(argName = "spawn" as string)
      m.argName = argName
    end sub

    ' Adds a spawn. One with the same id is replaced, keeping its place in the order.
    '
    ' @param {string} id
    ' @param {BGE.Math.Vector} position
    ' @param {float} [heading=0.0] - radians
    ' @return {BGE.SpawnPoint} the spawn added
    function add(id as string, position as BGE.Math.Vector, heading = 0.0 as float) as BGE.SpawnPoint
      point = new BGE.SpawnPoint(id, position, heading)
      return m.addPoint(point)
    end function

    ' Adds a spawn you made, e.g. a subclass of BGE.SpawnPoint. One with the same id is
    ' replaced, keeping its place in the order.
    '
    ' @param {BGE.SpawnPoint} point
    ' @return {BGE.SpawnPoint} point
    function addPoint(point as BGE.SpawnPoint) as BGE.SpawnPoint
      for i = 0 to m.points.count() - 1
        if m.points[i].id = point.id
          m.points[i] = point
          return point
        end if
      end for
      m.points.push(point)
      return point
    end function

    ' @param {string} id
    ' @return {BGE.SpawnPoint} or invalid
    function get(id as string) as BGE.SpawnPoint
      for each point in m.points
        if point.id = id
          return point
        end if
      end for
      return invalid
    end function

    ' @param {string} id
    ' @return {boolean}
    function has(id as string) as boolean
      return invalid <> m.get(id)
    end function

    ' @param {string} id
    sub remove(id as string)
      for i = m.points.count() - 1 to 0 step -1
        if m.points[i].id = id
          m.points.delete(i)
        end if
      end for
    end sub

    sub clear()
      m.points = []
    end sub

    ' @return {integer}
    function count() as integer
      return m.points.count()
    end function

    ' Every spawn's id, in the order added.
    '
    ' @return {string[]}
    function getIds() as string[]
      ids = [] as string[]
      for each point in m.points
        ids.push(point.id)
      end for
      return ids
    end function

    ' Where to start this visit: the spawn `args[argName]` names, else `defaultId`, else the
    ' first one added. Override it to choose some other way.
    '
    ' @param {roAssociativeArray} args - the scene's args, e.g. from onCreate(); may be invalid
    ' @param {string} [defaultId=""]
    ' @return {BGE.SpawnPoint} or invalid if there are no spawns
    function resolve(args as roAssociativeArray, defaultId = "" as string) as BGE.SpawnPoint
      if invalid <> args
        wanted = args[m.argName]
        if invalid <> wanted and invalid <> GetInterface(wanted, "ifString")
          point = m.get(wanted)
          if invalid <> point
            return point
          end if
        end if
      end if
      point = m.get(defaultId)
      if invalid <> point
        return point
      end if
      if m.points.count() > 0
        return m.points[0]
      end if
      return invalid
    end function

  end class

end namespace
