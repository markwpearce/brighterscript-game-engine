import "../../math/vector.bs"
import "../GameEntity.bs"
import "../renderer/Renderer.bs"
import "../renderer/sceneObjects/SceneObject.bs"
import "../renderer/sceneObjects/SceneObjectWall.bs"
import "Image.bs"

namespace BGE

  ' A freestanding upright wall at any angle: a textured quad between two floor points, from
  ' `bottom` to `top`, in its owner's space. Set `tileWidth`/`tileHeight` to repeat the texture
  ' along a long or tall wall instead of stretching it. Draws as perspective-correct columns
  ' on a Camera3d.
  '
  ' Give the owning GameEntity `isStatic = true` so walls sort through the static BSP and can
  ' occlude. Each wall is its own sorted object, so cost grows with the wall count (unlike
  ' `BGE.DrawableWalls`), and walls that cross each other can sort wrong. No collision.
  '
  ' @example
  ' wall = new BGE.DrawableWall(m, brickRegion, {x: 0, z: 0}, {x: 400, z: -200}, 0, 120, {tileWidth: 64, tileHeight: 64})
  ' m.addDrawable("wall", wall)
  class DrawableWall extends BGE.Image

    ' One floor end, in the owner's space (x and z; y is ignored)
    startPoint as BGE.Math.Vector = BGE.Math.VectorOps.create()
    ' The other floor end
    endPoint as BGE.Math.Vector = BGE.Math.VectorOps.create()
    ' Height of the wall's foot and top, in the owner's space
    bottom as float = 0.0
    top as float = 100.0
    ' World units one copy of the texture covers across, or 0 to stretch it over the whole wall
    tileWidth as float = 0.0
    ' World units one copy of the texture covers up, or 0 to stretch it. Tiles start at the foot.
    tileHeight as float = 0.0

    ' @param {BGE.GameEntity} owner
    ' @param {roRegion} region the texture
    ' @param {BGE.Math.Vector} startPoint a floor end (x, z)
    ' @param {BGE.Math.Vector} endPoint the other floor end
    ' @param {float} bottom
    ' @param {float} top
    ' @param {roAssociativeArray} args any other fields (e.g. tileWidth, tileHeight, drawMode)
    sub new(owner as BGE.GameEntity, region as roRegion, startPoint as BGE.Math.Vector, endPoint as BGE.Math.Vector, bottom as float, top as float, args = {} as roAssociativeArray)
      super(owner, region, {})
      m.drawMode = SceneObjectDrawMode.orientedDrawBackFace
      m.isOccluder = true
      m.isShaded = true
      m.startPoint = BGE.Math.VectorOps.create(startPoint.x, 0, startPoint.z)
      m.endPoint = BGE.Math.VectorOps.create(endPoint.x, 0, endPoint.z)
      m.bottom = bottom
      m.top = top
      ' bs:disable-next-line: 1140
      m.append(args)
      m.updateSize()
    end sub

    ' Moves the wall. Use this rather than writing the fields, so the renderer sees the change.
    '
    ' @param {BGE.Math.Vector} startPoint a floor end (x, z)
    ' @param {BGE.Math.Vector} endPoint the other floor end
    ' @param {float} bottom
    ' @param {float} top
    sub setEnds(startPoint as BGE.Math.Vector, endPoint as BGE.Math.Vector, bottom as float, top as float)
      m.startPoint = BGE.Math.VectorOps.create(startPoint.x, 0, startPoint.z)
      m.endPoint = BGE.Math.VectorOps.create(endPoint.x, 0, endPoint.z)
      m.bottom = bottom
      m.top = top
      m.updateSize()
      m.invalidateGeometry()
    end sub

    ' Sets the world size of one copy of the texture (0 stretches it on that axis).
    '
    ' @param {float} tileWidth
    ' @param {float} tileHeight
    sub setTileSize(tileWidth as float, tileHeight as float)
      m.tileWidth = tileWidth
      m.tileHeight = tileHeight
      m.invalidateGeometry()
    end sub

    ' Length along the floor, in the owner's space.
    '
    ' @return {float}
    function getLength() as float
      dx = m.endPoint.x - m.startPoint.x
      dz = m.endPoint.z - m.startPoint.z
      return sqr(dx * dx + dz * dz)
    end function

    ' How many times the texture repeats across (x) and up (y) the wall.
    '
    ' @return {BGE.Math.Vector}
    function getTextureRepeats() as BGE.Math.Vector
      repeats = BGE.Math.VectorOps.create(1, 1)
      if m.tileWidth > 0
        repeats.x = m.getLength() / m.tileWidth
      end if
      if m.tileHeight > 0
        repeats.y = (m.top - m.bottom) / m.tileHeight
      end if
      return repeats
    end function

    override function getPretranslation() as BGE.Math.Vector
      return BGE.Math.VectorOps.create(0, 0)
    end function

    override function addToRenderer(rendererObj as Renderer) as BGE.SceneObject
      return m.addSceneObjectToRenderer(new BGE.SceneObjectWall(m.getSceneObjectName("wall"), m), rendererObj)
    end function

    private sub updateSize()
      m.width = m.getLength()
      m.height = m.top - m.bottom
    end sub

  end class
end namespace
