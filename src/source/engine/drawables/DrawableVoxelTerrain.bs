import "../GameEntity.bs"
import "../renderer/Renderer.bs"
import "../renderer/sceneObjects/SceneObject.bs"
import "../renderer/sceneObjects/SceneObjectVoxelTerrain.bs"
import "../voxel/VoxelMap.bs"
import "Drawable.bs"

namespace BGE

  ' How a voxel terrain follows the camera's pitch.
  enum VoxelPitchMode
    ' Shift the horizon by focal length x tan(pitch): cheapest, but only right near level
    ' (about +-15 degrees); past that, objects float or sink against the hills
    horizonShift = "horizonShift"
    ' Project each step with the pitched camera (a divide per step): heights match objects at
    ' any pitch, though columns can't lean, so objects near the screen edges drift sideways a
    ' little when steeply pitched
    exact = "exact"
  end enum

  ' Hills from a heightmap (a `BGE.VoxelMap`), drawn Comanche-style: each screen column marches
  ' over the map front to back and draws a vertical span wherever the terrain rises into view.
  ' Retro and low resolution (quality sets the columns), but real hills a flat `DrawablePlane`
  ' can't give. `Camera3d` only, one per renderer.
  '
  ' The owner's position is map cell (0, 0): map x and z are world x and z (times `cellSize`),
  ' and a map height (0-255) is `heightScale` world units above the owner. The terrain is drawn
  ' after the planes and before the walls, and hides sorted objects behind its hills. Roll
  ' works at any angle; pitch is limited by `pitchMode`. With `Camera3d.fog` on, the terrain
  ' fades into the fog; otherwise set `fade`.
  '
  ' See docs/voxel-terrain.md.
  class DrawableVoxelTerrain extends BGE.Drawable

    ' The heightmap
    map as BGE.VoxelMap
    ' World units per map cell
    cellSize as float = 1.0
    ' World units per height unit (the map's 0-255 scale)
    heightScale as float = 1.0
    ' `BGE.VoxelPitchMode`
    pitchMode as string = "horizonShift"
    ' With `Camera3d.fog` off: `{color: 0xRRGGBB, start: 0.5}` fades far terrain into `color`
    ' (the sky's, typically) from `start` (a fraction of the draw distance) to the far end.
    ' invalid: no fade, the terrain just ends at the draw distance.
    fade as dynamic = invalid
    ' How much nearer than an object's middle the terrain must be to hide it, in world units.
    ' 0 means one cell.
    hideTolerance as float = 0

    ' @param {BGE.GameEntity} owner its position is map cell (0, 0)
    ' @param {BGE.VoxelMap} map
    ' @param {roAssociativeArray} [args] any of the fields above
    sub new(owner as BGE.GameEntity, map as BGE.VoxelMap, args = {} as roAssociativeArray)
      super(owner, args)
      ' again: field defaults are set after super() (issue #69)
      ' bs:disable-next-line: 1140
      m.append(args)
      m.map = map
    end sub

    ' Swaps the map.
    '
    ' @param {BGE.VoxelMap} map
    sub setMap(map as BGE.VoxelMap)
      m.map = map
      m.invalidateGeometry()
    end sub

    ' The world height of the terrain at a world position, blended between cells, for standing
    ' on it.
    '
    ' @param {float} worldX
    ' @param {float} worldZ
    ' @return {float} world y
    function heightAt(worldX as float, worldZ as float) as float
      origin = m.getOwnerPosition()
      cellX = (worldX - origin.x) / m.cellSize
      cellZ = (worldZ - (origin.z ?? 0)) / m.cellSize
      return (origin.y ?? 0) + m.map.heightAt(cellX, cellZ) * m.heightScale
    end function

    ' The hide tolerance in world units (hideTolerance, or one cell if that's 0).
    '
    ' @return {float}
    function getHideTolerance() as float
      if m.hideTolerance > 0
        return m.hideTolerance
      end if
      return m.cellSize
    end function

    override function addToRenderer(rendererObj as Renderer) as BGE.SceneObject
      sceneObj = new SceneObjectVoxelTerrain(m.getSceneObjectName("voxelTerrain"), m)
      return m.addSceneObjectToRenderer(sceneObj, rendererObj)
    end function

  end class

end namespace
