import "../renderer/cameras/Camera2d.bs"

namespace tests

  ' Drawables constructed with an `invalid` owner (issue #231) - used standalone through a
  ' Renderer with no Game/GameEntity at all.
  @suite("BGE.Drawable with no owner")
  class OwnerlessDrawableTests extends rooibos.BaseTestSuite

    bitmap as roBitmap
    renderer as BGE.Renderer

    protected override function beforeEach()
      m.bitmap = CreateObject("roBitmap", {width: 200, height: 100, alphaEnable: true})
      m.renderer = new BGE.Renderer(m.bitmap)
    end function

    @describe("owner accessors")

    @it("getGame() returns invalid")
    function _()
      rect = new BGE.DrawableRectangle(invalid, 10, 10)
      m.assertInvalid(rect.getGame())
    end function

    @it("getOwnerScale() is 1 on every axis")
    function _()
      rect = new BGE.DrawableRectangle(invalid, 10, 10)
      scale = rect.getOwnerScale()
      m.assertEqual(1.0, scale.x)
      m.assertEqual(1.0, scale.y)
      m.assertEqual(1.0, scale.z)
    end function

    @it("getOwnerPosition()/getOwnerRotation() are zero")
    function _()
      rect = new BGE.DrawableRectangle(invalid, 10, 10)
      m.assertEqual(0.0, rect.getOwnerPosition().x)
      m.assertEqual(0.0, rect.getOwnerRotation().z)
    end function

    @it("getWorldPosition() is just the drawable's own offset")
    function _()
      rect = new BGE.DrawableRectangle(invalid, 10, 10, {offset: BGE.Math.VectorOps.create(5, 7, 0)})
      worldPos = rect.getWorldPosition()
      m.assertEqual(5.0, worldPos.x)
      m.assertEqual(7.0, worldPos.y)
    end function

    @it("isEnabled() follows only the drawable's own enabled flag")
    function _()
      rect = new BGE.DrawableRectangle(invalid, 10, 10)
      m.assertTrue(rect.isEnabled())
      rect.enabled = false
      m.assertFalse(rect.isEnabled())
    end function

    @it("movedLastFrame(includeOwner = true) only reflects the drawable's own movement")
    function _()
      rect = new BGE.DrawableRectangle(invalid, 10, 10)
      m.assertEqual(rect.movedLastFrame(false), rect.movedLastFrame(true))
    end function

    @it("log() is a no-op")
    function _()
      rect = new BGE.DrawableRectangle(invalid, 10, 10)
      rect.log("hello", BGE.Debug.LogLevel.error)
      m.assertTrue(true)
    end function

    @describe("addToRenderer / render")

    @it("DrawableRectangle can be added to a renderer and drawn")
    function _()
      rect = new BGE.DrawableRectangle(invalid, 10, 10, {name: "box", offset: BGE.Math.VectorOps.create(50, 50, 0)})
      sceneObj = rect.addToRenderer(m.renderer)
      m.assertNotInvalid(sceneObj)
      m.assertTrue(Instr(1, sceneObj.name, "noOwner") > 0, "expected scene object name '" + sceneObj.name + "' to contain 'noOwner'")
      m.renderer.render()
      m.assertTrue(m.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("DrawableLine with an identity transform still gets its real endpoints")
    function _()
      line = new BGE.DrawableLine(invalid, BGE.Math.VectorOps.create(10, 10, 0), BGE.Math.VectorOps.create(90, 60, 0))
      sceneObj = line.addToRenderer(m.renderer)
      m.renderer.render()
      midpoint = sceneObj.getPositionForCameraDistance(BGE.SceneObjectDrawMode.matchCamera)
      m.assertEqual(50.0, midpoint.x)
      m.assertEqual(35.0, midpoint.y)
    end function

    @it("Image can be added to a renderer and drawn")
    function _()
      src = CreateObject("roBitmap", {width: 8, height: 8, alphaEnable: true})
      src.clear(BGE.Colors.Red)
      region = CreateObject("roRegion", src, 0, 0, 8, 8)
      img = new BGE.Image(invalid, region, {offset: BGE.Math.VectorOps.create(50, 50, 0)})
      m.assertNotInvalid(img.addToRenderer(m.renderer))
      m.renderer.render()
      m.assertTrue(m.renderer.getDrawCallsLastFrame() > 0)
    end function

    @it("DrawableText falls back to the system default font and renders")
    function _()
      text = new BGE.DrawableText(invalid, "hi")
      m.assertNotInvalid(text.font)
      m.assertNotInvalid(text.getTextImage())
      m.assertNotInvalid(text.addToRenderer(m.renderer))
      m.renderer.render()
    end function

    @describe("animated drawables")

    @it("Sprite animates and logs a missing animation without crashing")
    function _()
      sheet = CreateObject("roBitmap", {width: 20, height: 10, alphaEnable: true})
      sprite = new BGE.Sprite(invalid, sheet, 10, 10)
      sprite.playAnimation("doesNotExist")
      sprite.update()
      m.assertTrue(true)
    end function

    @it("DrawableOrientedSprite update() keeps its current facing with no Game")
    function _()
      sheet = CreateObject("roBitmap", {width: 80, height: 10, alphaEnable: true})
      sprite = new BGE.DrawableOrientedSprite(invalid, sheet, 10, 10)
      sprite.addOrientedAnimation("walk", [[0], [1], [2], [3], [4], [5], [6], [7]], 10, BGE.SpritePlayMode.Loop)
      sprite.playOrientedAnimation("walk")
      sprite.update()
      m.assertTrue(true)
    end function

  end class

end namespace
