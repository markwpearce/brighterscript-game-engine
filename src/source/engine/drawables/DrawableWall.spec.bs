import "../../math/vector.bs"
import "../renderer/cameras/Camera3d.bs"
import "../renderer/Renderer.bs"
import "../renderer/sceneObjects/SceneObjectWall.bs"
import "DrawableWall.bs"

namespace tests

  @suite("BGE.DrawableWall")
  class DrawableWallTests extends rooibos.BaseTestSuite

    private game as BGE.Game
    private renderer as BGE.Renderer
    private texture as roRegion

    protected override sub beforeEach()
      m.game = new BGE.Game(320, 240)
      bitmap = CreateObject("roBitmap", {width: 320, height: 240, alphaEnable: true})
      m.renderer = new BGE.Renderer(bitmap, m.game, new BGE.Camera3d())
      textureBitmap = CreateObject("roBitmap", {width: 32, height: 32, alphaEnable: true})
      m.texture = CreateObject("roRegion", textureBitmap, 0, 0, 32, 32)
    end sub

    private function newWall(args = {} as roAssociativeArray) as BGE.DrawableWall
      return new BGE.DrawableWall(invalid, m.texture, BGE.Math.VectorOps.create(0, 0, 0), BGE.Math.VectorOps.create(30, 0, -40), 10, 60, args)
    end function

    @describe("new")

    @it("sizes itself from its ends and heights")
    function _()
      wall = m.newWall()
      size = wall.getSize()
      m.assertEqual(50.0, size.width)
      m.assertEqual(50.0, size.height)
    end function

    @it("is an occluding, shaded, two-sided wall by default")
    function _()
      wall = m.newWall()
      m.assertTrue(wall.isOccluder)
      m.assertTrue(wall.isShaded)
      m.assertEqual(BGE.SceneObjectDrawMode.orientedDrawBackFace, wall.drawMode)
    end function

    @it("applies args")
    function _()
      wall = m.newWall({isShaded: false, tileWidth: 20.0})
      m.assertFalse(wall.isShaded)
      m.assertEqual(20.0, wall.tileWidth)
    end function

    @describe("getTextureRepeats")

    @it("stretches once with no tile size")
    function _()
      repeats = m.newWall().getTextureRepeats()
      m.assertEqual(1.0, repeats.x)
      m.assertEqual(1.0, repeats.y)
    end function

    @it("repeats by length and height over the tile size")
    function _()
      repeats = m.newWall({tileWidth: 20.0, tileHeight: 40.0}).getTextureRepeats()
      m.assertEqual(2.5, repeats.x)
      m.assertEqual(1.25, repeats.y)
    end function

    @describe("SceneObjectWall")

    @it("puts its corners at the wall's ends and heights")
    function _()
      wall = m.newWall()
      sceneObj = wall.addToRenderer(m.renderer) as BGE.SceneObjectWall
      corners = sceneObj.getBoundingPoints(m.renderer.camera)
      m.assertEqual(0.0, corners[0].x)
      m.assertEqual(60.0, corners[0].y)
      m.assertEqual(30.0, corners[1].x)
      m.assertEqual(-40.0, corners[1].z)
      m.assertEqual(10.0, corners[2].y)
      m.assertEqual(10.0, corners[3].y)
      m.assertEqual(30.0, corners[3].x)
    end function

    @it("moves its corners with setEnds()")
    function _()
      wall = m.newWall()
      sceneObj = wall.addToRenderer(m.renderer) as BGE.SceneObjectWall
      sceneObj.getBoundingPoints(m.renderer.camera)
      wall.setEnds(BGE.Math.VectorOps.create(5, 0, 5), BGE.Math.VectorOps.create(5, 0, -15), 0, 20)
      corners = sceneObj.getBoundingPoints(m.renderer.camera)
      m.assertEqual(5.0, corners[0].z)
      m.assertEqual(-15.0, corners[1].z)
      m.assertEqual(20.0, corners[0].y)
      m.assertEqual(20.0, wall.getSize().width)
    end function

    @it("draws when it runs past the camera, with one end behind it")
    function _()
      camera = m.renderer.camera as BGE.Camera3d
      camera.position = BGE.Math.VectorOps.create(0, 30, 0)
      camera.setTarget(BGE.Math.VectorOps.create(0, 30, -100))
      camera.setFrameSize(320, 240)
      camera.checkMovement()
      ' Beside the camera, from well behind it to far ahead
      wall = new BGE.DrawableWall(invalid, m.texture, BGE.Math.VectorOps.create(40, 0, 300), BGE.Math.VectorOps.create(40, 0, -400), 0, 60, {tileWidth: 32})
      sceneObj = wall.addToRenderer(m.renderer) as BGE.SceneObjectWall
      m.renderer.render()
      m.assertTrue(sceneObj.didDrawLastFrame())
    end function

  end class

end namespace
