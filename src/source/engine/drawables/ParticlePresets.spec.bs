import "pkg:/source/engine/drawables/ParticlePresets.bs"

namespace tests

  @suite("BGE.ParticlePresets")
  class ParticlePresetsTests extends rooibos.BaseTestSuite

    @describe("blood")

    @it("is in metres by default, in the given colour")
    function _()
      style = BGE.ParticlePresets.blood(&h306020)
      m.assertEqual(style.shape, BGE.ParticleShape.Rectangle)
      m.assertEqual(style.count, 18)
      m.assertEqual(style.startColor, &h306020)
      m.assertEqual(style.endColor, &h306020)
      m.assertTrue(style.sizeInWorldUnits)
      m.assertTrue(Abs(style.speed - 2.45) < 0.0001)
      m.assertTrue(Abs(style.acceleration.y + 12) < 0.0001)
    end function

    @it("scales sizes, speeds and gravity by unitsPerMetre")
    function _()
      style = BGE.ParticlePresets.blood(&h8A1010, {unitsPerMetre: 32.0})
      m.assertTrue(Abs(style.startSize - 0.065 * 32) < 0.001)
      m.assertTrue(Abs(style.speed - 2.45 * 32) < 0.001)
      m.assertTrue(Abs(style.speedSpread - 1.05 * 32) < 0.001)
      m.assertTrue(Abs(style.lift - 1.625 * 32) < 0.001)
      m.assertTrue(Abs(style.acceleration.y + 12 * 32) < 0.001)
      ' lifetimes don't scale
      m.assertTrue(Abs(style.lifetime - 0.4) < 0.0001)
    end function

    @it("flips lift and gravity for yDown")
    function _()
      style = BGE.ParticlePresets.blood(&h8A1010, {unitsPerMetre: 10.0, yDown: true})
      m.assertTrue(style.lift < 0)
      m.assertTrue(style.liftSpread > 0)
      m.assertTrue(style.acceleration.y > 0)
    end function

    @it("returns a fresh style each call")
    function _()
      first = BGE.ParticlePresets.blood()
      first.count = 99
      m.assertEqual(BGE.ParticlePresets.blood().count, 18)
    end function

    @describe("sparks")

    @it("are lines; a parry shower is bigger than a block's")
    function _()
      block = BGE.ParticlePresets.blockSparks()
      parry = BGE.ParticlePresets.parrySparks()
      m.assertEqual(block.shape, BGE.ParticleShape.Line)
      m.assertEqual(parry.shape, BGE.ParticleShape.Line)
      m.assertTrue(parry.count > block.count)
      m.assertTrue(parry.speed > block.speed)
      m.assertEqual(BGE.ParticlePresets.blockSparks({unitsPerMetre: 2.0}).count, 8)
    end function

    @it("play through a ParticleBurstPool")
    function _()
      game = new BGE.Game(320, 240)
      pool = new BGE.ParticleBurstPool(game)
      game.addEntity(pool)
      emitter = pool.play(BGE.Math.VectorOps.create(), BGE.Math.VectorOps.create(1, 0, 0), BGE.ParticlePresets.parrySparks({unitsPerMetre: 32.0}))
      m.assertEqual(emitter.particles.Count(), 22)
    end function

  end class

end namespace
