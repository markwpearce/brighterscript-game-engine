namespace tests

  @suite("BGE.Image")
  class ImageTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    sourceBitmap as roBitmap

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.sourceBitmap = CreateObject("roBitmap", {width: 64, height: 64, alphaEnable: true})
    end function

    private function newRegion(width = 20 as integer, height = 10 as integer) as roRegion
      return CreateObject("roRegion", m.sourceBitmap, 0, 0, width, height)
    end function

    @describe("setAnchor")

    @it("writes the computed pretranslation through to the region")
    function _()
      region = m.newRegion(20, 10)
      image = new BGE.Image(m.entity, region)
      image.setAnchor(0.5, 1)
      m.assertEqual(-10, image.region.GetPretranslationX())
      m.assertEqual(-10, image.region.GetPretranslationY())
    end function

    @it("leaves the region's existing pretranslation alone until setAnchor is called")
    function _()
      region = m.newRegion(20, 10)
      region.SetPretranslation(7, 9)
      image = new BGE.Image(m.entity, region)
      m.assertEqual(7, image.region.GetPretranslationX())
      m.assertEqual(9, image.region.GetPretranslationY())
    end function

    @it("getPretranslation reads back whatever setAnchor pushed to the region")
    function _()
      region = m.newRegion(20, 10)
      image = new BGE.Image(m.entity, region)
      image.setAnchor(0.5, 1)
      pretrans = image.getPretranslation()
      m.assertEqual(-10.0, pretrans.x)
      m.assertEqual(-10.0, pretrans.y)
    end function

    @describe("AnimatedImage anchor across cell swaps")

    @it("reapplies the anchor to a new cell region after a frame swap")
    function _()
      regionA = m.newRegion(20, 10)
      regionB = CreateObject("roRegion", m.sourceBitmap, 20, 0, 40, 30)
      animImage = new BGE.AnimatedImage(m.entity, [regionA, regionB])
      animImage.setAnchor(0.5, 1)
      animImage.index = 1
      animImage.update()
      m.assertEqual(-20, regionB.GetPretranslationX())
      m.assertEqual(-30, regionB.GetPretranslationY())
    end function

  end class

end namespace
