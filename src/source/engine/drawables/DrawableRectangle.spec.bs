namespace tests

  ' DrawableRectangle is a plain data holder - width/height/color/outline - and the
  ' SceneObjectRectangle it registers does all the drawing. See
  ' SceneObjectRectangle.spec.bs for the drawing side.
  @suite("BGE.DrawableRectangle")
  class DrawableRectangleTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    rectangle as BGE.DrawableRectangle

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.rectangle = new BGE.DrawableRectangle(m.entity, 40, 20)
    end function

    @describe("construction")

    @it("takes its size from the constructor")
    function _()
      size = m.rectangle.getSize()
      m.assertEqual(40.0, size.width)
      m.assertEqual(20.0, size.height)
    end function

    @it("is filled by default")
    function _()
      m.assertTrue(m.rectangle.filled)
    end function

    @it("has no outline by default")
    function _()
      m.assertFalse(m.rectangle.hasOutline())
    end function

    @it("applies args from the constructor")
    function _()
      rect = new BGE.DrawableRectangle(m.entity, 10, 10, {
        filled: false,
        outlineRGBA: BGE.ColorsRGB.Red,
        outlineWidth: 3
      })
      m.assertFalse(rect.filled)
      m.assertTrue(rect.hasOutline())
      m.assertEqual(3, rect.outlineWidth)
    end function

    @describe("setSize")

    @it("changes the reported size")
    function _()
      m.rectangle.setSize(100, 50)
      size = m.rectangle.getSize()
      m.assertEqual(100.0, size.width)
      m.assertEqual(50.0, size.height)
    end function

    @it("invalidates geometry, since a resize isn't movement and can't be dirty-checked")
    function _()
      versionBefore = m.rectangle.geometryVersion
      m.rectangle.setSize(100, 50)
      m.assertEqual(versionBefore + 1, m.rectangle.geometryVersion)
    end function

    @it("does nothing when set to the size it already is")
    function _()
      versionBefore = m.rectangle.geometryVersion
      m.rectangle.setSize(40, 20)
      m.assertEqual(versionBefore, m.rectangle.geometryVersion)
    end function

    @describe("addToScene")

    @it("registers a SceneObjectRectangle with the renderer")
    function _()
      sceneObj = m.rectangle.addToScene(m.game.canvas.renderer)
      m.assertNotInvalid(sceneObj)
      m.assertEqual(BGE.SceneObjectType.Rectangle, sceneObj.type)
    end function

    @it("points the registered SceneObject back at this drawable")
    function _()
      sceneObj = m.rectangle.addToScene(m.game.canvas.renderer)
      ' comparing a distinguishing scalar rather than the whole object, since a Drawable
      ' holds an owner back-reference that would make deep equality circular
      m.rectangle.outlineWidth = 12345
      m.assertEqual(12345, sceneObj.drawable.outlineWidth)
    end function

    @describe("GameEntity.addRectangle")

    @it("creates and attaches a DrawableRectangle of the requested size")
    function _()
      rect = m.entity.addRectangle("body", 64, 32)
      m.assertNotInvalid(rect)
      size = rect.getSize()
      m.assertEqual(64.0, size.width)
      m.assertEqual(32.0, size.height)
    end function

    @it("makes the rectangle retrievable by name from its owner")
    function _()
      rect = m.entity.addRectangle("body", 64, 32)
      rect.outlineWidth = 999
      m.assertEqual(999, m.entity.getDrawable("body").outlineWidth)
    end function

  end class

end namespace
