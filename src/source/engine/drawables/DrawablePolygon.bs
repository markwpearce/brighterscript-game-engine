import "../../math/vector.bs"
import "../../utils/utils.bs"
import "../GameEntity.bs"
import "../renderer/Renderer.bs"
import "../renderer/ScanlinePolygonFill.bs"
import "../renderer/sceneObjects/SceneObject.bs"
import "../renderer/sceneObjects/SceneObjectPolygon.bs"
import "Drawable.bs"

namespace BGE

  class DrawablePolygon extends Drawable

    ' The polygon's corners. Filled as their convex hull (in any order) unless `concave`.
    points as BGE.Math.Vector[] = []

    ' Fill the outline as drawn, notches and all, rather than its convex hull: the points
    ' must then go round the outline in order. A concave polygon is filled with `DrawRect`
    ' bands (`Renderer.drawConcavePolygonTo()`), so a big one costs more than its hull would
    ' to redraw; a still one is cached in a bitmap, so it's only redrawn when it, its color or
    ' the camera changes.
    ' Never an occluder, and depth sorted by its hull.
    concave as boolean = false

    ' With `concave`, what's inside a self-intersecting outline: nonzero (a star drawn as one
    ' line is solid) or evenOdd (hollow centre).
    fillRule as BGE.PolygonFillRule = BGE.PolygonFillRule.nonZero

    sub new(owner as GameEntity, points = [] as BGE.Math.Vector[], args = {} as roAssociativeArray)
      super(owner, args)
      m.points = BGE.cloneArray(points)
      ' bs:disable-next-line: 1140
      m.append(args)
    end sub

    override function addToRenderer(rendererObj as Renderer) as BGE.SceneObject
      return m.addSceneObjectToRenderer(new SceneObjectPolygon(m.getSceneObjectName("polygon"), m), rendererObj)
    end function

  end class

end namespace
