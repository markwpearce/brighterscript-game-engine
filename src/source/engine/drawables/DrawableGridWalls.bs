import "../renderer/gridWalls/GridWallsMap.bs"
import "../renderer/walls/WallSegment.bs"
import "DrawableWalls.bs"

namespace BGE

  ' The walls of a grid maze: a BGE.DrawableWalls whose segments come from the map
  ' (`GridWallsMap.toSegments()`), one per straight run of a texture, facing the open cells.
  ' Needs a `Camera3d`; one walls drawable per renderer.
  '
  ' `isShaded` lights the walls; `color`/`alpha` tint them, and `flash()` works as for other
  ' drawables.
  class DrawableGridWalls extends BGE.DrawableWalls

    ' The grid whose solid cells are drawn as walls. Call invalidateGeometry() after replacing
    ' or changing it.
    map as BGE.GridWallsMap

    ' @param {BGE.GameEntity} owner
    ' @param {BGE.GridWallsMap} map
    ' @param {roAssociativeArray} textures texture name (as used in the map's legend) to an
    ' `roRegion` one cell wide and the wall height tall
    ' @param {roAssociativeArray} [args={}] Drawable fields, e.g. `{isShaded: true}`
    sub new(owner as BGE.GameEntity, map as BGE.GridWallsMap, textures as roAssociativeArray, args = {} as roAssociativeArray)
      super(owner, map.toSegments(), textures, args)
      m.map = map
      if invalid = args.hideTolerance
        m.hideTolerance = map.cellSize * 0.25
      end if
    end sub

    ' Rebuilds the walls from the map (segments given to setSegments() are replaced too).
    override sub invalidateGeometry()
      ' bs:disable-next-line
      if invalid <> m.map
        m.segments = m.map.toSegments()
      end if
      super.invalidateGeometry()
    end sub

  end class

end namespace
