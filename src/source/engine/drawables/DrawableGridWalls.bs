import "../GameEntity.bs"
import "../renderer/gridWalls/GridWallsMap.bs"
import "../renderer/Renderer.bs"
import "../renderer/sceneObjects/SceneObject.bs"
import "../renderer/sceneObjects/SceneObjectGridWalls.bs"
import "Drawable.bs"

namespace BGE

  ' The walls of a grid maze, drawn by raycasting: each frame a fan of rays from the
  ' `Camera3d` finds the first wall in each direction, and that wall's texture column is
  ' drawn as one strip, leaning with the camera's pitch to stay on the floor. Strips are
  ' `gridWallStripWidth` pixels apart (see `BGE.RenderQualitySettings`). Drawn in the
  ' renderer's `gridWalls` stage, after planes and before the sorted objects; one per
  ' renderer. Needs a `Camera3d`.
  '
  ' `isShaded` lights the walls (lights sampled every `gridWallLightInterval` strips);
  ' `color`/`alpha` tint them, and `flash()` works as for other drawables.
  class DrawableGridWalls extends BGE.Drawable

    ' The grid whose solid cells are drawn as walls. Call invalidateGeometry() after
    ' replacing it.
    map as BGE.GridWallsMap

    ' Texture name (as used in the map's legend) to an `roRegion` one cell wide and the
    ' wall height tall. Change with setTextures().
    textures as roAssociativeArray

    ' Texture name to its 1px column regions, built on first use.
    private columnsByTexture as roAssociativeArray

    ' @param {BGE.GameEntity} owner
    ' @param {BGE.GridWallsMap} map
    ' @param {roAssociativeArray} textures texture name to `roRegion` - see `textures`
    ' @param {object} [args={}] Drawable fields, e.g. `{isShaded: true}`
    sub new(owner as BGE.GameEntity, map as BGE.GridWallsMap, textures as roAssociativeArray, args = {} as object)
      super(owner, args)
      ' bs:disable-next-line: 1140
      m.append(args)
      m.map = map
      m.textures = textures
      m.columnsByTexture = {}
    end sub

    ' Replaces the wall textures.
    '
    ' @param {roAssociativeArray} textures texture name to `roRegion` - see `textures`
    sub setTextures(textures as roAssociativeArray)
      m.textures = textures
      m.columnsByTexture = {}
      m.invalidateGeometry()
    end sub

    ' A texture's 1px-wide column regions, left to right, each pre-translated so its foot
    ' is at the draw point. Invalid if there's no such texture.
    '
    ' @param {string} name texture name
    ' @return {dynamic} roRegion[] or invalid
    function getColumns(name as string) as dynamic
      columns = m.columnsByTexture[name]
      if invalid = columns
        columns = m.buildColumns(m.textures[name])
        m.columnsByTexture[name] = columns
      end if
      if columns.count() = 0
        return invalid
      end if
      return columns
    end function

    override function addToRenderer(rendererObj as Renderer) as BGE.SceneObject
      sceneObj = new SceneObjectGridWalls(m.getSceneObjectName("gridWalls"), m)
      return m.addSceneObjectToRenderer(sceneObj, rendererObj)
    end function

    ' Empty for a missing texture, so a miss is cached too.
    private function buildColumns(region as dynamic) as roRegion[]
      columns = [] as roRegion[]
      if invalid = region
        return columns
      end if
      texture = region as roRegion
      bitmap = texture.GetBitmap()
      x = texture.GetX()
      y = texture.GetY()
      height = texture.GetHeight()
      for c = 0 to texture.GetWidth() - 1
        column = CreateObject("roRegion", bitmap, x + c, y, 1, height)
        column.SetPreTranslation(0, -height)
        columns.push(column)
      end for
      return columns
    end function

  end class

end namespace
