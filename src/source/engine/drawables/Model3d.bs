import "../../math/math.bs"
import "../../math/vector.bs"
import "../../utils/colors.bs"
import "../../utils/deviceRenderTier.bs"
import "../GameEntity.bs"
import "../renderer/Renderer.bs"
import "../renderer/RendererHelpers.bs"
import "../renderer/quadColumns/QuadColumnTexture.bs"
import "../renderer/quadColumns/TriangleColumnCuts.bs"
import "../renderer/sceneObjects/SceneObject.bs"
import "../renderer/sceneObjects/SceneObjectModel.bs"
import "Drawable.bs"

namespace BGE

  class Model3dTexture
    srcRegionWithId as BGE.RendererHelpers.RegionWithId
    points as BGE.Math.Vector[]
    private columnCuts as BGE.TriangleColumnCuts = invalid

    sub new(srcRegionWithId as BGE.RendererHelpers.RegionWithId, points as BGE.Math.Vector[])
      m.srcRegionWithId = srcRegionWithId
      m.points = points
    end sub

    ' The face's texture strips for drawing it as columns, cut on first use and shared by
    ' every instance of the model.
    '
    ' @return {BGE.TriangleColumnCuts}
    function getColumnCuts() as BGE.TriangleColumnCuts
      if invalid = m.columnCuts
        m.columnCuts = new BGE.TriangleColumnCuts(m.srcRegionWithId.region, m.points)
        ' one per texture, as faces share its regionWithId, so its flipped copies are shared
        source = m.srcRegionWithId.columnTexture
        if invalid = source
          source = new BGE.QuadColumnTexture(m.srcRegionWithId.region, m.srcRegionWithId.id)
          m.srcRegionWithId.columnTexture = source
        end if
        m.columnCuts.mirrorSource = source
      end if
      return m.columnCuts
    end function
  end class

  ' The options accepted by Game.load3dModel() for an .obj model's texture.
  interface Model3dLoadOptions
    ' A texture to draw every textured face with, instead of the textures its .mtl file gives
    optional texturePath as string
  end interface

  ' A material from an .obj model's .mtl file (a `newmtl` block).
  interface Model3dMaterial
    name as string
    ' Its texture (`map_Kd`), resolved against the .mtl file's folder or URL; "" if it has none
    texturePath as string
    ' Its diffuse color (`Kd`) as packed RGBA - what a face with this material is filled with
    ' when it isn't textured
    optional color as integer
  end interface

  interface Model3dFace
    vertices as BGE.Math.Vector[]
    normal as BGE.Math.Vector
    optional Texture as Model3dTexture
    ' The name of this face's material (the .obj's `usemtl`), if it has one
    optional material as string
    brightness as float
    ' The color to draw with: `color` after shading - set on the per-frame canvas-space copy
    optional shadedColor as integer
    priority as float
    color as integer
    ' This face's position in the model's own, never-reordered face list - set on the
    ' per-frame canvas-space copy (SceneObjectModel.updateCanvasPosition) so a face keeps
    ' a stable identity across frames even though modelCanvasFaces itself is filtered
    ' (backface culling) and re-sorted (depth) every frame. Used to find the face's world
    ' vertices and its last shaded color.
    optional faceIndex as integer
  end interface

  namespace Model3dFaceOps

    function create(vertices as BGE.Math.Vector[], normal = invalid as BGE.Math.Vector) as BGE.Model3dFace
      brightness = 1
      priority = 1
      color = BGE.Colors.White

      if vertices.Count() = 3
        face as BGE.Model3dFace = {
          vertices: vertices,
          normal: normal,
          brightness: brightness,
          priority: priority,
          color: color
        }
        if face.normal = invalid
          resetNormal(face)
        end if
        return face
      else
        ' throw "Model3dFace needs 3 vertices"
        return {
          vertices: [],
          normal: BGE.Math.VectorZero(),
          brightness: brightness,
          priority: priority,
          color: color
        } as BGE.Model3dFace
      end if
    end function

    sub resetNormal(face as BGE.Model3dFace)
      topVector = BGE.Math.VectorOps.subtract(face.vertices[0], face.vertices[2])
      downVector = BGE.Math.VectorOps.subtract(face.vertices[1], face.vertices[2])
      face.normal = BGE.Math.VectorOps.crossProduct(topVector, downVector)
      BGE.Math.VectorOps.normalize(face.normal)
    end sub

    function toStr(face as BGE.Model3dFace) as string
      return `Vertices: [\n ${ BGE.Math.VectorOps.toStr(face.vertices[0])},\n ${ BGE.Math.VectorOps.toStr(face.vertices[1])},\n ${ BGE.Math.VectorOps.toStr(face.vertices[2])}\n]\nNormal: ${ BGE.Math.VectorOps.toStr(face.normal)} `
    end function
  end namespace

  ' The largest a model texture tiled for UVs past 0..1 may be on each side, in pixels
  ' (half this on an HD or SD device - see Model3dOps.getTiledTextureMaxSize())
  const MODEL_TILED_TEXTURE_MAX_SIZE = 1024

  ' The whole texture repeats a face's UVs cover - see Model3dOps.getUVTileRange()
  interface UVTileRange
    minU as integer
    maxU as integer
    minV as integer
    maxV as integer
  end interface

  ' A texture (or a tiled copy of one) that faces map their UVs into
  interface ModelFaceTexture
    regionWithId as BGE.RendererHelpers.RegionWithId
    ' the size of one repeat of the texture, in pixels
    tileWidth as float
    tileHeight as float
  end interface

  namespace Model3dOps

    ' Points every textured face of a model at one texture - see applyTextureToFaces().
    '
    ' @param {BGE.Model3d} model
    ' @param {roBitmap} bitmap
    ' @param {string} cacheId - a stable, unique-per-texture id (the resolved texture path works well) used as the triangle-cache key for every draw of this texture
    sub applyTexture(model as BGE.Model3d, bitmap as roBitmap, cacheId as string)
      applyTextureToFaces(model.faces, bitmap, cacheId)
    end sub

    ' Groups the faces that have UV points by the texture each should be drawn with:
    ' `overridePath` for all of them if it isn't "", otherwise its material's texture, and
    ' for a face with no material the model's own `texturePath`. Faces that get no
    ' texture aren't included.
    '
    ' @param {BGE.Model3d} model
    ' @param {string} [overridePath=""] - a texture for every textured face (Model3dLoadOptions.texturePath)
    ' @return {roAssociativeArray} texture path -> the faces (Model3dFace[]) that use it
    function groupFacesByTexture(model as BGE.Model3d, overridePath = "" as string) as roAssociativeArray
      groups = {}
      for each face in model.faces
        if face.Texture <> invalid
          path = overridePath
          if path = ""
            path = getMaterialTexturePath(model, face)
          end if
          if path <> ""
            if groups[path] = invalid
              groups[path] = []
            end if
            groups[path].push(face)
          end if
        end if
      end for
      return groups
    end function

    ' The texture a face's material gives it, or the model's own texturePath for a face
    ' with no material.
    '
    ' @param {BGE.Model3d} model
    ' @param {BGE.Model3dFace} face
    ' @return {string} the path, or "" for none
    function getMaterialTexturePath(model as BGE.Model3d, face as BGE.Model3dFace) as string
      if face.material <> invalid and face.material <> ""
        material = model.materials[face.material]
        if material <> invalid
          return material.texturePath
        end if
        return ""
      end if
      if model.texturePath <> invalid
        return model.texturePath
      end if
      return ""
    end function

    ' Points each of these faces at one texture, converting their normalized UV points to
    ' pixel space (flipping v, since .obj UVs are bottom-up and bitmaps are top-down). A
    ' face whose UVs reach past 0..1 repeats the texture, the .obj default: it's given a
    ' copy of the texture tiled as many times as its UVs span (one per size, shared by
    ' every face that spans the same number of repeats). Faces with no Texture are left
    ' alone.
    '
    ' @param {BGE.Model3dFace[]} faces
    ' @param {roBitmap} bitmap
    ' @param {string} cacheId - a stable, unique-per-texture id (the resolved texture path works well) used as the triangle-cache key for every draw of this texture
    sub applyTextureToFaces(faces as BGE.Model3dFace[], bitmap as roBitmap, cacheId as string)
      width = bitmap.GetWidth()
      height = bitmap.GetHeight()
      region = CreateObject("roRegion", bitmap, 0, 0, width, height)
      untiled = {regionWithId: BGE.RendererHelpers.createRegionWithId(region, cacheId), tileWidth: width, tileHeight: height} as BGE.ModelFaceTexture
      tiledBySize = {}
      maxSize = invalid

      for each face in faces
        if face.Texture <> invalid
          texture = untiled
          range = getUVTileRange(face.Texture.points)
          tilesX = range.maxU - range.minU
          tilesY = range.maxV - range.minV
          ' a whole-repeat tiling looks the same from any starting repeat, so faces only
          ' need a copy per size, and one repeat anywhere is the texture itself
          if tilesX > 1 or tilesY > 1
            key = `${tilesX}x${tilesY}`
            if tiledBySize[key] = invalid
              if maxSize = invalid
                maxSize = getTiledTextureMaxSize()
              end if
              tiledBySize[key] = createTiledTexture(bitmap, tilesX, tilesY, maxSize, cacheId + "|tiled:" + key)
              if tiledBySize[key] = invalid
                print `[BGE.Model3dOps] warning: couldn't allocate a ${key} tiled copy of "${cacheId}" - its repeats will be stretched`
                tiledBySize[key] = {regionWithId: untiled.regionWithId, tileWidth: width / tilesX, tileHeight: height / tilesY} as BGE.ModelFaceTexture
              end if
            end if
            texture = tiledBySize[key]
          end if
          pixelPoints = [] as BGE.Math.Vector[]
          for each uv in face.Texture.points
            pixelPoints.push(BGE.Math.VectorOps.create((uv.x - range.minU) * texture.tileWidth, (range.maxV - uv.y) * texture.tileHeight, 0))
          end for
          face.Texture = new BGE.Model3dTexture(texture.regionWithId, pixelPoints)
        end if
      end for
    end sub

    ' The whole texture repeats a UV range covers, e.g. {minU: -1, maxU: 2, minV: 0, maxV: 1}
    ' for u from -0.5 to 1.5 - 0..1 for UVs within a single copy of the texture. A UV
    ' within 0.001 of a whole number counts as that number.
    '
    ' @param {BGE.Math.Vector[]} uvPoints - normalized UV points
    ' @return {BGE.UVTileRange}
    function getUVTileRange(uvPoints as BGE.Math.Vector[]) as BGE.UVTileRange
      minU = uvPoints[0].x
      maxU = minU
      minV = uvPoints[0].y
      maxV = minV
      for each uv in uvPoints
        minU = BGE.Math.Min(minU, uv.x)
        maxU = BGE.Math.Max(maxU, uv.x)
        minV = BGE.Math.Min(minV, uv.y)
        maxV = BGE.Math.Max(maxV, uv.y)
      end for
      ' a UV of exactly 1 is the far edge of the first copy, not the start of a second -
      ' and exported UVs are often a hair either side of a whole number
      epsilon = 0.001
      range = {minU: Int(minU + epsilon), maxU: -Int(-(maxU - epsilon)), minV: Int(minV + epsilon), maxV: -Int(-(maxV - epsilon))} as BGE.UVTileRange
      if range.maxU <= range.minU
        range.maxU = range.minU + 1
      end if
      if range.maxV <= range.minV
        range.maxV = range.minV + 1
      end if
      return range
    end function

    ' The largest a tiled model texture may be on each side on this device: an HD or SD
    ' Roku has only 64MB of texture memory.
    '
    ' @return {integer}
    function getTiledTextureMaxSize() as integer
      tier = BGE.getDeviceRenderTier()
      if tier = BGE.DeviceRenderTier.hd or tier = BGE.DeviceRenderTier.sd
        return BGE.MODEL_TILED_TEXTURE_MAX_SIZE \ 2
      end if
      return BGE.MODEL_TILED_TEXTURE_MAX_SIZE
    end function

    ' Draws a texture repeated tilesX x tilesY times into a new bitmap, shrinking each copy
    ' if needed to keep the bitmap within maxSize on each side.
    '
    ' @param {roBitmap} bitmap - the texture
    ' @param {integer} tilesX
    ' @param {integer} tilesY
    ' @param {integer} maxSize
    ' @param {string} cacheId
    ' @return {BGE.ModelFaceTexture} invalid if a bitmap couldn't be allocated
    function createTiledTexture(bitmap as roBitmap, tilesX as integer, tilesY as integer, maxSize as integer, cacheId as string) as BGE.ModelFaceTexture
      tileWidth = Int(BGE.Math.Max(1, BGE.Math.Min(bitmap.GetWidth(), maxSize \ tilesX)))
      tileHeight = Int(BGE.Math.Max(1, BGE.Math.Min(bitmap.GetHeight(), maxSize \ tilesY)))
      scaleX = tileWidth / bitmap.GetWidth()
      scaleY = tileHeight / bitmap.GetHeight()
      tiled = CreateObject("roBitmap", {width: tilesX * tileWidth, height: tilesY * tileHeight, AlphaEnable: true})
      ' one row of copies into a strip, then the strip once per row - a Roku drops
      ' everything drawn to a bitmap once ~13k draws queue up
      strip = CreateObject("roBitmap", {width: tilesX * tileWidth, height: tileHeight, AlphaEnable: true})
      if tiled = invalid or strip = invalid
        return invalid
      end if
      for column = 0 to tilesX - 1
        strip.DrawScaledObject(column * tileWidth, 0, scaleX, scaleY, bitmap)
      end for
      for row = 0 to tilesY - 1
        tiled.DrawObject(0, row * tileHeight, strip)
      end for
      region = CreateObject("roRegion", tiled, 0, 0, tiled.GetWidth(), tiled.GetHeight())
      regionWithId = BGE.RendererHelpers.createRegionWithId(region, cacheId)
      regionWithId.source = strip
      return {regionWithId: regionWithId, tileWidth: tileWidth, tileHeight: tileHeight} as BGE.ModelFaceTexture
    end function

    ' Call once a model's textures are applied: any face still waiting for a texture (none
    ' was given, or it failed to load) falls back to a flat fill, and an untextured face
    ' with a material takes that material's color (`Kd`).
    '
    ' @param {BGE.Model3d} model
    sub finishTextures(model as BGE.Model3d)
      for each face in model.faces
        if face.Texture <> invalid and face.Texture.srcRegionWithId.region = invalid
          face.Texture = invalid
        end if
        if face.Texture = invalid and face.material <> invalid and face.material <> ""
          material = model.materials[face.material]
          if material <> invalid and material.color <> invalid
            face.color = material.color
          end if
        end if
      end for
    end sub

  end namespace

  class Model3d
    faces as Model3dFace[]
    name as string = "Model3d"
    ' The texture for faces with no material: the first `map_Kd` in the .obj's .mtl file
    texturePath as string = invalid
    ' The materials from the .obj's .mtl file, by name (Model3dMaterial)
    materials as roAssociativeArray


    sub new(faces as Model3dFace[])
      m.faces = faces
      m.materials = {}
    end sub

    function toStr() as string
      lines = [] as string[]
      lines.push(`Model3d ${m.name}`)
      lines.push(`Faces: [\n`)
      for each face in m.faces
        lines.push(BGE.Model3dFaceOps.toStr(face))
      end for
      lines.push(`]`)
      return lines.join(chr(10))
    end function
  end class


  class DrawableModel extends Drawable

    ' The model to draw. After replacing it or changing its faces, call
    ' invalidateGeometry() so the renderer redraws it (and, for an occluder, rebuilds the
    ' area it hides).
    model as Model3d

    ' Experimental (#345, specs/2026-10-22-model-impostors-design.md): while the camera
    ' moves, keep drawing the last full rendering scaled and rotated to fit, for as long as it still
    ' fits. How far it may be off, grow or shrink, or be seen from a different angle comes from the
    ' render quality level (`modelImpostorError`, `modelImpostorMaxSizeChange`,
    ' `modelImpostorMaxAngleDegrees`). Only camera movement is covered - the model moving
    ' or turning redraws it (its faces straight to the canvas). On by default.
    useImpostor as boolean = true

    ' Experimental (#556): rotate the impostor's single blit only to follow the camera's roll.
    ' Turning, orbiting or moving without rolling then scales and shifts the capture without
    ' tilting it, so vertical edges stay vertical; when that no longer fits, strips (with
    ' useImpostorStrips) or a redraw take over. Off by default.
    impostorBlitRollOnly as boolean = false

    ' Experimental (#556): when the impostor's single scaled blit no longer fits, try redrawing
    ' the capture as vertical strips, each column scaled and shifted to follow the perspective
    ' change, before giving up and redrawing the model. Needs `useImpostor`. On by default
    ' (#557): verticals stay upright as the camera turns, and it redraws less.
    useImpostorStrips as boolean = true

    ' How far (px) a strip's single vertical scale may leave any of its columns from the
    ' fitted warp. Smaller means more, narrower strips. Ignored when impostorStripWidth is set.
    impostorStripStepPx as float = 2.5

    ' A fixed strip width, in pixels of the captured bitmap. 0 sizes strips by
    ' impostorStripStepPx instead.
    impostorStripWidth as integer = 0

    ' Where the strips' hint points come from: 0 fits them to the bounding box's visible
    ' vertical edges (the two outermost on screen and the one nearest the camera); 2 or more
    ' places up to that many knots across the model, at quantiles of its visible vertices' x
    ' (no more than the vertices support), with an inner one moved onto the box's nearest
    ' vertical edge (the crease), and fits them to those vertices.
    impostorStripKnots as integer = 3

    ' The most visible vertices a strip fit uses (an evenly spread subset of them): each
    ' strip attempt projects and fits every one.
    impostorStripMaxPoints as integer = 48

    ' Interpolate the strips with perspective between hint points, exact for flat walls between
    ' them; false interpolates linearly in screen x (the first prototype), for comparison.
    impostorStripPerspective as boolean = true

    ' How far (px) the strips may put any visible vertex from where it really is before the
    ' model is redrawn. 0 uses the quality level's modelImpostorError, scaled by
    ' impostorStripErrorScale.
    impostorStripMaxError as float = 0.0

    ' The most strips one redraw may take; past it the model is redrawn instead.
    impostorStripMaxStrips as integer = 32

    ' How far (degrees) the view may turn from the capture's and still try strips. 0 keeps the
    ' quality level's modelImpostorStripMaxAngleDegrees.
    impostorStripMaxAngleDegrees as float = 0.0

    ' Strips are the middle tier between the single blit and a redraw: with them on, the single
    ' blit's allowed error (the quality level's modelImpostorError) is scaled by this, so it can
    ' hand over to strips sooner, while it still looks right.
    impostorBlitErrorScale as float = 1.0

    ' With strips on, how far (degrees) the view may turn before the single blit hands over to
    ' strips - whether the direction to the model turns or the model moves across the view (the
    ' camera turning). 0 keeps the quality level's modelImpostorMaxAngleDegrees.
    impostorBlitMaxAngleDegrees as float = 0.0

    ' How far the model may reach in depth, as a multiple of its nearest point's depth, and
    ' still be reused as the single blit; past it, strips or a redraw. 0 keeps the quality
    ' level's modelImpostorBlitMaxDepthRatio.
    impostorBlitMaxDepthRatio as float = 0.0

    ' With strips on, scales the single blit's angle limit (the quality level's, or
    ' impostorBlitMaxAngleDegrees), so it hands over to strips sooner at every level.
    impostorBlitAngleScale as float = 0.75

    ' Redraw the impostor, at any quality level, once a side of the model that faced away at
    ' capture turns towards the camera - the capture has nothing to show for it (orbiting a
    ' building brings its side walls into view).
    impostorRedrawOnNewFace as boolean = true

    ' Sides smaller than this fraction of the model's whole surface (a plane's faces added up)
    ' don't force a redraw, so small details and curved props don't keep redrawing.
    impostorNewFaceMinArea as float = 0.01

    ' Scales the quality level's modelImpostorError for strips, so they can hold on longer than
    ' the single blit before a redraw. 0 keeps the quality level's modelImpostorStripErrorScale.
    ' Ignored when impostorStripMaxError is set.
    impostorStripErrorScale as float = 0.0

    ' Fit the strips in a level view (no pitch or roll) and turn each strip as it's drawn, so
    ' they follow a camera looking down; false fits them on the canvas and keeps them upright
    ' (exact only for a level camera), for comparison.
    impostorStripLevel as boolean = true

    sub new(owner as BGE.GameEntity, model as Model3d, args = {} as roAssociativeArray)
      super(owner, args)
      m.model = model
      m.isShaded = true
      ' bs:disable-next-line: 1140
      m.append(args)
    end sub

    override function addToRenderer(rendererObj as Renderer) as BGE.SceneObject
      return m.addSceneObjectToRenderer(new SceneObjectModel(m.getSceneObjectName("3dModel-" + m.model.name), m), rendererObj)
    end function

  end class


end namespace
