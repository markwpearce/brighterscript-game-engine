import "../../math/math.bs"
import "../../math/vector.bs"
import "../../utils/colors.bs"
import "../GameEntity.bs"
import "../renderer/Renderer.bs"
import "../renderer/RendererHelpers.bs"
import "../renderer/sceneObjects/SceneObject.bs"
import "../renderer/sceneObjects/SceneObjectModel.bs"
import "Drawable.bs"

namespace BGE

  class Model3dTexture
    srcRegionWithId as BGE.RendererHelpers.RegionWithId
    points as BGE.Math.Vector[]
    sub new(srcRegionWithId as BGE.RendererHelpers.RegionWithId, points as BGE.Math.Vector[])
      m.srcRegionWithId = srcRegionWithId
      m.points = points
    end sub
  end class

  ' The options accepted by Game.load3dModel() for an .obj model's texture.
  interface Model3dLoadOptions
    ' A texture to draw every textured face with, instead of the textures its .mtl file gives
    optional texturePath as string
  end interface

  ' A material from an .obj model's .mtl file (a `newmtl` block).
  interface Model3dMaterial
    name as string
    ' Its texture (`map_Kd`), resolved against the .mtl file's folder or URL; "" if it has none
    texturePath as string
    ' Its diffuse color (`Kd`) as packed RGBA - what a face with this material is filled with
    ' when it isn't textured
    optional color as integer
  end interface

  interface Model3dFace
    vertices as BGE.Math.Vector[]
    normal as BGE.Math.Vector
    optional Texture as Model3dTexture
    ' The name of this face's material (the .obj's `usemtl`), if it has one
    optional material as string
    brightness as float
    priority as float
    color as integer
    ' This face's position in the model's own, never-reordered face list - set on the
    ' per-frame canvas-space copy (SceneObjectModel.updateCanvasPosition) so a face keeps
    ' a stable identity across frames even though modelCanvasFaces itself is filtered
    ' (backface culling) and re-sorted (depth) every frame. Used to key SceneObjectModel's
    ' per-face raster reuse cache - see issue #163.
    optional faceIndex as integer
  end interface

  namespace Model3dFaceOps

    function create(vertices as BGE.Math.Vector[], normal = invalid as BGE.Math.Vector) as BGE.Model3dFace
      brightness = 1
      priority = 1
      color = BGE.Colors.White

      if vertices.Count() = 3
        face as BGE.Model3dFace = {
          vertices: vertices,
          normal: normal,
          brightness: brightness,
          priority: priority,
          color: color
        }
        if face.normal = invalid
          resetNormal(face)
        end if
        return face
      else
        ' throw "Model3dFace needs 3 vertices"
        return {
          vertices: [],
          normal: BGE.Math.VectorZero(),
          brightness: brightness,
          priority: priority,
          color: color
        } as BGE.Model3dFace
      end if
    end function

    sub resetNormal(face as BGE.Model3dFace)
      topVector = BGE.Math.VectorOps.subtract(face.vertices[0], face.vertices[2])
      downVector = BGE.Math.VectorOps.subtract(face.vertices[1], face.vertices[2])
      face.normal = BGE.Math.VectorOps.crossProduct(topVector, downVector)
      BGE.Math.VectorOps.normalize(face.normal)
    end sub

    function toStr(face as BGE.Model3dFace) as string
      return `Vertices: [\n ${ BGE.Math.VectorOps.toStr(face.vertices[0])},\n ${ BGE.Math.VectorOps.toStr(face.vertices[1])},\n ${ BGE.Math.VectorOps.toStr(face.vertices[2])}\n]\nNormal: ${ BGE.Math.VectorOps.toStr(face.normal)} `
    end function
  end namespace

  ' The largest a model texture tiled for UVs past 0..1 may be on each side, in pixels
  const MODEL_TILED_TEXTURE_MAX_SIZE = 1024

  ' The whole texture repeats a face's UVs cover - see Model3dOps.getUVTileRange()
  interface UVTileRange
    minU as integer
    maxU as integer
    minV as integer
    maxV as integer
  end interface

  ' A texture (or a tiled copy of one) that faces map their UVs into
  interface ModelFaceTexture
    regionWithId as BGE.RendererHelpers.RegionWithId
    ' the UV the texture's left edge is at
    minU as integer
    ' the UV the texture's top edge is at
    maxV as integer
    ' the size of one repeat of the texture, in pixels
    tileWidth as integer
    tileHeight as integer
  end interface

  namespace Model3dOps

    ' Picks the texture path an .obj model should actually use: an explicit override
    ' always wins over whatever `mtllib`/`map_Kd` resolution found while parsing.
    '
    ' @param {BGE.Model3dLoadOptions} options
    ' @param {BGE.Model3d} model
    ' @return {string}
    function resolveEffectiveTexturePath(options as BGE.Model3dLoadOptions, model as BGE.Model3d) as dynamic
      if options <> invalid and options.texturePath <> invalid and options.texturePath <> ""
        return options.texturePath
      end if
      return model.texturePath
    end function

    ' Points every textured face of a model at one texture - see applyTextureToFaces().
    '
    ' @param {BGE.Model3d} model
    ' @param {roBitmap} bitmap
    ' @param {string} cacheId - a stable, unique-per-texture id (the resolved texture path works well) used as the triangle-cache key for every draw of this texture
    sub applyTexture(model as BGE.Model3d, bitmap as roBitmap, cacheId as string)
      applyTextureToFaces(model.faces, bitmap, cacheId)
    end sub

    ' Groups the faces that have UV points by the texture each should be drawn with:
    ' `overridePath` for all of them if it isn't "", otherwise its material's texture, and
    ' for a face with no material the model's own `texturePath`. Faces that get no
    ' texture aren't included.
    '
    ' @param {BGE.Model3d} model
    ' @param {string} [overridePath=""] - a texture for every textured face (Model3dLoadOptions.texturePath)
    ' @return {roAssociativeArray} texture path -> the faces (Model3dFace[]) that use it
    function groupFacesByTexture(model as BGE.Model3d, overridePath = "" as string) as roAssociativeArray
      groups = {}
      for each face in model.faces
        if face.Texture <> invalid
          path = overridePath
          if path = ""
            path = getMaterialTexturePath(model, face)
          end if
          if path <> ""
            if groups[path] = invalid
              groups[path] = []
            end if
            groups[path].push(face)
          end if
        end if
      end for
      return groups
    end function

    ' The texture a face's material gives it, or the model's own texturePath for a face
    ' with no material.
    '
    ' @param {BGE.Model3d} model
    ' @param {BGE.Model3dFace} face
    ' @return {string} the path, or "" for none
    function getMaterialTexturePath(model as BGE.Model3d, face as BGE.Model3dFace) as string
      if face.material <> invalid and face.material <> ""
        material = model.materials[face.material]
        if material <> invalid
          return material.texturePath
        end if
        return ""
      end if
      if model.texturePath <> invalid
        return model.texturePath
      end if
      return ""
    end function

    ' Points each of these faces at one texture, converting their normalized UV points to
    ' pixel space (flipping v, since .obj UVs are bottom-up and bitmaps are top-down). A
    ' face whose UVs reach past 0..1 repeats the texture, the .obj default: it's given a
    ' copy of the texture tiled across its UV range (one per range, shared by faces with
    ' the same range). Faces with no Texture are left alone.
    '
    ' @param {BGE.Model3dFace[]} faces
    ' @param {roBitmap} bitmap
    ' @param {string} cacheId - a stable, unique-per-texture id (the resolved texture path works well) used as the triangle-cache key for every draw of this texture
    sub applyTextureToFaces(faces as BGE.Model3dFace[], bitmap as roBitmap, cacheId as string)
      width = bitmap.GetWidth()
      height = bitmap.GetHeight()
      region = CreateObject("roRegion", bitmap, 0, 0, width, height)
      untiled = {regionWithId: BGE.RendererHelpers.createRegionWithId(region, cacheId), minU: 0, maxV: 1, tileWidth: width, tileHeight: height} as BGE.ModelFaceTexture
      tiledByRange = {}

      for each face in faces
        if face.Texture <> invalid
          texture = untiled
          range = getUVTileRange(face.Texture.points)
          if range.minU <> 0 or range.maxU <> 1 or range.minV <> 0 or range.maxV <> 1
            key = `${range.minU},${range.maxU},${range.minV},${range.maxV}`
            if tiledByRange[key] = invalid
              tiledByRange[key] = createTiledTexture(bitmap, range, cacheId + "|tiled:" + key)
            end if
            texture = tiledByRange[key]
          end if
          pixelPoints = [] as BGE.Math.Vector[]
          for each uv in face.Texture.points
            pixelPoints.push(BGE.Math.VectorOps.create((uv.x - texture.minU) * texture.tileWidth, (texture.maxV - uv.y) * texture.tileHeight, 0))
          end for
          face.Texture = new BGE.Model3dTexture(texture.regionWithId, pixelPoints)
        end if
      end for
    end sub

    ' The whole texture repeats a UV range covers, e.g. {minU: -1, maxU: 2, minV: 0, maxV: 1}
    ' for u from -0.5 to 1.5 - 0..1 for UVs within a single copy of the texture.
    '
    ' @param {BGE.Math.Vector[]} uvPoints - normalized UV points
    ' @return {BGE.UVTileRange}
    function getUVTileRange(uvPoints as BGE.Math.Vector[]) as BGE.UVTileRange
      minU = uvPoints[0].x
      maxU = minU
      minV = uvPoints[0].y
      maxV = minV
      for each uv in uvPoints
        minU = BGE.Math.Min(minU, uv.x)
        maxU = BGE.Math.Max(maxU, uv.x)
        minV = BGE.Math.Min(minV, uv.y)
        maxV = BGE.Math.Max(maxV, uv.y)
      end for
      ' a UV of exactly 1 is the far edge of the first copy, not the start of a second
      range = {minU: Int(minU), maxU: -Int(-maxU), minV: Int(minV), maxV: -Int(-maxV)} as BGE.UVTileRange
      if range.maxU <= range.minU
        range.maxU = range.minU + 1
      end if
      if range.maxV <= range.minV
        range.maxV = range.minV + 1
      end if
      return range
    end function

    ' Draws a texture repeated across a UV tile range into a new bitmap, shrinking each copy
    ' if needed to keep the bitmap within MODEL_TILED_TEXTURE_MAX_SIZE on each side.
    '
    ' @param {roBitmap} bitmap - the texture
    ' @param {BGE.UVTileRange} range
    ' @param {string} cacheId
    ' @return {BGE.ModelFaceTexture}
    function createTiledTexture(bitmap as roBitmap, range as BGE.UVTileRange, cacheId as string) as BGE.ModelFaceTexture
      tilesX = range.maxU - range.minU
      tilesY = range.maxV - range.minV
      tileWidth = Int(BGE.Math.Max(1, BGE.Math.Min(bitmap.GetWidth(), BGE.MODEL_TILED_TEXTURE_MAX_SIZE \ tilesX)))
      tileHeight = Int(BGE.Math.Max(1, BGE.Math.Min(bitmap.GetHeight(), BGE.MODEL_TILED_TEXTURE_MAX_SIZE \ tilesY)))
      scaleX = tileWidth / bitmap.GetWidth()
      scaleY = tileHeight / bitmap.GetHeight()
      tiled = CreateObject("roBitmap", {width: tilesX * tileWidth, height: tilesY * tileHeight, AlphaEnable: true})
      for row = 0 to tilesY - 1
        for column = 0 to tilesX - 1
          tiled.DrawScaledObject(column * tileWidth, row * tileHeight, scaleX, scaleY, bitmap)
        end for
      end for
      region = CreateObject("roRegion", tiled, 0, 0, tiled.GetWidth(), tiled.GetHeight())
      return {regionWithId: BGE.RendererHelpers.createRegionWithId(region, cacheId), minU: range.minU, maxV: range.maxV, tileWidth: tileWidth, tileHeight: tileHeight} as BGE.ModelFaceTexture
    end function

    ' Call once a model's textures are applied: any face still waiting for a texture (none
    ' was given, or it failed to load) falls back to a flat fill, and an untextured face
    ' with a material takes that material's color (`Kd`).
    '
    ' @param {BGE.Model3d} model
    sub finishTextures(model as BGE.Model3d)
      for each face in model.faces
        if face.Texture <> invalid and face.Texture.srcRegionWithId.region = invalid
          face.Texture = invalid
        end if
        if face.Texture = invalid and face.material <> invalid and face.material <> ""
          material = model.materials[face.material]
          if material <> invalid and material.color <> invalid
            face.color = material.color
          end if
        end if
      end for
    end sub

    ' Clears every face's placeholder Texture, so the model falls back to flat-color
    ' rendering. Call this on every path where texture resolution/loading fails, so a
    ' face's Texture is never left as a placeholder whose srcRegionWithId.region is
    ' invalid - SceneObjectModel's draw path only checks `face.Texture <> invalid`,
    ' not the region inside it, so an uncleared placeholder crashes at draw time
    ' instead of degrading gracefully.
    '
    ' @param {BGE.Model3d} model
    sub clearTextures(model as BGE.Model3d)
      for each face in model.faces
        face.Texture = invalid
      end for
    end sub

  end namespace

  class Model3d
    faces as Model3dFace[]
    name as string = "Model3d"
    ' The texture for faces with no material: the first `map_Kd` in the .obj's .mtl file
    texturePath as string = invalid
    ' The materials from the .obj's .mtl file, by name (Model3dMaterial)
    materials as roAssociativeArray


    sub new(faces as Model3dFace[])
      m.faces = faces
      m.materials = {}
    end sub

    function toStr() as string
      lines = [] as string[]
      lines.push(`Model3d ${m.name}`)
      lines.push(`Faces: [\n`)
      for each face in m.faces
        lines.push(BGE.Model3dFaceOps.toStr(face))
      end for
      lines.push(`]`)
      return lines.join(chr(10))
    end function
  end class


  class DrawableModel extends Drawable

    ' The model to draw. After replacing it or changing its faces, call
    ' invalidateGeometry() so the renderer redraws it (and, for an occluder, rebuilds the
    ' area it hides).
    model as Model3d

    ' How many consecutive frames a face may reuse its own last-rendered raster
    ' (repositioned, content unchanged) before a real redraw, when the model moves -
    ' see SceneObjectModel's per-face reuse (issue #163). 0 disables reuse entirely
    ' (always redraw every visible face every frame); higher values trade a larger
    ' bound on visual staleness (a stale frame shows a face at its last-redrawn
    ' orientation, correctly positioned) for fewer expensive per-face redraws.
    maxStaleFrames as integer = 1

    ' How far (in canvas pixels, Manhattan distance - same measure the engine's other
    ' temp-bitmap-reuse tolerance checks use) any one of a face's 3 vertices may drift
    ' from where it was at its last real redraw before reuse is refused even if still
    ' within maxStaleFrames. Lower this if reused frames look visibly wrong (a
    ' fast-rotating or fast-approaching model can drift a lot in a single frame); raise
    ' it to permit more reuse at the cost of more visible staleness.
    maxFaceDriftDistance as float = 6

    ' Experimental (#345, specs/2026-10-22-model-impostors-design.md): while the camera
    ' moves, keep drawing the last full rendering scaled and rotated to fit, for as long as it still
    ' fits. How far it may be off, enlarged, or seen from a different angle comes from the
    ' render quality level (`modelImpostorError`, `modelImpostorMaxZoom`,
    ' `modelImpostorMaxAngleDegrees`). Only camera movement is covered - the model moving
    ' or turning redraws it. On by default; turns off per-face reuse (maxStaleFrames) for
    ' this model, so set it false to use that instead.
    useImpostor as boolean = true

    ' Experimental (#345): when a scale and rotation of the last full rendering no longer
    ' fit, try corner pinning it (`modelImpostorPinError`,
    ' `modelImpostorPinMaxAngleDegrees`) before redrawing. Only used with `useImpostor`.
    useImpostorPin as boolean = true

    sub new(owner as BGE.GameEntity, model as Model3d, args = {} as roAssociativeArray)
      super(owner, args)
      m.model = model
      m.isShaded = true
      ' bs:disable-next-line: 1140
      m.append(args)
    end sub

    override function addToRenderer(rendererObj as Renderer) as BGE.SceneObject
      return m.addSceneObjectToRenderer(new SceneObjectModel(m.getSceneObjectName("3dModel-" + m.model.name), m), rendererObj)
    end function

  end class


end namespace
