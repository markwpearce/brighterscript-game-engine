import "../../math/vector.bs"
import "../../utils/colors.bs"
import "../GameEntity.bs"
import "../renderer/Renderer.bs"
import "../renderer/RendererHelpers.bs"
import "../renderer/sceneObjects/SceneObject.bs"
import "../renderer/sceneObjects/SceneObjectModel.bs"
import "Drawable.bs"

namespace BGE

  class Model3dTexture
    srcRegionWithId as BGE.RendererHelpers.RegionWithId
    points as BGE.Math.Vector[]
    sub new(srcRegionWithId as BGE.RendererHelpers.RegionWithId, points as BGE.Math.Vector[])
      m.srcRegionWithId = srcRegionWithId
      m.points = points
    end sub
  end class

  ' The options accepted by Game.load3dModel() for an .obj model's texture.
  interface Model3dLoadOptions
    optional texturePath as string
  end interface

  interface Model3dFace
    vertices as BGE.Math.Vector[]
    normal as BGE.Math.Vector
    optional Texture as Model3dTexture
    brightness as float
    priority as float
    color as integer
  end interface

  namespace Model3dFaceOps

    function create(vertices as BGE.Math.Vector[], normal = invalid as BGE.Math.Vector) as BGE.Model3dFace
      brightness = 1
      priority = 1
      color = BGE.Colors.White

      if vertices.Count() = 3
        face as BGE.Model3dFace = {
          vertices: vertices,
          normal: normal,
          brightness: brightness,
          priority: priority,
          color: color
        }
        if face.normal = invalid
          resetNormal(face)
        end if
        return face
      else
        ' throw "Model3dFace needs 3 vertices"
        return {
          vertices: [],
          normal: BGE.Math.VectorZero(),
          brightness: brightness,
          priority: priority,
          color: color
        } as BGE.Model3dFace
      end if
    end function

    sub resetNormal(face as BGE.Model3dFace)
      topVector = BGE.Math.VectorOps.subtract(face.vertices[0], face.vertices[2])
      downVector = BGE.Math.VectorOps.subtract(face.vertices[1], face.vertices[2])
      face.normal = BGE.Math.VectorOps.crossProduct(topVector, downVector)
      BGE.Math.VectorOps.normalize(face.normal)
    end sub

    function toStr(face as BGE.Model3dFace) as string
      return `Vertices: [\n ${ BGE.Math.VectorOps.toStr(face.vertices[0])},\n ${ BGE.Math.VectorOps.toStr(face.vertices[1])},\n ${ BGE.Math.VectorOps.toStr(face.vertices[2])}\n]\nNormal: ${ BGE.Math.VectorOps.toStr(face.normal)} `
    end function
  end namespace

  namespace Model3dOps

    ' Picks the texture path an .obj model should actually use: an explicit override
    ' always wins over whatever `mtllib`/`map_Kd` resolution found while parsing.
    '
    ' @param {BGE.Model3dLoadOptions} options
    ' @param {BGE.Model3d} model
    ' @return {string}
    function resolveEffectiveTexturePath(options as BGE.Model3dLoadOptions, model as BGE.Model3d) as dynamic
      if options <> invalid and options.texturePath <> invalid and options.texturePath <> ""
        return options.texturePath
      end if
      return model.texturePath
    end function

    ' Finalizes every face's texture data now that the texture bitmap is loaded and its
    ' dimensions are known: wraps `bitmap` in one shared region+id (every face on this
    ' model points at the same RegionWithId - one texture per model, per issue #89's v1
    ' scope), and converts each textured face's normalized (0..1) UV points to pixel
    ' space, flipping v since .obj UVs are bottom-up and bitmaps are top-down. Faces
    ' with no Texture (a corner was missing a vt index while parsing) are left alone.
    '
    ' @param {BGE.Model3d} model
    ' @param {roBitmap} bitmap
    ' @param {string} cacheId - a stable, unique-per-texture id (the resolved texture path works well) used as the triangle-cache key for every draw of this texture
    sub applyTexture(model as BGE.Model3d, bitmap as roBitmap, cacheId as string)
      width = bitmap.GetWidth()
      height = bitmap.GetHeight()
      region = CreateObject("roRegion", bitmap, 0, 0, width, height)
      regionWithId = BGE.RendererHelpers.createRegionWithId(region, cacheId)

      for each face in model.faces
        if face.Texture <> invalid
          pixelPoints = [] as BGE.Math.Vector[]
          for each uv in face.Texture.points
            pixelPoints.push(BGE.Math.VectorOps.create(uv.x * width, (1 - uv.y) * height, 0))
          end for
          face.Texture = new BGE.Model3dTexture(regionWithId, pixelPoints)
        end if
      end for
    end sub

    ' Clears every face's placeholder Texture, so the model falls back to flat-color
    ' rendering. Call this on every path where texture resolution/loading fails, so a
    ' face's Texture is never left as a placeholder whose srcRegionWithId.region is
    ' invalid - SceneObjectModel's draw path only checks `face.Texture <> invalid`,
    ' not the region inside it, so an uncleared placeholder crashes at draw time
    ' instead of degrading gracefully.
    '
    ' @param {BGE.Model3d} model
    sub clearTextures(model as BGE.Model3d)
      for each face in model.faces
        face.Texture = invalid
      end for
    end sub

  end namespace

  class Model3d
    faces as Model3dFace[]
    name as string = "Model3d"
    texturePath as string = invalid

    sub new(faces as Model3dFace[])
      m.faces = faces
    end sub

    function toStr() as string
      lines = [] as string[]
      lines.push(`Model3d ${m.name}`)
      lines.push(`Faces: [\n`)
      for each face in m.faces
        lines.push(BGE.Model3dFaceOps.toStr(face))
      end for
      lines.push(`]`)
      return lines.join(chr(10))
    end function
  end class


  class DrawableModel extends Drawable

    model as Model3d

    sub new(owner as BGE.GameEntity, model as Model3d, args = {} as roAssociativeArray)
      super(owner, args)
      m.model = model
      m.isShaded = true
      ' bs:disable-next-line: 1140
      m.append(args)
    end sub

    override function addToScene(rendererObj as Renderer) as BGE.SceneObject
      return m.addSceneObjectToRenderer(new SceneObjectModel(m.getSceneObjectName("3dModel-" + m.model.name), m), rendererObj)
    end function

  end class


end namespace
