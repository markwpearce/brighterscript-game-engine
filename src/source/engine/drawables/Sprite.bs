import "../../roku_modules/rodash/rodash.d.bs"
import "../../utils/utils.bs"
import "../debug/LogLevel.bs"
import "../GameEntity.bs"
import "AnimatedImage.bs"
import "SpriteFrames.bs"

namespace BGE

  interface AnimationFrameDescription
    startFrame as integer
    frameCount as integer
  end interface

  enum SpritePlayMode
    Loop = "loop"
    Forward = "forward"
    Reverse = "reverse"
    PingPong = "pingpong"
  end enum

  class SpriteAnimation
    ' Name of the animation
    name as string
    ' Frames per second the animation should play at (fractional rates are fine)
    frameRate as float
    ' Array of the regions of the each cell of this animation
    frameList as integer[]
    ' Play mode for the sprite: loop, forward, reverse, pingpong
    playMode as SpritePlayMode = SpritePlayMode.Loop

    '
    ' CReate a new SpriteAnimation
    '
    ' @param {string} name Name of the animation
    ' @param frameList Wither an array of cell indexes, or an object {startFrame, frameCount}
    ' @param {float} frameRate Frames per second the animation should play at. Use BGE.frameRateFor() to play the frames over a set time.
    ' @param {SpritePlayMode} [playMode="loop"] Play mode for the sprite: loop, forward, reverse, pingpong
    sub new(name as string, frameList as integer[] or AnimationFrameDescription, frameRate as float, playMode = SpritePlayMode.Loop as SpritePlayMode)
      m.name = name
      m.frameRate = frameRate
      m.playMode = playMode
      m.setFrameList(frameList)
    end sub

    private sub setFrameList(frameList as integer[] or AnimationFrameDescription)
      m.frameList = []

      ' isArray must be checked first - dot-accessing .startFrame/.frameCount on a real
      ' integer[] (not an AA) throws a runtime error on real Roku hardware (confirmed via
      ' on-device testing, issue #104's Guard demo - the first caller to ever pass a raw
      ' array here instead of the {startFrame, frameCount} AA form).
      if rodash.isArray(frameList)
        frameArray = frameList as integer[]
        m.frameList = frameArray
      'bs:disable-next-line: cannot-find-name
      else if invalid <> frameList.startFrame and invalid <> frameList.frameCount and frameList.startFrame >= 0 and frameList.frameCount >= 0
        frameDesc = frameList as AnimationFrameDescription
        for i = frameDesc.startFrame to frameDesc.startFrame + frameDesc.frameCount - 1
          m.frameList.push(i)
        end for
      end if
    end sub
  end class

  class Sprite extends AnimatedImage

    ' roBitmap to pick cells from (the first sheet, when there are several)
    spriteSheet as ifDraw2d
    ' Every sheet, in order. Cells are numbered across them: sheet 0's first, then sheet 1's, ...
    spriteSheets as ifDraw2d[] = []
    ' Width of each animation cell in the sprite image in pixels (0 for packed frames)
    cellWidth as integer
    ' Height of each animation cell in the sprite image in pixels (0 for packed frames)
    cellHeight as integer
    ' Which rect of which sheet each frame index draws; may be shared with other sprites
    spriteFrames as BGE.SpriteFrames

    ' Lookup map of animation name -> SpriteAnimation object
    animations as roAssociativeArray = {}

    ' The current animation being played
    activeAnimation as SpriteAnimation = invalid

    ' @param {GameEntity} owner
    ' @param {ifDraw2d|ifDraw2d[]|BGE.SpriteFrames} spriteSheet One sheet, several with the same cell size (cells are numbered across sheets in order), or a BGE.SpriteFrames for packed frames or to share regions with other sprites
    ' @param {integer} cellWidth Width of each cell in pixels (ignored for a BGE.SpriteFrames)
    ' @param {integer} cellHeight Height of each cell in pixels (ignored for a BGE.SpriteFrames)
    ' @param [args={}] Any extra properties to set
    function new(owner as GameEntity, spriteSheet as ifDraw2d or ifDraw2d[] or BGE.SpriteFrames, cellWidth as integer, cellHeight as integer, args = {} as roAssociativeArray)
      super(owner, invalid, args)
      if "roAssociativeArray" = type(spriteSheet)
        m.spriteFrames = spriteSheet as BGE.SpriteFrames
      else
        m.spriteFrames = new BGE.SpriteFrames(spriteSheet as dynamic, cellWidth, cellHeight)
      end if
      m.spriteSheets = m.spriteFrames.sheets
      m.spriteSheet = m.spriteSheets[0]
      m.cellWidth = m.spriteFrames.cellWidth
      m.cellHeight = m.spriteFrames.cellHeight
      size = m.spriteFrames.getMaxSourceSize()
      m.width = size.x
      m.height = size.y
      m.setCellRegions()
      ' bs:disable-next-line: 1140
      m.append(args)
    end function

    private sub setCellRegions()
      if m.anchorIsSet
        m.regions = m.spriteFrames.regionsForAnchor(m.anchor.x, m.anchor.y)
      else
        m.regions = m.spriteFrames.regionsForAnchor(0, 0)
      end if
      if m.index >= 0 and m.index < m.regions.Count()
        m.region = m.regions[m.index]
      end if
    end sub

    ' Anchors are measured on the untrimmed cell, so packed frames trimmed out of their cells
    ' still line up. Switches to the shared regions already set up for this anchor.
    '
    ' @param {float} x
    ' @param {float} y
    override sub setAnchor(x as float, y as float)
      super.setAnchor(x, y)
      m.setCellRegions()
    end sub

    ' The regions come from spriteFrames with the anchor's pretranslation already set, and may
    ' be shared, so nothing is pushed onto them here.
    protected override sub applyAnchorToRegion()
    end sub

    ' Which sheet a cell index comes from, or -1 if it's out of range
    '
    ' @param {integer} frameIndex
    ' @return {integer}
    function getSheetIndexForFrame(frameIndex as integer) as integer
      return m.spriteFrames.sheetIndexForFrame(frameIndex)
    end function

    ' Size and cell layout of every sheet, for debug info
    '
    ' @return {roAssociativeArray[]}
    function getSpriteSheetsDebugInfo() as roAssociativeArray[]
      sheetsDump = []
      for i = 0 to m.spriteSheets.Count() - 1
        sheet = m.spriteSheets[i]
        if invalid = sheet
          continue for
        end if
        columns = 0
        rows = 0
        if m.cellWidth > 0 and m.cellHeight > 0
          columns = cint(sheet.GetWidth() / m.cellWidth)
          rows = cint(sheet.GetHeight() / m.cellHeight)
        end if
        firstFrame = -1
        for f = 0 to m.spriteFrames.frameCount() - 1
          if m.spriteFrames.sheetIndexForFrame(f) = i
            firstFrame = f
            exit for
          end if
        end for
        sheetsDump.push({
          width: sheet.GetWidth(),
          height: sheet.GetHeight(),
          columns: columns,
          rows: rows,
          firstFrame: firstFrame
        })
      end for
      return sheetsDump
    end function


    ' Apply a pre-translation to set the pivot point for the sprite cell. Prefer setAnchor():
    ' this changes the regions every sprite sharing spriteFrames draws with.
    '
    ' @param {float} x
    ' @param {float} y
    sub applyPreTranslation(x as float, y as float)
      for each region in m.regions
        region.SetPreTranslation(x, y)
      end for
    end sub

    ' Adds a named animation.
    '
    ' @param {string} name
    ' @param frameList Either an array of cell indexes, or an object {startFrame, frameCount}
    ' @param {float} frameRate Frames per second; must be above 0. BGE.frameRateFor() gives the rate for a duration.
    ' @param {SpritePlayMode} [playMode="loop"]
    ' @return {BGE.SpriteAnimation} the new animation, or invalid if the name is taken or the rate isn't positive
    function addAnimation(name as string, frameList as integer[] or AnimationFrameDescription, frameRate as float, playMode = SpritePlayMode.Loop as SpritePlayMode) as BGE.SpriteAnimation
      if frameRate <= 0
        m.log(`Sprite.addAnimation() - '${name}' needs a frame rate above 0`, BGE.Debug.LogLevel.warning)
        return invalid
      end if
      if invalid = m.animations[name]
        spriteAnim = new SpriteAnimation(name, frameList, frameRate, playMode)
        m.animations[name] = spriteAnim
        return spriteAnim
      end if
      m.log(`Sprite.addAnimation() - An animation named '${name}' already exists`, BGE.Debug.LogLevel.warning)
      return invalid
    end function

    ' Play an animation from the set of animations in this SpriteSheet. Calling this
    ' repeatedly with the same already-playing animationName (e.g. every onUpdate) is a
    ' no-op for timing purposes - only an actual switch to a *different* animation resets
    ' the animation clock, so a one-shot Forward/Reverse animation always starts at its
    ' first frame rather than reading whatever elapsed time built up while a previous
    ' animation was playing. Pass restart = true to replay the animation already playing
    ' from its first frame (e.g. a repeated one-shot attack).
    '
    ' @param {string} animationName
    ' @param {boolean} [restart=false] - reset the animation clock even if animationName is already playing
    sub playAnimation(animationName as string, restart = false as boolean)
      resetClock = restart or invalid = m.activeAnimation or m.activeAnimation.name <> animationName
      m.setActiveAnimation(animationName, resetClock)
    end sub

    ' Switches the active animation, resetting the animation clock only if resetClock is true.
    protected sub setActiveAnimation(animationName as string, resetClock as boolean)
      spriteAnim = m.animations[animationName]
      if invalid <> spriteAnim
        if resetClock
          m.animationTimer.mark()
        end if
        m.animationDurationMs = spriteAnim.frameList.count() * 1000.0 / spriteAnim.frameRate
      else
        m.log(`Sprite.playAnimation() - No animation named '${animationName}' exists`, BGE.Debug.LogLevel.warning)
      end if
      m.activeAnimation = spriteAnim
    end sub

    ' For tests only - fast-forwards the animation clock without waiting in real time
    ' (mirrors GameTimer's own addTime()/removeTime() testing convention). Needed because
    ' animationTimer is protected on the AnimatedImage ancestor, which a spec class (not
    ' itself a BGE.Sprite subclass) can't reach directly.
    '
    ' The first call freezes the clock (GameTimer.freeze()), so from then on only these
    ' calls move it and exact-time samples don't drift on a slow runner.
    '
    ' @param {integer} ms
    sub advanceAnimationClockForTests(ms as integer)
      m.animationTimer.freeze()
      m.animationTimer.addTime(ms)
    end sub

    ' For tests only - the raw elapsed milliseconds on the animation clock, unaffected by
    ' any animation's own duration/play-mode clamping (unlike getCellDrawIndex()'s
    ' already-clamped output). See advanceAnimationClockForTests() above.
    '
    ' @return {integer}
    function rawAnimationClockMsForTests() as integer
      return m.animationTimer.TotalMilliseconds()
    end function

    ' Debug helper - a plain data snapshot of every animation registered via
    ' addAnimation(): its frame rate/play mode, and each frame's index plus the exact
    ' spritesheet pixel rect (x/y/width/height) it draws from. Use to sanity-check a
    ' spritesheet's cell layout/frame-index math against the actual art when an
    ' animation looks like it's drawing the wrong region - see logAnimationsDebugInfo()
    ' to print this as JSON instead of inspecting it directly.
    '
    ' @return {roAssociativeArray}
    function getAnimationsDebugInfo() as roAssociativeArray
      animationsDump = {}
      for each name in m.animations
        anim = m.animations[name]
        framesDump = []
        for each frameIndex in anim.frameList
          framesDump.push(m.getFrameRegionDebugInfo(frameIndex))
        end for
        animationsDump[name] = {
          frameRate: anim.frameRate,
          playMode: anim.playMode,
          frameCount: anim.frameList.Count(),
          frames: framesDump
        }
      end for
      sheetsDump = m.getSpriteSheetsDebugInfo()
      ' Top-level size/columns/rows describe the first sheet
      firstSheet = {width: 0, height: 0, columns: 0, rows: 0}
      if sheetsDump.Count() > 0
        firstSheet = sheetsDump[0]
      end if
      return {
        spriteSheetWidth: firstSheet.width,
        spriteSheetHeight: firstSheet.height,
        cellWidth: m.cellWidth,
        cellHeight: m.cellHeight,
        columns: firstSheet.columns,
        rows: firstSheet.rows,
        spriteSheets: sheetsDump,
        totalRegions: invalid <> m.regions ? m.regions.Count() : 0,
        animations: animationsDump
      }
    end function

    ' One frame's sheet index and pixel rect (x/y/width/height) within that sheet, or an `error` note if
    ' frameIndex is out of range for this sprite's own sliced regions. Factored out of
    ' getAnimationsDebugInfo() so it's independently callable too.
    '
    ' @param {integer} frameIndex
    ' @return {roAssociativeArray}
    function getFrameRegionDebugInfo(frameIndex as integer) as roAssociativeArray
      if invalid = m.regions or frameIndex < 0 or frameIndex >= m.regions.Count()
        maxIndex = -1
        if invalid <> m.regions
          maxIndex = m.regions.Count() - 1
        end if
        return {frameIndex: frameIndex, error: `frame index out of range (sprite sheet has 0-${maxIndex.toStr()})`}
      end if
      region = m.regions[frameIndex]
      info = {
        frameIndex: frameIndex,
        sheetIndex: m.getSheetIndexForFrame(frameIndex),
        x: region.GetX(),
        y: region.GetY(),
        width: region.GetWidth(),
        height: region.GetHeight()
      }
      if not m.spriteFrames.isGrid()
        frame = m.spriteFrames.frames[frameIndex]
        info.offsetX = frame.offsetX
        info.offsetY = frame.offsetY
        info.sourceWidth = frame.sourceWidth
        info.sourceHeight = frame.sourceHeight
      end if
      return info
    end function

    ' Prints getAnimationsDebugInfo() as JSON via this sprite's owner Game.log() - call
    ' from onCreate()/onInput()/a Rooibos test while chasing a spritesheet slicing bug,
    ' e.g. to compare a walk cycle's actual per-frame pixel rects against the sheet's
    ' real layout.
    sub logAnimationsDebugInfo()
      m.log(FormatJson(m.getAnimationsDebugInfo()), BGE.Debug.LogLevel.info)
    end sub

    ' The current frame's column texture, shared through spriteFrames.
    '
    ' @return {BGE.QuadColumnTexture}
    override function getColumnTexture() as BGE.QuadColumnTexture
      if invalid = m.spriteFrames
        return invalid
      end if
      return m.spriteFrames.getColumnTexture(m.index)
    end function

    protected override function getCellDrawIndex() as integer
      if invalid = m.activeAnimation
        return -1
      end if
      frameCount = m.activeAnimation.frameList.Count()
      currentTimeMs = m.animationTimer.TotalMilliseconds()

      if currentTimeMs > m.animationDurationMs
        if SpritePlayMode.Loop = m.activeAnimation.playMode
          currentTimeMs -= m.animationDurationMs
          m.animationTimer.RemoveTime(m.animationDurationMs)
        else if SpritePlayMode.Forward = m.activeAnimation.playMode or SpritePlayMode.Reverse = m.activeAnimation.playMode
          currentTimeMs = m.animationDurationMs
        else if SpritePlayMode.PingPong = m.activeAnimation.playMode
          ' Wrap by whole round trips, then mirror the return half
          roundTripMs = 2 * m.animationDurationMs
          while currentTimeMs >= roundTripMs
            currentTimeMs -= roundTripMs
            m.animationTimer.RemoveTime(roundTripMs)
          end while
          if currentTimeMs > m.animationDurationMs
            currentTimeMs = roundTripMs - currentTimeMs
          end if
        end if
      end if
      tweenFunc = m.tweensReference[m.animationTween]
      if SpritePlayMode.Reverse = m.activeAnimation.playMode
        index = cint(tweenFunc(frameCount - 1, 0, currentTimeMs, m.animationDurationMs))
      else
        index = cint(tweenFunc(0, frameCount - 1, currentTimeMs, m.animationDurationMs))
      end if

      if index > frameCount - 1
        index = frameCount - 1
      else if index < 0
        index = 0
      end if
      return m.activeAnimation.frameList[index]
    end function

  end class

  ' The frame rate that plays `frameCount` frames over exactly `seconds`, e.g. a 3-frame
  ' attack windup that has to last 1.1s.
  '
  ' @param {integer} frameCount
  ' @param {float} seconds
  ' @return {float} frames per second, or 0 (which addAnimation rejects) if seconds isn't above 0
  function frameRateFor(frameCount as integer, seconds as float) as float
    if seconds <= 0
      return 0
    end if
    return frameCount / seconds
  end function

end namespace
