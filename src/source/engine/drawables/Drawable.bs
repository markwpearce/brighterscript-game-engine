import "../renderer/occlusion/OcclusionTypes.bs"
import "../../math/Matrix44.bs"
import "../../math/vector.bs"
import "../../utils/colors.bs"
import "../../utils/MotionChecker.bs"
import "../GameEntity.bs"
import "../interfaces.bs"
import "../renderer/Renderer.bs"
import "../renderer/sceneObjects/SceneObject.bs"

namespace BGE


  ' Abstract drawable class - all drawables extend from this
  class Drawable
    ' --------------Values That Can Be Changed------------
    name as string = ""

    ' The offset of the image from the owner's position
    offset = BGE.Math.VectorOps.create()

    ' The image scale
    scale = BGE.Math.VectorOps.create(1, 1, 1)

    ' Rotation of the image
    rotation = BGE.Math.VectorOps.create()

    ' directScaled only (see SceneObjectBillboard.updateCanvasPointsForCameraFacingQuad()):
    ' directScaled's whole point is to face the camera "by construction" and ignore 3D
    ' orientation entirely (see DrawableSphere, which forces this mode specifically so a
    ' sphere never tilts) - so it's screen-aligned and immune to camera roll by default,
    ' same as every other direct/billboard mode. Setting this true opts a single drawable
    ' back into visually banking with the camera's roll, the way a real object planted in
    ' the world would (matching how the ground plane/skybox already rotate with roll), by
    ' building the quad from the camera's *level* right/up vectors instead of its
    ' (roll-cancelling) rolled ones. Has no effect under a Camera2d, or in any other draw
    ' mode. Changing this after construction on an otherwise-stationary drawable needs an
    ' explicit invalidateGeometry() call, same as any other in-place shape change - nothing
    ' auto-detects a plain field write here.
    banksWithCameraRoll as boolean = false

    ' axisAligned only: the angle (degrees) the camera looks down at this drawable from when
    ' it's drawn at full height. It gets shorter the further the view is from this angle.
    ' Set it to the elevation the art was rendered from, e.g. 12 for a sheet drawn looking
    ' slightly down on a character. 0 means full height with a level camera. axisAligned
    ' drawables always bank with camera roll, whatever banksWithCameraRoll says.
    axisAlignedFullHeightPitch as float = 0

    ' This can be used to tint the image with the provided color if desired. White makes no change to the original image.
    color as integer = &hFFFFFF

    ' RGB color for the outline stroke. Leave `invalid` for no outline at all.
    optional outlineRGBA as integer = invalid

    ' Thickness of the outline stroke, in pixels. Only used when `outlineRGBA` is set.
    outlineWidth as integer = 1

    ' Change the image alpha (transparency).
    alpha as float = 255

    ' Whether or not the image will be drawn.
    enabled as boolean = true

    transformationMatrix = BGE.Math.getFloat44Identity()

    motionChecker as MotionChecker = new MotionChecker()

    protected shouldRedraw as boolean = false

    ' Bumped every time this drawable's geometry changes in a way the
    ' position/rotation/scale dirty-checking can't see - a rectangle being resized, for
    ' instance. `SceneObject` compares against it to know it has to recompute projected
    ' geometry even though nothing moved. Bump it via `invalidateGeometry()`.
    geometryVersion as integer = 0

    ' Normalized anchor point (0-1 on each axis) this drawable pivots around, where (0,0) is
    ' the top left corner (today's default behavior for every existing drawable) and (1,1) is
    ' the bottom right. Change it via setAnchor(), not by assigning directly - the renderer
    ' needs to know the geometry changed.
    protected anchor = BGE.Math.VectorOps.create(0, 0)

    ' Whether setAnchor() has ever been called. Image consults this to decide whether to keep
    ' honoring whatever pretranslation is already on its region (e.g. from a sprite atlas
    ' pivot) or to override it - see Image.applyAnchorToRegion().
    protected anchorIsSet as boolean = false

    ' The GameEntity this drawable is attached to. May be `invalid` for a drawable used
    ' standalone (e.g. drawn directly through a Renderer, with no Game) - it then behaves
    ' as if owned by an entity at the world origin with no rotation and a scale of 1.
    owner as GameEntity
    ' -------------Never To Be Manually Changed-----------------
    ' These values should never need to be manually changed.

    protected width as float = 0
    protected height as float = 0

    protected sceneObjects = {}

    ' Lazily-created identity matrix returned by getOwnerTransformationMatrix() when there's no owner.
    protected noOwnerTransformationMatrix as float[][] = invalid

    drawMode as SceneObjectDrawMode = SceneObjectDrawMode.matchCamera

    ' Makes this drawable hide whatever sits behind it (occlusion culling). Only takes
    ' effect when the owning GameEntity is `isStatic`, the drawable is fully opaque
    ' (an Image, Rectangle or Model3d), its `drawMode` is an oriented one (not
    ' directToCamera/directScaled), and the game uses a Camera3d. Otherwise it's ignored
    ' and the drawable draws as normal.
    '
    ' Only flag a drawable that is fully opaque: an Image with no transparent pixels, a
    ' model with no translucent face colors. The engine can't check this, and anything
    ' behind a see-through occluder will vanish. Note that a large filled triangle can
    ' leave dotted single-pixel seams along its internal edges, which occlusion still
    ' treats as covered.
    '
    ' An occluder still uses the renderer's cheaper approximate drawing while it or the
    ' camera moves. Its covered area shrinks to allow for that, so something just inside
    ' its edge may keep drawing until the camera stops. See Renderer.occluderDrawPolicy
    ' to change that trade-off.
    isOccluder as boolean = false

    private warnedOccluderNotStatic as boolean = false

    ' Whether this drawable is darkened by lighting: by the renderer's lights (see
    ' `Game.addLight()`), or with none, by how squarely it faces the camera. A billboard
    ' (a draw mode that stays square to the screen, e.g. `axisAligned`) is lit only by
    ' lights, as if it faced the camera across the ground, like a character cut-out.
    isShaded as boolean = false

    ' How far an `isShaded` drawable's lights wrap round past the side facing them, 0-1.
    ' 0 (the default) is plain diffuse light, so a surface facing away from a light gets
    ' none of it; 0.5 lights it halfway, so a back-lit billboard character is dim rather
    ' than black. Planes and models ignore it.
    lightWrap as float = 0.0

    ' The darkest an `isShaded` surface is ever allowed to get, as a 0-1 fraction of its
    ' own color - a face at a glancing/edge-on angle to the camera would otherwise darken
    ' all the way to pure black (0), which looks like a rendering glitch (a missing
    ' texture) rather than shading, especially right as a face rotates into view. Defaults
    ' to 0.25 (25% grey). Raise it for a flatter, more washed-out look; lower it (down to
    ' 0) to allow true black. With lights, it applies to each color channel separately.
    ambientBrightness as float = 0.25

    ' Active flash() state; see getDisplayColor().
    private flashColor as integer = &hFFFFFF
    private flashSeconds as float = 0.0
    private flashElapsed as float = 0.0
    private flashBlinkSeconds as float = 0.0

    sub new(owner as GameEntity, args = {} as roAssociativeArray)
      m.owner = owner
      ' bs:disable-next-line: 1140
      m.append(args)
    end sub


    ' Registers this Drawable with a Renderer, so it gets drawn each frame. The engine
    ' calls this for you when a drawable is added to an entity; call it yourself only for
    ' a standalone drawable. Subclasses override it to create their SceneObject.
    '
    ' @param {Renderer} renderer - The renderer to draw this Drawable with
    ' @return {BGE.SceneObject} The SceneObject that represents this Drawable in the renderer, or invalid if it has none
    function addToRenderer(renderer as Renderer) as BGE.SceneObject
      return invalid
    end function

    ' Every SceneObject this Drawable currently represents - usually one (a Drawable
    ' added to just the game canvas), but can be more than one if the same Drawable
    ' instance was also added to a second renderer (e.g. the UI canvas). Useful for
    ' consumer code that needs to identify "my own" SceneObject out of a list the
    ' renderer hands back (e.g. Renderer.getOverlapClusters()) - comparing two custom
    ' class instances directly with `=` is not supported by BrightScript at runtime
    ' (a "Type Mismatch" error, regardless of any `as`-cast at the BrighterScript type-
    ' checker level, which only affects compile-time typing, not the underlying VM
    ' operator), so compare SceneObject.id (a string) instead.
    '
    ' @return {BGE.SceneObject[]}
    function getSceneObjects() as BGE.SceneObject[]
      result = []
      for each item in m.sceneObjects.items()
        result.push(item.value)
      end for
      return result
    end function

    ' Unregisters every SceneObject this Drawable added to the given Renderer, so it
    ' stops being drawn. The engine calls this for you when a drawable is removed from
    ' an entity or the entity is destroyed.
    '
    ' @param {Renderer} renderer - The renderer to remove this Drawable from
    sub removeFromRenderer(renderer as Renderer)
      ' Only this renderer's scene objects - the drawable may also be in another one
      for each id in m.sceneObjects.keys()
        if renderer.getSceneObjectIndexById(id) >= 0
          renderer.removeSceneObject(m.sceneObjects[id] as SceneObject)
          m.sceneObjects.delete(id)
        end if
      end for
    end sub

    sub computeTransformationMatrix()
      currentlyMoved = m.motionChecker.check(m.offset, m.rotation, m.scale)

      if m.movedLastFrame() and not currentlyMoved
        m.motionChecker.resetMovedFlag()
        return
      end if

      if currentlyMoved
        m.motionChecker.setTransform(m.offset, m.rotation, m.scale)
        BGE.Math.Matrix44.setFrom(m.transformationMatrix, BGE.Math.getTransformationMatrix(m.offset, m.rotation, m.scale))
      end if
    end sub

    ' Whether offset/rotation/scale changed since the transform was last computed. Read-only
    ' (doesn't touch the MotionChecker), so every renderer this drawable is registered with
    ' sees the same answer.
    '
    ' @return {boolean}
    function hasPendingTransformChange() as boolean
      return m.motionChecker.check(m.offset, m.rotation, m.scale)
    end function

    ' Marks this drawable's geometry as changed, so the renderer recomputes its world and
    ' canvas geometry on the next frame. Movement is dirty-checked automatically (see
    ' `MotionChecker`), but a change in shape - resizing a rectangle, replacing a polygon's
    ' points - isn't visible to that check and has to be declared.
    sub invalidateGeometry()
      m.geometryVersion++
    end sub

    function getAnchor() as BGE.Math.Vector
      return BGE.Math.VectorOps.copy(m.anchor)
    end function

    ' Sets the normalized anchor point this drawable pivots around. (0,0) is top left (the
    ' default), (0.5, 1) is bottom-center, etc. This isn't movement, so it can't be picked up
    ' by the per-frame MotionChecker dirty-check - invalidateGeometry() tells the renderer to
    ' recompute this drawable's projected geometry even though nothing moved.
    '
    ' @param {float} x
    ' @param {float} y
    sub setAnchor(x as float, y as float)
      if x = m.anchor.x and y = m.anchor.y and m.anchorIsSet
        return
      end if
      m.anchor.x = x
      m.anchor.y = y
      m.anchorIsSet = true
      m.invalidateGeometry()
    end sub


    function movedLastFrame(includeOwner = false as boolean) as boolean
      if includeOwner
        return m.motionChecker.movedLastFrame or (invalid <> m.owner and m.owner.movedLastFrame())
      end if
      return m.motionChecker.movedLastFrame
    end function

    sub update()
    end sub


    sub onResume(pausedTimeMs as integer)
    end sub

    function isEnabled() as boolean
      return m.enabled and (invalid = m.owner or m.owner.enabled)
    end function

    ' The Game this drawable's owner belongs to.
    '
    ' @return {BGE.Game} the owner's Game, or invalid if this drawable has no owner (or its owner has no Game)
    function getGame() as BGE.Game
      return m.owner?.game
    end function

    ' Logs once per drawable that isOccluder was ignored because its owner isn't static.
    sub warnOccluderNeedsStaticOwner()
      if m.warnedOccluderNotStatic
        return
      end if
      m.warnedOccluderNotStatic = true
      m.log("Drawable '" + m.name + "' has isOccluder set but its GameEntity isn't isStatic - it will not occlude anything", BGE.Debug.LogLevel.warning)
    end sub

    ' Logs a message through the owner's Game. Does nothing if there is no Game to log to.
    '
    ' @param {string} message
    ' @param {BGE.Debug.LogLevel} [level=BGE.Debug.LogLevel.info]
    sub log(message as string, level = BGE.Debug.LogLevel.info as BGE.Debug.LogLevel)
      game = m.getGame()
      if invalid <> game
        game.log(message, level)
      end if
    end sub

    ' The owner's transformation matrix, or the identity matrix if this drawable has no owner.
    '
    ' @return {float[][]}
    function getOwnerTransformationMatrix() as float[][]
      if invalid <> m.owner
        return m.owner.transformationMatrix
      end if
      if invalid = m.noOwnerTransformationMatrix
        m.noOwnerTransformationMatrix = BGE.Math.getFloat44Identity()
      end if
      return m.noOwnerTransformationMatrix
    end function

    ' The owner's position, or the world origin if this drawable has no owner.
    '
    ' @return {BGE.Math.Vector}
    function getOwnerPosition() as BGE.Math.Vector
      if invalid <> m.owner
        return m.owner.position
      end if
      return BGE.Math.VectorOps.create(0, 0, 0)
    end function

    ' The owner's rotation, or no rotation if this drawable has no owner.
    '
    ' @return {BGE.Math.Vector}
    function getOwnerRotation() as BGE.Math.Vector
      if invalid <> m.owner
        return m.owner.rotation
      end if
      return BGE.Math.VectorOps.create(0, 0, 0)
    end function

    ' The owner's scale, or a scale of 1 on every axis if this drawable has no owner.
    '
    ' @return {BGE.Math.Vector}
    function getOwnerScale() as BGE.Math.Vector
      if invalid <> m.owner
        return m.owner.scale
      end if
      return BGE.Math.createScaleVector(1)
    end function

    function getSize() as SizeWH
      return {width: m.width, height: m.height}
    end function

    function getDrawnSize() as SizeWH
      return {width: m.width * m.scale.x, height: m.height * m.scale.y}
    end function

    function getWorldPosition() as BGE.Math.Vector
      return BGE.Math.Matrix44.multVecMatrix(m.offset, m.getOwnerTransformationMatrix())
    end function

    function getPretranslation() as BGE.Math.Vector
      return BGE.Math.VectorOps.create(-m.width * m.anchor.x, -m.height * m.anchor.y)
    end function

    function getFillColorRGBA(ignoreColor = false as boolean) as integer
      rgba = BGE.Colors.White
      if not ignoreColor and invalid <> m.color
        rgba = (m.getDisplayColor() << 8) + int(m.alpha)
      end if
      return rgba
    end function

    ' Tints this drawable with `color` (RGB, like `color`) for `seconds`, then goes back to
    ' its own `color`. `color` itself is never touched, so it can keep changing during the
    ' flash and is what shows afterwards. Flashing again restarts the flash.
    '
    ' The owning entity's flashes tick with the game, just before its onUpdate(), and pause
    ' with it. A drawable with no owner must call tickFlash() itself.
    '
    ' @param {integer} color - RGB flash color, e.g. &hFF5050
    ' @param {float} seconds - how long the flash lasts
    ' @param {float} [blinkSeconds=0] - if above 0, alternates between the flash color and the drawable's own color this often
    sub flash(color as integer, seconds as float, blinkSeconds = 0.0 as float)
      m.flashColor = color
      m.flashSeconds = seconds
      m.flashElapsed = 0.0
      m.flashBlinkSeconds = blinkSeconds
      if seconds > 0 and invalid <> m.owner
        m.owner.hasActiveFlash = true
      end if
    end sub

    ' Ends any flash now.
    sub stopFlash()
      m.flashSeconds = 0.0
      m.flashElapsed = 0.0
    end sub

    ' Whether a flash() is still running.
    '
    ' @return {boolean}
    function isFlashing() as boolean
      return m.flashElapsed < m.flashSeconds
    end function

    ' Advances a running flash. The engine calls this for drawables on an entity.
    '
    ' @param {float} dt - seconds
    ' @return {boolean} true while the flash is still running
    function tickFlash(dt as float) as boolean
      if not m.isFlashing()
        return false
      end if
      m.flashElapsed += dt
      if m.isFlashing()
        return true
      end if
      m.stopFlash()
      return false
    end function

    ' The RGB color drawn this frame: the flash color while flashing (and on a blink's
    ' "on" phase), otherwise `color`.
    '
    ' @return {integer}
    function getDisplayColor() as integer
      if not m.isFlashing()
        return m.color
      end if
      if m.flashBlinkSeconds > 0 and (int(m.flashElapsed / m.flashBlinkSeconds) mod 2) = 1
        return m.color
      end if
      return m.flashColor
    end function


    function getOutlineColorRGBA(ignoreColor = false as boolean) as integer
      rgba = m.getFillColorRGBA(ignoreColor)
      if not ignoreColor and invalid <> m.outlineRGBA
        rgba = (m.outlineRGBA << 8) + int(m.alpha)
      end if
      return rgba
    end function


    ' Whether this drawable should be stroked with an outline, which is the case once
    ' `outlineRGBA` has been given a color. Setting `outlineRGBA` is what turns outline
    ' drawing on - there is no separate flag - so this is the check the renderer uses to
    ' skip all outline work for the (common) drawables that don't want one.
    '
    ' @return {boolean} true if an outline should be drawn for this drawable
    function hasOutline() as boolean
      return invalid <> m.outlineRGBA
    end function

    protected function getSceneObjectName(extraBit = "" as string) as string
      ownerName = "noOwner"
      if invalid <> m.owner
        ownerName = m.owner.name
      end if
      return `${ownerName}_${m.name}_${extraBit}`
    end function

    protected function addSceneObjectToRenderer(sceneObj as SceneObject, renderer as Renderer) as SceneObject
      sceneObj.drawable = m
      renderer.addSceneObject(sceneObj)
      m.sceneObjects[sceneObj.id] = sceneObj
      return sceneObj
    end function

    protected sub drawRegionToCanvas(region as ifDraw2d, additionalRotation = invalid as BGE.Math.Vector, ignoreColor = false as boolean, drawTo = invalid as ifDraw2D)
      position = m.getWorldPosition()
      x = position.x
      y = position.y
      rgba = m.getFillColorRGBA(ignoreColor)
      totalRotation = m.rotation.z
      if invalid <> additionalRotation
        totalRotation = BGE.Math.VectorOps.add(additionalRotation, m.rotation).z
      end if
      game = m.getGame()
      if invalid = game
        return
      end if
      if invalid <> drawTo
        game.canvas.renderer.drawRegionTo(drawTo, region, x, y, m.scale.x, m.scale.y, -totalRotation, rgba)
      else
        game.canvas.renderer.drawRegion(region, x, y, m.scale.x, m.scale.y, -totalRotation, rgba)
      end if
    end sub


    sub forEachSceneObject(operation as function, context as roAssociativeArray)
      for each item in m.sceneObjects.items()
        operation(item.value as SceneObject, context)
      end for
    end sub

    ' The most visible state among this drawable's scene objects, in the order visible >
    ' occluded > offCamera > unknown, as of the last frame. unknown before it has been added
    ' to a renderer. See GameEntity.getVisibility().
    '
    ' @return {BGE.VisibilityState}
    function getVisibility() as BGE.VisibilityState
      result = BGE.VisibilityState.unknown
      for each id in m.sceneObjects
        state = (m.sceneObjects[id] as SceneObject).getVisibility()
        if state = BGE.VisibilityState.visible
          return state
        end if
        if state > result
          result = state
        end if
      end for
      return result
    end function

  end class


end namespace
