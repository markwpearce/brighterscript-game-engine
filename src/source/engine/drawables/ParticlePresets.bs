import "../../math/vector.bs"
import "../../math/math.bs"
import "DrawableParticles.bs"
import "ParticleBurstPool.bs"

namespace BGE

  ' Options for BGE.ParticlePresets. Every field is optional.
  interface ParticlePresetOptions extends roAssociativeArray
    ' World units per metre: preset sizes, speeds and gravity are in metres. Default 1.
    optional unitsPerMetre as float
    ' True for a 2D game whose y grows downward: lift and gravity then point the other way.
    optional yDown as boolean
  end interface

end namespace

' Ready-made BGE.ParticleBurstStyle values for BGE.ParticleBurstPool.play(): blood and sparks
' for melee hits. Each returns a fresh style, so change any field before playing it.
'
' @example
' style = BGE.ParticlePresets.blood(&h8A1010, {unitsPerMetre: 32})
' style.count = 30
' m.bursts.play(hitPoint, awayFromAttacker, style)
namespace BGE.ParticlePresets

  ' A spray of blood (or bone dust, slime: whatever `color`) for a hit that lands: 18 squares
  ' sized in world units, flung up and falling back.
  '
  ' @param {integer} [color=&h8A1010] - RGB
  ' @param {BGE.ParticlePresetOptions} [options={}]
  ' @return {BGE.ParticleBurstStyle}
  function blood(color = &h8A1010 as integer, options = {} as BGE.ParticlePresetOptions) as BGE.ParticleBurstStyle
    return BGE.ParticlePresets.inUnits({
      shape: BGE.ParticleShape.Rectangle,
      count: 18,
      startColor: color,
      endColor: color,
      startSize: 0.065,
      endSize: 0.02,
      sizeInWorldUnits: true,
      lifetime: 0.4,
      lifetimeSpread: 0.1,
      speed: 2.45,
      speedSpread: 1.05,
      lift: 1.625,
      liftSpread: 0.875,
      spreadRadians: BGE.Math.PI * 0.35,
      acceleration: BGE.Math.VectorOps.create(0, -12, 0)
    }, options)
  end function

  ' A few short-lived sparks, e.g. a blocked hit: steel on steel.
  '
  ' @param {BGE.ParticlePresetOptions} [options={}]
  ' @return {BGE.ParticleBurstStyle}
  function blockSparks(options = {} as BGE.ParticlePresetOptions) as BGE.ParticleBurstStyle
    return BGE.ParticlePresets.inUnits({
      shape: BGE.ParticleShape.Line,
      count: 8,
      startColor: &hFFF0C0,
      endColor: &hFF8020,
      startSize: 0.12,
      endSize: 0.04,
      lifetime: 0.2,
      lifetimeSpread: 0.05,
      speed: 3.5,
      speedSpread: 1.5,
      lift: 1.3,
      liftSpread: 0.7,
      spreadRadians: BGE.Math.PI * 0.5,
      acceleration: BGE.Math.VectorOps.create(0, -8, 0)
    }, options)
  end function

  ' A bigger, brighter shower of sparks than blockSparks(), e.g. a parry.
  '
  ' @param {BGE.ParticlePresetOptions} [options={}]
  ' @return {BGE.ParticleBurstStyle}
  function parrySparks(options = {} as BGE.ParticlePresetOptions) as BGE.ParticleBurstStyle
    return BGE.ParticlePresets.inUnits({
      shape: BGE.ParticleShape.Line,
      count: 22,
      startColor: &hFFFFFF,
      endColor: &hFFB030,
      startSize: 0.3,
      endSize: 0.05,
      lifetime: 0.32,
      lifetimeSpread: 0.08,
      speed: 4.9,
      speedSpread: 2.1,
      lift: 1.95,
      liftSpread: 1.05,
      spreadRadians: BGE.Math.PI * 0.8,
      acceleration: BGE.Math.VectorOps.create(0, -8, 0)
    }, options)
  end function

  ' Scales a style authored in metres to world units, flipping its up direction for yDown.
  function inUnits(style as BGE.ParticleBurstStyle, options as BGE.ParticlePresetOptions) as BGE.ParticleBurstStyle
    scale = options.unitsPerMetre ?? 1.0
    up = scale
    if options.yDown = true
      up = -scale
    end if
    style.startSize *= scale
    style.endSize *= scale
    style.speed *= scale
    style.speedSpread *= scale
    style.lift *= up
    style.liftSpread *= scale
    style.acceleration = BGE.Math.VectorOps.scale(style.acceleration, up)
    return style
  end function

end namespace
