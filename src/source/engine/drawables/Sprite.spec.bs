namespace tests

  @suite("BGE.Sprite")
  class SpriteTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    spriteSheet as roBitmap
    sprite as BGE.Sprite

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      ' 3 cells, 10x10 each, laid out in a single row.
      m.spriteSheet = CreateObject("roBitmap", {width: 30, height: 10, alphaEnable: true})
      m.sprite = new BGE.Sprite(m.entity, m.spriteSheet, 10, 10)
      m.sprite.addAnimation("idle", {startFrame: 0, frameCount: 3}, 10, BGE.SpritePlayMode.Loop)
      m.sprite.addAnimation("dead", {startFrame: 0, frameCount: 3}, 10, BGE.SpritePlayMode.Forward)
    end function

    @describe("playAnimation")

    @it("resets the animation clock when switching to a different animation")
    function _()
      m.sprite.playAnimation("idle")
      ' Simulate this sprite having already been alive/animating for 5 real seconds -
      ' far past "dead"'s own 300ms (3 frames @ 10fps) duration, which is exactly the
      ' scenario a long-lived entity (e.g. Player) hits switching to a one-shot
      ' animation well after spawning.
      m.sprite.advanceAnimationClockForTests(5000)
      m.assertTrue(m.sprite.rawAnimationClockMsForTests() >= 5000, "advanceAnimationClockForTests should have fast-forwarded the clock")

      m.sprite.playAnimation("dead")

      ' The clock must have been reset back near 0 by the switch - not left at the
      ' stale ~5000ms reading, which is far past "dead"'s 300ms duration and would make
      ' getCellDrawIndex() (exercised below via update()/index) clamp straight to the
      ' last frame instead of playing through from the first.
      m.assertTrue(m.sprite.rawAnimationClockMsForTests() < 300, "expected the animation clock to reset on switching to a different animation, got " + m.sprite.rawAnimationClockMsForTests().toStr() + "ms")

      ' Confirms the user-visible effect too, not just the raw clock: a fresh Forward
      ' one-shot should read as its first frame, not frozen on its last.
      m.sprite.update()
      m.assertEqual(0, m.sprite.index)
    end function

    @it("does not reset the animation clock when playAnimation is called again with the same already-playing animation")
    function _()
      ' Mirrors examples/pixels' WalkerEntity, which calls playAnimation() with the same
      ' name every single frame regardless of whether it actually changed - an
      ' unconditional reset here would restart that animation's phase every frame.
      m.sprite.playAnimation("idle")
      m.sprite.advanceAnimationClockForTests(5000)

      m.sprite.playAnimation("idle")

      m.assertTrue(m.sprite.rawAnimationClockMsForTests() >= 5000, "re-playing the same animation name should not reset the clock, got " + m.sprite.rawAnimationClockMsForTests().toStr() + "ms")
    end function

    @describe("PingPong play mode")

    @it("plays forward, then back down to the first frame, then repeats")
    function _()
      ' 3 frames @ 10fps: 300ms each way, a 600ms round trip.
      m.sprite.addAnimation("bounce", [0, 1, 2], 10, BGE.SpritePlayMode.PingPong)
      m.sprite.playAnimation("bounce")

      expected = [
        {atMs: 0, index: 0},
        {atMs: 150, index: 1},
        {atMs: 300, index: 2},
        {atMs: 450, index: 1},
        {atMs: 570, index: 0},
        {atMs: 750, index: 1},
        {atMs: 900, index: 2}
      ]
      elapsedMs = 0
      for each sample in expected
        m.sprite.advanceAnimationClockForTests(sample.atMs - elapsedMs)
        elapsedMs = sample.atMs
        m.sprite.update()
        m.assertEqual(sample.index, m.sprite.index, "wrong frame at " + sample.atMs.toStr() + "ms")
      end for
    end function

    @it("keeps its phase after a clock jump of several round trips")
    function _()
      m.sprite.addAnimation("bounce", [0, 1, 2], 10, BGE.SpritePlayMode.PingPong)
      m.sprite.playAnimation("bounce")

      ' 10 round trips + 450ms: on the way back down.
      m.sprite.advanceAnimationClockForTests(6450)
      m.sprite.update()

      m.assertEqual(1, m.sprite.index)
      m.assertTrue(m.sprite.rawAnimationClockMsForTests() < 600, "expected the clock to wrap by whole round trips, got " + m.sprite.rawAnimationClockMsForTests().toStr() + "ms")
    end function

    @describe("addAnimation")

    @it("accepts a raw integer[] frameList (not just the {startFrame, frameCount} AA form) and stores it unchanged")
    function _()
      ' Regression test for a real-hardware-only crash (issue #104):
      ' SpriteAnimation.setFrameList() used to dot-access frameList.startFrame before
      ' checking rodash.isArray(frameList), which throws a runtime error on a real
      ' integer[] on real Roku devices (headless brs-cli did not catch it).
      ' DrawableOrientedSprite is the only caller in the repo that passes a raw array
      ' here instead of an AA - every other example uses {startFrame, frameCount}.
      anim = m.sprite.addAnimation("raw", [0, 1, 2], 10)

      m.assertEqual([0, 1, 2], anim.frameList)
    end function

    @describe("multiple sprite sheets")

    @it("keeps a single sheet as spriteSheet and the only entry of spriteSheets")
    function _()
      m.assertEqual(1, m.sprite.spriteSheets.Count())
      m.assertEqual(30, m.sprite.spriteSheet.GetWidth())
      m.assertEqual(3, m.sprite.getAnimationsDebugInfo().totalRegions)
    end function

    @it("numbers cells across sheets in order")
    function _()
      ' sheet 0: 2x1 cells, sheet 1: 2x2 cells
      sheetA = CreateObject("roBitmap", {width: 20, height: 10, alphaEnable: true})
      sheetB = CreateObject("roBitmap", {width: 20, height: 20, alphaEnable: true})
      sprite = new BGE.Sprite(m.entity, [sheetA, sheetB], 10, 10)

      m.assertEqual(2, sprite.spriteSheets.Count())
      ' spriteSheet stays the first sheet
      m.assertEqual(10, sprite.spriteSheet.GetHeight())
      m.assertEqual(6, sprite.getAnimationsDebugInfo().totalRegions)
      ' frame 2 is sheet 1's first cell; frame 5 its last
      m.assertEqual({frameIndex: 2, sheetIndex: 1, x: 0, y: 0, width: 10, height: 10}, sprite.getFrameRegionDebugInfo(2))
      m.assertEqual({frameIndex: 5, sheetIndex: 1, x: 10, y: 10, width: 10, height: 10}, sprite.getFrameRegionDebugInfo(5))
      m.assertEqual({frameIndex: 1, sheetIndex: 0, x: 10, y: 0, width: 10, height: 10}, sprite.getFrameRegionDebugInfo(1))
    end function

    @it("plays an animation spanning two sheets")
    function _()
      sheetA = CreateObject("roBitmap", {width: 20, height: 10, alphaEnable: true})
      sheetB = CreateObject("roBitmap", {width: 20, height: 10, alphaEnable: true})
      sprite = new BGE.Sprite(m.entity, [sheetA, sheetB], 10, 10)
      sprite.addAnimation("walk", {startFrame: 1, frameCount: 2}, 10, BGE.SpritePlayMode.Forward)
      sprite.playAnimation("walk")
      sprite.advanceAnimationClockForTests(1000)
      sprite.update()

      m.assertEqual(2, sprite.index)
    end function

    @it("survives an empty sheet list")
    function _()
      sprite = new BGE.Sprite(m.entity, [], 10, 10)
      info = sprite.getAnimationsDebugInfo()
      m.assertEqual(0, info.totalRegions)
      m.assertEqual(0, info.spriteSheets.Count())
    end function

    @it("lists every sheet in the debug info")
    function _()
      sheetA = CreateObject("roBitmap", {width: 20, height: 10, alphaEnable: true})
      sheetB = CreateObject("roBitmap", {width: 30, height: 20, alphaEnable: true})
      sprite = new BGE.Sprite(m.entity, [sheetA, sheetB], 10, 10)
      info = sprite.getAnimationsDebugInfo()

      m.assertEqual(8, info.totalRegions)
      m.assertEqual(2, info.spriteSheets.Count())
      m.assertEqual({width: 20, height: 10, columns: 2, rows: 1, firstFrame: 0}, info.spriteSheets[0])
      m.assertEqual({width: 30, height: 20, columns: 3, rows: 2, firstFrame: 2}, info.spriteSheets[1])
    end function

  end class

end namespace
