namespace tests

  @suite("BGE.Sprite")
  class SpriteTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    spriteSheet as roBitmap
    sprite as BGE.Sprite

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      ' 3 cells, 10x10 each, laid out in a single row.
      m.spriteSheet = CreateObject("roBitmap", {width: 30, height: 10, alphaEnable: true})
      m.sprite = new BGE.Sprite(m.entity, m.spriteSheet, 10, 10)
      m.sprite.addAnimation("idle", {startFrame: 0, frameCount: 3}, 10, BGE.SpritePlayMode.Loop)
      m.sprite.addAnimation("dead", {startFrame: 0, frameCount: 3}, 10, BGE.SpritePlayMode.Forward)
    end function

    @describe("playAnimation")

    @it("resets the animation clock when switching to a different animation")
    function _()
      m.sprite.playAnimation("idle")
      ' Simulate this sprite having already been alive/animating for 5 real seconds -
      ' far past "dead"'s own 300ms (3 frames @ 10fps) duration, which is exactly the
      ' scenario a long-lived entity (e.g. Player) hits switching to a one-shot
      ' animation well after spawning.
      m.sprite.advanceAnimationClockForTests(5000)
      m.assertTrue(m.sprite.rawAnimationClockMsForTests() >= 5000, "advanceAnimationClockForTests should have fast-forwarded the clock")

      m.sprite.playAnimation("dead")

      ' The clock must have been reset back near 0 by the switch - not left at the
      ' stale ~5000ms reading, which is far past "dead"'s 300ms duration and would make
      ' getCellDrawIndex() (exercised below via update()/index) clamp straight to the
      ' last frame instead of playing through from the first.
      m.assertTrue(m.sprite.rawAnimationClockMsForTests() < 300, "expected the animation clock to reset on switching to a different animation, got " + m.sprite.rawAnimationClockMsForTests().toStr() + "ms")

      ' Confirms the user-visible effect too, not just the raw clock: a fresh Forward
      ' one-shot should read as its first frame, not frozen on its last.
      m.sprite.update()
      m.assertEqual(0, m.sprite.index)
    end function

    @it("does not reset the animation clock when playAnimation is called again with the same already-playing animation")
    function _()
      ' Mirrors examples/pixels' WalkerEntity, which calls playAnimation() with the same
      ' name every single frame regardless of whether it actually changed - an
      ' unconditional reset here would restart that animation's phase every frame.
      m.sprite.playAnimation("idle")
      m.sprite.advanceAnimationClockForTests(5000)

      m.sprite.playAnimation("idle")

      m.assertTrue(m.sprite.rawAnimationClockMsForTests() >= 5000, "re-playing the same animation name should not reset the clock, got " + m.sprite.rawAnimationClockMsForTests().toStr() + "ms")
    end function

  end class

end namespace
