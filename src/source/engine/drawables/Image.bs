namespace BGE

  ' Used to draw a bitmap image to the screen
  class Image extends BGE.Drawable


    ' An optional unique name for the region, used for caching image data. If not provided, the name of the drawable will be used as the region name.
    public regionId as string = ""

    ' -------------Never To Be Manually Changed-----------------
    ' These values should never need to be manually changed.
    public region as roRegion

    sub new(owner as BGE.GameEntity, region as roRegion, args = {} as roAssociativeArray)
      super(owner, args)
      m.region = region
      if m.region <> invalid
        m.width = m.region.getWidth()
        m.height = m.region.getHeight()
      end if
      ' bs:disable-next-line: 1140
      m.append(args)
    end sub

    override function getPretranslation() as BGE.Math.Vector
      return BGE.Math.VectorOps.create(m.region.GetPretranslationX(), m.region.GetPretranslationY())
    end function

    override sub setAnchor(x as float, y as float)
      super.setAnchor(x, y)
      m.applyAnchorToRegion()
    end sub

    ' Pushes the anchor-derived pretranslation onto the region so Roku's own DrawObject/
    ' DrawScaledObject picks it up natively in the plain 2D draw path - see
    ' getPretranslation(), which reads it straight back off the region.
    protected sub applyAnchorToRegion()
      if m.anchorIsSet and invalid <> m.region
        m.region.SetPretranslation(-m.width * m.anchor.x, -m.height * m.anchor.y)
      end if
    end sub


    override function addToScene(rendererObj as Renderer) as BGE.SceneObject
      return m.addSceneObjectToRenderer(new BGE.SceneObjectImage(m.getSceneObjectName("image"), m as Image), rendererObj)
    end function


  end class
end namespace
