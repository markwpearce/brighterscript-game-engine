import "../../math/vector.bs"
import "../Game.bs"
import "../GameEntity.bs"
import "DrawableParticles.bs"

namespace BGE

  ' What one ParticleBurstPool.play() burst looks like. Random spreads are +/- around the value.
  interface ParticleBurstStyle extends roAssociativeArray
    shape as BGE.ParticleShape
    count as integer
    ' RGB (0xRRGGBB), over each particle's life
    startColor as integer
    endColor as integer
    ' 0-255; default 255 to 0, so particles fade out
    optional startAlpha as float
    optional endAlpha as float
    ' See DrawableParticles.startSize
    startSize as float
    endSize as float
    ' Seconds
    lifetime as float
    optional lifetimeSpread as float
    ' Cone around the play() direction; see DrawableParticles.burstCone()
    spreadRadians as float
    speed as float
    optional speedSpread as float
    optional lift as float
    optional liftSpread as float
    ' Constant acceleration, e.g. gravity (0, -500, 0)
    optional acceleration as BGE.Math.Vector
  end interface

  ' Plays one-shot particle bursts anywhere in the world (hits, sparks, dust) from a small pool
  ' of emitters, so a burst doesn't create an entity, emitter and scene object each time. An
  ' emitter is reused once its particles have faded. Add one to the game, e.g. in a scene's
  ' onCreate():
  '
  '   m.bursts = m.game.addEntity(new BGE.ParticleBurstPool(m.game)) as BGE.ParticleBurstPool
  '   m.bursts.play(hitPoint, swingDirection, bloodStyle)
  class ParticleBurstPool extends GameEntity

    ' Most emitters it will make. When all are busy, play() drops the burst.
    maxEmitters as integer = 16

    protected emitters as BGE.DrawableParticles[] = []

    sub new(game as BGE.Game, args = {} as roAssociativeArray)
      super(game, args)
      if invalid = args.name
        m.name = "ParticleBurstPool"
      end if
    end sub

    ' Sprays a burst at `position`, in a cone around `direction`.
    '
    ' @param {BGE.Math.Vector} position - world space
    ' @param {BGE.Math.Vector} direction - centre of the cone
    ' @param {BGE.ParticleBurstStyle} style
    ' @return {BGE.DrawableParticles} the emitter used, or invalid if every emitter was busy
    function play(position as BGE.Math.Vector, direction as BGE.Math.Vector, style as BGE.ParticleBurstStyle) as BGE.DrawableParticles
      emitter = m.idleEmitter()
      if invalid = emitter
        return invalid
      end if
      emitter.shape = style.shape
      emitter.startColor = style.startColor
      emitter.endColor = style.endColor
      emitter.startAlpha = style.startAlpha ?? 255.0
      emitter.endAlpha = style.endAlpha ?? 0.0
      emitter.startSize = style.startSize
      emitter.endSize = style.endSize
      emitter.lifetime = style.lifetime
      emitter.lifetimeSpread = style.lifetimeSpread ?? 0.0
      emitter.acceleration = style.acceleration ?? BGE.Math.VectorOps.create()
      emitter.maxParticles = BGE.Math.Max(emitter.maxParticles, style.count)
      ' The pool never moves, so the offset from it is the emitter's world position
      emitter.offset = BGE.Math.VectorOps.subtract(position, m.position)
      emitter.invalidateGeometry()
      emitter.burstCone(style.count, direction, style.spreadRadians, style.speed, style.speedSpread ?? 0.0, style.lift ?? 0.0, style.liftSpread ?? 0.0)
      return emitter
    end function

    ' How many emitters have live particles.
    '
    ' @return {integer}
    function activeBurstCount() as integer
      count = 0
      for each emitter in m.emitters
        if emitter.particles.Count() > 0
          count++
        end if
      end for
      return count
    end function

    private function idleEmitter() as BGE.DrawableParticles
      for each emitter in m.emitters
        if emitter.particles.Count() = 0
          return emitter
        end if
      end for
      if m.emitters.Count() >= m.maxEmitters
        return invalid
      end if
      emitter = m.addParticles("burst" + m.emitters.Count().toStr(), BGE.ParticleShape.Rectangle)
      if invalid <> emitter
        m.emitters.push(emitter)
      end if
      return emitter
    end function

  end class

end namespace
