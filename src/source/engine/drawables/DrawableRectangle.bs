import "../GameEntity.bs"
import "../renderer/Renderer.bs"
import "../renderer/sceneObjects/SceneObject.bs"
import "../renderer/sceneObjects/SceneObjectRectangle.bs"
import "Drawable.bs"

namespace BGE

  ' Draws a rectangle, filled and/or outlined.
  '
  ' The rectangle's top left corner sits at the drawable's own world position (its `offset`
  ' transformed by the owning entity), extending `width` to the right and `height` downwards
  ' on screen - the same anchoring an `Image` uses, so the two are interchangeable.
  '
  ' In the direct (billboard) draw modes - which is what a 2D game gets, since a `Camera2d`
  ' resolves `matchCamera` to `directToCamera` - this is a plain axis-aligned rectangle.
  ' In the oriented/solid/wireFrame draw modes it becomes a quad that rotates and
  ' foreshortens in 3D like any other billboard (see `examples/3d`'s RectanglesRoom).
  '
  ' Set `color` for the fill and `outlineRGBA` for the outline (both packed RGB, no alpha
  ' byte - `alpha` is separate). Leaving `outlineRGBA` unset means no outline at all; set
  ' `filled = false` for an outline-only rectangle.
  class DrawableRectangle extends Drawable

    ' Whether the rectangle's interior is filled with `color`. Set false for an outline-only
    ' rectangle, which needs `outlineRGBA` set too or nothing is drawn at all.
    filled as boolean = true

    sub new(owner as GameEntity, width as float, height as float, args = {} as roAssociativeArray)
      super(owner, args)
      m.width = width
      m.height = height
      ' bs:disable-next-line: 1140
      m.append(args)
    end sub


    ' Resizes the rectangle. Use this rather than assigning to the inherited width/height,
    ' which are deliberately not public - a resize isn't movement, so it has to tell the
    ' renderer to recompute this drawable's geometry (see `Drawable.invalidateGeometry`).
    '
    ' @param {float} width - new width in world units
    ' @param {float} height - new height in world units
    sub setSize(width as float, height as float)
      if width = m.width and height = m.height
        return
      end if
      m.width = width
      m.height = height
      m.invalidateGeometry()
    end sub


    override function addToScene(rendererObj as Renderer) as BGE.SceneObject
      return m.addSceneObjectToRenderer(new SceneObjectRectangle(m.getSceneObjectName("rectangle"), m), rendererObj)
    end function

  end class

end namespace
