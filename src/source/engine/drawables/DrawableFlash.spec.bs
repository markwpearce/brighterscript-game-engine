import "pkg:/source/engine/Game.bs"
import "pkg:/source/engine/GameEntity.bs"
import "pkg:/source/engine/drawables/Drawable.bs"

namespace tests

  @suite("BGE.Drawable flash")
  class DrawableFlashTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    drawable as BGE.Drawable

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.drawable = new BGE.Drawable(m.entity)
      m.drawable.color = &h00FF00
    end function

    @describe("flash / tickFlash")

    @it("shows the drawable's own color when not flashing")
    function _()
      m.assertFalse(m.drawable.isFlashing())
      m.assertEqual(m.drawable.getDisplayColor(), &h00FF00)
    end function

    @it("draws the flash color without changing color")
    function _()
      m.drawable.flash(&h102030, 0.5)

      m.assertTrue(m.drawable.isFlashing())
      m.assertEqual(m.drawable.getDisplayColor(), &h102030)
      m.assertEqual(m.drawable.getFillColorRGBA(), &h102030FF)
      m.assertEqual(m.drawable.color, &h00FF00)
    end function

    @it("goes back to the current color, even one set during the flash")
    function _()
      m.drawable.flash(&h102030, 0.5)
      m.assertTrue(m.drawable.tickFlash(0.25))
      m.drawable.color = &h0000FF
      m.assertEqual(m.drawable.getDisplayColor(), &h102030)

      m.assertFalse(m.drawable.tickFlash(0.25))
      m.assertFalse(m.drawable.isFlashing())
      m.assertEqual(m.drawable.getDisplayColor(), &h0000FF)
    end function

    @it("restarts when flashed again")
    function _()
      m.drawable.flash(&h102030, 0.5)
      m.drawable.tickFlash(0.25)
      m.drawable.flash(&h302010, 0.5)
      m.assertTrue(m.drawable.tickFlash(0.25))
      m.assertEqual(m.drawable.getDisplayColor(), &h302010)
      m.assertFalse(m.drawable.tickFlash(0.25))
    end function

    @it("stops at once with stopFlash()")
    function _()
      m.drawable.flash(&h102030, 0.5)
      m.drawable.stopFlash()
      m.assertFalse(m.drawable.isFlashing())
      m.assertEqual(m.drawable.getDisplayColor(), &h00FF00)
    end function

    @it("blinks between the flash color and its own color")
    function _()
      m.drawable.flash(&h102030, 1.0, 0.25)
      m.assertEqual(m.drawable.getDisplayColor(), &h102030)
      m.drawable.tickFlash(0.25)
      m.assertEqual(m.drawable.getDisplayColor(), &h00FF00)
      m.drawable.tickFlash(0.25)
      m.assertEqual(m.drawable.getDisplayColor(), &h102030)
    end function

    @describe("ticked by the game")

    @it("ticks an entity's flashes each update until they end")
    function _()
      m.game.addEntity(m.entity)
      m.entity.addDrawable("flashy", m.drawable)
      m.drawable.flash(&h102030, 0.5)
      m.assertTrue(m.entity.hasActiveFlash)

      m.game.processEntityUpdatesForTest(0.25)
      m.assertTrue(m.drawable.isFlashing())
      m.game.processEntityUpdatesForTest(0.25)
      m.assertFalse(m.drawable.isFlashing())
      m.assertFalse(m.entity.hasActiveFlash)
    end function

    @it("holds a flash while the game is paused")
    function _()
      m.game.addEntity(m.entity)
      m.entity.addDrawable("flashy", m.drawable)
      m.drawable.flash(&h102030, 0.5)
      m.game.Pause()

      m.game.processEntityUpdatesForTest(1.0)

      m.assertTrue(m.drawable.isFlashing())
    end function

  end class

end namespace
