import "../../math/math.bs"
import "../../utils/colors.bs"
import "../../utils/strings.bs"
import "../GameEntity.bs"
import "../renderer/Renderer.bs"
import "../renderer/sceneObjects/SceneObject.bs"
import "../renderer/sceneObjects/SceneObjectText.bs"
import "../ui/Alignment.bs"
import "Drawable.bs"

namespace BGE

  const MIN_TEXT_REGION_SIZE = 256

  ' Class to draw text
  class DrawableText extends Drawable

    ' The text to write on the screen
    text as string = ""
    ' The Font object to use ( get this from the font registry)
    font as roFont

    ' The Horizontal alignment for the text
    alignment as BGE.UI.HorizAlignment = BGE.UI.HorizAlignment.left

    ' The color the text is drawn in
    textColor as integer = BGE.Colors.White

    protected lastTextValue as string = ""
    protected lastTextColor as integer = BGE.Colors.White
    protected tempCanvas as roBitmap = invalid
    protected tempRegion as roRegion = invalid
    protected lastAlignment as BGE.UI.HorizAlignment = BGE.UI.HorizAlignment.left

    sub new(owner as GameEntity, text = "" as string, font = invalid as roFont, args = {} as roAssociativeArray) as void
      super(owner, args)
      m.text = text
      m.font = font
      if invalid = m.font
        game = m.getGame()
        if invalid <> game
          m.font = game.getFont("default")
        else
          m.font = CreateObject("roFontRegistry").GetDefaultFont()
        end if
      end if
      ' bs:disable-next-line: 1140
      m.append(args)
      m.getTextImage()
    end sub

    override function addToRenderer(rendererObj as Renderer) as BGE.SceneObject
      return m.addSceneObjectToRenderer(new BGE.SceneObjectText(m.getSceneObjectName("image"), m), rendererObj)
    end function


    ' Replaces this drawable's font and forces the cached text image to be
    ' re-rendered on the next getTextImage() call - a plain assignment to
    ' `font` wouldn't be picked up otherwise, since the cache in
    ' getTextImage() only dirty-checks text/textColor.
    '
    ' @param {roFont} font
    ' @return {void}
    sub setFont(font as roFont)
      m.font = font
      m.shouldRedraw = true
    end sub

    function getTextImage() as roRegion
      if m.text = m.lastTextValue and m.textColor = m.lastTextColor and invalid <> m.tempRegion and not m.shouldRedraw
        return m.tempRegion
      end if
      m.lastTextValue = m.text
      m.lastTextColor = m.textColor
      m.width = m.font.GetOneLineWidth(m.text, 10000)
      m.height = m.font.GetOneLineHeight() * BGE.getNumberOfLinesInAString(m.text)

      if m.tempCanvas = invalid or m.width < m.tempCanvas.GetWidth() or m.height < m.tempCanvas.GetHeight()
        m.tempCanvas = CreateObject("roBitmap", {
          width: BGE.Math.max(m.width + 1, MIN_TEXT_REGION_SIZE),
          height: BGE.Math.max(m.height + 1, MIN_TEXT_REGION_SIZE),
          AlphaEnable: true
        })
      end if
      m.tempRegion = createObject("roRegion", m.tempCanvas, 0, 0, m.width, m.height)
      if invalid = m.tempRegion
        return invalid
      end if
      m.tempRegion.clear(0)
      horizOffset = 0
      if m.alignment = "left"
      else if m.alignment = "center"
        horizOffset = m.width / 2
      else if m.alignment = "right"
        horizOffset = m.width
      end if
      'm.owner.game.canvas.renderer.drawRectangleOutlineTo(m.tempRegion, 0, 0, m.width, m.height, BGE.Colors.RED)
      game = m.getGame()
      if invalid <> game
        game.canvas.renderer.DrawTextTo(m.tempRegion, m.text, horizOffset, 0, m.textColor, m.font, m.alignment)
      else
        ' The region is exactly the text's width, so every alignment lands at x = 0.
        m.tempRegion.DrawText(m.text, 0, 0, m.textColor, m.font)
      end if
      m.shouldRedraw = false
      return m.tempRegion
    end function


    ' alignment is a plain public field, so a direct assignment can't be intercepted - this
    ' dirty-checks it each frame and syncs it into the unified anchor mechanism (see
    ' Drawable.setAnchor), the same idiom this codebase uses for Camera3d.fieldOfViewDegrees.
    override sub update()
      if m.alignment <> m.lastAlignment
        m.lastAlignment = m.alignment
        x = 0.0
        if m.alignment = BGE.UI.HorizAlignment.center
          x = 0.5
        else if m.alignment = BGE.UI.HorizAlignment.right
          x = 1.0
        end if
        m.setAnchor(x, m.getAnchor().y)
      end if
    end sub

  end class

end namespace
