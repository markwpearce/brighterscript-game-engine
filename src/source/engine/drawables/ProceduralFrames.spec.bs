import "pkg:/source/testing/PixelReadback.spec.bs"
import "pkg:/source/engine/drawables/ProceduralFrames.bs"

namespace tests

  @suite("BGE.ProceduralFrames")
  class ProceduralFramesTests extends rooibos.BaseTestSuite

    @describe("flame")

    @it("draws one strip of default-sized frames")
    function _()
      strip = BGE.ProceduralFrames.drawFlameStrip({startColor: &hFFE89A, endColor: &hC02808})
      m.assertEqual(strip.GetWidth(), 24 * 8)
      m.assertEqual(Int(strip.GetHeight()), 48)
    end function

    @it("returns one region per frame, sized by the options")
    function _()
      game = new BGE.Game(320, 240)
      frames = BGE.ProceduralFrames.flame(game, "testFlame", {startColor: &hFFFFFF, endColor: &h0000FF, frameCount: 4, frameWidth: 10, frameHeight: 20})
      m.assertEqual(frames.Count(), 4)
      m.assertEqual(Int(frames[3].GetX()), 30)
      m.assertEqual(Int(frames[0].GetWidth()), 10)
      m.assertEqual(Int(frames[0].GetHeight()), 20)
      m.assertEqual(Int(game.getBitmap("testFlame").GetWidth()), 40)
    end function

    @it("reuses the strip already kept under the name")
    function _()
      game = new BGE.Game(320, 240)
      BGE.ProceduralFrames.flame(game, "testFlame", {startColor: &hFFFFFF, endColor: &h0000FF})
      ' The marker survives: the strip wasn't drawn again
      game.getBitmap("testFlame").DrawRect(0, 0, 1, 1, &h12345678)
      frames = BGE.ProceduralFrames.flame(game, "testFlame", {startColor: &h000000, endColor: &h000000})
      m.assertEqual(frames.Count(), 8)
      m.assertEqual(tests.readPixels(game.getBitmap("testFlame"), 0, 0, 1, 1)[0], &h12)
    end function

    @it("redraws the strip after it was unloaded")
    function _()
      game = new BGE.Game(320, 240)
      BGE.ProceduralFrames.flame(game, "testFlame", {startColor: &hFFFFFF, endColor: &h0000FF})
      game.unloadBitmap("testFlame")
      frames = BGE.ProceduralFrames.flame(game, "testFlame", {startColor: &hFFFFFF, endColor: &h0000FF})
      m.assertEqual(frames.Count(), 8)
      m.assertNotInvalid(game.getBitmap("testFlame"))
    end function

    @it("uses the default drift for an empty drift list")
    function _()
      strip = BGE.ProceduralFrames.drawFlameStrip({startColor: &hFFFFFF, endColor: &h0000FF, drift: []})
      m.assertEqual(strip.GetWidth(), 24 * 8)
    end function

    @it("staggers ages evenly so the loop wraps seamlessly")
    function _()
      m.assertEqual(BGE.ProceduralFrames.loopAge(0, 8, 0, 4), 0.0)
      m.assertTrue(Abs(BGE.ProceduralFrames.loopAge(2, 8, 1, 4) - 0.5) < 0.0001)
      m.assertTrue(Abs(BGE.ProceduralFrames.loopAge(4, 8, 3, 4) - 0.25) < 0.0001)
    end function

  end class

end namespace
