namespace tests

  @suite("BGE.SpriteFrames")
  class SpriteFramesTests extends rooibos.BaseTestSuite

    game as BGE.Game
    entity as BGE.GameEntity
    sheet as roBitmap

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.entity = new BGE.GameEntity(m.game, {name: "TestEntity"})
      m.sheet = CreateObject("roBitmap", {width: 100, height: 60, alphaEnable: true})
    end function

    ' Two trimmed frames out of 40x50 cells
    private function packedFrames() as BGE.SpriteFrames
      return new BGE.SpriteFrames(m.sheet, 0, 0, [
        {x: 10, y: 0, width: 20, height: 30, offsetX: 5, offsetY: 10, sourceWidth: 40, sourceHeight: 50},
        {x: 40, y: 0, width: 30, height: 40, offsetX: 4, offsetY: 6, sourceWidth: 40, sourceHeight: 50}
      ])
    end function

    @describe("grid frames")

    @it("numbers cells row by row, sheet after sheet")
    function _()
      second = CreateObject("roBitmap", {width: 40, height: 20, alphaEnable: true})
      frames = new BGE.SpriteFrames([m.sheet, second], 20, 20)

      m.assertTrue(frames.isGrid())
      m.assertEqual(frames.frameCount(), 15 + 2)
      m.assertEqual(frames.sheetIndexForFrame(14), 0)
      m.assertEqual(frames.sheetIndexForFrame(15), 1)
      m.assertEqual(frames.sheetIndexForFrame(17), -1)
      m.assertEqual(frames.frames[6].x, 20)
      m.assertEqual(frames.frames[6].y, 20)
    end function

    @describe("packed frames")

    @it("fills in defaults for the optional fields")
    function _()
      frames = new BGE.SpriteFrames(m.sheet, 0, 0, [{x: 1, y: 2, width: 3, height: 4}])
      frame = frames.frames[0]

      m.assertFalse(frames.isGrid())
      m.assertEqual(frame.sheet, 0)
      m.assertEqual(frame.offsetX, 0)
      m.assertEqual(frame.sourceWidth, 3)
      m.assertEqual(frame.sourceHeight, 4)
    end function

    @it("pretranslates each frame so the untrimmed cells line up at the anchor")
    function _()
      regions = m.packedFrames().regionsForAnchor(0.5, 1)

      ' anchor at (20, 50) in the cell; frame 0 starts at (5, 10) in it
      m.assertEqual(regions[0].GetPretranslationX(), -15)
      m.assertEqual(regions[0].GetPretranslationY(), -40)
      m.assertEqual(regions[1].GetPretranslationX(), -16)
      m.assertEqual(regions[1].GetPretranslationY(), -44)
      m.assertEqual(regions[1].GetWidth(), 30)
    end function

    @it("builds each anchor's regions once")
    function _()
      frames = m.packedFrames()
      first = frames.regionsForAnchor(0.5, 1)
      first[0].SetPretranslation(99, 99)

      m.assertEqual(frames.regionsForAnchor(0.5, 1)[0].GetPretranslationX(), 99)
      m.assertEqual(frames.regionsForAnchor(0, 0)[0].GetPretranslationX(), 5)
    end function

    @it("reports the largest untrimmed cell")
    function _()
      size = m.packedFrames().getMaxSourceSize()
      m.assertEqual(size.x, 40.0)
      m.assertEqual(size.y, 50.0)
    end function

    @describe("Sprite with SpriteFrames")

    @it("shares regions between sprites with the same anchor, not with a different one")
    function _()
      frames = m.packedFrames()
      a = new BGE.Sprite(m.entity, frames, 0, 0)
      b = new BGE.Sprite(m.entity, frames, 0, 0)
      c = new BGE.Sprite(m.entity, frames, 0, 0)
      a.setAnchor(0.5, 1)
      b.setAnchor(0.5, 1)
      c.setAnchor(0, 0)
      a.addAnimation("only", [0, 1], 10)
      a.playAnimation("only")

      a.region.SetPretranslation(77, 0)
      m.assertEqual(b.region.GetPretranslationX(), 77)
      m.assertEqual(c.region.GetPretranslationX(), 5)
    end function

    @it("draws each packed frame at its own size")
    function _()
      sprite = new BGE.Sprite(m.entity, m.packedFrames(), 0, 0)
      sprite.setAnchor(0.5, 1)
      sprite.addAnimation("only", [1], 10)
      sprite.playAnimation("only")
      sprite.update()

      size = sprite.getSize()
      m.assertEqual(size.width, 30)
      m.assertEqual(size.height, 40)
      m.assertEqual(sprite.getPretranslation().x, -16.0)
      m.assertEqual(sprite.getSheetIndexForFrame(1), 0)
    end function

    @describe("Game.getSpriteFrames")

    @it("returns the same frames for the same bitmap and cell size until it's unloaded")
    function _()
      m.game.loadBitmap("sheet", {width: 40, height: 40, alphaEnable: true})
      first = m.game.getSpriteFrames("sheet", 20, 20)
      first.cellWidth = 21
      m.assertEqual(m.game.getSpriteFrames("sheet", 20, 20).cellWidth, 21)
      m.assertEqual(m.game.getSpriteFrames("sheet", 10, 10).cellWidth, 10)

      m.game.loadBitmap("sheet", {width: 40, height: 40, alphaEnable: true})
      m.assertEqual(m.game.getSpriteFrames("sheet", 20, 20).cellWidth, 20)

      m.game.unloadBitmap("sheet")
      m.assertInvalid(m.game.getSpriteFrames("sheet", 20, 20))
    end function

  end class

end namespace
