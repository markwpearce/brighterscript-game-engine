namespace tests

  @suite("BGE.ParticleBurstPool")
  class ParticleBurstPoolTests extends rooibos.BaseTestSuite

    game as BGE.Game
    pool as BGE.ParticleBurstPool

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
      m.pool = new BGE.ParticleBurstPool(m.game)
      m.game.addEntity(m.pool)
    end function

    private function style() as BGE.ParticleBurstStyle
      return {
        shape: BGE.ParticleShape.Line,
        count: 6,
        startColor: &hFF0000,
        endColor: &h800000,
        startSize: 4,
        endSize: 1,
        lifetime: 0.5,
        spreadRadians: 0.4,
        speed: 80,
        acceleration: BGE.Math.VectorOps.create(0, -200, 0)
      }
    end function

    @describe("play")

    @it("spawns the burst at the given world position with the style's settings")
    function _()
      position = BGE.Math.VectorOps.create(100, 20, -50)
      emitter = m.pool.play(position, BGE.Math.VectorOps.create(1, 0, 0), m.style())

      m.assertEqual(emitter.particles.Count(), 6)
      m.assertEqual(emitter.shape, BGE.ParticleShape.Line)
      m.assertEqual(emitter.acceleration.y, -200.0)
      ' fades out by default
      m.assertEqual(emitter.endAlpha, 0.0)
      first = emitter.particles[0].position
      m.assertTrue(Abs(first.x - 100) < 0.01 and Abs(first.y - 20) < 0.01 and Abs(first.z + 50) < 0.01, "spawned at the wrong place")
    end function

    @it("reuses an emitter once its particles have gone")
    function _()
      first = m.pool.play(BGE.Math.VectorOps.create(), BGE.Math.VectorOps.create(1, 0, 0), m.style())
      first.particles.Clear()
      second = m.pool.play(BGE.Math.VectorOps.create(10, 0, 0), BGE.Math.VectorOps.create(1, 0, 0), m.style())

      m.assertEqual(second.name, first.name)
      m.assertEqual(m.pool.activeBurstCount(), 1)
    end function

    @it("uses another emitter while one is busy, and drops bursts past maxEmitters")
    function _()
      m.pool.maxEmitters = 2
      first = m.pool.play(BGE.Math.VectorOps.create(), BGE.Math.VectorOps.create(1, 0, 0), m.style())
      second = m.pool.play(BGE.Math.VectorOps.create(), BGE.Math.VectorOps.create(1, 0, 0), m.style())
      third = m.pool.play(BGE.Math.VectorOps.create(), BGE.Math.VectorOps.create(1, 0, 0), m.style())

      m.assertNotEqual(second.name, first.name)
      m.assertInvalid(third)
      m.assertEqual(m.pool.activeBurstCount(), 2)
    end function

  end class

end namespace
