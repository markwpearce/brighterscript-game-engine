import "../../math/math.bs"
import "../../utils/colors.bs"
import "../Game.bs"

namespace BGE

  ' How BGE.ProceduralFrames.flame() draws a flame. Only the colours are required.
  interface FlameFrameOptions extends roAssociativeArray
    ' RGB: each square cools from startColor to endColor as it rises
    startColor as integer
    endColor as integer
    ' Default 8
    optional frameCount as integer
    ' Pixels per frame; default 24 x 48
    optional frameWidth as integer
    optional frameHeight as integer
    ' Squares in flight at once; default 6
    optional squareCount as integer
    ' Pixels, at birth and at the top; default 16 and 5
    optional startSize as float
    optional endSize as float
    ' 0-255 at birth, fading out as each square rises; default 250
    optional startAlpha as float
    ' Sideways drift of each square, as a fraction of how far it has risen (repeats when there
    ' are more squares); a gentle sway by default
    optional drift as float[]
  end interface

end namespace

' Animation frames drawn in code instead of loaded from art.
namespace BGE.ProceduralFrames

  ' A looping flame: squares that rise, shrink, fade and cool from startColor to endColor,
  ' staggered so the loop is seamless. The strip is drawn once and kept in the game under
  ' `bitmapName`; later calls with that name reuse it and ignore the colours, so use one name
  ' per look (and the same frame sizes). Play the frames with GameEntity.addAnimatedImage(), unshaded, anchored at the
  ' bottom; one loop of 560 ms suits the defaults.
  '
  ' @example
  ' frames = BGE.ProceduralFrames.flame(m.game, "torchFlame", {startColor: &hFFE89A, endColor: &hC02808})
  ' image = m.addAnimatedImage("flame", frames, {drawMode: BGE.SceneObjectDrawMode.axisAligned, animationDurationMs: 560})
  ' image.setAnchor(0.5, 1)
  '
  ' @param {BGE.Game} game - keeps the strip bitmap
  ' @param {string} bitmapName
  ' @param {BGE.FlameFrameOptions} options
  ' @return {roRegion[]} one region per frame, in order
  function flame(game as BGE.Game, bitmapName as string, options as BGE.FlameFrameOptions) as roRegion[]
    options = BGE.ProceduralFrames.flameDefaults(options)
    ' Looked up directly, as getBitmap() warns when it's missing; unloadBitmap() leaves invalid
    strip = game.Bitmaps[bitmapName]
    if invalid = strip
      strip = BGE.ProceduralFrames.drawFlameStrip(options)
      game.loadBitmap(bitmapName, strip)
    end if
    frames = [] as roRegion[]
    for i = 0 to options.frameCount - 1
      frames.push(CreateObject("roRegion", strip, i * options.frameWidth, 0, options.frameWidth, options.frameHeight))
    end for
    return frames
  end function

  ' Draws flame()'s strip without caching it: every frame side by side, left to right.
  '
  ' @param {BGE.FlameFrameOptions} options
  ' @return {roBitmap} frameCount * frameWidth wide
  function drawFlameStrip(options as BGE.FlameFrameOptions) as roBitmap
    options = BGE.ProceduralFrames.flameDefaults(options)
    frameCount = options.frameCount
    width = options.frameWidth
    height = options.frameHeight
    count = options.squareCount
    startSize = options.startSize
    endSize = options.endSize
    startAlpha = options.startAlpha
    drift = options.drift
    ' Written straight, not blended, so the frame keeps its own alpha
    strip = CreateObject("roBitmap", {width: width * frameCount, height: height, AlphaEnable: false})
    strip.Clear(0)
    for frame = 0 to frameCount - 1
      originX = frame * width + width / 2
      ' oldest first, so the young bright squares at the base end up on top
      for k = 0 to count - 1
        age = BGE.ProceduralFrames.loopAge(frame, frameCount, count - 1 - k, count)
        size = startSize + (endSize - startSize) * age
        rise = age * (height - startSize)
        x = originX + drift[k mod drift.Count()] * rise - size / 2
        y = height - 2 - rise - size
        color = BGE.lerpColorRGB(options.startColor, options.endColor, age)
        alpha = Int(startAlpha * (1 - age * age))
        strip.DrawRect(Int(x), Int(y), Int(size), Int(size), (color << 8) + alpha)
      end for
    end for
    strip.Finish()
    return strip
  end function

  ' A copy of `options` with every unset field at its default.
  '
  ' @param {BGE.FlameFrameOptions} options
  ' @return {BGE.FlameFrameOptions}
  function flameDefaults(options as BGE.FlameFrameOptions) as BGE.FlameFrameOptions
    drift = options.drift
    if invalid = drift or drift.Count() = 0
      drift = [-0.18, 0.12, -0.05, 0.2, -0.14, 0.07]
    end if
    return {
      startColor: options.startColor,
      endColor: options.endColor,
      frameCount: options.frameCount ?? 8,
      frameWidth: options.frameWidth ?? 24,
      frameHeight: options.frameHeight ?? 48,
      squareCount: options.squareCount ?? 6,
      startSize: options.startSize ?? 16.0,
      endSize: options.endSize ?? 5.0,
      startAlpha: options.startAlpha ?? 250.0,
      drift: drift
    }
  end function

  ' How far through its life (0-1) item `index` of `count` is in `frame` of `frameCount`: each
  ' lives one loop, the items a fraction of a life apart, so the loop is seamless.
  '
  ' @param {integer} frame
  ' @param {integer} frameCount
  ' @param {integer} index
  ' @param {integer} count
  ' @return {float}
  function loopAge(frame as integer, frameCount as integer, index as integer, count as integer) as float
    age = frame / frameCount + index / count
    return age - Int(age)
  end function

end namespace
