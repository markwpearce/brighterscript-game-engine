import "../../math/vector.bs"
import "../renderer/cameras/Camera3d.bs"
import "../renderer/gridWalls/GridWallsMap.bs"
import "../renderer/Renderer.bs"
import "../renderer/sceneObjects/SceneObjectWalls.bs"
import "DrawableGridWalls.bs"

namespace tests

  @suite("BGE.DrawableGridWalls")
  class DrawableGridWallsTests extends rooibos.BaseTestSuite

    private game as BGE.Game
    private renderer as BGE.Renderer
    private map as BGE.GridWallsMap
    private textureBitmap as roBitmap

    protected override sub beforeEach()
      m.game = new BGE.Game(320, 240)
      bitmap = CreateObject("roBitmap", {width: 320, height: 240, alphaEnable: true})
      m.renderer = new BGE.Renderer(bitmap, m.game, new BGE.Camera3d())
      m.map = new BGE.GridWallsMap(["###", "#.#", "###"], {
        cellSize: 4.0,
        wallHeight: 4.0,
        origin: BGE.Math.VectorOps.create(-6, 0, -6),
        solid: {"#": "stone"}
      })
      m.textureBitmap = CreateObject("roBitmap", {width: 32, height: 24, alphaEnable: true})
    end sub

    ' Two open cells with a wall between, 8 units each: 8 wall runs
    private function bigMap() as BGE.GridWallsMap
      return new BGE.GridWallsMap(["#####", "#.#.#", "#####"], {
        cellSize: 8.0,
        wallHeight: 4.0,
        origin: BGE.Math.VectorOps.create(-20, 0, -12),
        solid: {"#": "stone"}
      })
    end function

    private function region(x as integer, width as integer) as roRegion
      return CreateObject("roRegion", m.textureBitmap, x, 0, width, 24)
    end function

    @describe("new")

    @it("keeps the map and textures and applies args")
    function _()
      textures = {stone: m.region(0, 16)}
      walls = new BGE.DrawableGridWalls(invalid, m.map, textures, {isShaded: true, lightWrap: 0.5, name: "maze"})
      m.assertEqual(3, walls.map.colCount)
      m.assertTrue(walls.isShaded)
      m.assertEqual(0.5, walls.lightWrap)
      m.assertEqual("maze", walls.name)
    end function

    @it("walls the open cell in from the map, one segment per side")
    function _()
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(0, 16)})
      m.assertEqual(4, walls.segments.count())
      m.assertEqual("stone", walls.segments[0].texture)
    end function

    @it("defaults hideTolerance to a quarter cell, unless args set it")
    function _()
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(0, 16)})
      m.assertEqual(1.0, walls.hideTolerance)
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(0, 16)}, {hideTolerance: 3.0})
      m.assertEqual(3.0, walls.hideTolerance)
    end function

    @describe("setMap")

    @it("rebuilds the walls, their BSP and a default hideTolerance from the new map")
    function _()
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(0, 16)})
      version = walls.geometryVersion
      walls.setMap(m.bigMap())
      m.assertEqual(8, walls.segments.count())
      m.assertEqual(8, walls.bsp.segmentCount)
      m.assertEqual(2.0, walls.hideTolerance)
      m.assertTrue(walls.geometryVersion > version)
    end function

    @it("keeps a hideTolerance set by args")
    function _()
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(0, 16)}, {hideTolerance: 3.0})
      walls.setMap(m.bigMap())
      m.assertEqual(3.0, walls.hideTolerance)
    end function

    @describe("setSegments")

    @it("replaces the map's walls, and setTextures() keeps them")
    function _()
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(0, 16)})
      one = [walls.segments[0]] as BGE.WallSegment[]
      walls.setSegments(one)
      m.assertEqual(1, walls.segments.count())
      m.assertEqual(1, walls.bsp.segmentCount)
      walls.setTextures({stone: m.region(0, 8)})
      m.assertEqual(1, walls.segments.count())
    end function

    @describe("addToRenderer")

    @it("registers one SceneObjectWalls")
    function _()
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(0, 16)})
      sceneObj = walls.addToRenderer(m.renderer)
      m.assertNotInvalid(sceneObj)
      m.assertEqual(BGE.SceneObjectType.Walls, sceneObj.type)
      m.assertEqual(0, m.renderer.getSceneObjectIndexById(sceneObj.id))
      m.assertEqual(sceneObj.id, walls.getSceneObjects()[0].id)
    end function

    @describe("getColumns")

    @it("cuts a texture into one-pixel columns, foot at the pivot")
    function _()
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(8, 16)})
      columns = walls.getColumns("stone", 1)
      m.assertEqual(16, columns.count())
      column = columns[3] as roRegion
      m.assertEqual(1, column.GetWidth())
      m.assertEqual(24, column.GetHeight())
      m.assertEqual(11, column.GetX())
      m.assertEqual(-24, column.GetPretranslationY())
    end function

    @it("returns invalid for an unknown texture")
    function _()
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(0, 16)})
      m.assertInvalid(walls.getColumns("brick", 1))
    end function

    @describe("setTextures")

    @it("swaps the textures, rebuilds the columns and invalidates geometry")
    function _()
      walls = new BGE.DrawableGridWalls(invalid, m.map, {stone: m.region(0, 16)})
      m.assertEqual(16, walls.getColumns("stone", 1).count())
      version = walls.geometryVersion
      walls.setTextures({stone: m.region(0, 8)})
      m.assertEqual(8, walls.getColumns("stone", 1).count())
      m.assertTrue(walls.geometryVersion > version)
    end function

  end class

end namespace
