namespace tests

  ' Real roAudioResource playback can't be heard headlessly, so these put a stand-in that records
  ' its trigger() calls into game.Sounds.
  @suite("BGE.Game sounds")
  class GameSoundTests extends rooibos.BaseTestSuite

    game as BGE.Game

    protected override function beforeEach()
      m.game = new BGE.Game(320, 240)
    end function

    private function addFakeSound(name as string, streams as integer) as roAssociativeArray
      sound = {
        streams: streams,
        calls: [],
        trigger: sub(volume as integer, channel = 0 as integer)
          m.calls.push({ volume: volume, channel: channel })
        end sub,
        maxSimulStreams: function() as integer
          return m.streams
        end function
      }
      m.game.Sounds[name] = sound
      return sound
    end function

    @describe("playSound")

    @it("plays on channel 0 by default")
    function _()
      sound = m.addFakeSound("hit", 2)
      m.assertTrue(m.game.playSound("hit", 80))
      m.assertEqual(1, sound.calls.count())
      m.assertEqual(80, sound.calls[0].volume)
      m.assertEqual(0, sound.calls[0].channel)
    end function

    @it("plays on the channel it's given")
    function _()
      sound = m.addFakeSound("voice", 2)
      m.game.playSound("voice", 100, 1)
      m.assertEqual(1, sound.calls[0].channel)
    end function

    @it("falls back to channel 0 when the device has only one")
    function _()
      sound = m.addFakeSound("voice", 1)
      m.game.playSound("voice", 100, 1)
      m.assertEqual(0, sound.calls[0].channel)
    end function

    @it("falls back to channel 0 for a negative channel")
    function _()
      sound = m.addFakeSound("voice", 2)
      m.game.playSound("voice", 100, -1)
      m.assertEqual(0, sound.calls[0].channel)
    end function

    @it("returns false for a sound that isn't loaded")
    function _()
      m.assertFalse(m.game.playSound("missing"))
    end function

    @describe("getSoundChannelCount")

    @it("is 1 with no sounds loaded")
    function _()
      m.assertEqual(1, m.game.getSoundChannelCount())
    end function

    @it("reads the loaded sounds' stream count")
    function _()
      m.addFakeSound("hit", 2)
      m.assertEqual(2, m.game.getSoundChannelCount())
    end function

  end class

end namespace
