' Test helpers every shard includes (see scripts/run-tests-sharded.js). No suite of its own.
namespace tests

  ' A bitmap's pixels, like bitmap.GetByteArray(). A Roku reads zeros back from a bitmap
  ' that's been drawn into, so on a device this reads them through a PNG instead; translucent
  ' pixels come back premultiplied there.
  '
  ' @param {roBitmap} bitmap
  ' @return {roByteArray} RGBA bytes, row by row
  function readPixels(bitmap as roBitmap, x as integer, y as integer, width as integer, height as integer) as roByteArray
    globals = GetGlobalAA()
    if globals.bgeTestsReadsDrawnPixels = invalid
      globals.bgeTestsReadsDrawnPixels = CreateObject("roDeviceInfo").HasFeature("simulation_engine")
    end if
    if globals.bgeTestsReadsDrawnPixels
      return bitmap.GetByteArray(x, y, width, height)
    end if
    copy = tests.loadedCopy(bitmap, x, y, width, height)
    if invalid = copy
      ' the bitmap itself would read back zeros and pass "is transparent" checks
      throw "tests.readPixels(): couldn't load a PNG copy of the bitmap"
    end if
    return copy.GetByteArray(0, 0, width, height)
  end function

  ' Something to read many of `bitmap`'s pixels from with GetByteArray(): the bitmap itself
  ' headless, or one loaded copy of it on a device (see readPixels()), so a loop of reads costs
  ' one PNG round trip. Take a new one after drawing again.
  '
  ' @param {roBitmap} bitmap
  ' @return {roBitmap} a bitmap to call GetByteArray() on
  function pixelSource(bitmap as roBitmap) as roBitmap
    globals = GetGlobalAA()
    if globals.bgeTestsReadsDrawnPixels = invalid
      globals.bgeTestsReadsDrawnPixels = CreateObject("roDeviceInfo").HasFeature("simulation_engine")
    end if
    if globals.bgeTestsReadsDrawnPixels
      return bitmap
    end if
    copy = tests.loadedCopy(bitmap)
    if invalid = copy
      throw "tests.pixelSource(): couldn't load a PNG copy of the bitmap"
    end if
    return copy
  end function

  ' A bitmap loaded from a PNG of part of `bitmap` (all of it by default), which a device can
  ' read pixels from (see readPixels()), e.g. for engine code that calls GetByteArray().
  '
  ' @param {roBitmap} bitmap
  ' @return {dynamic} roBitmap, or invalid if it couldn't be written or read
  function loadedCopy(bitmap as roBitmap, x = 0 as integer, y = 0 as integer, width = -1 as integer, height = -1 as integer) as dynamic
    if width < 0
      width = bitmap.GetWidth()
    end if
    if height < 0
      height = bitmap.GetHeight()
    end if
    png = bitmap.GetPng(x, y, width, height)
    if invalid = png
      return invalid
    end if
    ' a new name each time: a device can hand back its cached decode of a path it's loaded before
    globals = GetGlobalAA()
    index = globals.bgeTestsPixelFileIndex ?? 0
    globals.bgeTestsPixelFileIndex = index + 1
    path = "tmp:/bge_test_pixels_" + index.toStr() + ".png"
    if not png.WriteFile(path)
      return invalid
    end if
    copy = CreateObject("roBitmap", path)
    DeleteFile(path)
    return copy
  end function

end namespace
