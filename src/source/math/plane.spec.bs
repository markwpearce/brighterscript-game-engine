namespace tests

  ' A ground plane at y=0, facing straight up (+y normal) - the same setup
  ' BGE.DrawablePlane/SceneObjectPlane uses for a floor.
  @suite("BGE.Math plane")
  class PlaneTests extends rooibos.BaseTestSuite

    groundPlane as BGE.Math.Plane

    protected override function beforeEach()
      m.groundPlane = {
        normal: BGE.Math.VectorOps.create(0, 1, 0),
        point: BGE.Math.VectorOps.create(0, 0, 0)
      }
    end function

    @describe("intersectRayWithPlane")

    @it("finds the point where a downward ray crosses the plane")
    function _()
      ray = {
        origin: BGE.Math.VectorOps.create(0, 10, 0),
        direction: BGE.Math.VectorOps.create(0, -1, 0)
      }
      result = BGE.Math.intersectRayWithPlane(m.groundPlane, ray)
      m.assertNotInvalid(result)
      m.assertTrue(abs(result.y) < 0.0001)
    end function

    @it("returns invalid when the ray points away from the plane")
    function _()
      ray = {
        origin: BGE.Math.VectorOps.create(0, 10, 0),
        direction: BGE.Math.VectorOps.create(0, 1, 0)
      }
      result = BGE.Math.intersectRayWithPlane(m.groundPlane, ray)
      m.assertInvalid(result)
    end function

    @it("returns invalid when the ray runs parallel to the plane")
    function _()
      ray = {
        origin: BGE.Math.VectorOps.create(0, 10, 0),
        direction: BGE.Math.VectorOps.create(1, 0, 0)
      }
      result = BGE.Math.intersectRayWithPlane(m.groundPlane, ray)
      m.assertInvalid(result)
    end function

    @describe("signedDistanceFromPointToPlane / distanceFromPointToPlane")

    @it("is positive on the side the normal points toward, negative on the other")
    function _()
      above = BGE.Math.VectorOps.create(0, 5, 0)
      below = BGE.Math.VectorOps.create(0, -5, 0)
      m.assertEqual(5.0, BGE.Math.signedDistanceFromPointToPlane(m.groundPlane, above))
      m.assertEqual(-5.0, BGE.Math.signedDistanceFromPointToPlane(m.groundPlane, below))
      m.assertEqual(5.0, BGE.Math.distanceFromPointToPlane(m.groundPlane, below))
    end function

    @describe("closestPointOnPlane")

    @it("projects a point straight onto the plane along its normal")
    function _()
      result = BGE.Math.closestPointOnPlane(m.groundPlane, BGE.Math.VectorOps.create(3, 5, 7))
      m.assertEqual(3.0, result.x)
      m.assertTrue(abs(result.y) < 0.0001)
      m.assertEqual(7.0, result.z)
    end function

    @describe("projectRayOntoPlane")

    @it("removes the component of the ray's direction along the plane normal")
    function _()
      ray = {
        origin: BGE.Math.VectorOps.create(0, 5, 0),
        direction: BGE.Math.VectorOps.create(1, 1, 0)
      }
      projected = BGE.Math.projectRayOntoPlane(m.groundPlane, ray)
      m.assertTrue(abs(projected.direction.y) < 0.0001)
      m.assertTrue(projected.direction.x > 0)
    end function

    @describe("angleToPlaneSurfaceDeg / angleToPlaneNormalDeg")

    @it("a vector along the normal is 90deg from the surface and 0deg from the normal")
    function _()
      m.assertTrue(abs(BGE.Math.angleToPlaneSurfaceDeg(m.groundPlane, BGE.Math.VectorOps.create(0, 1, 0)) - 90.0) < 0.0001)
      m.assertTrue(abs(BGE.Math.angleToPlaneNormalDeg(m.groundPlane, BGE.Math.VectorOps.create(0, 1, 0))) < 0.0001)
    end function

    @it("a vector along the surface is 0deg from the surface and 90deg from the normal")
    function _()
      m.assertTrue(abs(BGE.Math.angleToPlaneSurfaceDeg(m.groundPlane, BGE.Math.VectorOps.create(1, 0, 0))) < 0.0001)
      m.assertTrue(abs(BGE.Math.angleToPlaneNormalDeg(m.groundPlane, BGE.Math.VectorOps.create(1, 0, 0)) - 90.0) < 0.0001)
    end function

  end class

end namespace
