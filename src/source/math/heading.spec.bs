namespace tests

  @suite("BGE.Math headings")
  class HeadingTests extends rooibos.BaseTestSuite

    private function assertNear(actual as float, expected as float, message = "" as string)
      m.assertTrue(Abs(actual - expected) < 0.0001, `${message} expected ${expected}, got ${actual}`)
    end function

    @describe("headingForward / headingRight / headingOf")

    @it("faces -z at heading 0 and +x at a quarter turn")
    function _()
      forward = BGE.Math.headingForward(0)
      m.assertNear(forward.x, 0)
      m.assertNear(forward.z, -1)
      quarter = BGE.Math.headingForward(BGE.Math.HALF_PI)
      m.assertNear(quarter.x, 1)
      m.assertNear(quarter.z, 0)
    end function

    @it("puts right a quarter turn clockwise from forward")
    function _()
      for each heading in [0, 0.7, -2.1, 3]
        right = BGE.Math.headingRight(heading)
        forward = BGE.Math.headingForward(heading + BGE.Math.HALF_PI)
        m.assertNear(right.x, forward.x, "x")
        m.assertNear(right.z, forward.z, "z")
      end for
    end function

    @it("round-trips a heading through its forward vector")
    function _()
      for each heading in [0, 0.5, -1.2, 2.9, -2.9]
        m.assertNear(BGE.Math.headingOf(BGE.Math.headingForward(heading)), heading)
      end for
    end function

    @describe("wrapAngle")

    @it("wraps into -PI..PI")
    function _()
      m.assertNear(BGE.Math.wrapAngle(0.5), 0.5)
      m.assertNear(BGE.Math.wrapAngle(2 * BGE.Math.PI + 0.5), 0.5)
      m.assertNear(BGE.Math.wrapAngle(-2 * BGE.Math.PI - 0.5), -0.5)
      m.assertNear(BGE.Math.wrapAngle(BGE.Math.PI + 0.25), -BGE.Math.PI + 0.25)
      m.assertNear(BGE.Math.wrapAngle(-9 * BGE.Math.PI - 0.25), BGE.Math.PI - 0.25)
    end function

    @describe("turnToward")

    @it("steps by at most maxStep the short way round")
    function _()
      m.assertNear(BGE.Math.turnToward(0, 1, 0.25), 0.25)
      m.assertNear(BGE.Math.turnToward(0, -1, 0.25), -0.25)
      ' 3.0 to -3.0 is 0.28 rad through PI, not 6 rad back through 0
      m.assertNear(BGE.Math.turnToward(3.0, -3.0, 0.1), 3.1)
    end function

    @it("lands on the target when within maxStep")
    function _()
      m.assertNear(BGE.Math.turnToward(0.9, 1, 0.25), 1)
    end function

    @it("lands exactly on 0, so callers can test for having arrived")
    function _()
      m.assertTrue(BGE.Math.turnToward(0.05, 0, 0.25) = 0)
    end function

    @describe("flatDistance / flatDirection")

    @it("ignores height")
    function _()
      a = BGE.Math.VectorOps.create(0, 0, 0)
      b = BGE.Math.VectorOps.create(3, 100, -4)
      m.assertNear(BGE.Math.flatDistance(a, b), 5)
      direction = BGE.Math.flatDirection(a, b)
      m.assertNear(direction.x, 0.6)
      m.assertNear(direction.y, 0)
      m.assertNear(direction.z, -0.8)
    end function

    @it("falls back to heading 0's forward for the same point")
    function _()
      a = BGE.Math.VectorOps.create(2, 0, 2)
      direction = BGE.Math.flatDirection(a, a)
      m.assertNear(direction.x, 0)
      m.assertNear(direction.z, -1)
    end function

    @describe("isWithinArc")

    @it("accepts a target ahead within reach, inclusive, and rejects one beyond it")
    function _()
      origin = BGE.Math.VectorOps.create(0, 0, 0)
      m.assertTrue(BGE.Math.isWithinArc(origin, 0, BGE.Math.VectorOps.create(0, 0, -5), 10, 0.5))
      m.assertTrue(BGE.Math.isWithinArc(origin, 0, BGE.Math.VectorOps.create(0, 0, -10), 10, 0.5), "at reach")
      m.assertFalse(BGE.Math.isWithinArc(origin, 0, BGE.Math.VectorOps.create(0, 0, -10.5), 10, 0.5), "beyond reach")
    end function

    @it("ignores height")
    function _()
      origin = BGE.Math.VectorOps.create(0, 0, 0)
      m.assertTrue(BGE.Math.isWithinArc(origin, 0, BGE.Math.VectorOps.create(0, 500, -5), 10, 0.5))
    end function

    @it("tests the angle either side of the heading")
    function _()
      origin = BGE.Math.VectorOps.create(10, 0, 10)
      ' Heading a quarter turn faces +x; a target at 45 degrees off it
      target = BGE.Math.VectorOps.create(15, 0, 15)
      m.assertTrue(BGE.Math.isWithinArc(origin, BGE.Math.HALF_PI, target, 10, 0.8))
      m.assertFalse(BGE.Math.isWithinArc(origin, BGE.Math.HALF_PI, target, 10, 0.7))
      m.assertFalse(BGE.Math.isWithinArc(origin, -BGE.Math.HALF_PI, target, 10, 0.8), "behind")
    end function

    @it("wraps the angle across PI")
    function _()
      origin = BGE.Math.VectorOps.create(0, 0, 0)
      ' Facing +z (heading PI), a target slightly to either side
      m.assertTrue(BGE.Math.isWithinArc(origin, BGE.Math.PI, BGE.Math.VectorOps.create(1, 0, 5), 10, 0.3))
      m.assertTrue(BGE.Math.isWithinArc(origin, -BGE.Math.PI, BGE.Math.VectorOps.create(-1, 0, 5), 10, 0.3))
    end function

    @it("covers every direction with a half angle of PI")
    function _()
      origin = BGE.Math.VectorOps.create(0, 0, 0)
      m.assertTrue(BGE.Math.isWithinArc(origin, 0, BGE.Math.VectorOps.create(0, 0, 5), 10, BGE.Math.PI))
    end function

    @it("adds targetRadius to reach")
    function _()
      origin = BGE.Math.VectorOps.create(0, 0, 0)
      target = BGE.Math.VectorOps.create(0, 0, -12)
      m.assertFalse(BGE.Math.isWithinArc(origin, 0, target, 10, 0.5))
      m.assertTrue(BGE.Math.isWithinArc(origin, 0, target, 10, 0.5, 2))
    end function

    @it("counts a target on top of the origin as inside")
    function _()
      origin = BGE.Math.VectorOps.create(3, 0, 3)
      m.assertTrue(BGE.Math.isWithinArc(origin, 2, BGE.Math.VectorOps.create(3, 1, 3), 10, 0.1))
    end function

  end class

end namespace
