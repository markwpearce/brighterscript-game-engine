namespace BGE.Math

  ' A sphere in world space: centre (x, y, z) and radius.
  interface BoundingSphere extends roAssociativeArray
    x as float
    y as float
    z as float
    radius as float
  end interface

  ' A sphere holding every point: centred on their average, out to the farthest one. Not the
  ' smallest such sphere, but quick. The radius is padded a little, so a test against it errs
  ' towards "maybe" rather than flipping on rounding.
  '
  ' @param {BGE.Math.Vector[]} points at least one
  ' @return {BGE.Math.BoundingSphere}
  function boundingSphereOfPoints(points as BGE.Math.Vector[]) as BGE.Math.BoundingSphere
    count = points.count()
    sumX = 0.0
    sumY = 0.0
    sumZ = 0.0
    for each point in points
      sumX += point.x
      sumY += point.y
      sumZ += point.z ?? 0
    end for
    cx = sumX / count
    cy = sumY / count
    cz = sumZ / count
    farthest = 0.0
    for each point in points
      dx = point.x - cx
      dy = point.y - cy
      dz = (point.z ?? 0) - cz
      squared = dx * dx + dy * dy + dz * dz
      if squared > farthest
        farthest = squared
      end if
    end for
    radius = Sqr(farthest)
    return {x: cx, y: cy, z: cz, radius: radius * 1.001 + 0.01}
  end function

end namespace
