import "math.bs"
import "vector.bs"

' Helpers for headings and directions on the ground (XZ) plane, in the heading convention
' DrawableOrientedSprite and Camera3d use: a heading of 0 faces -z, and increasing headings
' turn clockwise seen from above, so forward is (sin(heading), 0, -cos(heading)).
namespace BGE.Math

  ' Unit vector on the ground that `heading` faces.
  '
  ' @param {float} heading - radians
  ' @return {BGE.Math.Vector}
  function headingForward(heading as float) as BGE.Math.Vector
    return BGE.Math.VectorOps.create(Sin(heading), 0, -Cos(heading))
  end function

  ' Unit vector on the ground to the right of `heading` (forward turned a quarter clockwise).
  '
  ' @param {float} heading - radians
  ' @return {BGE.Math.Vector}
  function headingRight(heading as float) as BGE.Math.Vector
    return BGE.Math.VectorOps.create(Cos(heading), 0, Sin(heading))
  end function

  ' The heading a direction faces on the ground; its y is ignored.
  '
  ' @param {BGE.Math.Vector} direction
  ' @return {float} radians, -PI..PI
  function headingOf(direction as BGE.Math.Vector) as float
    return BGE.Math.Atan2(direction.x, -direction.z)
  end function

  ' Wraps an angle into -PI..PI.
  '
  ' @param {float} angle - radians
  ' @return {float}
  function wrapAngle(angle as float) as float
    ' Left untouched when already in range, so turnToward() can land exactly on a target
    if angle >= -BGE.Math.PI and angle <= BGE.Math.PI
      return angle
    end if
    twoPi = 2 * BGE.Math.PI
    angle = angle - Int(angle / twoPi) * twoPi
    ' Int() floors, so angle is now in 0..2PI
    if angle > BGE.Math.PI
      angle -= twoPi
    end if
    return angle
  end function

  ' Turns `current` toward `target` by at most maxStep radians, the short way round.
  '
  ' @param {float} current - radians
  ' @param {float} target - radians
  ' @param {float} maxStep - radians, e.g. turnSpeed * dt
  ' @return {float} the new heading (lands on target's direction when within maxStep)
  function turnToward(current as float, target as float, maxStep as float) as float
    diff = BGE.Math.wrapAngle(target - current)
    if Abs(diff) <= maxStep
      return current + diff
    end if
    if diff > 0
      return current + maxStep
    end if
    return current - maxStep
  end function

  ' Distance between two points on the ground, ignoring height.
  '
  ' @param {BGE.Math.Vector} a
  ' @param {BGE.Math.Vector} b
  ' @return {float}
  function flatDistance(a as BGE.Math.Vector, b as BGE.Math.Vector) as float
    dx = b.x - a.x
    dz = b.z - a.z
    return Sqr(dx * dx + dz * dz)
  end function

  ' Unit vector on the ground from `a` toward `b`, ignoring height. Gives heading 0's forward
  ' when the points are (almost) on top of each other.
  '
  ' @param {BGE.Math.Vector} a
  ' @param {BGE.Math.Vector} b
  ' @return {BGE.Math.Vector}
  function flatDirection(a as BGE.Math.Vector, b as BGE.Math.Vector) as BGE.Math.Vector
    length = BGE.Math.flatDistance(a, b)
    if length < 0.001
      return BGE.Math.headingForward(0)
    end if
    return BGE.Math.VectorOps.create((b.x - a.x) / length, 0, (b.z - a.z) / length)
  end function

  ' True when `target` is inside the ground-plane wedge reaching `reach` from `origin`, up to
  ' halfAngle either side of `heading`: the shape Renderer.drawWorldArc(origin, reach,
  ' heading - halfAngle, heading + halfAngle, rgba, true) draws. Heights are ignored. E.g. a
  ' melee swing's hit test.
  '
  ' @param {BGE.Math.Vector} origin
  ' @param {float} heading - radians, where the wedge points
  ' @param {BGE.Math.Vector} target
  ' @param {float} reach - world units; a target exactly at reach is inside
  ' @param {float} halfAngle - radians either side of heading; PI or more is a full circle
  ' @param {float} [targetRadius=0] - the target's body radius, added to reach so a body counts as soon as its edge is in reach (the angle is still measured to its centre)
  ' @return {boolean} true if inside; a target on top of the origin always is
  function isWithinArc(origin as BGE.Math.Vector, heading as float, target as BGE.Math.Vector, reach as float, halfAngle as float, targetRadius = 0 as float) as boolean
    dx = target.x - origin.x
    dz = target.z - origin.z
    distanceSquared = dx * dx + dz * dz
    maxDistance = reach + targetRadius
    if maxDistance < 0 or distanceSquared > maxDistance * maxDistance
      return false
    end if
    ' No direction to measure
    if distanceSquared < 0.000001
      return true
    end if
    return Abs(BGE.Math.wrapAngle(BGE.Math.Atan2(dx, -dz) - heading)) <= halfAngle
  end function

  ' Turns a move stick into a direction on the ground relative to a camera: stick up (+y) is
  ' the way the camera looks, stick right (+x) is the camera's right. Its length follows the
  ' stick's, clamped to 1, so a partly pushed stick still gives a slower move.
  '
  ' @param {BGE.Math.Vector} stick - x right, y up, each -1..1
  ' @param {float} cameraHeading - radians, e.g. BGE.OrbitCamera.heading
  ' @return {BGE.Math.Vector} y is 0, length 0..1
  function cameraRelativeMove(stick as BGE.Math.Vector, cameraHeading as float) as BGE.Math.Vector
    forward = BGE.Math.VectorOps.scale(BGE.Math.headingForward(cameraHeading), stick.y)
    right = BGE.Math.VectorOps.scale(BGE.Math.headingRight(cameraHeading), stick.x)
    move = BGE.Math.VectorOps.add(forward, right)
    length = BGE.Math.VectorOps.length(move)
    if length > 1
      move = BGE.Math.VectorOps.scale(move, 1 / length)
    end if
    return move
  end function

end namespace
