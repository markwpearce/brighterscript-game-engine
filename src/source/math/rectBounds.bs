import "math.bs"
import "vector.bs"
import "rectangle.bs"

' Keeping a body inside a rectangle: bounce off its edges, clamp to them, or wrap around.
' Edges are named for the engine's y-up world space: `bottom` is the rectangle's `y` edge
' (low y) and `top` is `y + height`.
namespace BGE.Math

  ' An edge of a rectangle - see bounceInRect().
  enum RectEdge
    none = "none"
    left = "left"
    right = "right"
    bottom = "bottom"
    top = "top"
  end enum

  ' Bounces a body off the edges of `rect`: a body past an edge is moved back onto it and,
  ' if it was heading out, its velocity on that axis flips. Updates `position` and
  ' `velocity` in place.
  '
  ' @example
  ' ' In onUpdate: a ball that can fall out of the bottom
  ' edge = BGE.Math.bounceInRect(m.position, m.velocity, m.playArea, radius, radius, [BGE.Math.RectEdge.bottom])
  ' if edge <> BGE.Math.RectEdge.none
  '   m.game.playSound("bounce")
  ' end if
  '
  ' @param {BGE.Math.Vector} position - the body's centre
  ' @param {BGE.Math.Vector} velocity
  ' @param {BGE.Math.Rectangle} rect
  ' @param {float} [halfWidth=0] - half the body's width (its radius, for a ball)
  ' @param {float} [halfHeight=0] - half the body's height
  ' @param {BGE.Math.RectEdge[]} [openEdges=[]] - edges the body passes through, e.g. the goal ends in pong
  ' @return {BGE.Math.RectEdge} the edge it bounced off (the vertical one, if it hit a corner), or none
  function bounceInRect(position as BGE.Math.Vector, velocity as BGE.Math.Vector, rect as BGE.Math.Rectangle, halfWidth = 0.0 as float, halfHeight = 0.0 as float, openEdges = [] as BGE.Math.RectEdge[]) as BGE.Math.RectEdge
    open = {}
    for each edge in openEdges
      open[edge] = true
    end for
    hit = BGE.Math.RectEdge.none
    if not open.DoesExist(BGE.Math.RectEdge.left) and position.x - halfWidth <= rect.x
      position.x = rect.x + halfWidth
      if velocity.x < 0
        velocity.x = -velocity.x
        hit = BGE.Math.RectEdge.left
      end if
    else if not open.DoesExist(BGE.Math.RectEdge.right) and position.x + halfWidth >= rect.x + rect.width
      position.x = rect.x + rect.width - halfWidth
      if velocity.x > 0
        velocity.x = -velocity.x
        hit = BGE.Math.RectEdge.right
      end if
    end if
    if not open.DoesExist(BGE.Math.RectEdge.bottom) and position.y - halfHeight <= rect.y
      position.y = rect.y + halfHeight
      if velocity.y < 0
        velocity.y = -velocity.y
        hit = BGE.Math.RectEdge.bottom
      end if
    else if not open.DoesExist(BGE.Math.RectEdge.top) and position.y + halfHeight >= rect.y + rect.height
      position.y = rect.y + rect.height - halfHeight
      if velocity.y > 0
        velocity.y = -velocity.y
        hit = BGE.Math.RectEdge.top
      end if
    end if
    return hit
  end function

  ' Moves a body that pokes out of `rect` back inside it. Updates `position` in place.
  '
  ' @example
  ' ' In onUpdate: keep the player on screen
  ' BGE.Math.clampToRect(m.position, m.screenRect, radius, radius)
  '
  ' @param {BGE.Math.Vector} position - the body's centre
  ' @param {BGE.Math.Rectangle} rect
  ' @param {float} [halfWidth=0]
  ' @param {float} [halfHeight=0]
  ' @return {boolean} true if it had to be moved
  function clampToRect(position as BGE.Math.Vector, rect as BGE.Math.Rectangle, halfWidth = 0.0 as float, halfHeight = 0.0 as float) as boolean
    x = BGE.Math.Clamp(position.x, rect.x + halfWidth, rect.x + rect.width - halfWidth)
    y = BGE.Math.Clamp(position.y, rect.y + halfHeight, rect.y + rect.height - halfHeight)
    moved = x <> position.x or y <> position.y
    position.x = x
    position.y = y
    return moved
  end function

  ' Wraps a point that left `rect` around to the opposite edge, like the ships and rocks in
  ' Asteroids. Updates `position` in place.
  '
  ' @example
  ' if BGE.Math.wrapInRect(m.position, m.screenRect) and m.dieOffScreen
  '   m.invalidate()
  ' end if
  '
  ' @param {BGE.Math.Vector} position
  ' @param {BGE.Math.Rectangle} rect
  ' @return {boolean} true if it wrapped
  function wrapInRect(position as BGE.Math.Vector, rect as BGE.Math.Rectangle) as boolean
    wrapped = false
    if position.x < rect.x or position.x > rect.x + rect.width
      position.x = rect.x + BGE.Math.wrapValue(position.x - rect.x, rect.width)
      wrapped = true
    end if
    if position.y < rect.y or position.y > rect.y + rect.height
      position.y = rect.y + BGE.Math.wrapValue(position.y - rect.y, rect.height)
      wrapped = true
    end if
    return wrapped
  end function

end namespace
