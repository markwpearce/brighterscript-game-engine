namespace tests

  @suite("BGE.Math rect bounds")
  class RectBoundsTests extends rooibos.BaseTestSuite

    rect as BGE.Math.Rectangle

    protected override function beforeEach()
      m.rect = new BGE.Math.Rectangle(0, 0, 100, 50)
    end function

    @describe("bounceInRect")

    @it("leaves a body inside the rectangle alone")
    function _()
      position = BGE.Math.VectorOps.create(50, 25)
      velocity = BGE.Math.VectorOps.create(10, -10)
      m.assertEqual(BGE.Math.RectEdge.none, BGE.Math.bounceInRect(position, velocity, m.rect, 5, 5))
      m.assertEqual(50.0, position.x)
      m.assertEqual(10.0, velocity.x)
      m.assertEqual(-10.0, velocity.y)
    end function

    @it("bounces off the left edge, moving the body back onto it")
    function _()
      position = BGE.Math.VectorOps.create(2, 25)
      velocity = BGE.Math.VectorOps.create(-10, 3)
      m.assertEqual(BGE.Math.RectEdge.left, BGE.Math.bounceInRect(position, velocity, m.rect, 5, 5))
      m.assertEqual(5.0, position.x)
      m.assertEqual(10.0, velocity.x)
      m.assertEqual(3.0, velocity.y)
    end function

    @it("bounces off the right edge")
    function _()
      position = BGE.Math.VectorOps.create(99, 25)
      velocity = BGE.Math.VectorOps.create(10, 0)
      m.assertEqual(BGE.Math.RectEdge.right, BGE.Math.bounceInRect(position, velocity, m.rect, 5, 5))
      m.assertEqual(95.0, position.x)
      m.assertEqual(-10.0, velocity.x)
    end function

    @it("names the low-y edge bottom and the high-y edge top")
    function _()
      position = BGE.Math.VectorOps.create(50, 1)
      velocity = BGE.Math.VectorOps.create(0, -10)
      m.assertEqual(BGE.Math.RectEdge.bottom, BGE.Math.bounceInRect(position, velocity, m.rect, 2, 2))
      m.assertEqual(2.0, position.y)
      m.assertEqual(10.0, velocity.y)

      position = BGE.Math.VectorOps.create(50, 49)
      m.assertEqual(BGE.Math.RectEdge.top, BGE.Math.bounceInRect(position, velocity, m.rect, 2, 2))
      m.assertEqual(48.0, position.y)
      m.assertEqual(-10.0, velocity.y)
    end function

    @it("returns the vertical edge when it hits a corner, flipping both axes")
    function _()
      position = BGE.Math.VectorOps.create(0, 50)
      velocity = BGE.Math.VectorOps.create(-1, 1)
      m.assertEqual(BGE.Math.RectEdge.top, BGE.Math.bounceInRect(position, velocity, m.rect))
      m.assertEqual(1.0, velocity.x)
      m.assertEqual(-1.0, velocity.y)
    end function

    @it("doesn't flip a body already heading back in")
    function _()
      position = BGE.Math.VectorOps.create(-3, 25)
      velocity = BGE.Math.VectorOps.create(10, 0)
      m.assertEqual(BGE.Math.RectEdge.none, BGE.Math.bounceInRect(position, velocity, m.rect))
      m.assertEqual(0.0, position.x)
      m.assertEqual(10.0, velocity.x)
    end function

    @it("lets a body through an open edge")
    function _()
      position = BGE.Math.VectorOps.create(50, -20)
      velocity = BGE.Math.VectorOps.create(0, -10)
      edge = BGE.Math.bounceInRect(position, velocity, m.rect, 5, 5, [BGE.Math.RectEdge.bottom])
      m.assertEqual(BGE.Math.RectEdge.none, edge)
      m.assertEqual(-20.0, position.y)
      m.assertEqual(-10.0, velocity.y)
    end function

    @describe("clampToRect")

    @it("leaves a body that fits alone")
    function _()
      position = BGE.Math.VectorOps.create(50, 25)
      m.assertFalse(BGE.Math.clampToRect(position, m.rect, 10, 10))
      m.assertEqual(50.0, position.x)
      m.assertEqual(25.0, position.y)
    end function

    @it("pulls a body that pokes out back inside on both axes")
    function _()
      position = BGE.Math.VectorOps.create(-5, 49)
      m.assertTrue(BGE.Math.clampToRect(position, m.rect, 10, 4))
      m.assertEqual(10.0, position.x)
      m.assertEqual(46.0, position.y)
    end function

    @describe("wrapInRect")

    @it("leaves a point inside alone")
    function _()
      position = BGE.Math.VectorOps.create(100, 0)
      m.assertFalse(BGE.Math.wrapInRect(position, m.rect))
      m.assertEqual(100.0, position.x)
    end function

    @it("wraps past the right or top edge to the other side, keeping the overshoot")
    function _()
      position = BGE.Math.VectorOps.create(103.5, 52)
      m.assertTrue(BGE.Math.wrapInRect(position, m.rect))
      m.assertEqual(3.5, position.x)
      m.assertEqual(2.0, position.y)
    end function

    @it("wraps past the left edge of an offset rectangle")
    function _()
      offsetRect = new BGE.Math.Rectangle(10, 10, 100, 50)
      position = BGE.Math.VectorOps.create(6, 30)
      m.assertTrue(BGE.Math.wrapInRect(position, offsetRect))
      m.assertEqual(106.0, position.x)
      m.assertEqual(30.0, position.y)
    end function

  end class

end namespace
