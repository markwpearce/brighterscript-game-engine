namespace tests

  @suite("BGE.Math.boundingSphereOfPoints")
  class BoundingSphereTests extends rooibos.BaseTestSuite

    @describe("boundingSphereOfPoints")

    @it("centres on the points' average")
    function _()
      sphere = BGE.Math.boundingSphereOfPoints([
        BGE.Math.VectorOps.create(0, 0, 0),
        BGE.Math.VectorOps.create(10, 0, 0),
        BGE.Math.VectorOps.create(10, 20, 0),
        BGE.Math.VectorOps.create(0, 20, 0)
      ])
      m.assertEqual(sphere.x, 5.0)
      m.assertEqual(sphere.y, 10.0)
      m.assertEqual(sphere.z, 0.0)
    end function

    @it("holds every point, with a little to spare")
    function _()
      points = [
        BGE.Math.VectorOps.create(-3, 7, 100),
        BGE.Math.VectorOps.create(40, -2, 90),
        BGE.Math.VectorOps.create(12, 30, 130)
      ]
      sphere = BGE.Math.boundingSphereOfPoints(points)
      farthest = 0.0
      for each point in points
        dx = point.x - sphere.x
        dy = point.y - sphere.y
        dz = point.z - sphere.z
        distance = Sqr(dx * dx + dy * dy + dz * dz)
        m.assertTrue(distance < sphere.radius, `point ${distance} from the centre is outside radius ${sphere.radius}`)
        if distance > farthest
          farthest = distance
        end if
      end for
      m.assertTrue(sphere.radius < farthest * 1.01 + 0.1, "padded only a little")
    end function

    @it("treats a missing z as 0")
    function _()
      sphere = BGE.Math.boundingSphereOfPoints([{x: 0, y: 0}, {x: 4, y: 0}] as BGE.Math.Vector[])
      m.assertEqual(sphere.z, 0.0)
      m.assertTrue(sphere.radius >= 2)
    end function

    @it("gives a single point a near-zero radius")
    function _()
      sphere = BGE.Math.boundingSphereOfPoints([BGE.Math.VectorOps.create(1, 2, 3)])
      m.assertEqual(sphere.x, 1.0)
      m.assertTrue(sphere.radius > 0 and sphere.radius < 0.1)
    end function

  end class

end namespace
