namespace BGE.Math


  interface Plane
    normal as Vector
    point as Vector
  end interface


  interface Ray
    origin as Vector
    direction as Vector
  end interface


  function intersectRayWithPlane(plane as Plane, ray as Ray) as BGE.Math.Vector
    planeNormal = plane.normal
    planePoint = plane.point
    rayOrigin = ray.origin
    rayDirection = ray.direction
    BGE.Math.VectorOps.normalize(planeNormal)
    BGE.Math.VectorOps.normalize(rayDirection)
    denom = BGE.Math.VectorOps.dotProduct(planeNormal, rayDirection)
    if abs(denom) > 0.00001
      diff = BGE.Math.VectorOps.subtract(planePoint, rayOrigin)
      t = BGE.Math.VectorOps.dotProduct(diff, planeNormal) / denom
      if t >= 0
        intersectionPoint = BGE.Math.VectorOps.add(rayOrigin, BGE.Math.VectorOps.scale(rayDirection, t))
        return intersectionPoint
      end if
    end if
    return invalid
  end function

  ' Returns signed distance from a point to a plane.
  ' Positive/negative sign indicates which side of the plane normal the point is on.
  '
  ' @param {Plane} plane
  ' @param {BGE.Math.Vector} targetPoint
  ' @return {float}
  function signedDistanceFromPointToPlane(plane as Plane, targetPoint as BGE.Math.Vector) as float
    diff = BGE.Math.VectorOps.subtract(targetPoint, plane.point)
    normalLength = BGE.Math.VectorOps.length(plane.normal)
    if normalLength = 0
      return 0
    end if
    return BGE.Math.VectorOps.dotProduct(diff, plane.normal) / normalLength
  end function

  ' Returns the absolute shortest distance from a point to a plane.
  function distanceFromPointToPlane(plane as Plane, targetPoint as BGE.Math.Vector) as float
    return abs(signedDistanceFromPointToPlane(plane, targetPoint))
  end function


  ' 0..90 deg
  ' 0 = parallel to plane, 90 = perpendicular to plane
  function angleToPlaneSurfaceDeg(plane as BGE.Math.Plane, v as BGE.Math.Vector) as float
    nLen = BGE.Math.VectorOps.length(plane.normal)
    vLen = BGE.Math.VectorOps.length(v)
    if nLen = 0 or vLen = 0
      return 0
    end if

    c = BGE.Math.VectorOps.dotProduct(plane.normal, v) / (nLen * vLen)
    c = BGE.Math.Clamp(c, -1, 1)

    ' angle to normal in [0, pi]
    thetaNormal = BGE.Math.Atan2(Sqr(BGE.Math.Max(0, 1 - c * c)), c)

    ' convert to angle to surface in [0, pi/2]
    thetaSurface = abs(BGE.Math.HALF_PI - thetaNormal)
    return BGE.Math.RadiansToDegrees(thetaSurface)
  end function

  ' 0..180 deg
  ' 0 = +normal, 180 = -normal, 90 = parallel to plane
  function angleToPlaneNormalDeg(plane as BGE.Math.Plane, v as BGE.Math.Vector) as float
    nLen = BGE.Math.VectorOps.length(plane.normal)
    vLen = BGE.Math.VectorOps.length(v)
    if nLen = 0 or vLen = 0
      return 0
    end if

    c = BGE.Math.VectorOps.dotProduct(plane.normal, v) / (nLen * vLen)
    c = BGE.Math.Clamp(c, -1, 1)
    thetaNormal = BGE.Math.Atan2(Sqr(BGE.Math.Max(0, 1 - c * c)), c)
    return BGE.Math.RadiansToDegrees(thetaNormal)
  end function

  function closestPointOnPlane(plane as BGE.Math.Plane, point as BGE.Math.Vector) as BGE.Math.Vector
    nLen = BGE.Math.VectorOps.length(plane.normal)
    if nLen = 0
      return BGE.Math.VectorOps.copy(point)
    end if

    d = BGE.Math.signedDistanceFromPointToPlane(plane, point)
    nUnit = BGE.Math.VectorOps.scale(plane.normal, 1 / nLen)
    return BGE.Math.VectorOps.subtract(point, BGE.Math.VectorOps.scale(nUnit, d))
  end function


  function projectRayOntoPlane(plane as BGE.Math.Plane, ray as BGE.Math.Ray) as BGE.Math.Ray
    rayDir = ray.direction
    planeNormal = plane.normal
    nLen = BGE.Math.VectorOps.length(planeNormal)
    if nLen = 0
      return ray
    end if

    closestPointOnPlane = BGE.Math.closestPointOnPlane(plane, ray.origin)

    planeNormalUnit = BGE.Math.VectorOps.scale(planeNormal, 1 / nLen)
    dot = BGE.Math.VectorOps.dotProduct(rayDir, planeNormalUnit)
    projectedDir = BGE.Math.VectorOps.subtract(rayDir, BGE.Math.VectorOps.scale(planeNormalUnit, dot))
    return {origin: closestPointOnPlane, direction: projectedDir}
  end function

end namespace
