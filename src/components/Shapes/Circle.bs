' See Circle.xml for the field interface.
import "../../source/utils/ShapeComponentHelpers.bs"

' Fields already declare onChange="onShapeFieldChanged" in XML; an extra observeField() here double-fires every redraw (confirmed on hardware).
sub init()
  redraw()
end sub

sub onShapeFieldChanged()
  redraw()
end sub

sub redraw()
  roundTripTimer = BGE.ShapeComponentHelpers.startRoundTripTimer()
  width = Int(m.top.width)
  height = Int(m.top.height)
  radius = BGE.Math.Min(width, height) / 2
  cacheKey = FormatJson({
    w: width,
    h: height,
    color: m.top.color,
    oc: m.top.outlineColor,
    ow: m.top.outlineWidth,
    os: m.top.outlineSegments
  })

  renderState = BGE.ShapeComponentHelpers.beginShapeRender("Circle", cacheKey, width, height)
  if not renderState.hit
    if invalid = renderState.renderer
      return
    end if
    renderState.renderer.drawCircleTo(renderState.bitmap, radius, radius, radius, m.top.color)
    if m.top.outlineWidth > 0
      renderState.renderer.drawCircleOutline(m.top.outlineSegments, radius, radius, radius - (m.top.outlineWidth / 2), m.top.outlineColor)
    end if
    BGE.ShapeComponentHelpers.finishShapeRender(renderState)
  end if
  m.top.uri = renderState.uri
  m.top.lastRoundTripMs = BGE.ShapeComponentHelpers.logRoundTrip("Circle", roundTripTimer)
end sub
