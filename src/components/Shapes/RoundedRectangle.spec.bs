import "pkg:/components/Shapes/ShapeTestHelpers.spec.bs"

namespace tests

  ' Runs inside a RoundedRectangle node (SceneGraph runner), so the component's own functions are in scope.
  @SGNode("RoundedRectangle")
  @suite("RoundedRectangle (SceneGraph)")
  class RoundedRectangleNodeTests extends rooibos.BaseTestSuite

    ' every test shares one node, so reset what tests change
    protected override function beforeEach()
      tests.deleteShapeCache()
      m.top.uri = ""
      m.top.findNode("renderTask").uri = ""
    end function

    @describe("render task")

    @it("sets its render task up for rounded rectangles")
    function _()
      m.assertEqual("RoundedRectangle", m.top.findNode("renderTask").shapeType)
    end function

    @it("hands the render task its corner radius on a cache miss")
    function _()
      m.top.width = 120
      m.top.height = 60
      m.top.cornerRadius = 14
      m.top.outlineColor = &h00FF00FF
      redraw()
      task = m.top.findNode("renderTask")
      m.assertEqual(14.0, task.cornerRadius)
      m.assertEqual(&h00FF00FF, task.outlineColor)
      m.assertEqual(120.0, task.width)
    end function

    @it("shows a cached render without running the task")
    function _()
      redraw()
      uri = m.top.findNode("renderTask").uri
      WriteAsciiFile(uri, "cached")
      redraw()
      m.assertEqual(uri, m.top.uri)
    end function

  end class

end namespace
