<?xml version="1.0" encoding="utf-8" ?>
<!--
  Renders a filled (optionally outlined) convex polygon, using
  BGE.Renderer.drawPolygonTo()/drawPolygonOutlineTo() internally (fan-triangulated
  via BGE.QuickHull - see drawPolygonTo). `vertices` is required. See
  docs/scenegraph-shapes.md.

  Wraps a child Poster whose width/height are never set (only its uri is swapped, and only
  once a render is ready) so there's never a frame where Poster's own auto-scale-to-fit
  stretches a stale image to a newly-set size - see docs/scenegraph-shapes.md.
-->
<component name="Polygon" extends="Group">
  <interface>
    <!-- Async load starves under rapid `uri` changes, leaving the shape blank (confirmed on hardware). -->
    <field id="loadSync" type="boolean" value="true" onChange="onLoadSyncChanged" />
    <!-- Set once a render (cache hit or Task result) is ready to display - mirrors the old Poster-native `uri` field so external observers keep working unchanged. -->
    <field id="uri" type="string" value="" />
    <field id="lastRoundTripMs" type="integer" value="0" />
    <!-- Fill color, packed RGBA (matches every BGE.Renderer draw* call). -->
    <field id="color" type="color" value="0xFFFFFFFF" onChange="onShapeFieldChanged" />
    <field id="width" type="float" value="100" onChange="onShapeFieldChanged" />
    <field id="height" type="float" value="100" onChange="onShapeFieldChanged" />
    <!-- Required points, local to the shape's own bitmap, settable from XML e.g. vertices="[[0,0],[100,0],[50,80]]". -->
    <field id="vertices" type="vector2darray" value="[]" onChange="onShapeFieldChanged" />
    <!-- Outline color, packed RGBA. Only drawn when outlineWidth > 0. -->
    <field id="outlineColor" type="color" value="0x000000FF" onChange="onShapeFieldChanged" />
    <field id="outlineWidth" type="integer" value="0" onChange="onShapeFieldChanged" />
  </interface>
  <children>
    <Poster id="image" loadSync="true" />
    <ShapeRenderTask id="renderTask" />
  </children>
</component>
