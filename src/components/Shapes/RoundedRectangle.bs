' See RoundedRectangle.xml for the field interface.
import "../../source/utils/ShapeComponentHelpers.bs"

' Redraw-triggering fields observe via observeField() here, not XML onChange= - registering
' after construction means setting several as XML attributes on one tag redraws once, not once
' per attribute (confirmed on hardware; see RoundedRectangle.xml).
sub init()
  m.image = m.top.findNode("image")
  m.renderTask = m.top.findNode("renderTask")
  m.renderTask.shapeType = "RoundedRectangle"
  m.renderTask.observeField("resultUri", "onRenderComplete")
  for each fieldId in ["color", "width", "height", "cornerRadius", "outlineColor", "outlineWidth"]
    m.top.observeField(fieldId, "onShapeFieldChanged")
  end for
  redraw()
end sub

sub onLoadSyncChanged()
  m.image.loadSync = m.top.loadSync
end sub

sub onShapeFieldChanged()
  redraw()
end sub

sub redraw()
  m.roundTripTimer = BGE.ShapeComponentHelpers.startRoundTripTimer()
  width = Int(m.top.width)
  height = Int(m.top.height)
  cacheKey = FormatJson({
    w: width,
    h: height,
    color: m.top.color,
    r: m.top.cornerRadius,
    oc: m.top.outlineColor,
    ow: m.top.outlineWidth
  })

  cache = BGE.ShapeComponentHelpers.checkShapeCache("RoundedRectangle", cacheKey)
  if cache.hit
    applyRenderedUri(cache.uri)
    return
  end if

  m.renderTask.uri = cache.uri
  m.renderTask.width = width
  m.renderTask.height = height
  m.renderTask.color = m.top.color
  m.renderTask.cornerRadius = m.top.cornerRadius
  m.renderTask.outlineColor = m.top.outlineColor
  m.renderTask.outlineWidth = m.top.outlineWidth
  m.renderTask.control = "RUN"
end sub

sub onRenderComplete()
  applyRenderedUri(m.renderTask.resultUri)
end sub

sub applyRenderedUri(uri as string)
  if "" = uri
    return
  end if
  m.image.uri = uri
  m.top.uri = uri
  m.top.lastRoundTripMs = BGE.ShapeComponentHelpers.logRoundTrip("RoundedRectangle", m.roundTripTimer)
end sub
