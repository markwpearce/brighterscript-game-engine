' See RoundedRectangle.xml for the field interface.
import "../../source/utils/ShapeComponentHelpers.bs"

sub init()
  m.top.observeField("color", "onShapeFieldChanged")
  m.top.observeField("width", "onShapeFieldChanged")
  m.top.observeField("height", "onShapeFieldChanged")
  m.top.observeField("cornerRadius", "onShapeFieldChanged")
  m.top.observeField("outlineColor", "onShapeFieldChanged")
  m.top.observeField("outlineWidth", "onShapeFieldChanged")
  redraw()
end sub

sub onShapeFieldChanged()
  redraw()
end sub

sub redraw()
  width = Int(m.top.width)
  height = Int(m.top.height)
  cacheKey = FormatJson({
    w: width,
    h: height,
    color: m.top.color,
    r: m.top.cornerRadius,
    oc: m.top.outlineColor,
    ow: m.top.outlineWidth
  })

  renderState = BGE.ShapeComponentHelpers.beginShapeRender("RoundedRectangle", cacheKey, width, height)
  if not renderState.hit
    if invalid = renderState.renderer
      return
    end if
    renderState.renderer.drawRoundedRectangleTo(renderState.bitmap, 0, 0, width, height, m.top.cornerRadius, m.top.color)
    if m.top.outlineWidth > 0
      renderState.renderer.drawRectangleOutlineTo(renderState.bitmap, 0, 0, width, height, m.top.outlineColor, m.top.outlineWidth)
    end if
    BGE.ShapeComponentHelpers.finishShapeRender(renderState)
  end if
  m.top.uri = renderState.uri
end sub
