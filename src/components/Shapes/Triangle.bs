' See Triangle.xml for the field interface.
import "../../source/utils/ShapeComponentHelpers.bs"

' Fields already declare onChange="onShapeFieldChanged" in XML; an extra observeField() here double-fires every redraw (confirmed on hardware).
sub init()
  redraw()
end sub

sub onShapeFieldChanged()
  redraw()
end sub

' A right triangle with its right angle at the bottom-left, sized to fill the
' given width/height - used whenever `vertices` is empty.
function defaultTriangleVertices(width as float, height as float) as BGE.Math.Vector[]
  return [
    BGE.Math.VectorOps.create(0, height),
    BGE.Math.VectorOps.create(0, 0),
    BGE.Math.VectorOps.create(width, height)
  ]
end function

sub redraw()
  roundTripTimer = BGE.ShapeComponentHelpers.startRoundTripTimer()
  width = Int(m.top.width)
  height = Int(m.top.height)
  points = BGE.ShapeComponentHelpers.verticesFromField(m.top.vertices)
  if points.count() <> 3
    points = defaultTriangleVertices(width, height)
  end if

  cacheKey = FormatJson({
    w: width,
    h: height,
    v: m.top.vertices,
    color: m.top.color,
    oc: m.top.outlineColor,
    ow: m.top.outlineWidth
  })

  renderState = BGE.ShapeComponentHelpers.beginShapeRender("Triangle", cacheKey, width, height)
  if not renderState.hit
    if invalid = renderState.renderer
      return
    end if
    renderState.renderer.drawTriangleTo(renderState.bitmap, points, 0, 0, m.top.color)
    if m.top.outlineWidth > 0
      renderState.renderer.drawTriangleOutlineTo(renderState.bitmap, points, m.top.outlineColor)
    end if
    BGE.ShapeComponentHelpers.finishShapeRender(renderState)
  end if
  m.top.uri = renderState.uri
  m.top.lastRoundTripMs = BGE.ShapeComponentHelpers.logRoundTrip("Triangle", roundTripTimer)
end sub
