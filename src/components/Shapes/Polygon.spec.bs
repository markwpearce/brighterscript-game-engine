import "pkg:/components/Shapes/ShapeTestHelpers.spec.bs"

namespace tests

  ' Runs inside a Polygon node (SceneGraph runner), so the component's own functions are in scope.
  @SGNode("Polygon")
  @suite("Polygon (SceneGraph)")
  class PolygonNodeTests extends rooibos.BaseTestSuite

    ' every test shares one node, so reset what tests change
    protected override function beforeEach()
      tests.deleteShapeCache()
      m.top.uri = ""
      m.top.findNode("renderTask").uri = ""
      m.top.concave = false
      m.top.fillRule = "nonzero"
    end function

    @describe("render task")

    @it("sets its render task up for polygons")
    function _()
      m.assertEqual("Polygon", m.top.findNode("renderTask").shapeType)
    end function

    @it("doesn't render until it has three vertices")
    function _()
      m.top.vertices = [[0, 0], [10, 0]]
      redraw()
      m.assertEqual("", m.top.findNode("renderTask").uri)
    end function

    @it("hands the render task its fill rule for a concave fill")
    function _()
      m.top.vertices = [[0, 0], [20, 0], [10, 5], [20, 20], [0, 20]]
      m.top.concave = true
      m.top.fillRule = "evenodd"
      redraw()
      task = m.top.findNode("renderTask")
      m.assertTrue(task.concave)
      m.assertEqual("evenodd", task.fillRule)
      m.assertEqual(5, task.vertices.count())
    end function

    @it("caches a hull fill and a concave fill separately")
    function _()
      m.top.vertices = [[0, 0], [20, 0], [10, 5], [20, 20], [0, 20]]
      redraw()
      hull = m.top.findNode("renderTask").uri
      m.top.concave = true
      redraw()
      m.assertNotEqual(hull, m.top.findNode("renderTask").uri)
    end function

  end class

end namespace
