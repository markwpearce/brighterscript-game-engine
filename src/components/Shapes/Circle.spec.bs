import "pkg:/components/Shapes/ShapeTestHelpers.spec.bs"

namespace tests

  ' Runs inside a Circle node (SceneGraph runner), so the component's own functions are in scope.
  @SGNode("Circle")
  @suite("Circle (SceneGraph)")
  class CircleNodeTests extends rooibos.BaseTestSuite

    ' every test shares one node, so reset what tests change
    protected override function beforeEach()
      tests.deleteShapeCache()
      m.top.uri = ""
      m.top.findNode("renderTask").uri = ""
    end function

    @describe("render task")

    @it("sets its render task up for circles")
    function _()
      m.assertEqual("Circle", m.top.findNode("renderTask").shapeType)
    end function

    @it("hands the render task its fields on a cache miss")
    function _()
      m.top.width = 40.7
      m.top.height = 30
      m.top.color = &hFF0000FF
      m.top.outlineWidth = 2
      m.top.outlineSegments = 12
      redraw()
      task = m.top.findNode("renderTask")
      m.assertEqual(40.0, task.width)
      m.assertEqual(30.0, task.height)
      m.assertEqual(&hFF0000FF, task.color)
      m.assertEqual(2, task.outlineWidth)
      m.assertEqual(12, task.outlineSegments)
      m.assertEqual(1, Instr(1, task.uri, "cachefs:/bge_shape_"))
      m.assertEqual("", m.top.uri)
    end function

    @it("shows a cached render without running the task")
    function _()
      m.top.width = 24
      m.top.height = 24
      redraw()
      uri = m.top.findNode("renderTask").uri
      WriteAsciiFile(uri, "cached")
      redraw()
      m.assertEqual(uri, m.top.uri)
      m.assertEqual(uri, m.top.findNode("image").uri)
    end function

    @describe("results")

    @it("ignores a failed render")
    function _()
      applyRenderedUri("cachefs:/bge_shape_a.png")
      applyRenderedUri("")
      m.assertEqual("cachefs:/bge_shape_a.png", m.top.uri)
    end function

    @it("passes loadSync to its poster")
    function _()
      m.top.loadSync = false
      onLoadSyncChanged()
      m.assertFalse(m.top.findNode("image").loadSync)
    end function

  end class

end namespace
