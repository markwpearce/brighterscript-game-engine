<?xml version="1.0" encoding="utf-8" ?>
<!--
  Shared render worker for every BGE shape component (RoundedRectangle/Circle/Triangle/
  Polygon). Runs the draw+PNG-encode+write work off the render thread, since it costs
  ~150-200ms per shape regardless of complexity (dominated by PNG encode/decode, not the
  draw call itself). Each shape component creates and keeps exactly one instance of this
  Task, reused across redraws via control="RUN" - a cold Task run costs ~780ms (thread
  spin-up) vs ~200ms warm, so paying that once per component instance (not per redraw)
  matters. See ShapeComponentHelpers.bs and docs/scenegraph-shapes.md.
-->
<component name="ShapeRenderTask" extends="Task">
  <interface>
    <!-- Which shape to render - selects the BGE.Renderer draw*/draw*Outline call(s) to dispatch to. -->
    <field id="shapeType" type="string" value="" />
    <!-- Cache file to render into, computed synchronously by the calling component
         (BGE.ShapeComponentHelpers.checkShapeCache) before this Task is ever run. -->
    <field id="uri" type="string" value="" />
    <field id="width" type="float" value="0" />
    <field id="height" type="float" value="0" />
    <field id="color" type="color" value="0xFFFFFFFF" />
    <field id="outlineColor" type="color" value="0x000000FF" />
    <field id="outlineWidth" type="integer" value="0" />
    <field id="cornerRadius" type="float" value="0" />
    <field id="outlineSegments" type="integer" value="32" />
    <field id="vertices" type="vector2darray" value="[]" />
    <!-- Set once the render finishes; "" on failure (e.g. a non-positive width/height). -->
    <field id="resultUri" type="string" value="" alwaysNotify="true" />
    <!-- Draw+encode+write time for the most recent run, in milliseconds. -->
    <field id="resultRoundTripMs" type="integer" value="0" alwaysNotify="true" />
  </interface>
</component>
