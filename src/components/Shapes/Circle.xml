<?xml version="1.0" encoding="utf-8" ?>
<!--
  Renders a filled (optionally outlined) circle, using BGE.Renderer.drawCircleTo()/
  drawCircleOutline() internally. Radius is derived from min(width, height) / 2.
  See docs/scenegraph-shapes.md.

  Wraps a child Poster whose width/height are never set (only its uri is swapped, and only
  once a render is ready) so there's never a frame where Poster's own auto-scale-to-fit
  stretches a stale image to a newly-set size - see docs/scenegraph-shapes.md.
-->
<component name="Circle" extends="Group">
  <interface>
    <!-- Async load starves under rapid `uri` changes, leaving the shape blank (confirmed on hardware). -->
    <field id="loadSync" type="boolean" value="true" onChange="onLoadSyncChanged" />
    <!-- Set once a render (cache hit or Task result) is ready to display - mirrors the old Poster-native `uri` field so external observers keep working unchanged. -->
    <field id="uri" type="string" value="" />
    <field id="lastRoundTripMs" type="integer" value="0" />
    <!-- Fill color, packed RGBA (matches every BGE.Renderer draw* call). Redraw-triggering
         fields deliberately have no onChange here - see Circle.bs's init(), which registers
         observeField() for all of them only after construction finishes, so setting several
         of these as XML attributes on the same tag causes exactly one redraw, not one per
         attribute (confirmed on hardware). -->
    <field id="color" type="color" value="0xFFFFFFFF" />
    <field id="width" type="float" value="100" />
    <field id="height" type="float" value="100" />
    <!-- Outline color, packed RGBA. Only drawn when outlineWidth > 0. -->
    <field id="outlineColor" type="color" value="0x000000FF" />
    <field id="outlineWidth" type="integer" value="0" />
    <!-- Number of line segments used to approximate the outline (drawCircleOutline's line_count). -->
    <field id="outlineSegments" type="integer" value="32" />
  </interface>
  <children>
    <Poster id="image" loadSync="true" />
    <ShapeRenderTask id="renderTask" />
  </children>
</component>
