import "pkg:/components/Shapes/ShapeTestHelpers.spec.bs"

namespace tests

  ' Runs inside a Triangle node (SceneGraph runner), so the component's own functions are in scope.
  @SGNode("Triangle")
  @suite("Triangle (SceneGraph)")
  class TriangleNodeTests extends rooibos.BaseTestSuite

    ' every test shares one node, so reset what tests change
    protected override function beforeEach()
      tests.deleteShapeCache()
      m.top.uri = ""
      m.top.findNode("renderTask").uri = ""
    end function

    @describe("render task")

    @it("sets its render task up for triangles")
    function _()
      m.assertEqual("Triangle", m.top.findNode("renderTask").shapeType)
    end function

    @it("hands the render task its vertices on a cache miss")
    function _()
      m.top.width = 50
      m.top.height = 40
      m.top.vertices = [[0, 40], [25, 0], [50, 40]]
      redraw()
      task = m.top.findNode("renderTask")
      m.assertEqual(3, task.vertices.count())
      m.assertEqual(25.0, task.vertices[1][0] * 1.0)
      m.assertEqual(50.0, task.width)
      m.assertEqual(1, Instr(1, task.uri, "cachefs:/bge_shape_"))
    end function

    @it("caches each set of vertices separately")
    function _()
      m.top.vertices = [[0, 10], [5, 0], [10, 10]]
      redraw()
      first = m.top.findNode("renderTask").uri
      m.top.vertices = [[0, 10], [6, 0], [10, 10]]
      redraw()
      m.assertNotEqual(first, m.top.findNode("renderTask").uri)
    end function

  end class

end namespace
