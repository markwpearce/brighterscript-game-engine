<?xml version="1.0" encoding="utf-8" ?>
<!--
  Renders a filled (optionally outlined) rectangle with rounded corners, using
  BGE.Renderer.drawRoundedRectangleTo() internally - SceneGraph's native
  <Rectangle> node has no corner-radius support. See docs/scenegraph-shapes.md.
-->
<component name="RoundedRectangle" extends="Poster">
  <interface>
    <!-- Fill color, packed RGBA (matches every BGE.Renderer draw* call). -->
    <field id="color" type="color" value="0xFFFFFFFF" onChange="onShapeFieldChanged" />
    <field id="width" type="float" value="100" onChange="onShapeFieldChanged" />
    <field id="height" type="float" value="100" onChange="onShapeFieldChanged" />
    <!-- Corner radius, clamped to at most half of width/height (see drawRoundedRectangleTo). -->
    <field id="cornerRadius" type="float" value="10" onChange="onShapeFieldChanged" />
    <!-- Outline color, packed RGBA. Only drawn when outlineWidth > 0. -->
    <field id="outlineColor" type="color" value="0x000000FF" onChange="onShapeFieldChanged" />
    <field id="outlineWidth" type="integer" value="0" onChange="onShapeFieldChanged" />
  </interface>
</component>
