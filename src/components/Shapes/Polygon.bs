' See Polygon.xml for the field interface.
import "../../source/utils/ShapeComponentHelpers.bs"

' Fields already declare onChange="onShapeFieldChanged" in XML; an extra observeField() here double-fires every redraw (confirmed on hardware).
sub init()
  redraw()
end sub

sub onShapeFieldChanged()
  redraw()
end sub

sub redraw()
  roundTripTimer = BGE.ShapeComponentHelpers.startRoundTripTimer()
  width = Int(m.top.width)
  height = Int(m.top.height)
  points = BGE.ShapeComponentHelpers.verticesFromField(m.top.vertices)
  if points.count() < 3
    ' Nothing to draw yet - `vertices` is required and hasn't been set.
    return
  end if

  cacheKey = FormatJson({
    w: width,
    h: height,
    v: m.top.vertices,
    color: m.top.color,
    oc: m.top.outlineColor,
    ow: m.top.outlineWidth
  })

  renderState = BGE.ShapeComponentHelpers.beginShapeRender("Polygon", cacheKey, width, height)
  if not renderState.hit
    if invalid = renderState.renderer
      return
    end if
    renderState.renderer.drawPolygonTo(renderState.bitmap, points, 0, 0, m.top.color)
    if m.top.outlineWidth > 0
      renderState.renderer.drawPolygonOutlineTo(renderState.bitmap, points, m.top.outlineColor, m.top.outlineWidth)
    end if
    BGE.ShapeComponentHelpers.finishShapeRender(renderState)
  end if
  m.top.uri = renderState.uri
  m.top.lastRoundTripMs = BGE.ShapeComponentHelpers.logRoundTrip("Polygon", roundTripTimer)
end sub
