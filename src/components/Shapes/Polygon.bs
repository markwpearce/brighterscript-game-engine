' See Polygon.xml for the field interface.
import "../../source/utils/ShapeComponentHelpers.bs"

' Fields already declare onChange="onShapeFieldChanged" in XML; an extra observeField() here double-fires every redraw (confirmed on hardware).
sub init()
  m.image = m.top.findNode("image")
  m.renderTask = m.top.findNode("renderTask")
  m.renderTask.shapeType = "Polygon"
  m.renderTask.observeField("resultUri", "onRenderComplete")
  redraw()
end sub

sub onLoadSyncChanged()
  m.image.loadSync = m.top.loadSync
end sub

sub onShapeFieldChanged()
  redraw()
end sub

sub redraw()
  width = Int(m.top.width)
  height = Int(m.top.height)
  points = BGE.ShapeComponentHelpers.verticesFromField(m.top.vertices)
  if points.count() < 3
    ' Nothing to draw yet - `vertices` is required and hasn't been set.
    return
  end if

  m.roundTripTimer = BGE.ShapeComponentHelpers.startRoundTripTimer()
  cacheKey = FormatJson({
    w: width,
    h: height,
    v: m.top.vertices,
    color: m.top.color,
    oc: m.top.outlineColor,
    ow: m.top.outlineWidth
  })

  cache = BGE.ShapeComponentHelpers.checkShapeCache("Polygon", cacheKey)
  if cache.hit
    applyRenderedUri(cache.uri)
    return
  end if

  m.renderTask.uri = cache.uri
  m.renderTask.width = width
  m.renderTask.height = height
  m.renderTask.vertices = m.top.vertices
  m.renderTask.color = m.top.color
  m.renderTask.outlineColor = m.top.outlineColor
  m.renderTask.outlineWidth = m.top.outlineWidth
  m.renderTask.control = "RUN"
end sub

sub onRenderComplete()
  applyRenderedUri(m.renderTask.resultUri)
end sub

sub applyRenderedUri(uri as string)
  if "" = uri
    return
  end if
  m.image.uri = uri
  m.top.uri = uri
  m.top.lastRoundTripMs = BGE.ShapeComponentHelpers.logRoundTrip("Polygon", m.roundTripTimer)
end sub
