' See ShapeRenderTask.xml for the field interface.
import "../../source/utils/ShapeComponentHelpers.bs"

sub init()
  m.top.functionName = "doRender"
end sub

function doRender() as void
  width = Int(m.top.width)
  height = Int(m.top.height)
  shapeType = m.top.shapeType

  renderState = BGE.ShapeComponentHelpers.createShapeRenderState(shapeType, m.top.uri, width, height)
  if invalid = renderState.renderer
    return
  end if

  drawShape(renderState, shapeType, width, height)
  BGE.ShapeComponentHelpers.finishShapeRender(renderState)

  m.top.resultRoundTripMs = renderState.timer.TotalMilliseconds()
  m.top.resultUri = renderState.uri
end function

' Dispatches to the BGE.Renderer draw*/draw*Outline call(s) matching `shapeType` - the
' same calls each shape component made directly before this Task existed.
sub drawShape(renderState as object, shapeType as string, width as integer, height as integer)
  renderer = renderState.renderer
  bitmap = renderState.bitmap

  if shapeType = "RoundedRectangle"
    renderer.drawRoundedRectangleTo(bitmap, 0, 0, width, height, m.top.cornerRadius, m.top.color)
    if m.top.outlineWidth > 0
      renderer.drawRectangleOutlineTo(bitmap, 0, 0, width, height, m.top.outlineColor, m.top.outlineWidth)
    end if
  else if shapeType = "Circle"
    radius = BGE.Math.Min(width, height) / 2
    renderer.drawCircleTo(bitmap, radius, radius, radius, m.top.color)
    if m.top.outlineWidth > 0
      renderer.drawCircleOutline(m.top.outlineSegments, radius, radius, radius - (m.top.outlineWidth / 2), m.top.outlineColor)
    end if
  else if shapeType = "Triangle"
    points = BGE.ShapeComponentHelpers.verticesFromField(m.top.vertices)
    if points.count() <> 3
      points = BGE.ShapeComponentHelpers.defaultTriangleVertices(width, height)
    end if
    renderer.drawTriangleTo(bitmap, points, 0, 0, m.top.color)
    if m.top.outlineWidth > 0
      renderer.drawTriangleOutlineTo(bitmap, points, m.top.outlineColor)
    end if
  else if shapeType = "Polygon"
    points = BGE.ShapeComponentHelpers.verticesFromField(m.top.vertices)
    if points.count() >= 3
      renderer.drawPolygonTo(bitmap, points, 0, 0, m.top.color)
      if m.top.outlineWidth > 0
        renderer.drawPolygonOutlineTo(bitmap, points, m.top.outlineColor, m.top.outlineWidth)
      end if
    end if
  end if
end sub
