import "pkg:/components/Shapes/ShapeTestHelpers.spec.bs"

namespace tests

  ' Runs inside a ShapeRenderTask node (SceneGraph runner), calling its render function directly.
  @SGNode("ShapeRenderTask")
  @suite("ShapeRenderTask (SceneGraph)")
  class ShapeRenderTaskNodeTests extends rooibos.BaseTestSuite

    protected override function beforeEach()
      tests.deleteShapeCache()
    end function

    @describe("doRender")

    @it("renders a shape to its cache file")
    function _()
      m.top.shapeType = "Circle"
      m.top.uri = "cachefs:/bge_shape_test_circle.png"
      m.top.width = 16
      m.top.height = 16
      m.top.color = &hFF0000FF
      doRender()
      m.assertEqual("cachefs:/bge_shape_test_circle.png", m.top.resultUri)
      m.assertEqual(1, MatchFiles("cachefs:/", "bge_shape_test_circle.png").count())
    end function

    @it("reports a failure for a shape with no size")
    function _()
      m.top.shapeType = "RoundedRectangle"
      m.top.uri = "cachefs:/bge_shape_test_empty.png"
      m.top.width = 0
      m.top.height = 10
      m.top.resultUri = "x"
      doRender()
      m.assertEqual("", m.top.resultUri)
    end function

  end class

end namespace
